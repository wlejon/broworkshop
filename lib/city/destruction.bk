// lib/city/destruction.bk — a building's members (lib/destruct), standing or
// broken off and flying: one instanced box a member, placed from its record
// (its box in its mass's frame) and its body's pose, drawn as what it was.
// A face that was the building's outside draws the facade (facade.bk) where
// it was on the building, so a panel flying off keeps its windows; a face
// inside draws the floor, ceiling or wall of the rooms; a broken face (where
// a joint gave or the member was split) is jagged and raw: concrete with its
// aggregate and rebar, brick and mortar, the curtain wall's metal, timber.
// The jagged faces are a displacement field of the mass's frame, so the two
// sides of a break are the same surface.
module hook;
import scene;
import mesh;
import custom;
import facade;
from scene import camera;

struct Params {
    night: f32,
    room_day: f32,
    room_night: f32,
    debug: f32,   // 1: the shading branch's colour (outside red, break green, inside blue); 2: all grey; 3: the dust coat (red full, blue none, black standing)
    blend: f32,   // how far the picture is from the solver's last step but one (0) to its last (1)
    base: f32,    // the body the node's first instance draws
}

@binding(4, 0) var params: uniform<Params>;
@binding(4, 14) var masses: read_buffer<vec4<f32>>;
// Per member, 3 x vec4: (centre in its mass's frame, mass), (half extents
// (0: gone), body + 1 (0: standing)), (kind, material, broken faces (bit
// 2 * axis + 1 for the + face), seed).
@binding(4, 15) var pieces: read_buffer<vec4<f32>>;
// Per body, 5 x vec4 (the solver's k_show): (pivot at rest, its broken faces as bits), where it is after the
// solver's last step, where it was before it, and its turn from rest after and before.
@binding(4, 16) var bodies: read_buffer<vec4<f32>>;
// Per mass, its building open (interior.js, as building.bk reads it): a
// building taken down but standing whole keeps its rooms, its glass cut.
@binding(4, 17) var open_state: read_buffer<vec4<f32>>;

const KIND_FOUNDATION: i32 = 0;
const KIND_SLAB: i32 = 1;
const KIND_COLUMN: i32 = 2;
const KIND_WALL: i32 = 3;
const KIND_ROOF: i32 = 4;
const MAT_CONCRETE: i32 = 0;
const MAT_MASONRY: i32 = 1;
const MAT_GLASS: i32 = 2;
const MAT_STEEL: i32 = 3;
const MAT_TIMBER: i32 = 4;

fn qrot(q: vec4<f32>, v: vec3<f32>) -> vec3<f32> {
    let t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

fn lattice(x: f32, y: f32, z: f32, k: u32) -> f32 {
    let ix = bitcast<u32>(x as i32);
    let iy = bitcast<u32>(y as i32);
    let iz = bitcast<u32>(z as i32);
    return scene::hash2((ix * 73856093u) ^ (iy * 19349663u) ^ (k * 83492791u), iz);
}

// Value noise over 3D, unit lattice.
fn vn3(p: vec3<f32>, k: u32) -> f32 {
    let i = floor(p);
    let f = p - i;
    let s = f * f * (vec3<f32>(3.0, 3.0, 3.0) - 2.0 * f);
    let a = mix(lattice(i.x, i.y, i.z, k), lattice(i.x + 1.0, i.y, i.z, k), s.x);
    let b = mix(lattice(i.x, i.y + 1.0, i.z, k), lattice(i.x + 1.0, i.y + 1.0, i.z, k), s.x);
    let c = mix(lattice(i.x, i.y, i.z + 1.0, k), lattice(i.x + 1.0, i.y, i.z + 1.0, k), s.x);
    let d = mix(lattice(i.x, i.y + 1.0, i.z + 1.0, k), lattice(i.x + 1.0, i.y + 1.0, i.z + 1.0, k), s.x);
    return mix(mix(a, b, s.y), mix(c, d, s.y), s.z);
}

// How far a broken face along axis k stands off its plane at p, in -1..1:
// coarse lumps and a finer tearing.
fn jag(p: vec3<f32>, k: u32) -> f32 {
    return (vn3(p * 1.3, k) - 0.5) * 1.4 + (vn3(p * 4.1, k + 7u) - 0.5) * 0.6;
}

fn has_bit(m: i32, b: i32) -> bool {
    return ((m >> b) & 1) != 0;
}

fn is_broken(rough: i32, n: vec3<f32>) -> bool {
    var bit = 0;
    if (abs(n.x) > 0.5) { bit = select(n.x > 0.0, 1, 0); }
    else if (abs(n.y) > 0.5) { bit = 2 + select(n.y > 0.0, 1, 0); }
    else { bit = 4 + select(n.z > 0.0, 1, 0); }
    return has_bit(rough, bit);
}

// A pitched roof's box laid onto building.bk's prism (eaves 0.45 m out and
// 0.12 m down, ridge along x; a hip's ends slope in to a ridge shortened by
// the depth), as building.bk shapes it: a point no higher than the long
// slope over it, then (a hip) drawn in along x onto the end's slope at its
// height. Both slopes stay planes, the hip line where they meet.
fn roof_point(lp: vec3<f32>, r1: vec4<f32>, r3: vec4<f32>) -> vec3<f32> {
    let rw = r1.x + 0.45;
    let rd = r1.z + 0.45;
    let rh = r3.y + 0.12;
    let y0 = r1.y - 0.12;
    let y = clamp(lp.y, y0, y0 + rh * (1.0 - min(abs(lp.z) / rd, 1.0)));
    var x = lp.x;
    if (r3.x > 1.5) {
        let a = max(0.0, r1.x - r1.z);
        x = sign(lp.x) * min(abs(lp.x), a + (rw - a) * (1.0 - (y - y0) / rh));
    }
    return vec3<f32>(x, y, lp.z);
}

// The roof's normal (its mass's frame) on a face of a roof member's box:
// its top the long slope on the member's side of the ridge (zc its centre's
// z), an end the hip's slope (a gable's end its wall), else the box's own.
fn roof_normal(n: vec3<f32>, end: bool, zc: f32, r1: vec4<f32>, r3: vec4<f32>) -> vec3<f32> {
    let rw = r1.x + 0.45;
    let rd = r1.z + 0.45;
    let rh = r3.y + 0.12;
    if (n.y > 0.5) { return normalize(vec3<f32>(0.0, rd, select(zc < 0.0, -rh, rh))); }
    if (end && r3.x > 1.5) {
        let a = max(0.0, r1.x - r1.z);
        return normalize(vec3<f32>(sign(n.x) * rh, rw - a, 0.0));
    }
    return n;
}

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    let k = v.instance_index + ((params.base + 0.5) as i32);
    let p0 = pieces[k * 3];
    let p1 = pieces[k * 3 + 1];
    let p2 = pieces[k * 3 + 2];
    if (p1.x <= 0.0) {
        v.pos = vec3<f32>(0.0, -100000.0, 0.0);
        return v;
    }
    let mi = (p0.w + 0.5) as i32;
    let r0 = masses[mi * 4];
    let r1 = masses[mi * 4 + 1];
    let r2 = masses[mi * 4 + 2];
    let r3 = masses[mi * 4 + 3];
    // Its mass hidden from view (flag 8, building_render.js hide({view})):
    // its pieces too.
    if ((((r3.z + 0.5) as i32) & 8) != 0) {
        v.pos = vec3<f32>(0.0, -100000.0, 0.0);
        return v;
    }
    let u = v.pos;
    let n = v.normal;
    let bi = (p1.w + 0.5) as i32 - 1;
    var rough = 0;
    if (bi >= 0) { rough = (bodies[bi * 5].w + 0.5) as i32; }
    var lp = p0.xyz + u * 2.0 * p1.xyz;
    // Broken faces jagged: each axis's displacement where the point lies on a
    // broken face across that axis (so an edge's two copies move alike).
    let rest = lp;
    if (abs(u.x) > 0.499 && has_bit(rough, select(u.x > 0.0, 1, 0))) { lp.x += jag(rest, 0u) * min(0.45, 0.7 * p1.x); }
    if (abs(u.y) > 0.499 && has_bit(rough, select(u.y > 0.0, 3, 2))) { lp.y += jag(rest, 1u) * min(0.45, 0.7 * p1.y); }
    if (abs(u.z) > 0.499 && has_bit(rough, select(u.z > 0.0, 5, 4))) { lp.z += jag(rest, 2u) * min(0.45, 0.7 * p1.z); }

    // A roof's box laid down to its slope: no point over the roof's surface.
    var nn = n;
    if ((p2.x + 0.5) as i32 == KIND_ROOF) {
        lp = roof_point(lp, r1, r3);
        // (An end face: on the box's x side that reaches the eaves' end.)
        let end = abs(n.x) > 0.5 && abs(p0.x) + p1.x >= r1.x + 0.44;
        nn = roof_normal(n, end, p0.z, r1, r3);
    }

    let yaw = r0.w;
    let c = cos(yaw);
    let s = sin(yaw);
    let rw = vec3<f32>(r0.x + c * lp.x + s * lp.z, r0.y + lp.y, r0.z - s * lp.x + c * lp.z);
    let nw0 = vec3<f32>(c * nn.x + s * nn.z, nn.y, -s * nn.x + c * nn.z);
    let bi = (p1.w + 0.5) as i32 - 1;
    var q = vec4<f32>(0.0, 0.0, 0.0, 1.0);
    var w = rw;
    // How much a body has been through (0..1): coated in the dust by how far
    // it has turned from how it stood, and (far less) how far it has come: a
    // panel cracked loose and still in its place keeps its glass and its
    // face, and so do the storeys of a tower on their way down whole.
    var coat = 0.0;
    var loose = false;
    if (bi >= 0) {
        let b0 = bodies[bi * 5];
        let at = mix(bodies[bi * 5 + 2].xyz, bodies[bi * 5 + 1].xyz, params.blend);
        let qa = bodies[bi * 5 + 3];
        var qb = bodies[bi * 5 + 4];
        if (dot(qa, qb) < 0.0) { qb = -qb; }
        q = normalize(mix(qb, qa, params.blend));
        w = qrot(q, rw - b0.xyz) + at;
        let b1 = vec4<f32>(at, 0.0);
        let turned = 2.0 * acos(min(abs(q.w), 1.0));
        let come = length(b1.xyz - b0.xyz);
        coat = smoothstep(0.15, 2.5, 0.03 * come + 2.0 * turned);
        loose = come > 0.01 || turned > 0.002;
    }
    v.pos = w;
    v.normal = qrot(q, nw0);
    v.v0 = vec4<f32>(lp, p2.x);
    v.v1 = r1;
    v.v2 = r2;
    v.v3 = r3;
    v.v4 = vec4<f32>(n, p2.y);
    v.v5 = q;
    // (w: 0 standing, else 1 + the coat in thousandths + 1001 * a tone 0..63
    // of its member's: the chunks of a pile are not all dusted alike.)
    let tone = (p2.w * 64.0) as i32 % 64;
    v.vi = vec4<i32>(floor(r2.z * 1048576.0) as i32, rough, mi, select(loose, 1 + (coat * 1000.0 + 0.5) as i32 + 1001 * tone, 0));
    return v;
}

// The rebar a concrete member's break bares: bars 16 mm thick, 0.2 m apart,
// running along the face (a, across b), bared only where the concrete
// spalled off them (`bare`, a patch noise), and gone where a bar is under a
// pixel, so the far rubble does not shimmer.
fn rebar(a: f32, b: f32, fpx: f32, bare: f32) -> f32 {
    let gb = abs(fract(b / 0.2 + 0.5) - 0.5) * 0.2;
    let bar = 1.0 - smoothstep(0.008, 0.008 + fpx, gb);
    return bar * smoothstep(0.62, 0.7, bare) * (1.0 - smoothstep(0.006, 0.02, fpx));
}

pub fn fragment(v: mesh::Vertex, s_in: mesh::Surface) -> mesh::Surface {
    var s = s_in;
    let lp = v.v0.xyz;
    let kind = (v.v0.w + 0.5) as i32;
    let n = v.v4.xyz;
    let mat = (v.v4.w + 0.5) as i32;
    let q = v.v5;
    let mi = v.vi.z;
    let rough = v.vi.y;
    let moved = v.vi.w > 0;
    let packed = max(v.vi.w - 1, 0);
    let coat = (packed % 1001) as f32 / 1000.0;
    let tone = (packed / 1001) as f32 / 63.0;
    let yaw = masses[mi * 4].w;
    let hw = v.v1.x;
    let h = v.v1.y;
    let hd = v.v1.z;
    let plinth = v.v2.y;
    let style = (v.v2.w + 0.5) as i32;
    let hue = v.v3.w;
    let id = v.vi.x as f32;
    let c = cos(yaw);
    let sn = sin(yaw);
    let X = qrot(q, vec3<f32>(c, 0.0, -sn));
    let Y = qrot(q, vec3<f32>(0.0, 1.0, 0.0));
    let Z = qrot(q, vec3<f32>(sn, 0.0, c));
    let eye = normalize(v.world_pos);
    let broken = is_broken(rough, n);
    let fpx = facade::fw1(lp.x) + facade::fw1(lp.y) + facade::fw1(lp.z) + 0.001;

    s.metallic = 0.0;
    s.emissive = vec3<f32>(0.0, 0.0, 0.0);
    let e = 0.03;
    let outer = !broken && ((n.z > 0.5 && lp.z > hd - e) || (n.z < -0.5 && lp.z < -hd + e) ||
                            (n.x > 0.5 && lp.x > hw - e) || (n.x < -0.5 && lp.x < -hw + e) ||
                            (n.y > 0.5 && lp.y > h - e) || (n.y < -0.5 && lp.y < -plinth + e));
    let roofk = kind == KIND_ROOF;
    // The roof's normal in its mass's frame, as the vertex stage set it.
    let nr = normalize(s_in.normal);
    let nloc = vec3<f32>(dot(nr, X), dot(nr, Y), dot(nr, Z));
    // A roof's slope, a hip's end, or a gable's end wall: the roof as the
    // building drew it.
    let roof_out = roofk && !broken && (n.y > 0.5 || (abs(n.x) > 0.5 && (nloc.y > 0.05 || abs(lp.x) > hw + 0.4)));
    if (roof_out) {
        let m = facade::mass_of(v.v1, v.v2, v.v3, id);
        s = facade::shade(m, lp, nloc, true, X, Y, Z, eye, s_in, params.night, params.room_day, params.room_night).s;
    } else if (outer && !roofk) {
        // The building's outside, as it drew it.
        let m = facade::mass_of(v.v1, v.v2, v.v3, id);
        let o = facade::shade(m, lp, n, false, X, Y, Z, eye, s_in, params.night, params.room_day, params.room_night);
        s = o.s;
        // Held open (standing whole): its glass cut over the floors built, as
        // the building drew it, the rooms and their panes behind.
        let wy = masses[mi * 4].y + lp.y;
        if (!moved && mi < open_state.len()) {
            let op = open_state[mi];
            if (op.x > 0.0 && wy > op.y && wy < op.z && o.hole > 0.5 && scene::band_dither(frag_coord().xy) < op.x) { s.alpha = 0.0; }
        }
    } else if (broken) {
        // A break: the jagged surface's own normal, the material raw.
        let wp = v.world_pos;
        var nn = normalize(cross(dpdx(wp), dpdy(wp)));
        if (dot(nn, eye) > 0.0) { nn = -nn; }
        s.normal = nn;
        // The face's two other axes, for patterns across it.
        var a = lp.y;
        var b = lp.z;
        if (abs(n.y) > 0.5) { a = lp.x; b = lp.z; } else if (abs(n.z) > 0.5) { a = lp.x; b = lp.y; }
        let grain = vn3(lp * 9.0, 11u);
        let speck = lattice(floor(lp.x * 40.0), floor(lp.y * 40.0), floor(lp.z * 40.0), 13u);
        if (mat == MAT_MASONRY) {
            // Brick and mortar in section, courses of 75 mm, the wall's own colour.
            let row = floor(b / 0.075);
            let mortar = max(facade::pulse(b / 0.075, 0.0, 0.16, fpx / 0.075), facade::pulse(a / 0.23 + 0.5 * row, 0.0, 0.06, fpx / 0.23));
            let brick = facade::wall_color(style, hue) * (0.85 + 0.3 * speck);
            s.base_color = mix(brick, vec3<f32>(0.46, 0.44, 0.40), mortar * 0.85);
            s.roughness = 0.95;
        } else if (mat == MAT_GLASS || mat == MAT_STEEL) {
            // The frame's metal, torn.
            s.base_color = vec3<f32>(0.42, 0.43, 0.44) * (0.8 + 0.4 * grain);
            s.metallic = 0.7;
            s.roughness = 0.45;
        } else if (mat == MAT_TIMBER) {
            s.base_color = vec3<f32>(0.42, 0.30, 0.18) * (0.75 + 0.5 * vn3(vec3<f32>(a * 2.0, b * 30.0, 0.0), 17u));
            s.roughness = 0.9;
        } else {
            // Concrete: cement paste, aggregate in it, voids, and its rebar.
            var cc = vec3<f32>(0.52, 0.51, 0.48) * (0.86 + 0.28 * grain);
            let near = 1.0 - smoothstep(0.01, 0.03, fpx);
            cc = mix(cc, vec3<f32>(0.36, 0.35, 0.33), select(speck > 0.82, 0.8 * near, 0.0));
            cc = mix(cc, vec3<f32>(0.66, 0.64, 0.60), select(speck < 0.1, 0.7 * near, 0.0));
            let bare = vn3(vec3<f32>(a * 1.3, b * 1.3, 0.0) + lp * 0.4, 23u);
            let rb = rebar(a, b, fpx, bare) * select(kind == KIND_FOUNDATION, 0.0, 1.0);
            s.base_color = mix(cc, vec3<f32>(0.22, 0.13, 0.08), rb);
            s.metallic = 0.4 * rb;
            s.roughness = mix(0.95, 0.6, rb);
        }
    } else {
        // Held open (standing whole): an outer wall's inner face is cut
        // through where its window is, so the rooms behind show, as through
        // the building's hollow walls.
        if (!moved && kind == KIND_WALL && abs(n.y) < 0.5 && mi < open_state.len()) {
            let op = open_state[mi];
            let wy = masses[mi * 4].y + lp.y;
            if (op.x > 0.0 && wy > op.y && wy < op.z) {
                var po = lp;
                var no = vec3<f32>(0.0, 0.0, 0.0);
                if (n.z < -0.5 && lp.z > hd - 0.6) { po.z = hd; no.z = 1.0; }
                else if (n.z > 0.5 && lp.z < -hd + 0.6) { po.z = -hd; no.z = -1.0; }
                else if (n.x < -0.5 && lp.x > hw - 0.6) { po.x = hw; no.x = 1.0; }
                else if (n.x > 0.5 && lp.x < -hw + 0.6) { po.x = -hw; no.x = -1.0; }
                if (dot(no, no) > 0.5) {
                    let m = facade::mass_of(v.v1, v.v2, v.v3, id);
                    let o = facade::shade(m, po, no, false, X, Y, Z, eye, s_in, params.night, params.room_day, params.room_night);
                    if (o.hole > 0.5 && scene::band_dither(frag_coord().xy) < op.x) { s.alpha = 0.0; }
                }
            }
        }
        // Inside the building: a floor, a ceiling, a wall's inner face, a column.
        let rh = facade::hash3(floor(lp.x / 6.0), floor(lp.y / 3.0), id);
        let office = style == facade::STYLE_GLASS || style == facade::STYLE_OFFICE;
        if (kind == KIND_SLAB && n.y > 0.5) {
            if (office) {
                // Carpet tiles, half a metre.
                let t = facade::hash3(floor(lp.x / 0.5), floor(lp.z / 0.5), id + 3.0);
                s.base_color = mix(vec3<f32>(0.20, 0.22, 0.26), vec3<f32>(0.30, 0.30, 0.31), fract(rh * 3.1)) * (0.92 + 0.16 * t);
                s.roughness = 0.95;
            } else if (style == facade::STYLE_INDUSTRIAL || style == facade::STYLE_PLANT) {
                s.base_color = vec3<f32>(0.44, 0.43, 0.41) * (0.9 + 0.2 * vn3(lp * 0.7, 5u));
                s.roughness = 0.8;
            } else {
                // Boards 15 cm wide, each its own shade, their joints dark.
                let board = floor(lp.x / 0.15);
                let t = facade::hash3(board, floor(lp.z / 2.4 + facade::hash3(board, 1.0, id)), id + 5.0);
                let jn = facade::pulse(lp.x / 0.15, 0.0, 0.05, fpx / 0.15);
                s.base_color = mix(vec3<f32>(0.36, 0.22, 0.12), vec3<f32>(0.48, 0.34, 0.20), t) * (1.0 - 0.5 * jn);
                s.roughness = 0.6;
            }
        } else if (kind == KIND_SLAB && n.y < -0.5) {
            // Ceilings: an office's tiles on a grid, a home's plaster.
            var cc = vec3<f32>(0.70, 0.69, 0.66);
            if (office) {
                let g = max(facade::pulse(lp.x / 0.6, 0.0, 0.04, fpx / 0.6), facade::pulse(lp.z / 0.6, 0.0, 0.04, fpx / 0.6));
                cc = mix(cc, vec3<f32>(0.55, 0.55, 0.55), g);
            }
            s.base_color = cc;
            s.roughness = 0.9;
        } else if (kind == KIND_WALL && abs(n.y) < 0.5) {
            if (mat == MAT_GLASS) {
                // A curtain wall seen from inside: its glass, dark against the room.
                s.base_color = vec3<f32>(0.04, 0.05, 0.055);
                s.roughness = 0.08;
            } else {
                // Plaster, the rooms' colour, a skirting board at the floor.
                let wc = mix(vec3<f32>(0.62, 0.58, 0.50), vec3<f32>(0.48, 0.52, 0.56), rh);
                let fy = fract((lp.y - v.v2.x) / v.v1.w);
                let skirt = select(lp.y < v.v2.x, facade::band(lp.y, 0.0, 0.1, fpx), facade::band(fy * v.v1.w, 0.3, 0.4, fpx));
                s.base_color = mix(wc, vec3<f32>(0.85, 0.84, 0.80), skirt);
                s.roughness = 0.85;
            }
        } else if (roofk) {
            // Under a pitched roof: rafters 0.6 m apart over boards.
            let raf = facade::pulse(lp.x / 0.6, 0.0, 0.12, fpx / 0.6);
            s.base_color = mix(vec3<f32>(0.40, 0.30, 0.20), vec3<f32>(0.30, 0.21, 0.13), raf) * (0.85 + 0.3 * vn3(vec3<f32>(lp.x * 0.5, 0.0, lp.z * 6.0), 29u));
            s.roughness = 0.85;
        } else {
            // Columns, slab edges, foundations: cast concrete, its formwork's lines.
            let fl = facade::pulse(lp.y / 1.2, 0.0, 0.02, fpx / 1.2);
            s.base_color = vec3<f32>(0.50, 0.49, 0.46) * (0.9 + 0.2 * vn3(lp * 2.0, 3u)) * (1.0 - 0.25 * fl);
            if (kind == KIND_FOUNDATION) { s.base_color *= 0.75; }
            s.roughness = 0.9;
        }
    }
    if (moved) {
        // Down and through the dust: coated in it, the upturned faces most;
        // the rooms' lights are out. The street lamps (facade.bk's row,
        // 1600 cd 30 m apart 8 m up, 7 m out) still reach it where it is
        // now: by its height above the building's ground, and by how its
        // face turns to them (from above and aside: an upturned face all of
        // a street front's share, a side under half, an underside none, so
        // a heap is lit on its tops and dark in its gaps, not aglow through).
        let up = max(dot(s.normal, vec3<f32>(0.0, 1.0, 0.0)), 0.0);
        // (Every face takes some, in patches; the rooms' pale ceilings and
        // walls do not show clean through a fall.)
        let k = coat * (0.45 + 0.1 * vn3(lp * 0.9, 17u) + 0.4 * up * (0.6 + 0.4 * vn3(lp * 1.7, 19u)));
        // Each chunk its own: a shade lighter or darker, warmer or greyer.
        let dust = vec3<f32>(0.47, 0.45, 0.42) * (0.78 + 0.4 * tone) + vec3<f32>(0.02, 0.01, -0.02) * (fract(tone * 7.3) - 0.5);
        s.base_color = mix(s.base_color, dust, k);
        // And its faces under the dust darkened a little, by the chunk, so
        // a pile reads as many pieces, not one pale mass.
        s.base_color *= mix(1.0, 0.8 + 0.3 * fract(tone * 3.7), coat);
        s.roughness = mix(s.roughness, 0.95, k);
        s.metallic *= 1.0 - k;
        let dy = camera.eye_world.y + v.world_pos.y - masses[mi * 4].y - 8.0;
        let facing = clamp(0.4 + 0.6 * s.normal.y, 0.0, 1.0);
        let e = 2.0 * 1600.0 * 7.0 / (30.0 * (49.0 + dy * dy)) * facing;
        let lamps = s.base_color * vec3<f32>(1.0, 0.82, 0.62) * (e * params.night / 3.14159265);
        // The lamps reach every moved piece; the rooms' glow behind its glass
        // goes out with the coat (where the facade's own lamp term is the
        // larger, it stands for both).
        s.emissive = max(mix(s.emissive, lamps, coat), lamps);
    }
    if (params.debug > 2.5) {
        // 3: the dust coat, red full to blue none (standing: black).
        s.base_color = select(moved, vec3<f32>(coat, 0.0, 1.0 - coat), vec3<f32>(0.0, 0.0, 0.0));
        s.metallic = 0.0;
        s.emissive = vec3<f32>(0.0, 0.0, 0.0);
    } else if (params.debug > 1.5) {
        s.base_color = vec3<f32>(0.5, 0.5, 0.5);
        s.metallic = 0.0;
        s.emissive = vec3<f32>(0.0, 0.0, 0.0);
    } else if (params.debug > 0.5) {
        s.base_color = select(outer, vec3<f32>(0.8, 0.1, 0.1), select(broken, vec3<f32>(0.1, 0.8, 0.1), vec3<f32>(0.1, 0.1, 0.8)));
        s.metallic = 0.0;
        s.emissive = vec3<f32>(0.0, 0.0, 0.0);
    }
    return s;
}
