// lib/city/building.bk — every mass of a city's buildings, one instanced box
// (and one roof prism), drawn the same way at every distance.
//
// The vertex stage places a unit box from the instance's mass record (see
// buildings.js: centre, yaw, half extents, height, foundation). The fragment
// stage draws the facade from the same record (facade.bk: floors, bays,
// windows, a shop front, and behind every window a room), and cuts the
// windows of a building open to its interior.
module hook;
import scene;
import mesh;
import custom;
import facade;

struct Params {
    night: f32,      // 0 day .. 1 night: how many rooms are lit, how bright
    room_day: f32,   // a room's luminance by day, cd/m^2 per unit albedo
    room_night: f32, // a lit room's luminance at night, cd/m^2 per unit albedo
    part: f32,       // 0 walls (box), 1 roof (prism)
}

@binding(4, 0) var params: uniform<Params>;
@binding(4, 14) var masses: read_buffer<vec4<f32>>;
@binding(4, 15) var ids: read_buffer<i32>;   // the mass each instance draws
// Per mass, its building open (interior.js): x the share of the cut made
// (0..1, dithered on the wall: a crossfade to the rooms built), its windows
// and door cut from world height y to z.
@binding(4, 16) var open_state: read_buffer<vec4<f32>>;

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    let i = ids[v.instance_index];
    let r0 = masses[i * 4];
    let r1 = masses[i * 4 + 1];
    let r2 = masses[i * 4 + 2];
    let r3 = masses[i * 4 + 3];
    let yaw = r0.w;
    let hw = r1.x;
    let h = r1.y;
    let hd = r1.z;
    let roof = r3.x;
    let roof_h = r3.y;
    let p = v.pos;
    var lp = vec3<f32>(0.0, 0.0, 0.0);
    var ln = v.normal;
    // A mass taken down (4: destruction.js draws it as its pieces) or hidden
    // from view (8): nothing.
    let gone = ((r3.z + 0.5) as i32 & 12) != 0;

    if (gone) {
        lp = vec3<f32>(0.0, -100000.0, 0.0);
    } else if (params.part < 0.5) {
        // Unit box centred on the origin: x, z in [-0.5, 0.5], y in [-0.5, 0.5].
        let ty = p.y + 0.5;
        lp = vec3<f32>(p.x * 2.0 * hw, mix(-r2.y, h, ty), p.z * 2.0 * hd);
    } else {
        // Roof prism: base rectangle at y 0, ridge at y 1 along x.
        if (roof < 0.5) {
            lp = vec3<f32>(0.0, -100000.0, 0.0);     // no pitched roof: collapse
        } else {
            let over = 0.45;
            let rw = hw + over;
            let rd = hd + over;
            var x = p.x * 2.0 * rw;
            if (p.y > 0.5 && roof > 1.5) {
                // Hip: the ridge shortened by the depth, so the ends slope too.
                x = sign(p.x) * max(0.0, hw - hd);
            }
            let y = h + p.y * roof_h - 0.12 * (1.0 - p.y);
            lp = vec3<f32>(x, y, p.z * 2.0 * rd * (1.0 - p.y));
            // Analytic normals of the slopes and the ends.
            if (abs(v.normal.z) > 0.1) {
                ln = normalize(vec3<f32>(0.0, rd, sign(v.normal.z) * roof_h));
            } else if (abs(v.normal.x) > 0.1) {
                if (roof > 1.5) {
                    ln = normalize(vec3<f32>(sign(v.normal.x) * roof_h, max(rw - max(0.0, hw - hd), 0.1), 0.0));
                } else {
                    ln = vec3<f32>(sign(v.normal.x), 0.0, 0.0);
                }
            } else {
                ln = vec3<f32>(0.0, -1.0, 0.0);
            }
        }
    }

    let c = cos(yaw);
    let s = sin(yaw);
    let wx = r0.x + c * lp.x + s * lp.z;
    let wz = r0.z - s * lp.x + c * lp.z;
    let wy = r0.y + lp.y;
    // Node space: the engine takes it eye-relative (the node's model matrix less the eye).
    v.pos = vec3<f32>(wx, wy, wz);
    v.normal = vec3<f32>(c * ln.x + s * ln.z, ln.y, -s * ln.x + c * ln.z);
    v.v0 = vec4<f32>(lp, 0.0);
    v.v1 = vec4<f32>(hw, h, hd, r1.w);
    v.v2 = r2;
    v.v3 = r3;
    v.v4 = vec4<f32>(ln, yaw);
    v.v5 = vec4<f32>(r0.xyz, i as f32);
    // The mass's id for its hashes, made here from the record (exact) and
    // passed flat: the seed interpolated arrives an ulp off, and where
    // seed * 2^20 is whole its floor then flips pixel by pixel (a window lit
    // or dark, a brick's tone, from one pixel to the next).
    v.vi = vec4<i32>(floor(r2.z * 1048576.0) as i32, 0, 0, 0);
    return v;
}

pub fn fragment(v: mesh::Vertex, s_in: mesh::Surface) -> mesh::Surface {
    let yaw = v.v4.w;
    let c = cos(yaw);
    let sn = sin(yaw);
    let m = facade::mass_of(v.v1, v.v2, v.v3, v.vi.x as f32);
    let o = facade::shade(m, v.v0.xyz, v.v4.xyz, params.part > 0.5,
                          vec3<f32>(c, 0.0, -sn), vec3<f32>(0.0, 1.0, 0.0), vec3<f32>(sn, 0.0, c),
                          normalize(v.world_pos), s_in, params.night, params.room_day, params.room_night);
    var s = o.s;

    // An open building (interior.js builds its rooms): the glass of its
    // windows and its door are cut over the floors built, to see in and go in.
    let wy = v.v5.y + v.v0.y;
    let mi = (v.v5.w + 0.5) as i32;
    if (mi < open_state.len()) {
        let op = open_state[mi];
        if (op.x > 0.0 && wy > op.y && wy < op.z) {
            // The engine's per-pixel band dither, as its LOD fades use, so the
            // rooms dissolve in at the finest grain.
            let dith = scene::band_dither(frag_coord().xy);
            if (o.hole > 0.5 && dith < op.x) { s.alpha = 0.0; }
        }
    }
    return s;
}
