// Opaque mid-tier interior-parallax facade & roof shader for metropolis buildings.
// Rich architectural styles: glass curtain walls, Art-Deco limestone, brick storefronts, clapboard homes.
module hook;
import mesh;
import scene;

struct ParallaxParams {
    glow_scale: f32,
    night_factor: f32,
    time: f32,
    pad0: f32,
}

@binding(4, 0) var params: uniform<ParallaxParams>;
@binding(4, 14) var shell_meta: read_buffer<vec4<f32>>;

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    let inst = v_in.instance_index;
    let meta0 = shell_meta[inst * 2];
    let meta1 = shell_meta[inst * 2 + 1];
    v.v0 = vec4<f32>(v_in.pos.x * meta0.x, v_in.pos.y * meta0.y + meta1.z, v_in.pos.z * meta0.z, meta0.w);
    v.v1 = meta1;
    v.v2 = vec4<f32>(v_in.normal, 0.0);
    return v;
}

fn hash21(p: vec2<f32>, seed: f32) -> f32 {
    let q = vec2<f32>(dot(p, vec2<f32>(127.1, 311.7)) + seed * 17.3, dot(p, vec2<f32>(269.5, 183.3)) + seed * 43.7);
    return fract(sin(q.x * 0.13 + q.y * 0.27) * 43758.5453);
}

fn vnoise2(p: vec2<f32>, seed: f32) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (vec2<f32>(3.0, 3.0) - f * 2.0);
    let a = hash21(i, seed);
    let b = hash21(i + vec2<f32>(1.0, 0.0), seed);
    let c = hash21(i + vec2<f32>(0.0, 1.0), seed);
    let d = hash21(i + vec2<f32>(1.0, 1.0), seed);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

fn fbm2(p: vec2<f32>, seed: f32) -> f32 {
    return 0.62 * vnoise2(p, seed) + 0.38 * vnoise2(p * 2.31 + vec2<f32>(7.1, 13.7), seed);
}

pub fn fragment(v: mesh::Vertex, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    out.alpha = 1.0;

    let seed = v.v1.x;
    let kind = floor(v.v1.y + 0.5) as i32;  // 0=home, 1=business, 2=skyscraper
    let style = floor(v.v1.w + 0.5) as i32; // 0..3 architectural facade variant
    let floor_h = max(2.6, v.v0.w);
    let ln = v.v2.xyz;

    let roof_p = vec2<f32>(v.v0.x, v.v0.z);
    let wx = abs(ln.z) > 0.5 ? (ln.z > 0.0 ? v.v0.x : -v.v0.x) : (ln.x > 0.0 ? -v.v0.z : v.v0.z);
    let wy = max(0.0, v.v0.y);
    let wall_p = vec2<f32>(wx, wy);

    let dp_wall = max(length(dpdx(wall_p)), length(dpdy(wall_p)));
    let dp_roof = max(length(dpdx(roof_p)), length(dpdy(roof_p)));
    let detail_wall = 1.0 - smoothstep(0.08, 0.38, dp_wall);
    let detail_roof = 1.0 - smoothstep(0.10, 0.45, dp_roof);

    let g_wall = fbm2(wall_p * 1.8, seed) - 0.5;
    let gx_w = (vnoise2(wall_p * 3.4 + vec2<f32>(0.08, 0.0), seed) - vnoise2(wall_p * 3.4 - vec2<f32>(0.08, 0.0), seed)) * detail_wall * 3.2;
    let gy_w = (vnoise2(wall_p * 3.4 + vec2<f32>(0.0, 0.08), seed) - vnoise2(wall_p * 3.4 - vec2<f32>(0.0, 0.08), seed)) * detail_wall * 3.2;

    let g_roof = fbm2(roof_p * 0.5, seed) - 0.5;
    let gx_r = (vnoise2(roof_p * 2.2 + vec2<f32>(0.1, 0.0), seed) - vnoise2(roof_p * 2.2 - vec2<f32>(0.1, 0.0), seed)) * detail_roof * 3.2;
    let gy_r = (vnoise2(roof_p * 2.2 + vec2<f32>(0.0, 0.1), seed) - vnoise2(roof_p * 2.2 - vec2<f32>(0.0, 0.1), seed)) * detail_roof * 3.2;

    let n = normalize(v.normal);
    let t = normalize(v.tangent.xyz);
    let b = normalize(v.bitangent);
    var debug_col = vec3<f32>(0.25, 0.35, 0.45);

    if (abs(ln.y) > 0.6) {
        let rx_e = fract(abs(v.v0.x) * 0.12);
        let rz_e = fract(abs(v.v0.z) * 0.12);
        let parapet_seam = 1.0 - 0.08 * smoothstep(0.46, 0.495, max(abs(rx_e - 0.5), abs(rz_e - 0.5))) * detail_roof;
        let roof_base = kind == 0 ? vec3<f32>(0.24, 0.22, 0.21) : vec3<f32>(0.34, 0.35, 0.37);
        out.base_color = roof_base * clamp(1.0 + 0.14 * g_roof, 0.82, 1.16) * parapet_seam;
        out.roughness = 0.86;
        out.metallic = 0.04;
        out.normal = normalize(n + t * (gx_r * 0.08) + b * (gy_r * 0.08));
        debug_col = vec3<f32>(0.35, 0.35, 0.38);
    } else {
        let is_curtain = (kind == 2 && (style == 0 || style == 3));
        let bay_w = kind == 2 ? (is_curtain ? 2.4 : 3.2) : (kind == 1 ? 3.2 : 2.6);
        let bay_i = floor(wx / bay_w);
        let floor_j = floor(wy / floor_h);
        let bu = fract(wx / bay_w);
        let bv = fract(wy / floor_h);

        let is_storefront = (kind == 1 && floor_j < 0.5);
        let margin_x = kind == 2 ? (is_curtain ? 0.05 : 0.18) : (is_storefront ? 0.07 : 0.24);
        let sill_y = kind == 2 ? (is_curtain ? 0.12 : 0.20) : (is_storefront ? 0.06 : 0.30);
        let lintel_y = kind == 2 ? (is_curtain ? 0.94 : 0.88) : (is_storefront ? 0.88 : 0.82);
        let in_win = bu > margin_x && bu < (1.0 - margin_x) && bv > sill_y && bv < lintel_y;

        if (!in_win) {
            let is_spandrel = bv <= sill_y || bv >= lintel_y;
            let masonry_brick = (kind == 1 || (kind == 0 && style == 1));
            var wall_tint = s.base_color;
            if (kind == 2 && style == 1) { wall_tint = vec3<f32>(0.68, 0.64, 0.56); }
            else if (kind == 2 && style == 2) { wall_tint = vec3<f32>(0.24, 0.27, 0.32); }
            else if (kind == 1 && style == 0) { wall_tint = vec3<f32>(0.54, 0.31, 0.24); }
            else if (kind == 0 && style == 1) { wall_tint = vec3<f32>(0.58, 0.35, 0.27); }

            let clapboard = (kind == 0 && style != 1) ? (0.91 + 0.07 * sin(wy * 28.0) * detail_wall) : 1.0;
            let brick_row = masonry_brick ? (0.92 + 0.06 * smoothstep(0.82, 0.96, fract(wy * 7.5)) * detail_wall) : 1.0;
            let cornice = is_spandrel ? (kind == 2 && is_curtain ? 0.72 : 0.86) : 0.96;
            let frame_shut = (kind == 0 && bv > sill_y && bv < lintel_y && (abs(bu - margin_x) < 0.055 || abs(bu - (1.0 - margin_x)) < 0.055));

            let fac_albedo = wall_tint * clamp(1.0 + 0.16 * g_wall * detail_wall, 0.82, 1.12) * clapboard * brick_row * cornice;
            out.base_color = frame_shut ? vec3<f32>(0.22, 0.26, 0.30) : min(vec3<f32>(0.50), fac_albedo);
            out.roughness = is_curtain ? 0.34 : 0.80;
            out.metallic = is_curtain ? 0.55 : 0.03;
            out.normal = normalize(n + t * (gx_w * 0.14) + b * (gy_w * 0.14));
            debug_col = vec3<f32>(0.45, 0.45, 0.48);
        } else {
            let wu = (bu - margin_x) / (1.0 - 2.0 * margin_x);
            let wv = (bv - sill_y) / (lintel_y - sill_y);

            let face_id = abs(ln.x) > 0.5 ? (ln.x > 0.0 ? 1.0 : 2.0) : (ln.z > 0.0 ? 3.0 : 4.0);
            let h_room = hash21(vec2<f32>(bay_i + face_id * 31.0, floor_j), seed);
            let h_warm = hash21(vec2<f32>(bay_i * 3.0 + 7.0, floor_j * 5.0 + face_id), seed);

            let mull_off = 0.46 + 0.08 * h_warm;
            let is_mullion = (kind == 2 && (abs(wu - 0.5) < 0.024 || abs(wv - 0.5) < 0.020))
                          || (kind != 2 && h_room > 0.32 && abs(wu - mull_off) < 0.032)
                          || (kind == 0 && (abs(wv - 0.50) < 0.030 || wu < 0.04 || wu > 0.96 || wv < 0.04 || wv > 0.96));
            if (is_mullion) {
                let trim_col = kind == 0 ? vec3<f32>(0.50, 0.49, 0.46) : (style == 1 ? vec3<f32>(0.34, 0.31, 0.26) : vec3<f32>(0.22, 0.25, 0.29));
                out.base_color = trim_col;
                out.roughness = kind == 0 ? 0.52 : 0.34;
                out.metallic = kind == 0 ? 0.04 : 0.68;
                out.normal = n;
                debug_col = vec3<f32>(0.20, 0.22, 0.26);
            } else {
                let I = normalize(v.world_pos);
                let rx_ray = dot(I, t);
                let ry_ray = dot(I, b);
                let rz_ray = min(-0.02, dot(I, n));

                let room_depth = 1.45;
                let px = wu * 2.0 - 1.0;
                let py = wv * 2.0 - 1.0;

                let tx = rx_ray > 0.0 ? (1.0 - px) / max(rx_ray, 1e-4) : (-1.0 - px) / min(rx_ray, -1e-4);
                let ty = ry_ray > 0.0 ? (1.0 - py) / max(ry_ray, 1e-4) : (-1.0 - py) / min(ry_ray, -1e-4);
                let tz = -room_depth / rz_ray;

                let t_hit = min(tz, min(tx, ty));
                let hit = vec3<f32>(px + rx_ray * t_hit, py + ry_ray * t_hit, rz_ray * t_hit);

                let t_mid = (-0.58 * room_depth) / rz_ray;
                let mid_p = vec2<f32>(px + rx_ray * t_mid, py + ry_ray * t_mid);
                let curtain_edge = 0.32 + 0.36 * h_warm + 0.16 * sin(mid_p.y * 2.8 + h_room * 6.28);
                let mid_card = (mid_p.x > curtain_edge || (abs(mid_p.x) < 0.72 && mid_p.y < -0.22 + 0.15 * mid_p.x && mid_p.y > -0.98));

                let lit_prob = is_storefront ? 0.88 : mix(0.26, 0.70, smoothstep(0.10, 0.75, params.night_factor));
                let is_lit = h_room < lit_prob;

                var wall_col = vec3<f32>(0.24, 0.26, 0.30);
                if (hit.y > 0.92) { wall_col = vec3<f32>(0.85, 0.83, 0.78); }
                else if (hit.y < -0.92) { wall_col = vec3<f32>(0.40, 0.35, 0.29); }
                else if (t_hit < tz - 0.01) { wall_col = vec3<f32>(0.54, 0.50, 0.45); }
                else { wall_col = vec3<f32>(0.64, 0.59, 0.53); }
                if (mid_card) { wall_col *= 0.55; }

                let warm_tint = mix(vec3<f32>(1.0, 0.87, 0.66), vec3<f32>(0.84, 0.93, 1.0), step(0.66, h_warm));
                let room_shade = is_lit ? warm_tint * wall_col * (0.88 + 0.35 * h_warm) : wall_col * 0.30;

                var glass_tint = vec3<f32>(0.10, 0.15, 0.20);
                if (kind == 2 && style == 0) { glass_tint = vec3<f32>(0.15, 0.27, 0.36); }
                else if (kind == 2 && style == 3) { glass_tint = vec3<f32>(0.26, 0.24, 0.21); }
                else if (kind == 2 && style == 1) { glass_tint = vec3<f32>(0.18, 0.16, 0.14); }

                out.base_color = min(vec3<f32>(0.38), mix(room_shade, glass_tint, is_lit ? 0.30 : 0.66));
                out.roughness = kind == 2 ? 0.20 : 0.34;
                out.metallic = kind == 2 ? 0.20 : 0.06;
                out.normal = n;

                if (is_lit) {
                    let glow = mix(0.02, 0.30, smoothstep(0.55, 0.95, params.night_factor));
                    let ceiling_boost = hit.y > 0.90 ? 1.10 : 0.85;
                    out.emissive = min(vec3<f32>(0.28), warm_tint * wall_col * ceiling_boost * glow);
                }
                debug_col = is_lit ? vec3<f32>(1.0, 0.75, 0.2) : vec3<f32>(0.15, 0.35, 0.6);
            }
        }
    }

    if (SCENE_DEBUG(mat_id)) {
        out = mesh::debug(out, debug_col);
    }
    return out;
}
