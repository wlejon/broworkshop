// Opaque mid-tier interior-parallax facade & roof shader for metropolis buildings.
// Clean architectural masonry/curtain-wall/siding PBR + crisp sky-reflective glass + warm night rooms.
module hook;
import mesh;
import scene;

struct ParallaxParams {
    glow_scale: f32,
    night_factor: f32,
    time: f32,
    pad0: f32,
}

@binding(4, 0) var params: uniform<ParallaxParams>;
@binding(4, 14) var shell_meta: read_buffer<vec4<f32>>;

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    let inst = v_in.instance_index;
    let meta0 = shell_meta[inst * 2];
    let meta1 = shell_meta[inst * 2 + 1];
    v.v0 = vec4<f32>(v_in.pos.x * meta0.x, v_in.pos.y * meta0.y + meta1.z, v_in.pos.z * meta0.z, meta0.w);
    v.v1 = meta1;
    v.v2 = vec4<f32>(v_in.normal, 0.0);
    return v;
}

fn hash21(p: vec2<f32>, seed: f32) -> f32 {
    let q = vec2<f32>(dot(p, vec2<f32>(127.1, 311.7)) + seed * 17.3, dot(p, vec2<f32>(269.5, 183.3)) + seed * 43.7);
    return fract(sin(q.x * 0.13 + q.y * 0.27) * 43758.5453);
}

fn vnoise2(p: vec2<f32>, seed: f32) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (vec2<f32>(3.0, 3.0) - f * 2.0);
    let a = hash21(i, seed);
    let b = hash21(i + vec2<f32>(1.0, 0.0), seed);
    let c = hash21(i + vec2<f32>(0.0, 1.0), seed);
    let d = hash21(i + vec2<f32>(1.0, 1.0), seed);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

fn fbm2(p: vec2<f32>, seed: f32) -> f32 {
    return 0.62 * vnoise2(p, seed) + 0.38 * vnoise2(p * 2.31 + vec2<f32>(7.1, 13.7), seed);
}

pub fn fragment(v: mesh::Vertex, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    out.alpha = 1.0;

    let seed = v.v1.x;
    let kind = floor(v.v1.y + 0.5) as i32; // 0=home, 1=business, 2=skyscraper
    let floor_h = max(2.6, v.v0.w);
    let ln = v.v2.xyz;

    let roof_p = vec2<f32>(v.v0.x, v.v0.z);
    let wx = abs(ln.z) > 0.5 ? (ln.z > 0.0 ? v.v0.x : -v.v0.x) : (ln.x > 0.0 ? -v.v0.z : v.v0.z);
    let wy = max(0.0, v.v0.y);
    let wall_p = vec2<f32>(wx, wy);

    // Distance fade so sub-pixel wall grain smoothly vanishes without moire
    let dp_wall = max(length(dpdx(wall_p)), length(dpdy(wall_p)));
    let dp_roof = max(length(dpdx(roof_p)), length(dpdy(roof_p)));
    let detail_wall = 1.0 - smoothstep(0.08, 0.35, dp_wall);
    let detail_roof = 1.0 - smoothstep(0.10, 0.42, dp_roof);

    let g_wall = fbm2(wall_p * 1.6, seed) - 0.5;
    let gx_w = (vnoise2(wall_p * 3.4 + vec2<f32>(0.08, 0.0), seed) - vnoise2(wall_p * 3.4 - vec2<f32>(0.08, 0.0), seed)) * detail_wall;
    let gy_w = (vnoise2(wall_p * 3.4 + vec2<f32>(0.0, 0.08), seed) - vnoise2(wall_p * 3.4 - vec2<f32>(0.0, 0.08), seed)) * detail_wall;

    let g_roof = fbm2(roof_p * 0.45, seed) - 0.5;
    let gx_r = (vnoise2(roof_p * 2.2 + vec2<f32>(0.1, 0.0), seed) - vnoise2(roof_p * 2.2 - vec2<f32>(0.1, 0.0), seed)) * detail_roof;
    let gy_r = (vnoise2(roof_p * 2.2 + vec2<f32>(0.0, 0.1), seed) - vnoise2(roof_p * 2.2 - vec2<f32>(0.0, 0.1), seed)) * detail_roof;

    let n = normalize(v.normal);
    let t = normalize(v.tangent.xyz);
    let b = normalize(v.bitangent);
    var debug_col = vec3<f32>(0.25, 0.35, 0.45);

    if (abs(ln.y) > 0.6) {
        // Architectural roof deck + subtle gravel membrane
        let rx_e = fract(abs(v.v0.x) * 0.12);
        let rz_e = fract(abs(v.v0.z) * 0.12);
        let parapet_seam = 1.0 - 0.08 * smoothstep(0.46, 0.495, max(abs(rx_e - 0.5), abs(rz_e - 0.5))) * detail_roof;
        let roof_base = kind == 0 ? vec3<f32>(0.26, 0.23, 0.22) : vec3<f32>(0.34, 0.35, 0.37);
        out.base_color = roof_base * clamp(1.0 + 0.12 * g_roof, 0.82, 1.15) * parapet_seam;
        out.roughness = 0.86;
        out.metallic = 0.04;
        out.normal = normalize(n + t * (gx_r * 0.08) + b * (gy_r * 0.08));
        debug_col = vec3<f32>(0.35, 0.35, 0.38);
    } else {
        let bay_w = kind == 2 ? 3.2 : (kind == 1 ? 3.2 : 2.7);
        let bay_i = floor(wx / bay_w);
        let floor_j = floor(wy / floor_h);
        let bu = fract(wx / bay_w);
        let bv = fract(wy / floor_h);

        let is_storefront = (kind == 1 && floor_j < 0.5);
        let margin_x = kind == 2 ? 0.10 : (is_storefront ? 0.08 : 0.22);
        let sill_y = kind == 2 ? 0.18 : (is_storefront ? 0.06 : 0.28);
        let lintel_y = kind == 2 ? 0.91 : (is_storefront ? 0.88 : 0.82);
        let in_win = bu > margin_x && bu < (1.0 - margin_x) && bv > sill_y && bv < lintel_y;

        if (!in_win) {
            let is_spandrel = bv <= sill_y || bv >= lintel_y;
            let course_band = kind == 0 ? (0.94 + 0.06 * sin(wy * 24.0) * detail_wall) : (is_spandrel ? 0.86 : 1.02);
            let wall_mod = clamp(1.0 + 0.10 * g_wall * detail_wall, 0.86, 1.14) * course_band;
            out.base_color = s.base_color * wall_mod;
            out.roughness = kind == 2 ? 0.42 : 0.80;
            out.metallic = kind == 2 ? 0.36 : 0.03;
            out.normal = normalize(n + t * (gx_w * 0.07) + b * (gy_w * 0.07));
            debug_col = vec3<f32>(0.45, 0.45, 0.48);
        } else {
            let wu = (bu - margin_x) / (1.0 - 2.0 * margin_x);
            let wv = (bv - sill_y) / (lintel_y - sill_y);

            let face_id = abs(ln.x) > 0.5 ? (ln.x > 0.0 ? 1.0 : 2.0) : (ln.z > 0.0 ? 3.0 : 4.0);
            let h_room = hash21(vec2<f32>(bay_i + face_id * 31.0, floor_j), seed);
            let h_warm = hash21(vec2<f32>(bay_i * 3.0 + 7.0, floor_j * 5.0 + face_id), seed);

            let mull_off = 0.44 + 0.12 * h_warm;
            let is_mullion = (kind == 2 && (abs(wu - 0.5) < 0.025 || abs(wv - 0.5) < 0.022))
                          || (kind != 2 && h_room > 0.35 && abs(wu - mull_off) < 0.032)
                          || (kind == 0 && abs(wv - 0.50) < 0.030);
            if (is_mullion) {
                let trim_col = kind == 0 ? vec3<f32>(0.82, 0.81, 0.78) : vec3<f32>(0.22, 0.24, 0.27);
                out.base_color = trim_col;
                out.roughness = kind == 0 ? 0.55 : 0.36;
                out.metallic = kind == 0 ? 0.05 : 0.65;
                out.normal = n;
                debug_col = vec3<f32>(0.20, 0.22, 0.26);
            } else {
                // Ray-box interior parallax room behind crisp reflective glass
                let I = normalize(v.world_pos);
                let rx_ray = dot(I, t);
                let ry_ray = dot(I, b);
                let rz_ray = min(-0.02, dot(I, n));

                let room_depth = 1.45;
                let px = wu * 2.0 - 1.0;
                let py = wv * 2.0 - 1.0;

                let tx = rx_ray > 0.0 ? (1.0 - px) / max(rx_ray, 1e-4) : (-1.0 - px) / min(rx_ray, -1e-4);
                let ty = ry_ray > 0.0 ? (1.0 - py) / max(ry_ray, 1e-4) : (-1.0 - py) / min(ry_ray, -1e-4);
                let tz = -room_depth / rz_ray;

                let t_hit = min(tz, min(tx, ty));
                let hit = vec3<f32>(px + rx_ray * t_hit, py + ry_ray * t_hit, rz_ray * t_hit);

                let t_mid = (-0.58 * room_depth) / rz_ray;
                let mid_p = vec2<f32>(px + rx_ray * t_mid, py + ry_ray * t_mid);
                let curtain_edge = 0.32 + 0.36 * h_warm + 0.16 * sin(mid_p.y * 2.8 + h_room * 6.28);
                let mid_card = (mid_p.x > curtain_edge || (abs(mid_p.x) < 0.72 && mid_p.y < -0.22 + 0.15 * mid_p.x && mid_p.y > -0.98));

                let lit_prob = is_storefront ? 0.85 : mix(0.24, 0.68, smoothstep(0.10, 0.75, params.night_factor));
                let is_lit = h_room < lit_prob;

                var wall_col = vec3<f32>(0.22, 0.24, 0.28);
                if (hit.y > 0.92) {
                    wall_col = vec3<f32>(0.82, 0.80, 0.76);
                } else if (hit.y < -0.92) {
                    wall_col = vec3<f32>(0.36, 0.32, 0.28);
                } else if (t_hit < tz - 0.01) {
                    wall_col = vec3<f32>(0.50, 0.47, 0.43);
                } else {
                    wall_col = vec3<f32>(0.60, 0.56, 0.51);
                }
                if (mid_card) { wall_col *= 0.52; }

                let warm_tint = mix(vec3<f32>(1.0, 0.86, 0.64), vec3<f32>(0.82, 0.92, 1.0), step(0.68, h_warm));
                let room_shade = is_lit ? warm_tint * wall_col * (0.85 + 0.35 * h_warm) : wall_col * 0.30;

                let glass_tint = kind == 2 ? vec3<f32>(0.14, 0.21, 0.28) : vec3<f32>(0.10, 0.14, 0.18);
                out.base_color = mix(room_shade, glass_tint, is_lit ? 0.32 : 0.68);
                out.roughness = 0.08;
                out.metallic = kind == 2 ? 0.22 : 0.08;
                out.normal = n;

                if (is_lit) {
                    let glow = mix(0.06, 0.48, smoothstep(0.05, 0.65, params.night_factor));
                    let ceiling_boost = hit.y > 0.90 ? 1.15 : 0.85;
                    out.emissive = min(vec3<f32>(0.82), warm_tint * wall_col * ceiling_boost * glow);
                }
                debug_col = is_lit ? vec3<f32>(1.0, 0.75, 0.2) : vec3<f32>(0.15, 0.35, 0.6);
            }
        }
    }

    if (SCENE_DEBUG(mat_id)) {
        out = mesh::debug(out, debug_col);
    }
    return out;
}
