// Band-limited GPU tile compute kernels for natural terrain & macro landcover.
// Noise, river carving, and biome math match world/terrain_field.js bit-for-bit.
import tiles;

const RIVER_BED_Y: f32 = -6.5;

fn sstep(a: f32, b: f32, x: f32) -> f32 {
    let t = clamp((x - a) / (b - a), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

fn hash2i(ix: i32, iz: i32, seed: i32) -> f32 {
    var h: u32 = ((ix as u32) * 0x27d4eb2du) ^ ((iz as u32) * 0x165667b1u) ^ ((seed as u32) * 0x85ebca6bu);
    h = (h ^ (h >> 15u)) * 0x2c1b3c6du;
    h = (h ^ (h >> 12u)) * 0x297a2d39u;
    h = h ^ (h >> 15u);
    return ((h >> 8u) as f32) * (1.0 / 16777216.0);
}

fn value_noise(x: f32, z: f32, cell_size: f32, seed: i32) -> f32 {
    let gx = x / cell_size;
    let gz = z / cell_size;
    let flx = floor(gx);
    let flz = floor(gz);
    let ix = flx as i32;
    let iz = flz as i32;
    let fx = gx - flx;
    let fz = gz - flz;
    let ux = fx * fx * fx * (fx * (fx * 6.0 - 15.0) + 10.0);
    let uz = fz * fz * fz * (fz * (fz * 6.0 - 15.0) + 10.0);
    let a = hash2i(ix, iz, seed);
    let b = hash2i(ix + 1, iz, seed);
    let c = hash2i(ix, iz + 1, seed);
    let d = hash2i(ix + 1, iz + 1, seed);
    let ab = a + (b - a) * ux;
    let cd = c + (d - c) * ux;
    return ab + (cd - ab) * uz;
}

fn river_center_x(z: f32) -> f32 {
    return 340.0 * sin(z / 1150.0) + 190.0 * cos(z / 580.0) - 80.0 * sin(z / 2400.0);
}

fn river_half_width(z: f32) -> f32 {
    return 58.0 + 26.0 * sstep(200.0, 3200.0, z) + 10.0 * sin(z / 720.0);
}

fn river_signed_dist(x: f32, z: f32) -> f32 {
    return abs(x - river_center_x(z)) - river_half_width(z);
}

fn terrain_height(x: f32, z: f32) -> f32 {
    let n_big = value_noise(x, z, 1100.0, 11);
    let n_med = value_noise(x, z, 420.0, 23);
    let n_fine = value_noise(x, z, 150.0, 37);
    let n_micro = value_noise(x, z, 52.0, 53);

    let r = length(vec2<f32>(x, z));
    let rd = river_signed_dist(x, z);

    let valley_floor = 5.5 + 5.0 * n_big + 2.4 * n_med + 1.0 * n_fine + 0.3 * n_micro;
    let outer_rise = sstep(3300.0, 5800.0, r);
    let ridge_noise = abs(value_noise(x + 600.0, z - 400.0, 1400.0, 71) - 0.48) * 2.0;
    let foothills = outer_rise * (28.0 + 52.0 * n_big + 30.0 * ridge_noise + 12.0 * n_med + 3.5 * n_fine);
    let ne_boost = (1.0 - sstep(450.0, 2600.0, length(vec2<f32>(x - 4400.0, z + 4200.0)))) * 34.0;
    let nw_boost = (1.0 - sstep(450.0, 2700.0, length(vec2<f32>(x + 4500.0, z + 4100.0)))) * 38.0;
    let inner_hills = 18.0 * sstep(0.5, 0.9, value_noise(x + 211.0, z - 97.0, 1700.0, 83));
    let upland = valley_floor + foothills + ne_boost + nw_boost + inner_hills;

    let river_valley = 4.6 + 1.8 * n_med + 0.6 * n_fine;
    let terrace_blend = sstep(-5.0, 240.0, rd);
    let dry_elev = river_valley + (upland - river_valley) * terrace_blend;

    let bank_slope = sstep(-10.0, 42.0, rd);
    return RIVER_BED_Y + (dry_elev - RIVER_BED_Y) * bank_slope;
}

// A road segment's distance past its sidewalks (x) and its height there (y).
fn seg_dist(segs: read_store<vec4<f32>, 1>, si: i32, wx: f32, wz: f32) -> vec2<f32> {
    let a = segs[si * 3];
    let b = segs[si * 3 + 1];
    let dx = a.z - a.x;
    let dz = a.w - a.y;
    let l2 = max(dx * dx + dz * dz, 1.0e-9);
    let t = clamp(((wx - a.x) * dx + (wz - a.y) * dz) / l2, 0.0, 1.0);
    let ex = wx - a.x - dx * t;
    let ez = wz - a.y - dz * t;
    return vec2<f32>(sqrt(ex * ex + ez * ez) - (b.z + b.w), b.x + (b.y - b.x) * t);
}

fn unorm8(x: f32) -> u32 {
    return (clamp(x, 0.0, 1.0) * 255.0 + 0.5) as u32;
}

@kernel @grid(3)
fn k_tile(
    g: grid<3>,
    table: read_store<vec4<i32>, 1>,
    pos_out: write_store<vec4<f32>, 3>,
    surf_out: write_store<u32, 3>,
    h_span: rw_store<i32, 1>,
    border: f32,
    inv_size: f32,
    bottom: f32,
    segs: read_store<vec4<f32>, 1>,
    cell_start: read_store<i32, 1>,
    cell_segs: read_store<i32, 1>,
    city_half: f32,
    city_cell: f32,
    city_cells: i32,
    reach: f32
) {
    let rec = tiles::record(table, g.z());
    let s = ((g.x() as f32) - border) * inv_size;
    let t = ((g.y() as f32) - border) * inv_size;
    let d = tiles::frame_offset(rec, s, t);
    let wx = rec.anchor.x + d.x;
    let wz = rec.anchor.z + d.z;
    let local_xz = d.xz + rec.point.xz;

    var h = terrain_height(wx, wz);
    // The roads' grade (lib/city/ground.js gradedHeight, its JS twin): the
    // roads' heights under it and its sidewalks, blended by how much farther
    // each is than the nearest (two alike halfway between, so no step on
    // that line), eased back to the land over `reach` metres past them.
    let ci = floor((wx + city_half) / city_cell) as i32;
    let cj = floor((wz + city_half) / city_cell) as i32;
    if (ci >= 0 && cj >= 0 && ci < city_cells && cj < city_cells) {
        let c = cj * city_cells + ci;
        var best = 1.0e9;
        for (var k = cell_start[c]; k < cell_start[c + 1]; k += 1) {
            best = min(best, seg_dist(segs, cell_segs[k], wx, wz).x);
        }
        // A road 4 m farther than the nearest no longer counts (ground.js
        // GRADE_SPAN), more the deeper in a road: a junction one surface.
        let span = 4.0 + max(0.0, -best);
        var sw = 0.0;
        var sy = 0.0;
        for (var k = cell_start[c]; k < cell_start[c + 1]; k += 1) {
            let dy = seg_dist(segs, cell_segs[k], wx, wz);
            let w = 1.0 - sstep(0.0, span, dy.x - best);
            sw += w;
            sy += w * dy.y;
        }
        let by = sw > 0.0 ? sy / sw : h;
        if (best < reach) {
            let w = best <= 0.0 ? 1.0 : 1.0 - sstep(0.0, 1.0, best / reach);
            h = h + (by - h) * w;
        }
    }
    let rd = river_signed_dist(wx, wz);
    let r = length(vec2<f32>(wx, wz));
    let n = value_noise(wx, wz, 280.0, 97);

    let bank_sand = 1.0 - sstep(-2.0, 16.0, rd);
    let slope_rock = sstep(52.0, 92.0, h);
    let rock_sand = max(bank_sand, slope_rock * 0.78);

    let outer_bias = sstep(1200.0, 3200.0, r) * 0.22;
    let forest = max(0.0, sstep(0.46, 0.76, n + outer_bias) * sstep(14.0, 48.0, rd) * (1.0 - bank_sand));
    let grass = max(0.05, 1.0 - min(1.0, forest + rock_sand));
    let inv_sum = 1.0 / max(grass + forest + rock_sand, 0.001);

    pos_out[g.x(), g.y(), rec.slot] = vec4<f32>(local_xz.x, h, local_xz.y, rd);
    surf_out[g.x(), g.y(), rec.slot] =
        0u |
        (unorm8(grass * inv_sum) << 8u) |
        (unorm8(forest * inv_sum) << 16u) |
        (unorm8(rock_sand * inv_sum) << 24u);

    let over = max(h - bottom, 0.0);
    let bits = bitcast<i32>(over);
    h_span.atomic_max(2 * g.z(), 2147483647 - bits);
    h_span.atomic_max(2 * g.z() + 1, bits);
}

@kernel @grid(1)
fn k_range(
    g: grid<1>,
    table: read_store<vec4<i32>, 1>,
    h_span: rw_store<i32, 1>,
    ranges: write_store<f32, 1>,
    top: f32,
    bottom: f32
) {
    let rec = tiles::record(table, g.x());
    let slot = rec.slot;
    let lo = bitcast<f32>(2147483647 - h_span[2 * g.x()]) + bottom;
    let hi = bitcast<f32>(h_span[2 * g.x() + 1]) + bottom;
    h_span[2 * g.x()] = 0;
    h_span[2 * g.x() + 1] = 0;
    let margin = rec.level < 3 ? 2.5 : 0.6;
    ranges[2 * slot] = max(lo - margin, bottom);
    ranges[2 * slot + 1] = min(hi + margin, top);
}
