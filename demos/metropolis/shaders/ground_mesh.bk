// Instanced ground mesh hook for bro.tiles plane domain with cam_hi/cam_lo precision
// and realistic PBR asphalt roads, concrete sidewalks, pavers, and suburban lawns.
module hook;
import scene;
import mesh;
import custom;

const TILE: i32 = 32;
const BORDER: i32 = 2;
const CELLS: i32 = 36;
const BLOCK_SIZE: f32 = 128.0;
const URBAN_RING_R2: f32 = 2560.0 * 2560.0;

struct GroundParams {
    cam_hi: vec3<f32>,
    time: f32,
    cam_lo: vec3<f32>,
    pad0: f32,
}

@binding(4, 0) var params: uniform<GroundParams>;
@binding(4, 1) var pos: texture2d_array<vec4<f32>>;
@binding(4, 2) var surf: texture2d_array<vec4<f32>>;
@binding(4, 14) var tiles: read_buffer<vec4<i32>>;

fn pos_at(slot: i32, x: i32, y: i32) -> vec4<f32> {
    let cell = slot & 3;
    return pos.fetch(vec3<i32>((cell & 1) * CELLS + x, (cell >> 1) * CELLS + y, slot >> 2), 0);
}

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    let inst = v.instance_index;
    let ids = tiles[inst * 4];
    let xy = tiles[inst * 4 + 1];
    let hi = bitcast<vec4<f32>>(tiles[inst * 4 + 2]);
    let lo = bitcast<vec4<f32>>(tiles[inst * 4 + 3]);

    let i = (v.pos.x + 0.5) as i32;
    let j = (v.pos.z + 0.5) as i32;
    let slot = ids.x;
    let cx = i + BORDER;
    let cy = j + BORDER;
    var c0 = pos_at(slot, cx, cy);

    // Edge stitching against coarser neighbors
    let coarser = xy.z;
    var k: i32 = 0;
    var along = j;
    var across = vec2<i32>(0, 1);
    if (i == 0) { k = coarser & 15; }
    else if (i == TILE) { k = (coarser >> 4) & 15; }
    else if (j == 0) { k = (coarser >> 8) & 15; along = i; across = vec2<i32>(1, 0); }
    else if (j == TILE) { k = (coarser >> 12) & 15; along = i; across = vec2<i32>(1, 0); }
    if (k > 0) {
        let step = min(1 << k, TILE);
        let lo_e = (along / step) * step;
        if (lo_e != along) {
            let a = pos_at(slot, cx + across.x * (lo_e - along), cy + across.y * (lo_e - along));
            let b = pos_at(slot, cx + across.x * (lo_e + step - along), cy + across.y * (lo_e + step - along));
            c0 = mix(a, b, (along - lo_e) as f32 / (step as f32));
        }
    }

    // Parent geomorphing for odd vertices
    let morph = 1.0 - clamp(bitcast<f32>(xy.w), 0.0, 1.0);
    if (k == 0 && ids.y >= 0 && morph > 0.0 && ((i | j) & 1) != 0) {
        let oi = i & 1;
        let oj = j & 1;
        var p = pos_at(slot, cx - oi, cy - oj) + pos_at(slot, cx + oi, cy + oj);
        if (oi != 0 && oj != 0) {
            p += pos_at(slot, cx - 1, cy + 1) + pos_at(slot, cx + 1, cy - 1);
            p *= 0.25;
        } else {
            p *= 0.5;
        }
        c0 = mix(c0, p, morph);
    }

    var c_xyz = c0.xyz;
    if (v.pos.y > 0.5) {
        let si = i == 0 ? -1 : (i == TILE ? 1 : 0);
        let sj = j == 0 ? -1 : (j == TILE ? 1 : 0);
        c_xyz = pos_at(slot, cx + si, cy + sj).xyz;
    }

    let tu = pos_at(slot, cx + 1, cy).xyz - pos_at(slot, cx - 1, cy).xyz;
    let tv = pos_at(slot, cx, cy + 1).xyz - pos_at(slot, cx, cy - 1).xyz;
    var n = normalize(cross(tv, tu));
    if (n.y < 0.0) { n = -n; }

    let extent = 4096.0 / ((1 << ids.w) as f32);
    let rel = (hi.xyz - params.cam_hi) + (lo.xyz - params.cam_lo);
    v.pos = rel + c_xyz - vec3<f32>(0.0, v.pos.y * extent * 0.0625, 0.0);
    v.normal = n;

    let block_xy = mod(hi.xz, BLOCK_SIZE) + lo.xz + c_xyz.xz;
    let world_xz = hi.xz + c_xyz.xz;
    v.v0 = vec4<f32>(cx as f32, cy as f32, v_in.pos.y, c0.w);
    v.v1 = vec4<f32>(block_xy.x, block_xy.y, world_xz.x, world_xz.y);
    v.vi = vec4<i32>(slot, ids.w, ids.y, 0);
    return v;
}

fn line_kind(line_idx: i32, perp_idx: i32) -> i32 {
    if ((line_idx & 3) == 0) { return 2; }
    let lx = (line_idx as f32) * BLOCK_SIZE;
    let lz = (perp_idx as f32) * BLOCK_SIZE;
    return (lx * lx + lz * lz) < URBAN_RING_R2 ? 1 : 0;
}

fn road_hw(kind: i32) -> f32 {
    if (kind == 2) { return 10.0; }
    if (kind == 1) { return 6.0; }
    return 4.5;
}

fn sw_w(kind: i32) -> f32 {
    if (kind == 2) { return 3.5; }
    if (kind == 1) { return 2.5; }
    return 2.0;
}

fn hash2(p: vec2<f32>) -> f32 {
    return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453123);
}

fn vnoise2(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (vec2<f32>(3.0, 3.0) - f * 2.0);
    let a = hash2(i);
    let b = hash2(i + vec2<f32>(1.0, 0.0));
    let c = hash2(i + vec2<f32>(0.0, 1.0));
    let d = hash2(i + vec2<f32>(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

fn fbm2(p: vec2<f32>) -> f32 {
    var sum = 0.0;
    sum += 0.54 * vnoise2(p);
    sum += 0.30 * vnoise2(p * 2.13 + vec2<f32>(17.3, 9.1));
    sum += 0.16 * vnoise2(p * 4.41 + vec2<f32>(5.7, 23.9));
    return sum;
}

fn box_band(d: f32, c: f32, hw: f32, fw: f32) -> f32 {
    let hfw = max(fw * 0.75, 0.015);
    return clamp(smoothstep(c - hw - hfw, c - hw + hfw, d) - smoothstep(c + hw - hfw, c + hw + hfw, d), 0.0, 1.0);
}

fn filtered_pulse(x: f32, freq: f32, duty: f32, fw: f32) -> f32 {
    let p = x * freq;
    let w = clamp(fw * freq, 0.001, 1.0);
    let p0 = p - 0.5 * w;
    let p1 = p + 0.5 * w;
    let i0 = floor(p0) + min(fract(p0), duty);
    let i1 = floor(p1) + min(fract(p1), duty);
    return clamp((i1 - i0) / w, 0.0, 1.0);
}

pub fn fragment(v: mesh::Vertex, s_in: mesh::Surface) -> mesh::Surface {
    var s = s_in;
    let slot = v.vi.x;
    let level = v.vi.y;
    let cell = slot & 3;
    let tx = (((cell & 1) as f32) + (v.v0.x + 0.5) / (CELLS as f32)) * 0.5;
    let ty = ((((cell >> 1) & 1) as f32) + (v.v0.y + 0.5) / (CELLS as f32)) * 0.5;
    let surf_val = surf.sample_lod(custom::linear, vec3<f32>(tx, ty, (slot >> 2) as f32), 0.0);

    // Uniform control flow derivatives (meters/pixel)
    let dp_dx = dpdx(v.world_pos.xz);
    let dp_dy = dpdy(v.world_pos.xz);
    let fw_xz = max(abs(dp_dx) + abs(dp_dy), vec2<f32>(0.001, 0.001));
    let fw_x = fw_xz.x;
    let fw_z = fw_xz.y;
    let fw_max = max(fw_x, fw_z);

    let block_xz = mod(v.v1.xy, BLOCK_SIZE);
    let world_xz = v.v1.zw;
    let rx = floor(world_xz.x / BLOCK_SIZE + 0.5) as i32;
    let rz = floor(world_xz.y / BLOCK_SIZE + 0.5) as i32;
    let x_kind = line_kind(rx, rz);
    let z_kind = line_kind(rz, rx);
    let hx = road_hw(x_kind);
    let hz = road_hw(z_kind);
    let swx = hx + sw_w(x_kind);
    let swz = hz + sw_w(z_kind);

    let dx = min(block_xz.x, BLOCK_SIZE - block_xz.x);
    let dz = min(block_xz.y, BLOCK_SIZE - block_xz.y);

    // Crisp anti-aliased road, sidewalk, and block masks (no distant softening smear)
    let w_x = max(fw_x * 1.35, 0.03);
    let w_z = max(fw_z * 1.35, 0.03);
    let cov_road_x = 1.0 - smoothstep(hx - 0.5 * w_x, hx + 0.5 * w_x, dx);
    let cov_road_z = 1.0 - smoothstep(hz - 0.5 * w_z, hz + 0.5 * w_z, dz);
    let road_cov = max(cov_road_x, cov_road_z);

    let cov_sw_x = 1.0 - smoothstep(swx - 0.5 * w_x, swx + 0.5 * w_x, dx);
    let cov_sw_z = 1.0 - smoothstep(swz - 0.5 * w_z, swz + 0.5 * w_z, dz);
    let sw_cov = clamp(max(cov_sw_x, cov_sw_z) - road_cov, 0.0, 1.0);
    let block_cov = clamp(1.0 - road_cov - sw_cov, 0.0, 1.0);

    // Band-limited natural isotropic fBm at macro (40m), mid (3m), and fine (0.28m) scales
    let dist_damp_fine = 1.0 - smoothstep(0.025, 0.09, fw_max);
    let dist_damp_mid = 1.0 - smoothstep(0.18, 0.65, fw_max);
    let n_macro = fbm2(world_xz * 0.024);
    let n_mid = mix(0.5, fbm2(block_xz * 0.34 + vec2<f32>(3.1, 7.4)), dist_damp_mid);
    let n_fine = mix(0.5, vnoise2(block_xz * 3.6 + vec2<f32>(11.2, 4.9)), dist_damp_fine);
    let n_grad_x = (vnoise2(block_xz * 3.8 + vec2<f32>(0.08, 0.0)) - vnoise2(block_xz * 3.8 - vec2<f32>(0.08, 0.0))) * dist_damp_fine;
    let n_grad_z = (vnoise2(block_xz * 3.8 + vec2<f32>(0.0, 0.08)) - vnoise2(block_xz * 3.8 - vec2<f32>(0.0, 0.08))) * dist_damp_fine;

    let pad_mask = surf_val.z;
    let zone_code = surf_val.w;

    // Subtle physically-grounded normal perturbation: asphalt <= 0.025, turf <= 0.075
    let n_amp = mix(0.065, 0.022, max(road_cov, max(sw_cov, pad_mask)));
    s.normal = normalize(s.normal + vec3<f32>(n_grad_x * n_amp, 0.0, n_grad_z * n_amp));

    var col = vec3<f32>(0.0);
    var rough: f32 = 0.0;

    if (road_cov > 0.001) {
        let lane_wear = 0.94 + 0.07 * (n_macro - 0.5) + 0.06 * (n_mid - 0.5) + 0.06 * (n_fine - 0.5);
        var road_col = vec3<f32>(0.105, 0.110, 0.118) * lane_wear;
        var road_rough = 0.80 + 0.08 * n_fine;

        let aa_mark = 1.0 - smoothstep(0.04, 0.11, fw_max);
        if (aa_mark > 0.001) {
            let in_junc = (1.0 - smoothstep(hx + 0.4 - 0.5 * w_x, hx + 0.4 + 0.5 * w_x, dx))
                        * (1.0 - smoothstep(hz + 0.4 - 0.5 * w_z, hz + 0.4 + 0.5 * w_z, dz));
            let not_junc = 1.0 - in_junc;

            let cw_x_cov = cov_road_x * not_junc * box_band(dz, hz + 2.8, 1.5, fw_z)
                         * (1.0 - smoothstep(hx - 1.0 - 0.5 * w_x, hx - 1.0 + 0.5 * w_x, dx))
                         * filtered_pulse(world_xz.x, 0.55, 0.46, fw_x);
            let cw_z_cov = cov_road_z * not_junc * box_band(dx, hx + 2.8, 1.5, fw_x)
                         * (1.0 - smoothstep(hz - 1.0 - 0.5 * w_z, hz - 1.0 + 0.5 * w_z, dz))
                         * filtered_pulse(world_xz.y, 0.55, 0.46, fw_z);
            let cw_cov = clamp(max(cw_x_cov, cw_z_cov), 0.0, 1.0) * aa_mark;

            let past_cw_z = smoothstep(hz + 4.5 - 0.5 * w_z, hz + 4.5 + 0.5 * w_z, dz);
            let past_cw_x = smoothstep(hx + 4.5 - 0.5 * w_x, hx + 4.5 + 0.5 * w_x, dx);

            var yel_cov: f32 = 0.0;
            var wht_cov: f32 = 0.0;
            var sub_yel_cov: f32 = 0.0;
            if (x_kind == 2) {
                yel_cov = max(yel_cov, cov_road_x * not_junc * past_cw_z * box_band(dx, 0.16, 0.08, fw_x));
                wht_cov = max(wht_cov, cov_road_x * not_junc * past_cw_z * box_band(dx, 5.0, 0.07, fw_x) * filtered_pulse(world_xz.y, 0.125, 0.40, fw_z));
            } else if (x_kind == 1) {
                sub_yel_cov = max(sub_yel_cov, cov_road_x * not_junc * past_cw_z * box_band(dx, 0.0, 0.08, fw_x) * filtered_pulse(world_xz.y, 0.125, 0.40, fw_z));
            }
            if (z_kind == 2) {
                yel_cov = max(yel_cov, cov_road_z * not_junc * past_cw_x * box_band(dz, 0.16, 0.08, fw_z));
                wht_cov = max(wht_cov, cov_road_z * not_junc * past_cw_x * box_band(dz, 5.0, 0.07, fw_z) * filtered_pulse(world_xz.x, 0.125, 0.40, fw_x));
            } else if (z_kind == 1) {
                sub_yel_cov = max(sub_yel_cov, cov_road_z * not_junc * past_cw_x * box_band(dz, 0.0, 0.08, fw_z) * filtered_pulse(world_xz.x, 0.125, 0.40, fw_x));
            }

            let line_mask = clamp(1.0 - cw_cov, 0.0, 1.0) * aa_mark;
            road_col = mix(road_col, vec3<f32>(0.72, 0.72, 0.70), cw_cov * 0.9);
            road_col = mix(road_col, vec3<f32>(0.76, 0.56, 0.12), yel_cov * line_mask * 0.92);
            road_col = mix(road_col, vec3<f32>(0.72, 0.72, 0.70), wht_cov * line_mask * (1.0 - yel_cov) * 0.9);
            road_col = mix(road_col, vec3<f32>(0.70, 0.58, 0.22), sub_yel_cov * line_mask * (1.0 - yel_cov) * (1.0 - wht_cov) * 0.9);
            road_rough = mix(road_rough, 0.65, cw_cov);
            road_rough = mix(road_rough, 0.62, yel_cov * line_mask);
        }

        col += road_col * road_cov;
        rough += road_rough * road_cov;
    }

    if (sw_cov > 0.001) {
        let aa_seam_x = 1.0 - smoothstep(0.025, 0.07, fw_x);
        let aa_seam_z = 1.0 - smoothstep(0.025, 0.07, fw_z);
        let gx = abs(fract(block_xz.x * 0.5) - 0.5);
        let gz = abs(fract(block_xz.y * 0.5) - 0.5);
        let seam_raw = max(smoothstep(0.45, 0.485, gx) * aa_seam_x, smoothstep(0.45, 0.485, gz) * aa_seam_z);
        let seam = 1.0 - 0.08 * seam_raw;
        let aa_curb = 1.0 - smoothstep(0.035, 0.10, fw_max);
        let curb_cov = max(box_band(dx, hx + 0.175, 0.175, fw_x), box_band(dz, hz + 0.175, 0.175, fw_z)) * aa_curb;
        let curb_shade = 1.0 - 0.09 * curb_cov;
        let sw_var = 0.96 + 0.05 * (n_mid - 0.5) + 0.04 * (n_fine - 0.5);
        let sw_col = vec3<f32>(0.36, 0.36, 0.35) * seam * curb_shade * sw_var;
        col += sw_col * sw_cov;
        rough += 0.87 * sw_cov;
    }

    if (block_cov > 0.001) {
        var blk_col = vec3<f32>(0.14, 0.24, 0.10);
        var blk_rough: f32 = 0.92;
        if (zone_code > 0.52) {
            let aa_seam_x = 1.0 - smoothstep(0.025, 0.07, fw_x);
            let aa_seam_z = 1.0 - smoothstep(0.025, 0.07, fw_z);
            let px = abs(fract(block_xz.x * 0.25) - 0.5);
            let pz = abs(fract(block_xz.y * 0.25) - 0.5);
            let tile_raw = max(smoothstep(0.46, 0.49, px) * aa_seam_x, smoothstep(0.46, 0.49, pz) * aa_seam_z);
            let tile_seam = 1.0 - 0.07 * tile_raw;
            let plaza_var = 0.95 + 0.07 * (n_macro - 0.5) + 0.05 * (n_mid - 0.5);
            let plaza = vec3<f32>(0.29, 0.29, 0.28) * tile_seam * plaza_var;
            let pad_col = vec3<f32>(0.32, 0.32, 0.31) * tile_seam * plaza_var;
            blk_col = mix(plaza, pad_col, pad_mask);
            blk_rough = 0.85;
        } else {
            let grass_a = vec3<f32>(0.10, 0.19, 0.07);
            let grass_b = vec3<f32>(0.17, 0.30, 0.11);
            let organic = clamp(n_macro * 0.65 + n_mid * 0.35, 0.0, 1.0);
            let grass = mix(grass_a, grass_b, organic) * (0.93 + 0.10 * (n_fine - 0.5));
            let pad_col = vec3<f32>(0.33, 0.33, 0.32) * (0.96 + 0.06 * (n_mid - 0.5));
            blk_col = mix(grass, pad_col, pad_mask);
            blk_rough = mix(0.92, 0.85, pad_mask);
        }
        col += blk_col * block_cov;
        rough += blk_rough * block_cov;
    }

    s.base_color = col;
    s.roughness = rough;
    s.metallic = 0.0;

    if (SCENE_DEBUG(level)) {
        let hue = ((level % 6) as f32) / 6.0;
        s = mesh::debug(s, clamp(abs(mod(vec3<f32>(hue * 6.0) + vec3<f32>(0.0, 4.0, 2.0), 6.0) - vec3<f32>(3.0)) - vec3<f32>(1.0), vec3<f32>(0.0), vec3<f32>(1.0)) * 0.5);
    }
    if (SCENE_DEBUG(albedo)) { s = mesh::debug(s, s.base_color); }
    if (SCENE_DEBUG(normal)) { s = mesh::debug(s, s.normal * 0.5 + vec3<f32>(0.5)); }
    if (SCENE_DEBUG(skirt)) { s = mesh::debug(s, v.v0.z > 0.5 ? vec3<f32>(1.0, 0.0, 0.0) : s.base_color); }
    return s;
}
