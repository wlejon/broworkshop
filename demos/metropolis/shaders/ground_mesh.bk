// The ground over bro.tiles' plane domain: natural land by band-limited biome
// weights, and the city painted on it from lib/city/ground.js's data: the
// roads (asphalt, lane lines, crosswalks, curbs, sidewalks) from the segment
// index, the blocks (paving, yards, parks, industrial yards) from the surface
// grid. Every detail is box-filtered by the pixel's footprint, so far ground
// is the near ground averaged, not another picture.
module hook;
import scene;
import mesh;
import custom;

const TILE: i32 = 32;
const BORDER: i32 = 2;
const CELLS: i32 = 36;
const ROOT_SIZE: f32 = 2816.0;

struct GroundParams {
    time: f32,
    night: f32,          // 0 day .. 1 night: the street lamps' share

    pad1: f32,
    pad2: f32,
    city: vec4<f32>,     // half, cell, cells, surf cell
    city2: vec4<f32>,    // surf cells
    open: vec4<f32>,     // the open building's masses [x, y) (lib/city/interior.js): no ground inside them
}

@binding(4, 0) var params: uniform<GroundParams>;
@binding(4, 1) var pos: texture2d_array<vec4<f32>>;
@binding(4, 14) var tiles: read_buffer<vec4<i32>>;
@binding(4, 15) var segs: read_buffer<vec4<f32>>;
@binding(4, 16) var cell_start: read_buffer<i32>;
@binding(4, 17) var cell_segs: read_buffer<i32>;
@binding(4, 18) var surf: read_buffer<u32>;
@binding(4, 19) var masses: read_buffer<vec4<f32>>;   // lib/city/buildings.js records, 4 a mass

// Inside a mass of the open building: a building stands at its street
// front's height and cuts into a rise behind, so the ground there is above
// its floor, hidden by its walls until its rooms are shown.
fn in_open(p: vec2<f32>) -> bool {
    let a = params.open.x as i32;
    let b = min(params.open.y as i32, a + 8);
    if a < 0 || masses.len() == 0 { return false; }
    for (var k: i32 = a; k < b; k += 1) {
        let m0 = masses[4 * k];
        let m1 = masses[4 * k + 1];
        let c = cos(m0.w);
        let sn = sin(m0.w);
        let dx = p.x - m0.x;
        let dz = p.y - m0.z;
        if abs(c * dx - sn * dz) < m1.x && abs(sn * dx + c * dz) < m1.z { return true; }
    }
    return false;
}

fn pos_at(slot: i32, x: i32, y: i32) -> vec4<f32> {
    let cell = slot & 3;
    return pos.fetch(vec3<i32>((cell & 1) * CELLS + x, (cell >> 1) * CELLS + y, slot >> 2), 0);
}

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    let inst = v.instance_index;
    let ids = tiles[inst * 4];
    let xy = tiles[inst * 4 + 1];
    let hi = bitcast<vec4<f32>>(tiles[inst * 4 + 2]);
    let lo = bitcast<vec4<f32>>(tiles[inst * 4 + 3]);

    let i = (v.pos.x + 0.5) as i32;
    let j = (v.pos.z + 0.5) as i32;
    let slot = ids.x;
    let cx = i + BORDER;
    let cy = j + BORDER;
    var c0 = pos_at(slot, cx, cy);

    let coarser = xy.z;
    var k: i32 = 0;
    var along = j;
    var across = vec2<i32>(0, 1);
    if (i == 0) { k = coarser & 15; }
    else if (i == TILE) { k = (coarser >> 4) & 15; }
    else if (j == 0) { k = (coarser >> 8) & 15; along = i; across = vec2<i32>(1, 0); }
    else if (j == TILE) { k = (coarser >> 12) & 15; along = i; across = vec2<i32>(1, 0); }
    if (k > 0) {
        let step = min(1 << k, TILE);
        let lo_e = (along / step) * step;
        if (lo_e != along) {
            let a = pos_at(slot, cx + across.x * (lo_e - along), cy + across.y * (lo_e - along));
            let b = pos_at(slot, cx + across.x * (lo_e + step - along), cy + across.y * (lo_e + step - along));
            c0 = mix(a, b, (along - lo_e) as f32 / (step as f32));
        }
    }

    let morph = 1.0 - clamp(bitcast<f32>(xy.w), 0.0, 1.0);
    if (k == 0 && ids.y >= 0 && morph > 0.0 && ((i | j) & 1) != 0) {
        let oi = i & 1;
        let oj = j & 1;
        var p = pos_at(slot, cx - oi, cy - oj) + pos_at(slot, cx + oi, cy + oj);
        if (oi != 0 && oj != 0) {
            p += pos_at(slot, cx - 1, cy + 1) + pos_at(slot, cx + 1, cy - 1);
            p *= 0.25;
        } else {
            p *= 0.5;
        }
        c0 = mix(c0, p, morph);
    }

    var c_xyz = c0.xyz;
    if (v.pos.y > 0.5) {
        let si = i == 0 ? -1 : (i == TILE ? 1 : 0);
        let sj = j == 0 ? -1 : (j == TILE ? 1 : 0);
        c_xyz = pos_at(slot, cx + si, cy + sj).xyz;
    }

    let tu = pos_at(slot, cx + 1, cy).xyz - pos_at(slot, cx - 1, cy).xyz;
    let tv = pos_at(slot, cx, cy + 1).xyz - pos_at(slot, cx, cy - 1).xyz;
    var n = normalize(cross(tv, tu));
    if (n.y < 0.0) { n = -n; }

    let extent = ROOT_SIZE / ((1 << ids.w) as f32);
    // Node space (the node sits at the origin; the engine takes it eye-relative).
    v.pos = hi.xyz + lo.xyz + c_xyz - vec3<f32>(0.0, v.pos.y * extent * 0.0625, 0.0);
    v.normal = n;

    let world_xz = hi.xz + lo.xz + c_xyz.xz;
    let world_y = hi.y + lo.y + c_xyz.y;
    v.v0 = vec4<f32>(cx as f32, cy as f32, v_in.pos.y, c0.w);
    v.v1 = vec4<f32>(world_xz.x, world_xz.y, world_y, 0.0);
    v.vi = vec4<i32>(slot, ids.w, 0, 0);
    return v;
}

fn sstep(a: f32, b: f32, x: f32) -> f32 {
    let t = clamp((x - a) / (b - a), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

fn hash2(p: vec2<f32>) -> f32 {
    var q = fract(vec3<f32>(p.x, p.y, p.x) * 0.1031);
    let d = dot(q, vec3<f32>(q.y + 33.33, q.z + 33.33, q.x + 33.33));
    q = q + vec3<f32>(d);
    return fract((q.x + q.y) * q.z);
}

fn vnoise2(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (vec2<f32>(3.0, 3.0) - f * 2.0);
    let a = hash2(i);
    let b = hash2(i + vec2<f32>(1.0, 0.0));
    let c = hash2(i + vec2<f32>(0.0, 1.0));
    let d = hash2(i + vec2<f32>(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// Street lamps every `sp` metres along a road, staggered on its two sides at
// `side` from the centre line, LAMP_H up: the illuminance (lux) they give a
// point at (s along, u across), the inverse square times the cosine, from
// the two nearest on each side.
const PI_F: f32 = 3.14159265;
const LAMP_H: f32 = 8.0;
const LAMP_CD: f32 = 1600.0;
fn lamp_lux(s: f32, u: f32, sp: f32, side: f32) -> f32 {
    var e = 0.0;
    for (var k = 0; k < 2; k += 1) {
        let off = k == 0 ? 0.0 : sp * 0.5;
        let su = k == 0 ? side : -side;
        let base = floor((s - off) / sp) * sp + off;
        for (var j = 0; j < 2; j += 1) {
            let ls = base + (j as f32) * sp;
            let dx = s - ls;
            let du = u - su;
            let r2 = dx * dx + du * du + LAMP_H * LAMP_H;
            e += LAMP_CD * LAMP_H / (r2 * sqrt(r2));
        }
    }
    return e;
}

// Coverage of [a, b] by a pixel at x of footprint f (a box-filtered step).
fn band(x: f32, a: f32, b: f32, f: f32) -> f32 {
    let lo = clamp((x - a) / f + 0.5, 0.0, 1.0);
    let hi = clamp((x - b) / f + 0.5, 0.0, 1.0);
    return lo - hi;
}

// A periodic stripe pattern's coverage: [0, duty) of every period, box-filtered,
// fading to its mean `duty` once the period is under two pixels.
fn stripes(x: f32, period: f32, duty: f32, f: f32) -> f32 {
    let u = fract(x / period);
    let fp = f / period;
    let c = band(u, 0.0, duty, fp) + band(u, 1.0, 1.0 + duty, fp) + band(u, -1.0, duty - 1.0, fp);
    return mix(c, duty, smoothstep(0.25, 0.5, fp));
}

fn surf_at(x: f32, z: f32) -> i32 {
    let sc = params.city.w;
    let n = params.city2.x as i32;
    let i = floor((x + params.city.x) / sc) as i32;
    let j = floor((z + params.city.x) / sc) as i32;
    if (i < 0 || j < 0 || i >= n || j >= n) { return 0; }
    let ci = j * n + i;
    return ((surf[ci >> 2] >> (((ci & 3) * 8) as u32)) & 255u) as i32;
}

// The block surface's colour (linear) and roughness, `nat` the natural ground under it.
fn block_surface(code: i32, p: vec2<f32>, fw: f32, nat: vec3<f32>, var_k: f32) -> vec4<f32> {
    if (code == 1) {
        // Pavers: a 0.6 m grid of slightly varied stones.
        let g = 1.0 - 0.22 * max(stripes(p.x, 0.6, 0.06, fw), stripes(p.y, 0.6, 0.06, fw));
        let cell = floor(p / 0.6);
        let jitter = 1.0 + 0.1 * (hash2(cell) - 0.5) * (1.0 - smoothstep(0.1, 0.3, fw));
        return vec4<f32>(vec3<f32>(0.24, 0.23, 0.21) * g * jitter * var_k, 0.8);
    }
    if (code == 2) {
        // Yards: mown lawn, a little greener and lighter than the wild grass.
        return vec4<f32>(vec3<f32>(0.10, 0.17, 0.06) * var_k, 0.9);
    }
    if (code == 3) {
        return vec4<f32>(vec3<f32>(0.08, 0.16, 0.05) * var_k, 0.9);
    }
    if (code == 4) {
        return vec4<f32>(vec3<f32>(0.20, 0.19, 0.17) * var_k, 0.85);
    }
    return vec4<f32>(nat, 0.9);
}

pub fn fragment(v: mesh::Vertex, s_in: mesh::Surface) -> mesh::Surface {
    var s = s_in;
    let p = v.v1.xy;
    if in_open(p) {
        s.alpha = 0.0;
        return s;
    }
    let h = v.v1.z;
    let rd = v.v0.w;
    let fw = max(length(dpdx(v.world_pos.xz)) + length(dpdy(v.world_pos.xz)), 0.02);

    // Continuous world-space macro biome weights (zero tile-boundary quantization seams)
    let r = length(p);
    let n = vnoise2(p * 0.0036 + vec2<f32>(11.3, 4.7));
    let bank_sand = 1.0 - sstep(-2.0, 16.0, rd);
    let slope_rock = sstep(48.0, 92.0, h);
    let rock_sand = max(bank_sand, slope_rock * 0.78);

    let outer_bias = sstep(1200.0, 3200.0, r) * 0.22;
    let forest = max(0.0, sstep(0.46, 0.76, n + outer_bias) * sstep(14.0, 48.0, rd) * (1.0 - bank_sand));
    let grass = max(0.05, 1.0 - min(1.0, forest + rock_sand));
    let inv_sum = 1.0 / max(grass + forest + rock_sand, 0.001);
    let w = vec4<f32>(0.0, grass, forest, rock_sand) * inv_sum;

    // Multi-scale noise faded out smoothly before Nyquist -> same albedo up close & from orbit
    let macro_var = 0.88 + 0.24 * vnoise2(p * 0.012);
    let med_w = 1.0 - smoothstep(1.5, 9.0, fw);
    let med_var = 1.0 + med_w * 0.14 * (vnoise2(p * 0.09) - 0.5);
    let fine_w = 1.0 - smoothstep(0.12, 0.85, fw);
    let fine_var = 1.0 + fine_w * 0.12 * (vnoise2(p * 0.65) - 0.5);

    // Linear physical palette
    let col_grass = vec3<f32>(0.085, 0.145, 0.052) * macro_var * med_var * fine_var;
    let col_forest = vec3<f32>(0.052, 0.100, 0.040) * macro_var * med_var * fine_var;
    let col_rock = vec3<f32>(0.18, 0.17, 0.145) * macro_var * med_var * fine_var;

    let slope = clamp(1.0 - v.normal.y, 0.0, 1.0);
    let rock_blend = smoothstep(0.14, 0.36, slope);
    var base = col_grass * w.y + col_forest * w.z + col_rock * w.w;
    base = mix(base, col_rock * 1.05, rock_blend * 0.72);

    // Wet dark river sediment below water line
    if (rd < 2.0) {
        let wet = 1.0 - smoothstep(-6.0, 2.0, rd);
        base = mix(base, vec3<f32>(0.045, 0.055, 0.05), wet * 0.65);
    }

    var rough = mix(0.88, 0.45, clamp(1.0 - smoothstep(-2.0, 2.5, rd), 0.0, 1.0));

    // The city: the block's surface, then the nearest road over it.
    let var_k = macro_var * med_var * fine_var;
    let code = surf_at(p.x, p.y);
    if (code != 0) {
        let bs = block_surface(code, p, fw, base, var_k);
        base = bs.xyz;
        rough = bs.w;
    }
    var lamp_e = 0.0;
    let ci = floor((p.x + params.city.x) / params.city.y) as i32;
    let cj = floor((p.y + params.city.x) / params.city.y) as i32;
    let cells = params.city.z as i32;
    if (ci >= 0 && cj >= 0 && ci < cells && cj < cells) {
        let c = cj * cells + ci;
        // The road whose carriageway the point is nearest (inside wins over a neighbour's sidewalk).
        var best = 1.0e9;
        var u = 0.0;
        var sa = 0.0;
        var a_best = vec4<f32>(0.0);
        var b_best = vec4<f32>(0.0);
        var c_best = vec4<f32>(0.0);
        for (var k = cell_start[c]; k < cell_start[c + 1]; k += 1) {
            let si = cell_segs[k];
            let a = segs[si * 3];
            let b = segs[si * 3 + 1];
            let dx = a.z - a.x;
            let dz = a.w - a.y;
            let l2 = max(dx * dx + dz * dz, 1.0e-9);
            let t = clamp(((p.x - a.x) * dx + (p.y - a.y) * dz) / l2, 0.0, 1.0);
            let ex = p.x - a.x - dx * t;
            let ez = p.y - a.y - dz * t;
            let d = sqrt(ex * ex + ez * ez) - b.z;
            if (d < best) {
                best = d;
                let l = sqrt(l2);
                u = (dx * ez - dz * ex) / l;
                let cc = segs[si * 3 + 2];
                sa = cc.x + t * l;
                a_best = a;
                b_best = b;
                c_best = cc;
            }
        }
        let hwid = b_best.z;
        let walk = b_best.w;
        if (best < walk + 0.5) {
            let L = c_best.y;
            let major = c_best.z < 0.5;
            let flags = c_best.w as i32;
            let sb = L - sa;
            // Junction mouths: a box as deep as a crossing road is half wide.
            let jr = 11.0;
            let in_j0 = (flags & 1) != 0 && sa < jr;
            let in_j1 = (flags & 2) != 0 && sb < jr;
            let junction = in_j0 || in_j1;
            let sj = min((flags & 1) != 0 ? sa : 1.0e9, (flags & 2) != 0 ? sb : 1.0e9);

            // Sidewalk: concrete slabs, a granite curb at its road edge.
            let slab_v = 1.0 - smoothstep(0.08, 0.25, fw);
            let joints = max(stripes(sa, 1.5, 0.03, fw), stripes(best, 1.5, 0.03, fw)) * slab_v;
            var walk_c = vec3<f32>(0.30, 0.29, 0.27) * (1.0 - 0.25 * joints) * var_k;
            walk_c = mix(walk_c, vec3<f32>(0.36, 0.36, 0.35), band(best, 0.0, 0.25, fw));
            // Asphalt, worn lighter along the wheel tracks.
            var road_c = vec3<f32>(0.055, 0.056, 0.058) * var_k;
            let lane_w = 3.4;
            let au = abs(u);
            let track = band(fract(au / lane_w), 0.18, 0.38, fw / lane_w) + band(fract(au / lane_w), 0.62, 0.82, fw / lane_w);
            road_c *= 1.0 + 0.18 * track;
            // Markings (linear paint albedo): none inside a junction.
            var paint = 0.0;
            var yellow = 0.0;
            if (!junction) {
                if (major) {
                    // Double yellow centre, dashed lane lines, solid edge lines.
                    yellow = band(au, 0.08, 0.22, fw);
                    let lanes = floor(hwid / lane_w);
                    for (var li = 1.0; li < 4.0; li += 1.0) {
                        if (li < lanes) {
                            paint = max(paint, band(au, li * lane_w - 0.07, li * lane_w + 0.07, fw) * stripes(sa, 9.0, 0.33, fw));
                        }
                    }
                    paint = max(paint, band(au, hwid - 0.45, hwid - 0.3, fw));
                } else {
                    // A dashed white centre line on streets.
                    paint = band(au, -0.06, 0.06, fw) * stripes(sa, 6.0, 0.45, fw);
                }
            }
            // Crosswalks just outside the junction box, a stop line before them.
            if (sj > jr && sj < jr + 3.2 && au < hwid - 0.2) {
                paint = max(paint, stripes(au + 0.25, 1.0, 0.5, fw));
            }
            if (sj > jr + 3.6 && sj < jr + 4.1 && major) {
                // stop line on the inbound half only
                let inbound = ((flags & 1) != 0 && sa < sb) == (u > 0.0);
                if (inbound && au < hwid - 0.3) { paint = max(paint, band(sj, jr + 3.6, jr + 4.1, fw)); }
            }
            road_c = mix(road_c, vec3<f32>(0.62, 0.62, 0.60), paint * 0.9);
            road_c = mix(road_c, vec3<f32>(0.62, 0.45, 0.10), yellow * 0.9);
            // Tram rails: a grooved pair (1.435 m gauge) in each inner lane,
            // through the junctions too.
            if ((flags & 4) != 0) {
                let lc = 1.7;
                let r0 = abs(au - (lc - 0.7175));
                let r1 = abs(au - (lc + 0.7175));
                let rail = 1.0 - smoothstep(0.035, 0.035 + fw, min(r0, r1));
                let groove = 1.0 - smoothstep(0.012, 0.012 + fw, min(r0, r1));
                road_c = mix(road_c, vec3<f32>(0.30, 0.30, 0.31), rail * 0.9);
                road_c = mix(road_c, vec3<f32>(0.02, 0.02, 0.02), groove * 0.8);
            }
            // Coverage of the carriageway against the sidewalk, and of the sidewalk against the block.
            let on_road = band(best, -100.0, 0.0, fw);
            let on_walk = band(best, 0.0, walk, fw);
            base = mix(base, walk_c, on_walk);
            base = mix(base, road_c, on_road);
            if (params.night > 0.0) {
                let lux = lamp_lux(sa, u, major ? 26.0 : 32.0, hwid + 0.6);
                lamp_e = lux * params.night;
            }
            rough = mix(rough, 0.75, on_walk);
            rough = mix(rough, mix(0.7, 0.5, paint), on_road);
        }
    }

    s.base_color = base;
    s.roughness = rough;
    s.metallic = 0.0;
    // Lamp light, as the luminance a diffuse surface sends back (sodium-warm LED).
    s.emissive = base * vec3<f32>(1.0, 0.82, 0.62) * (lamp_e / PI_F);
    return s;
}
