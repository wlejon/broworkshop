// Vertex & multi-material PBR/emissive fragment hook for GPU-instanced city & interior meshes.
// Includes architectural siding/brick, interior plaster+baseboards, oak planks, marble tile, textile, shingles.
module hook;
import mesh;
import scene;

struct InstParams {
    glow_scale: f32,
    night_factor: f32,
    pad0: f32,
    pad1: f32,
}

@binding(4, 0) var params: uniform<InstParams>;

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    v.v0 = vec4<f32>(v_in.pos, v_in.uv.x);
    v.v1 = vec4<f32>(v_in.normal, v_in.instance_index as f32);
    return v;
}

fn hash3(p: vec3<f32>) -> f32 {
    var q = fract(p * 0.1031);
    let d = dot(q, vec3<f32>(q.y + 33.33, q.z + 33.33, q.x + 33.33));
    q = q + vec3<f32>(d);
    return fract((q.x + q.y) * q.z);
}

fn vnoise3(p: vec3<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (vec3<f32>(3.0, 3.0, 3.0) - f * 2.0);
    let n000 = hash3(i);
    let n100 = hash3(i + vec3<f32>(1.0, 0.0, 0.0));
    let n010 = hash3(i + vec3<f32>(0.0, 1.0, 0.0));
    let n110 = hash3(i + vec3<f32>(1.0, 1.0, 0.0));
    let n001 = hash3(i + vec3<f32>(0.0, 0.0, 1.0));
    let n101 = hash3(i + vec3<f32>(1.0, 0.0, 1.0));
    let n011 = hash3(i + vec3<f32>(0.0, 1.0, 1.0));
    let n111 = hash3(i + vec3<f32>(1.0, 1.0, 1.0));
    let nx00 = mix(n000, n100, u.x);
    let nx10 = mix(n010, n110, u.x);
    let nx01 = mix(n001, n101, u.x);
    let nx11 = mix(n011, n111, u.x);
    return mix(mix(nx00, nx10, u.y), mix(nx01, nx11, u.y), u.z);
}

fn micro_bump(p: vec3<f32>, t0: vec3<f32>, b0: vec3<f32>, step: f32, amp: f32) -> vec3<f32> {
    if (amp <= 0.001) { return vec3<f32>(0.0); }
    let c = vnoise3(p);
    let gx = (vnoise3(p + t0 * step) - c) * (2.0 * amp);
    let gy = (vnoise3(p + b0 * step) - c) * (2.0 * amp);
    return vec3<f32>((c - 0.5) * amp, gx, gy);
}

pub fn fragment(v: mesh::Vertex, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    let mat = floor(v.uv.x + 0.5) as i32;
    let param = v.uv.y;

    let n = normalize(v.normal);
    let up_ref = abs(n.y) < 0.9 ? vec3<f32>(0.0, 1.0, 0.0) : vec3<f32>(1.0, 0.0, 0.0);
    let t0 = normalize(cross(up_ref, n));
    let b0 = cross(n, t0);

    let m_fw = length(dpdx(v.world_pos)) + length(dpdy(v.world_pos));
    let detail_fine = 1.0 - smoothstep(0.06, 0.42, m_fw);
    let detail_mid = 1.0 - smoothstep(0.35, 2.20, m_fw);

    let inst_seed = vec3<f32>(v.v1.w * 0.137, v.v1.w * 0.071, v.v1.w * 0.193);
    let op = v.v0.xyz * 28.0 + inst_seed;
    let op_micro = v.v0.xyz * 210.0 + inst_seed;

    if (mat == 0) {
        let mb = micro_bump(op_micro, t0, b0, 0.22, detail_fine);
        if (param > 0.5) {
            // Crisp interior drywall plaster + clean painted wood baseboard along bottom margin
            let is_base = v.v0.y < 0.045;
            let base_line = smoothstep(0.006, 0.0, abs(v.v0.y - 0.045)) * detail_fine;
            let wall_tex = s.base_color * clamp(1.0 + 0.095 * mb.x, 0.90, 1.10);
            out.base_color = (is_base ? vec3<f32>(0.89, 0.87, 0.83) : wall_tex) * (1.0 - 0.18 * base_line);
            out.roughness = is_base ? 0.44 : clamp(0.84 + 0.05 * mb.x, 0.74, 0.92);
            out.metallic = 0.02;
            out.normal = normalize(n + t0 * (mb.y * 1.45) + b0 * (mb.z * 1.45));
        } else {
            // Exterior architectural siding/masonry horizontal courses + fine masonry micro-grain
            let course = sin(v.v0.y * 42.0) * detail_fine;
            let course_mul = 0.96 + 0.04 * course;
            out.base_color = s.base_color * clamp(1.0 + 0.12 * mb.x, 0.88, 1.12) * course_mul;
            out.roughness = clamp(0.80 + 0.06 * mb.x, 0.68, 0.92);
            out.metallic = 0.02;
            out.normal = normalize(n + t0 * (mb.y * 1.45) + b0 * (mb.z * 1.45 + course * 0.05));
        }
    } else if (mat == 1) {
        // Brushed steel mullions, frames, streetlight poles, elevator cab metal
        let mb = micro_bump(op_micro, t0, b0, 0.22, detail_fine);
        out.base_color = s.base_color * clamp(1.0 + 0.12 * mb.x, 0.88, 1.12);
        out.roughness = clamp(0.36 + 0.06 * mb.x, 0.24, 0.52);
        out.metallic = 0.72;
        out.normal = normalize(n + t0 * (mb.y * 1.25) + b0 * (mb.z * 1.25));
    } else if (mat == 2) {
        if (param > 1.5) {
            // Polished veined lobby marble floor / stone countertop
            let tile_x = abs(fract(v.world_pos.x * 0.8) - 0.5);
            let tile_z = abs(fract(v.world_pos.z * 0.8) - 0.5);
            let grout = smoothstep(0.47, 0.495, max(tile_x, tile_z)) * detail_fine;
            let vein = sin(v.world_pos.x * 1.9 + vnoise3(v.world_pos * 1.2) * 5.0) * 0.5 + 0.5;
            let col_m = mix(vec3<f32>(0.82, 0.80, 0.77), vec3<f32>(0.62, 0.60, 0.57), vein * 0.52);
            let sb = micro_bump(v.world_pos * 24.0, t0, b0, 0.22, detail_fine);
            out.base_color = col_m * (1.0 - 0.28 * grout) * clamp(1.0 + 0.20 * sb.x, 0.82, 1.18);
            out.roughness = mix(0.28, 0.76, grout);
            out.metallic = 0.04;
            out.normal = normalize(n + t0 * (sb.y * 1.75) + b0 * (sb.z * 1.75));
        } else if (param > 0.5) {
            // Hardwood oak plank flooring for homes & offices (crisp high-entropy fiber & plank bevels)
            let plank_z = fract(v.world_pos.z * 4.5);
            let seam_z = smoothstep(0.44, 0.49, abs(plank_z - 0.5)) * detail_fine;
            let plank_id = floor(v.world_pos.z * 4.5);
            let end_x = smoothstep(0.46, 0.495, abs(fract(v.world_pos.x * 0.65 + plank_id * 0.37) - 0.5)) * detail_fine;
            let plank_tint = 0.84 + 0.28 * hash3(vec3<f32>(plank_id, 1.0, 2.0));
            let fiber_coord = vec3<f32>(v.world_pos.x * 3.5, 0.0, v.world_pos.z * 26.0);
            let fb = micro_bump(fiber_coord, t0, b0, 0.16, detail_fine);
            let wood_grain = 0.90 + 0.22 * fb.x;
            let wood_col = vec3<f32>(0.54, 0.38, 0.24) * plank_tint * wood_grain * (1.0 - 0.34 * max(seam_z, end_x));
            out.base_color = wood_col;
            out.roughness = mix(0.42, 0.76, max(seam_z, end_x));
            out.metallic = 0.02;
            out.normal = normalize(n + t0 * (fb.y * 1.55) + b0 * (fb.z * 1.55));
        } else {
            // Sculpted furniture hardwood grain (crisp fine normal & tonal relief)
            let mb = micro_bump(op_micro, t0, b0, 0.22, detail_fine);
            let wood_g = detail_fine > 0.001 ? (vnoise3(vec3<f32>(v.v0.x * 22.0, v.v0.y * 8.0, v.v0.z * 8.0)) - 0.5) * detail_fine : 0.0;
            out.base_color = s.base_color * clamp(1.0 + 0.24 * wood_g + 0.12 * mb.x, 0.78, 1.22);
            out.roughness = 0.54;
            out.metallic = 0.02;
            out.normal = normalize(n + t0 * (mb.y * 1.55) + b0 * (mb.z * 1.55));
        }
    } else if (mat == 3) {
        // Architectural & vehicle glass
        out.roughness = 0.06;
        out.metallic = 0.16;
        out.normal = n;
    } else if (mat == 4) {
        // Polished chrome & alloy rims
        let mb = micro_bump(op, t0, b0, 0.20, max(detail_fine, detail_mid));
        out.base_color = vec3<f32>(0.78, 0.80, 0.84) * clamp(1.0 + 0.10 * mb.x, 0.90, 1.10);
        out.roughness = 0.18;
        out.metallic = 0.90;
        out.normal = normalize(n + t0 * (mb.y * 0.35) + b0 * (mb.z * 0.35));
    } else if (mat == 5) {
        // Emissive lamps, ceiling lights, vehicle headlights/taillights, monitors
        let night_atten = mix(0.85, 0.42, smoothstep(0.15, 0.85, params.night_factor));
        out.base_color = s.base_color;
        out.roughness = 0.25;
        out.metallic = 0.0;
        out.emissive = min(vec3<f32>(0.88), s.base_color * max(0.0, param * params.glow_scale * night_atten));
    } else if (mat == 6) {
        // Satin-gloss clearcoat automotive paint (controlled roughness avoids grazing dusk HDR clipping)
        let flake = detail_fine > 0.001 ? (vnoise3(v.v0.xyz * 36.0) - 0.5) * detail_fine : 0.0;
        out.base_color = min(vec3<f32>(0.42), s.base_color * clamp(1.0 + 0.04 * flake, 0.95, 1.05));
        out.roughness = 0.44;
        out.metallic = 0.14;
        out.normal = n;
    } else if (mat == 7) {
        // Commercial/skyscraper slate rooftops, spire crowns & parapets (crisp fine architectural finish)
        let mb = micro_bump(op_micro, t0, b0, 0.22, detail_fine);
        out.base_color = s.base_color * clamp(1.0 + 0.10 * mb.x, 0.88, 1.12);
        out.roughness = 0.82;
        out.metallic = 0.04;
        out.normal = normalize(n + t0 * (mb.y * 1.45) + b0 * (mb.z * 1.45));
    } else if (mat == 8) {
        // Woven textile upholstery, rugs, canvas art, commercial awnings
        let mb = micro_bump(op_micro, t0, b0, 0.22, detail_fine);
        let weave = (sin(v.v0.x * 90.0) * sin(v.v0.z * 90.0)) * detail_fine;
        out.base_color = s.base_color * clamp(1.0 + 0.12 * weave + 0.12 * mb.x, 0.82, 1.18);
        out.roughness = 0.88;
        out.metallic = 0.0;
        out.normal = normalize(n + t0 * (mb.y * 1.45) + b0 * (mb.z * 1.45));
    } else if (mat == 9) {
        // Botanical foliage
        let mb = micro_bump(op * 0.65, t0, b0, 0.22, max(detail_fine, detail_mid));
        out.base_color = s.base_color * clamp(1.0 + 0.32 * mb.x, 0.72, 1.28);
        out.roughness = 0.82;
        out.metallic = 0.0;
        out.normal = normalize(n + t0 * (mb.y * 1.10) + b0 * (mb.z * 1.10));
    } else if (mat == 10) {
        // Tree bark brown
        let mb = micro_bump(op * 0.65, t0, b0, 0.22, max(detail_fine, detail_mid));
        out.base_color = vec3<f32>(0.29, 0.21, 0.14) * clamp(1.0 + 0.28 * mb.x, 0.74, 1.25);
        out.roughness = 0.90;
        out.metallic = 0.0;
        out.normal = normalize(n + t0 * (mb.y * 1.25) + b0 * (mb.z * 1.25));
    } else if (mat == 11) {
        // Pitched roof slate/asphalt shingles
        let mb = micro_bump(op_micro, t0, b0, 0.22, detail_fine);
        let row = floor(v.v0.y * 7.5);
        let row_seam = smoothstep(0.43, 0.49, abs(fract(v.v0.y * 7.5) - 0.5)) * detail_fine;
        let tab_seam = smoothstep(0.46, 0.495, abs(fract(v.v0.x * 2.2 + row * 0.5) - 0.5)) * detail_fine;
        let grit = detail_fine > 0.001 ? (vnoise3(v.v0.xyz * 22.0) - 0.5) * detail_fine : 0.0;
        out.base_color = s.base_color * clamp(1.0 + 0.10 * grit + 0.08 * mb.x, 0.84, 1.16) * (1.0 - 0.24 * max(row_seam, tab_seam));
        out.roughness = 0.84;
        out.metallic = 0.04;
        out.normal = normalize(n + t0 * (mb.y * 1.55) + b0 * (mb.z * 1.55));
    } else if (mat == 12) {
        // Dark satin automotive tire rubber
        let mb = micro_bump(op, t0, b0, 0.22, max(detail_fine, detail_mid));
        out.base_color = vec3<f32>(0.09, 0.095, 0.105) * clamp(1.0 + 0.18 * mb.x, 0.82, 1.18);
        out.roughness = 0.82;
        out.metallic = 0.02;
        out.normal = normalize(n + t0 * (mb.y * 0.85) + b0 * (mb.z * 0.85));
    } else if (mat == 13) {
        // Dark matte automotive grille, bumper fascia & clean interior backing
        out.base_color = vec3<f32>(0.08, 0.085, 0.095);
        out.roughness = 0.62;
        out.metallic = 0.10;
        out.normal = n;
    }

    if (SCENE_DEBUG(mat_id)) {
        let m = clamp((mat as f32) / 13.0, 0.0, 1.0);
        out = mesh::debug(out, vec3<f32>(m, clamp(param, 0.0, 1.0), 1.0 - m));
    }
    return out;
}
