// Vertex & PBR/emissive fragment hook for GPU-instanced city & interior meshes.
// Clean 3D object-space fBm material grain without diagonal static or bumpy distortions.
module hook;
import mesh;
import scene;

struct InstParams {
    glow_scale: f32,
    night_factor: f32,
    pad0: f32,
    pad1: f32,
}

@binding(4, 0) var params: uniform<InstParams>;

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    v.v0 = vec4<f32>(v_in.pos, v_in.uv.x);
    v.v1 = vec4<f32>(v_in.normal, v_in.instance_index as f32);
    return v;
}

fn hash3(p: vec3<f32>) -> f32 {
    return fract(sin(dot(p, vec3<f32>(127.1, 311.7, 74.7))) * 43758.5453123);
}

fn vnoise3(p: vec3<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (vec3<f32>(3.0, 3.0, 3.0) - f * 2.0);
    let n000 = hash3(i);
    let n100 = hash3(i + vec3<f32>(1.0, 0.0, 0.0));
    let n010 = hash3(i + vec3<f32>(0.0, 1.0, 0.0));
    let n110 = hash3(i + vec3<f32>(1.0, 1.0, 0.0));
    let n001 = hash3(i + vec3<f32>(0.0, 0.0, 1.0));
    let n101 = hash3(i + vec3<f32>(1.0, 0.0, 1.0));
    let n011 = hash3(i + vec3<f32>(0.0, 1.0, 1.0));
    let n111 = hash3(i + vec3<f32>(1.0, 1.0, 1.0));
    let nx00 = mix(n000, n100, u.x);
    let nx10 = mix(n010, n110, u.x);
    let nx01 = mix(n001, n101, u.x);
    let nx11 = mix(n011, n111, u.x);
    return mix(mix(nx00, nx10, u.y), mix(nx01, nx11, u.y), u.z);
}

fn fbm3(p: vec3<f32>) -> f32 {
    return 0.62 * vnoise3(p) + 0.38 * vnoise3(p * 2.27 + vec3<f32>(5.3, 11.7, 3.1));
}

pub fn fragment(v: mesh::Vertex, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    let mat = floor(v.uv.x + 0.5) as i32;
    let param = v.uv.y;

    let n = normalize(v.normal);
    let up_ref = abs(n.y) < 0.9 ? vec3<f32>(0.0, 1.0, 0.0) : vec3<f32>(1.0, 0.0, 0.0);
    let t0 = normalize(cross(up_ref, n));
    let b0 = cross(n, t0);

    // Multi-scale object-space fBm micro + mid relief (uniform control flow, zero diagonal stripes)
    let m_fw = length(dpdx(v.world_pos)) + length(dpdy(v.world_pos));
    let detail_fine = 1.0 - smoothstep(0.06, 0.42, m_fw);
    let detail_mid = 1.0 - smoothstep(0.35, 2.20, m_fw);

    let freq = (mat == 2 || mat == 0 || mat == 9 || mat == 7) ? 5.2 : 6.5;
    let op = v.v0.xyz * freq + vec3<f32>(v.v1.w * 0.137, v.v1.w * 0.071, v.v1.w * 0.193);
    let speck = (vnoise3(op * 3.2) - 0.5) * detail_fine;
    let grain_f = (fbm3(op) - 0.5) * detail_fine;
    let grain_m = (vnoise3(op * 0.28) - 0.5) * detail_mid;
    let grain = grain_f + grain_m * 0.70 + speck * 0.55;
    let g_fx = (vnoise3(op * 2.4 + t0 * 0.11) - vnoise3(op * 2.4 - t0 * 0.11)) * detail_fine;
    let g_fy = (vnoise3(op * 2.4 + b0 * 0.11) - vnoise3(op * 2.4 - b0 * 0.11)) * detail_fine;
    let g_mx = (vnoise3(op * 0.55 + t0 * 0.25) - vnoise3(op * 0.55 - t0 * 0.25)) * detail_mid;
    let g_my = (vnoise3(op * 0.55 + b0 * 0.25) - vnoise3(op * 0.55 - b0 * 0.25)) * detail_mid;
    let gx = (g_fx + g_mx * 0.85) * 9.0;
    let gy = (g_fy + g_my * 0.85) * 9.0;

    if (mat == 0) {
        // Exterior & interior plaster, brick, drywall
        out.base_color = s.base_color * clamp(1.0 + 0.24 * grain, 0.78, 1.22);
        out.roughness = clamp(0.82 + 0.08 * grain, 0.68, 0.94);
        out.metallic = 0.02;
        out.normal = normalize(n + t0 * (gx * 0.18) + b0 * (gy * 0.18));
    } else if (mat == 1) {
        // Brushed steel mullions, frames, streetlight poles, elevator cab metal
        out.base_color = s.base_color * clamp(1.0 + 0.12 * grain, 0.88, 1.12);
        out.roughness = clamp(0.36 + 0.08 * grain, 0.22, 0.55);
        out.metallic = 0.72;
        out.normal = normalize(n + t0 * (gx * 0.08) + b0 * (gy * 0.08));
    } else if (mat == 2) {
        // Slabs, concrete floors, stone, wood furniture, stair treads
        let is_slab = param > 0.5;
        out.base_color = s.base_color * clamp(1.0 + (is_slab ? 0.22 : 0.24) * grain, 0.76, 1.24);
        out.roughness = is_slab ? 0.84 : 0.76;
        out.metallic = 0.02;
        out.normal = normalize(n + t0 * (gx * 0.18) + b0 * (gy * 0.18));
    } else if (mat == 3) {
        // Architectural glass
        out.roughness = 0.06;
        out.metallic = 0.16;
        out.normal = n;
    } else if (mat == 4) {
        // Polished chrome trim & alloy wheel rims
        out.base_color = vec3<f32>(0.78, 0.80, 0.84) * clamp(1.0 + 0.08 * grain, 0.90, 1.10);
        out.roughness = 0.18;
        out.metallic = 0.90;
        out.normal = normalize(n + t0 * (gx * 0.04) + b0 * (gy * 0.04));
    } else if (mat == 5) {
        // Emissive (streetlamps, interior ceiling lights, vehicle headlights/taillights)
        let night_atten = mix(0.85, 0.42, smoothstep(0.15, 0.85, params.night_factor));
        out.base_color = s.base_color;
        out.roughness = 0.25;
        out.metallic = 0.0;
        out.emissive = min(vec3<f32>(1.4), s.base_color * max(0.0, param * params.glow_scale * night_atten));
    } else if (mat == 6) {
        // Mirror-smooth clearcoat metallic automotive paint (zero macro bump distortion)
        let flake = (vnoise3(v.v0.xyz * 36.0) - 0.5) * detail_fine;
        out.base_color = s.base_color * clamp(1.0 + 0.04 * flake, 0.95, 1.05);
        out.roughness = 0.16;
        out.metallic = 0.52;
        out.normal = n;
    } else if (mat == 7) {
        // Rooftops & cornices
        out.base_color = s.base_color * clamp(1.0 + 0.26 * grain, 0.76, 1.24);
        out.roughness = 0.86;
        out.metallic = 0.04;
        out.normal = normalize(n + t0 * (gx * 0.20) + b0 * (gy * 0.20));
    } else if (mat == 9) {
        // Foliage crown tinted by per-instance color
        out.base_color = s.base_color * clamp(1.0 + 0.28 * grain, 0.72, 1.28);
        out.roughness = 0.84;
        out.metallic = 0.0;
        out.normal = normalize(n + t0 * (gx * 0.18) + b0 * (gy * 0.18));
    } else if (mat == 10) {
        // Organic tree bark brown (overrides green foliage tint)
        out.base_color = vec3<f32>(0.29, 0.21, 0.14) * clamp(1.0 + 0.25 * grain, 0.74, 1.25);
        out.roughness = 0.90;
        out.metallic = 0.0;
        out.normal = normalize(n + t0 * (gx * 0.22) + b0 * (gy * 0.22));
    } else if (mat == 12) {
        // Dark satin automotive tire rubber
        out.base_color = vec3<f32>(0.09, 0.095, 0.105) * clamp(1.0 + 0.14 * grain, 0.82, 1.18);
        out.roughness = 0.82;
        out.metallic = 0.02;
        out.normal = normalize(n + t0 * (gx * 0.12) + b0 * (gy * 0.12));
    } else if (mat == 13) {
        // Dark matte automotive grille, bumper fascia & clean interior backing
        out.base_color = vec3<f32>(0.08, 0.085, 0.095);
        out.roughness = 0.62;
        out.metallic = 0.10;
        out.normal = n;
    }

    if (SCENE_DEBUG(mat_id)) {
        let m = clamp((mat as f32) / 7.0, 0.0, 1.0);
        out = mesh::debug(out, vec3<f32>(m, clamp(param, 0.0, 1.0), 1.0 - m));
    }
    return out;
}
