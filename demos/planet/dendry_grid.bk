// The drainage (dendry.bk) over a tile: every point's potential and link
// found once for the tile's batch, in two dispatches a level, so a tile's
// cells each read the segments about them instead of finding them again
// (drain_probed finds 49 potentials and 25 links a level for every point).
//
// A level's grid is the level's cells about the cell of the tile's centre,
// (i, j) from it, out to GRID_R either way, on the centre's face's lattice
// carried on past its edges (dendry.bk cell_step); positions are metres on
// the plane at the tile's anchor. A level is in a tile's grid where any of
// the tile's consumers resolves it: its texels (k_detail_height) and its
// soil (k_soil, coarser), and over the wider ground its horizons march
// through, those (k_horizon_heights), each at its own cell (texel_cell,
// horizon_cell). Each level's grid reaches the cells those consumers read
// about their points, 2 cells either side, and the parents the next level's
// potentials take theirs from (grid_reach).
//
// A point's potential takes the level above's segments from its parent's
// 3 x 3, as drain_probed's do, so the grid and drain_probed are the same
// network: the tile's vertices (k_tile, every level at its point) read the
// levels the grid holds and go on from them in windows of their own as
// drain_probed does (window_point), and stand where every finer tile's
// vertices do.
module planet::dendry_grid;

import tiles;
from planet::rivers import RIV_N, cell_of, cell_next;
from planet::dendry import DRAIN_LEVELS, VALLEY, Seg, no_seg, Near, near_none, near_try, streams_about, Pot, pot_of,
    fall, link_of, seg_packed, seg_unpacked, seg_far, Local, local_frame, to_local, vec_local, from_local, reach_seg,
    seg_dist, chord, valley_term, seg_near, rel_after, mean_rel, base_weight, Tally, tally_none,
    tally_water, tally_level, ubar_next, Drain, drain_of, cell_spread, spacing, fade, rise, cell_in, cell_virtual,
    cell_step, site_dir, site_id, parent_of, grain_at, lean, comp4, strengths;
from planet::ground import frame_dir, cell_width, octaves_for, SOIL_OCTAVES;
from planet::anchor import Anchor;

pub const GRID_R: i32 = 50;
pub const GRID: i32 = 101;       // 2 GRID_R + 1
// The potentials' grid, one cell wider each way (the links' neighbours).
pub const POT_R: i32 = 51;
pub const POT_GRID: i32 = 103;

// The cells a tile's consumers resolve the drainage at: its texels' (found
// every other texel, for two texels' width, planet.bk tex_drains), and its
// horizons' (its own cells': the horizons march over valleys two cells wide
// and more).
pub fn texel_cell(rec: tiles::Record, inv_size: f32, d: f32) -> f32 {
    return cell_width(octaves_for(rec.extent, 2.0 * inv_size / d));
}
pub fn horizon_cell(rec: tiles::Record, inv_size: f32) -> f32 {
    return cell_width(octaves_for(rec.extent, inv_size));
}

// How far level `level`'s grid reaches (-1: not in the grid): the cells
// under the frame's (s, t) from lo to hi, where its consumers read (texels:
// the tile and its border, horizons: a tile's edge beyond it), from the
// corners' cells, the equal-angle lattice being monotone, and 3 more (the
// 5 x 5 read about a point, a cell's rounding); and every level reaches the
// parents of the next's potentials. Level 0 is the rivers' reaches.
pub fn grid_reach(a: Anchor, rec: tiles::Record, level: i32, radius: f32, inv_size: f32, d: f32) -> i32 {
    let tc = texel_cell(rec, inv_size, d);
    let hc = horizon_cell(rec, inv_size);
    let centre = normalize(a.dir + rec.dir_lo);
    // A tile fine enough for the soil (planet.bk k_soil) reads it out to
    // its soil points a spacing past its texels.
    let soil = octaves_for(rec.extent, inv_size / d) > SOIL_OCTAVES;
    var rk: i32 = -1;
    for (var k: i32 = DRAIN_LEVELS; k >= level; k -= 1) {
        let finer = rk;
        rk = -1;
        let lk = spacing(k, radius);
        var lo: f32 = soil ? -0.65 : -0.08;
        var hi: f32 = soil ? 1.65 : 1.08;
        if (fade(lk, hc) > 0.0) {
            lo = -0.5;
            hi = 1.5;
        }
        if (fade(lk, tc) > 0.0) {
            let n = RIV_N << (2 * k);
            let ck = cell_in(centre, n);
            for (var c: i32 = 0; c < 4; c += 1) {
                let s = (c & 1) == 0 ? lo : hi;
                let t = (c & 2) == 0 ? lo : hi;
                let v = cell_virtual(normalize(a.dir + frame_dir(rec, s, t)), ck.x, n) - ck.yz;
                rk = max(rk, max(abs(v.x), abs(v.y)) + 3);
            }
            if (finer >= 0) { rk = max(rk, (finer + 7) / 4 + 1); }
            rk = min(rk, GRID_R);
        }
    }
    return rk;
}

// Level 0's reach (i, j) of tile z in `reaches` (three vec4s, dendry.bk Seg).
fn reach_at(z: i32, i: i32, j: i32) -> i32 {
    return ((z * GRID + j + GRID_R) * GRID + i + GRID_R) * 3;
}
fn grid_reach_seg(reaches: read_store<vec4<f32>, 1>, z: i32, i: i32, j: i32) -> Seg {
    let at = reach_at(z, i, j);
    return Seg { a: reaches[at], b: reaches[at + 1], c: reaches[at + 2] };
}
// Reach (gx, gy) of tile z's level 0 grid, from the rivers' network.
pub fn grid_reach_point(reaches: write_store<vec4<f32>, 1>, net: read_store<f32, 1>, a: Anchor, rec: tiles::Record,
                        z: i32, gx: i32, gy: i32, radius: f32, inv_size: f32, d: f32) {
    let r = grid_reach(a, rec, 0, radius, inv_size, d);
    let i = gx - GRID_R;
    let j = gy - GRID_R;
    if (r < 0 || abs(i) > r || abs(j) > r) { return; }
    let s = reach_seg(net, cell_next(cell_of(normalize(a.dir + rec.dir_lo)), i, j), local_frame(a.dir, rec.dir_lo, radius));
    let at = reach_at(z, i, j);
    reaches[at] = s.a;
    reaches[at + 1] = s.b;
    reaches[at + 2] = s.c;
}

// Where level k's segment (i, j) of the batch's tile z lies in the grids'
// store (two vec4s, dendry.bk seg_packed), `tiles` tiles a level.
fn seg_at(k: i32, z: i32, tiles: i32, i: i32, j: i32) -> i32 {
    return ((((k - 1) * tiles + z) * GRID + j + GRID_R) * GRID + i + GRID_R) * 2;
}
fn pot_at(z: i32, i: i32, j: i32) -> i32 {
    return ((z * POT_GRID + j + POT_R) * POT_GRID + i + POT_R) * 2;
}
fn grid_seg(segs: read_store<vec4<f32>, 1>, k: i32, z: i32, tiles: i32, i: i32, j: i32) -> Seg {
    let at = seg_at(k, z, tiles, i, j);
    return seg_unpacked(segs[at], segs[at + 1]);
}

// ── The grids ──────────────────────────────────────────────────────────────

// Level k's point (gx, gy) of the potentials' grid of tile z: its potential
// from the level above's segments about its parent (level 0's reaches from
// the rivers' network).
pub fn grid_point(pots: write_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>, reaches: read_store<vec4<f32>, 1>,
                  a: Anchor, rec: tiles::Record, k: i32, z: i32, tiles: i32, gx: i32, gy: i32,
                  radius: f32, inv_size: f32, d: f32, seed: i32) {
    let r = grid_reach(a, rec, k, radius, inv_size, d);
    let i = gx - POT_R;
    let j = gy - POT_R;
    if (r < 0 || abs(i) > r + 1 || abs(j) > r + 1) { return; }
    let f = local_frame(a.dir, rec.dir_lo, radius);
    let centre = normalize(a.dir + rec.dir_lo);
    let n = RIV_N << (2 * k);
    let ck = cell_in(centre, n);
    let lk = spacing(k, radius);
    let sig = rise(k);
    let x = to_local(f, site_dir(cell_step(ck, i, j, n), n, seed + 1000 * k));
    let pi = parent_of(ck.y + i) - parent_of(ck.y);
    let pj = parent_of(ck.z + j) - parent_of(ck.z);
    var near = near_none();
    if (k == 1) {
        for (var e: i32 = 0; e < 9; e += 1) {
            near = near_try(near, grid_reach_seg(reaches, z, pi + e % 3 - 1, pj + e / 3 - 1), x, sig, lk);
        }
    } else {
        for (var e: i32 = 0; e < 9; e += 1) {
            near = near_try(near, grid_seg(segs, k - 1, z, tiles, pi + e % 3 - 1, pj + e / 3 - 1), x, sig, lk);
        }
    }
    let p = pot_of(near, x, k, lk, seed);
    let at = pot_at(z, i, j);
    pots[at] = p.a;
    pots[at + 1] = p.b;
}

// Level k's segment (gx, gy) of tile z's grid: its point's link, from the
// potentials about it, in the grain at its point.
pub fn grid_link(segs: write_store<vec4<f32>, 1>, pots: read_store<vec4<f32>, 1>, a: Anchor, rec: tiles::Record,
                 k: i32, z: i32, tiles: i32, gx: i32, gy: i32, radius: f32, inv_size: f32, d: f32, seed: i32) {
    let r = grid_reach(a, rec, k, radius, inv_size, d);
    let i = gx - GRID_R;
    let j = gy - GRID_R;
    if (r < 0 || abs(i) > r || abs(j) > r) { return; }
    let n = RIV_N << (2 * k);
    let ck = cell_in(normalize(a.dir + rec.dir_lo), n);
    let o = pot_at(z, i, j);
    let po = Pot { a: pots[o], b: pots[o + 1] };
    let f = local_frame(a.dir, rec.dir_lo, radius);
    let grain = grain_at(from_local(f, po.a.xy), f, seed);
    var tgt: i32 = o;
    var steep: f32 = 0.0;
    for (var nb: i32 = 0; nb < 9; nb += 1) {
        let at = pot_at(z, i + nb % 3 - 1, j + nb / 3 - 1);
        let pt = Pot { a: pots[at], b: pots[at + 1] };
        let sl = fall(po, pt) * lean(grain, po, pt);
        if (sl > steep) {
            steep = sl;
            tgt = at;
        }
    }
    let s = link_of(po, Pot { a: pots[tgt], b: pots[tgt + 1] }, tgt != o, k, rise(k), site_id(cell_step(ck, i, j, n), k));
    let at = seg_at(k, z, tiles, i, j);
    segs[at] = s.a;
    segs[at + 1] = seg_packed(s);
}

// ── A tile's points' drainage ──────────────────────────────────────────────

// The drainage at a tile's point from its levels' parts: the levels a cell
// `cell` wide resolves while they are taken. `next` is the first level not
// taken, `onward` whether the cell resolves it.
struct Walk {
    base: f32,
    rel: f32,
    ubar: f32,
    t: Tally,
    next: i32,
    onward: bool,
    drops: vec4<f32>,
}
// v with component i set to x.
fn set4(v: vec4<f32>, i: i32, x: f32) -> vec4<f32> {
    return vec4<f32>(i == 0 ? x : v.x, i == 1 ? x : v.y, i == 2 ? x : v.z, i == 3 ? x : v.w);
}

// Whether tile rec's grid holds level k (its texels resolve it).
pub fn grid_holds(rec: tiles::Record, k: i32, radius: f32, inv_size: f32, d: f32) -> bool {
    return fade(spacing(k, radius), texel_cell(rec, inv_size, d)) > 0.0;
}

// How the walk takes level k (1 on) for a cell `cell` wide, the grid's
// texels `tc`: 1 from the grid, 0 not at all (the cell does not resolve it:
// the mean over its valleys), 2 not from the grid (it does not hold it).
fn level_taken(k: i32, cell: f32, tc: f32, radius: f32) -> i32 {
    let lk = spacing(k, radius);
    if (fade(lk, cell) <= 0.0) { return 0; }
    if (fade(lk, tc) <= 0.0) { return 2; }
    return 1;
}

// Level k's part of the drainage at a tile's point, for a cell `cell` wide,
// found on its own (a thread's, so a point's levels are found side by
// side): x the sum of its valleys' terms (dendry.bk valley_term), y the
// distance to its nearest stream, z its streams' height about here
// (streams_about, from the level above's 3 x 3 about here; level 0's: the
// base level), w its channels' share of the cell and their banks' (12 bits
// each, a float exactly). y is 1e9 where the walk does not take it.
pub fn level_part(segs: read_store<vec4<f32>, 1>, reaches: read_store<vec4<f32>, 1>, net: read_store<f32, 1>,
                  a: Anchor, rec: tiles::Record, z: i32, tiles: i32, e: vec3<f32>, cell: f32, k: i32, radius: f32,
                  inv_size: f32, d: f32, seed: i32) -> vec4<f32> {
    let tc = texel_cell(rec, inv_size, d);
    if (k > 0 && level_taken(k, cell, tc, radius) != 1) { return vec4<f32>(0.0, 1.0e9, 1.0e9, 0.0); }
    let f = local_frame(a.dir, rec.dir_lo, radius);
    let q = vec_local(f, e - rec.dir_lo) * radius;
    let dq = normalize(a.dir + e);
    let centre = normalize(a.dir + rec.dir_lo);
    let sg = cell_spread(cell);
    let lk = spacing(k, radius);
    let wk = VALLEY * lk;
    let fk = fade(lk, cell);
    var t = tally_none();
    var acc: f32 = 0.0;
    var dmin: f32 = 1.0e9;
    let ct = cell_of(centre);
    if (k == 0) {
        // From the grid where it holds level 0 (always, where the cell
        // resolves it), else from the network: the base level is every
        // cell's.
        let held = fade(lk, tc) > 0.0;
        let c0 = cell_of(dq);
        let q0 = cell_virtual(dq, ct.x, RIV_N) - ct.yz;
        var zsum: f32 = 0.0;
        var wsum: f32 = 0.0;
        for (var m: i32 = 0; m < 25; m += 1) {
            var s: Seg;
            if (held) {
                s = grid_reach_seg(reaches, z, q0.x + m % 5 - 2, q0.y + m / 5 - 2);
            } else {
                s = reach_seg(net, cell_next(c0, m % 5 - 2, m / 5 - 2), f);
            }
            if (s.c.z > 0.0) {
                let ch = chord(s.a, q);
                let wt = base_weight(ch.x / lk);
                zsum += wt * mix(s.b.z, s.b.w, ch.y / ch.z);
                wsum += wt;
                if (fk > 0.0) {
                    let dt = seg_dist(s.a, s.c, q, 0, wk, seed);
                    acc += valley_term(s, dt, 0, wk);
                    if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, 0, wk)); }
                    t = tally_water(t, s, dt.x, 0, 1.0, sg);
                }
            }
        }
        return vec4<f32>(acc, dmin, wsum > 0.0 ? zsum / wsum : 0.0, water_word(t));
    }
    // The streams about here: from the level above's 3 x 3 about here.
    var near = near_none();
    let sig = rise(k);
    if (k == 1) {
        let q0 = cell_virtual(dq, ct.x, RIV_N) - ct.yz;
        for (var m: i32 = 0; m < 9; m += 1) {
            near = near_try(near, grid_reach_seg(reaches, z, q0.x + m % 3 - 1, q0.y + m / 3 - 1), q, sig, lk);
        }
    } else {
        let np = RIV_N << (2 * (k - 1));
        let cp = cell_in(centre, np);
        let qp = cell_virtual(dq, cp.x, np) - cp.yz;
        for (var m: i32 = 0; m < 9; m += 1) {
            near = near_try(near, grid_seg(segs, k - 1, z, tiles, qp.x + m % 3 - 1, qp.y + m / 3 - 1), q, sig, lk);
        }
    }
    let n = RIV_N << (2 * k);
    let ck = cell_in(centre, n);
    let qv = cell_virtual(dq, ck.x, n) - ck.yz;
    for (var m: i32 = 0; m < 25; m += 1) {
        // A segment two valleys' widths away adds nothing here (its floor's
        // wetness is under a percent): its first vec4 says so.
        let at = seg_at(k, z, tiles, qv.x + m % 5 - 2, qv.y + m / 5 - 2);
        let a4 = segs[at];
        if (seg_far(a4, q, 2.0 * wk)) { continue; }
        let s = seg_unpacked(a4, segs[at + 1]);
        if (s.c.z > 0.0) {
            let dt = seg_dist(s.a, s.c, q, k, wk, seed);
            acc += valley_term(s, dt, k, wk);
            // (seg_near is never nearer than the distance itself.)
            if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, k, wk)); }
            t = tally_water(t, s, dt.x, k, fk, sg);
        }
    }
    return vec4<f32>(acc, dmin, streams_about(near, sig), water_word(t));
}
fn water_word(t: Tally) -> f32 {
    let share = (clamp(t.share, 0.0, 1.0) * 4095.0 + 0.5) as i32;
    let gallery = (clamp(t.gallery, 0.0, 1.0) * 4095.0 + 0.5) as i32;
    return (share + 4096 * gallery) as f32;
}
fn with_water(t: Tally, word: f32) -> Tally {
    var o = t;
    let w = word as i32;
    o.share = max(o.share, ((w & 4095) as f32) / 4095.0);
    o.gallery = max(o.gallery, ((w >> 12) as f32) / 4095.0);
    return o;
}

// The walk from the levels' parts, each level's floors and interfluves as
// strong as the region's strengths `st` (dendry.bk strengths) say; its
// depth whole (dendry.bk drained takes it as strong as the land cuts it).
fn walk_parts(p0: vec4<f32>, p1: vec4<f32>, p2: vec4<f32>, p3: vec4<f32>, p4: vec4<f32>, cell: f32, tc: f32,
              radius: f32, st: vec4<f32>) -> Walk {
    let l0 = spacing(0, radius);
    let f0 = fade(l0, cell);
    var w: Walk;
    w.base = p0.z;
    w.rel = rel_after(1.0, p0.x, 0.0, f0);
    w.t = tally_level(with_water(tally_none(), p0.w), 0, p0.y, VALLEY * l0, f0, 1.0);
    w.ubar = 0.0;
    w.next = 1;
    w.onward = f0 > 0.0;
    w.drops = vec4<f32>(0.0);
    for (var k: i32 = 1; k <= DRAIN_LEVELS; k += 1) {
        if (w.next != k || !w.onward) { continue; }
        let taken = level_taken(k, cell, tc, radius);
        if (taken == 0) {
            w.onward = false;
            continue;
        }
        if (taken == 2) { continue; }
        var p = p4;
        if (k == 1) { p = p1; }
        if (k == 2) { p = p2; }
        if (k == 3) { p = p3; }
        let lk = spacing(k, radius);
        let fk = fade(lk, cell);
        let ak = comp4(st, k - 1);
        let before = w.rel;
        w.ubar = p.z < 1.0e8 ? p.z : ubar_next(w.ubar, k);
        w.rel = rel_after(w.rel, p.x, w.ubar, fk);
        w.t = tally_level(with_water(w.t, p.w), k, p.y, VALLEY * lk, fk, ak);
        w.drops = set4(w.drops, k - 1, before - w.rel);
        w.next = k + 1;
    }
    return w;
}
// The drainage from the levels' parts, the levels found down to a cell `tc`
// wide (the grid's texel_cell; a vertex's own, its windows going on past
// the grid), the rest as the means over their valleys, in land of dryness
// `dry` (dendry.bk dryness).
pub fn drain_parts(p0: vec4<f32>, p1: vec4<f32>, p2: vec4<f32>, p3: vec4<f32>, p4: vec4<f32>, cell: f32,
                   tc: f32, radius: f32, dry: f32) -> Drain {
    let st = strengths(dry, 0.0, radius);
    let w = walk_means(walk_parts(p0, p1, p2, p3, p4, cell, tc, radius, st), radius, st);
    return drain_of(w.base, w.rel, w.t, vec4<f32>(1.0), w.drops, dry);
}

// The levels from `next` on as the means over their valleys.
fn walk_means(w: Walk, radius: f32, st: vec4<f32>) -> Walk {
    var o = w;
    for (var k: i32 = 1; k <= DRAIN_LEVELS; k += 1) {
        if (k < o.next) { continue; }
        let ak = comp4(st, k - 1);
        let before = o.rel;
        o.ubar = ubar_next(o.ubar, k);
        o.rel = mean_rel(o.rel, o.ubar);
        o.t = tally_level(o.t, k, 1.0e9, VALLEY * spacing(k, radius), 0.0, ak);
        o.drops = set4(o.drops, k - 1, before - o.rel);
    }
    o.next = DRAIN_LEVELS + 1;
    return o;
}

// ── The vertices' windows ──────────────────────────────────────────────────

// A tile's vertices stand at every level (k_tile: a parent's vertices are
// every other one of its children's), and the levels finer than its grid
// holds are found about each vertex on its own, as drain_probed finds them:
// level k's 7 x 7 potentials about the vertex's cell from the level above's
// 5 x 5 links about its own (the grid's, or the window's), then its 5 x 5
// links from them, a thread a potential and a link (window_point,
// window_link), level by level. The levels' parts then read a window's
// links (window_part) as they read the grid's (level_part). On one thread a
// vertex, a coarse tile's 1296 found those levels one after another, the
// batch's longest by far.
//
// A window is WIN records a level, two vec4s each: the 25 links (seg_packed)
// and, in the last's x, the streams' height about the vertex
// (streams_about); a vertex's potentials, POTS records, the last that height.
pub const WIN: i32 = 26;
pub const POTS: i32 = 50;
fn win_at(z: i32, v: i32, verts: i32, k: i32, m: i32) -> i32 {
    return (((z * verts + v) * DRAIN_LEVELS + k - 1) * WIN + m) * 2;
}
fn wpot_at(z: i32, v: i32, verts: i32, m: i32) -> i32 {
    return ((z * verts + v) * POTS + m) * 2;
}

// Vertex v's (offset e) level k potential m of its window: its 7 x 7 cells'
// row by row, then at the vertex itself (the streams' height about it).
pub fn window_point(pots: write_store<vec4<f32>, 1>, win: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>,
                    reaches: read_store<vec4<f32>, 1>, net: read_store<f32, 1>, a: Anchor, rec: tiles::Record,
                    z: i32, tiles: i32, e: vec3<f32>, v: i32, verts: i32, m: i32, k: i32, radius: f32, inv_size: f32,
                    d: f32, seed: i32) {
    if (grid_holds(rec, k, radius, inv_size, d)) { return; }
    let f = local_frame(a.dir, rec.dir_lo, radius);
    let dq = normalize(a.dir + e);
    let n = RIV_N << (2 * k);
    let ck = cell_in(dq, n);
    let lk = spacing(k, radius);
    let sig = rise(k);
    var di: i32 = 0;
    var dj: i32 = 0;
    var x = vec_local(f, e - rec.dir_lo) * radius;
    if (m < 49) {
        di = m % 7 - 3;
        dj = m / 7 - 3;
        x = to_local(f, site_dir(cell_step(ck, di, dj, n), n, seed + 1000 * k));
    }
    // Its parent's 3 x 3 in the level above's 5 x 5 about the vertex.
    let pi = parent_of(ck.y + di) - parent_of(ck.y);
    let pj = parent_of(ck.z + dj) - parent_of(ck.z);
    let up = k - 1;
    let centre = normalize(a.dir + rec.dir_lo);
    var near = near_none();
    if (up >= 1 && !grid_holds(rec, up, radius, inv_size, d)) {
        for (var c: i32 = 0; c < 9; c += 1) {
            let at = win_at(z, v, verts, up, (pj + c / 3 + 1) * 5 + pi + c % 3 + 1);
            near = near_try(near, seg_unpacked(win[at], win[at + 1]), x, sig, lk);
        }
    } else if (up >= 1) {
        let np = RIV_N << (2 * up);
        let cp = cell_in(centre, np);
        let qp = cell_virtual(dq, cp.x, np) - cp.yz;
        for (var c: i32 = 0; c < 9; c += 1) {
            near = near_try(near, grid_seg(segs, up, z, tiles, qp.x + pi + c % 3 - 1, qp.y + pj + c / 3 - 1), x, sig, lk);
        }
    } else if (grid_holds(rec, 0, radius, inv_size, d)) {
        let ct = cell_of(centre);
        let q0 = cell_virtual(dq, ct.x, RIV_N) - ct.yz;
        for (var c: i32 = 0; c < 9; c += 1) {
            near = near_try(near, grid_reach_seg(reaches, z, q0.x + pi + c % 3 - 1, q0.y + pj + c / 3 - 1), x, sig, lk);
        }
    } else {
        let c0 = cell_of(dq);
        for (var c: i32 = 0; c < 9; c += 1) {
            near = near_try(near, reach_seg(net, cell_next(c0, pi + c % 3 - 1, pj + c / 3 - 1), f), x, sig, lk);
        }
    }
    let at = wpot_at(z, v, verts, m);
    if (m == 49) {
        pots[at] = vec4<f32>(streams_about(near, sig), 0.0, 0.0, 0.0);
        return;
    }
    let p = pot_of(near, x, k, lk, seed);
    pots[at] = p.a;
    pots[at + 1] = p.b;
}

// Vertex v's level k link m of its window, its 5 x 5 cells' row by row, from
// its potentials (m 25: the streams' height about it, copied).
pub fn window_link(win: write_store<vec4<f32>, 1>, pots: read_store<vec4<f32>, 1>, a: Anchor, rec: tiles::Record,
                   z: i32, e: vec3<f32>, v: i32, verts: i32, m: i32, k: i32, radius: f32, inv_size: f32, d: f32,
                   seed: i32) {
    if (grid_holds(rec, k, radius, inv_size, d)) { return; }
    let out = win_at(z, v, verts, k, m);
    if (m == 25) {
        win[out] = pots[wpot_at(z, v, verts, 49)];
        return;
    }
    let dq = normalize(a.dir + e);
    let n = RIV_N << (2 * k);
    let ck = cell_in(dq, n);
    let o = (m / 5 + 1) * 7 + m % 5 + 1;
    let ao = wpot_at(z, v, verts, o);
    let po = Pot { a: pots[ao], b: pots[ao + 1] };
    // The grain about the vertex (dendry.bk grain_at).
    let grain = grain_at(dq, local_frame(a.dir, rec.dir_lo, radius), seed);
    var tgt: i32 = ao;
    var steep: f32 = 0.0;
    for (var nb: i32 = 0; nb < 9; nb += 1) {
        let at = wpot_at(z, v, verts, o + (nb / 3 - 1) * 7 + nb % 3 - 1);
        let pt = Pot { a: pots[at], b: pots[at + 1] };
        let sl = fall(po, pt) * lean(grain, po, pt);
        if (sl > steep) {
            steep = sl;
            tgt = at;
        }
    }
    let s = link_of(po, Pot { a: pots[tgt], b: pots[tgt + 1] }, tgt != ao, k, rise(k),
                    site_id(cell_step(ck, m % 5 - 2, m / 5 - 2, n), k));
    win[out] = s.a;
    win[out + 1] = seg_packed(s);
}

// Level k's part at vertex v (offset e) from its window, as level_part's.
pub fn window_part(win: read_store<vec4<f32>, 1>, a: Anchor, rec: tiles::Record, z: i32, e: vec3<f32>, v: i32,
                   verts: i32, cell: f32, k: i32, radius: f32, seed: i32) -> vec4<f32> {
    let f = local_frame(a.dir, rec.dir_lo, radius);
    let q = vec_local(f, e - rec.dir_lo) * radius;
    let sg = cell_spread(cell);
    let lk = spacing(k, radius);
    let wk = VALLEY * lk;
    let fk = fade(lk, cell);
    var t = tally_none();
    var acc: f32 = 0.0;
    var dmin: f32 = 1.0e9;
    for (var m: i32 = 0; m < 25; m += 1) {
        let at = win_at(z, v, verts, k, m);
        let a4 = win[at];
        if (seg_far(a4, q, 2.0 * wk)) { continue; }
        let s = seg_unpacked(a4, win[at + 1]);
        if (s.c.z > 0.0) {
            let dt = seg_dist(s.a, s.c, q, k, wk, seed);
            acc += valley_term(s, dt, k, wk);
            if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, k, wk)); }
            t = tally_water(t, s, dt.x, k, fk, sg);
        }
    }
    return vec4<f32>(acc, dmin, win[win_at(z, v, verts, k, 25)].x, water_word(t));
}

