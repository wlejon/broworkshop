// Building the drainage network (rivers.bk): the points' heights, the level
// water stands at over each, their downstream neighbours and their
// catchments, into the network's records. Each kernel runs over every
// point, as grid (i, j, face).
from planet::ground import terrain_base;
from planet::rivers import RIV_N, RIV_REC, RIV_OCTAVES, point_index, point_cell, point_dir, cell_next;

// The fall from a lake's point to the next toward its outlet (m): a lake's
// level is all but flat, and still drains one way.
const LAKE_FALL: f32 = 0.05;
// The deepest a lake stands over its deepest floor (m).
const LAKE_MAX: f32 = 30.0;

// Each point's height: the ground before the water cuts it, at the octaves
// the lattice resolves; no downstream yet, a catchment of itself. And the
// fill's start: the sea at its own height, land as high as can be.
@kernel @grid(3)
fn k_river_height(g: grid<3>, net: write_store<f32, 1>, level: write_store<f32, 1>,
                  radius: f64, seed: i32) {
    let c = vec3<i32>(g.z(), g.x(), g.y());
    let p = point_index(c);
    let k = p * RIV_REC;
    let dir = point_dir(c, seed);
    let h = terrain_base(dir, radius, RIV_OCTAVES, seed) as f32;
    net[k] = h;
    net[k + 1] = -1.0;
    net[k + 2] = 1.0;
    net[k + 3] = h;
    net[k + 4] = dir.x as f32;
    net[k + 5] = dir.y as f32;
    net[k + 6] = dir.z as f32;
    net[k + 7] = 0.0;
    level[p] = h <= 0.0 ? h : 1.0e9;
}

// One step of the fill (Planchon and Darboux 2001): a point's level falls
// to its ground, or to LAKE_FALL over its lowest neighbour's level where
// that is higher. From the sea inward the levels settle to the ground where
// it drains and to the spill where it does not, a chain n points long in n
// steps.
@kernel @grid(3)
fn k_river_fill(g: grid<3>, net: read_store<f32, 1>, src: read_store<f32, 1>, dst: write_store<f32, 1>) {
    let c = vec3<i32>(g.z(), g.x(), g.y());
    let p = point_index(c);
    let h = net[p * RIV_REC];
    var w = src[p];
    if (w > h) {
        var lowest: f32 = 1.0e9;
        for (var dj: i32 = -1; dj <= 1; dj += 1) {
            for (var di: i32 = -1; di <= 1; di += 1) {
                if (di != 0 || dj != 0) {
                    lowest = min(lowest, src[point_index(cell_next(c, di, dj))]);
                }
            }
        }
        w = min(w, max(h, lowest + LAKE_FALL));
    }
    dst[p] = w;
}

// Each point's level into its record, and its downstream neighbour: of its
// 8, the one its level falls to most steeply; none at the sea, or where the
// fill has not reached.
@kernel @grid(3)
fn k_river_down(g: grid<3>, net: rw_store<f32, 1>, level: read_store<f32, 1>, seed: i32) {
    let c = vec3<i32>(g.z(), g.x(), g.y());
    let p = point_index(c);
    let k = p * RIV_REC;
    let w = level[p];
    net[k + 3] = w > 1.0e8 ? net[k] : w;
    if (net[k] <= 0.0 || w > 1.0e8) { return; }
    let dir = point_dir(c, seed);
    var best: f32 = 0.0;
    var down: i32 = -1;
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            if (di != 0 || dj != 0) {
                let nc = cell_next(c, di, dj);
                let n = point_index(nc);
                let fall = w - level[n];
                if (fall > 0.0) {
                    let slope = fall / (length(point_dir(nc, seed) - dir) as f32);
                    if (slope > best) {
                        best = slope;
                        down = n;
                    }
                }
            }
        }
    }
    net[k + 1] = down as f32;
}

// One step of the catchments: each point's, itself and the catchments of
// the neighbours that drain into it. A chain n points long settles in n
// steps.
@kernel @grid(3)
fn k_river_catchment(g: grid<3>, net: read_store<f32, 1>, src: read_store<f32, 1>, dst: write_store<f32, 1>) {
    let c = vec3<i32>(g.z(), g.x(), g.y());
    let k = point_index(c);
    var sum: f32 = 1.0;
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            if (di != 0 || dj != 0) {
                let n = point_index(cell_next(c, di, dj));
                if ((net[n * RIV_REC + 1] as i32) == k) { sum += src[n]; }
            }
        }
    }
    dst[k] = sum;
}

// The rivers' floors and water. The lattice's broad heights pass over the
// full ground's hollows between its points, which lie hundreds of metres
// lower; a river drawn at them stood in the air over a hollow, its valley
// cut as a shelf into the slopes on either side, and a lake at their level
// was a ring of water about the hollow's slopes. So each point's floor is
// the lowest of the full ground along its reach to its downstream point
// (FLOOR_SAMPLES heights at FLOOR_OCTAVES, hollows a few tens of metres
// wide), and its water stands over the floors as the lattice's did over
// its heights: filled from the sea up each chain, so a hollow holds a lake
// to its rim, then breached, so a lake stands no more than LAKE_MAX over
// its deepest floor and its outlet cuts a gorge through the rim at that
// level (Lindsay 2016, filling and breaching together).
const FLOOR_SAMPLES: i32 = 9;
const FLOOR_OCTAVES: f64 = 12.0;
@kernel @grid(3)
fn k_river_floor(g: grid<3>, net: read_store<f32, 1>, dst: write_store<f32, 1>, radius: f64, seed: i32) {
    let c = vec3<i32>(g.z(), g.x(), g.y());
    let k = point_index(c);
    let dir = point_dir(c, seed);
    var floor = max(terrain_base(dir, radius, FLOOR_OCTAVES, seed) as f32, 0.0);
    let down = net[k * RIV_REC + 1] as i32;
    if (down >= 0) {
        let b = point_dir(point_cell(down), seed);
        for (var i: i32 = 1; i < FLOOR_SAMPLES; i += 1) {
            let t = (i as f64) / ((FLOOR_SAMPLES - 1) as f64);
            let h = terrain_base(normalize(dir + (b - dir) * t), radius, FLOOR_OCTAVES, seed) as f32;
            floor = min(floor, max(h, 0.0));
        }
    }
    dst[k] = floor;
}

// One step of the fill up the chains: a point's water stands at its floor,
// or at its downstream point's water where that is higher. A chain n
// points long settles in n steps.
@kernel @grid(3)
fn k_river_rise(g: grid<3>, net: read_store<f32, 1>, floor: read_store<f32, 1>, src: read_store<f32, 1>, dst: write_store<f32, 1>) {
    let k = point_index(vec3<i32>(g.z(), g.x(), g.y()));
    let down = net[k * RIV_REC + 1] as i32;
    var w = floor[k];
    if (down >= 0) { w = max(w, src[down]); }
    dst[k] = w;
}

// The start of the breach: each point's water no more than LAKE_MAX over
// its floor.
@kernel @grid(3)
fn k_river_breach_start(g: grid<3>, floor: read_store<f32, 1>, src: read_store<f32, 1>, dst: write_store<f32, 1>) {
    let k = point_index(vec3<i32>(g.z(), g.x(), g.y()));
    dst[k] = min(src[k], floor[k] + LAKE_MAX);
}

// One step of the breach: a point's water is no higher than the water of
// the points draining into it, so it falls all along its way to the sea; a
// chain n points long settles in n steps.
@kernel @grid(3)
fn k_river_breach(g: grid<3>, net: read_store<f32, 1>, src: read_store<f32, 1>, dst: write_store<f32, 1>) {
    let c = vec3<i32>(g.z(), g.x(), g.y());
    let k = point_index(c);
    var w = src[k];
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            if (di != 0 || dj != 0) {
                let n = point_index(cell_next(c, di, dj));
                if ((net[n * RIV_REC + 1] as i32) == k) { w = min(w, src[n]); }
            }
        }
    }
    dst[k] = w;
}

// The catchments, the breached water and the floors into the records.
@kernel @grid(3)
fn k_river_store(g: grid<3>, net: rw_store<f32, 1>, catchment: read_store<f32, 1>, water: read_store<f32, 1>,
                 floor: read_store<f32, 1>) {
    let k = point_index(vec3<i32>(g.z(), g.x(), g.y()));
    net[k * RIV_REC + 2] = catchment[k];
    net[k * RIV_REC + 3] = water[k];
    net[k * RIV_REC + 7] = floor[k];
}

// Each point's tangent, the way its water runs through it, into its record
// (rivers.bk RIV_REC 8-10): halfway between the way it comes in from its
// main tributary (the neighbour of the largest catchment draining into it)
// and the way it leaves toward its downstream point; a source's the way it
// leaves, a mouth's the way it comes in. The reaches on either side bend to
// it, so a river runs smoothly through its points instead of turning there.
@kernel @grid(3)
fn k_river_tangent(g: grid<3>, net: rw_store<f32, 1>) {
    let c = vec3<i32>(g.z(), g.x(), g.y());
    let k = point_index(c);
    let here = vec3<f32>(net[k * RIV_REC + 4], net[k * RIV_REC + 5], net[k * RIV_REC + 6]);
    var into = vec3<f32>(0.0, 0.0, 0.0);
    var most: f32 = 0.0;
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            if (di != 0 || dj != 0) {
                let n = point_index(cell_next(c, di, dj));
                let m = net[n * RIV_REC + 2];
                if ((net[n * RIV_REC + 1] as i32) == k && m > most) {
                    most = m;
                    into = normalize(here - vec3<f32>(net[n * RIV_REC + 4], net[n * RIV_REC + 5], net[n * RIV_REC + 6]));
                }
            }
        }
    }
    let down = net[k * RIV_REC + 1] as i32;
    var out = vec3<f32>(0.0, 0.0, 0.0);
    if (down >= 0) {
        out = normalize(vec3<f32>(net[down * RIV_REC + 4], net[down * RIV_REC + 5], net[down * RIV_REC + 6]) - here);
    }
    let t = into + out;
    let l = length(t);
    var tangent = vec3<f32>(0.0, 0.0, 0.0);
    if (l > 1e-6) { tangent = t / l; }
    net[k * RIV_REC + 8] = tangent.x;
    net[k * RIV_REC + 9] = tangent.y;
    net[k * RIV_REC + 10] = tangent.z;
}
