// The grass's ground (grass.js): a field of points about the eye, on the
// gnomonic plane of a cube face (the points a + e u + f v projected onto the
// sphere), each the ground's true surface there, how much of it grows grass,
// and its albedo; and on a coarser grid how much of the sun's disc it sees.
// The blades stand on the field, between its points.
from planet::ground import terrain, surface, grass_cover, variation;
from planet::rivers import water_at, water_share;

// The plane point of field point (x, y) (-1 and the width are the border).
fn field_dir(a: vec3<f64>, e: vec3<f64>, f: vec3<f64>, u0: f64, v0: f64, delta: f64, x: i32, y: i32) -> vec3<f64> {
    return normalize(a + e * (u0 + (x as f64) * delta) + f * (v0 + (y as f64) * delta));
}

// The terrain's height over the field and a point's border about it: grid
// point (x, y) is field point (x - 1, y - 1), into `heights` at
// y * width + x.
@kernel @grid(2)
fn k_grass_heights(g: grid<2>, heights: write_store<f32, 1>,
                   ax: f64, ay: f64, az: f64, ex: f64, ey: f64, ez: f64, fx: f64, fy: f64, fz: f64,
                   u0: f64, v0: f64, delta: f64, radius: f64, octaves: f64, seed: i32, net: read_store<f32, 1>) {
    let dir = field_dir(vec3<f64>(ax, ay, az), vec3<f64>(ex, ey, ez), vec3<f64>(fx, fy, fz), u0, v0, delta, g.x() - 1, g.y() - 1);
    heights[g.y() * g.width() + g.x()] = terrain(dir, radius, octaves, seed, net) as f32;
}

// Point (x, y) of the field at plane point (u0 + x delta, v0 + y delta),
// seven floats at `out` (y * width + x) * 7: its position about `origin`
// (xyz), its grass cover and its albedo (rgb), from k_grass_heights'.
@kernel @grid(2)
fn k_grass_field(g: grid<2>, out: write_store<f32, 1>, heights: read_store<f32, 1>,
                 ax: f64, ay: f64, az: f64, ex: f64, ey: f64, ez: f64, fx: f64, fy: f64, fz: f64,
                 u0: f64, v0: f64, delta: f64, ox: f64, oy: f64, oz: f64, radius: f64, octaves: f64, seed: i32, net: read_store<f32, 1>) {
    let a = vec3<f64>(ax, ay, az);
    let e = vec3<f64>(ex, ey, ez);
    let f = vec3<f64>(fx, fy, fz);
    let x = g.x();
    let y = g.y();
    let hw = g.width() + 2;
    let at = (y + 1) * hw + x + 1;
    let dir = field_dir(a, e, f, u0, v0, delta, x, y);
    let h = heights[at] as f64;
    let p = dir * (radius + max(h, 0.0));
    // The gradient between the neighbours, a spacing either side.
    let pu = field_dir(a, e, f, u0, v0, delta, x + 1, y) * (radius + max(heights[at + 1] as f64, 0.0))
           - field_dir(a, e, f, u0, v0, delta, x - 1, y) * (radius + max(heights[at - 1] as f64, 0.0));
    let pv = field_dir(a, e, f, u0, v0, delta, x, y + 1) * (radius + max(heights[at + hw] as f64, 0.0))
           - field_dir(a, e, f, u0, v0, delta, x, y - 1) * (radius + max(heights[at - hw] as f64, 0.0));
    var n = normalize(cross(pu, pv));
    if (dot(n, dir) < 0.0) { n = -n; }
    let cosine = clamp(dot(n, dir) as f32, 1e-3, 1.0);
    let grad = sqrt(1.0 / (cosine * cosine) - 1.0);
    // The blades' colour is the sward's at this height, not the ground's,
    // which on a slope is part bare rock that no blade is.
    let albedo = surface(h as f32, 0.0).xyz * variation(dir, radius, octaves, seed);

    let i = (y * g.width() + x) * 7;
    let rel = p - vec3<f64>(ox, oy, oz);
    out[i] = rel.x as f32;
    out[i + 1] = rel.y as f32;
    out[i + 2] = rel.z as f32;
    // None in the rivers and lakes.
    out[i + 3] = grass_cover(h as f32, grad) * (1.0 - water_share(h as f32, water_at(dir, radius, 1.0, net, seed), 0.0));
    out[i + 4] = albedo.x;
    out[i + 5] = albedo.y;
    out[i + 6] = albedo.z;
}
