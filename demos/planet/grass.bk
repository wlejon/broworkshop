// The grass's ground (grass.js): a field of points about the eye, on the
// gnomonic plane of a cube face (the points a + e u + f v projected onto the
// sphere), each the ground's true surface there, how much of it grows grass,
// and its albedo; and on a coarser grid how much of the sun's disc it sees.
// The blades stand on the field, between its points. The field is anchored
// at its centre (anchor.bk, found on the CPU): field point (x, y) is the plane
// offset lost + e (du0 + x delta) + f (dv0 + y delta) from it.
from planet::ground import terrain, surface, grass_cover, variation, site_ground, with_streams, tree_cover, woodland, wooded,
    banked;
from planet::rivers import water_share;
from planet::climate import climate_at, landform_climate, landform_share, landform_wood;
from planet::anchor import Anchor, read_anchor, plane_offset;

// Field point (x, y)'s offset from the anchor's direction (-1 and the width
// are the border).
fn field_point(a: Anchor, ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32, du0: f32, dv0: f32, delta: f32,
               x: i32, y: i32) -> vec3<f32> {
    return plane_offset(a, a.lost + vec3<f32>(ex, ey, ez) * (du0 + (x as f32) * delta)
                                  + vec3<f32>(fx, fy, fz) * (dv0 + (y as f32) * delta));
}

// The terrain's height over the field and a point's border about it: grid
// point (x, y) is field point (x - 1, y - 1), into `heights` at
// y * width + x.
@kernel @grid(2)
fn k_grass_heights(g: grid<2>, heights: write_store<f32, 1>, anchor: read_store<vec4<i32>, 1>,
                   ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
                   du0: f32, dv0: f32, delta: f32, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) {
    let a = read_anchor(anchor, 0);
    let e = field_point(a, ex, ey, ez, fx, fy, fz, du0, dv0, delta, g.x() - 1, g.y() - 1);
    heights[g.y() * g.width() + g.x()] = terrain(a, e, radius, octaves, seed, net);
}

// Field point (x, y), eight floats at `out` (y * width + x) * 8: its
// position about `origin` (xyz), its grass cover, its albedo (rgb) and how
// lush it grows, from k_grass_heights'. `point` is the anchor's surface
// point (its direction times the radius) less the origin.
@kernel @grid(2)
fn k_grass_field(g: grid<2>, out: write_store<f32, 1>, heights: read_store<f32, 1>, anchor: read_store<vec4<i32>, 1>,
                 ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
                 du0: f32, dv0: f32, delta: f32, px: f32, py: f32, pz: f32, radius: f32, octaves: f32, seed: i32,
                 net: read_store<f32, 1>) {
    let a = read_anchor(anchor, 0);
    let x = g.x();
    let y = g.y();
    let hw = g.width() + 2;
    let at = (y + 1) * hw + x + 1;
    let e = field_point(a, ex, ey, ez, fx, fy, fz, du0, dv0, delta, x, y);
    let h = heights[at];
    // Grass grows where the soil holds: by its slope over tens of metres
    // (ground.bk soil_gradient), as the ground's colour lays its rock.
    let site = site_ground(a, e, radius, octaves, seed, net);
    let grad = site.grad;
    // The blades' colour is the sward's at this height, not the ground's,
    // which on a slope is part bare rock that no blade is; in the climate
    // its landform makes (climate.bk landform_climate).
    let region = climate_at(normalize(a.dir + e), 0.0, seed);
    let lf = landform_share(site.drain.dry);
    let cl = landform_climate(region, lf * site.drain.wet, lf * site.drain.ridge);
    let albedo = surface(h, 0.0, cl).xyz * variation(a, e, radius, octaves, seed);
    // Under the trees (their share as trees.bk stands them) the floor is
    // their litter and little grass grows (ground_mesh.bk LITTER).
    let wa = with_streams(site.water, site.drain.share, site.drain.gallery, region, h);
    let woods = wooded(banked(tree_cover(h, grad, cl), h, grad, cl, wa),
                       landform_wood(woodland(a, e, radius, 99.0, seed), lf * site.drain.wet, lf * site.drain.ridge));

    let i = (y * g.width() + x) * 8;
    let rel = vec3<f32>(px, py, pz) + e * radius + (a.dir + e) * max(h, 0.0);
    out[i] = rel.x;
    out[i + 1] = rel.y;
    out[i + 2] = rel.z;
    // None in the rivers and lakes, nor on the wet margin the ground's
    // shader draws as water wherever its texels' share passes about half,
    // its shore wandering by noise on either side (ground_mesh.bk): grown in
    // proportion to the land's share, blades stood in open water; cut from
    // 0.1 to 0.35, they stood where the shore's noise put the water.
    out[i + 3] = grass_cover(h, grad, cl) * (1.0 - WOODS_SHADE * woods)
               * (1.0 - smoothstep(0.0, 0.08, water_share(h, wa, 0.0)));
    out[i + 4] = albedo.x;
    out[i + 5] = albedo.y;
    out[i + 6] = albedo.z;
    // How lush the sward grows, 0 to 1: taller and greener down the
    // hollows and valleys, short and part straw along the crests, as the
    // landform moves the moisture (grass_mesh.bk).
    out[i + 7] = clamp(0.55 + LUSH_LANDFORM * (cl.moist - region.moist), 0.0, 1.0);
}
const WOODS_SHADE: f32 = 0.85;
const LUSH_LANDFORM: f32 = 2.5;
