// The cloud layer's column field (clouds.js): how much cloud each column of
// the layer holds, in a tile cache over the cube-sphere the shaders read
// (k_cloud_tile); each cell holds the column's amount there, filtered to
// the cell's footprint, and the variance of the octaves too fine for it.
// And what the clouds leave of the ground's light, in a second cache
// (k_cloud_ground).
from planet::ground import perlin_split, terrain_base, octaves_for;
import tiles;

const F0: f32 = -0.12;          // the mean amount: clear more than cloudy
pub const NOISE_VAR: f32 = 0.0728;  // perlin_split's variance (ground.bk PERLIN_VAR)

// The column at the unit direction q, resolved at a footprint of w metres:
// an octave counts in full from 4 footprints a wavelength, not at all at 2,
// and adds the variance of what it leaves out.
pub fn column(q: vec3<f64>, w: f64, radius: f64) -> vec2<f32> {
    var f: f32 = F0;
    var v: f32 = 0.0;
    // The weather: cloud systems from 2000 km down to fronts and cells of
    // 30 km, clear skies between them; each octave 0.6 of the last.
    var wavelength: f64 = 2000000.0;
    var amp: f32 = 0.48;
    for (var k: i32 = 0; k < 7; k += 1) {
        let r = clamp(wavelength / w * 0.5 - 1.0, 0.0, 1.0) as f32;
        if (r > 0.0) {
            f += r * amp * perlin_split(q * (radius / wavelength), 101 + k);
        }
        v += (1.0 - r * r) * amp * amp * NOISE_VAR;
        wavelength *= 0.5;
        amp *= 0.6;
    }
    // The cumuli: from 13 km to 25 m, each octave 0.62 of the last; past
    // the finest, the variance of yet finer ones.
    wavelength = 12800.0;
    amp = 0.32;
    for (var k: i32 = 0; k < 10; k += 1) {
        let r = clamp(wavelength / w * 0.5 - 1.0, 0.0, 1.0) as f32;
        if (r > 0.0) {
            f += r * amp * perlin_split(q * (radius / wavelength), 7 + k);
        }
        v += (1.0 - r * r) * amp * amp * NOISE_VAR;
        wavelength *= 0.5;
        amp *= 0.62;
    }
    v += amp * amp * NOISE_VAR / (1.0 - 0.3844);
    return vec2<f32>(f, v);
}

// The layer's shape (also read by the view's volume, clouds_volume.bk, and
// the ground's light, k_cloud_ground): its base over the lift, its depth, a
// cloud's extinction, and what a column must hold to reach the layer's
// height s (cloud_need); the finest footprint the column resolves, and the
// amount up to which the detail's variance grows in (CLOUD_COLUMN_MIN,
// CLOUD_DETAIL_FULL).
//
// A column is cloud from where the need falls to its amount to where it
// rises past it again: least at CLOUD_BASE_SHARE, the base of the thinnest
// cloud, rising toward the top and, steeper, toward the layer's floor
// CLOUD_DIP metres below. A cumulus's base is where its rising air condenses,
// and the stronger the column the moister its air and the lower it
// condenses: a column reaching a share x of the way to the top dips x of
// CLOUD_DIP below the thinnest's base, so bases differ cloud to cloud and
// across the layer at every scale the amount does, and the detail billows
// them (at one need for every column the base was a single plane, drawn as
// a hard line where it met the horizon and as stripes seen edge-on).
pub const CLOUD_DIP: f32 = 400.0;
pub const CLOUD_BASE: f32 = 1100.0;    // the floor: the thinnest cloud's base, 1500 m, less CLOUD_DIP
pub const CLOUD_DEPTH: f32 = 3000.0;
pub const CLOUD_BASE_SHARE: f32 = 0.13333333;   // CLOUD_DIP / CLOUD_DEPTH
pub const CLOUD_SIGMA: f32 = 0.03;
pub const CLOUD_FLOOR: f32 = 0.02;
pub const CLOUD_CURVE: f32 = 0.7;
pub const CLOUD_COLUMN_MIN: f64 = 60.0;
pub const CLOUD_DETAIL_FULL: f32 = 0.04;
const CLOUD_SHADOW_STEPS: i32 = 6;
const LIFT_OCTAVES: f64 = 3.0;   // the lift's (k_cloud_lift)
// Height share s as a share of the way from the thinnest base to the top
// (above it) or to the floor (below it).
fn need_x(s: f32) -> f32 {
    let above = step(CLOUD_BASE_SHARE, s);
    return mix((CLOUD_BASE_SHARE - s) / CLOUD_BASE_SHARE, (s - CLOUD_BASE_SHARE) / (1.0 - CLOUD_BASE_SHARE), above);
}
pub fn cloud_need(s: f32) -> f32 {
    let x = need_x(s);
    let x2 = min(x * x, 0.999);
    return CLOUD_FLOOR + CLOUD_CURVE * x2 / (1.0 - x2);
}
// Its rate per unit of s: negative below the thinnest base, where the need
// falls as the height rises.
pub fn cloud_need_slope(s: f32) -> f32 {
    let x = need_x(s);
    let d = max(1.0 - x * x, 0.001);
    let dx = mix(-1.0 / CLOUD_BASE_SHARE, 1.0 / (1.0 - CLOUD_BASE_SHARE), step(CLOUD_BASE_SHARE, s));
    return 2.0 * CLOUD_CURVE * x / (d * d) * dx;
}
// The height share a column's cloud reaches: where cloud_need(s) = f above
// the thinnest base.
pub fn cloud_top(f: f32) -> f32 {
    let x = max(f - CLOUD_FLOOR, 0.0) / CLOUD_CURVE;
    return CLOUD_BASE_SHARE + (1.0 - CLOUD_BASE_SHARE) * sqrt(x / (1.0 + x));
}
// The chance of cloud at height s in a column of amount f with unresolved
// variance v (cloudOccupancy's logistic).
pub fn cloud_occupancy(f: f32, v: f32, s: f32) -> f32 {
    return 1.0 / (1.0 + exp(-1.7 * (f - cloud_need(s)) / sqrt(v + 1.0e-5)));
}
// The optical depth a step of length len adds to sub-column `rank` (3 the
// cloudiest, filled first) at occupancy occ.
fn cloud_sub(occ: f32, rank: f32, len: f32) -> f32 {
    return CLOUD_SIGMA * len * clamp(occ * 4.0 - rank, 0.0, 1.0);
}

// What the clouds leave of the light at the point at unit direction `dir`,
// h metres up, over a footprint of w metres: the view's march (clouds.js
// userVolume's sub-columns) taken up the light's ray through the layer in
// CLOUD_SHADOW_STEPS steps of its height. The column there, resolved to
// the footprint, is cloud as its occupancy says, filled into four
// sub-columns ranked by their amount (the cloudiest first; a column cloudy
// up to its top), each crossed at full density. x: the sun straight
// through, exp(-tau); y: what the cloud scatters forward and down besides,
// from a slab of each one's depth, two-stream diffusion's
// 1 / (1 + 0.75 (1 - g) tau), g = 0.85 (the march's light deep in a
// cloud), less the light straight through: it comes from all over the
// cloud's base, so it casts no shadow (the engine's sunDiffuse), and under
// a deck the ground is lit grey and shadowless, not by a dimmed sun
// drawing sharp shadows; z: the sky's light through them, straight up,
// every step in the column over the point. detail_var: the variance of the
// clouds' three-dimensional detail at full amount (clouds.js
// CLOUD_DETAIL_VAR). The ground reads it from a tile cache (k_cloud_ground),
// the grass and the trees from their sun grids (sun.bk).
pub fn cloud_light(dir: vec3<f64>, h: f32, to_sun: vec3<f64>, w: f64, radius: f64, seed: i32,
                   detail_var: f32) -> vec3<f32> {
    let fw = max(w, CLOUD_COLUMN_MIN);
    let base = CLOUD_BASE + max(terrain_base(dir, radius, LIFT_OCTAVES, seed), 0.0) as f32;
    let s0 = clamp((h - base) / CLOUD_DEPTH, 0.0, 1.0);
    let ds = (1.0 - s0) / (CLOUD_SHADOW_STEPS as f32);
    let g = dir * (radius + (h as f64));
    // The sky's: straight up, every step in the column over the point.
    let up = column(dir, fw, radius);
    let gu = clamp(up.x / CLOUD_DETAIL_FULL, 0.0, 1.0);
    let vu = up.y + detail_var * gu * gu;
    var k0: f32 = 0.0;
    var k1: f32 = 0.0;
    var k2: f32 = 0.0;
    var k3: f32 = 0.0;
    for (var i: i32 = 0; i < CLOUD_SHADOW_STEPS; i += 1) {
        let occ = cloud_occupancy(up.x, vu, s0 + ((i as f32) + 0.5) * ds);
        let len = ds * CLOUD_DEPTH;
        k0 += cloud_sub(occ, 3.0, len);
        k1 += cloud_sub(occ, 2.0, len);
        k2 += cloud_sub(occ, 1.0, len);
        k3 += cloud_sub(occ, 0.0, len);
    }
    let sky = 0.25 * (1.0 / (1.0 + 0.1125 * k0) + 1.0 / (1.0 + 0.1125 * k1)
                    + 1.0 / (1.0 + 0.1125 * k2) + 1.0 / (1.0 + 0.1125 * k3));
    let mu = dot(to_sun, dir) as f32;
    if (mu <= 0.02) {
        return vec3<f32>(1.0, 0.0, sky);
    }
    // The sun's: up its ray through the layer.
    var t0: f32 = 0.0;
    var t1: f32 = 0.0;
    var t2: f32 = 0.0;
    var t3: f32 = 0.0;
    let len = ds * CLOUD_DEPTH / mu;
    for (var i: i32 = 0; i < CLOUD_SHADOW_STEPS; i += 1) {
        let s = s0 + ((i as f32) + 0.5) * ds;
        let q = normalize(g + to_sun * (((base + s * CLOUD_DEPTH - h) / mu) as f64));
        let c = column(q, fw, radius);
        let gq = clamp(c.x / CLOUD_DETAIL_FULL, 0.0, 1.0);
        let occ = cloud_occupancy(c.x, c.y + detail_var * gq * gq, s);
        t0 += cloud_sub(occ, 3.0, len);
        t1 += cloud_sub(occ, 2.0, len);
        t2 += cloud_sub(occ, 1.0, len);
        t3 += cloud_sub(occ, 0.0, len);
    }
    let direct = 0.25 * (exp(-t0) + exp(-t1) + exp(-t2) + exp(-t3));
    let total = 0.25 * (1.0 / (1.0 + 0.1125 * t0) + 1.0 / (1.0 + 0.1125 * t1)
                      + 1.0 / (1.0 + 0.1125 * t2) + 1.0 / (1.0 + 0.1125 * t3));
    return vec3<f32>(direct, total - direct, sky);
}

// The layer's lift: the broad ground under it, over which its base stands
// (clouds.js). A cumulus's base is where the air rising off the ground
// cools to condensing, some way over the ground it rose from, so over a
// plateau the layer stands as high over it as over the sea; at LIFT_OCTAVES
// the ground's plateaus and basins of hundreds of kilometres, not its
// ranges, which rise into the clouds. Texel (x, y) of a face's grid of n a
// row at plane point (o + x delta, o + y delta), into `out` at base.
@kernel @grid(2)
fn k_cloud_lift(g: grid<2>, out: write_store<f32, 1>, base: i32, n: i32,
                ax: f64, ay: f64, az: f64, ex: f64, ey: f64, ez: f64, fx: f64, fy: f64, fz: f64,
                o: f64, delta: f64, radius: f64, seed: i32) {
    let u = o + (g.x() as f64) * delta;
    let v = o + (g.y() as f64) * delta;
    let p = vec3<f64>(ax, ay, az) + vec3<f64>(ex, ey, ez) * u + vec3<f64>(fx, fy, fz) * v;
    out[base + g.y() * n + g.x()] = max(terrain_base(normalize(p), radius, LIFT_OCTAVES, seed), 0.0) as f32;
}

// Cell (x, y) of the tile at record r of a batch table (bro.tiles), its
// border's cells included: the unit direction of its centre, and the
// footprint of two cells there, at the face plane's stretch (the larger of
// how far the sphere moves for a step along either of the plane's axes).
struct TileCell {
    dir: vec3<f64>,
    w: f64,
}
fn tile_cell<B>(table: B, r: i32, x: i32, y: i32, tile: f64, border: f64, radius: f64) -> TileCell {
    let root = table[r + 2] as i32;
    let s = ((x as f64) - border + 0.5) / tile;
    let t = ((y as f64) - border + 0.5) / tile;
    let du = vec3<f64>(table[r + 11], table[r + 12], table[r + 13]);
    let dv = vec3<f64>(table[r + 14], table[r + 15], table[r + 16]);
    let b = vec3<f64>(table[r + 8], table[r + 9], table[r + 10]) + du * s + dv * t;
    // The face plane's coordinates: the two axes other than the root's
    // (its own is +-1 on the plane).
    var u: f64 = b.y;
    var v: f64 = b.z;
    if (root == 2 || root == 3) {
        u = b.x;
    } else if (root == 4 || root == 5) {
        u = b.x;
        v = b.y;
    }
    let stretch = sqrt(1.0 + max(u * u, v * v)) / (1.0 + u * u + v * v);
    return TileCell { dir: normalize(b), w: 2.0 * radius * (length(du) / tile) * stretch };
}

// A column (amount, variance) in one word: the amount over [-2.5, 2.5]
// (the octaves' amplitudes sum to under 2.2 about F0) and the variance over
// [0, 0.05] (all of it is 0.038), 16 bits each, steps of 8e-5 and 8e-7.
pub const COLUMN_F_RANGE: f32 = 2.5;
pub const COLUMN_V_RANGE: f32 = 0.05;
fn pack_column(c: vec2<f32>) -> i32 {
    let f = (clamp(c.x / COLUMN_F_RANGE * 0.5 + 0.5, 0.0, 1.0) * 65535.0 + 0.5) as i32;
    let v = (clamp(c.y / COLUMN_V_RANGE, 0.0, 1.0) * 65535.0 + 0.5) as i32;
    return f | (v << 16);
}

// A batch of the column field's tiles (clouds.js createClouds' cache, read
// by the view's volume through tiles.bk): each cell's column at its
// footprint (tile_cell), a word a cell (pack_column) into the pool at the
// tile's slot.
@kernel @grid(3)
fn k_cloud_tile(g: grid<3>, table: read_store<f64, 1>, pool: write_store<i32, 1>, cells: i32,
                tile: f64, border: f64, radius: f64) {
    let r = g.z() * 24;
    let slot = table[r] as i32;
    let cell = tile_cell(table, r, g.x(), g.y(), tile, border, radius);
    pool[(slot * cells + g.y()) * cells + g.x()] = pack_column(column(cell.dir, cell.w, radius));
}

// The sun field: for each of a tile's cells, the optical depth of cloud
// toward the sun from four heights of the layer, from SUN_LOWEST (just over
// the thinnest cloud's base: one under every base found its way out beneath
// the deck, and lit the clouds' insides) SUN_SPACING apart, so a cloud's side toward a low sun is lit where its
// sun's ray leaves the cloud, its far side dark, and a cloud in the shade of
// another dark. A view's march and its near grid read it alike (Schneider's
// light field for Nubis; Hillaire's shadow steps), and only with the layer's
// own column above a point does it say less (clouds_volume.bk sun_depth).
// The ray is sampled at SUN_STEPS lengths growing geometrically from
// SUN_FIRST metres (the first 160 m are the readers' own billow taps) to
// where it leaves the layer's top, each reading the column field at a
// footprint of SUN_W_SHARE of its length from the cache itself (the coarse
// tiles always resident; this tile's own cells from its slot, written by
// k_cloud_tile before), as cover. The footprint is the step's, never the
// tile's own cells': read at a coarse tile's, a coarse tile's depths came
// out lower than its children's at the same points, a step at the edge of
// where the finer tiles end. A step whose occupancy is occ, SUN_SEGMENT
// metres of it at a time (about a cumulus across), passes 1 - occ of the
// light whole and the rest through its cloud, the segments at random
// overlap (as the march's pieces), so a long way through a layer of
// scattered cloud finds its gaps and a deck's does not. (At the
// occupancy's mean density, every low sun's ray was dark: 28 km of a
// third's cover is a depth of 250. Taken a step at a time instead, the
// gaps of a kilometres-long step lined up whole: the deck's faces toward a
// dusk sun were lit where the light-marched sun, clouds.sunReference, finds
// them dark.)
pub const SUN_LOWEST: f32 = 0.15;
pub const SUN_SPACING: f32 = 0.25;
const SUN_STEPS: i32 = 12;
const SUN_FIRST: f32 = 60.0;
const SUN_SEGMENT: f32 = 500.0;
const SUN_W_SHARE: f32 = 0.25;
pub const SUN_TAU_MAX: f32 = 48.0;   // the depth a unorm16 channel spans
const CELL_COLUMN_RANGE: f32 = 2.0 * COLUMN_F_RANGE / 65535.0;
const CELL_VAR_RANGE: f32 = COLUMN_V_RANGE / 65535.0;

fn unpack_column(w: i32) -> vec2<f32> {
    return vec2<f32>(((w & 65535) as f32) * CELL_COLUMN_RANGE - COLUMN_F_RANGE,
                     (((w >> 16) & 65535) as f32) * CELL_VAR_RANGE);
}
// Tile t's column at p, bilinear over its cells (tiles.bk cells).
fn pool_column<P>(pool: P, t: tiles::Tile, p: tiles::Point, tile: i32, border: i32) -> vec2<f32> {
    let c = tiles::cells(t, p, tile, border);
    let a = mix(unpack_column(pool[c.i00]), unpack_column(pool[c.i10]), c.f.x);
    let b = mix(unpack_column(pool[c.i01]), unpack_column(pool[c.i11]), c.f.x);
    return mix(a, b, c.f.y);
}

@kernel @grid(3)
fn k_cloud_sun(g: grid<3>, table: read_store<f64, 1>, lookup: read_store<vec4<i32>, 1>, pool: read_store<i32, 1>,
               out: write_store<i32, 1>, cells: i32, tile: i32, border: i32, levels: i32, w0: f32,
               radius: f64, seed: i32, sx: f32, sy: f32, sz: f32, detail_var: f32) {
    let r = g.z() * 24;
    let slot = table[r] as i32;
    let root = table[r + 2] as i32;
    let own = tiles::Tile { slot: slot, level: table[r + 3] as i32, x: table[r + 4] as i32, y: table[r + 5] as i32,
                            parent: -1 };
    let s = ((g.x() - border) as f64 + 0.5) / (tile as f64);
    let t = ((g.y() - border) as f64 + 0.5) / (tile as f64);
    let du = vec3<f64>(table[r + 11], table[r + 12], table[r + 13]);
    let dv = vec3<f64>(table[r + 14], table[r + 15], table[r + 16]);
    let q = normalize(vec3<f64>(table[r + 8], table[r + 9], table[r + 10]) + du * s + dv * t);
    let base = CLOUD_BASE + max(terrain_base(q, radius, LIFT_OCTAVES, seed), 0.0) as f32;
    let up = vec3<f32>(q.x as f32, q.y as f32, q.z as f32);
    let to_sun = vec3<f32>(sx, sy, sz);
    let mu = dot(to_sun, up);
    let rf = radius as f32;
    var taus: vec4<f32> = vec4<f32>(SUN_TAU_MAX);
    if (mu > -0.2) {
        // The four heights' rays, stepped alike from the lowest's: each
        // step's four points lie over one point of the layer (their
        // directions differ by their heights' spacing over the planet's
        // radius, 1e-4 of the step), so one column read serves all four,
        // each taking its own height's occupancy; a ray out of the layer's
        // top takes nothing more.
        let h0 = base + SUN_LOWEST * CLOUD_DEPTH;
        let reach = min((1.0 - SUN_LOWEST) * CLOUD_DEPTH / max(mu, 0.02), 120000.0);
        var tau4: vec4<f32> = vec4<f32>(0.0);
        var e0: f32 = 0.0;
        var e1: f32 = SUN_FIRST;
        let grow = pow(max(reach / SUN_FIRST, 1.0), 1.0 / ((SUN_STEPS - 1) as f32));
        let spread = vec4<f32>(0.0, 1.0, 2.0, 3.0) * SUN_SPACING;
        for (var i: i32 = 0; i < SUN_STEPS; i += 1) {
            let len = e1 - e0;
            let m = 0.5 * (e0 + e1);
            e0 = e1;
            e1 *= grow;
            // The lowest ray's point and direction: from (rf + h0) up along
            // to_sun, relative to the planet's centre in f32 about the
            // point's radius (the steps are short against it).
            let x = up * (rf + h0) + to_sun * m;
            let rx = length(x);
            let qx = x / rx;
            let si = (rx - rf - base) / CLOUD_DEPTH;
            if (si > 1.0 || min(min(tau4.x, tau4.y), min(tau4.z, tau4.w)) > SUN_TAU_MAX) {
                break;
            }
            let s4 = vec4<f32>(si) + spread;
            if (s4.w >= 0.0) {
                let p = tiles::cube_point(qx);
                let uv = vec2<f32>(p.u, p.v) * 2.0 - 1.0;
                let stretch = sqrt(1.0 + max(uv.x * uv.x, uv.y * uv.y)) / (1.0 + dot(uv, uv));
                let w = max(CLOUD_COLUMN_MIN as f32, SUN_W_SHARE * len);
                let lk = min(tiles::level_for(w, w0 * stretch, levels) as i32, levels);
                let at = tiles::tile_at(p, own.level);
                var c: vec2<f32> = vec2<f32>(-COLUMN_F_RANGE, 0.0);
                if (p.root == root && lk >= own.level && at.x == own.x && at.y == own.y) {
                    c = pool_column(pool, own, p, tile, border);
                } else {
                    let found = tiles::locate(lookup, p, lk);
                    if (found.slot >= 0) {
                        c = pool_column(pool, found, p, tile, border);
                    }
                }
                let gq = clamp(c.x / CLOUD_DETAIL_FULL, 0.0, 1.0);
                let cv = c.y + detail_var * gq * gq;
                let occ = vec4<f32>(cloud_occupancy(c.x, cv, s4.x), cloud_occupancy(c.x, cv, s4.y),
                                    cloud_occupancy(c.x, cv, s4.z), cloud_occupancy(c.x, cv, s4.w));
                // Only the heights within the layer's [0, 1].
                let inside = step(vec4<f32>(0.0), s4) * step(s4, vec4<f32>(1.0));
                let segs = max(len / SUN_SEGMENT, 1.0);
                let pass = 1.0 - occ * inside * (1.0 - exp(-CLOUD_SIGMA * len / segs));
                tau4 -= segs * log(max(pass, vec4<f32>(1.0e-12)));
            }
        }
        taus = tau4;
    }
    let n = clamp(taus / SUN_TAU_MAX, vec4<f32>(0.0), vec4<f32>(1.0)) * 65535.0 + 0.5;
    let i = ((slot * cells + g.y()) * cells + g.x()) * 2;
    out[i] = (n.x as i32) | ((n.y as i32) << 16);
    out[i + 1] = (n.z as i32) | ((n.w as i32) << 16);
}

// 0 to 1 in 8 bits, rounded.
fn unorm8(x: f32) -> i32 {
    return (clamp(x, 0.0, 1.0) * 255.0 + 0.5) as i32;
}

// A batch of the ground light's tiles (clouds.js createClouds' groundLight
// cache, read by the ground through tiles.bk): what the clouds leave of the
// ground's light (cloud_light) at each cell, at its footprint (tile_cell)
// and the broad ground's height there (the octaves the footprint carries),
// the sun toward (sx, sy, sz); into the pool at the tile's slot as one word
// a cell, the sun straight through, scattered down and the sky's, 8 bits
// each from the lowest (a unorm8 texture's x, y, z).
pub fn ground_light(dir: vec3<f64>, w: f64, to_sun: vec3<f64>, radius: f64, seed: i32, detail_var: f32) -> vec3<f32> {
    let h = max(terrain_base(dir, radius, octaves_for(w, 1.0), seed), 0.0) as f32;
    return cloud_light(dir, h, to_sun, w, radius, seed, detail_var);
}
@kernel @grid(3)
fn k_cloud_ground(g: grid<3>, table: read_store<f64, 1>, pool: write_store<i32, 1>, cells: i32,
                  tile: f64, border: f64, radius: f64, seed: i32, sx: f64, sy: f64, sz: f64, detail_var: f32) {
    let r = g.z() * 24;
    let slot = table[r] as i32;
    let cell = tile_cell(table, r, g.x(), g.y(), tile, border, radius);
    let c = ground_light(cell.dir, cell.w, normalize(vec3<f64>(sx, sy, sz)), radius, seed, detail_var);
    pool[(slot * cells + g.y()) * cells + g.x()] = unorm8(c.x) | (unorm8(c.y) << 8) | (unorm8(c.z) << 16);
}
