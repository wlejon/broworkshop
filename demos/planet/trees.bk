// The trees' ground (trees.js): one point per tree site, on a lattice of the
// gnomonic plane of a cube face (the points a + e u + f v projected onto the
// sphere) about a power of two of the plane's units apart, each site at a
// spot hashed inside its lattice cell, so a tree stands where it grew
// whichever field holds it. Each holds the ground's true surface at that
// spot, whether a tree stands there (the forest's cover, ground.bk
// tree_cover, against the site's hash) and how large, and the ground's
// colour variation there, which the crown takes. The field is anchored at
// its centre (anchor.bk, found on the CPU): cell (x, y)'s corner is the plane
// offset lost + e (du0 + x delta) + f (dv0 + y delta) from it.
import std::noise::*;
from planet::ground import terrain, tree_cover, variation, soil_gradient, woodland, wooded, banked;
from planet::rivers import water_at, water_share;
from planet::climate import climate_at;
from planet::anchor import read_anchor, plane_offset;

// Site (x, y0 + y) of the field, lattice site (li + x, lj + y0 + y) on face
// `face`, seven floats at `out` (row * width + x) * 7: its position about
// `origin` (xyz), its size (0: no tree) and the colour variation (rgb).
// `point` is the anchor's surface point (its direction times the radius)
// less the origin.
@kernel @grid(2)
fn k_tree_field(g: grid<2>, out: write_store<f32, 1>, anchor: read_store<vec4<i32>, 1>,
                ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
                du0: f32, dv0: f32, delta: f32, px: f32, py: f32, pz: f32, radius: f32, octaves: f32, seed: i32,
                li: i32, lj: i32, face: i32, y0: i32, net: read_store<f32, 1>) {
    let a = read_anchor(anchor, 0);
    let row = y0 + g.y();
    let hx = hash_primes3d(seed + 977, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    let hy = hash_primes3d(seed + 1979, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    let hp = hash_primes3d(seed + 2971, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    // Inside the middle 70% of the cell, so neighbours do not touch.
    let jx = 0.15 + 0.7 * (((hx >> 8) & 65535) as f32) / 65536.0;
    let jy = 0.15 + 0.7 * (((hy >> 8) & 65535) as f32) / 65536.0;
    let pick = (((hp >> 8) & 65535) as f32) / 65536.0;
    let du = du0 + ((g.x() as f32) + jx) * delta;
    let dv = dv0 + ((row as f32) + jy) * delta;
    let e = plane_offset(a, a.lost + vec3<f32>(ex, ey, ez) * du + vec3<f32>(fx, fy, fz) * dv);
    let h = terrain(a, e, radius, octaves, seed, net);
    // The cover's rock: the soil's slope (ground.bk soil_gradient), as the
    // ground's colour lays it.
    let grad = soil_gradient(a, e, radius, seed, net);
    // Forests grow as a mosaic, forests to glades (ground.bk woodland), the
    // same the ground's colour takes over its texels, and in gallery woods
    // along the rivers' banks (ground.bk banked); none in the rivers and
    // lakes. A tree stands where the site's pick is under it; at a thinning
    // edge the ones left are smaller.
    let cl = climate_at(normalize(a.dir + e), 0.0, seed);
    let wa = water_at(a.dir, e, radius, 6.0, net, seed);
    let local = wooded(banked(tree_cover(h, grad, cl), h, grad, cl, wa), woodland(a, e, radius, 99.0, seed))
              * (1.0 - water_share(h, wa, 0.0));
    var size: f32 = 0.0;
    if (pick < local) { size = 0.6 + 0.4 * local; }
    let vary = variation(a, e, radius, octaves, seed);

    let i = (row * g.width() + g.x()) * 7;
    let rel = vec3<f32>(px, py, pz) + e * radius + (a.dir + e) * max(h, 0.0);
    out[i] = rel.x;
    out[i + 1] = rel.y;
    out[i + 2] = rel.z;
    out[i + 3] = size;
    out[i + 4] = vary.x;
    out[i + 5] = vary.y;
    out[i + 6] = vary.z;
}
