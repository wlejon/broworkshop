// The trees' ground (trees.js): one point per tree site, on a lattice of the
// gnomonic plane of a cube face (the points a + e u + f v projected onto the
// sphere) about a power of two of the plane's units apart, each site at a
// spot hashed inside its lattice cell, so a tree stands where it grew
// whichever field holds it. Each holds the ground's true surface at that
// spot, whether a tree stands there (the forest's cover, ground.bk
// tree_cover, against the site's hash) and how large, and the ground's
// colour variation there, which the crown takes.
import std::noise::*;
from planet::ground import terrain, tree_cover, variation, perlin_split;
from planet::rivers import water_near, water_share;

// Site (x, y0 + y) of the field, lattice site (li + x, lj + y0 + y) on face
// `face`, cell (u0 + x delta, v0 + (y0 + y) delta), seven floats at `out`
// (row * width + x) * 7: its position about `origin` (xyz), its size (0: no
// tree) and the colour variation (rgb).
@kernel @grid(2)
fn k_tree_field(g: grid<2>, out: write_store<f32, 1>,
                ax: f64, ay: f64, az: f64, ex: f64, ey: f64, ez: f64, fx: f64, fy: f64, fz: f64,
                u0: f64, v0: f64, delta: f64, ox: f64, oy: f64, oz: f64, radius: f64, octaves: f64, seed: i32,
                li: i32, lj: i32, face: i32, y0: i32, net: read_store<f32, 1>) {
    let a = vec3<f64>(ax, ay, az);
    let e = vec3<f64>(ex, ey, ez);
    let f = vec3<f64>(fx, fy, fz);
    let row = y0 + g.y();
    let hx = hash_primes3d(seed + 977, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    let hy = hash_primes3d(seed + 1979, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    let hp = hash_primes3d(seed + 2971, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    // Inside the middle 70% of the cell, so neighbours do not touch.
    let jx = 0.15 + 0.7 * (((hx >> 8) & 65535) as f64) / 65536.0;
    let jy = 0.15 + 0.7 * (((hy >> 8) & 65535) as f64) / 65536.0;
    let pick = (((hp >> 8) & 65535) as f32) / 65536.0;
    let u = u0 + ((g.x() as f64) + jx) * delta;
    let v = v0 + ((row as f64) + jy) * delta;
    let dir = normalize(a + e * u + f * v);
    let h = terrain(dir, radius, octaves, seed, net);
    let p = dir * (radius + max(h, 0.0));
    // The slope across a metre or so: the cover's rock.
    let du = normalize(a + e * (u + 0.15 * delta) + f * v);
    let dv = normalize(a + e * u + f * (v + 0.15 * delta));
    let pu = du * (radius + max(terrain(du, radius, octaves, seed, net), 0.0)) - p;
    let pv = dv * (radius + max(terrain(dv, radius, octaves, seed, net), 0.0)) - p;
    var n = normalize(cross(pu, pv));
    if (dot(n, dir) < 0.0) { n = -n; }
    let cosine = clamp(dot(n, dir) as f32, 1e-3, 1.0);
    let grad = sqrt(1.0 / (cosine * cosine) - 1.0);
    // None in the rivers and lakes, nor right on their banks.
    let cover = tree_cover(h as f32, grad) * (1.0 - water_share(h as f32, water_near(dir, radius, 6.0, net, seed)));
    // Forests grow in stands and glades: the cover scaled by zero-mean
    // noise across ~70 m and ~20 m, so the forest's average stays the
    // cover the ground's colour takes. A tree stands where the site's pick
    // is under it; at a thinning edge the ones left are smaller.
    let stands = perlin_split(dir * (radius / 70.0), seed + 4111) * 2.2
               + perlin_split(dir * (radius / 20.0), seed + 4127) * 1.1;
    let local = clamp(cover * (1.0 + stands), 0.0, 1.0);
    var size: f32 = 0.0;
    if (pick < local) { size = 0.6 + 0.4 * local; }
    let vary = variation(dir, radius, octaves, seed);

    let i = (row * g.width() + g.x()) * 7;
    let rel = p - vec3<f64>(ox, oy, oz);
    out[i] = rel.x as f32;
    out[i + 1] = rel.y as f32;
    out[i + 2] = rel.z as f32;
    out[i + 3] = size;
    out[i + 4] = vary.x;
    out[i + 5] = vary.y;
    out[i + 6] = vary.z;
}
