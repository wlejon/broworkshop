// The planet's rivers and lakes: a drainage network over the whole sphere,
// which the ground's height carves (ground.bk terrain) and whose water the
// ground's colour and cover take.
//
// The network is a lattice of points, one in each cell of an equal-angle
// grid on each cube face (RIV_N x RIV_N cells, about 20 km apart at Earth's
// radius), each at a spot hashed inside its cell. riverbuild.bk gives every
// point the ground's broad height there; the level water stands at there,
// the hollows filled up to where they spill (Planchon and Darboux 2001),
// with a slight fall across each lake toward its outlet; its downstream
// neighbour (the one of its 8 that level falls to most steeply, so every
// chain reaches the sea); and its catchment, the points that drain through
// it: a record of RIV_REC floats each, which this module reads. A river
// runs from each point to its downstream one, as wide as its catchment
// says, its bed falling from the one point's level to the other's; where
// the level stands over the ground a lake lies, out to where the ground
// rises through its level.
module planet::rivers;

import std::noise::*;

pub const RIV_N: i32 = 512;
pub const RIV_REC: i32 = 11;   // height (m), downstream point (-1 none), catchment (points), water level (m), direction (3), floor (m; riverbuild.bk k_river_floor), tangent (3; k_river_tangent, 0 for a lone point)
// The octaves the lattice resolves, which its points' heights are the
// ground at: about 20 km between points, a wavelength of 2.5 of them
// (ground.bk octaves_for).
pub const RIV_OCTAVES: f32 = 5.6;
// A point drains a river once at least this many points drain through it.
const MIN_CATCHMENT: f32 = 2.0;
const PI4: f32 = 0.78539816;

// Face `face`'s frame: a its axis (outward), e and f its plane's axes
// (clouds.js faceFrame, the same).
pub fn face_a(face: i32) -> vec3<f32> {
    let s: f32 = face < 3 ? 1.0 : -1.0;
    let axis = face % 3;
    if (axis == 0) { return vec3<f32>(s, 0.0, 0.0); }
    if (axis == 1) { return vec3<f32>(0.0, s, 0.0); }
    return vec3<f32>(0.0, 0.0, s);
}
pub fn face_e(face: i32) -> vec3<f32> {
    let axis = face % 3;
    if (axis == 0) { return vec3<f32>(0.0, 1.0, 0.0); }
    if (axis == 1) { return vec3<f32>(0.0, 0.0, 1.0); }
    return vec3<f32>(1.0, 0.0, 0.0);
}
pub fn face_f(face: i32) -> vec3<f32> {
    let axis = face % 3;
    if (axis == 0) { return vec3<f32>(0.0, 0.0, 1.0); }
    if (axis == 1) { return vec3<f32>(1.0, 0.0, 0.0); }
    return vec3<f32>(0.0, 1.0, 0.0);
}

// The face whose side of the cube `d` points through.
pub fn face_of(d: vec3<f32>) -> i32 {
    let ax = abs(d.x);
    let ay = abs(d.y);
    let az = abs(d.z);
    if (ax >= ay && ax >= az) { return d.x > 0.0 ? 0 : 3; }
    if (ay >= az) { return d.y > 0.0 ? 1 : 4; }
    return d.z > 0.0 ? 2 : 5;
}

// The direction at equal-angle coordinates (x, y) of a face (-1 to 1 across
// it; beyond, the plane carries on past its edge).
pub fn alpha_dir(face: i32, x: f32, y: f32) -> vec3<f32> {
    let u = tan(x * PI4);
    let v = tan(y * PI4);
    return normalize(face_a(face) + face_e(face) * u + face_f(face) * v);
}

// The cell (face, i, j) that `d` lies in.
pub fn cell_of(d: vec3<f32>) -> vec3<i32> {
    let face = face_of(d);
    let z = dot(d, face_a(face));
    let x = atan(dot(d, face_e(face)) / z) / PI4;
    let y = atan(dot(d, face_f(face)) / z) / PI4;
    let n = RIV_N as f32;
    let i = clamp(floor((x + 1.0) * 0.5 * n) as i32, 0, RIV_N - 1);
    let j = clamp(floor((y + 1.0) * 0.5 * n) as i32, 0, RIV_N - 1);
    return vec3<i32>(face, i, j);
}

pub fn point_index(c: vec3<i32>) -> i32 {
    return (c.x * RIV_N + c.z) * RIV_N + c.y;
}
pub fn point_cell(k: i32) -> vec3<i32> {
    return vec3<i32>(k / (RIV_N * RIV_N), k % RIV_N, (k / RIV_N) % RIV_N);
}

// The point of cell c: at a spot hashed inside the middle 70% of it.
pub fn point_dir(c: vec3<i32>, seed: i32) -> vec3<f32> {
    let hx = hash_primes3d(seed + 5003, c.y * PRIME_X, c.z * PRIME_Y, c.x * PRIME_Z);
    let hy = hash_primes3d(seed + 6007, c.y * PRIME_X, c.z * PRIME_Y, c.x * PRIME_Z);
    let jx = 0.15 + 0.7 * (((hx >> 8) & 65535) as f32) / 65536.0;
    let jy = 0.15 + 0.7 * (((hy >> 8) & 65535) as f32) / 65536.0;
    let step = 2.0 / (RIV_N as f32);
    return alpha_dir(c.x, -1.0 + ((c.y as f32) + jx) * step, -1.0 + ((c.z as f32) + jy) * step);
}

// The cell (di, dj) from c, across the face's edge if need be.
pub fn cell_next(c: vec3<i32>, di: i32, dj: i32) -> vec3<i32> {
    let i = c.y + di;
    let j = c.z + dj;
    if (i >= 0 && i < RIV_N && j >= 0 && j < RIV_N) { return vec3<i32>(c.x, i, j); }
    let step = 2.0 / (RIV_N as f32);
    return cell_of(alpha_dir(c.x, -1.0 + ((i as f32) + 0.5) * step, -1.0 + ((j as f32) + 0.5) * step));
}

// A river `catchment` points large: its width (m). A point drains about
// 400 km^2, so the smallest rivers are streams a few metres across and the
// greatest (16000 points, an Amazon's basin) kilometres wide, seen from
// orbit: the width grows faster than the root of the catchment, as a
// river gathering a continent is broad and shallow.
pub fn river_width(catchment: f32) -> f32 {
    return 3.0 * pow(catchment, 0.75);
}

// The floodplain a river lays down about its channel: flat ground at its
// bed, a few times its width across, on which it wanders and floods (half
// its width from the channel's middle, m). A stream has none; a great
// river's is tens of kilometres, the green ribbon a desert river draws
// from orbit. Held under PLAIN_MAX, as the reaches whose valleys can reach
// here are searched out to half a lattice cell.
const PLAIN_MAX: f32 = 6000.0;
pub fn plain_half(catchment: f32) -> f32 {
    let half = 0.5 * river_width(catchment);
    return min(half * (1.0 + 7.0 * smoothstep(20.0, 3000.0, catchment)), PLAIN_MAX);
}

// How steeply a river's valley sides rise for its size: a stream cuts a
// narrow notch, a great river a broad valley, so the small rivers' valleys
// stay under what orbit can see while the trunks' fill the view.
fn valley_steepness(catchment: f32) -> f32 {
    return mix(3.0, 1.0, smoothstep(5.0, 800.0, catchment));
}
// A river's water stands over its bed as a lake from this deep (m).
const LAKE_DEPTH: f32 = 1.0;

// A river's meanders: its channel's offset across its reach (m), `s` metres
// along a reach `len` long from point `p`, for a channel `width` wide. Gradient
// noise in octaves from half the reach down to MEANDER_WAVES widths (a
// meander's wavelength is about 11 of its channel's widths, Leopold and
// Wolman 1960), each MEANDER_AMP of its wavelength, each tapered to nothing
// within half its wavelength of the reach's ends so reaches meet at their
// points and the short meanders run up to them; the valley follows the
// channel. Slopes stay under one, so the distance across the reach to the
// offset stays the distance to the channel.
const MEANDER_WAVES: f32 = 11.0;
const MEANDER_AMP: f32 = 0.18;
fn meander_gradient(seed: i32, p: i32, i: i32, octave: i32) -> f32 {
    let h = hash_primes3d(seed + 7919, p * PRIME_X, i * PRIME_Y, octave * PRIME_Z);
    return (((h >> 8) & 65535) as f32) / 32767.5 - 1.0;
}
pub fn meander(p: i32, s: f32, len: f32, width: f32, seed: i32) -> f32 {
    return meander_from(p, s, len, width, seed, 0.0);
}
// The meanders as ground `far` metres from the channel follows them (the
// drainage's valleys, dendry.bk): an octave counts in full where its
// wavelength is at least `far`, none under half of it, so a valley's sides
// carry its channel's broad bends and not its fine ones.
pub fn meander_from(p: i32, s: f32, len: f32, width: f32, seed: i32, far: f32) -> f32 {
    let shortest = max(MEANDER_WAVES * width, 0.5 * far);
    var wavelength = 0.5 * len;
    var m: f32 = 0.0;
    for (var o: i32 = 0; o < 6; o += 1) {
        if (wavelength < shortest) { break; }
        let x = s / wavelength;
        let c = floor(x);
        let f = x - c;
        let i = c as i32;
        let v = mix(meander_gradient(seed, p, i, o) * f, meander_gradient(seed, p, i + 1, o) * (f - 1.0),
                    f * f * (3.0 - 2.0 * f));
        // Each octave tapers within half its wavelength of the ends.
        let e = clamp(min(s, len - s) * 2.0 / wavelength, 0.0, 1.0);
        let follow = far > 0.0 ? smoothstep(0.5 * far, far, wavelength) : 1.0;
        m += v * 2.0 * MEANDER_AMP * wavelength * e * e * (3.0 - 2.0 * e) * follow;
        wavelength *= 0.5;
    }
    return m;
}

// The valley the water cuts, at `x` metres from its edge: its rise over the
// bed, steepening outward so the cut ends within a few kilometres however
// deep the ground stands over the bed.
fn valley_rise(x: f32) -> f32 {
    let o = max(x, 0.0);
    return 0.2 * o + 1.6e-4 * o * o;
}

// The water about `dir`, for a cell `cell` metres wide (water_at): near.x
// the height the rivers' valleys cut the ground down to (the lowest of a bed plus its
// valley's rise, over every river near; 1e9 where none), y the share of the
// cell in a river's channel, z the level of the lake whose surface stands
// highest here (its valley's water, riverbuild.bk; -1e9 where none) and w
// how deep it stands over that valley's bed. A cell wider than a channel spreads its valley's
// sides over its width (the distance taken as sqrt(d^2 + cell^2 / 6), the
// root mean square over a cell) and holds its water as the share of it the
// channel covers.
//
// The points' offsets from here are in f32: each point's direction as its
// record stores it (f32, so the same wherever it is read), less here as an
// anchor's direction `hi` (anchor.bk) and the offset `lo` from it, exact to
// millimetres.
fn point_offset(net: read_store<f32, 1>, k: i32, hi: vec3<f32>, lo: vec3<f32>, r: f32) -> vec3<f32> {
    return ((vec3<f32>(net[k + 4], net[k + 5], net[k + 6]) - hi) - lo) * r;
}
// channel: how deep the channels it lies in run under their water there
// (m; 0 out of every channel): a river's bed sinks to a 25th of its
// width at its middle (hydraulic geometry: depth grows about as the root
// of the width's square, a channel 20 to 40 widths across for each of its
// depths, Leopold and Maddock 1953), in a parabola from its banks.
// bed: the floor's height under the valley that cuts deepest here (-1e9
// where none), which near.x rises from. lake: the highest lake surface
// over here of every valley near (lake_top; -1e9 where none).
pub struct Water {
    near: vec4<f32>,
    channel: f32,
    bed: f32,
    lake: f32,
    // The share of the cell on a great river's floodplain (plain_half), and
    // its old courses there, to -1 in a grown-over swale.
    plain: f32,
    tone: f32,
    // The share of the cell on a sand bar: an island's rim, or a bank's;
    // and on an island, which stands out of a lake as out of a channel.
    bar: f32,
    dry: f32,
    // The share of the cell on a river's banks, in the strip its gallery
    // woods grow along (GALLERY).
    gallery: f32,
}
const CHANNEL_DEPTH: f32 = 0.04;   // of the width, at the middle
// The reach from point k (record offset) to its downstream point, at offset
// af from here: v.x the height its valley cuts the ground to, v.y the share
// of the cell in its channel, v.z how deep its channel runs here, v.w its
// floor's height; surface the level its water stands at where it holds a
// lake: its downstream point's, as a lake stands flat at its outlet's (a
// surface run between its points' sloped from a tributary's level down to
// the lake it joins, a sheet of water over the lake's floor ending in a cut
// across the shore). The floor runs between its points'. A point's
// (riverbuild.bk): the water filled over the floors and breached, the
// floor the full ground's lowest along the reach, or the water where an
// outlet's gorge cuts through a rim under it. So the river lies in the
// ground's hollows, holding lakes in them, rather than standing at the
// lattice's broad heights over a hollow with its valley cut as a shelf
// into the slopes either side.
const SHARE_SIGMA: f32 = 0.75;
// erf, to 2e-4 (Winitzki 2008).
pub fn erf_approx(x: f32) -> f32 {
    let x2 = x * x;
    let ax2 = 0.147 * x2;
    let e = sqrt(1.0 - exp(-x2 * (1.2732395 + ax2) / (1.0 + ax2)));
    if (x < 0.0) { return -e; }
    return e;
}
struct Reach {
    v: vec4<f32>,
    surface: f32,
    plain: f32,
    tone: f32,
    bar: f32,
    dry: f32,
    gallery: f32,
}
// The gallery woods' strip out from each bank: a creek's a few crowns
// wide, a great river's some hundreds of metres; it wanders along the
// reach, narrowing to nothing on some stretches.
const GALLERY_MIN: f32 = 18.0;
const GALLERY_MAX: f32 = 450.0;
// A floodplain's rise from its channel outward, m a metre.
const PLAIN_RISE: f32 = 0.003;
// How much a channel's width wanders along its reach (and each bank about
// that), and the catchments from which a channel holds islands, sand bars
// and a floodplain.
const WIDTH_VARY: f32 = 0.3;
const BANK_VARY: f32 = 0.12;
const ISLAND_MIN: f32 = 150.0;
const BAR_MIN: f32 = 60.0;
const PLAIN_MIN: f32 = 20.0;
// 0 to 1, hashed from (p, i).
fn hash01(seed: i32, p: i32, i: i32) -> f32 {
    let h = hash_primes3d(seed, p * PRIME_X, i * PRIME_Y, 0);
    return (((h >> 8) & 65535) as f32) / 65536.0;
}
// Smooth gradient noise along a reach, about -1 to 1, at `wavelength` m.
fn wobble(seed: i32, p: i32, s: f32, wavelength: f32) -> f32 {
    let x = s / max(wavelength, 1.0);
    let c = floor(x);
    let f = x - c;
    let i = c as i32;
    return 2.0 * mix(meander_gradient(seed, p, i, 9) * f, meander_gradient(seed, p, i + 1, 9) * (f - 1.0),
                     f * f * (3.0 - 2.0 * f));
}
// The reach's bend: its channel's offset across its line (m) at t (0 to 1)
// of a reach `len` long, a cubic Hermite from nothing at either point whose
// slopes there are the points' tangents' in the reach's frame (riverbuild.bk
// k_river_tangent: across over along), so a reach leaves its point the way
// the reach into it arrived and a river runs smoothly through the lattice's
// points rather than turning at them; a tributary meets its river leaning
// downstream. The slopes held under BEND_SLOPE keep the distance across the
// reach to the bend the distance to the channel (meander's).
const BEND_SLOPE: f32 = 0.6;
fn tangent_slope(net: read_store<f32, 1>, k: i32, along: vec3<f32>, side: vec3<f32>) -> f32 {
    let tg = vec3<f32>(net[k + 8], net[k + 9], net[k + 10]);
    return clamp(dot(tg, side) / max(dot(tg, along), 0.3), -BEND_SLOPE, BEND_SLOPE);
}
fn bend(net: read_store<f32, 1>, k: i32, down: i32, along: vec3<f32>, side: vec3<f32>, t: f32, len: f32) -> f32 {
    let t2 = t * t;
    return len * ((t2 * t - 2.0 * t2 + t) * tangent_slope(net, k, along, side) + (t2 * t - t2) * tangent_slope(net, down, along, side));
}
fn reach(net: read_store<f32, 1>, k: i32, af: vec3<f32>, hi: vec3<f32>, lo: vec3<f32>, r: f32, up: vec3<f32>,
         cell: f32, spread: f32, seed: i32) -> Reach {
    let level = net[k + 3];
    let catchment = net[k + 2];
    let down = net[k + 1] as i32;
    let bf = point_offset(net, down * RIV_REC, hi, lo, r);
    let len = max(length(bf - af), 1.0);
    let along = (bf - af) / len;
    let side = normalize(cross(along, up));
    let s = clamp(-dot(af, along), 0.0, len);
    let t = s / len;
    let p = k / RIV_REC;
    let width = river_width(catchment);
    // The channel widens and narrows along its reach, back to its width at
    // the points, where the next reach takes it on.
    // Each bank wanders on its own too, at a shorter wavelength, so the
    // channel's edges are not one curve twice.
    let taper = smoothstep(0.0, 1.0, min(s, len - s) / max(min(3.0 * width, 0.25 * len), 1.0));
    let mid = 0.5 * width * (1.0 + WIDTH_VARY * wobble(seed + 11, p, s, 3.0 * width) * taper);
    // A bank wanders at every scale, bays and spits down to a few metres,
    // in octaves of a third the wavelength and half the reach; at one
    // octave a great river's banks were smooth arcs kilometres long.
    var vl: f32 = 0.0;
    var vr: f32 = 0.0;
    var bw = 0.8 * width;
    var ba = BANK_VARY;
    for (var o: i32 = 0; o < 4 && (o == 0 || bw > 2.0 * cell); o += 1) {
        // The finer octaves fade in as the cells resolve them.
        let fade = o == 0 ? 1.0 : clamp(bw / (2.0 * cell) - 1.0, 0.0, 1.0);
        vl += ba * fade * wobble(seed + 41 + 100 * o, p, s, bw);
        vr += ba * fade * wobble(seed + 43 + 100 * o, p, s, bw);
        bw *= 0.33;
        ba *= 0.5;
    }
    let hl = mid * (1.0 + vl * taper);
    let hr = mid * (1.0 + vr * taper);
    let half = 0.5 * (hl + hr);
    // From here to the reach's line, and across it to the channel: the
    // meanders about the reach's bend to its points' tangents.
    let q = af + along * s;
    let bent = bend(net, k, down * RIV_REC, along, side, t, len);
    let x = -dot(q, side) - bent - meander(p, s, len, width, seed);
    let ahead = dot(q, along);
    let d = length(vec2<f32>(ahead, x));
    let downLevel = net[down * RIV_REC + 3];
    let bed = mix(min(net[k + 7], level), min(net[down * RIV_REC + 7], downLevel), t);
    // The cell's share inside |d| < half: the strip under a Gaussian of
    // SHARE_SIGMA cells about here. A box a cell wide, or a tent, is not
    // band-limited: a stream narrower than a cell, running aslant across
    // them, took a large share of the cells whose centres it passed and
    // little of those between, and whatever filled in between the cells
    // strung it out as beads; under the Gaussian a cell's share is a
    // smooth function of its distance to the stream, which the cells
    // between carry on.
    let sg = SHARE_SIGMA * max(cell, 1e-3) * 1.4142136;
    let across = d / half;
    // The floodplain: from the channel's bank out to `plain`, rising a few
    // metres a kilometre; the valley's sides from its edge.
    let plain = max(plain_half(catchment), half);
    let ds = sqrt(d * d + spread);
    let floor_rise = PLAIN_RISE * clamp(ds - half, 0.0, plain - half);
    // This side's bank, blended across the middle.
    let hs = mix(hl, hr, smoothstep(-0.5 * half, 0.5 * half, x));
    var share = clamp(0.5 * (erf_approx((hs - d) / sg) - erf_approx((-hs - d) / sg)), 0.0, 1.0);
    var depth = CHANNEL_DEPTH * 2.0 * half * max(1.0 - across * across, 0.0);
    var out: Reach;
    out.plain = 0.0;
    out.tone = 0.0;
    out.bar = 0.0;
    out.dry = 0.0;
    // The banks' gallery: the share of the strip out to `gw` past either
    // bank, less the channel's.
    let gw = clamp(GALLERY_MIN + 0.25 * hs, GALLERY_MIN, GALLERY_MAX)
           * smoothstep(-0.6, 0.2, wobble(seed + 61, p, s, 6.0 * hs + 200.0));
    let strip = clamp(0.5 * (erf_approx((hs + gw - d) / sg) - erf_approx((-hs - gw - d) / sg)), 0.0, 1.0);
    out.gallery = max(strip - share, 0.0);
    // Islands stand in a broad river's channel: lenses, a large one in
    // about half of the stretches of five widths and a small one in a
    // third of those of two, off its middle, rimmed with sand bars; land the
    // colour of the floodplain.
    if (d < half + 2.0 * sg && catchment >= ISLAND_MIN) {
        for (var layer: i32 = 0; layer < 2; layer += 1) {
            let big = layer == 0;
            let stretch = min((big ? 10.0 : 4.5) * half, (big ? 0.5 : 0.25) * len);
            let u = s / stretch;
            let ci = floor(u) as i32;
            let h1 = hash01(seed + 13 + 7 * layer, p, ci);
            // Only stretches wholly inside the reach: an island across its
            // end would be cut off there.
            if (h1 < (big ? 0.55 : 0.35) && ((ci + 1) as f32) * stretch <= len) {
                let h2 = hash01(seed + 17 + 7 * layer, p, ci);
                let lens = big ? 0.22 + 0.3 * h1 : 0.1 + 0.25 * h1;
                let ex = (u - (ci as f32) - 0.5) / 0.38;
                let ey = (x / half - (h2 - 0.5) * 0.9) / lens;
                // Ragged, not a lens: its outline wanders by a third of its
                // breadth.
                let breadth = lens * half;
                let ragged = 0.3 * breadth * wobble(seed + 53 + layer, p, s + 97.0 * x / max(half, 1.0), 0.15 * stretch);
                let inside = (1.0 - sqrt(ex * ex + ey * ey)) * breadth + ragged;
                let island = smoothstep(-sg, sg, inside);
                share *= 1.0 - island;
                depth *= 1.0 - island;
                out.dry = max(out.dry, island);
                // Bars: broad at its head, where the river drops its sand,
                // a thin rim down its sides.
                // Its width wanders round the island, to nothing in places.
                let patchy = clamp(0.6 + 0.9 * wobble(seed + 67 + layer, p, s + 61.0 * x / max(half, 1.0), 0.08 * stretch), 0.0, 1.4);
                let rim = (0.12 * patchy + 0.35 * smoothstep(0.2, -0.9, ex)) * breadth + sg;
                out.bar = max(out.bar, island * (1.0 - smoothstep(0.0, rim, inside)));
            }
        }
    }
    // Point bars: sand along the banks, on stretches of them.
    if (catchment >= BAR_MIN && d < hs + 0.3 * hs + 2.0 * sg) {
        let out_of = d - hs;
        let on = smoothstep(0.0, 0.5, wobble(seed + 47, p, s, 2.0 * width)) * taper;
        out.bar = max(out.bar, on * smoothstep(-sg, sg, out_of) * (1.0 - smoothstep(0.0, 0.3 * hs + sg, out_of)));
    }
    // The floodplain, for a river large enough to have one: its edge
    // softened over a fifth of its width and wandering, and over it the
    // river's old courses, tighter meanders than its own: oxbow lakes along
    // some stretches of one, and the others' swales.
    let soft = 0.2 * plain + sg;
    if (catchment >= PLAIN_MIN && d < plain + soft) {
        let edge = plain * (1.0 + 0.25 * wobble(seed + 23, p, s, 2.0 * plain) * taper);
        out.plain = (1.0 - smoothstep(edge - soft, edge + soft, d)) * smoothstep(PLAIN_MIN, 300.0, catchment);
        let old_width = min(0.7 * width, 0.5 * len / MEANDER_WAVES);
        let xo = -dot(q, side) - bent - meander(p + 7919, s, len, old_width, seed + 101);
        let ho = 0.5 * old_width;
        let stretch = smoothstep(0.1, 0.35, wobble(seed + 19, p, s, 8.0 * old_width)) * taper * out.plain;
        let oxbow = stretch * clamp(0.5 * (erf_approx((ho - xo) / sg) - erf_approx((-ho - xo) / sg)), 0.0, 1.0);
        share = max(share, oxbow);
        depth = max(depth, 3.0 * oxbow);
        // Older courses still, silted up and grown over: darker swales
        // along other meanders, fading in and out along the plain.
        var swale: f32 = 0.0;
        for (var o: i32 = 0; o < 2; o += 1) {
            let xs = -dot(q, side) - bent - meander(p + 104729 * (o + 2), s, len, old_width * (1.3 + 0.5 * (o as f32)), seed + 211 + o);
            let along_s = smoothstep(-0.2, 0.3, wobble(seed + 29 + o, p, s, 6.0 * old_width));
            let wide = ho * 1.6 + sg;
            swale = max(swale, along_s * exp(-(xs * xs) / (wide * wide)));
        }
        out.tone = -swale * taper * out.plain;
    }
    out.v = vec4<f32>(bed + floor_rise + valley_rise(ds - plain) * valley_steepness(catchment), share, depth, bed);
    out.surface = downLevel;
    return out;
}

// Whether point index `p` is one of the 3x3 points about cell c.
fn in_block(c: vec3<i32>, p: i32) -> bool {
    let pc = point_cell(p);
    if (pc.x == c.x) { return abs(pc.y - c.y) <= 1 && abs(pc.z - c.z) <= 1; }
    // Across a face's edge the neighbours are found as the 3x3 loop finds them.
    var found = false;
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            if (point_index(cell_next(c, di, dj)) == p) { found = true; }
        }
    }
    return found;
}

// Every reach whose valley can reach the direction hi + lo is searched: the
// reaches from the 3x3 points about its cell, and the reaches into them from
// the ring of 16 beyond. A reach between two points outside the 3x3 passes
// at least half a cell (10 km) away, where its valley stands kilometres over
// any ground; one left out nearer would end its valley along a cell's edge,
// a straight crease across the land.
pub fn water_at(hi: vec3<f32>, lo: vec3<f32>, radius: f32, cell: f32, net: read_store<f32, 1>, seed: i32) -> Water {
    let up = normalize(hi + lo);
    let c = cell_of(up);
    let r = radius;
    var cut: f32 = 1.0e9;
    var share: f32 = 0.0;
    var channel: f32 = 0.0;
    var bed: f32 = -1.0e9;
    var top: f32 = -1.0e9;
    var level: f32 = -1.0e9;
    var depth: f32 = 0.0;
    var plain: f32 = 0.0;
    var tone: f32 = 0.0;
    var bar: f32 = 0.0;
    var dry: f32 = 0.0;
    var gallery: f32 = 0.0;
    let spread = cell * cell / 6.0;
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            let k = point_index(cell_next(c, di, dj)) * RIV_REC;
            if (net[k + 3] > 0.0 && net[k + 2] >= MIN_CATCHMENT && net[k + 1] >= 0.0) {
                let rc = reach(net, k, point_offset(net, k, hi, lo, r), hi, lo, r, up, cell, spread, seed);
                if (rc.v.x < cut) {
                    cut = rc.v.x;
                    bed = rc.v.w;
                }
                let lt = lake_top(rc);
                if (lt > top) {
                    top = lt;
                    level = rc.surface;
                    depth = rc.surface - rc.v.w;
                }
                share = max(share, rc.v.y);
                channel = max(channel, rc.v.z);
                if (rc.plain > plain) {
                    plain = rc.plain;
                    tone = rc.tone;
                }
                bar = max(bar, rc.bar);
                dry = max(dry, rc.dry);
                gallery = max(gallery, rc.gallery);
            }
        }
    }
    for (var dj: i32 = -2; dj <= 2; dj += 1) {
        for (var di: i32 = -2; di <= 2; di += 1) {
            if (abs(di) == 2 || abs(dj) == 2) {
                let k = point_index(cell_next(c, di, dj)) * RIV_REC;
                let down = net[k + 1];
                if (down >= 0.0 && net[k + 3] > 0.0 && net[k + 2] >= MIN_CATCHMENT && in_block(c, down as i32)) {
                    let rc = reach(net, k, point_offset(net, k, hi, lo, r), hi, lo, r, up, cell, spread, seed);
                    if (rc.v.x < cut) {
                        cut = rc.v.x;
                        bed = rc.v.w;
                    }
                    let lt = lake_top(rc);
                    if (lt > top) {
                        top = lt;
                        level = rc.surface;
                        depth = rc.surface - rc.v.w;
                    }
                    share = max(share, rc.v.y);
                    channel = max(channel, rc.v.z);
                    if (rc.plain > plain) {
                        plain = rc.plain;
                        tone = rc.tone;
                    }
                    bar = max(bar, rc.bar);
                    dry = max(dry, rc.dry);
                    gallery = max(gallery, rc.gallery);
                }
            }
        }
    }
    var w: Water;
    w.near = vec4<f32>(cut, share, level, depth);
    w.channel = channel;
    w.bed = bed;
    w.lake = top;
    w.plain = plain;
    w.tone = tone;
    w.bar = bar;
    w.dry = dry;
    w.gallery = gallery;
    return w;
}

// A reach's lake surface here, under which the ground is under its water:
// where its water stands over LAKE_DEPTH above its bed, its level, out to
// where its valley's profile rises SHORE over the level (less where the
// lake shallows toward its outlet, twice its depth past LAKE_DEPTH, so it
// narrows to its end rather than ending across the valley in a straight
// line): the valley's sides
// carry the ground's relief, so the shore runs in bays and points rather
// than along the profile's smooth contour, a canal's. Beyond, it falls
// BANK times as steeply as the profile rises, so the lake ends in a short
// bank over lower ground rather than a wall. -1e9 without a lake. A lake
// stands only in its river's valley, so never as a ring of water about a
// hollow's slopes.
const SHORE: f32 = 60.0;
const BANK: f32 = 3.0;
fn lake_top(rc: Reach) -> f32 {
    let over = rc.surface - rc.v.w - LAKE_DEPTH;
    if (over <= 0.0) { return -1.0e9; }
    return rc.surface - BANK * max(rc.v.x - rc.surface - min(SHORE, 2.0 * over), 0.0);
}

// The surface over ground at height h by the lakes of `w` (water_at): the
// highest of their surfaces where the ground lies under it, so where two
// valleys meet the water holds across the line where one's valley gives
// way to the other's. h itself elsewhere.
pub fn lake_surface(h: f32, w: Water) -> f32 {
    return max(h, w.lake);
}

// The share of a cell whose mean ground or water surface is at h under
// water: its river channel's, or a lake's. Where a lake stands the ground
// under it is its surface (ground.bk terrain), so a cell a share p under it
// has a mean (1 - p) of the dry ground's excess over the level above it,
// the dry ground spread about as the cell's heights are (sd: their
// standard deviation, its unresolved octaves and its slope across it):
// the share falls from 1 at the level to none a typical excess, 0.8 sd,
// above it, so a shore crossing a cell takes part of it rather than all or
// none (a saw of whole cells along it); and none from a lake under a
// metre deep over LAKE_DEPTH, as it vanishes. The excess is over the lake's
// surface here (w.lake), not its level: past its shore the surface falls
// away as its bank (lake_top), and the water thins to none as the bank
// drops a few metres under the level. Measured against the level, ground
// as high as it anywhere about, out past the lake's end, drew a line of
// water along that contour, all of a cell where its mean height met it and
// none between: a dotted stream across the valley's side.
pub fn water_share(h: f32, w: Water, sd: f32) -> f32 {
    var lake: f32 = 0.0;
    if (w.near.w > LAKE_DEPTH) {
        let soft = 0.8 * sd + 0.25;
        lake = clamp(1.0 + min(w.lake - h, 0.0) / soft, 0.0, 1.0)
             * clamp(1.0 - (w.near.z - w.lake) / (soft + 2.0), 0.0, 1.0)
             * clamp(w.near.w - LAKE_DEPTH, 0.0, 1.0) * (1.0 - w.dry);
    }
    return max(w.near.y, lake);
}

