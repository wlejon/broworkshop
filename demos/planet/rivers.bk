// The planet's rivers and lakes: a drainage network over the whole sphere,
// which the ground's height carves (ground.bk terrain) and whose water the
// ground's colour and cover take.
//
// The network is a lattice of points, one in each cell of an equal-angle
// grid on each cube face (RIV_N x RIV_N cells, about 20 km apart at Earth's
// radius), each at a spot hashed inside its cell. riverbuild.bk gives every
// point the ground's broad height there; the level water stands at there,
// the hollows filled up to where they spill (Planchon and Darboux 2001),
// with a slight fall across each lake toward its outlet; its downstream
// neighbour (the one of its 8 that level falls to most steeply, so every
// chain reaches the sea); and its catchment, the points that drain through
// it: a record of RIV_REC floats each, which this module reads. A river
// runs from each point to its downstream one, as wide as its catchment
// says, its bed falling from the one point's level to the other's; where
// the level stands over the ground a lake lies, out to where the ground
// rises through its level.
module planet::rivers;

import std::noise::*;

pub const RIV_N: i32 = 512;
pub const RIV_REC: i32 = 8;   // height (m), downstream point (-1 none), catchment (points), water level (m), direction (3), floor (m; riverbuild.bk k_river_floor)
// The octaves the lattice resolves, which its points' heights are the
// ground at: about 20 km between points, a wavelength of 2.5 of them
// (ground.bk octaves_for).
pub const RIV_OCTAVES: f64 = 5.6;
// A point drains a river once at least this many points drain through it.
const MIN_CATCHMENT: f32 = 2.0;
const PI4: f32 = 0.78539816;

// Face `face`'s frame: a its axis (outward), e and f its plane's axes
// (clouds.js faceFrame, the same).
pub fn face_a(face: i32) -> vec3<f64> {
    let s: f64 = face < 3 ? 1.0 : -1.0;
    let axis = face % 3;
    if (axis == 0) { return vec3<f64>(s, 0.0, 0.0); }
    if (axis == 1) { return vec3<f64>(0.0, s, 0.0); }
    return vec3<f64>(0.0, 0.0, s);
}
pub fn face_e(face: i32) -> vec3<f64> {
    let axis = face % 3;
    if (axis == 0) { return vec3<f64>(0.0, 1.0, 0.0); }
    if (axis == 1) { return vec3<f64>(0.0, 0.0, 1.0); }
    return vec3<f64>(1.0, 0.0, 0.0);
}
pub fn face_f(face: i32) -> vec3<f64> {
    let axis = face % 3;
    if (axis == 0) { return vec3<f64>(0.0, 0.0, 1.0); }
    if (axis == 1) { return vec3<f64>(1.0, 0.0, 0.0); }
    return vec3<f64>(0.0, 1.0, 0.0);
}

// The face whose side of the cube `d` points through.
pub fn face_of(d: vec3<f64>) -> i32 {
    let ax = abs(d.x);
    let ay = abs(d.y);
    let az = abs(d.z);
    if (ax >= ay && ax >= az) { return d.x > 0.0 ? 0 : 3; }
    if (ay >= az) { return d.y > 0.0 ? 1 : 4; }
    return d.z > 0.0 ? 2 : 5;
}

// The direction at equal-angle coordinates (x, y) of a face (-1 to 1 across
// it; beyond, the plane carries on past its edge).
pub fn alpha_dir(face: i32, x: f32, y: f32) -> vec3<f64> {
    let u = tan(x * PI4) as f64;
    let v = tan(y * PI4) as f64;
    return normalize(face_a(face) + face_e(face) * u + face_f(face) * v);
}

// The cell (face, i, j) that `d` lies in.
pub fn cell_of(d: vec3<f64>) -> vec3<i32> {
    let face = face_of(d);
    let z = dot(d, face_a(face));
    let x = atan((dot(d, face_e(face)) / z) as f32) / PI4;
    let y = atan((dot(d, face_f(face)) / z) as f32) / PI4;
    let n = RIV_N as f32;
    let i = clamp(floor((x + 1.0) * 0.5 * n) as i32, 0, RIV_N - 1);
    let j = clamp(floor((y + 1.0) * 0.5 * n) as i32, 0, RIV_N - 1);
    return vec3<i32>(face, i, j);
}

pub fn point_index(c: vec3<i32>) -> i32 {
    return (c.x * RIV_N + c.z) * RIV_N + c.y;
}
pub fn point_cell(k: i32) -> vec3<i32> {
    return vec3<i32>(k / (RIV_N * RIV_N), k % RIV_N, (k / RIV_N) % RIV_N);
}

// The point of cell c: at a spot hashed inside the middle 70% of it.
pub fn point_dir(c: vec3<i32>, seed: i32) -> vec3<f64> {
    let hx = hash_primes3d(seed + 5003, c.y * PRIME_X, c.z * PRIME_Y, c.x * PRIME_Z);
    let hy = hash_primes3d(seed + 6007, c.y * PRIME_X, c.z * PRIME_Y, c.x * PRIME_Z);
    let jx = 0.15 + 0.7 * (((hx >> 8) & 65535) as f32) / 65536.0;
    let jy = 0.15 + 0.7 * (((hy >> 8) & 65535) as f32) / 65536.0;
    let step = 2.0 / (RIV_N as f32);
    return alpha_dir(c.x, -1.0 + ((c.y as f32) + jx) * step, -1.0 + ((c.z as f32) + jy) * step);
}

// The cell (di, dj) from c, across the face's edge if need be.
pub fn cell_next(c: vec3<i32>, di: i32, dj: i32) -> vec3<i32> {
    let i = c.y + di;
    let j = c.z + dj;
    if (i >= 0 && i < RIV_N && j >= 0 && j < RIV_N) { return vec3<i32>(c.x, i, j); }
    let step = 2.0 / (RIV_N as f32);
    return cell_of(alpha_dir(c.x, -1.0 + ((i as f32) + 0.5) * step, -1.0 + ((j as f32) + 0.5) * step));
}

// A river `catchment` points large: its width (m).
pub fn river_width(catchment: f32) -> f32 {
    return 6.0 * sqrt(catchment);
}
// A river's water stands over its bed as a lake from this deep (m).
const LAKE_DEPTH: f32 = 1.0;

// A river's meanders: its channel's offset across its reach (m), `s` metres
// along a reach `len` long from point `p`, for a channel `width` wide. Gradient
// noise in octaves from half the reach down to MEANDER_WAVES widths (a
// meander's wavelength is about 11 of its channel's widths, Leopold and
// Wolman 1960), each MEANDER_AMP of its wavelength, each tapered to nothing
// within half its wavelength of the reach's ends so reaches meet at their
// points and the short meanders run up to them; the valley follows the
// channel. Slopes stay under one, so the distance across the reach to the
// offset stays the distance to the channel.
const MEANDER_WAVES: f32 = 11.0;
const MEANDER_AMP: f32 = 0.18;
fn meander_gradient(seed: i32, p: i32, i: i32, octave: i32) -> f32 {
    let h = hash_primes3d(seed + 7919, p * PRIME_X, i * PRIME_Y, octave * PRIME_Z);
    return (((h >> 8) & 65535) as f32) / 32767.5 - 1.0;
}
pub fn meander(p: i32, s: f32, len: f32, width: f32, seed: i32) -> f32 {
    let shortest = MEANDER_WAVES * width;
    var wavelength = 0.5 * len;
    var m: f32 = 0.0;
    for (var o: i32 = 0; o < 6; o += 1) {
        if (wavelength < shortest) { break; }
        let x = s / wavelength;
        let c = floor(x);
        let f = x - c;
        let i = c as i32;
        let v = mix(meander_gradient(seed, p, i, o) * f, meander_gradient(seed, p, i + 1, o) * (f - 1.0),
                    f * f * (3.0 - 2.0 * f));
        // Each octave tapers within half its wavelength of the ends.
        let e = clamp(min(s, len - s) * 2.0 / wavelength, 0.0, 1.0);
        m += v * 2.0 * MEANDER_AMP * wavelength * e * e * (3.0 - 2.0 * e);
        wavelength *= 0.5;
    }
    return m;
}

// The valley the water cuts, at `x` metres from its edge: its rise over the
// bed, steepening outward so the cut ends within a few kilometres however
// deep the ground stands over the bed.
fn valley_rise(x: f32) -> f32 {
    let o = max(x, 0.0);
    return 0.2 * o + 1.6e-4 * o * o;
}

// The water about `dir`, for a cell `cell` metres wide (water_at): near.x
// the height the rivers' valleys cut the ground down to (the lowest of a bed plus its
// valley's rise, over every river near; 1e9 where none), y the share of the
// cell in a river's channel, z the level of the lake whose surface stands
// highest here (its valley's water, riverbuild.bk; -1e9 where none) and w
// how deep it stands over that valley's bed. A cell wider than a channel spreads its valley's
// sides over its width (the distance taken as sqrt(d^2 + cell^2 / 6), the
// root mean square over a cell) and holds its water as the share of it the
// channel covers.
//
// The points' offsets from `dir` are in f32: each point's direction as its
// record stores it (f32, so the same wherever it is read), less `dir` split
// into its nearest f32 and the remainder, exact to millimetres.
fn point_offset(net: read_store<f32, 1>, k: i32, hi: vec3<f32>, lo: vec3<f32>, r: f32) -> vec3<f32> {
    return ((vec3<f32>(net[k + 4], net[k + 5], net[k + 6]) - hi) - lo) * r;
}
// channel: how deep the channels it lies in run under their water there
// (m; 0 out of every channel): a river's bed sinks to a 25th of its
// width at its middle (hydraulic geometry: depth grows about as the root
// of the width's square, a channel 20 to 40 widths across for each of its
// depths, Leopold and Maddock 1953), in a parabola from its banks.
// bed: the floor's height under the valley that cuts deepest here (-1e9
// where none), which near.x rises from. lake: the highest lake surface
// over here of every valley near (lake_top; -1e9 where none).
pub struct Water {
    near: vec4<f32>,
    channel: f32,
    bed: f32,
    lake: f32,
}
const CHANNEL_DEPTH: f32 = 0.04;   // of the width, at the middle
// The reach from point k (record offset) to its downstream point, at offset
// af from here: v.x the height its valley cuts the ground to, v.y the share
// of the cell in its channel, v.z how deep its channel runs here, v.w its
// floor's height; surface its water's here. Both run between its points'
// (riverbuild.bk): the water filled over the floors and breached, the
// floor the full ground's lowest along the reach, or the water where an
// outlet's gorge cuts through a rim under it. So the river lies in the
// ground's hollows, holding lakes in them, rather than standing at the
// lattice's broad heights over a hollow with its valley cut as a shelf
// into the slopes either side.
struct Reach {
    v: vec4<f32>,
    surface: f32,
}
fn reach(net: read_store<f32, 1>, k: i32, af: vec3<f32>, hi: vec3<f32>, lo: vec3<f32>, r: f32, up: vec3<f32>,
         cell: f32, spread: f32, seed: i32) -> Reach {
    let level = net[k + 3];
    let catchment = net[k + 2];
    let down = net[k + 1] as i32;
    let bf = point_offset(net, down * RIV_REC, hi, lo, r);
    let len = max(length(bf - af), 1.0);
    let along = (bf - af) / len;
    let side = normalize(cross(along, up));
    let s = clamp(-dot(af, along), 0.0, len);
    let t = s / len;
    let half = 0.5 * river_width(catchment);
    // From here to the reach's line, and across it to the channel.
    let q = af + along * s;
    let d = length(vec2<f32>(dot(q, along), -dot(q, side) - meander(k / RIV_REC, s, len, 2.0 * half, seed)));
    let downLevel = net[down * RIV_REC + 3];
    let bed = mix(min(net[k + 7], level), min(net[down * RIV_REC + 7], downLevel), t);
    // The cell's share inside |d| < half, a strip against a box: their
    // overlap along the distance.
    let s0 = max(d - 0.5 * cell, -half);
    let s1 = min(d + 0.5 * cell, half);
    let across = d / half;
    var out: Reach;
    out.v = vec4<f32>(bed + valley_rise(sqrt(d * d + spread) - half),
                      clamp((s1 - s0) / max(cell, 1e-3), 0.0, 1.0),
                      CHANNEL_DEPTH * 2.0 * half * max(1.0 - across * across, 0.0), bed);
    out.surface = mix(level, downLevel, t);
    return out;
}

// Whether point index `p` is one of the 3x3 points about cell c.
fn in_block(c: vec3<i32>, p: i32) -> bool {
    let pc = point_cell(p);
    if (pc.x == c.x) { return abs(pc.y - c.y) <= 1 && abs(pc.z - c.z) <= 1; }
    // Across a face's edge the neighbours are found as the 3x3 loop finds them.
    var found = false;
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            if (point_index(cell_next(c, di, dj)) == p) { found = true; }
        }
    }
    return found;
}

// Every reach whose valley can reach `dir` is searched: the reaches from the
// 3x3 points about its cell, and the reaches into them from the ring of 16
// beyond. A reach between two points outside the 3x3 passes at least half a
// cell (10 km) away, where its valley stands kilometres over any ground; one
// left out nearer would end its valley along a cell's edge, a straight crease
// across the land.
pub fn water_at(dir: vec3<f64>, radius: f64, cell: f32, net: read_store<f32, 1>, seed: i32) -> Water {
    let c = cell_of(dir);
    let hi = vec3<f32>(dir.x as f32, dir.y as f32, dir.z as f32);
    let rest = dir - vec3<f64>(hi.x as f64, hi.y as f64, hi.z as f64);
    let lo = vec3<f32>(rest.x as f32, rest.y as f32, rest.z as f32);
    let r = radius as f32;
    let up = normalize(hi);
    var cut: f32 = 1.0e9;
    var share: f32 = 0.0;
    var channel: f32 = 0.0;
    var bed: f32 = -1.0e9;
    var top: f32 = -1.0e9;
    var level: f32 = -1.0e9;
    var depth: f32 = 0.0;
    let spread = cell * cell / 6.0;
    for (var dj: i32 = -1; dj <= 1; dj += 1) {
        for (var di: i32 = -1; di <= 1; di += 1) {
            let k = point_index(cell_next(c, di, dj)) * RIV_REC;
            if (net[k + 3] > 0.0 && net[k + 2] >= MIN_CATCHMENT && net[k + 1] >= 0.0) {
                let rc = reach(net, k, point_offset(net, k, hi, lo, r), hi, lo, r, up, cell, spread, seed);
                if (rc.v.x < cut) {
                    cut = rc.v.x;
                    bed = rc.v.w;
                }
                let lt = lake_top(rc);
                if (lt > top) {
                    top = lt;
                    level = rc.surface;
                    depth = rc.surface - rc.v.w;
                }
                share = max(share, rc.v.y);
                channel = max(channel, rc.v.z);
            }
        }
    }
    for (var dj: i32 = -2; dj <= 2; dj += 1) {
        for (var di: i32 = -2; di <= 2; di += 1) {
            if (abs(di) == 2 || abs(dj) == 2) {
                let k = point_index(cell_next(c, di, dj)) * RIV_REC;
                let down = net[k + 1];
                if (down >= 0.0 && net[k + 3] > 0.0 && net[k + 2] >= MIN_CATCHMENT && in_block(c, down as i32)) {
                    let rc = reach(net, k, point_offset(net, k, hi, lo, r), hi, lo, r, up, cell, spread, seed);
                    if (rc.v.x < cut) {
                        cut = rc.v.x;
                        bed = rc.v.w;
                    }
                    let lt = lake_top(rc);
                    if (lt > top) {
                        top = lt;
                        level = rc.surface;
                        depth = rc.surface - rc.v.w;
                    }
                    share = max(share, rc.v.y);
                    channel = max(channel, rc.v.z);
                }
            }
        }
    }
    var w: Water;
    w.near = vec4<f32>(cut, share, level, depth);
    w.channel = channel;
    w.bed = bed;
    w.lake = top;
    return w;
}

// A reach's lake surface here, under which the ground is under its water:
// where its water stands over LAKE_DEPTH above its bed, its level, out to
// where its valley's profile rises SHORE over the level (less where the
// lake shallows toward its outlet, twice its depth past LAKE_DEPTH, so it
// narrows to its end rather than ending across the valley in a straight
// line): the valley's sides
// carry the ground's relief, so the shore runs in bays and points rather
// than along the profile's smooth contour, a canal's. Beyond, it falls
// BANK times as steeply as the profile rises, so the lake ends in a short
// bank over lower ground rather than a wall. -1e9 without a lake. A lake
// stands only in its river's valley, so never as a ring of water about a
// hollow's slopes.
const SHORE: f32 = 60.0;
const BANK: f32 = 3.0;
fn lake_top(rc: Reach) -> f32 {
    let over = rc.surface - rc.v.w - LAKE_DEPTH;
    if (over <= 0.0) { return -1.0e9; }
    return rc.surface - BANK * max(rc.v.x - rc.surface - min(SHORE, 2.0 * over), 0.0);
}

// The surface over ground at height h by the lakes of `w` (water_at): the
// highest of their surfaces where the ground lies under it, so where two
// valleys meet the water holds across the line where one's valley gives
// way to the other's. h itself elsewhere.
pub fn lake_surface(h: f32, w: Water) -> f32 {
    return max(h, w.lake);
}

// The share of a cell whose mean ground or water surface is at h under
// water: its river channel's, or a lake's. Where a lake stands the ground
// under it is its surface (ground.bk terrain), so a cell a share p under it
// has a mean (1 - p) of the dry ground's excess over the level above it,
// the dry ground spread about as the cell's heights are (sd: their
// standard deviation, its unresolved octaves and its slope across it):
// the share falls from 1 at the level to none a typical excess, 0.8 sd,
// above it, so a shore crossing a cell takes part of it rather than all or
// none (a saw of whole cells along it); and none from a lake under a
// metre deep over LAKE_DEPTH, as it vanishes. Under the level, on its
// bank (lake_surface), the water thins to none over a few metres.
pub fn water_share(h: f32, w: Water, sd: f32) -> f32 {
    var lake: f32 = 0.0;
    if (w.near.w > LAKE_DEPTH) {
        let x = w.near.z - h;
        let soft = 0.8 * sd + 0.25;
        if (x <= 0.0) {
            lake = clamp(1.0 + x / soft, 0.0, 1.0) * clamp(w.near.w - LAKE_DEPTH, 0.0, 1.0);
        } else {
            lake = clamp(1.0 - x / (soft + 2.0), 0.0, 1.0);
        }
    }
    return max(w.near.y, lake);
}

