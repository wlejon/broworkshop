// Where the ground's noise lattices lie about an anchor. GPU code is f32,
// and a planet-radius point in f32 is good to about half a metre: so every
// lattice a world's ground reads is found once at an anchor near the work,
// on the CPU in f64 (anchor_of: a tile's centre, a field's, the camera), and
// a point is the anchor's direction plus an f32 offset from it.
//
// An anchor carries four lattices, two simplex (p, r: skewed) and two
// Perlin (v, f), at the points the world gives for a direction
// (planet::world_lattice: lattice_points in f64, lattice_points_near in
// f32); what each is for is the world's.
// A lattice's point there is held in fixed point, its cell and 64 bits of
// fraction an axis, so doubling it for each finer octave (twice) is exact
// integer work, and an octave's point is that plus the offset scaled to the
// octave, in f32 (simplex_from, perlin_from): exact to a part in 2^24 of the
// offset at every scale.
module planet::anchor;
from planet::noise import SimplexAt, skew;
from planet::world_lattice import lattice_points, lattice_points_near;

// A lattice's point: its cell, and the fraction in it in 64 bits an axis
// (hi the top 32).
pub struct Lattice {
    cell: vec3<i32>,
    hi: vec3<u32>,
    lo: vec3<u32>,
}
pub struct Anchor {
    dir: vec3<f32>,      // the anchor's direction, rounded to f32 (a tile's tiles::Record dir_hi)
    dir_lo: vec3<f32>,   // normalize(base) less dir
    base: vec3<f32>,     // its point in base coordinates (cube-sphere or a face's plane), f32
    lost: vec3<f32>,     // what base lost to f32
    p: Lattice,          // the world's first simplex lattice, skewed
    r: Lattice,          // its second, skewed
    v: Lattice,          // its first Perlin lattice
    f: Lattice,          // its second
}
// An anchor in a buffer (read_store<vec4<i32>, 1>): ANCHOR_VEC4S vec4s, the
// four vectors (xyz, float bits) then each lattice's cell, hi and lo.
pub const ANCHOR_VEC4S: i32 = 16;

fn lattice_at<B>(buf: B, i: i32) -> Lattice {
    let c = buf[i];
    let h = buf[i + 1];
    let l = buf[i + 2];
    return Lattice {
        cell: c.xyz,
        hi: vec3<u32>(bitcast<u32>(h.x), bitcast<u32>(h.y), bitcast<u32>(h.z)),
        lo: vec3<u32>(bitcast<u32>(l.x), bitcast<u32>(l.y), bitcast<u32>(l.z)),
    };
}
pub fn read_anchor<B>(buf: B, k: i32) -> Anchor {
    let i = k * ANCHOR_VEC4S;
    return Anchor {
        dir: bitcast<vec4<f32>>(buf[i]).xyz,
        dir_lo: bitcast<vec4<f32>>(buf[i + 1]).xyz,
        base: bitcast<vec4<f32>>(buf[i + 2]).xyz,
        lost: bitcast<vec4<f32>>(buf[i + 3]).xyz,
        p: lattice_at(buf, i + 4),
        r: lattice_at(buf, i + 7),
        v: lattice_at(buf, i + 10),
        f: lattice_at(buf, i + 13),
    };
}

// ── Lattice work, in f32 and integers ───────────────────────────────────────

fn top_bit(x: u32) -> i32 {
    return bitcast<i32>(x >> 31u);
}
// The lattice's point an octave finer: twice it, exactly.
pub fn twice(l: Lattice) -> Lattice {
    return Lattice {
        cell: l.cell * 2 + vec3<i32>(top_bit(l.hi.x), top_bit(l.hi.y), top_bit(l.hi.z)),
        hi: vec3<u32>((l.hi.x << 1u) | (l.lo.x >> 31u), (l.hi.y << 1u) | (l.lo.y >> 31u), (l.hi.z << 1u) | (l.lo.z >> 31u)),
        lo: vec3<u32>(l.lo.x << 1u, l.lo.y << 1u, l.lo.z << 1u),
    };
}
// k octaves finer.
pub fn doubled(l: Lattice, k: i32) -> Lattice {
    var m = l;
    for (var i: i32 = 0; i < k; i += 1) {
        m = twice(m);
    }
    return m;
}
// The fraction's top 24 bits, exact in f32, and the rest.
fn frac_top(l: Lattice) -> vec3<f32> {
    return vec3<f32>((l.hi.x >> 8u) as f32, (l.hi.y >> 8u) as f32, (l.hi.z >> 8u) as f32) * (1.0 / 16777216.0);
}
fn frac_rest(l: Lattice) -> vec3<f32> {
    let h = vec3<f32>((l.hi.x & 255u) as f32, (l.hi.y & 255u) as f32, (l.hi.z & 255u) as f32);
    let o = vec3<f32>(l.lo.x as f32, l.lo.y as f32, l.lo.z as f32);
    return h * 2.3283064365386963e-10 + o * 5.421010862427522e-20;
}
// The simplex lattice's point `off` past l (the noise's coordinates, at l's
// octave): its cell and offset (relief.bk SimplexAt), and what the offset's
// f32 lost of the fraction, unskewed (the skew adds a third of the sum, so
// its inverse takes a sixth), which simplex_grad (noise.bk) puts back to
// first order.
pub fn simplex_from(l: Lattice, off: vec3<f32>) -> SimplexAt {
    let s = frac_top(l) + skew(off);
    let fl = floor(s);
    let rest = frac_rest(l);
    return SimplexAt {
        cell: l.cell + vec3<i32>(fl.x as i32, fl.y as i32, fl.z as i32),
        sk: s - fl,
        res: rest - vec3<f32>((rest.x + rest.y + rest.z) / 6.0),
    };
}
// A Perlin lattice's cell and offset (ground.bk perlin_at).
pub struct PerlinAt {
    cell: vec3<i32>,
    f: vec3<f32>,
}
pub fn perlin_from(l: Lattice, off: vec3<f32>) -> PerlinAt {
    let s = frac_top(l) + off;
    let fl = floor(s);
    return PerlinAt { cell: l.cell + vec3<i32>(fl.x as i32, fl.y as i32, fl.z as i32), f: s - fl };
}

// ── Offsets ─────────────────────────────────────────────────────────────────
//
// A point is the anchor's direction plus an offset e (dir + e is the unit
// direction), small beside 1, so f32 holds it to a part in 2^24 of itself.

// The offset of normalize(base + d) for a base offset d from the anchor's
// base point (a face plane's patch, the camera): |base + d| = |base| + g with
// g = (2 base.d + d.d) / (|base| + |base + d|), which holds no difference of
// large numbers (tiles.bk sphere_offset, the same).
pub fn plane_offset(a: Anchor, d: vec3<f32>) -> vec3<f32> {
    let l = length(a.base);
    let grow = 2.0 * dot(a.base, d) + dot(d, d);
    let l2 = sqrt(l * l + grow);
    let g = grow / (l + l2);
    return a.dir_lo + (d - a.dir * g) / l2;
}
// The offset of normalize(dir + e + d), a step d from the point at offset e.
pub fn moved(dir: vec3<f32>, e: vec3<f32>, d: vec3<f32>) -> vec3<f32> {
    let n = dir + e;
    let grow = 2.0 * dot(n, d) + dot(d, d);
    let l2 = sqrt(1.0 + grow);
    let g = grow / (1.0 + l2);
    return e + (d - n * g) / l2;
}

// An anchor at a direction known only to f32 (the clouds' cells, the rivers'
// points): its lattices from f32 products, good to about a metre, for work
// whose footprint is tens of metres or more.
fn lattice_near(q: vec3<f32>, skewed: bool) -> Lattice {
    var s = q;
    if (skewed) { s = skew(q); }
    let c = floor(s);
    let f = (s - c) * 4294967296.0;
    return Lattice {
        cell: vec3<i32>(c.x as i32, c.y as i32, c.z as i32),
        hi: vec3<u32>(min(f.x, 4294967040.0) as u32, min(f.y, 4294967040.0) as u32, min(f.z, 4294967040.0) as u32),
        lo: vec3<u32>(0u),
    };
}
pub fn anchor_near(dir: vec3<f32>, radius: f32) -> Anchor {
    let q = lattice_points_near(dir, radius);
    let z = vec3<f32>(0.0);
    return Anchor {
        dir: dir, dir_lo: z, base: dir, lost: z,
        p: lattice_near(q.p, true),
        r: lattice_near(q.r, true),
        v: lattice_near(q.v, false),
        f: lattice_near(q.f, false),
    };
}

// ── On the CPU, in f64 ──────────────────────────────────────────────────────
//
// Only @cpu kernels reach these (core/tiles.bk k_anchors, a world's surface height: Earth's produce.bk k_height).

pub fn lattice_of(q: vec3<f64>, skewed: bool) -> Lattice {
    var s = q;
    if (skewed) {
        let third = (0.3333333432674407958984375 as f32) as f64;
        s = q + vec3<f64>(third * (q.x + q.y + q.z));
    }
    let c = floor(s);
    let f = (s - c) * 4294967296.0;
    let h = floor(f);
    let l = floor((f - h) * 4294967296.0);
    return Lattice {
        cell: vec3<i32>((c.x as i64) as i32, (c.y as i64) as i32, (c.z as i64) as i32),
        hi: vec3<u32>((h.x as i64) as u32, (h.y as i64) as u32, (h.z as i64) as u32),
        lo: vec3<u32>((l.x as i64) as u32, (l.y as i64) as u32, (l.z as i64) as u32),
    };
}
// The anchor at `base` (base coordinates, exact), whose direction rounded to
// f32 is `dir` (given, so it is the very value a tile's record holds).
pub fn anchor_of(base: vec3<f64>, dir: vec3<f32>, radius: f64) -> Anchor {
    let b = vec3<f32>(base.x as f32, base.y as f32, base.z as f32);
    let bd = vec3<f64>(b.x as f64, b.y as f64, b.z as f64);
    let lost = base - bd;
    let n = normalize(bd);
    let d = vec3<f64>(dir.x as f64, dir.y as f64, dir.z as f64);
    let lo = n - d;
    let q = lattice_points(d, radius);
    return Anchor {
        dir: dir,
        dir_lo: vec3<f32>(lo.x as f32, lo.y as f32, lo.z as f32),
        base: b,
        lost: vec3<f32>(lost.x as f32, lost.y as f32, lost.z as f32),
        p: lattice_of(q.p, true),
        r: lattice_of(q.r, true),
        v: lattice_of(q.v, false),
        f: lattice_of(q.f, false),
    };
}
// An anchor at the unit direction `dir` itself, and dir's offset from it.
pub fn anchor_at(dir: vec3<f64>, radius: f64) -> Anchor {
    let b = vec3<f32>(dir.x as f32, dir.y as f32, dir.z as f32);
    let n = normalize(vec3<f64>(b.x as f64, b.y as f64, b.z as f64));
    return anchor_of(dir, vec3<f32>(n.x as f32, n.y as f32, n.z as f32), radius);
}

fn write_vec(out: write_store<i32, 1>, i: i32, v: vec3<f32>) {
    out[i] = bitcast<i32>(v.x);
    out[i + 1] = bitcast<i32>(v.y);
    out[i + 2] = bitcast<i32>(v.z);
    out[i + 3] = 0;
}
fn write_lattice(out: write_store<i32, 1>, i: i32, l: Lattice) {
    out[i] = l.cell.x;
    out[i + 1] = l.cell.y;
    out[i + 2] = l.cell.z;
    out[i + 3] = 0;
    out[i + 4] = bitcast<i32>(l.hi.x);
    out[i + 5] = bitcast<i32>(l.hi.y);
    out[i + 6] = bitcast<i32>(l.hi.z);
    out[i + 7] = 0;
    out[i + 8] = bitcast<i32>(l.lo.x);
    out[i + 9] = bitcast<i32>(l.lo.y);
    out[i + 10] = bitcast<i32>(l.lo.z);
    out[i + 11] = 0;
}
// Anchor k into `out` (read_anchor's layout).
pub fn write_anchor(out: write_store<i32, 1>, k: i32, a: Anchor) {
    let i = k * ANCHOR_VEC4S * 4;
    write_vec(out, i, a.dir);
    write_vec(out, i + 4, a.dir_lo);
    write_vec(out, i + 8, a.base);
    write_vec(out, i + 12, a.lost);
    write_lattice(out, i + 16, a.p);
    write_lattice(out, i + 28, a.r);
    write_lattice(out, i + 40, a.v);
    write_lattice(out, i + 52, a.f);
}
