// Kernels for measuring the clouds (on the CPU): the column field and the
// ground's light at a direction, as the tile kernels compute a cell's.
from planet::clouds import column, ground_light;

fn f32v(x: f64, y: f64, z: f64) -> vec3<f32> {
    let d = normalize(vec3<f64>(x, y, z));
    return vec3<f32>(d.x as f32, d.y as f32, d.z as f32);
}

// The column's amount (ch 0) or unresolved variance (ch 1) at direction
// (x, y, z), resolved at a footprint of w metres.
@kernel @cpu @grid(1)
fn k_column(g: grid<1>, x: f64, y: f64, z: f64, w: f64, radius: f64, ch: i32) -> f64 {
    let c = column(f32v(x, y, z), w as f32, radius as f32);
    if (ch == 1) {
        return c.y as f64;
    }
    return c.x as f64;
}

// What the clouds leave of the ground's light there (clouds.bk
// k_cloud_ground): ch 0 the sun straight through, 1 scattered down, 2 the
// sky's.
@kernel @cpu @grid(1)
fn k_ground_light(g: grid<1>, x: f64, y: f64, z: f64, w: f64, sx: f64, sy: f64, sz: f64, radius: f64,
                  seed: i32, detail_var: f32, ch: i32) -> f64 {
    let c = ground_light(f32v(x, y, z), w as f32, f32v(sx, sy, sz), radius as f32, seed, detail_var);
    if (ch == 1) {
        return c.y as f64;
    }
    if (ch == 2) {
        return c.z as f64;
    }
    return c.x as f64;
}
