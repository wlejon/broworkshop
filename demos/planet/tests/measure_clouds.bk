// Kernels for measuring the clouds (on the CPU): the column field and the
// ground's light at a direction, as the tile kernels compute a cell's.
from planet::clouds import column, ground_light;

fn f32v(x: f64, y: f64, z: f64) -> vec3<f32> {
    let d = normalize(vec3<f64>(x, y, z));
    return vec3<f32>(d.x as f32, d.y as f32, d.z as f32);
}

// The column's amount (ch 0) or unresolved variance (ch 1) at direction
// (x, y, z), resolved at a footprint of w metres. When `n == 1`, writes
// `[c.x, c.y]` to `out[0..1]`; when `n > 1` and `ch == 0`, counts how many of
// the `n x n` sub-footprints on the frame `(d; t, b)` have `c.x > 0.02`; when
// `n > 1` and `ch == 1`, writes all `n x n` `(c.x, c.y)` pairs to `out`.
@kernel @cpu @grid(1)
fn k_column(g: grid<1>, dx: f64, dy: f64, dz: f64, tx: f64, ty: f64, tz: f64, bx: f64, by: f64, bz: f64,
            n: i32, w: f64, radius: f64, ch: i32, out: write_store<f64, 1>) -> f64 {
    let nf = max(n, 1) as f64;
    let total = max(n * n, 1);
    let r = radius as f32;
    let w32 = w as f32;
    var cover: i32 = 0;
    var last_x: f64 = 0.0;
    var last_y: f64 = 0.0;
    var k: i32 = 0;
    while (k < total) {
        var qx = dx;
        var qy = dy;
        var qz = dz;
        if (n > 1) {
            let s = ((k % n) as f64 + 0.5) / nf - 0.5;
            let u = ((k / n) as f64 + 0.5) / nf - 0.5;
            qx = dx + tx * s + bx * u;
            qy = dy + ty * s + by * u;
            qz = dz + tz * s + bz * u;
        }
        let c = column(f32v(qx, qy, qz), w32, r);
        last_x = c.x as f64;
        last_y = c.y as f64;
        if (c.x > 0.02) { cover = cover + 1; }
        if (n == 1 || ch == 1) {
            let idx = k * 2;
            out[idx] = last_x;
            out[idx + 1] = last_y;
        }
        k = k + 1;
    }
    if (n > 1) { return cover as f64; }
    if (ch == 1) { return last_y; }
    return last_x;
}

// What the clouds leave of the ground's light there (clouds.bk
// k_cloud_ground): ch 0 the sun straight through, 1 scattered down, 2 the
// sky's. Also writes all three channels to `out[0..2]`.
@kernel @cpu @grid(1)
fn k_ground_light(g: grid<1>, x: f64, y: f64, z: f64, w: f64, sx: f64, sy: f64, sz: f64, radius: f64,
                  seed: i32, detail_var: f32, ch: i32, out: write_store<f64, 1>) -> f64 {
    let c = ground_light(f32v(x, y, z), w as f32, f32v(sx, sy, sz), radius as f32, seed, detail_var);
    out[0] = c.x as f64;
    out[1] = c.y as f64;
    out[2] = c.z as f64;
    if (ch == 1) {
        return c.y as f64;
    }
    if (ch == 2) {
        return c.z as f64;
    }
    return c.x as f64;
}
