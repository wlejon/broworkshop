// Kernels for measuring the ground (CPU eval): one cell as the tile kernels
// compute it, at (0, 0) of a frame (corner c, axes u, v), `cell` wide.
from planet::ground import cell_height, spread, expected_surface, gradient;

// The cell's height.
@kernel
fn k_cell(cx: f64, cy: f64, cz: f64, ux: f64, uy: f64, uz: f64, vx: f64, vy: f64, vz: f64,
          cell: f64, radius: f64, octaves: f64, seed: i32) -> f64 {
    return cell_height(vec3<f64>(cx, cy, cz), vec3<f64>(ux, uy, uz), vec3<f64>(vx, vy, vz),
                       0.0, 0.0, cell, radius, octaves, seed);
}

// The cell's surface point at (s, t) of the frame.
fn point(c: vec3<f64>, u: vec3<f64>, v: vec3<f64>, s: f64, t: f64, cell: f64,
         radius: f64, octaves: f64, seed: i32) -> vec3<f64> {
    let h = cell_height(c, u, v, s, t, cell, radius, octaves, seed);
    return normalize(c + u * s + v * t) * (radius + max(h, 0.0));
}

// The cell's colour as k_color computes it, its gradient from the
// neighbouring cells as k_color takes it from the position layer: `ch` 0
// its luminance, 1 how much is water. `naive` 1 drops the spreads, the
// colour of the cell's mean instead of the mean colour under it.
@kernel
fn k_cell_color(cx: f64, cy: f64, cz: f64, ux: f64, uy: f64, uz: f64, vx: f64, vy: f64, vz: f64,
                cell: f64, radius: f64, octaves: f64, truth: f32, seed: i32, ch: i32, naive: i32) -> f64 {
    let c = vec3<f64>(cx, cy, cz);
    let u = vec3<f64>(ux, uy, uz);
    let v = vec3<f64>(vx, vy, vz);
    let h = cell_height(c, u, v, 0.0, 0.0, cell, radius, octaves, seed);
    let o = point(c, u, v, 0.0, 0.0, cell, radius, octaves, seed);
    let du = point(c, u, v, cell, 0.0, cell, radius, octaves, seed) - point(c, u, v, -cell, 0.0, cell, radius, octaves, seed);
    let dv = point(c, u, v, 0.0, cell, cell, radius, octaves, seed) - point(c, u, v, 0.0, -cell, cell, radius, octaves, seed);
    let up = normalize(o);
    let grad = gradient(vec3<f32>(du.x as f32, du.y as f32, du.z as f32),
                        vec3<f32>(dv.x as f32, dv.y as f32, dv.z as f32),
                        vec3<f32>(up.x as f32, up.y as f32, up.z as f32));
    var sp = spread(normalize(c), radius, octaves, truth, seed);
    if (naive == 1) { sp = vec2<f32>(0.0, 0.0); }
    let e = expected_surface(h as f32, grad, sp.x, sp.y);
    if (ch == 0) { return (e.x * 0.2126 + e.y * 0.7152 + e.z * 0.0722) as f64; }
    return e.w as f64;
}
