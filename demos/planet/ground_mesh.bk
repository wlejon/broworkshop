// The ground's mesh hook (app.js): each instance a tile of the cache, its
// vertices the tile's cells, shaded with the detail layer's colour and
// normal and the light its vertex sees.
//
// The light the ground sees at a vertex (the vertex shader; the fragment
// interpolates it): what it sees changes over metres to kilometres and its
// vertices stand a few pixels apart (a tile's cells, DETAIL texels: 8 px at
// the default Detail), so at the vertices it costs a small share of what
// every pixel did, the same to the eye. light: x the sun's share seen (its disc over the horizons, under the
// clouds and the drawn trees), y the sky's (GTAO over the horizons, under
// the clouds), z the clouds' shadow, which the slopes around share, w the
// sun the clouds scatter down shadowless (clouds.bk cloud_light's y); bent:
// how the sky's mean direction turns from the normal n.
//
// The horizons, read bilinearly at the horizon grid's point hz of tile
// `slot` (planet.bk's horizon layer, a point every other cell), with the
// grid's axes tu, tv. The sun: the share of its disc (0.53 degrees) above
// the horizon toward it. The sky: GTAO's cosine-weighted visibility
// (Jimenez et al. 2016) over four slices through the up axis, each bounded
// by the horizons on its two sides and taken about the normal's projection
// on it, and the mean direction of the sky seen. The clouds' shadow
// (clouds.js) at a footprint of w metres, and the sky they hide overhead:
// under a deck the blue sky is gone and the light is the grey the deck
// scatters down. Among drawn trees, their shadows (tree_crown.bk).
module hook;
import scene;
import mesh;
import lighting;
import custom;
import tiles;
from planet::ground_layout import CELLS, BORDER, TILE, DETAIL, TEXELS, HZ, FACE_EXTENT, DETAIL_PERIOD, SWELL_PERIOD,
    SEED, GL_TILE, GL_BORDER, GL_ATLAS, GL_LEVELS, WAVE_COUNT, WAVE_SWELL, WAVE_FRESH, WAVE_RESIDUAL,
    WAVE_FRESH_SCALE, WAVE_K, WAVE_F;
from planet::relief import BASE_WAVELENGTH, RIDGE_LAST, RIDGE_PAST, FINE_FIRST, ridge_amp, span_at, mean_factor,
    ridge_cell_slope, simplex_grad, simplex_past, simplex_twice, SimplexAt, kept_share;
from planet::tree_crown import tree_shadow, TreePlace;
from planet::grass_floor import grass_floor, GrassPlace;

struct Params {
    cam_hi: vec3<f32>,
    cam_lo: vec3<f32>,
    to_sun: vec3<f32>,
    time: f32,
    trees_far: f32,
    cloud_w0: f32,
    grass_a: vec3<f32>,
    grass_e: vec3<f32>,
    grass_f: vec3<f32>,
    grass_uv: vec3<f32>,
    tree_o_hi: vec3<f32>,
    tree_o_lo: vec3<f32>,
    tree_lattice: vec3<f32>,
    tree_a: vec3<f32>,
    tree_e: vec3<f32>,
    tree_f: vec3<f32>,
    tree_uv: vec3<f32>,
}
@binding(4, 0) var params: uniform<Params>;
@binding(4, 1) var pos: texture2d_array<vec4<f32>>;
@binding(4, 2) var cloud_ground: texture2d_array<vec4<f32>>;
@binding(4, 14) var tiles: read_buffer<vec4<i32>>;
@binding(4, 15) var det: read_buffer<u32>;
@binding(4, 16) var hz: read_buffer<vec4<u32>>;
@binding(4, 19) var cloud_lookup: read_buffer<vec4<i32>>;
// Each tile's relief anchors (planet.bk k_anchor), and each cell's offset in
// the relief's noise and its scales (planet.bk k_tile).
@binding(4, 20) var anchors: read_buffer<vec4<i32>>;
@binding(4, 21) var relief: read_buffer<vec4<f32>>;
const ANCHOR_VEC4S: i32 = 6;

const GROUND_PI: f32 = 3.14159265;
const TREE_CROWNS: f32 = 0.7;
const CANOPY: vec3<f32> = vec3<f32>(0.026, 0.052, 0.019);
const CROWN_FIRST: f32 = 4.0;     // the crowns' texture's octaves (m), and per octave
const CROWN_LAST: f32 = 16.0;
const CROWN_LUM: f32 = 0.8;       // its log-luminance and its slope per unit of the noise's gradient
const CROWN_RELIEF: f32 = 0.5;
const VARY_LUM: f32 = 0.11;      // ground.bk VARY_LUM
const PERLIN_VAR: f32 = 0.0728;  // ground.bk PERLIN_VAR
const RELIEF: f32 = 0.08;        // slope per octave, per unit of the noise's gradient
const ROCK_LUM: f32 = 1.8;
const ROCK_RELIEF: f32 = 3.0;
const FLOOR_LAST: f32 = 8.0;    // the floor's own relief's longest wavelength (m)
const FLOOR_RELIEF: f32 = 0.2;   // its slope per octave, per unit of the noise's gradient
// The forest's floor: needle and leaf litter, mossy in its hollows, over
// LITTER of the ground under the trees.
const LITTER: f32 = 0.8;
const NEEDLES: vec3<f32> = vec3<f32>(0.070, 0.047, 0.026);
const MOSS: vec3<f32> = vec3<f32>(0.030, 0.055, 0.016);
const FRESH_GLOSS: f32 = 0.35;   // fresh water's roughness, of its ripples'
// A river's lanes along its current: STREAK_W metres across, STREAK_LEN
// between the samples averaged along it, how much they gather and calm the
// ripples (STREAK_RIPPLE) and tilt the surface (slope per unit of the
// noise's gradient).
const STREAK_W: f32 = 6.0;
const STREAK_LEN: f32 = 6.0;
const STREAK_RIPPLE: f32 = 1.6;
const STREAK_SLOPE: f32 = 0.02;
// Clouds low in a reflection: their sunlit sides, of the sun's light on the
// ground; the reflection where the horizons hide the sky: the banks' shade.
const CLOUD_SIDES: f32 = 0.55;
const BANK_SHADE: f32 = 0.35;
// What the clouds leave of the light at the ground point g (about the
// planet's centre) over a footprint of w metres, from clouds.js's ground
// light cache (clouds.bk k_cloud_ground): the sun straight through (x),
// scattered down (y), and the sky's (z). Between the two tile levels whose
// cells bracket w, as mips blend, each the finest ready tile holding g at
// that level or coarser; clear sky before any is ready.
fn cloud_ground_at(t: tiles::Tile, p: tiles::Point) -> vec3<f32> {
    return cloud_ground.sample_lod(custom::linear, tiles::atlas_uvw(t, p, GL_TILE, GL_BORDER, GL_ATLAS), 0.0).xyz;
}
fn cloud_light_at(g: vec3<f32>, w: f32) -> vec3<f32> {
    let p = tiles::cube_point(normalize(g));
    let uv = vec2<f32>(p.u, p.v) * 2.0 - 1.0;
    let stretch = sqrt(1.0 + max(uv.x * uv.x, uv.y * uv.y)) / (1.0 + dot(uv, uv));
    let l = tiles::level_for(w, params.cloud_w0 * stretch, GL_LEVELS);
    let k = min(l as i32, GL_LEVELS - 1);
    let fine = tiles::locate(cloud_lookup, p, k + 1);
    if (fine.slot < 0) {
        return vec3<f32>(1.0, 0.0, 1.0);
    }
    var c: vec3<f32> = cloud_ground_at(fine, p);
    if (fine.level == k + 1) {
        var coarse: tiles::Tile = tiles::parent_of(fine);
        if (coarse.slot < 0) {
            coarse = tiles::locate(cloud_lookup, p, k);
        }
        if (coarse.slot >= 0) {
            c = mix(cloud_ground_at(coarse, p), c, l - (k as f32));
        }
    }
    return c;
}

fn vec4_at(v: vec4<f32>, i: i32) -> f32 {
    return i == 0 ? v.x : (i == 1 ? v.y : (i == 2 ? v.z : v.w));
}

fn pos_at(slot: i32, x: i32, y: i32) -> vec4<f32> {
    let cell = slot & 3;
    return pos.fetch(vec3<i32>((cell & 1) * CELLS + x, (cell >> 1) * CELLS + y, slot >> 2), 0);
}

// Point p of tile slot's horizon grid: the sines of its horizon's
// elevation along the grid's 8 directions. Directions 0-3 in lo, 4-7 in
// hi: its four words are one 16-byte load.
struct Horizon {
    lo: vec4<f32>,
    hi: vec4<f32>,
}
fn horizon_point(slot: i32, p_in: vec2<i32>) -> Horizon {
    let p = clamp(p_in, vec2<i32>(0), vec2<i32>(HZ - 1));
    let w = hz[((slot * HZ + p.y) * HZ + p.x) * 4];
    let lo = vec4<f32>(unpack_unorm2x16(w.x), unpack_unorm2x16(w.y)) * 2.0 - vec4<f32>(1.0);
    let hi = vec4<f32>(unpack_unorm2x16(w.z), unpack_unorm2x16(w.w)) * 2.0 - vec4<f32>(1.0);
    return Horizon { lo: lo, hi: hi };
}
fn horizon_at(h: Horizon, k: i32) -> f32 {
    return k < 4 ? vec4_at(h.lo, k) : vec4_at(h.hi, k - 4);
}

// acos to 7e-5 rad (Abramowitz and Stegun 4.4.45).
fn fast_acos(x: f32) -> f32 {
    let a = abs(x);
    let r = sqrt(max(1.0 - a, 0.0)) * (1.5707288 + a * (-0.2121144 + a * (0.0742610 - 0.0187293 * a)));
    return x < 0.0 ? GROUND_PI - r : r;
}

struct GroundLight {
    light: vec4<f32>,
    bent: vec3<f32>,
    open: f32,   // the sky's share the clouds leave (cloud_light_at's z)
}
fn ground_light(slot: i32, hz_coord: vec2<f32>, tu: vec3<f32>, tv: vec3<f32>, up: vec3<f32>,
                n: vec3<f32>, rel: vec3<f32>, w: f32) -> GroundLight {
    let to_sun = params.to_sun;
    let fl = floor(hz_coord);
    let f = hz_coord - fl;
    let p = vec2<i32>(fl.x as i32, fl.y as i32);
    let ha = horizon_point(slot, p);
    let hb = horizon_point(slot, p + vec2<i32>(1, 0));
    let hc = horizon_point(slot, p + vec2<i32>(0, 1));
    let hd = horizon_point(slot, p + vec2<i32>(1, 1));
    let sl = clamp(mix(mix(ha.lo, hb.lo, f.x), mix(hc.lo, hd.lo, f.x), f.y), vec4<f32>(-1.0), vec4<f32>(1.0));
    let sh = clamp(mix(mix(ha.hi, hb.hi, f.x), mix(hc.hi, hd.hi, f.x), f.y), vec4<f32>(-1.0), vec4<f32>(1.0));
    // The grid's axes on the tangent plane: direction k is
    // cos * gu + sin * gv. The sun's azimuth is taken in those axes.
    let gu = tu - up * dot(tu, up);
    let gv = tv - up * dot(tv, up);
    let uu = dot(gu, gu);
    let uv = dot(gu, gv);
    let vv = dot(gv, gv);
    let su = dot(to_sun, gu);
    let sv = dot(to_sun, gv);
    let fk = mod(atan2(uu * sv - uv * su, vv * su - uv * sv) / (GROUND_PI * 0.25), 8.0);
    let k0 = (fk as i32) & 7;
    // Each point's share of the disc, blended: across a ridge's horizon
    // jump, blended horizons would step from point to point.
    let k1 = (k0 + 1) & 7;
    let fa = fk - floor(fk);
    // In sines, not angles: across the disc an elevation's step is its
    // sine's over the cosine.
    let sun = clamp(dot(to_sun, up), -1.0, 1.0);
    let corner = vec4<f32>(
        mix(horizon_at(ha, k0), horizon_at(ha, k1), fa),
        mix(horizon_at(hb, k0), horizon_at(hb, k1), fa),
        mix(horizon_at(hc, k0), horizon_at(hc, k1), fa),
        mix(horizon_at(hd, k0), horizon_at(hd, k1), fa),
    );
    let lit = clamp((vec4<f32>(sun) - corner) / (0.0093 * max(sqrt(1.0 - sun * sun), 0.02)) + vec4<f32>(0.5), vec4<f32>(0.0), vec4<f32>(1.0));
    var sun_seen = mix(mix(lit.x, lit.y, f.x), mix(lit.z, lit.w, f.x), f.y);

    var visible: f32 = 0.0;
    var mean = vec3<f32>(0.0);
    // Without trigonometry: the horizons are kept as the cosines of their
    // zenith angles (the sines of their elevations, as stored), clamped
    // to the normal's hemisphere there as a max of cosines, and each
    // angle's double-angle terms are taken from its cosine and sine.
    for (var s: i32 = 0; s < 4; s += 1) {
        let az = s == 0 ? vec2<f32>(1.0, 0.0) : (s == 1 ? vec2<f32>(0.70710678, 0.70710678) : (s == 2 ? vec2<f32>(0.0, 1.0) : vec2<f32>(-0.70710678, 0.70710678)));
        let t = normalize(gu * az.x + gv * az.y);
        let across = cross(up, t);
        let np = n - across * dot(n, across);
        let len = length(np);
        let il = 1.0 / max(len, 1e-6);
        let cg = dot(np, up) * il;
        let sg = dot(np, t) * il;   // cos, sin of the normal's angle gamma
        // The horizons' zenith angles toward +t (h2) and -t (h1), no
        // further than 90 degrees from the normal: cosines c2, c1.
        let c2 = max(vec4_at(sl, s), -sg);
        let c1 = max(vec4_at(sh, s), sg);
        let h2 = fast_acos(c2);
        let h1 = -fast_acos(c1);
        let s2 = sqrt(max(1.0 - c2 * c2, 0.0));
        let s1 = -sqrt(max(1.0 - c1 * c1, 0.0));
        // cos(2h - gamma) = cos 2h cos gamma + sin 2h sin gamma.
        let k2 = (2.0 * c2 * c2 - 1.0) * cg + 2.0 * s2 * c2 * sg;
        let k1 = (2.0 * c1 * c1 - 1.0) * cg + 2.0 * s1 * c1 * sg;
        let slice = 0.25 * (-k1 + cg + 2.0 * h1 * sg) + 0.25 * (-k2 + cg + 2.0 * h2 * sg);
        visible += len * slice;
        // The direction halfway between the horizons: the perpendicular
        // of their difference, which holds when they are over 180 apart.
        let b = vec2<f32>(c1 - c2, s2 - s1);
        let bl2 = dot(b, b);
        if (bl2 > 1e-12) {
            mean += (t * b.x + up * b.y) * (len * slice * inversesqrt(bl2));
        }
    }
    let bent = dot(mean, mean) > 1e-12 ? normalize(mean) - n : vec3<f32>(0.0);

    let sky = cloud_light_at((params.cam_hi + params.cam_lo) + rel, w);
    sun_seen *= sky.x;
    if (params.trees_far > 0.0 && length(rel) < params.trees_far) {
        let eye = (params.cam_hi - params.tree_o_hi) + (params.cam_lo - params.tree_o_lo);
        let place = TreePlace {
            o_hi: params.tree_o_hi, o_lo: params.tree_o_lo, lattice: params.tree_lattice,
            a: params.tree_a, e: params.tree_e, f: params.tree_f, uv: params.tree_uv,
        };
        sun_seen *= tree_shadow(place, eye + rel, eye, up, to_sun);
    }
    return GroundLight { light: vec4<f32>(sun_seen, visible * 0.25 * sky.z, sky.x, sky.y), bent: bent, open: sky.z };
}

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    let inst = v.instance_index;
    let ids = tiles[inst * 4];   // slot, parentSlot, root, level
    let hi = bitcast<vec4<f32>>(tiles[inst * 4 + 2]);
    let lo = bitcast<vec4<f32>>(tiles[inst * 4 + 3]);
    let i = (v.pos.x + 0.5) as i32;
    let j = (v.pos.z + 0.5) as i32;
    let slot = ids.x;
    let cx = i + BORDER;
    let cy = j + BORDER;
    let c0 = pos_at(slot, cx, cy);
    var c_xyz = c0.xyz;
    let c_w = c0.w;
    // The vertex in the detail layer's texels (planet.bk): texel t is
    // centred at cell (t + 0.5) / D - 0.5.
    let v_tex = (vec2<f32>(cx as f32, cy as f32) + vec2<f32>(0.5)) * (DETAIL as f32) - vec2<f32>(0.5);
    let v_skirt = v.pos.y;
    // The tile grid's axes, which the horizons' directions are measured
    // along, and the surface's normal across them.
    let tu = pos_at(slot, cx + 1, cy).xyz - pos_at(slot, cx - 1, cy).xyz;
    let tv = pos_at(slot, cx, cy + 1).xyz - pos_at(slot, cx, cy - 1).xyz;
    // A skirt's bottom sits under the border cell beyond the edge, so the
    // skirts of neighbouring tiles cross beneath their seam instead of
    // sharing a plane: f32 rounding differs tile to tile, and coplanar
    // skirts leave pinholes along the seam and at corners.
    if (v.pos.y > 0.5) {
        let si = i == 0 ? -1 : (i == TILE ? 1 : 0);
        let sj = j == 0 ? -1 : (j == TILE ? 1 : 0);
        c_xyz = pos_at(slot, cx + si, cy + sj).xyz;
    }
    // Up at this vertex: away from the planet's center at the origin.
    let up = normalize(c_xyz + hi.xyz);
    // Skirts hang a sixteenth of the tile's edge below the surface.
    let extent = FACE_EXTENT / ((1 << ids.w) as f32);
    let rel = (hi.xyz - params.cam_hi) + (lo.xyz - params.cam_lo);
    v.pos = rel + c_xyz - up * (v.pos.y * extent * 0.0625);
    v.normal = up;   // the fragment shades with the detail layer's normal
    // The ground's fine detail is periodic over DETAIL_PERIOD metres: the
    // tile's center modulo that (exact in f32, the period a power of two)
    // plus the cell's offset from it is a coordinate good to micrometres
    // near the camera, and the same modulo the period on every tile.
    let v_q = mod(hi.xyz, DETAIL_PERIOD) + mod(lo.xyz, DETAIL_PERIOD) + c_xyz;
    let v_swell = mod(hi.xyz, SWELL_PERIOD) + mod(lo.xyz, SWELL_PERIOD) + c_xyz;
    // The light it sees, on the horizon layer's grid (a point every
    // other cell), at a cell's footprint.
    var n = normalize(cross(tu, tv));
    if (dot(n, up) < 0.0) { n = -n; }
    let gl = ground_light(slot, vec2<f32>(cx as f32, cy as f32) * 0.5, tu, tv, up, n, v.pos, 0.5 * length(tu));
    // Where the vertex is in the relief's noise from the tile's centre,
    // through the warp, and how much the ground here moves with the
    // relief's octaves below FINE_FIRST, from it on, and the octaves the
    // drainage keeps whole (relief.bk kept_share; planet.bk k_tile).
    let rl = relief[(slot * CELLS + cy) * CELLS + cx];
    let dq = rl.xyz;
    let rs = bitcast<u32>(rl.w);
    v.uv = vec2<f32>((rs & 2047u) as f32, ((rs >> 11u) & 2047u) as f32) * (1.5 / 2047.0) - vec2<f32>(0.5);
    let kept = ((rs >> 22u) as f32) * (1.5 / 1023.0) - 0.5;
    // z: the clouds' open sky, which the water's mirror needs apart from the
    // horizons', less 2 on a skirt's bottom.
    v.v0 = vec4<f32>(v_tex, clamp(gl.open, 0.0, 1.0) - 2.0 * v_skirt, c_w);
    v.v1 = vec4<f32>(up, dq.x);
    v.v2 = vec4<f32>(v_q, dq.y);
    v.v3 = vec4<f32>(v_swell, dq.z);
    v.v4 = gl.light;
    v.v5 = vec4<f32>(gl.bent, kept);
    v.vi = vec4<i32>(slot, ids.w, 0, 0);
    return v;
}

// Texel (x, y) of this tile: colour (rgb, water), the octahedral normal
// unfolded and the forest's cover.
struct DetailTexel {
    col: vec4<f32>,
    nrm: vec3<f32>,
    cover: f32,
}
fn detail_texel(slot: i32, t_in: vec2<i32>) -> DetailTexel {
    let t = clamp(t_in, vec2<i32>(0), vec2<i32>(TEXELS - 1));
    let k = ((slot * TEXELS + t.y) * TEXELS + t.x) * 2;
    // The colour is stored square-rooted (planet.bk k_detail).
    let raw = unpack_unorm4x8(det[k]);
    let col = vec4<f32>(raw.xyz * raw.xyz, raw.w);
    let w = det[k + 1];
    let ox = ((w & 4095u) as f32) * (2.0 / 4095.0) - 1.0;
    let oy = (((w >> 12u) & 4095u) as f32) * (2.0 / 4095.0) - 1.0;
    let cover = ((w >> 24u) as f32) / 255.0;
    let nz = 1.0 - abs(ox) - abs(oy);
    let nx = nz < 0.0 ? (1.0 - abs(oy)) * (ox >= 0.0 ? 1.0 : -1.0) : ox;
    let ny = nz < 0.0 ? (1.0 - abs(ox)) * (oy >= 0.0 ? 1.0 : -1.0) : oy;
    return DetailTexel { col: col, nrm: normalize(vec3<f32>(nx, ny, nz)), cover: cover };
}
// Texel t's share of water alone.
fn detail_water(slot: i32, t_in: vec2<i32>) -> f32 {
    let t = clamp(t_in, vec2<i32>(0), vec2<i32>(TEXELS - 1));
    return ((det[((slot * TEXELS + t.y) * TEXELS + t.x) * 2] >> 24u) as f32) / 255.0;
}
// A uniform cubic B-spline's four weights at fraction f past the second.
fn bspline(f: f32) -> vec4<f32> {
    let g = 1.0 - f;
    let f2 = f * f;
    let f3 = f2 * f;
    return vec4<f32>(g * g * g, 3.0 * f3 - 6.0 * f2 + 4.0, -3.0 * f3 + 3.0 * f2 + 3.0 * f + 1.0, f3) / 6.0;
}

// One of the 12 cube-edge gradients at lattice point c, the lattice
// periodic over cells (a power of two).
fn lattice_gradient(c: vec3<i32>, cells: i32, seed: i32) -> vec3<f32> {
    let m = c & vec3<i32>(cells - 1);
    let px = m.x as u32;
    let py = m.y as u32;
    let pz = m.z as u32;
    var h = (px * 0x8da6b343u ^ py * 0xd8163841u ^ pz * 0xcb1ab31fu ^ (seed as u32)) * 0x27d4eb2du;
    h = h ^ (h >> 15u);
    let e = h % 12u;
    let s1 = (e & 1u) != 0u ? -1.0 : 1.0;
    let s2 = (e & 2u) != 0u ? -1.0 : 1.0;
    let axis = e >> 2u;
    return axis == 0u ? vec3<f32>(0.0, s1, s2) : (axis == 1u ? vec3<f32>(s1, 0.0, s2) : vec3<f32>(s1, s2, 0.0));
}

// Perlin noise at x (lattice units) and its gradient: x value, yzw gradient.
fn perlin_grad(x: vec3<f32>, cells: i32, seed: i32) -> vec4<f32> {
    let fl = floor(x);
    let i = vec3<i32>(fl.x as i32, fl.y as i32, fl.z as i32);
    let f = fract(x);
    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    let ga = lattice_gradient(i, cells, seed);
    let gb = lattice_gradient(i + vec3<i32>(1, 0, 0), cells, seed);
    let gc = lattice_gradient(i + vec3<i32>(0, 1, 0), cells, seed);
    let gd = lattice_gradient(i + vec3<i32>(1, 1, 0), cells, seed);
    let ge = lattice_gradient(i + vec3<i32>(0, 0, 1), cells, seed);
    let gf = lattice_gradient(i + vec3<i32>(1, 0, 1), cells, seed);
    let gg = lattice_gradient(i + vec3<i32>(0, 1, 1), cells, seed);
    let gh = lattice_gradient(i + vec3<i32>(1, 1, 1), cells, seed);
    let va = dot(ga, f);
    let vb = dot(gb, f - vec3<f32>(1.0, 0.0, 0.0));
    let vc = dot(gc, f - vec3<f32>(0.0, 1.0, 0.0));
    let vd = dot(gd, f - vec3<f32>(1.0, 1.0, 0.0));
    let ve = dot(ge, f - vec3<f32>(0.0, 0.0, 1.0));
    let vf = dot(gf, f - vec3<f32>(1.0, 0.0, 1.0));
    let vg = dot(gg, f - vec3<f32>(0.0, 1.0, 1.0));
    let vh = dot(gh, f - vec3<f32>(1.0, 1.0, 1.0));
    let k1 = vb - va;
    let k2 = vc - va;
    let k3 = ve - va;
    let k4 = va - vb - vc + vd;
    let k5 = va - vc - ve + vg;
    let k6 = va - vb - ve + vf;
    let k7 = -va + vb + vc - vd + ve - vf - vg + vh;
    let value = va + u.x * k1 + u.y * k2 + u.z * k3 + u.x * u.y * k4 + u.y * u.z * k5 + u.z * u.x * k6 + u.x * u.y * u.z * k7;
    let grad = ga + u.x * (gb - ga) + u.y * (gc - ga) + u.z * (ge - ga)
             + u.x * u.y * (ga - gb - gc + gd) + u.y * u.z * (ga - gc - ge + gg) + u.z * u.x * (ga - gb - ge + gf)
             + u.x * u.y * u.z * (-ga + gb + gc - gd + ge - gf - gg + gh)
             + du * (vec3<f32>(k1, k2, k3) + u.yzx * vec3<f32>(k4, k5, k6) + u.zxy * vec3<f32>(k6, k4, k5) + u.yzx * u.zxy * k7);
    return vec4<f32>(value, grad);
}

// Bare rock in its beds at a point (metres about the planet's centre), as
// ground.bk bedded_surface lays it with strata: three scales of bed level
// along a surface folded by low-frequency noise, in log-luminance, each
// fading as the pixel's footprint spans it.
// A bed is a function of height alone: gradient noise along one axis, its
// gradients hashed from the lattice point (its variance is 0.0194; scaled to
// about 0.7 of a unit, as its even bands read stronger than 3D noise's).
fn bed_slope(i: f32, seed: i32) -> f32 {
    var h: u32 = ((i as i32) as u32) * 0x27d4eb2du ^ (seed as u32) * 0x165667b1u;
    h = (h ^ (h >> 15u)) * 0x85ebca6bu;
    h = h ^ (h >> 13u);
    return ((h & 65535u) as f32) / 32767.5 - 1.0;
}
fn cliff_band(level: f32, length: f32, footprint: f32, seed: i32) -> f32 {
    let x = level / length;
    let i = floor(x);
    let f = x - i;
    let s = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let n = mix(bed_slope(i, seed) * f, bed_slope(i + 1.0, seed) * (f - 1.0), s);
    let t = 6.2831853 * footprint / length;
    return n * 5.0 * exp(-0.5 * t * t);
}
// The region's stone at detail texel coordinate `tex` of tile `slot`: the
// four corners k_anchor stored (planet.bk), bilinear over the tile.
fn region_rock(slot: i32, tex: vec2<f32>) -> vec3<f32> {
    let w = bitcast<vec4<u32>>(anchors[slot * ANCHOR_VEC4S + 5]);
    let st = clamp(((tex + vec2<f32>(0.5)) / (DETAIL as f32) - vec2<f32>(0.5 + (BORDER as f32))) / (TILE as f32),
                   vec2<f32>(0.0), vec2<f32>(1.0));
    let r = mix(mix(unpack_unorm4x8(w.x).xyz, unpack_unorm4x8(w.y).xyz, st.x),
                mix(unpack_unorm4x8(w.z).xyz, unpack_unorm4x8(w.w).xyz, st.x), st.y);
    return r * r;
}
// The beds are not ruled lines: they buckle by a few metres over tens
// (CLIFF_BUCKLE, at CLIFF_FOLD metres), and how strongly they show comes and
// goes across the face, so a wall reads as layered stone, weathered in
// places to one tone, rather than as even stripes. One noise for both (its
// value and one component of its gradient, a field of its own), from
// `swell`, the vertices' periodic position: p's f32 is half a metre at the
// planet's radius.
const CLIFF_FOLD: f32 = 64.0;
const CLIFF_BUCKLE: f32 = 8.0;
fn cliff_rock(p: vec3<f32>, swell: vec3<f32>, footprint: f32, stone: vec3<f32>) -> vec3<f32> {
    let h = length(p) - FACE_EXTENT * 0.63661977;   // FACE_EXTENT is a quarter of the circumference
    let fold = perlin_grad(swell / CLIFF_FOLD, (SWELL_PERIOD / CLIFF_FOLD) as i32, SEED + 331);
    let level = h + perlin_grad(p * (1.0 / 3500.0), 4096, SEED + 307).x * 1600.0 + fold.x * CLIFF_BUCKLE;
    let shows = clamp(0.75 + 0.6 * (fold.y + fold.z), 0.15, 1.3);
    let bed = (0.10 * cliff_band(level, 9.0, footprint, SEED + 311)
             + 0.16 * cliff_band(level, 41.0, footprint, SEED + 313)
             + 0.18 * cliff_band(level, 130.0, footprint, SEED + 317)) * shows;
    // The region's stone (climate.bk, region_rock), as ground.bk
    // bedded_surface lays it.
    return stone * exp(bed) + vec3<f32>(0.03, 0.012, -0.012) * bed;
}

// Gradient noise in 2D (lattice units, periodic over `cells`, a power of
// two) and its gradient: x value, yz gradient. Half the 3D noise's corners,
// for relief that lies along the ground.
fn lattice_gradient2(c: vec2<i32>, cells: i32, seed: i32) -> vec2<f32> {
    let m = c & vec2<i32>(cells - 1);
    var h = ((m.x as u32) * 0x8da6b343u ^ (m.y as u32) * 0xd8163841u ^ (seed as u32)) * 0x27d4eb2du;
    h = h ^ (h >> 15u);
    let a = ((h >> 29u) as f32) * 0.78539816;
    return vec2<f32>(cos(a), sin(a));
}
fn perlin2_grad(x: vec2<f32>, cells: i32, seed: i32) -> vec3<f32> {
    let fl = floor(x);
    let i = vec2<i32>(fl.x as i32, fl.y as i32);
    let f = x - fl;
    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    let ga = lattice_gradient2(i, cells, seed);
    let gb = lattice_gradient2(i + vec2<i32>(1, 0), cells, seed);
    let gc = lattice_gradient2(i + vec2<i32>(0, 1), cells, seed);
    let gd = lattice_gradient2(i + vec2<i32>(1, 1), cells, seed);
    let va = dot(ga, f);
    let vb = dot(gb, f - vec2<f32>(1.0, 0.0));
    let vc = dot(gc, f - vec2<f32>(0.0, 1.0));
    let vd = dot(gd, f - vec2<f32>(1.0, 1.0));
    let k4 = va - vb - vc + vd;
    let value = va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * k4;
    let grad = ga + u.x * (gb - ga) + u.y * (gc - ga) + u.x * u.y * (ga - gb - gc + gd)
             + du * (vec2<f32>(vb - va, vc - va) + u.yx * k4);
    return vec3<f32>(value, grad);
}
// The floor's relief (fragment) in the plane of the two axes the ground's
// up is furthest from, its coordinates the vertices' periodic positions as
// they are (swell past a metre, q under): x its height in noise units, yzw
// its gradient (per unit of the noise's lattice). In the octaves at 8, 2
// and 0.5 m, each fading as a pixel spans it. Where two axes are about
// equally far from up (a band along the cube's diagonal planes) the two
// planes' blend, so the pattern changes there without a seam.
fn floor_plane(p: vec3<f32>, axis: i32) -> vec2<f32> {
    return axis == 0 ? p.yz : (axis == 1 ? p.zx : p.xy);
}
fn floor_axes(axis: i32, g: vec2<f32>) -> vec3<f32> {
    return axis == 0 ? vec3<f32>(0.0, g.x, g.y) : (axis == 1 ? vec3<f32>(g.y, 0.0, g.x) : vec3<f32>(g.x, g.y, 0.0));
}
fn floor_octaves(swell: vec3<f32>, q: vec3<f32>, axis: i32, footprint: f32) -> vec4<f32> {
    var out = vec4<f32>(0.0);
    var wl = FLOOR_LAST;
    for (var k: i32 = 0; k < 3; k += 1) {
        let w = clamp(wl / footprint * 0.5 - 1.0, 0.0, 1.0);
        if (w <= 0.0) { break; }
        let far = wl >= 1.0;
        let pg = perlin2_grad(floor_plane(far ? swell : q, axis) / wl, ((far ? SWELL_PERIOD : DETAIL_PERIOD) / wl) as i32, 61 + k);
        out += vec4<f32>(pg.x, floor_axes(axis, pg.yz)) * w;
        wl *= 0.25;
    }
    return out;
}
fn floor_noise(swell: vec3<f32>, q: vec3<f32>, up: vec3<f32>, footprint: f32) -> vec4<f32> {
    let a = abs(up);
    let first = a.x >= a.y && a.x >= a.z ? 0 : (a.y >= a.z ? 1 : 2);
    let top = max(a.x, max(a.y, a.z));
    let next = first == 0 ? max(a.y, a.z) : (first == 1 ? max(a.x, a.z) : max(a.x, a.y));
    let second = first == 0 ? (a.y >= a.z ? 1 : 2) : (first == 1 ? (a.x >= a.z ? 0 : 2) : (a.x >= a.y ? 0 : 1));
    let blend = 0.5 * (1.0 - smoothstep(0.0, 0.03, top - next));
    var r = floor_octaves(swell, q, first, footprint);
    if (blend > 0.0) { r = mix(r, floor_octaves(swell, q, second, footprint), blend); }
    return r;
}

struct SeaResult {
    slope: vec3<f32>,
    variance: f32,
}
fn sea_slope(footprint: f32, up: vec3<f32>, v_swell: vec3<f32>, v_q: vec3<f32>, first: i32) -> SeaResult {
    var slope = vec3<f32>(0.0);
    var variance: f32 = WAVE_RESIDUAL;
    for (var i: i32 = first; i < WAVE_COUNT; i += 1) {
        let k = WAVE_K[i];
        let f = WAVE_F[i];
        let w = clamp(k.w / footprint - 1.0, 0.0, 1.0);
        if (w <= 0.0) {
            variance += f.y;
            break;
        }
        let q = i < WAVE_SWELL ? v_swell : v_q;
        slope += k.xyz * (f.z * w * cos(dot(k.xyz, q) - f.x * params.time));
        variance += f.w * (1.0 - w);
    }
    return SeaResult { slope: slope - up * dot(slope, up), variance: variance };
}

pub fn fragment(v: mesh::Vertex, s_in: mesh::Surface) -> mesh::Surface {
    var s = s_in;
    let v_tex = v.v0.xy;
    let v_skirt = v.v0.z < -0.5 ? 1.0 : 0.0;
    let v_open = clamp(v.v0.z, 0.0, 1.0);
    let v_height = v.v0.w;
    let v_up = v.v1.xyz;
    let v_q = v.v2.xyz;
    let v_swell = v.v3.xyz;
    let v_light = v.v4;
    let v_bent = v.v5.xyz;
    let v_slot = v.vi.x;
    let v_level = v.vi.y;
    let footprint = max(length(dpdx(v_q)), length(dpdy(v_q)));

    // The mountains' ridged octaves finer than the tile's texels, as the
    // truth has them (ground.bk relief), to what this pixel resolves (full
    // weight from 4 pixels a wavelength, none at 2, as the detail below):
    // each octave's slope at the pixel's mean factor less what the texel's
    // normal already holds, its slope at the texel's mean factor through
    // the central difference over two texels it is taken by (sinc(2 pi
    // span), ground.bk gradient_share). The same noise, from the
    // tile's anchor (planet.bk k_anchor), each octave's lattice twice the
    // last's, at the vertices' offset through the warp, scaled by how much
    // the ground here moves with them (v.uv), the gradient taken through
    // the warp's stretch. First, while little else is live: the noise
    // needs registers.
    let a = v_slot * ANCHOR_VEC4S;
    let a0 = anchors[a];
    let oct_pix = log2(BASE_WAVELENGTH / (2.5 * max(footprint, 1e-4)));
    // The octave whose wavelength is two pixels.
    let o_nyquist = log2(BASE_WAVELENGTH / (2.0 * max(footprint, 1e-4)));
    let o_end = min(ceil(o_nyquist) as i32, RIDGE_LAST);
    var ridges = vec3<f32>(0.0);
    if (max(max(abs(v.uv.x), abs(v.uv.y)), abs(v.v5.w)) > 0.002 && a0.w < o_end) {
        let a1 = anchors[a + 1];
        let oct_tex = bitcast<f32>(a1.w);
        // (Its cell is about the tile's texels: what sk lost is nothing.)
        var at = SimplexAt { cell: a0.xyz, sk: bitcast<vec4<f32>>(a1).xyz, res: vec3<f32>(0.0) };
        let dq = vec3<f32>(v.v1.w, v.v2.w, v.v3.w);
        var lattice = exp2(a0.w as f32);
        var gq = vec3<f32>(0.0);
        // The mean factors octave by octave: the span doubles, so the factor
        // exp(-NOISE_BOX s^2) goes to its fourth power.
        var mf_pix = mean_factor(a0.w, oct_pix);
        var mf_tex = mean_factor(a0.w, oct_tex);
        for (var o: i32 = a0.w; o < o_end; o += 1) {
            let fo = o as f32;
            let fade_p = clamp(o_nyquist - fo, 0.0, 1.0);
            let fade_t = clamp(oct_tex + RIDGE_PAST - fo, 0.0, 1.0);
            let nq = simplex_grad(simplex_past(at, dq * lattice), SEED + 100 + o);
            var dr = ridge_cell_slope(nq.x, mf_pix) * fade_p;
            // What the texels hold of it (none past half its wavelength: no
            // slope taken).
            let x = 6.2831853 * min(span_at(o, oct_tex), 1.0);
            if (fade_t > 0.0 && x < 3.1415926) {
                dr -= ridge_cell_slope(nq.x, mf_tex) * fade_t * (sin(x) / x);
            }
            mf_pix *= mf_pix;
            mf_pix *= mf_pix;
            mf_tex *= mf_tex;
            mf_tex *= mf_tex;
            let scale = o < FINE_FIRST ? v.uv.x : mix(v.uv.y, v.v5.w, kept_share(o));
            gq += nq.yzw * (ridge_amp(o) * scale * dr * lattice);
            at = simplex_twice(at);
            lattice *= 2.0;
        }
        let gp = gq + bitcast<vec4<f32>>(anchors[a + 2]).xyz * gq.x + bitcast<vec4<f32>>(anchors[a + 3]).xyz * gq.y
               + bitcast<vec4<f32>>(anchors[a + 4]).xyz * gq.z;
        ridges = gp * (1.0 / BASE_WAVELENGTH);
    }

    // Bilinear over the four texels about this point. The layer's normals
    // face up, so a skirt seen from behind shades as the ground does.
    let fl_tex = floor(v_tex);
    let f = v_tex - fl_tex;
    let t0 = vec2<i32>(fl_tex.x as i32, fl_tex.y as i32);
    let d00 = detail_texel(v_slot, t0);
    let d10 = detail_texel(v_slot, t0 + vec2<i32>(1, 0));
    let d01 = detail_texel(v_slot, t0 + vec2<i32>(0, 1));
    let d11 = detail_texel(v_slot, t0 + vec2<i32>(1, 1));
    var col = mix(mix(d00.col, d10.col, f.x), mix(d01.col, d11.col, f.x), f.y);
    let forest = mix(mix(d00.cover, d10.cover, f.x), mix(d01.cover, d11.cover, f.x), f.y);
    var n = normalize(mix(mix(d00.nrm, d10.nrm, f.x), mix(d01.nrm, d11.nrm, f.x), f.y));
    var water = col.w;
    // The water's share, where there is any about, by a cubic B-spline
    // over the 4 x 4 texels around.
    if (max(max(d00.col.w, d10.col.w), max(d01.col.w, d11.col.w)) > 0.0) {
        let bx = bspline(f.x);
        let by = bspline(f.y);
        water = 0.0;
        for (var j: i32 = 0; j < 4; j += 1) {
            var row: f32 = 0.0;
            for (var i: i32 = 0; i < 4; i += 1) {
                row += vec4_at(bx, i) * detail_water(v_slot, t0 + vec2<i32>(i - 1, j - 1));
            }
            water += vec4_at(by, j) * row;
        }
    }
    // A shore the texels resolve runs as smoothly as their spline: from low
    // over a river its banks were drawn arcs. Finer than the texels the
    // edge is the pixel's: the spline's ramp sharpened to a couple of
    // pixels and shifted by noise from the texel's scale down to the
    // pixel's, so the bank wanders in bays and spits at every scale. The
    // noise is even about the spline's middle, so the water's share holds
    // on average and, farther off, resolves back to the texels'.
    let texel_m = footprint / max(max(length(dpdx(v_tex)), length(dpdy(v_tex))), 1e-6);
    if (water > 0.0 && water < 1.0 && texel_m > 2.0 * footprint) {
        var ragged: f32 = 0.0;
        var amp: f32 = 0.42;
        var wl = min(exp2(floor(log2(texel_m))), 256.0);
        for (var k: i32 = 0; k < 6 && wl > 2.0 * footprint; k += 1) {
            let far = wl >= 1.0;
            let pg = perlin_grad((far ? v_swell : v_q) / wl, ((far ? SWELL_PERIOD : DETAIL_PERIOD) / wl) as i32, 71 + k);
            ragged += pg.x * amp * clamp(wl / footprint * 0.5 - 1.0, 0.0, 1.0);
            amp *= 0.6;
            wl *= 0.5;
        }
        let sharp = clamp(texel_m / footprint * 0.4, 1.0, 24.0);
        water = clamp((water - 0.5 + ragged) * sharp + 0.5, 0.0, 1.0);
    }

    // The octaves a pixel resolves: full weight from 4 pixels a
    // wavelength, none at 2.
    // A wall too steep to hold snow (from about 63 degrees, bare by 78) is
    // rock, its beds level along their folds at the pixel's own height,
    // where the texels' colours (snow on one, rock on the next across the
    // face) would run down it as stripes.
    let shed = (1.0 - smoothstep(0.2, 0.45, dot(n, normalize(v_up)))) * (1.0 - water);
    if (shed > 0.0) {
        let cliff = cliff_rock((params.cam_hi + params.cam_lo) + v.world_pos, v_swell, footprint, region_rock(v_slot, v_tex));
        col = vec4<f32>(mix(col.xyz, cliff, shed), col.w);
    }
    var lum: f32 = 0.0;
    var lum_var: f32 = 0.0;
    var wavelength: f32 = 0.125;
    // Where the ground stands steep, a texel spans more height than width,
    // and what is laid out across the sphere (the ridges' finer octaves, the
    // texels' colours) is drawn down the face as streaks. There the face
    // takes its relief from the 3D detail below, which varies down it as
    // across it, and the ridges' octaves fade.
    let steep = 1.0 - smoothstep(0.35, 0.75, dot(n, normalize(v_up)));
    var slope = ridges * (1.0 - steep);
    let hi_c = max(col.x, max(col.y, col.z));
    let lo_c = min(col.x, min(col.y, col.z));
    let rock = (1.0 - smoothstep(0.15, 0.45, (hi_c - lo_c) / max(hi_c, 1e-3))) * (1.0 - smoothstep(0.35, 0.6, hi_c));
    let lum_gain = mix(1.0, ROCK_LUM, rock);
    let relief_gain = mix(1.0, ROCK_RELIEF, rock);
    let texel = texel_m;
    // Past the drawn trees, the crowns' share of the ground (below): their
    // texture is the octaves of a crown and its neighbours (CROWN_FIRST to
    // CROWN_LAST metres), lit and shaded crowns and dark gaps, bumps the sun
    // lights, as long as a pixel resolves them. The texels hold none of it,
    // so it is weighed by the pixel alone; mean-preserving like the rest, so
    // farther off it averages to the canopy's colour. Without it the forest
    // past the drawn trees was a smooth sheet.
    let drawn = params.trees_far <= 0.0 ? 0.0 : smoothstep(params.trees_far, params.trees_far * (5.0 / 6.0), length(v.world_pos));
    let canopy = TREE_CROWNS * forest * (1.0 - drawn * drawn) * (1.0 - water);
    // (By the pixel's area, the root of its two footprints: seen low, a
    // pixel is long down the view and narrow across it, and the crowns
    // still show across it.)
    let foot_area = sqrt(length(dpdx(v_q)) * length(dpdy(v_q)));
    var coarse = min(exp2(ceil(log2(2.0 * texel))), 32.0);
    if (canopy > 0.0) { coarse = max(coarse, CROWN_LAST); }
    for (var k: i32 = 0; k < 8 && coarse > wavelength; k += 1) {
        let w = clamp(coarse / footprint * 0.5 - 1.0, 0.0, 1.0) - clamp(coarse / texel * 0.5 - 1.0, 0.0, 1.0);
        let wc = (coarse >= CROWN_FIRST && coarse <= CROWN_LAST) ? canopy * clamp(coarse / foot_area * 0.5 - 1.0, 0.0, 1.0) : 0.0;
        if (w > 0.0 || wc > 0.0) {
            let far = coarse >= 1.0;
            let x = (far ? v_swell : v_q) / coarse;
            // Each wavelength its own noise, wherever the loop starts.
            let pg = perlin_grad(x, ((far ? SWELL_PERIOD : DETAIL_PERIOD) / coarse) as i32, 46 + (round(log2(coarse)) as i32));
            let a = VARY_LUM * lum_gain * max(w, 0.0);
            let ac = CROWN_LUM * wc;
            lum += pg.x * (a + ac);
            slope += pg.yzw * (RELIEF * relief_gain * max(w, 0.0) * steep + CROWN_RELIEF * wc);
            lum_var += (a * a + ac * ac) * PERLIN_VAR;
        }
        coarse *= 0.5;
    }
    // The forest floor's own small relief, root mounds, windthrow pits and
    // hollows, from FLOOR_LAST metres down on the gentle ground the faces'
    // relief leaves alone: the drained ground is smooth below its gullies,
    // and the texels resolving it close by left the floor dead flat however
    // near. (The open ground's is under the grass's blades.) It is the
    // shader's alone, at every distance (the texels hold none of it), each
    // octave fading as a pixel spans it; faded in from a tenth of the
    // forest, so thin woods cost nothing. rise: how high it stands here,
    // its noise, about -1 to 1.
    let floor_relief = FLOOR_RELIEF * forest * smoothstep(0.1, 0.2, forest) * (1.0 - steep) * (1.0 - water);
    var rise: f32 = 0.0;
    if (floor_relief > 0.0 && footprint < 0.5 * FLOOR_LAST) {
        let fr = floor_noise(v_swell, v_q, normalize(v_up), footprint);
        rise = fr.x;
        slope += fr.yzw * floor_relief;
    }
    var cells = (DETAIL_PERIOD / wavelength) as i32;
    for (var k: i32 = 0; k < 6; k += 1) {
        let w = clamp(wavelength / footprint * 0.5 - 1.0, 0.0, 1.0);
        if (w <= 0.0) { break; }
        let x = v_q / wavelength;
        // One noise for both: the relief's crests are the lighter ground.
        let g = perlin_grad(x, cells, 11 + k);
        let a = VARY_LUM * lum_gain * w;
        lum += g.x * a;
        lum_var += a * a * PERLIN_VAR;
        slope += g.yzw * (RELIEF * relief_gain * w);
        wavelength *= 0.5;
        cells *= 2;
    }
    let land = 1.0 - water;
    let vary = mix(1.0, exp(lum - 0.5 * lum_var), land);
    // Under the trees the floor is their litter, not the open ground's
    // sward: brown needles on the floor's rises, moss in its hollows, none
    // over rock or snow. (Where the pixel spans the relief, rise is 0 and
    // the floor their mix.)
    let litter = LITTER * forest * land * (1.0 - rock) * (1.0 - shed) * (1.0 - smoothstep(0.25, 0.5, hi_c));
    if (litter > 0.0) {
        let mossy = smoothstep(0.25, -0.25, rise);
        col = vec4<f32>(mix(col.xyz, mix(NEEDLES, MOSS, mossy), litter), col.w);
    }
    s.base_color = col.xyz * vary;
    let eye = -normalize(v.world_pos);
    let crowns = 1.0 - pow(1.0 - TREE_CROWNS * forest, 1.0 / max(dot(eye, normalize(v_up)), 0.05));
    // Where blades stand, the ground between them, in their shade.
    let grass = GrassPlace { a: params.grass_a, e: params.grass_e, f: params.grass_f, uv: params.grass_uv };
    s.base_color *= grass_floor(grass, (params.cam_hi + params.cam_lo) + v.world_pos, length(v.world_pos));
    // Where the trees are not drawn, their crowns' share of the ground is
    // the crowns' own colour (trees_mesh.bk's needles, as their shading
    // averages them). A tint over the floor (bluish, for the shade) read
    // from altitude as lakes under the air's blue.
    s.base_color = mix(s.base_color, CANOPY * vary, crowns * (1.0 - drawn * drawn));
    let g_floor = TREE_CROWNS * forest * drawn * drawn;
    // The relief's gradient along the surface tilts the normal against it.
    n = normalize(n - (slope - dot(slope, n) * n) * land);
    var sea_variance: f32 = 0.0;
    let up = normalize(v_up);
    let fresh = smoothstep(0.0, 1.0, v_height);
    var sea = up;
    if (water > 0.001) {
        let calm = mix(1.0, WAVE_FRESH_SCALE, fresh);
        let sr = sea_slope(footprint * mix(1.0, 4.0, fresh), up, v_swell, v_q, fresh > 0.5 ? WAVE_FRESH : 0);
        // A river's surface in streaks along its current: rippled lanes
        // and glassy slicks between, and the gentle swell across them,
        // which break its mirror into what reads as moving water. The
        // current runs across the bed's slope (the texels' normal under
        // the water is its bed's); the lanes are the noise averaged along
        // it, so they stay periodic (no seam where the coordinates wrap),
        // and turn to patches where the bed is level.
        var lane: f32 = 0.0;
        let sw = clamp(STREAK_W / footprint * 0.5 - 1.0, 0.0, 1.0) * fresh;
        if (sw > 0.0) {
            let across = n - up * dot(n, up);
            let al = length(across);
            let along = (al > 1.0e-5 ? cross(up, across / al) : vec3<f32>(0.0)) * (STREAK_LEN * smoothstep(0.002, 0.02, al));
            var acc = vec4<f32>(0.0);
            acc = perlin_grad((v_swell - along) / STREAK_W, (SWELL_PERIOD / STREAK_W) as i32, 81)
                + perlin_grad((v_swell + along) / STREAK_W, (SWELL_PERIOD / STREAK_W) as i32, 81);
            acc *= 0.5 * sw;
            lane = acc.x;
            let g = acc.yzw - up * dot(acc.yzw, up);
            sea = normalize(up - (sr.slope * max(1.0 + STREAK_RIPPLE * lane, 0.1) + g * STREAK_SLOPE) * calm);
        } else {
            sea = normalize(up - sr.slope * calm);
        }
        let rip = max(1.0 + STREAK_RIPPLE * lane, 0.1);
        sea_variance = sr.variance * calm * calm * rip * rip;
    }
    // Fresh water is smoother than its ripples' slopes say: a river or a
    // lake mirrors its sky and its banks, which is what reads as water from
    // low over it (at the slopes' roughness it was a dull grey sheet).
    let water_rough = sqrt(sqrt(sea_variance)) * mix(1.0, FRESH_GLOSS, fresh);
    // A pixel mostly water shades as water. One partly water (a stream
    // narrower than it, a shore crossing it) shades as its land, and its
    // water's mirror is added in its share: a roughness between the two
    // mirrors nothing, so a stream finer than the pixels lost its glint and
    // vanished into the ground about it.
    let mirror = smoothstep(0.5, 1.0, water);
    s.normal = normalize(mix(n, sea, mirror));
    s.roughness = mix(0.9, water_rough, mirror);
    s.metallic = 0.0;

    s.sun_visibility *= v_light.x;
    s.sky_visibility *= v_light.y * (1.0 - 0.8 * g_floor);
    s.occluder_sun *= v_light.z;
    s.sun_diffuse = v_light.w;
    s.sky_normal = normalize(s.normal + v_bent);
    // Only a stream finer than a pixel glints in its share: one the pixels
    // resolve is drawn as its water, and its glint over the texels' spread
    // of it read as a wire laid over the ground. (A stream narrower than a
    // texel spreads over about one and a half, so its width is about its
    // share there times that, in pixels.)
    let thread = 1.0 - smoothstep(0.6, 1.2, 1.5 * water * texel_m / footprint);
    let glint = water * (1.0 - mirror) * thread;
    if (glint > 0.0) {
        let ls = lighting::Surface {
            position: v.world_pos, normal: sea, view: eye, cam_dist: length(v.world_pos),
            base_color: vec3<f32>(0.0), metallic: 0.0, roughness: max(water_rough, 0.04),
            receives_shadow: false, two_sided: false, subsurface: 0.0, translucency: 0.0,
            sun_visibility: clamp(s.sun_visibility, 0.0, 1.0), sky_visibility: clamp(s.sky_visibility, 0.0, 1.0),
            sky_normal: sea, occluder_sun: 0.0, sun_diffuse: 0.0,
        };
        s.emissive += glint * (lighting::direct_light(ls) + lighting::ambient(ls));
    }
    // The water's mirror of a cloudy sky. The scene's reflection is the
    // clear sky's, and the clouds count as what hides it, so under cloud a
    // river mirrored nothing and was its silt's matte brown. Here the
    // reflected ray sees the sky through the clouds' gaps (closing along a
    // grazing ray, as gaps do toward the horizon) and the clouds in them:
    // their undersides by the light they scatter down (spread over the
    // sky they cover), their sunlit sides low down. What the scene already
    // adds of the clear sky is taken off. By Fresnel: from low over a
    // river, mostly its sky and its banks' shade; from above, its water.
    if (mirror > 0.0) {
        let open = v_open;
        let banks = clamp(v_light.y / max(open, 1.0e-3), 0.0, 1.0);
        let nv = max(dot(s.normal, eye), 1.0e-4);
        let r = reflect(-eye, s.normal);
        let r_up = max(dot(r, up), 0.0);
        let open_r = pow(open, 1.0 / max(r_up, 0.08));
        let sun_up = max(dot(up, params.to_sun), 0.0);
        let e = lighting::sun_light(v.world_pos) * (sun_up / GROUND_PI);
        let under = e * (v_light.w / max(1.0 - open, 0.15));
        let clouds = mix(e * CLOUD_SIDES, under, smoothstep(0.0, 0.5, r_up));
        let sky_r = lighting::sky_along(r);
        let fr = 0.02 + 0.98 * pow(1.0 - nv, 5.0) * (1.0 - s.roughness);
        let seen = mix(sky_r, clouds, 1.0 - open_r) * mix(BANK_SHADE, 1.0, banks);
        let scene = sky_r * lighting::specular_occlusion(nv, s.sky_visibility, s.roughness);
        s.emissive += mirror * fr * max(seen - scene, vec3<f32>(0.0));
    }

    if (SCENE_DEBUG(water)) { s = mesh::debug(s, vec3<f32>(water)); }
    if (SCENE_DEBUG(forest)) { s = mesh::debug(s, vec3<f32>(forest, forest, water)); }
    if (SCENE_DEBUG(level)) {
        let hue = ((v_level % 6) as f32) / 6.0;
        s = mesh::debug(s, clamp(abs(mod(vec3<f32>(hue * 6.0) + vec3<f32>(0.0, 4.0, 2.0), 6.0) - vec3<f32>(3.0)) - vec3<f32>(1.0), vec3<f32>(0.0), vec3<f32>(1.0)) * 0.5);
    }
    if (SCENE_DEBUG(albedo)) { s = mesh::debug(s, s.base_color); }
    if (SCENE_DEBUG(texels)) { s = mesh::debug(s, col.xyz); }
    if (SCENE_DEBUG(octaves)) { s = mesh::debug(s, vec3<f32>(0.5 * exp(lum - 0.5 * lum_var))); }
    if (SCENE_DEBUG(ridges)) {
        s = mesh::debug(s, vec3<f32>(min(length(ridges), 1.0), max((o_end - a0.w) as f32, 0.0) * 0.2, 0.0));
    }
    if (SCENE_DEBUG(light)) { s = mesh::debug(s, v_light.xyz); }
    if (SCENE_DEBUG(normal)) { s = mesh::debug(s, s.normal * 0.5 + vec3<f32>(0.5)); }
    if (SCENE_DEBUG(skirt)) { s = mesh::debug(s, v_skirt > 0.0 ? vec3<f32>(1.0, 0.0, 0.0) : s.base_color); }
    if (SCENE_DEBUG(tile)) {
        let at = (v_tex + vec2<f32>(0.5)) / (DETAIL as f32) - vec2<f32>(BORDER as f32);
        let e = abs(fract(v_tex + vec2<f32>(0.5)) - vec2<f32>(0.5));
        s = mesh::debug(s, mix(vec3<f32>(at / (TILE as f32), 0.0), s.base_color, 0.5) * (max(e.x, e.y) > 0.45 ? 0.3 : 1.0));
    }
    return s;
}
