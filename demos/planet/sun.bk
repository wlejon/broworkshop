// How much of the sun's disc the ground sees over the terrain, and what the
// clouds leave of the sun and the sky there, on a grid of points on the
// gnomonic plane of a cube face (the points a + e u + f v projected onto the
// sphere): the grass's and the trees' light (sun.js). The grid is anchored
// at its centre (anchor.bk, found on the CPU), point (x, y) the plane offset
// lost + e (du0 + x delta) + f (dv0 + y delta) from it. Two kernels: the
// ground's height at every step toward the sun of every point, in parallel
// (a point's steps in one thread underfill the GPU), into `steps`
// (z * points + y * width + x), then each point's share from its steps, and
// the clouds' (clouds.bk cloud_light) at the grid's spacing.
from planet::ground import terrain, sun_step_height, sun_step_angle, sun_elevation_seen, SUN_STEPS;
from planet::clouds import cloud_light;
from planet::anchor import Anchor, read_anchor, plane_offset;

// Point (x, y)'s offset from the anchor's direction.
fn plane_point(a: Anchor, ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32, du: f32, dv: f32) -> vec3<f32> {
    return plane_offset(a, a.lost + vec3<f32>(ex, ey, ez) * du + vec3<f32>(fx, fy, fz) * dv);
}

// Steps z0 + z of every point.
@kernel @grid(3)
fn k_sun_steps(g: grid<3>, steps: write_store<f32, 1>, anchor: read_store<vec4<i32>, 1>,
               ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
               du0: f32, dv0: f32, delta: f32, sx: f32, sy: f32, sz: f32, radius: f32, octaves: f32, seed: i32,
               z0: i32, net: read_store<f32, 1>) {
    let a = read_anchor(anchor, 0);
    let e = plane_point(a, ex, ey, ez, fx, fy, fz, du0 + (g.x() as f32) * delta, dv0 + (g.y() as f32) * delta);
    let k = z0 + g.z();
    steps[(k * g.height() + g.y()) * g.width() + g.x()] =
        sun_step_height(a, e, normalize(vec3<f32>(sx, sy, sz)), k, radius, octaves, seed, net);
}

// 0 to 1 in 8 bits, rounded.
fn unorm8(x: f32) -> i32 {
    return (clamp(x, 0.0, 1.0) * 255.0 + 0.5) as i32;
}

// Point i into out[i]: the terrain's share of the sun, then the clouds' sun
// straight through, scattered down, and sky (cloud_light), 8 bits each from
// the lowest: four shares that change smoothly over the grid, read by every
// vertex of every blade and needle, so in one word.
@kernel @grid(2)
fn k_sun(g: grid<2>, steps: read_store<f32, 1>, out: write_store<i32, 1>, anchor: read_store<vec4<i32>, 1>,
         ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
         du0: f32, dv0: f32, delta: f32, sx: f32, sy: f32, sz: f32, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>,
         detail_var: f32) {
    let a = read_anchor(anchor, 0);
    let e = plane_point(a, ex, ey, ez, fx, fy, fz, du0 + (g.x() as f32) * delta, dv0 + (g.y() as f32) * delta);
    let h = terrain(a, e, radius, octaves, seed, net);
    let points = g.width() * g.height();
    let i = g.y() * g.width() + g.x();
    var highest: f32 = -1.57;
    for (var k: i32 = 0; k < SUN_STEPS; k += 1) {
        highest = max(highest, sun_step_angle(h, steps[k * points + i], k, radius));
    }
    let to_sun = normalize(vec3<f32>(sx, sy, sz));
    let up = normalize(a.dir + e);
    let c = cloud_light(up, max(h, 0.0), to_sun, delta * radius, radius, seed, detail_var);
    out[i] = unorm8(sun_elevation_seen(up, to_sun, highest)) | (unorm8(c.x) << 8) | (unorm8(c.y) << 16)
           | (unorm8(c.z) << 24);
}
