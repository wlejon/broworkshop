// How much of the sun's disc the ground sees over the terrain, and what the
// clouds leave of the sun and the sky there, on a grid of points on the
// gnomonic plane of a cube face (the points a + e u + f v projected onto the
// sphere): the grass's and the trees' light (sun.js). The grid is anchored
// at its centre (anchor.bk, found on the CPU), point (x, y) the plane offset
// lost + e (du0 + x delta) + f (dv0 + y delta) from it. The ground's height
// at every step toward the sun of every point, in parallel (a point's steps
// in one thread underfill the GPU), into `steps` (z * points + y * width +
// x): each step's drainage levels side by side (k_sun_parts), then its
// height from them (k_sun_steps); then each point's share from its steps,
// and the clouds' (clouds.bk cloud_light) at the grid's spacing (k_sun).
//
// The ground's drainage under the grid and its steps is found once, over a
// field about the grid's centre (dendry_field.bk: k_field_reaches, then
// k_field_points and k_field_links a level), and every point and step reads
// it there; the trees' field (trees.bk) reads its sun grid's.
from planet::ground import terrain_drained, cell_width, terrain_parts, shaped_by;
from planet::rivers import water_at;
from planet::clouds import cloud_light;
from planet::anchor import Anchor, read_anchor, plane_offset, moved;
from planet::dendry import DRAIN_LEVELS, dryness;
from planet::dendry_grid import drain_parts;
from planet::dendry_field import field_drain, field_part, field_reach_point, field_point, field_link;

// The sun's disc over the terrain from the ground at offset e: the highest
// the ground rises toward the sun, out to 1.8 km at SUN_STEPS steps 1.3
// apart (SUN_REACH metres), against the sun's elevation, over the disc's
// 0.53 degrees. The steps are independent, so a kernel takes them in
// parallel (k_sun_steps) and another gathers them (k_sun). Far steps read
// coarser octaves: what is finer than the step does not cast its shadow.
const SUN_STEPS: i32 = 28;
fn sun_step_dist(k: i32) -> f32 { return 1.5 * pow(1.3, k as f32); }

// The share of the disc seen from `up` over ground rising to the angle
// `highest` (the largest of sun_step_angle's).
fn sun_elevation_seen(up: vec3<f32>, toSun: vec3<f32>, highest: f32) -> f32 {
    let sunUp = dot(toSun, up);
    if (sunUp <= -0.01) { return 0.0; }
    let sunElev = asin(clamp(sunUp, -1.0, 1.0));
    return clamp((sunElev - highest) / 0.0093 + 0.5, 0.0, 1.0);
}

// Step k's elevation angle seen from `h` up: above the point's tangent
// plane, the sphere's fall included.
fn sun_step_angle(h: f32, hk: f32, k: i32, radius: f32) -> f32 {
    let dist = sun_step_dist(k);
    let rise = hk - max(h, 0.0) - dist * dist / (2.0 * radius);
    return atan(rise / dist);
}

// Point (x, y)'s offset from the anchor's direction.
fn plane_point(a: Anchor, ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32, du: f32, dv: f32) -> vec3<f32> {
    return plane_offset(a, a.lost + vec3<f32>(ex, ey, ez) * du + vec3<f32>(fx, fy, fz) * dv);
}

// The ground (sea level and up) at offset e with `octaves`, drained from
// the field.
fn field_terrain(reaches: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>, a: Anchor, e: vec3<f32>,
                 radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    let d = field_drain(reaches, segs, a, e, radius, cell_width(octaves), seed, vec3<f32>(0.0), vec3<f32>(0.0), 1);
    return terrain_drained(a, e, radius, octaves, seed, net, d);
}

// ── The field's drainage ───────────────────────────────────────────────────
//
// Over the square `half` metres either side of the anchor's centre (the
// grid's points and their steps): level 0's reaches, then each level's
// potentials and links, a level at a time (pots holds one level's).

@kernel @grid(2)
fn k_field_reaches(g: grid<2>, reaches: write_store<vec4<f32>, 1>, anchor: read_store<vec4<i32>, 1>, half: f32,
                   radius: f32, net: read_store<f32, 1>) {
    field_reach_point(reaches, net, read_anchor(anchor, 0), g.x(), g.y(), half, radius);
}

@kernel @grid(2)
fn k_field_points(g: grid<2>, pots: write_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>,
                  reaches: read_store<vec4<f32>, 1>, anchor: read_store<vec4<i32>, 1>, half: f32, radius: f32,
                  level: i32, seed: i32) {
    field_point(pots, segs, reaches, read_anchor(anchor, 0), level, g.x(), g.y(), half, radius, seed);
}

@kernel @grid(2)
fn k_field_links(g: grid<2>, segs: write_store<vec4<f32>, 1>, pots: read_store<vec4<f32>, 1>,
                 anchor: read_store<vec4<i32>, 1>, half: f32, radius: f32, level: i32, seed: i32) {
    field_link(segs, pots, read_anchor(anchor, 0), level, g.x(), g.y(), half, radius, seed);
}

// ── The grid ───────────────────────────────────────────────────────────────

// Step k toward the sun of the point at offset e: its offset, and in w the
// octaves it reads.
fn step_point(a: Anchor, e: vec3<f32>, sx: f32, sy: f32, sz: f32, k: i32, radius: f32, octaves: f32) -> vec4<f32> {
    let to_sun = normalize(vec3<f32>(sx, sy, sz));
    let n = a.dir + e;
    let level = normalize(to_sun - n * dot(to_sun, n));
    let dist = sun_step_dist(k);
    let q = moved(a.dir, e, level * (dist / radius));
    return vec4<f32>(q, max(octaves - log2(max(dist, 1.0)) * 0.7, 8.0));
}

// The drainage's levels at steps z0 + z / (DRAIN_LEVELS + 1) of every point,
// level z % (DRAIN_LEVELS + 1), side by side (dendry_field.bk field_part),
// into `parts` (z * points + y * width + x): one thread finding a step's
// levels one after another left the GPU latency-bound.
@kernel @grid(3)
fn k_sun_parts(g: grid<3>, parts: write_store<vec4<f32>, 1>, anchor: read_store<vec4<i32>, 1>,
               ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
               du0: f32, dv0: f32, delta: f32, sx: f32, sy: f32, sz: f32, radius: f32, octaves: f32, seed: i32,
               z0: i32, reaches: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>) {
    let a = read_anchor(anchor, 0);
    let e = plane_point(a, ex, ey, ez, fx, fy, fz, du0 + (g.x() as f32) * delta, dv0 + (g.y() as f32) * delta);
    let sp = step_point(a, e, sx, sy, sz, z0 + g.z() / (DRAIN_LEVELS + 1), radius, octaves);
    parts[(g.z() * g.height() + g.y()) * g.width() + g.x()] =
        field_part(reaches, segs, a, sp.xyz, radius, cell_width(sp.w), g.z() % (DRAIN_LEVELS + 1), seed);
}

// Steps z0 + z of every point: the ground's height (sea level and up) at
// step k toward the sun, drained from its levels' parts (k_sun_parts).
@kernel @grid(3)
fn k_sun_steps(g: grid<3>, steps: write_store<f32, 1>, anchor: read_store<vec4<i32>, 1>,
               ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
               du0: f32, dv0: f32, delta: f32, sx: f32, sy: f32, sz: f32, radius: f32, octaves: f32, seed: i32,
               z0: i32, net: read_store<f32, 1>, parts: read_store<vec4<f32>, 1>) {
    let a = read_anchor(anchor, 0);
    let e = plane_point(a, ex, ey, ez, fx, fy, fz, du0 + (g.x() as f32) * delta, dv0 + (g.y() as f32) * delta);
    let k = z0 + g.z();
    let sp = step_point(a, e, sx, sy, sz, k, radius, octaves);
    // The noise first, then the drainage: a Drain held through the noise
    // costs the kernel its threads.
    let t = terrain_parts(a, sp.xyz, radius, sp.w, seed);
    let cell = cell_width(sp.w);
    let points = g.width() * g.height();
    let i = g.z() * (DRAIN_LEVELS + 1) * points + g.y() * g.width() + g.x();
    let d = drain_parts(parts[i], parts[i + points], parts[i + 2 * points], parts[i + 3 * points],
                        parts[i + 4 * points], cell, 0.0, radius, dryness(normalize(a.dir + sp.xyz), seed));
    let w = water_at(a.dir, sp.xyz, radius, cell, net, seed);
    steps[(k * g.height() + g.y()) * g.width() + g.x()] = max(shaped_by(t, w, d, radius).x, 0.0);
}

// 0 to 1 in 8 bits, rounded.
fn unorm8(x: f32) -> i32 {
    return (clamp(x, 0.0, 1.0) * 255.0 + 0.5) as i32;
}

// Point i into out[i]: the terrain's share of the sun, then the clouds' sun
// straight through, scattered down, and sky (cloud_light), 8 bits each from
// the lowest: four shares that change smoothly over the grid, read by every
// vertex of every blade and needle, so in one word.
@kernel @grid(2)
fn k_sun(g: grid<2>, steps: read_store<f32, 1>, out: write_store<i32, 1>, anchor: read_store<vec4<i32>, 1>,
         ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
         du0: f32, dv0: f32, delta: f32, sx: f32, sy: f32, sz: f32, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>,
         reaches: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>, detail_var: f32) {
    let a = read_anchor(anchor, 0);
    let e = plane_point(a, ex, ey, ez, fx, fy, fz, du0 + (g.x() as f32) * delta, dv0 + (g.y() as f32) * delta);
    let h = field_terrain(reaches, segs, a, e, radius, octaves, seed, net);
    let points = g.width() * g.height();
    let i = g.y() * g.width() + g.x();
    var highest: f32 = -1.57;
    for (var k: i32 = 0; k < SUN_STEPS; k += 1) {
        highest = max(highest, sun_step_angle(h, steps[k * points + i], k, radius));
    }
    let to_sun = normalize(vec3<f32>(sx, sy, sz));
    let up = normalize(a.dir + e);
    let c = cloud_light(up, max(h, 0.0), to_sun, delta * radius, radius, seed, detail_var);
    out[i] = unorm8(sun_elevation_seen(up, to_sun, highest)) | (unorm8(c.x) << 8) | (unorm8(c.y) << 16)
           | (unorm8(c.z) << 24);
}
