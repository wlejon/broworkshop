// The drainage (dendry.bk) over a field of points about a centre: the sun
// grids' and the trees' fields (sun.js, trees.js), as dendry_grid.bk finds
// it over a tile. Every level's potentials and links are found once over
// the field, in two dispatches a level (sun.bk k_field_points,
// k_field_links, after k_field_reaches), and a point reads the 5 x 5
// segments about it a level (field_drain) instead of finding 49 potentials
// and 25 links a level on its own (dendry.bk drain_probed). The same network
// the tiles' texels read: a point's potentials take the level above's
// segments from its parent's 3 x 3, each link leans in the grain at its own
// point, and the segments are packed as the tiles' are.
//
// A level's grid is its cells about the cell of the field's centre, (i, j)
// from it, out to FIELD_R either way (cell_step past a face's edge), as far
// as the square `half` metres either side of the centre on the field's
// plane reaches (field_reach), and the parents of the next level's
// potentials. Positions are metres on the plane at the field's anchor:
// its direction `a.dir`, the centre at `a.dir_lo` from it.
module planet::dendry_field;

from planet::rivers import RIV_N, cell_of, cell_next;
from planet::dendry import DRAIN_LEVELS, VALLEY, Seg, Near, near_none, near_try, streams_about, Pot, pot_of, fall,
    link_of, seg_packed, seg_unpacked, seg_far, Local, local_frame, to_local, vec_local, from_local, reach_seg,
    seg_dist, chord, valley_term, seg_near, rel_after, mean_rel, base_weight, Tally, tally_none, tally_water,
    tally_level, ubar_next, Drain, drain_of, cell_spread, spacing, fade, rise, cell_in, cell_virtual, cell_step,
    site_dir, site_id, parent_of, grain_at, lean, comp4, strengths, dryness;
from planet::dendry_grid import water_word;
from planet::anchor import Anchor;

pub const FIELD_R: i32 = 96;
pub const FIELD: i32 = 193;      // 2 FIELD_R + 1
// The potentials' grid, one cell wider each way (the links' neighbours).
pub const FPOT_R: i32 = 97;
pub const FPOT: i32 = 195;

// The bytes of a field's stores: level 0's reaches (three vec4s a cell),
// levels 1 on's segments (two), one level's potentials (two).
pub const FIELD_REACH_BYTES: i32 = 193 * 193 * 48;
pub const FIELD_SEG_BYTES: i32 = 4 * 193 * 193 * 32;
pub const FIELD_POT_BYTES: i32 = 195 * 195 * 32;

fn field_frame(a: Anchor, radius: f32) -> Local {
    return local_frame(a.dir, a.dir_lo, radius);
}
fn field_centre(a: Anchor) -> vec3<f32> {
    return normalize(a.dir + a.dir_lo);
}

// How far level `level`'s grid reaches: the cells under the field's
// square from its corners' cells (the equal-angle lattice is monotone) and
// 3 more (the 5 x 5 read about a point, a cell's rounding); and every level
// reaches the parents of the next's potentials. Level 0 is the rivers'.
pub fn field_reach(a: Anchor, level: i32, half: f32, radius: f32) -> i32 {
    let f = field_frame(a, radius);
    let centre = field_centre(a);
    var rk: i32 = -1;
    for (var k: i32 = DRAIN_LEVELS; k >= level; k -= 1) {
        let finer = rk;
        let n = RIV_N << (2 * k);
        let ck = cell_in(centre, n);
        rk = 0;
        for (var c: i32 = 0; c < 4; c += 1) {
            let x = (c & 1) == 0 ? -half : half;
            let y = (c & 2) == 0 ? -half : half;
            let v = cell_virtual(from_local(f, vec2<f32>(x, y)), ck.x, n) - ck.yz;
            rk = max(rk, max(abs(v.x), abs(v.y)) + 3);
        }
        if (finer >= 0) { rk = max(rk, (finer + 7) / 4 + 1); }
        rk = min(rk, FIELD_R);
    }
    return rk;
}

fn reach_at(i: i32, j: i32) -> i32 {
    return ((j + FIELD_R) * FIELD + i + FIELD_R) * 3;
}
fn field_reach_seg(reaches: read_store<vec4<f32>, 1>, i: i32, j: i32) -> Seg {
    let at = reach_at(i, j);
    return Seg { a: reaches[at], b: reaches[at + 1], c: reaches[at + 2] };
}
fn seg_at(k: i32, i: i32, j: i32) -> i32 {
    return (((k - 1) * FIELD + j + FIELD_R) * FIELD + i + FIELD_R) * 2;
}
fn pot_at(i: i32, j: i32) -> i32 {
    return ((j + FPOT_R) * FPOT + i + FPOT_R) * 2;
}
fn field_seg(segs: read_store<vec4<f32>, 1>, k: i32, i: i32, j: i32) -> Seg {
    let at = seg_at(k, i, j);
    return seg_unpacked(segs[at], segs[at + 1]);
}

// ── The grids ──────────────────────────────────────────────────────────────

// Level 0's reach (gx, gy) of the grid, from the rivers' network.
pub fn field_reach_point(reaches: write_store<vec4<f32>, 1>, net: read_store<f32, 1>, a: Anchor, gx: i32, gy: i32,
                         half: f32, radius: f32) {
    let r = field_reach(a, 0, half, radius);
    let i = gx - FIELD_R;
    let j = gy - FIELD_R;
    if (abs(i) > r || abs(j) > r) { return; }
    let s = reach_seg(net, cell_next(cell_of(field_centre(a)), i, j), field_frame(a, radius));
    let at = reach_at(i, j);
    reaches[at] = s.a;
    reaches[at + 1] = s.b;
    reaches[at + 2] = s.c;
}

// Level k's point (gx, gy) of the potentials' grid: its potential from the
// level above's segments about its parent (level 0's: the reaches).
pub fn field_point(pots: write_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>, reaches: read_store<vec4<f32>, 1>,
                   a: Anchor, k: i32, gx: i32, gy: i32, half: f32, radius: f32, seed: i32) {
    let r = field_reach(a, k, half, radius);
    let i = gx - FPOT_R;
    let j = gy - FPOT_R;
    if (abs(i) > r + 1 || abs(j) > r + 1) { return; }
    let f = field_frame(a, radius);
    let n = RIV_N << (2 * k);
    let ck = cell_in(field_centre(a), n);
    let lk = spacing(k, radius);
    let sig = rise(k);
    let x = to_local(f, site_dir(cell_step(ck, i, j, n), n, seed + 1000 * k));
    let pi = parent_of(ck.y + i) - parent_of(ck.y);
    let pj = parent_of(ck.z + j) - parent_of(ck.z);
    var near = near_none();
    if (k == 1) {
        for (var e: i32 = 0; e < 9; e += 1) {
            near = near_try(near, field_reach_seg(reaches, pi + e % 3 - 1, pj + e / 3 - 1), x, sig, lk);
        }
    } else {
        for (var e: i32 = 0; e < 9; e += 1) {
            near = near_try(near, field_seg(segs, k - 1, pi + e % 3 - 1, pj + e / 3 - 1), x, sig, lk);
        }
    }
    let p = pot_of(near, x, k, lk, seed);
    let at = pot_at(i, j);
    pots[at] = p.a;
    pots[at + 1] = p.b;
}

// Level k's segment (gx, gy) of the grid: its point's link, from the
// potentials about it, in the grain at its point.
pub fn field_link(segs: write_store<vec4<f32>, 1>, pots: read_store<vec4<f32>, 1>, a: Anchor, k: i32, gx: i32, gy: i32,
                  half: f32, radius: f32, seed: i32) {
    let r = field_reach(a, k, half, radius);
    let i = gx - FIELD_R;
    let j = gy - FIELD_R;
    if (abs(i) > r || abs(j) > r) { return; }
    let n = RIV_N << (2 * k);
    let ck = cell_in(field_centre(a), n);
    let o = pot_at(i, j);
    let po = Pot { a: pots[o], b: pots[o + 1] };
    let f = field_frame(a, radius);
    let grain = grain_at(from_local(f, po.a.xy), f, seed);
    var tgt: i32 = o;
    var steep: f32 = 0.0;
    for (var nb: i32 = 0; nb < 9; nb += 1) {
        let at = pot_at(i + nb % 3 - 1, j + nb / 3 - 1);
        let pt = Pot { a: pots[at], b: pots[at + 1] };
        let sl = fall(po, pt) * lean(grain, po, pt);
        if (sl > steep) {
            steep = sl;
            tgt = at;
        }
    }
    let s = link_of(po, Pot { a: pots[tgt], b: pots[tgt + 1] }, tgt != o, k, rise(k), site_id(cell_step(ck, i, j, n), k));
    let at = seg_at(k, i, j);
    segs[at] = s.a;
    segs[at + 1] = seg_packed(s);
}

// ── A point's drainage ─────────────────────────────────────────────────────

// Level k's part of the drainage at the field's point offset e from the
// anchor's direction, for a cell `cell` wide, found on its own (a thread's,
// so a point's levels are found side by side, then combined by
// dendry_grid.bk drain_parts with no texel limit): dendry_grid.bk
// level_part's, from the field's grids. field_drain's levels, one point.
pub fn field_part(reaches: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>, a: Anchor, e: vec3<f32>,
                  radius: f32, cell: f32, k: i32, seed: i32) -> vec4<f32> {
    let lk = spacing(k, radius);
    let fk = fade(lk, cell);
    if (k > 0 && fk <= 0.0) { return vec4<f32>(0.0, 1.0e9, 1.0e9, 0.0); }
    let f = field_frame(a, radius);
    let centre = field_centre(a);
    let up = normalize(a.dir + e);
    let q = vec_local(f, e - a.dir_lo) * radius;
    let sg = cell_spread(cell);
    let wk = VALLEY * lk;
    var t = tally_none();
    var acc: f32 = 0.0;
    var dmin: f32 = 1.0e9;
    let ct = cell_of(centre);
    let c0 = cell_virtual(up, ct.x, RIV_N) - ct.yz;
    if (k == 0) {
        var zsum: f32 = 0.0;
        var wsum: f32 = 0.0;
        for (var m: i32 = 0; m < 25; m += 1) {
            let s = field_reach_seg(reaches, c0.x + m % 5 - 2, c0.y + m / 5 - 2);
            if (s.c.z > 0.0) {
                let ch = chord(s.a, q);
                let wt = base_weight(ch.x / lk);
                zsum += wt * mix(s.b.z, s.b.w, ch.y / ch.z);
                wsum += wt;
                if (fk > 0.0) {
                    let dt = seg_dist(s, q, 0, wk, seed);
                    acc += valley_term(s, dt, 0, wk);
                    if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, 0, wk)); }
                    t = tally_water(t, s, dt.x, 0, 1.0, sg);
                }
            }
        }
        return vec4<f32>(acc, dmin, wsum > 0.0 ? zsum / wsum : 0.0, water_word(t));
    }
    // The streams about here: the level above's 3 x 3 about here.
    var near = near_none();
    let sig = rise(k);
    if (k == 1) {
        for (var m: i32 = 0; m < 9; m += 1) {
            near = near_try(near, field_reach_seg(reaches, c0.x + m % 3 - 1, c0.y + m / 3 - 1), q, sig, lk);
        }
    } else {
        let np1 = RIV_N << (2 * (k - 1));
        let cp = cell_in(centre, np1);
        let qp = cell_virtual(up, cp.x, np1) - cp.yz;
        for (var m: i32 = 0; m < 9; m += 1) {
            near = near_try(near, field_seg(segs, k - 1, qp.x + m % 3 - 1, qp.y + m / 3 - 1), q, sig, lk);
        }
    }
    // The valleys of the 5 x 5 links about here.
    let n = RIV_N << (2 * k);
    let ck = cell_in(centre, n);
    let qv = cell_virtual(up, ck.x, n) - ck.yz;
    for (var m: i32 = 0; m < 25; m += 1) {
        let at = seg_at(k, qv.x + m % 5 - 2, qv.y + m / 5 - 2);
        let a4 = segs[at];
        if (seg_far(a4, q, 2.0 * wk)) { continue; }
        let s = seg_unpacked(a4, segs[at + 1]);
        if (s.c.z > 0.0) {
            let dt = seg_dist(s, q, k, wk, seed);
            acc += valley_term(s, dt, k, wk);
            if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, k, wk)); }
            t = tally_water(t, s, dt.x, k, fk, sg);
        }
    }
    return vec4<f32>(acc, dmin, streams_about(near, sig), water_word(t));
}

// The drainage at the field's point offset e from the anchor's direction,
// for a cell `cell` wide, and its relative height at `np` - 1 more points
// (up to 4), here + s1, - s1, + s2, - s2 (metres): drain_probed's, its
// levels' segments read from the field's grids.
pub fn field_drain(reaches: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>, a: Anchor, e: vec3<f32>,
                   radius: f32, cell: f32, seed: i32, s1: vec3<f32>, s2: vec3<f32>, np: i32) -> Drain {
    let f = field_frame(a, radius);
    let centre = field_centre(a);
    let up = normalize(a.dir + e);
    let q0 = vec_local(f, e - a.dir_lo) * radius;
    var q: array<vec2<f32>, 5>;
    q[0] = q0;
    q[1] = q0 + vec_local(f, s1);
    q[2] = q0 - vec_local(f, s1);
    q[3] = q0 + vec_local(f, s2);
    q[4] = q0 - vec_local(f, s2);
    // A segment this far past a valley adds nothing at any of the points.
    let spread = max(length(vec_local(f, s1)), length(vec_local(f, s2)));
    var rel: array<f32, 5>;
    var acc: array<f32, 5>;
    for (var p: i32 = 0; p < 5; p += 1) {
        rel[p] = 1.0;
        acc[p] = 0.0;
    }
    let sg = cell_spread(cell);
    var t = tally_none();
    let dry = dryness(up, seed);
    let st = strengths(dry, 0.0, radius);
    var drop: array<f32, 4>;

    // Level 0: the reaches from the 5 x 5 rivers' points about here.
    let l0 = spacing(0, radius);
    let w0 = VALLEY * l0;
    let f0 = fade(l0, cell);
    let ct = cell_of(centre);
    let c0 = cell_virtual(up, ct.x, RIV_N) - ct.yz;
    var zsum: f32 = 0.0;
    var wsum: f32 = 0.0;
    var dmin: f32 = 1.0e9;
    for (var m: i32 = 0; m < 25; m += 1) {
        let s = field_reach_seg(reaches, c0.x + m % 5 - 2, c0.y + m / 5 - 2);
        if (s.c.z > 0.0) {
            let ch = chord(s.a, q0);
            let wt = base_weight(ch.x / l0);
            zsum += wt * mix(s.b.z, s.b.w, ch.y / ch.z);
            wsum += wt;
            if (f0 > 0.0) {
                for (var p: i32 = 0; p < np; p += 1) {
                    let dt = seg_dist(s, q[p], 0, w0, seed);
                    acc[p] += valley_term(s, dt, 0, w0);
                    if (p == 0) {
                        if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, 0, w0)); }
                        t = tally_water(t, s, dt.x, 0, 1.0, sg);
                    }
                }
            }
        }
    }
    let base = wsum > 0.0 ? zsum / wsum : 0.0;
    for (var p: i32 = 0; p < np; p += 1) { rel[p] = rel_after(1.0, acc[p], 0.0, f0); }
    t = tally_level(t, 0, dmin, w0, f0, 1.0);

    // Levels 1 on, each from its grid while the cells resolve them; past
    // that each the mean over its valleys.
    var resolved = f0 > 0.0;
    var ubar: f32 = 0.0;
    for (var k: i32 = 1; k <= DRAIN_LEVELS; k += 1) {
        let lk = spacing(k, radius);
        let wk = VALLEY * lk;
        let sig = rise(k);
        let fk = fade(lk, cell);
        let ak = comp4(st, k - 1);
        let before = rel[0];
        if (!resolved || fk <= 0.0) {
            ubar = ubar_next(ubar, k);
            for (var p: i32 = 0; p < np; p += 1) { rel[p] = mean_rel(rel[p], ubar); }
            t = tally_level(t, k, 1.0e9, wk, 0.0, ak);
            drop[k - 1] = before - rel[0];
            resolved = false;
            continue;
        }
        // The streams about here: the level above's 3 x 3 about here.
        var near = near_none();
        if (k == 1) {
            for (var m: i32 = 0; m < 9; m += 1) {
                near = near_try(near, field_reach_seg(reaches, c0.x + m % 3 - 1, c0.y + m / 3 - 1), q0, sig, lk);
            }
        } else {
            let np1 = RIV_N << (2 * (k - 1));
            let cp = cell_in(centre, np1);
            let qp = cell_virtual(up, cp.x, np1) - cp.yz;
            for (var m: i32 = 0; m < 9; m += 1) {
                near = near_try(near, field_seg(segs, k - 1, qp.x + m % 3 - 1, qp.y + m / 3 - 1), q0, sig, lk);
            }
        }
        let uq = streams_about(near, sig);
        ubar = uq < 1.0e8 ? uq : ubar_next(ubar, k);
        // The valleys of the 5 x 5 links about here.
        let n = RIV_N << (2 * k);
        let ck = cell_in(centre, n);
        let qv = cell_virtual(up, ck.x, n) - ck.yz;
        for (var p: i32 = 0; p < np; p += 1) { acc[p] = 0.0; }
        dmin = 1.0e9;
        for (var m: i32 = 0; m < 25; m += 1) {
            let at = seg_at(k, qv.x + m % 5 - 2, qv.y + m / 5 - 2);
            let a4 = segs[at];
            if (seg_far(a4, q0, 2.0 * wk + spread)) { continue; }
            let s = seg_unpacked(a4, segs[at + 1]);
            if (s.c.z > 0.0) {
                for (var p: i32 = 0; p < np; p += 1) {
                    let dt = seg_dist(s, q[p], k, wk, seed);
                    acc[p] += valley_term(s, dt, k, wk);
                    if (p == 0) {
                        if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, k, wk)); }
                        t = tally_water(t, s, dt.x, k, fk, sg);
                    }
                }
            }
        }
        for (var p: i32 = 0; p < np; p += 1) { rel[p] = rel_after(rel[p], acc[p], ubar, fk); }
        t = tally_level(t, k, dmin, wk, fk, ak);
        drop[k - 1] = before - rel[0];
    }
    return drain_of(base, rel[0], t, vec4<f32>(rel[1], rel[2], rel[3], rel[4]),
                    vec4<f32>(drop[0], drop[1], drop[2], drop[3]), dry);
}
