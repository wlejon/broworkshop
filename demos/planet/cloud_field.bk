// The cloud field as the view reads it at a point (clouds_volume.bk): the
// column's amount and the variance of what is finer, from the column tile
// cache at the point's footprint (clouds.bk k_cloud_tile); the detail the
// footprint resolves over it; the sun field's depths and the neighbours'
// columns toward the sun (k_cloud_sun); and a ray's height in the layer.
// The volume's bindings and values live here, as every reader takes them.
module planet::cloud_field;

import custom;
import tiles;
from planet::clouds import NOISE_VAR, CLOUD_BASE, CLOUD_DEPTH, CLOUD_DETAIL_FULL, cloud_occupancy, COLUMN_F_RANGE,
                           COLUMN_V_RANGE, SUN_TAU_MAX, SUN_LOWEST, SUN_SPACING;

// The node's values (clouds.js update): the planet's radius; the detail's
// billow statistics and variance (clouds.js noiseSlices, CLOUD_DETAIL_VAR);
// the eye about the centre as an f32 and the rest; its altitude over the
// radius; the least and most lift a ray from the eye can meet; the near
// grid's range (0 off).
pub struct Params {
    radius: f32,
    billow_mean: f32,
    billow_var: f32,
    detail_var: f32,
    cam_hi: vec3<f32>,
    cam_lo: vec3<f32>,
    cam_alt: f32,
    lift_range: vec2<f32>,
    near_range: f32,
}
@binding(4, 0) pub var params: uniform<Params>;

// The lift on the globe's six faces; the detail's noise, a tiling 3D
// texture.
@binding(4, 2) var lift_faces: texture2d_array<vec4<f32>>;
@binding(4, 3) var noise: texture3d<vec4<f32>>;
// The column field (clouds.bk k_cloud_tile): a tile cache over the
// cube-sphere, each tile's cells the column (amount, variance) at a
// footprint of two of them, found through its lookup (tiles.bk) and read
// from a texture array of the cache's pool, 2 x 2 slots a layer; and per tile
// level, the footprint of its cells at a face's centre and the gradient
// bound of the column there (clouds.js gradientBound).
@binding(4, 4) var columns: texture2d_array<vec4<f32>>;
@binding(4, 14) var lookup: read_buffer<vec4<i32>>;
@binding(4, 16) var bounds: read_buffer<vec4<f32>>;
// The sun field (clouds.bk k_cloud_sun), alike: four optical depths a cell.
@binding(4, 5) var sun_field: texture2d_array<vec4<f32>>;
// The neighbours' shade (k_cloud_sun far4): the depth toward the sun from
// 160 m to 1400 m out at the same four heights, alike.
@binding(4, 6) var sun_far: texture2d_array<vec4<f32>>;

// The cache's tiles (clouds.js TILE, TILE_BORDER, TILE_LEVELS), and the
// lift's faces (FACE + 2 texels of LIFT_DELTA of the plane).
const TILE: i32 = 64;
const TILE_BORDER: i32 = 1;
const TILE_LEVELS: i32 = 13;
const TILE_ATLAS: i32 = 2;
const CLOUD_FACE: i32 = 258;
const LIFT_DELTA: f32 = 0.007843137;
// The finest footprint the column resolves (clouds.bk CLOUD_COLUMN_MIN).
const CLOUD_COLUMN_MIN: f32 = 60.0;
pub const CLOUD_LIFT_SLOPE: f32 = 0.05;   // a bound on the lift's gradient (m/m)
// The noise texture: NOISE_CELL texels a lattice unit, NOISE_TEXELS a side.
const NOISE_CELL: f32 = 4.0;
const NOISE_TEXELS: f32 = 64.0;

pub fn detail_scale(f: f32) -> f32 {
    return clamp(f / CLOUD_DETAIL_FULL, 0.0, 1.0);
}

// The lift's face at the unit direction q (the largest axis), and q's texel
// coordinates on it.
struct FacePoint {
    face: i32,
    t: vec2<f32>,
}
fn face_of(q: vec3<f32>) -> FacePoint {
    let m = abs(q);
    var r: vec3<f32> = q.zxy;
    var axis: i32 = 2;
    if (m.x >= m.y && m.x >= m.z) {
        r = q;
        axis = 0;
    } else if (m.y >= m.z) {
        r = q.yzx;
        axis = 1;
    }
    let uv = r.yz / abs(r.x);
    let delta = LIFT_DELTA;
    let t = clamp((uv + 1.0 + delta) / delta, vec2<f32>(0.0), vec2<f32>((CLOUD_FACE as f32) - 1.001));
    var face: i32 = axis;
    if (r.x < 0.0) {
        face = axis + 3;
    }
    return FacePoint { face: face, t: t };
}

// The layer's lift at the unit direction q (clouds.bk k_cloud_lift): its base
// stands CLOUD_BASE over it.
fn lift(q: vec3<f32>) -> f32 {
    let p = face_of(q);
    let uv = (p.t + 0.5) / (CLOUD_FACE as f32);
    return lift_faces.sample_lod(custom::linear, vec3<f32>(uv.x, uv.y, p.face as f32), 0.0).x;
}

// Tile t's column at p, filtered by the hardware from its layer (the
// packed column's two 16-bit halves read as unorm16, clouds.bk
// pack_column).
fn tile_column(t: tiles::Tile, p: tiles::Point) -> vec2<f32> {
    let w = columns.sample_lod(custom::linear, tiles::atlas_uvw(t, p, TILE, TILE_BORDER, TILE_ATLAS), 0.0);
    return vec2<f32>(w.x * (2.0 * COLUMN_F_RANGE) - COLUMN_F_RANGE, w.y * COLUMN_V_RANGE);
}

// The column's amount F at the layer point q resolved at a footprint of w
// metres, and the variance of what is finer: between the two tile levels
// whose footprints bracket w, as a mip's levels blend, each from the finest
// ready tile holding q at that level or coarser (where the cache has not
// refined that far: out of view, or still producing). The cache refines
// wherever the view's footprints need it, so the whole view reads its own
// footprint. `cloud` false when even 3.4 deviations of what is finer cannot
// lift it to need, with `clear` the distance (m) within which the level's
// own amount cannot either, given that need falls by at most drop a metre
// along the way: how far a ray may step and find no cloud.
pub struct Column {
    cloud: bool,
    f: f32,
    variance: f32,
    clear: f32,
}
// The tiles a column at a point is read from: the level its footprint falls
// at (l, between levels k and k + 1), the finest ready tile at k + 1 or
// coarser, and the coarser of the two the column blends (the same tile when
// fine is coarser than k + 1), with the root they are on.
pub struct Tiles {
    root: i32,
    l: f32,
    k: i32,
    fine: tiles::Tile,
    coarse: tiles::Tile,
}
fn level_at(p: tiles::Point, w: f32) -> f32 {
    // The footprint of a level-0 tile's cells here: at a face's centre, by
    // the plane's stretch (clouds.bk k_cloud_tile).
    let uv = vec2<f32>(p.u, p.v) * 2.0 - 1.0;
    let stretch = sqrt(1.0 + max(uv.x * uv.x, uv.y * uv.y)) / (1.0 + dot(uv, uv));
    return tiles::level_for(max(w, CLOUD_COLUMN_MIN), bounds[0].x * stretch, TILE_LEVELS);
}
pub fn tiles_at(p: tiles::Point, w: f32) -> Tiles {
    let l = level_at(p, w);
    let k = min(l as i32, TILE_LEVELS - 1);
    let fine = tiles::locate(lookup, p, k + 1);
    var coarse: tiles::Tile = fine;
    if (fine.slot >= 0 && fine.level == k + 1) {
        // Its parent, as a mip's next level; found again only if it is not
        // ready.
        coarse = tiles::parent_of(fine);
        if (coarse.slot < 0) {
            coarse = tiles::locate(lookup, p, k);
        }
    }
    return Tiles { root: p.root, l: l, k: k, fine: fine, coarse: coarse };
}
// The cloud's optical depth toward the sun from height share s at p, by the
// sun field of the tiles the column is read from (blended as it is), between
// its four heights and to nothing at the top; past the field, more than any.
pub fn field_tau(p: tiles::Point, t: Tiles, s: f32) -> f32 {
    if (t.fine.slot < 0) {
        return 1.0e9;
    }
    var f: vec4<f32> = sun_field.sample_lod(custom::linear, tiles::atlas_uvw(t.fine, p, TILE, TILE_BORDER, TILE_ATLAS), 0.0);
    if (t.fine.level == t.k + 1) {
        let c = sun_field.sample_lod(custom::linear, tiles::atlas_uvw(t.coarse, p, TILE, TILE_BORDER, TILE_ATLAS), 0.0);
        f = mix(c, f, t.l - (t.k as f32));
    }
    let x = clamp((s - SUN_LOWEST) / SUN_SPACING, 0.0, 3.0);
    let wts = max(vec4<f32>(1.0) - abs(vec4<f32>(x) - vec4<f32>(0.0, 1.0, 2.0, 3.0)), vec4<f32>(0.0));
    let top = SUN_LOWEST + 3.0 * SUN_SPACING;
    return dot(f, wts) * SUN_TAU_MAX * clamp((1.0 - s) / (1.0 - top), 0.0, 1.0);
}

// The neighbours' columns toward the sun from p (sun_far: the column
// SUN_FAR_NEAR and SUN_FAR_OUT metres out, amount and variance each), read
// as the sun field is; none past the field.
pub fn far_columns(p: tiles::Point, t: Tiles) -> vec4<f32> {
    if (t.fine.slot < 0) {
        return vec4<f32>(-COLUMN_F_RANGE, 0.0, -COLUMN_F_RANGE, 0.0);
    }
    var f: vec4<f32> = sun_far.sample_lod(custom::linear, tiles::atlas_uvw(t.fine, p, TILE, TILE_BORDER, TILE_ATLAS), 0.0);
    if (t.fine.level == t.k + 1) {
        let c = sun_far.sample_lod(custom::linear, tiles::atlas_uvw(t.coarse, p, TILE, TILE_BORDER, TILE_ATLAS), 0.0);
        f = mix(c, f, t.l - (t.k as f32));
    }
    return vec4<f32>(f.x * (2.0 * COLUMN_F_RANGE) - COLUMN_F_RANGE, f.y * COLUMN_V_RANGE,
                     f.z * (2.0 * COLUMN_F_RANGE) - COLUMN_F_RANGE, f.w * COLUMN_V_RANGE);
}
// The occupancy of a column (f, variance) read alone, at height share s.
pub fn far_occupancy(f: f32, v: f32, s: f32) -> f32 {
    if (s > 1.0) {
        return 0.0;
    }
    let g = detail_scale(f);
    return cloud_occupancy(f, v + params.detail_var * g * g, s);
}

pub fn column_in(p: tiles::Point, t: Tiles, need: f32, drop: f32) -> Column {
    if (t.fine.slot < 0) {
        return Column { cloud: false, f: 0.0, variance: 0.0, clear: 1.0e6 };
    }
    var c: vec2<f32> = tile_column(t.fine, p);
    var level: i32 = t.fine.level;
    if (t.fine.level == t.k + 1) {
        c = mix(tile_column(t.coarse, p), c, t.l - (t.k as f32));
        level = t.coarse.level;
    }
    let g = detail_scale(c.x);
    let variance = c.y + params.detail_var * g * g;
    let reach = 3.4 * sqrt(variance);
    if (c.x + reach < need) {
        return Column { cloud: false, f: c.x, variance: variance, clear: (need - c.x - reach) / (bounds[level].y + drop) };
    }
    return Column { cloud: true, f: c.x, variance: variance, clear: 0.0 };
}

// The cloud's own relief, in three dimensions: the column is the same at
// every height, so its sides would be its pattern drawn straight up (walls
// streaked toward the zenith seen from under them). Octaves of gradient noise
// over space are added to the column's amount, billows of a few hundred
// metres in its sides, base and tops (the erosion of Schneider's Nubis), in
// proportion to the column's amount up to CLOUD_DETAIL_FULL, so a column
// barely short of cloud stays clear. A column read alone carries their
// variance as unresolved (params.detail_var), so the shadows, the light's
// tops and far pixels see what they average to; where a sample resolves them
// (detailed) they are added and their share of the variance taken back out.
// The finer two are billows, the noise's magnitude less its mean: lobes
// bounded by creases where it crosses zero, a cumulus's cauliflower.
fn noise_at(p: vec3<f32>) -> f32 {
    return noise.sample_lod(custom::repeat, (p * NOISE_CELL + 0.5) / NOISE_TEXELS, 0.0).x;
}
// One octave of wavelength lambda, amplitude amp and offset off at P, at
// weight g (detail_scale) over r (F, variance); `billow` its magnitude.
fn octave(r: vec2<f32>, p: vec3<f32>, w: f32, g: f32, lambda: f32, amp: f32, off: f32, billow: bool) -> vec2<f32> {
    // At full weight from 4 footprints a wavelength, none at 2.
    let a = clamp(lambda / w * 0.5 - 1.0, 0.0, 1.0);
    if (a <= 0.0) {
        return r;
    }
    let n = noise_at(p / lambda + off);
    if (billow) {
        return vec2<f32>(r.x + a * g * amp * (abs(n) - params.billow_mean),
                         r.y - a * a * g * g * amp * amp * params.billow_var);
    }
    return vec2<f32>(r.x + a * g * amp * n, r.y - a * a * g * g * amp * amp * NOISE_VAR);
}
// The column's (F, variance) with the detail a footprint of w metres
// resolves at P (about the centre).
pub fn detailed(p: vec3<f32>, w: f32, f: f32, variance: f32) -> vec2<f32> {
    let g = detail_scale(f);
    var r: vec2<f32> = vec2<f32>(f, variance);
    if (g > 0.0) {
        r = octave(r, p, w, g, 480.0, 0.07, 0.0, false);
        r = octave(r, p, w, g, 190.0, 0.04, 17.0, false);
        r = octave(r, p, w, g, 85.0, 0.03, 5.3, true);
        r = octave(r, p, w, g, 38.0, 0.02, 11.7, true);
    }
    return vec2<f32>(r.x, max(r.y, 0.0));
}

// The height share s of the layer at distance t along the ray from the eye
// (an altitude of hc, mu the cosine to up), and the point's direction.
pub struct Height {
    p: vec3<f32>,
    up: vec3<f32>,
    s: f32,
}
pub fn height_at(eye: vec3<f32>, dir: vec3<f32>, t: f32, hc: f32, mu: f32) -> Height {
    let p = eye + dir * t;
    let rp = length(p);
    let h = hc + (2.0 * (params.radius + hc) * mu * t + t * t) / (rp + params.radius + hc);
    let up = p / rp;
    return Height { p: p, up: up, s: (h - CLOUD_BASE - lift(up)) / CLOUD_DEPTH };
}
