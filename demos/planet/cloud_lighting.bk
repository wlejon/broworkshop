// How a sample of the clouds is lit (clouds_volume.bk): the sun through the
// cloud between the point and it (the column above up to its top, the
// billows' own shade toward it, then the neighbours' columns: bright tops,
// shaded far sides, grey bases), scattered in a two-lobed phase (the silver
// lining toward the sun), with the light scattered many times as two-stream
// diffusion carries it in; the sky from above through the depth over the
// point; each integrated over a step in closed form (Hillaire 2016). Four
// sub-columns at once (clouds_volume.bk's march), each its own vec4 lane.
module planet::cloud_lighting;

from planet::clouds import CLOUD_DEPTH, CLOUD_SIGMA, cloud_top, cloud_occupancy, SUN_FAR_NEAR, SUN_FAR_OUT;
from planet::cloud_field import detailed, far_occupancy;

// The sub-columns' ranks, the cloudiest first to fill.
pub const CLOUD_RANK = vec4<f32>(3.0, 2.0, 1.0, 0.0);
// Each sub-column's amount about the column's, at its rank's quantile of the
// occupancy's logistic, in deviations: ln(p / (1 - p)) / 1.7 at p = 1/8,
// 3/8, 5/8, 7/8.
const CLOUD_QUANTILE = vec4<f32>(-1.1446, -0.3011, 0.3011, 1.1446);
const CLOUD_TOP_SOFT: f32 = 0.04;   // of the layer's height, about 100 m

// The light a step of length dt scatters toward the eye, per unit of the
// source at its start, from a medium of extinction sigma whose light dims
// along the step at a further rate: sigma * the integral over x of
// exp(-(sigma + rate) x). Four sub-columns at once, each its own length.
pub fn step_light(sigma: vec4<f32>, rate: vec4<f32>, dt: vec4<f32>) -> vec4<f32> {
    let r = sigma + rate;
    let some = step(vec4<f32>(1.0e-7), abs(r));
    let rs = mix(vec4<f32>(1.0), r, some);
    return mix(sigma * dt, sigma * (1.0 - exp(-rs * dt)) / rs, some);
}

// The sun's light a step of length dt scatters toward the eye, per unit of
// the sun's: sigma * the integral over x of exp(-sigma x) times the sun
// through the cloud, exp(-(tau0 + rate x)). A ray rising toward a low sun
// crosses less cloud toward it as it goes, at a rate that can pass the
// extinction, but the sun's depth only falls to nothing, at x0, and from
// there the step sees it whole. Written with each exponent whole, none of
// them positive: taken apart, one overflowed to infinity where the other was
// nothing, a NaN, and a white blot on every cloud at dusk.
pub fn sun_step(sigma: vec4<f32>, tau0: vec4<f32>, rate: vec4<f32>, dt: vec4<f32>) -> vec4<f32> {
    let falling = vec4<f32>(1.0) - step(vec4<f32>(0.0), rate);
    let x0 = mix(dt, min(tau0 / max(-rate, vec4<f32>(1.0e-9)), dt), falling);
    let r = sigma + rate;
    let e0 = exp(-tau0);
    let e1 = exp(-tau0 - r * x0);
    let some = step(vec4<f32>(1.0e-7), abs(r));
    let lit = mix(sigma * x0 * e0, sigma * (e0 - e1) / mix(vec4<f32>(1.0), r, some), some);
    return lit + exp(-sigma * x0) - exp(-sigma * dt);
}

fn hg_phase(g: f32, c: f32) -> f32 {
    let k = 1.0 + g * g - 2.0 * g * c;
    return (1.0 - g * g) / (12.566 * k * sqrt(k));
}
// Single scattering's forward and back lobes (the silver lining; the dimmer
// glow away from the sun).
pub fn phase(cos_sun: f32) -> f32 {
    return mix(hg_phase(-0.25, cos_sun), hg_phase(0.8, cos_sun), 0.7);
}

// The sun's light scattered many times toward the eye, per unit of the
// sun's and of the light scattered, at a depth tau_sun toward a sun at mu_s
// over the horizon: near a surface it falls fast with the depth the sun
// crossed (the first few scatterings, Wrenninge's octaves), deep in as slowly
// as diffusion through a thick slab carries it, 1 / (1 + 0.75 (1 - g) tau),
// so a deck's top glows near white and its base is a lit grey. The sky's the
// same, through the depth straight up.
//
// What enters is the sun's flux through the cloud's surface. The diffusion
// deep in is fed through a deck's top, the sun's flux on the level, mu_s of
// it; but the first scatterings are near the surface the sun's ray came in
// by (tau_sun is along that ray), and a cumulus's billows face a low sun
// with their sides: MANY_FACING of the way from the level to facing it. At
// mu_s alone, a low sun lit every top through its weak back lobe only, the
// clouds seen from above at dusk a flat mauve-brown where they glow gold on
// every bump toward the sun, dark between.
const MANY_FACING: f32 = 0.5;
// The first scatterings' share. A thick deck under a high sun, seen from
// above, sends back about 0.8 of a white card's light (conservative
// scattering, g 0.85); at 0.55 its tops sent back 0.58, and from orbit every
// cumulus was a dull grey not much brighter than the forest under it.
const MANY_FIRST: f32 = 1.1;
pub fn sun_many(tau_sun: vec4<f32>, mu_s: f32) -> vec4<f32> {
    return (0.85 / 3.14159) * (MANY_FIRST * mix(mu_s, 1.0, MANY_FACING) * exp(-0.6 * tau_sun)
                               + 0.45 * mu_s / (1.0 + 0.1125 * tau_sun));
}
pub fn sky_many(tau_sun: vec4<f32>, mu_s: f32) -> vec4<f32> {
    return 1.0 / (1.0 + 0.1125 * mu_s * tau_sun);
}

// The sub-columns' tops of a column (F, v).
fn tops(f: f32, v: f32) -> vec4<f32> {
    let dev = sqrt(v);
    return vec4<f32>(cloud_top(f + dev * CLOUD_QUANTILE.x), cloud_top(f + dev * CLOUD_QUANTILE.y),
                     cloud_top(f + dev * CLOUD_QUANTILE.z), cloud_top(f + dev * CLOUD_QUANTILE.w));
}

// Those tops seen from height share s: cloud the detail lifts over the
// column's top is in the sun, reached through a smooth maximum over
// CLOUD_TOP_SOFT of the height (at a hard one, every such patch had a hard
// edge across the bases).
// Less the knee's own half-width, so a point at a top has nothing above it:
// with it, every top was lit through 60 m of cloud (an optical depth of
// 1.8 at its very surface), half its light, and from orbit, where the light
// comes from the tops' first tens of metres, the cumuli were a dull grey.
fn soft_tops(s: f32, f: f32, v: f32) -> vec4<f32> {
    let over = tops(f, v) - s;
    return s + 0.5 * (over + sqrt(over * over + CLOUD_TOP_SOFT * CLOUD_TOP_SOFT) - CLOUD_TOP_SOFT);
}

// The depth of cloud toward the sun from height share s of a column (F, v):
// through the column up to each sub-column's top (bright tops, dark bases),
// and how far each top is above. A top's far side shaded behind the bumps
// toward the sun is the billows' taps' (billow_tau) and the sun field's: a
// tap of the column the sun's ray reached 200 m over the highest top, read
// where the ray entered each cloud, for 0.15 ms a frame.
pub struct SunDepth {
    tau: vec4<f32>,
    above: vec4<f32>,
}
pub fn sun_depth(s: f32, f: f32, v: f32, mu_s: f32) -> SunDepth {
    let above = max(soft_tops(s, f, v) - s, vec4<f32>(0.0)) * CLOUD_DEPTH;
    return SunDepth { tau: CLOUD_SIGMA * above / mu_s, above: above };
}

// The billows' own shade. The column's depth toward the sun runs through the
// column to its tops, the same for a lobe toward the sun and the crease
// beside it, so near clouds were lit as smooth cotton. The first 160 m
// toward the sun are integrated through the field itself, its detail
// included (taps at 40 m and 160 m, trapezoids), and the column's depth past
// them added: a lobe's sunward face is lit through metres of itself, a
// crease shaded through the lobe beside it, and deep in, every tap in cloud,
// the depth is the column's. The rest is added even where the far tap is
// clear: a ray out through a crease meets the cloud's body again (weighted
// by the far tap's fill, a big cloud's lower half shone gold where it
// belongs in shade). The far tap reads at a footprint
// of half its distance (only the shape that far matters). The column is the
// sample's over the taps' few metres across; the detail carries their shape.
//
// Past them, the neighbours: the column a tower beside the point stands in
// is not the point's, so a top lower than the turret toward the sun was lit
// as if nothing stood there, and from orbit every deck was a flat grey cut-
// out. The columns SUN_FAR_NEAR and SUN_FAR_OUT metres toward the sun
// (sun_far, k_cloud_sun) are read at the ray's heights there, each stretch
// (160 m to the first, on to the second in two) passing 1 - fill of the light
// whole and the rest through its cloud, as the sun field's segments do (at
// the mean density instead, partial cover at a coarse footprint dimmed every
// near cloud grey); the depth is the larger of that and the column's, so a
// neighbour only ever adds shade, for 0.06 to 0.14 ms a frame.
fn tap_fill(p: vec3<f32>, s: f32, f: f32, v: f32, w: f32, to_sun: vec3<f32>, mu_s: f32, d: f32) -> vec4<f32> {
    let fd = detailed(p + to_sun * d, w, f, v);
    let occ = cloud_occupancy(fd.x, fd.y, s + d * mu_s / CLOUD_DEPTH);
    return clamp(occ * 4.0 - CLOUD_RANK, vec4<f32>(0.0), vec4<f32>(1.0));
}
pub fn billow_tau(p: vec3<f32>, s: f32, f: f32, v: f32, w: f32, to_sun: vec3<f32>, mu_s: f32, fill0: vec4<f32>, tau_col: vec4<f32>, fc: vec4<f32>) -> vec4<f32> {
    let f1 = tap_fill(p, s, f, v, w, to_sun, mu_s, 40.0);
    let f2 = tap_fill(p, s, f, v, max(w, 80.0), to_sun, mu_s, 160.0);
    let local = CLOUD_SIGMA * (20.0 * (fill0 + f1) + 60.0 * (f1 + f2));
    let near = local + max(tau_col - vec4<f32>(CLOUD_SIGMA * 160.0), vec4<f32>(0.0));
    let o3 = clamp(far_occupancy(fc.x, fc.y, s + SUN_FAR_NEAR * mu_s / CLOUD_DEPTH) * 4.0 - CLOUD_RANK, vec4<f32>(0.0), vec4<f32>(1.0));
    let o4 = clamp(far_occupancy(fc.z, fc.w, s + SUN_FAR_OUT * mu_s / CLOUD_DEPTH) * 4.0 - CLOUD_RANK, vec4<f32>(0.0), vec4<f32>(1.0));
    let pass3 = vec4<f32>(1.0) - 0.5 * (f2 + o3) * (1.0 - exp(-CLOUD_SIGMA * (SUN_FAR_NEAR - 160.0)));
    let pass4 = vec4<f32>(1.0) - 0.5 * (o3 + o4) * (1.0 - exp(-CLOUD_SIGMA * 0.5 * (SUN_FAR_OUT - SUN_FAR_NEAR)));
    let far = -log(max(pass3, vec4<f32>(1.0e-6))) - 2.0 * log(max(pass4, vec4<f32>(1.0e-6)));
    return max(near, local + far);
}
