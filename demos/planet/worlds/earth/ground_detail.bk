// Procedural noise, cliff strata, forest floor micro-relief, and sea wave
// slope helpers for Earth's shading of the ground (world_ground.bk). A
// `swell` coordinate is the ground's point modulo FAR_PERIOD (the hook's
// far coordinate), `q` modulo DETAIL_PERIOD.
module planet::ground_detail;

from planet::ground_layout import FACE_EXTENT, DETAIL_PERIOD, FAR_PERIOD, SEED,
    WAVE_COUNT, WAVE_SWELL, WAVE_RESIDUAL, WAVE_K, WAVE_F;
from planet::periodic import perlin_grad;

pub const FLOOR_LAST: f32 = 8.0;    // the floor's own relief's longest wavelength (m)
pub const FLOOR_RELIEF: f32 = 0.2;   // its slope per octave, per unit of the noise's gradient


// Bare rock in its beds at a point (metres about the planet's centre), as
// ground.bk bedded_surface lays it with strata: three scales of bed level
// along a surface folded by low-frequency noise, in log-luminance, each
// fading as the pixel's footprint spans it.
// A bed is a function of height alone: gradient noise along one axis, its
// gradients hashed from the lattice point (its variance is 0.0194; scaled to
// about 0.7 of a unit, as its even bands read stronger than 3D noise's).
fn bed_slope(i: f32, seed: i32) -> f32 {
    var h: u32 = ((i as i32) as u32) * 0x27d4eb2du ^ (seed as u32) * 0x165667b1u;
    h = (h ^ (h >> 15u)) * 0x85ebca6bu;
    h = h ^ (h >> 13u);
    return ((h & 65535u) as f32) / 32767.5 - 1.0;
}
fn cliff_band(level: f32, length: f32, footprint: f32, seed: i32) -> f32 {
    let x = level / length;
    let i = floor(x);
    let f = x - i;
    let s = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let n = mix(bed_slope(i, seed) * f, bed_slope(i + 1.0, seed) * (f - 1.0), s);
    let t = 6.2831853 * footprint / length;
    return n * 5.0 * exp(-0.5 * t * t);
}

// The beds are not ruled lines: they buckle by a few metres over tens
// (CLIFF_BUCKLE, at CLIFF_FOLD metres), and how strongly they show comes and
// goes across the face, so a wall reads as layered stone, weathered in
// places to one tone, rather than as even stripes. One noise for both (its
// value and one component of its gradient, a field of its own), from
// `swell`, the vertices' periodic position: p's f32 is half a metre at the
// planet's radius.
const CLIFF_FOLD: f32 = 64.0;
const CLIFF_BUCKLE: f32 = 8.0;
pub fn cliff_rock(p: vec3<f32>, swell: vec3<f32>, footprint: f32, stone: vec3<f32>) -> vec3<f32> {
    let h = length(p) - FACE_EXTENT * 0.63661977;   // FACE_EXTENT is a quarter of the circumference
    let fold = perlin_grad(swell / CLIFF_FOLD, (FAR_PERIOD / CLIFF_FOLD) as i32, SEED + 331);
    let level = h + perlin_grad(p * (1.0 / 3500.0), 4096, SEED + 307).x * 1600.0 + fold.x * CLIFF_BUCKLE;
    let shows = clamp(0.75 + 0.6 * (fold.y + fold.z), 0.15, 1.3);
    let bed = (0.10 * cliff_band(level, 9.0, footprint, SEED + 311)
             + 0.16 * cliff_band(level, 41.0, footprint, SEED + 313)
             + 0.18 * cliff_band(level, 130.0, footprint, SEED + 317)) * shows;
    // The region's stone (climate.bk, region_rock), as ground.bk
    // bedded_surface lays it.
    return stone * exp(bed) + vec3<f32>(0.03, 0.012, -0.012) * bed;
}

// Gradient noise in 2D (lattice units, periodic over `cells`, a power of
// two) and its gradient: x value, yz gradient. Half the 3D noise's corners,
// for relief that lies along the ground.
fn lattice_gradient2(c: vec2<i32>, cells: i32, seed: i32) -> vec2<f32> {
    let m = c & vec2<i32>(cells - 1);
    var h = ((m.x as u32) * 0x8da6b343u ^ (m.y as u32) * 0xd8163841u ^ (seed as u32)) * 0x27d4eb2du;
    h = h ^ (h >> 15u);
    let a = ((h >> 29u) as f32) * 0.78539816;
    return vec2<f32>(cos(a), sin(a));
}
fn perlin2_grad(x: vec2<f32>, cells: i32, seed: i32) -> vec3<f32> {
    let fl = floor(x);
    let i = vec2<i32>(fl.x as i32, fl.y as i32);
    let f = x - fl;
    let u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    let du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    let ga = lattice_gradient2(i, cells, seed);
    let gb = lattice_gradient2(i + vec2<i32>(1, 0), cells, seed);
    let gc = lattice_gradient2(i + vec2<i32>(0, 1), cells, seed);
    let gd = lattice_gradient2(i + vec2<i32>(1, 1), cells, seed);
    let va = dot(ga, f);
    let vb = dot(gb, f - vec2<f32>(1.0, 0.0));
    let vc = dot(gc, f - vec2<f32>(0.0, 1.0));
    let vd = dot(gd, f - vec2<f32>(1.0, 1.0));
    let k4 = va - vb - vc + vd;
    let value = va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * k4;
    let grad = ga + u.x * (gb - ga) + u.y * (gc - ga) + u.x * u.y * (ga - gb - gc + gd)
             + du * (vec2<f32>(vb - va, vc - va) + u.yx * k4);
    return vec3<f32>(value, grad);
}
// The floor's relief (fragment) in the plane of the two axes the ground's
// up is furthest from, its coordinates the vertices' periodic positions as
// they are (swell past a metre, q under): x its height in noise units, yzw
// its gradient (per unit of the noise's lattice). In the octaves at 8, 2
// and 0.5 m, each fading as a pixel spans it. Where two axes are about
// equally far from up (a band along the cube's diagonal planes) the two
// planes' blend, so the pattern changes there without a seam.
fn floor_plane(p: vec3<f32>, axis: i32) -> vec2<f32> {
    return axis == 0 ? p.yz : (axis == 1 ? p.zx : p.xy);
}
fn floor_axes(axis: i32, g: vec2<f32>) -> vec3<f32> {
    return axis == 0 ? vec3<f32>(0.0, g.x, g.y) : (axis == 1 ? vec3<f32>(g.y, 0.0, g.x) : vec3<f32>(g.x, g.y, 0.0));
}
fn floor_octaves(swell: vec3<f32>, q: vec3<f32>, axis: i32, footprint: f32) -> vec4<f32> {
    var out = vec4<f32>(0.0);
    var wl = FLOOR_LAST;
    for (var k: i32 = 0; k < 3; k += 1) {
        let w = clamp(wl / footprint * 0.5 - 1.0, 0.0, 1.0);
        if (w <= 0.0) { break; }
        let far = wl >= 1.0;
        let pg = perlin2_grad(floor_plane(far ? swell : q, axis) / wl, ((far ? FAR_PERIOD : DETAIL_PERIOD) / wl) as i32, 61 + k);
        out += vec4<f32>(pg.x, floor_axes(axis, pg.yz)) * w;
        wl *= 0.25;
    }
    return out;
}
pub fn floor_noise(swell: vec3<f32>, q: vec3<f32>, up: vec3<f32>, footprint: f32) -> vec4<f32> {
    let a = abs(up);
    let first = a.x >= a.y && a.x >= a.z ? 0 : (a.y >= a.z ? 1 : 2);
    let top = max(a.x, max(a.y, a.z));
    let next = first == 0 ? max(a.y, a.z) : (first == 1 ? max(a.x, a.z) : max(a.x, a.y));
    let second = first == 0 ? (a.y >= a.z ? 1 : 2) : (first == 1 ? (a.x >= a.z ? 0 : 2) : (a.x >= a.y ? 0 : 1));
    let blend = 0.5 * (1.0 - smoothstep(0.0, 0.03, top - next));
    var r = floor_octaves(swell, q, first, footprint);
    if (blend > 0.0) { r = mix(r, floor_octaves(swell, q, second, footprint), blend); }
    return r;
}

pub struct SeaResult {
    slope: vec3<f32>,
    variance: f32,
}
pub fn sea_slope(footprint: f32, up: vec3<f32>, v_swell: vec3<f32>, v_q: vec3<f32>, first: i32, time: f32) -> SeaResult {
    var slope = vec3<f32>(0.0);
    var variance: f32 = WAVE_RESIDUAL;
    for (var i: i32 = first; i < WAVE_COUNT; i += 1) {
        let k = WAVE_K[i];
        let f = WAVE_F[i];
        let w = clamp(k.w / footprint - 1.0, 0.0, 1.0);
        if (w <= 0.0) {
            variance += f.y;
            break;
        }
        let q = i < WAVE_SWELL ? v_swell : v_q;
        slope += k.xyz * (f.z * w * cos(dot(k.xyz, q) - f.x * time));
        variance += f.w * (1.0 - w);
    }
    return SeaResult { slope: slope - up * dot(slope, up), variance: variance };
}
