// The planet's surface colour, rock strata, vegetation cover, woodland
// mosaic, patch variation, and cell quadrature. Re-exported by ground.bk.
module planet::surface;

import std::noise::*;
from planet::rivers import Water, RIM_CREST, sea_water;
from planet::dendry import Drain, drained;
from planet::climate import Climate, cover_at, temp_at, snow_at;
from planet::relief import BASE_WAVELENGTH;
from planet::noise import normal_cdf;
from planet::world_lattice import VARY_FIRST, STRATA_FOLD, V, F;
from planet::anchor import Anchor, PerlinAt, twice, doubled, perlin_from;

fn p_offset(e: vec3<f32>, radius: f32) -> vec3<f32> {
    return e * (radius / BASE_WAVELENGTH);
}

// The ground at one height and gradient (tan of the angle from up): its
// albedo, and w = 1 for water.
pub fn surface(h: f32, grad: f32, c: Climate) -> vec4<f32> {
    return bedded_surface(h, grad, 0.0, c);
}

// Bedded rock: a cliff's face shows its beds as bands, lighter and warmer
// ones (sandstone, limestone) between darker ones (shale), each bed level
// along a surface folded by low-frequency noise, so the bands follow the
// strata rather than the contours. Three scales of bed, each gradient noise
// along the height on the fold (a line through the lattice, so the beds'
// thicknesses and tones are irregular, not a cosine's even stripes), in
// log-luminance at an amplitude of its deviation. Over a texel whose
// heights spread by sd, an octave of wavelength L averages to about itself
// times exp(-(2 pi sd / L)^2 / 2) (a sinusoid's mean under a normal), so a
// bed fades out where the texel spans it, and the far ground keeps the
// beds' mean. (The folds' wavelength, STRATA_FOLD metres, is anchor.bk's.)
const STRATA_FOLD_HEIGHT: f32 = 1600.0;   // the folds' height, per unit of noise
const STRATA_L0: f32 = 9.0;
const STRATA_L1: f32 = 41.0;
const STRATA_L2: f32 = 130.0;
const STRATA_A0: f32 = 0.10;
const STRATA_A1: f32 = 0.16;
const STRATA_A2: f32 = 0.18;

fn strata_band(level: f32, length: f32, track: f32, sd: f32, seed: i32) -> f32 {
    let n = perlin_f32(vec3<f32>(level / length, track, 0.5 * track), seed);
    let t = 6.2831853 * sd / length;
    return n / sqrt(PERLIN_VAR) * exp(-0.5 * t * t);
}

pub fn strata(a: Anchor, e: vec3<f32>, radius: f32, h: f32, sd: f32, seed: i32) -> f32 {
    let fold = perlin_at(perlin_from(a.l[F], e * (radius / STRATA_FOLD)), seed + 307) * STRATA_FOLD_HEIGHT;
    let level = h + fold;
    return STRATA_A0 * strata_band(level, STRATA_L0, 0.37, sd, seed + 311)
         + STRATA_A1 * strata_band(level, STRATA_L1, 0.61, sd, seed + 313)
         + STRATA_A2 * strata_band(level, STRATA_L2, 0.29, sd, seed + 317);
}

// surface with the rock's beds at `bed` (strata, log-luminance).
pub fn bedded_surface(h: f32, grad: f32, bed: f32, cl: Climate) -> vec4<f32> {
    if (h <= 0.0) { return vec4<f32>(sea_water(-h), 1.0); }
    // Beach at the shore; the climate's cover (climate.bk: desert, steppe,
    // savanna, grassland, forest, tundra by temperature and moisture) up to
    // the treeline, alpine meadow above it, bare scree higher still, snow
    // where it is cold enough; the region's rock wherever the ground is too
    // steep to hold soil (from about 38 degrees), snow where it is not too
    // steep to hold snow.
    let slope = 1.0 - 1.0 / sqrt(1.0 + grad * grad);
    let t = temp_at(cl, h);
    let beach = mix(vec3<f32>(0.50, 0.45, 0.34), cl.sand, 0.5);
    let cover = cover_at(cl, h);
    let alpine = mix(vec3<f32>(0.16, 0.17, 0.09), vec3<f32>(0.24, 0.21, 0.15), 1.0 - smoothstep(0.2, 0.5, cl.moist));
    let rock = cl.rock * exp(bed) + vec3<f32>(0.03, 0.012, -0.012) * bed;
    let snow = vec3<f32>(0.92, 0.94, 0.97);
    var c = mix(beach, cover.colour, smoothstep(1.0, 4.0, h));
    // Above the trees: alpine meadow, then scree.
    c = mix(c, alpine, (1.0 - smoothstep(-4.0, 0.0, t)) * smoothstep(0.15, 0.35, cl.moist));
    c = mix(c, rock, max(smoothstep(0.2, 0.4, slope), 1.0 - smoothstep(-8.0, -4.5, t)));
    c = mix(c, snow, snow_at(cl, h) * (1.0 - smoothstep(0.35, 0.6, slope)));
    return vec4<f32>(c, 0.0);
}

// The share of the ground at one height and gradient that grows grass (the
// grass blades' density, demos/planet/grass.js): surface's land past the
// beach, less the rock and the snow it lays over it.
pub fn grass_cover(h: f32, grad: f32, cl: Climate) -> f32 {
    if (h <= 0.0) { return 0.0; }
    let slope = 1.0 - 1.0 / sqrt(1.0 + grad * grad);
    var c = smoothstep(1.0, 4.0, h) * cover_at(cl, h).grass;
    c *= 1.0 - max(smoothstep(0.2, 0.4, slope), 1.0 - smoothstep(-8.0, -4.5, temp_at(cl, h)));
    c *= 1.0 - snow_at(cl, h) * (1.0 - smoothstep(0.35, 0.6, slope));
    return c;
}

// The share of the ground at one height and gradient under forest (the
// trees' density, demos/planet/trees.js): surface's forest band, less the
// rock and the snow it lays over it. Where the trees are not drawn the
// ground shader lays their average over surface's floor by this share
// (expected_cover, over a texel).
pub fn tree_cover(h: f32, grad: f32, cl: Climate) -> f32 {
    if (h <= 0.0) { return 0.0; }
    let slope = 1.0 - 1.0 / sqrt(1.0 + grad * grad);
    var c = smoothstep(4.0, 30.0, h) * cover_at(cl, h).forest;
    c *= 1.0 - smoothstep(0.2, 0.4, slope);
    c *= 1.0 - snow_at(cl, h);
    return c;
}

// Gallery woods: along a river's banks (rivers.bk Water.gallery) the ground
// is as wet as a much rainier climate's, and trees grow there in a strip
// however open the country, the lines of trees that draw every creek
// across a prairie or a savanna. `cover` is the land's own; the mosaic
// (wooded) is laid over the two, so a gallery runs in clumps and gaps
// rather than as one even ribbon.
const GALLERY_MOIST: f32 = 0.6;
pub fn banked(cover: f32, h: f32, grad: f32, cl: Climate, wa: Water) -> f32 {
    if (wa.gallery <= 0.0) { return cover; }
    let wet = Climate { temp: cl.temp, moist: min(cl.moist + GALLERY_MOIST, 1.0), sand: cl.sand, rock: cl.rock };
    return mix(cover, max(cover, tree_cover(h, grad, wet)), wa.gallery);
}

// The drainage's streams (dendry.bk) into the rivers' water w: their
// channels' share of a cell and their banks' gallery strip, where the
// climate is wet enough for them to run (dry washes elsewhere), and only on
// land h metres up out of the sea and any lake standing here: under one they
// drew their silt in lines across its water.
pub fn with_streams(w: Water, share: f32, gallery: f32, cl: Climate, h: f32) -> Water {
    let lake = w.lake > -1.0e8 && w.shore < RIM_CREST ? 1.0 - smoothstep(w.near.z, w.near.z + 1.0, h) : 0.0;
    let runs = smoothstep(0.12, 0.35, cl.moist) * smoothstep(0.0, 1.0, h) * (1.0 - lake);
    var o = w;
    o.near.y = max(w.near.y, share * runs);
    o.gallery = max(w.gallery, gallery * runs);
    o.channel = max(w.channel, 0.3 * share * runs);
    return o;
}

// Forests grow as a mosaic at every scale: whole forests and open country
// kilometres across, stands and clearings in them, glades of a few trees.
// The cover is scaled by 1 + W, W zero-mean gradient noise in octaves
// WOOD_FIRST (4.7 km) to WOOD_LAST (18 m) of the base wavelength on the
// variation's lattice (anchor.bk), and a tree stands where its site's pick
// is under that (trees.bk). With the forest only in stands of tens of
// metres, the land a few kilometres up was one even tone, its meadows and
// woods averaged away (under a dawn's haze the colour of water).
// woodland: W's octaves a cell resolves (x, the last by its fraction) and
// the variance of the rest (y); a site resolves them all.
const WOOD_FIRST: i32 = 9;
const WOOD_LAST: i32 = 17;
fn wood_amp(o: i32) -> f32 {
    if (o >= 15) { return 1.7; }
    return 1.25;
}
pub fn woodland(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> vec2<f32> {
    var lat = doubled(a.l[V], WOOD_FIRST - VARY_FIRST);
    var d = p_offset(e, radius) * exp2(WOOD_FIRST as f32);
    var s: f32 = 0.0;
    var v: f32 = 0.0;
    for (var o: i32 = WOOD_FIRST; o <= WOOD_LAST; o += 1) {
        let amp = wood_amp(o);
        let w = clamp(octaves - (o as f32), 0.0, 1.0);
        if (w > 0.0) {
            s += perlin_at(perlin_from(lat, d), seed + 4111 + o) * amp * w;
        }
        v += amp * amp * PERLIN_VAR * (1.0 - w * w);
        lat = twice(lat);
        d *= 2.0;
    }
    return vec2<f32>(s, v);
}
// The share of a cell under trees: the mean of clamp(cover (1 + W)) over
// it, W the resolved part plus a normal of the rest's variance (the clamp
// of a normal in closed form).
pub fn wooded(cover: f32, wood: vec2<f32>) -> f32 {
    let mu = cover * (1.0 + wood.x);
    let sg = cover * sqrt(wood.y);
    if (sg < 1e-4) { return clamp(mu, 0.0, 1.0); }
    let za = -mu / sg;
    let zb = (1.0 - mu) / sg;
    let pa = normal_cdf(za);
    let pb = normal_cdf(zb);
    let fa = 0.3989423 * exp(-0.5 * za * za);
    let fb = 0.3989423 * exp(-0.5 * zb * zb);
    return clamp(mu * (pb - pa) + sg * (fa - fb) + (1.0 - pb), 0.0, 1.0);
}

// The z with normal_cdf(z) = u: normal_cdf's tanh inverted, then its cubic
// solved by Newton from the linear guess (it is nearly linear, so three
// steps reach f32).
fn normal_quantile(u: f32) -> f32 {
    let x = clamp(2.0 * u - 1.0, -0.999999, 0.999999);
    let y = 0.5 * log((1.0 + x) / (1.0 - x)) / 0.7978846;
    var z = y;
    for (var i: i32 = 0; i < 3; i += 1) {
        z -= (z + 0.044715 * z * z * z - y) / (1.0 + 0.134145 * z * z);
    }
    return z;
}

// Gauss-Legendre nodes and weights on [0, 1]: x node, y weight.
fn gl5(i: i32) -> vec2<f32> {
    if (i == 0) { return vec2<f32>(0.0469101, 0.1184634); }
    if (i == 1) { return vec2<f32>(0.2307653, 0.2393143); }
    if (i == 2) { return vec2<f32>(0.5, 0.2844444); }
    if (i == 3) { return vec2<f32>(0.7692347, 0.2393143); }
    return vec2<f32>(0.9530899, 0.1184634);
}
// Gauss-Hermite nodes and weights for N(0, 1): x node, y weight.
fn gh3(i: i32) -> vec2<f32> {
    if (i == 0) { return vec2<f32>(-1.7320508, 0.1666667); }
    if (i == 1) { return vec2<f32>(0.0, 0.6666667); }
    return vec2<f32>(1.7320508, 0.1666667);
}

// The land's albedo varies in patches, lighter and darker, more and less ochre,
// at every scale from octave VARY_FIRST down, with equal contrast in each
// octave: log-normal factors on the albedo, independent of the height. A
// cell takes the octaves it resolves (the last weighted by its fraction),
// exp(S - var(S) / 2), which is the mean of the factor over all the octaves
// below, so a cell's factor is the average of its children's. The ground
// shader carries the octaves finer than any tile on per pixel. (VARY_FIRST
// is anchor.bk's: the anchor holds its lattice.)
// Var(perlin_at), measured over 200k samples.
const PERLIN_VAR: f32 = 0.0728;
const VARY_LUM: f32 = 0.11;    // log-luminance, per octave
const VARY_TINT: f32 = 0.05;   // ochre (tint_axis, log per channel), per octave
// Toward ochre and straw one way and deeper green the other; blue kept, as
// its share of the light does not swing between a dry patch and a lush one.
fn tint_axis() -> vec3<f32> { return vec3<f32>(1.0, 0.4, 0.0); }
const TINT_LAST: i32 = 20;
// Over a few metres to a few hundred (octaves 13 to 19, 290 m to 4.6 m)
// the patches are stronger: a meadow's clumps of other grasses and herbs,
// its dry straw beside lush green, where the variance of a grassland's
// greenness lies (remote sensing of grassland finds most of it at these
// scales); coarser the land is a region's, finer a sward's blades.
const PATCH_FIRST: i32 = 13;
const PATCH_LAST: i32 = 19;
const PATCH_LUM: f32 = 0.30;
const PATCH_TINT: f32 = 0.16;
const PATCH_CORR: f32 = 0.7;
const PATCH_CORR_REST: f32 = 0.71414;   // sqrt(1 - PATCH_CORR^2)
fn lum_amp(o: i32) -> f32 {
    if (o >= PATCH_FIRST && o <= PATCH_LAST) { return PATCH_LUM; }
    return VARY_LUM;
}
fn tint_amp(o: i32) -> f32 {
    if (o >= PATCH_FIRST && o <= PATCH_LAST) { return PATCH_TINT; }
    return VARY_TINT;
}

// Perlin noise at a lattice cell and the offset in it (anchor.bk
// perlin_from), or at an f32 point (perlin_f32: the strata's bands, the
// clouds' octaves, coarse beside f32's step there).
pub fn perlin_f32(q: vec3<f32>, seed: i32) -> f32 {
    let c = floor(q);
    return perlin_at(PerlinAt { cell: vec3<i32>(c.x as i32, c.y as i32, c.z as i32), f: q - c }, seed);
}
pub fn perlin_at(at: PerlinAt, seed: i32) -> f32 {
    let xf0 = at.f.x;
    let yf0 = at.f.y;
    let zf0 = at.f.z;
    let x0: i32 = at.cell.x * PRIME_X;
    let y0: i32 = at.cell.y * PRIME_Y;
    let z0: i32 = at.cell.z * PRIME_Z;
    let x1: i32 = x0 + PRIME_X;
    let y1: i32 = y0 + PRIME_Y;
    let z1: i32 = z0 + PRIME_Z;
    let xf1 = xf0 - 1.0;
    let yf1 = yf0 - 1.0;
    let zf1 = zf0 - 1.0;
    let u = interp_quintic<f32>(xf0);
    let v = interp_quintic<f32>(yf0);
    let w = interp_quintic<f32>(zf0);
    let g0 = mix(mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y0, z0), xf0, yf0, zf0),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y0, z0), xf1, yf0, zf0), u),
                 mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y1, z0), xf0, yf1, zf0),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y1, z0), xf1, yf1, zf0), u), v);
    let g1 = mix(mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y0, z1), xf0, yf0, zf1),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y0, z1), xf1, yf0, zf1), u),
                 mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y1, z1), xf0, yf1, zf1),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y1, z1), xf1, yf1, zf1), u), v);
    return mix(g0, g1, w);
}

pub fn variation(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> vec3<f32> {
    var lat = a.l[V];
    var d = p_offset(e, radius) * exp2(VARY_FIRST as f32);
    var lum: f32 = 0.0;
    var tint: f32 = 0.0;
    var vl: f32 = 0.0;
    var vt: f32 = 0.0;
    let n = ceil(octaves) as i32;
    for (var o: i32 = VARY_FIRST; o < n; o += 1) {
        let pa = perlin_from(lat, d);
        let w = clamp(octaves - (o as f32), 0.0, 1.0);
        let al = lum_amp(o) * w;
        let nl = perlin_at(pa, seed + 101 + o);
        lum += nl * al;
        vl += al * al * PERLIN_VAR;
        if (o < TINT_LAST) {
            let at = tint_amp(o) * w;
            // A meadow's light patches are its dry ones, straw, and its dark
            // ones lush: in the patch octaves the tint follows the
            // luminance at a correlation of PATCH_CORR (its variance kept).
            var nt = perlin_at(pa, seed + 211 + o);
            if (o >= PATCH_FIRST && o <= PATCH_LAST) { nt = PATCH_CORR * nl + PATCH_CORR_REST * nt; }
            tint += nt * at;
            vt += at * at * PERLIN_VAR;
        }
        lat = twice(lat);
        d *= 2.0;
    }
    let axis = tint_axis();
    let s = vec3<f32>(lum, lum, lum) + axis * tint;
    let v = vec3<f32>(vl, vl, vl) + axis * axis * vt;
    return exp(s - v * 0.5);
}

// The mean of `surface` over the truth under a cell: height N(h, sh^2), and
// the soil's gradient its own (soil.x along one axis) plus N(0, soil.y^2)
// along each. The height's spread is sh, what the cell does not resolve, with the
// cell's own slope across its width (`cell`, metres): a plane of gradient g
// over a square L wide varies by g^2 L^2 / 12. The shore is a step, which
// quadrature over the whole normal places only to its nearest node (a coast
// 4 m up read a quarter water), so the height splits there: the water takes
// its share P(h < 0) by quadrature over the water's quantiles (5 nodes), the
// land its share the same over the land's, each with 3 x 3 in the gradient.
// The land's albedo takes the cell's variation factor, its rock the beds'
// mean over the cell (`bed`, strata). The rock and snow are by the soil's
// slope (SOIL_OCTAVES): `soil` its gradient and spread, which for a cell
// finer than the soil's scale are its point's and 0.
pub fn expected_surface(h: f32, grad: f32, cell: f32, sh: f32, soil: vec2<f32>, vary: vec3<f32>, bed: f32,
                        cl: Climate, fl: vec2<f32>) -> vec4<f32> {
    var sum = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    let trend = grad * cell;
    let sd = max(sqrt(sh * sh + trend * trend / 12.0), 1e-6);
    let zs = -sea_height(h, fl) / sd;
    let wet = normal_cdf(zs);
    if (wet > 1e-5) {
        for (var i: i32 = 0; i < 5; i += 1) {
            let nh = gl5(i);
            let depth = min(h + sd * normal_quantile(wet * nh.x), 0.0);
            sum += surface(depth, 0.0, cl) * (wet * nh.y);
        }
    }
    let dry = 1.0 - wet;
    if (dry > 1e-5) {
        for (var i: i32 = 0; i < 5; i += 1) {
            let nh = gl5(i);
            let height = max(h + sd * normal_quantile(wet + dry * nh.x), 1e-3);
            for (var j: i32 = 0; j < 3; j += 1) {
                let gx = gh3(j);
                for (var k: i32 = 0; k < 3; k += 1) {
                    let gy = gh3(k);
                    let ex = soil.x + soil.y * gx.x;
                    let ey = soil.y * gy.x;
                    let s = bedded_surface(height, sqrt(ex * ex + ey * ey), bed, cl);
                    sum += vec4<f32>(s.xyz * vary, 0.0) * (dry * nh.y * gx.y * gy.y);
                }
            }
        }
    }
    return sum;
}

// The spread is the relief's before the drainage, which planes the land down
// toward its base level (a floodplain's floor stands flat a few metres over
// the sea) and leaves what lies under it as it is, so the sea's share is the
// undrained height's: `fl` the drainage's base and its slope d h / d h0 there
// (sea_floor).
pub fn sea_floor(h: f32, d: Drain, radius: f32) -> vec2<f32> {
    let rel0 = d.rel + d.drops.x + d.drops.y + d.drops.z + d.drops.w;
    let h0 = d.base + max(h - d.base, 0.0) / max(rel0, 0.02);
    return vec2<f32>(d.base, drained(h0, d.base, d.rel, d, radius).y);
}
fn sea_height(h: f32, fl: vec2<f32>) -> f32 {
    if (h <= fl.x) { return h; }
    let k = max(fl.y, 0.02);
    return fl.x > 0.0 ? fl.x + (h - fl.x) / k : h / k;
}

// tree_cover's mean over a cell, by expected_surface's quadrature over the
// heights and soil gradients the cell holds.
pub fn expected_cover(h: f32, grad: f32, cell: f32, sh: f32, soil: vec2<f32>, cl: Climate, fl: vec2<f32>) -> f32 {
    let trend = grad * cell;
    let sd = max(sqrt(sh * sh + trend * trend / 12.0), 1e-6);
    let wet = normal_cdf(-sea_height(h, fl) / sd);
    let dry = 1.0 - wet;
    var sum: f32 = 0.0;
    if (dry > 1e-5) {
        for (var i: i32 = 0; i < 5; i += 1) {
            let nh = gl5(i);
            let height = max(h + sd * normal_quantile(wet + dry * nh.x), 1e-3);
            for (var j: i32 = 0; j < 3; j += 1) {
                let gx = gh3(j);
                for (var k: i32 = 0; k < 3; k += 1) {
                    let gy = gh3(k);
                    let ex = soil.x + soil.y * gx.x;
                    let ey = soil.y * gy.x;
                    sum += tree_cover(height, sqrt(ex * ex + ey * ey), cl) * (dry * nh.y * gx.y * gy.y);
                }
            }
        }
    }
    return sum;
}

// The gradient (tan of the angle from up) of a surface whose neighbouring
// points across a cell differ by du and dv, at `up`.
pub fn gradient(du: vec3<f32>, dv: vec3<f32>, up: vec3<f32>) -> f32 {
    let cosine = clamp(abs(dot(normalize(cross(du, dv)), up)), 1e-3, 1.0);
    return sqrt(1.0 / (cosine * cosine) - 1.0);
}
