// Earth's shading of the ground (planet::world_ground, which the core's
// hook core/ground_mesh.bk calls; planet::ground_core is what it gives):
// the light its clouds and drawn trees take from a vertex (ground_sky), the
// relief's place and scales at a cell (ground_vertex), and each pixel
// (ground_fragment): the detail layer's colour and normal (its a the share
// of water, its byte the forest's) with the mountains' finer ridges, the
// shores, cliffs, the octaves of detail a pixel resolves, the canopy and
// forest floor past the drawn trees, the grass's floor, and the water's
// waves and glint.
//
// The clouds' shadow (clouds.js) at a footprint of w metres, and the sky
// they hide overhead: under a deck the blue sky is gone and the light is
// the grey the deck scatters down. Among drawn trees, their shadows
// (tree_crown.bk).
module planet::world_ground;
import scene;
import mesh;
import lighting;
import custom;
import tiles;
from planet::ground_layout import CELLS, BORDER, TILE, DETAIL, DETAIL_PERIOD, FAR_PERIOD, SEED, WIND,
    GL_TILE, GL_BORDER, GL_ATLAS, GL_LEVELS, WAVE_FRESH, WAVE_FRESH_SCALE;
from planet::ground_params import params;
from planet::ground_core import vec4_at, detail_texel, detail_alpha, bspline, GroundVarying, GroundFrag, lit;
from planet::relief import BASE_WAVELENGTH, RIDGE_LAST, RIDGE_PAST, FINE_FIRST, ridge_amp, span_at, mean_factor,
    ridge_cell_slope, kept_share;
from planet::noise import simplex_grad, simplex_past, simplex_twice, SimplexAt;
from planet::tree_crown import tree_shadow, TreePlace;
from planet::grass_floor import grass_floor, GrassPlace;
from planet::ground_detail import FLOOR_LAST, FLOOR_RELIEF, perlin_grad, cliff_rock, floor_noise, SeaResult, sea_slope;

@binding(4, 2) var cloud_ground: texture2d_array<vec4<f32>>;
@binding(4, 19) var cloud_lookup: read_buffer<vec4<i32>>;
// Each tile's relief anchors (produce.bk k_anchor), and each cell's offset in
// the relief's noise and its scales (produce.bk k_tile).
@binding(4, 20) var anchors: read_buffer<vec4<i32>>;
@binding(4, 21) var relief: read_buffer<vec4<f32>>;
const ANCHOR_VEC4S: i32 = 6;

const TREE_CROWNS: f32 = 0.7;
const CANOPY: vec3<f32> = vec3<f32>(0.026, 0.052, 0.019);
const CROWN_FIRST: f32 = 4.0;     // the crowns' texture's octaves (m), and per octave
const CROWN_LAST: f32 = 16.0;
const CROWN_LUM: f32 = 0.8;       // its log-luminance and its slope per unit of the noise's gradient
const CROWN_RELIEF: f32 = 0.5;
const VARY_LUM: f32 = 0.11;      // ground.bk VARY_LUM
const PERLIN_VAR: f32 = 0.0728;  // ground.bk PERLIN_VAR
const RELIEF: f32 = 0.08;        // slope per octave, per unit of the noise's gradient
const ROCK_LUM: f32 = 1.8;
const ROCK_RELIEF: f32 = 3.0;
// The forest's floor: needle and leaf litter, mossy in its hollows, over
// LITTER of the ground under the trees.
const LITTER: f32 = 0.8;
const NEEDLES: vec3<f32> = vec3<f32>(0.070, 0.047, 0.026);
const MOSS: vec3<f32> = vec3<f32>(0.030, 0.055, 0.016);
@knob const FRESH_GLOSS: f32 = 0.35;   // fresh water's roughness, of its ripples'
// Fresh water's lanes along the wind: STREAK_W metres across, STREAK_LEN
// between the samples averaged along it, how much they gather and calm the
// ripples (STREAK_RIPPLE) and tilt the surface (slope per unit of the
// noise's gradient).
// (A power of two, so the noise's period divides FAR_PERIOD: at 6 m the
// lanes jumped at every tile's edge, where the coordinates wrap.)
const STREAK_W: f32 = 8.0;
const STREAK_LEN: f32 = 6.0;
const STREAK_RIPPLE: f32 = 1.6;
const STREAK_SLOPE: f32 = 0.02;
// What the clouds leave of the light at the ground point g (about the
// planet's centre) over a footprint of w metres, from clouds.js's ground
// light cache (clouds.bk k_cloud_ground): the sun straight through (x),
// scattered down (y), and the sky's (z). Between the two tile levels whose
// cells bracket w, as mips blend, each the finest ready tile holding g at
// that level or coarser; clear sky before any is ready.
fn cloud_ground_at(t: tiles::Tile, p: tiles::Point) -> vec3<f32> {
    return cloud_ground.sample_lod(custom::linear, tiles::atlas_uvw(t, p, GL_TILE, GL_BORDER, GL_ATLAS), 0.0).xyz;
}
fn cloud_light_at(g: vec3<f32>, w: f32) -> vec3<f32> {
    let p = tiles::cube_point(normalize(g));
    let uv = vec2<f32>(p.u, p.v) * 2.0 - 1.0;
    let stretch = sqrt(1.0 + max(uv.x * uv.x, uv.y * uv.y)) / (1.0 + dot(uv, uv));
    let l = tiles::level_for(w, params.cloud_w0 * stretch, GL_LEVELS);
    let k = min(l as i32, GL_LEVELS - 1);
    let fine = tiles::locate(cloud_lookup, p, k + 1);
    if (fine.slot < 0) {
        return vec3<f32>(1.0, 0.0, 1.0);
    }
    var c: vec3<f32> = cloud_ground_at(fine, p);
    if (fine.level == k + 1) {
        var coarse: tiles::Tile = tiles::parent_of(fine);
        if (coarse.slot < 0) {
            coarse = tiles::locate(cloud_lookup, p, k);
        }
        if (coarse.slot >= 0) {
            c = mix(cloud_ground_at(coarse, p), c, l - (k as f32));
        }
    }
    return c;
}

// The light at a vertex, from the core's sun seen over the horizons and sky
// seen (GTAO's share), `rel` camera-relative, over a footprint of w metres:
// the clouds' and the drawn trees' shadows.
pub fn ground_sky(sun_in: f32, sky_seen: f32, rel: vec3<f32>, up: vec3<f32>, to_sun: vec3<f32>, w: f32) -> vec4<f32> {
    var sun_seen = sun_in;
    let sky = cloud_light_at((params.cam_hi + params.cam_lo) + rel, w);
    sun_seen *= sky.x;
    if (params.trees_far > 0.0 && length(rel) < params.trees_far) {
        let eye = (params.cam_hi - params.tree_o_hi) + (params.cam_lo - params.tree_o_lo);
        let place = TreePlace {
            o_hi: params.tree_o_hi, o_lo: params.tree_o_lo, lattice: params.tree_lattice,
            a: params.tree_a, e: params.tree_e, f: params.tree_f, uv: params.tree_uv,
        };
        sun_seen *= tree_shadow(place, eye + rel, eye, up, to_sun);
    }
    return vec4<f32>(sun_seen, sky_seen * sky.z, sky.x, sky.y);
}

// Where the cell is in the relief's noise from the tile's centre, through
// the warp (a.xyz), and how much the ground here moves with the relief's
// octaves below FINE_FIRST (uv.x), from it on (uv.y), and the octaves the
// drainage keeps whole (a.w; relief.bk kept_share; produce.bk k_tile).
pub fn ground_vertex(slot: i32, cx: i32, cy: i32) -> GroundVarying {
    let rl = relief[(slot * CELLS + cy) * CELLS + cx];
    let rs = bitcast<u32>(rl.w);
    let uv = vec2<f32>((rs & 2047u) as f32, ((rs >> 11u) & 2047u) as f32) * (1.5 / 2047.0) - vec2<f32>(0.5);
    let kept = ((rs >> 22u) as f32) * (1.5 / 1023.0) - 0.5;
    return GroundVarying { a: vec4<f32>(rl.xyz, kept), uv: uv };
}

// The region's stone at detail texel coordinate `tex` of tile `slot`: the
// four corners k_anchor stored (produce.bk), bilinear over the tile.
fn region_rock(slot: i32, tex: vec2<f32>) -> vec3<f32> {
    let w = bitcast<vec4<u32>>(anchors[slot * ANCHOR_VEC4S + 5]);
    let st = clamp(((tex + vec2<f32>(0.5)) / (DETAIL as f32) - vec2<f32>(0.5 + (BORDER as f32))) / (TILE as f32),
                   vec2<f32>(0.0), vec2<f32>(1.0));
    let r = mix(mix(unpack_unorm4x8(w.x).xyz, unpack_unorm4x8(w.y).xyz, st.x),
                mix(unpack_unorm4x8(w.z).xyz, unpack_unorm4x8(w.w).xyz, st.x), st.y);
    return r * r;
}

pub fn ground_fragment(g: GroundFrag, s_in: mesh::Surface) -> mesh::Surface {
    var s = s_in;
    let v_tex = g.tex;
    let v_height = g.height;
    let v_up = g.up;
    let v_q = g.q;
    let v_swell = g.far;
    let v_slot = g.slot;
    let footprint = g.footprint;
    let scales = g.world.uv;
    let kept = g.world.a.w;

    // The mountains' ridged octaves finer than the tile's texels, as the
    // truth has them (ground.bk relief), to what this pixel resolves (full
    // weight from 4 pixels a wavelength, none at 2, as the detail below):
    // each octave's slope at the pixel's mean factor less what the texel's
    // normal already holds, its slope at the texel's mean factor through
    // the central difference over two texels it is taken by (sinc(2 pi
    // span), ground.bk gradient_share). The same noise, from the
    // tile's anchor (produce.bk k_anchor), each octave's lattice twice the
    // last's, at the vertices' offset through the warp, scaled by how much
    // the ground here moves with them (scales), the gradient taken through
    // the warp's stretch. First, while little else is live: the noise
    // needs registers.
    let a = v_slot * ANCHOR_VEC4S;
    let a0 = anchors[a];
    let oct_pix = log2(BASE_WAVELENGTH / (2.5 * max(footprint, 1e-4)));
    // The octave whose wavelength is two pixels.
    let o_nyquist = log2(BASE_WAVELENGTH / (2.0 * max(footprint, 1e-4)));
    let o_end = min(ceil(o_nyquist) as i32, RIDGE_LAST);
    var ridges = vec3<f32>(0.0);
    if (max(max(abs(scales.x), abs(scales.y)), abs(kept)) > 0.002 && a0.w < o_end) {
        let a1 = anchors[a + 1];
        let oct_tex = bitcast<f32>(a1.w);
        // (Its cell is about the tile's texels: what sk lost is nothing.)
        var at = SimplexAt { cell: a0.xyz, sk: bitcast<vec4<f32>>(a1).xyz, res: vec3<f32>(0.0) };
        let dq = g.world.a.xyz;
        var lattice = exp2(a0.w as f32);
        var gq = vec3<f32>(0.0);
        // The mean factors octave by octave: the span doubles, so the factor
        // exp(-NOISE_BOX s^2) goes to its fourth power.
        var mf_pix = mean_factor(a0.w, oct_pix);
        var mf_tex = mean_factor(a0.w, oct_tex);
        for (var o: i32 = a0.w; o < o_end; o += 1) {
            let fo = o as f32;
            let fade_p = clamp(o_nyquist - fo, 0.0, 1.0);
            let fade_t = clamp(oct_tex + RIDGE_PAST - fo, 0.0, 1.0);
            let nq = simplex_grad(simplex_past(at, dq * lattice), SEED + 100 + o);
            var dr = ridge_cell_slope(nq.x, mf_pix) * fade_p;
            // What the texels hold of it (none past half its wavelength: no
            // slope taken).
            let x = 6.2831853 * min(span_at(o, oct_tex), 1.0);
            if (fade_t > 0.0 && x < 3.1415926) {
                dr -= ridge_cell_slope(nq.x, mf_tex) * fade_t * (sin(x) / x);
            }
            mf_pix *= mf_pix;
            mf_pix *= mf_pix;
            mf_tex *= mf_tex;
            mf_tex *= mf_tex;
            let scale = o < FINE_FIRST ? scales.x : mix(scales.y, kept, kept_share(o));
            gq += nq.yzw * (ridge_amp(o) * scale * dr * lattice);
            at = simplex_twice(at);
            lattice *= 2.0;
        }
        let gp = gq + bitcast<vec4<f32>>(anchors[a + 2]).xyz * gq.x + bitcast<vec4<f32>>(anchors[a + 3]).xyz * gq.y
               + bitcast<vec4<f32>>(anchors[a + 4]).xyz * gq.z;
        ridges = gp * (1.0 / BASE_WAVELENGTH);
    }

    // Bilinear over the four texels about this point. The layer's normals
    // face up, so a skirt seen from behind shades as the ground does.
    let fl_tex = floor(v_tex);
    let f = v_tex - fl_tex;
    let t0 = vec2<i32>(fl_tex.x as i32, fl_tex.y as i32);
    let d00 = detail_texel(v_slot, t0);
    let d10 = detail_texel(v_slot, t0 + vec2<i32>(1, 0));
    let d01 = detail_texel(v_slot, t0 + vec2<i32>(0, 1));
    let d11 = detail_texel(v_slot, t0 + vec2<i32>(1, 1));
    var col = mix(mix(d00.col, d10.col, f.x), mix(d01.col, d11.col, f.x), f.y);
    let forest = mix(mix(d00.cover, d10.cover, f.x), mix(d01.cover, d11.cover, f.x), f.y);
    var n = normalize(mix(mix(d00.nrm, d10.nrm, f.x), mix(d01.nrm, d11.nrm, f.x), f.y));
    var water = col.w;
    // The water's share, where there is any about, by a cubic B-spline
    // over the 4 x 4 texels around.
    if (max(max(d00.col.w, d10.col.w), max(d01.col.w, d11.col.w)) > 0.0) {
        let bx = bspline(f.x);
        let by = bspline(f.y);
        water = 0.0;
        for (var j: i32 = 0; j < 4; j += 1) {
            var row: f32 = 0.0;
            for (var i: i32 = 0; i < 4; i += 1) {
                row += vec4_at(bx, i) * detail_alpha(v_slot, t0 + vec2<i32>(i - 1, j - 1));
            }
            water += vec4_at(by, j) * row;
        }
    }
    // A shore the texels resolve runs as smoothly as their spline: from low
    // over a river its banks were drawn arcs. Finer than the texels the
    // edge is the pixel's: the spline's ramp sharpened to a couple of
    // pixels and shifted by noise from the texel's scale down to the
    // pixel's, so the bank wanders in bays and spits at every scale. The
    // noise is even about the spline's middle, so the water's share holds
    // on average and, farther off, resolves back to the texels'.
    let texel_m = footprint / max(max(length(dpdx(v_tex)), length(dpdy(v_tex))), 1e-6);
    if (water > 0.0 && water < 1.0 && texel_m > 2.0 * footprint) {
        var ragged: f32 = 0.0;
        var amp: f32 = 0.42;
        var wl = min(exp2(floor(log2(texel_m))), 256.0);
        for (var k: i32 = 0; k < 6 && wl > 2.0 * footprint; k += 1) {
            let far = wl >= 1.0;
            let pg = perlin_grad((far ? v_swell : v_q) / wl, ((far ? FAR_PERIOD : DETAIL_PERIOD) / wl) as i32, 71 + k);
            ragged += pg.x * amp * clamp(wl / footprint * 0.5 - 1.0, 0.0, 1.0);
            amp *= 0.6;
            wl *= 0.5;
        }
        let sharp = clamp(texel_m / footprint * 0.4, 1.0, 24.0);
        water = clamp((water - 0.5 + ragged) * sharp + 0.5, 0.0, 1.0);
    }

    // The octaves a pixel resolves: full weight from 4 pixels a
    // wavelength, none at 2.
    // A wall too steep to hold snow (from about 63 degrees, bare by 78) is
    // rock, its beds level along their folds at the pixel's own height,
    // where the texels' colours (snow on one, rock on the next across the
    // face) would run down it as stripes.
    let shed = (1.0 - smoothstep(0.2, 0.45, dot(n, normalize(v_up)))) * (1.0 - water);
    if (shed > 0.0) {
        let cliff = cliff_rock((params.cam_hi + params.cam_lo) + g.pos, v_swell, footprint, region_rock(v_slot, v_tex));
        col = vec4<f32>(mix(col.xyz, cliff, shed), col.w);
    }
    var lum: f32 = 0.0;
    var lum_var: f32 = 0.0;
    var wavelength: f32 = 0.125;
    // Where the ground stands steep, a texel spans more height than width,
    // and what is laid out across the sphere (the ridges' finer octaves, the
    // texels' colours) is drawn down the face as streaks. There the face
    // takes its relief from the 3D detail below, which varies down it as
    // across it, and the ridges' octaves fade.
    let steep = 1.0 - smoothstep(0.35, 0.75, dot(n, normalize(v_up)));
    var slope = ridges * (1.0 - steep);
    let hi_c = max(col.x, max(col.y, col.z));
    let lo_c = min(col.x, min(col.y, col.z));
    let rock = (1.0 - smoothstep(0.15, 0.45, (hi_c - lo_c) / max(hi_c, 1e-3))) * (1.0 - smoothstep(0.35, 0.6, hi_c));
    let lum_gain = mix(1.0, ROCK_LUM, rock);
    let relief_gain = mix(1.0, ROCK_RELIEF, rock);
    let texel = texel_m;
    // Past the drawn trees, the crowns' share of the ground (below): their
    // texture is the octaves of a crown and its neighbours (CROWN_FIRST to
    // CROWN_LAST metres), lit and shaded crowns and dark gaps, bumps the sun
    // lights, as long as a pixel resolves them. The texels hold none of it,
    // so it is weighed by the pixel alone; mean-preserving like the rest, so
    // farther off it averages to the canopy's colour. Without it the forest
    // past the drawn trees was a smooth sheet.
    let drawn = params.trees_far <= 0.0 ? 0.0 : smoothstep(params.trees_far, params.trees_far * (5.0 / 6.0), length(g.pos));
    let canopy = TREE_CROWNS * forest * (1.0 - drawn * drawn) * (1.0 - water);
    // (By the pixel's area, the root of its two footprints: seen low, a
    // pixel is long down the view and narrow across it, and the crowns
    // still show across it.)
    let foot_area = sqrt(length(dpdx(v_q)) * length(dpdy(v_q)));
    var coarse = min(exp2(ceil(log2(2.0 * texel))), 32.0);
    if (canopy > 0.0) { coarse = max(coarse, CROWN_LAST); }
    for (var k: i32 = 0; k < 8 && coarse > wavelength; k += 1) {
        let w = clamp(coarse / footprint * 0.5 - 1.0, 0.0, 1.0) - clamp(coarse / texel * 0.5 - 1.0, 0.0, 1.0);
        let wc = (coarse >= CROWN_FIRST && coarse <= CROWN_LAST) ? canopy * clamp(coarse / foot_area * 0.5 - 1.0, 0.0, 1.0) : 0.0;
        if (w > 0.0 || wc > 0.0) {
            let far = coarse >= 1.0;
            let x = (far ? v_swell : v_q) / coarse;
            // Each wavelength its own noise, wherever the loop starts.
            let pg = perlin_grad(x, ((far ? FAR_PERIOD : DETAIL_PERIOD) / coarse) as i32, 46 + (round(log2(coarse)) as i32));
            let a = VARY_LUM * lum_gain * max(w, 0.0);
            let ac = CROWN_LUM * wc;
            lum += pg.x * (a + ac);
            slope += pg.yzw * (RELIEF * relief_gain * max(w, 0.0) * steep + CROWN_RELIEF * wc);
            lum_var += (a * a + ac * ac) * PERLIN_VAR;
        }
        coarse *= 0.5;
    }
    // The forest floor's own small relief, root mounds, windthrow pits and
    // hollows, from FLOOR_LAST metres down on the gentle ground the faces'
    // relief leaves alone: the drained ground is smooth below its gullies,
    // and the texels resolving it close by left the floor dead flat however
    // near. (The open ground's is under the grass's blades.) It is the
    // shader's alone, at every distance (the texels hold none of it), each
    // octave fading as a pixel spans it; faded in from a tenth of the
    // forest, so thin woods cost nothing. rise: how high it stands here,
    // its noise, about -1 to 1.
    let floor_relief = FLOOR_RELIEF * forest * smoothstep(0.1, 0.2, forest) * (1.0 - steep) * (1.0 - water);
    var rise: f32 = 0.0;
    if (floor_relief > 0.0 && footprint < 0.5 * FLOOR_LAST) {
        let fr = floor_noise(v_swell, v_q, normalize(v_up), footprint);
        rise = fr.x;
        slope += fr.yzw * floor_relief;
    }
    var cells = (DETAIL_PERIOD / wavelength) as i32;
    for (var k: i32 = 0; k < 6; k += 1) {
        let w = clamp(wavelength / footprint * 0.5 - 1.0, 0.0, 1.0);
        if (w <= 0.0) { break; }
        let x = v_q / wavelength;
        // One noise for both: the relief's crests are the lighter ground.
        let gn = perlin_grad(x, cells, 11 + k);
        let a = VARY_LUM * lum_gain * w;
        lum += gn.x * a;
        lum_var += a * a * PERLIN_VAR;
        slope += gn.yzw * (RELIEF * relief_gain * w);
        wavelength *= 0.5;
        cells *= 2;
    }
    let land = 1.0 - water;
    let vary = mix(1.0, exp(lum - 0.5 * lum_var), land);
    // Under the trees the floor is their litter, not the open ground's
    // sward: brown needles on the floor's rises, moss in its hollows, none
    // over rock or snow. (Where the pixel spans the relief, rise is 0 and
    // the floor their mix.)
    let litter = LITTER * forest * land * (1.0 - rock) * (1.0 - shed) * (1.0 - smoothstep(0.25, 0.5, hi_c));
    if (litter > 0.0) {
        let mossy = smoothstep(0.25, -0.25, rise);
        col = vec4<f32>(mix(col.xyz, mix(NEEDLES, MOSS, mossy), litter), col.w);
    }
    s.base_color = col.xyz * vary;
    let eye = -normalize(g.pos);
    let crowns = 1.0 - pow(1.0 - TREE_CROWNS * forest, 1.0 / max(dot(eye, normalize(v_up)), 0.05));
    // Where blades stand, the ground between them, in their shade.
    let grass = GrassPlace { a: params.grass_a, e: params.grass_e, f: params.grass_f, uv: params.grass_uv };
    s.base_color *= grass_floor(grass, (params.cam_hi + params.cam_lo) + g.pos, length(g.pos));
    // Where the trees are not drawn, their crowns' share of the ground is
    // the crowns' own colour (trees_mesh.bk's needles, as their shading
    // averages them). A tint over the floor (bluish, for the shade) read
    // from altitude as lakes under the air's blue.
    s.base_color = mix(s.base_color, CANOPY * vary, crowns * (1.0 - drawn * drawn));
    let g_floor = TREE_CROWNS * forest * drawn * drawn;
    // The relief's gradient along the surface tilts the normal against it.
    n = normalize(n - (slope - dot(slope, n) * n) * land);
    var sea_variance: f32 = 0.0;
    // Fresh water lies on its bed's slope: a lake's texels are level, a
    // stream down a hillside falls with it. Mirrored about the level, a
    // stream on a slope faced the eye at grazing incidence and drew the
    // sky's white down every hillside; tilted with its bed, it shows its own
    // dark water as a stream seen from across the valley does. (Fresh water
    // stands above the sea, at the radius.)
    let level_up = normalize(v_up);
    let fresh = smoothstep(0.0, 1.0, v_height);
    let up = normalize(mix(level_up, n, fresh * smoothstep(0.02, 0.1, 1.0 - dot(n, level_up))));
    var sea = up;
    if (water > 0.001) {
        let calm = mix(1.0, WAVE_FRESH_SCALE, fresh);
        let sr = sea_slope(footprint * mix(1.0, 2.0, fresh), up, v_swell, v_q, fresh > 0.5 ? WAVE_FRESH : 0, params.time);
        // Fresh water's surface in wind rows: rippled lanes and glassy
        // slicks between, and the gentle swell across them, which break its
        // sky's reflection into what reads as moving water. The lanes are the noise
        // averaged along the wind (WIND on the tangent plane), so they stay
        // periodic (no seam where the coordinates wrap) and run the same on
        // every tile and level. (Along the current, taken across the bed's
        // slope in the texels' normal, they turned at every tile edge where
        // the levels' beds differed, and drew the tiles across the glint.)
        var lane: f32 = 0.0;
        let wind = WIND - up * dot(WIND, up);
        let wl = length(wind);
        let sw = clamp(STREAK_W / footprint * 0.5 - 1.0, 0.0, 1.0) * fresh * smoothstep(0.05, 0.2, wl);
        if (sw > 0.0) {
            let along = wind * (STREAK_LEN / wl);
            var acc = vec4<f32>(0.0);
            acc = perlin_grad((v_swell - along) / STREAK_W, (FAR_PERIOD / STREAK_W) as i32, 81)
                + perlin_grad((v_swell + along) / STREAK_W, (FAR_PERIOD / STREAK_W) as i32, 81);
            acc *= 0.5 * sw;
            lane = acc.x;
            let gl = acc.yzw - up * dot(acc.yzw, up);
            sea = normalize(up - (sr.slope * max(1.0 + STREAK_RIPPLE * lane, 0.1) + gl * STREAK_SLOPE) * calm);
        } else {
            sea = normalize(up - sr.slope * calm);
        }
        let rip = max(1.0 + STREAK_RIPPLE * lane, 0.1);
        sea_variance = sr.variance * calm * calm * rip * rip;
    }
    // Fresh water is smoother than its ripples' slopes say (at the slopes'
    // roughness a river or a lake was a dull grey sheet from low over it).
    let water_rough = sqrt(sqrt(sea_variance)) * mix(1.0, FRESH_GLOSS, fresh);
    // A pixel mostly water shades as water. One partly water (a stream
    // narrower than it, a shore crossing it) shades as its land, with its
    // water's glint added in its share: a roughness between the two shows
    // neither, so a stream finer than the pixels lost its glint and vanished
    // into the ground about it.
    let surface = smoothstep(0.5, 1.0, water);
    probe("water", water);
    s.normal = normalize(mix(n, sea, surface));
    s.roughness = mix(0.9, water_rough, surface);
    s.metallic = 0.0;

    // The light the vertex saw; the sky under the drawn trees' crowns is
    // theirs.
    s = lit(g, s, 1.0 - 0.8 * g_floor);
    // Only a stream finer than a pixel glints in its share: one the pixels
    // resolve is drawn as its water, and its glint over the texels' spread
    // of it read as a wire laid over the ground. (A stream narrower than a
    // texel spreads over about one and a half, so its width is about its
    // share there times that, in pixels.)
    let thread = 1.0 - smoothstep(0.6, 1.2, 1.5 * water * texel_m / footprint);
    let glint = water * (1.0 - surface) * thread;
    if (glint > 0.0) {
        let ls = lighting::Surface {
            position: g.pos, normal: sea, view: eye, cam_dist: length(g.pos),
            base_color: vec3<f32>(0.0), metallic: 0.0, roughness: max(water_rough, 0.04),
            receives_shadow: false, two_sided: false, subsurface: 0.0, translucency: 0.0,
            sun_visibility: clamp(s.sun_visibility, 0.0, 1.0), sky_visibility: 1.0,
            sky_normal: sea, occluder_sun: 0.0, sun_diffuse: 0.0,
        };
        s.emissive += glint * (lighting::direct_light(ls) + lighting::ambient(ls) * clamp(s.sky_visibility, 0.0, 1.0));
    }
    // Its debug views: the water's share, the forest's, the texels' colour,
    // the octaves' luminance and the ridges' slope (with the octaves added).
    if (SCENE_DEBUG(water)) { s = mesh::debug(s, vec3<f32>(water)); }
    if (SCENE_DEBUG(forest)) { s = mesh::debug(s, vec3<f32>(forest, forest, water)); }
    if (SCENE_DEBUG(texels)) { s = mesh::debug(s, col.xyz); }
    if (SCENE_DEBUG(octaves)) { s = mesh::debug(s, vec3<f32>(0.5 * exp(lum - 0.5 * lum_var))); }
    if (SCENE_DEBUG(ridges)) {
        s = mesh::debug(s, vec3<f32>(min(length(ridges), 1.0), max((o_end - a0.w) as f32, 0.0) * 0.2, 0.0));
    }
    return s;
}
