// The land's drainage below the rivers (rivers.bk): valleys within valleys,
// four levels of them under the river network, so the ground is organised
// by the water it sheds at every scale from the lattice's 20 km down to a
// gully's tens of metres (after Gaillard et al. 2019, "Dendry").
//
// Each level is a lattice of points on the cube faces' equal-angle grid,
// each subdividing the last's cells by four: points about 4.9 km, 1.2 km,
// 300 m and 76 m apart (level 0 is the rivers' own lattice, 20 km), each at
// a spot hashed inside its cell. A point's potential is the relative height
// its stream would stand at if it ran straight to the level above's network:
// the height of the nearest place on that network plus RISE of the relief a
// cell of its own level away, so streams climb the faster the finer they
// are. The network it is measured to is the level above's segments from the
// 3 x 3 points about its own cell's parent. It drains to the neighbour its
// potential falls to most steeply, or, where none lies lower, to that place
// on the network above: the points form trees that run down to their
// parents and join them, leaning downstream. A stream's segments are curves,
// bent, and wandering (stream_wander) in bends of every size that straighten
// where the stream runs high and steep; level 0's meander as the rivers' do
// (rivers.bk meander_from); tapered to their points.
//
// Heights here are relative: 0 the base level the water drains to (the
// rivers' beds about here, `base`), 1 the terrain's own height over it, so
// the relief a valley cuts scales with the height there is to cut. A
// stream stands at its relative height u and its valley rises from it to
// the terrain over VALLEY of its spacing either side (less for a stream
// that gathers little), carrying the terrain's own relief scaled
// (ground.bk shaped_by): ranges are dissected deep, plains gently, and no
// valley digs below its river. The ground's relative height is the soft
// minimum of every stream's valley, so ridges stand between valleys at
// every scale. Each level's share of it (drops) is kept apart, so its
// depth in metres saturates at its own scale (drained): a gully cuts as
// deep as gullies do however high the range it cuts.
//
// The drainage is not one texture everywhere: each level cuts as strongly
// as the region dissects (strengths: finely in dry land, sparsely in wet),
// and where a regional grain runs the streams lean along it (grain_at), in
// parallel lines and trellises.
//
// Refine, never replace: a level fades in as cells resolve it (fade), and
// where they do not a cell holds its mean over the valleys it cannot see
// (mean_rel), so a coarse cell is the aggregate of the finer truth.
//
// Two evaluations of the same network. A tile's (dendry_grid.bk) finds
// every point's potential and link once over the tile and reads the 5 x 5
// segments about each of its cells. Any other point's (drain_probed, for
// trees, grass, the sun's steps and the CPU) finds them about the point
// itself, bounded: the level's points in a 7 x 7 block of its cells about
// here (their potentials, from the level above's 5 x 5 segments about
// here's parent, which hold every one's 3 x 3), the links of the 5 x 5
// within. Both are the same network to f32's rounding. Positions are
// metres on a tangent plane, from each point's f32 direction less the
// plane's origin as an anchor's direction `hi` and the offset `lo` from it
// (as rivers.bk point_offset), so a point lies at the same place wherever
// it is read.
module planet::dendry;

import std::noise::*;
from planet::rivers import RIV_N, RIV_REC, alpha_dir, face_of, face_a, face_e, face_f, cell_of, cell_next, point_index,
    river_width, meander_from, meander_across, erf_approx;
from planet::noise import simplex_grad_f32, GRAD_TO_VALUE;
from planet::climate import moist_broad;

pub const DRAIN_LEVELS: i32 = 4;
const PI4: f32 = 0.78539816;
// rivers.bk draws reaches from MIN_CATCHMENT points (river_width 5.04 m
// on); the reaches narrower are this module's streams.
const RIVER_WIDTH_MIN: f32 = 5.04;
// A valley rises to the terrain over VALLEY of its level's spacing either
// side of its stream.
pub const VALLEY: f32 = 0.45;
// The soft minimum's sharpness: two valleys meeting dip a few percent
// under either (the root of the sum of the inverse powers), so ridges
// between them round rather than crease.
const SOFT: f32 = 10.0;
// The base level is the rivers' beds about here, each weighted by the
// inverse fourth power of its distance, out to BASE_REACH of the lattice's
// spacing: so on a reach it is that reach's bed exactly.
const BASE_REACH: f32 = 1.1;

// How far a level's streams climb, in relative height, a cell of their own
// level from the network above: sources of every level together reach the
// ridges.
pub fn rise(k: i32) -> f32 {
    if (k == 1) { return 0.22; }
    if (k == 2) { return 0.16; }
    if (k == 3) { return 0.12; }
    return 0.10;
}
// A level's channel at the most it gathers (m): levels 1 and 2 carry
// water, the finer are dry gullies.
pub fn stream_width(k: i32) -> f32 {
    if (k == 1) { return 4.0; }
    if (k == 2) { return 1.8; }
    if (k == 3) { return 0.9; }
    return 0.5;
}
// How much a level's valley floors and its interfluves count toward the
// land's wetness and dryness (landform).
fn wet_weight(k: i32) -> f32 {
    if (k == 0) { return 1.0; }
    if (k == 1) { return 0.75; }
    if (k == 2) { return 0.5; }
    if (k == 3) { return 0.3; }
    return 0.18;
}
fn ridge_weight(k: i32) -> f32 {
    if (k == 0) { return 0.5; }
    if (k == 1) { return 0.6; }
    if (k == 2) { return 0.5; }
    if (k == 3) { return 0.35; }
    return 0.2;
}

// A level's spacing between points (m).
pub fn spacing(k: i32, radius: f32) -> f32 {
    return 1.5707963 * radius / ((RIV_N << (2 * k)) as f32);
}

// How deep a level's valleys cut for the height there is to cut (drained):
// a share of it while it is under the level's depth scale, DEPTH of its
// valleys' half-width, and saturating toward that past it. A gully a few
// tens of metres wide cuts metres into a range thousands of metres over its
// base level, not hundreds: its walls stay soil slopes, where they were
// cliffs whose rock streaked every range's gullies.
const DEPTH: f32 = 1.2;
pub fn depth_scale(k: i32, radius: f32) -> f32 {
    return DEPTH * VALLEY * spacing(k, radius);
}

// How much of a level a cell `cell` metres wide holds: none from a cell
// half its spacing wide, all from an eighth, in between over the octaves.
pub fn fade(l: f32, cell: f32) -> f32 {
    return smoothstep(0.0, 1.0, (log2(l / max(cell, 1e-3)) - 1.0) * 0.5);
}

// ── The levels' lattices ───────────────────────────────────────────────────

// The cell (i, j) of face `face`'s lattice, n cells along its edge, that
// `d` lies in, the lattice carried on past the face's edges (a direction
// within 45 degrees of the face's).
pub fn cell_virtual(d: vec3<f32>, face: i32, n: i32) -> vec2<i32> {
    let z = dot(d, face_a(face));
    let x = atan(dot(d, face_e(face)) / z) / PI4;
    let y = atan(dot(d, face_f(face)) / z) / PI4;
    let nf = n as f32;
    return vec2<i32>(floor((x + 1.0) * 0.5 * nf) as i32, floor((y + 1.0) * 0.5 * nf) as i32);
}
// The cell (face, i, j) of a lattice n cells a face's edge that `d` lies in
// (rivers.bk cell_of, at n).
pub fn cell_in(d: vec3<f32>, n: i32) -> vec3<i32> {
    let face = face_of(d);
    let c = cell_virtual(d, face, n);
    return vec3<i32>(face, clamp(c.x, 0, n - 1), clamp(c.y, 0, n - 1));
}
// The cell (di, dj) from c, across the face's edge if need be (rivers.bk
// cell_next, at n).
pub fn cell_step(c: vec3<i32>, di: i32, dj: i32, n: i32) -> vec3<i32> {
    let i = c.y + di;
    let j = c.z + dj;
    if (i >= 0 && i < n && j >= 0 && j < n) { return vec3<i32>(c.x, i, j); }
    let step = 2.0 / (n as f32);
    return cell_in(alpha_dir(c.x, -1.0 + ((i as f32) + 0.5) * step, -1.0 + ((j as f32) + 0.5) * step), n);
}
// The index of the parent of a cell index i, the level above's (floor of
// i / 4, past the face's edges too).
pub fn parent_of(i: i32) -> i32 {
    return i >= 0 ? i / 4 : -((3 - i) / 4);
}
// A cell's point: at a spot hashed inside the middle 70% of it.
pub fn site_dir(c: vec3<i32>, n: i32, seed: i32) -> vec3<f32> {
    let hx = hash_primes3d(seed + 5003, c.y * PRIME_X, c.z * PRIME_Y, c.x * PRIME_Z);
    let hy = hash_primes3d(seed + 6007, c.y * PRIME_X, c.z * PRIME_Y, c.x * PRIME_Z);
    let jx = 0.15 + 0.7 * (((hx >> 8) & 65535) as f32) / 65536.0;
    let jy = 0.15 + 0.7 * (((hy >> 8) & 65535) as f32) / 65536.0;
    let step = 2.0 / (n as f32);
    return alpha_dir(c.x, -1.0 + ((c.y as f32) + jx) * step, -1.0 + ((c.z as f32) + jy) * step);
}
// A point's own number, which its stream's meanders are hashed from.
pub fn site_id(c: vec3<i32>, k: i32) -> i32 {
    return hash_primes3d(9173 + k, c.y * PRIME_X, c.z * PRIME_Y, c.x * PRIME_Z);
}
// 0 to 1 from a stream's number, a draw `salt` for each of its traits.
fn id_unit(id: i32, salt: i32) -> f32 {
    return (((hash_primes3d(salt, id, id * PRIME_Y, 0) >> 8) & 65535) as f32) / 65536.0;
}
// A stream's curve leaves its point at a slope of its own (across over
// along), so no two run alike from their sources.
pub fn start_slope(id: i32) -> f32 {
    return (id_unit(id, 811) - 0.5) * 0.9;
}

// A tangent plane: metres along t1 and t2 from its origin hi + lo.
pub struct Local {
    hi: vec3<f32>,
    lo: vec3<f32>,
    t1: vec3<f32>,
    t2: vec3<f32>,
    r: f32,
}
pub fn local_frame(hi: vec3<f32>, lo: vec3<f32>, r: f32) -> Local {
    let up = normalize(hi + lo);
    let axis = abs(up.y) < 0.9 ? vec3<f32>(0.0, 1.0, 0.0) : vec3<f32>(1.0, 0.0, 0.0);
    let t1 = normalize(cross(up, axis));
    // up = t1 x t2: a segment's side (along.y, -along.x) is rivers.bk's
    // cross(along, up).
    let t2 = cross(up, t1);
    return Local { hi: hi, lo: lo, t1: t1, t2: t2, r: r };
}
pub fn to_local(f: Local, p: vec3<f32>) -> vec2<f32> {
    let o = ((p - f.hi) - f.lo) * f.r;
    return vec2<f32>(dot(o, f.t1), dot(o, f.t2));
}
pub fn vec_local(f: Local, v: vec3<f32>) -> vec2<f32> {
    return vec2<f32>(dot(v, f.t1), dot(v, f.t2));
}
// The direction of the plane's point x (to f32's rounding: for the fields
// hundreds of kilometres across).
pub fn from_local(f: Local, x: vec2<f32>) -> vec3<f32> {
    return normalize(f.hi + (f.lo + (f.t1 * x.x + f.t2 * x.y) / f.r));
}

// ── Segments ───────────────────────────────────────────────────────────────
//
// A stream's segment from a point P to where it drains T, three vec4s:
//   a: P (xy), T (zw), metres on the tangent plane
//   b: its relative height at P and at T; level 0's the base level at P
//      and at T
//   c: its bend's slopes at P and at T (across over along, as rivers.bk
//      bend takes them), its channel's width (0: no segment), its number
//      (bits) for its meanders
pub struct Seg {
    a: vec4<f32>,
    b: vec4<f32>,
    c: vec4<f32>,
}
pub fn no_seg() -> Seg {
    return Seg { a: vec4<f32>(0.0), b: vec4<f32>(0.0), c: vec4<f32>(0.0) };
}

// Level 0: the reach from the rivers' point in cell c to its downstream
// point, its bed the rivers' (min of floor and water), its bend their
// tangents', so its curve is the very line rivers.bk lays its channel
// along. Every reach on land, a source's too: the valleys of the reaches
// too small for rivers.bk to draw are this module's.
pub fn reach_seg(net: read_store<f32, 1>, c: vec3<i32>, f: Local) -> Seg {
    var s = no_seg();
    let p = point_index(c);
    let k = p * RIV_REC;
    let down = net[k + 1];
    if (net[k + 3] <= 0.0 || down < 0.0) { return s; }
    let dk = (down as i32) * RIV_REC;
    let pa = to_local(f, vec3<f32>(net[k + 4], net[k + 5], net[k + 6]));
    let pb = to_local(f, vec3<f32>(net[dk + 4], net[dk + 5], net[dk + 6]));
    let len = max(length(pb - pa), 1.0);
    let along = (pb - pa) / len;
    let side = vec2<f32>(along.y, -along.x);
    let ta = vec_local(f, vec3<f32>(net[k + 8], net[k + 9], net[k + 10]));
    let tb = vec_local(f, vec3<f32>(net[dk + 8], net[dk + 9], net[dk + 10]));
    let sa = clamp(dot(ta, side) / max(dot(ta, along), 0.3), -0.6, 0.6);
    let sb = clamp(dot(tb, side) / max(dot(tb, along), 0.3), -0.6, 0.6);
    s.a = vec4<f32>(pa, pb);
    s.b = vec4<f32>(0.0, 0.0, min(net[k + 7], net[k + 3]), min(net[dk + 7], net[dk + 3]));
    s.c = vec4<f32>(sa, sb, river_width(net[k + 2]), bitcast<f32>(p));
    return s;
}

// The segment's curve's offset across its chord at s metres along it, a
// chord `len` long: a cubic Hermite to its slopes at either end, and the
// meanders (level 0 at the rivers' own seed: their channel's line). For a
// point `across` metres across the chord, the meanders as far from the
// curve as it is (rivers.bk meander_from); on the curve (ON_CURVE), all of
// them. y the meanders' slope along the chord. u: the stream's relative
// height there. Level 0's reaches meander as the rivers' channels do (the
// very line rivers.bk lays them along); the levels below wander
// (stream_wander).
fn curve_offset(c: vec4<f32>, s: f32, len: f32, k: i32, seed: i32, across: f32, u: f32) -> vec2<f32> {
    let t = s / len;
    let t2 = t * t;
    let bend = len * ((t2 * t - 2.0 * t2 + t) * c.x + (t2 * t - t2) * c.y);
    let off = across > 1.0e29 ? across : across - bend;
    var m: vec2<f32>;
    if (k == 0) {
        m = meander_from(bitcast<i32>(c.w), s, len, c.z, seed, off);
    } else {
        m = stream_wander(bitcast<i32>(c.w), s, len, seed + 131 * k, off, u);
    }
    return vec2<f32>(bend + m.x, m.y);
}
const ON_CURVE: f32 = 1.0e30;

// A stream's or a gully's line about its bend: not a great river's
// meanders (whose one wavelength, eleven channel widths, at the swing that
// makes a river's sinuosity, drew every creek and gully as the same even
// squiggle: they are washes and small channels, steered by the ground) but
// a wander in octaves of gradient noise from half its segment down to
// GULLY_FINEST metres, each octave's length a hashed 0.42 to 0.58
// of the last's and its lattice at a hashed phase, so no bend repeats and no
// crossing falls on a beat; each GULLY_GAIN of the last's amplitude, more
// than the half a self-similar curve keeps, so the line is as rough at a
// few metres as at its segment's scale. Its amplitude comes and goes along
// it (straight runs and tortuous ones), and it straightens where the stream
// runs high on its slopes (u, its relative height: a rill on a steep upper
// slope runs down the fall line; on the gentle footslopes it wanders). The
// tapers and `far` as rivers.bk meander_from takes them, so the valley's
// sides follow its broad bends and the floor all of them.
const GULLY_OCTAVES: i32 = 6;
const GULLY_AMP: f32 = 0.2;
const GULLY_GAIN: f32 = 0.6;
const GULLY_FINEST: f32 = 8.0;
fn gully_gradient(seed: i32, p: i32, i: i32, octave: i32) -> f32 {
    let h = hash_primes3d(seed + 7927, p * PRIME_X, i * PRIME_Y, octave * PRIME_Z);
    return (((h >> 8) & 65535) as f32) / 32767.5 - 1.0;
}
fn gully_noise(seed: i32, p: i32, x: f32, octave: i32) -> vec2<f32> {
    let c = floor(x);
    let f = x - c;
    let i = c as i32;
    let g0 = gully_gradient(seed, p, i, octave);
    let g1 = gully_gradient(seed, p, i + 1, octave);
    let h = f * f * (3.0 - 2.0 * f);
    return vec2<f32>(mix(g0 * f, g1 * (f - 1.0), h),
                     mix(g0, g1, h) + (g1 * (f - 1.0) - g0 * f) * 6.0 * f * (1.0 - f));
}
pub fn stream_wander(p: i32, s: f32, len: f32, seed: i32, across: f32, u: f32) -> vec2<f32> {
    let all = across > 1.0e29;
    // Farther than its segment's length, even the broadest octave's
    // `follow` is nothing (and every finer one stops), so most segments a
    // point sees cost no noise.
    if (!all && len <= abs(across)) { return vec2<f32>(0.0); }
    // One hash a segment; each octave's phase and length ratio step from it
    // by the golden ratio's fraction (a low-discrepancy run, no repeats).
    var r = id_unit(p, 917);
    // Under a period and a half a segment: a sine at a hashed phase and
    // depth comes and goes as noise would, with no beat to see.
    let along = (0.2 + 0.3 * fract(r * 7.0)) * sin(6.2831853 * (s / (0.7 * len) + r));
    let amp = GULLY_AMP * clamp(1.0 + 2.2 * along, 0.15, 1.9) * mix(1.25, 0.3, smoothstep(0.3, 0.85, u));
    var wavelength = 0.5 * len;
    var gain: f32 = 1.0;
    var m = vec2<f32>(0.0);
    for (var o: i32 = 0; o < GULLY_OCTAVES; o += 1) {
        let far = all ? 0.0 : max(abs(across - m.x), 1e-3);
        if (o > 0 && wavelength < max(GULLY_FINEST, 0.5 * far)) { break; }
        r = fract(r + 0.618034);
        let n = gully_noise(seed, p, s / wavelength + r * 7.0, o);
        let e = clamp(min(s, len - s) * 2.0 / wavelength, 0.0, 1.0);
        let follow = all ? 1.0 : smoothstep(0.5 * far, far, wavelength);
        let a = amp * gain * e * e * (3.0 - 2.0 * e) * follow;
        m += vec2<f32>(n.x * wavelength * a, n.y * a);
        gain *= GULLY_GAIN / 0.5;
        r = fract(r + 0.618034);
        wavelength *= 0.42 + 0.16 * r;
    }
    return m;
}

// X's distance to a segment's chord (x), the place along it (y, m) and
// its length (z).
pub fn chord(a: vec4<f32>, x: vec2<f32>) -> vec3<f32> {
    let p = a.xy;
    let len = max(length(a.zw - p), 1e-3);
    let along = (a.zw - p) / len;
    let s = clamp(dot(x - p, along), 0.0, len);
    return vec3<f32>(length(x - p - along * s), s, len);
}

// X's distance to a segment's curve (x) and the fraction along it (y). The
// curve stays within 0.4 of its chord's length of the chord, so past
// `limit` of that the distance is not needed: a bound under it is returned
// instead, without the meanders.
pub fn seg_dist(sg: Seg, x: vec2<f32>, k: i32, limit: f32, seed: i32) -> vec2<f32> {
    let a = sg.a;
    let p = a.xy;
    let len = max(length(a.zw - p), 1e-3);
    let along = (a.zw - p) / len;
    let side = vec2<f32>(along.y, -along.x);
    let rel = x - p;
    let sr = dot(rel, along);
    let s = clamp(sr, 0.0, len);
    let across = dot(rel, side);
    let ahead = sr - s;
    let bound = 0.4 * len;
    if (abs(ahead) > limit || abs(across) > limit + bound) {
        return vec2<f32>(max(abs(ahead), abs(across) - bound), s / len);
    }
    let co = curve_offset(sg.c, s, len, k, seed, across, mix(sg.b.x, sg.b.y, s / len));
    let off = meander_across(across - co.x, co.y);
    return vec2<f32>(sqrt(ahead * ahead + off * off), s / len);
}

// A valley's cross-section: its relative rise at t of its half-width, a
// swale: level along its floor, steepest partway up its sides and level at
// its rim. (Steepest at its stream, x (2 - x), every gully's floor was a
// crease, drawn as an engraved dark groove rather than a soft swale.)
fn prof(t: f32) -> f32 {
    let x = clamp(t, 0.0, 1.0);
    let x2 = x * x;
    return x2 * (2.0 - x2);
}

// What a level's valleys leave of relative height rho over a cell that
// does not resolve them, its streams at relative height ubar: rho's mean
// under the valleys' minimum, the distance to the nearest stream taken as
// uniform out to SPAN of a valley's half-width.
const SPAN: f32 = 1.1;
pub fn mean_rel(rho: f32, ubar: f32) -> f32 {
    if (rho <= ubar) { return rho; }
    let span = max(1.0 - ubar, 1e-4);
    let rp = clamp((rho - ubar) / span, 0.0, 1.0);
    // prof(ts) = rp (ts <= 1 < SPAN), and prof's integral to it.
    let ts = sqrt(max(1.0 - sqrt(1.0 - rp), 0.0));
    let t3 = ts * ts * ts;
    let e = (t3 * (2.0 / 3.0) - t3 * ts * ts * 0.2 + rp * (SPAN - ts)) / SPAN;
    return ubar + span * min(e, rp);
}
// The mean, over the same uniform distance, of a valley floor's wetness
// (exp(-(d / (WET_W w))^2)) and of being near a level's stream for its
// interfluves (exp(-(d / (NEAR_W w))^2)).
const WET_W: f32 = 0.35;
const NEAR_W: f32 = 0.8;
const WET_MEAN: f32 = 0.282;    // WET_W sqrt(pi) / 2 / SPAN
const NEAR_MEAN: f32 = 0.565;   // erf(SPAN / NEAR_W) NEAR_W sqrt(pi) / 2 / SPAN

// ── Potentials and links ───────────────────────────────────────────────────

// The nearest place, by potential, on the level above's network from a
// point: its potential v (1e9: none), the place along the segment (s, m),
// the distance (d, m), and the segment.
pub struct Near {
    v: f32,
    s: f32,
    d: f32,
    seg: Seg,
}
pub fn near_none() -> Near {
    return Near { v: 1.0e9, s: 0.0, d: 0.0, seg: no_seg() };
}
// n, or segment s if it offers x, of level `lk` apart and rising `sig`, a
// lower potential.
pub fn near_try(n: Near, s: Seg, x: vec2<f32>, sig: f32, lk: f32) -> Near {
    if (s.c.z <= 0.0) { return n; }
    let ch = chord(s.a, x);
    let v = mix(s.b.x, s.b.y, ch.y / ch.z) + sig * ch.x / lk;
    if (v >= n.v) { return n; }
    return Near { v: v, s: ch.y, d: ch.x, seg: s };
}
// The level's streams about a point stand under its own potential by about
// half a cell's rise, and over the network they join (1e9: none found).
pub fn streams_about(n: Near, sig: f32) -> f32 {
    if (n.v > 1.0e8) { return 1.0e9; }
    let a = n.seg.a;
    return max(n.v - 0.5 * sig, mix(n.seg.b.x, n.seg.b.y, n.s / max(length(a.zw - a.xy), 1e-3)));
}

// A point's potential, two vec4s: a its position (xy) and potential (z,
// 1e9: none); b where it would join the network above (xy), its distance
// to it in its level's spacings, and the direction the network runs there.
pub struct Pot {
    a: vec4<f32>,
    b: vec4<f32>,
}
// The potential of the point at x of level k from its nearest place n on
// the level above's network.
pub fn pot_of(n: Near, x: vec2<f32>, k: i32, lk: f32, seed: i32) -> Pot {
    if (n.v > 1.0e8) { return Pot { a: vec4<f32>(x, 1.0e9, 0.0), b: vec4<f32>(x, 0.0, 0.0) }; }
    let a = n.seg.a;
    let len = max(length(a.zw - a.xy), 1e-3);
    let along = (a.zw - a.xy) / len;
    let side = vec2<f32>(along.y, -along.x);
    let jn = a.xy + along * n.s + side * curve_offset(n.seg.c, n.s, len, k - 1, seed, ON_CURVE,
                                                      mix(n.seg.b.x, n.seg.b.y, n.s / len)).x;
    return Pot { a: vec4<f32>(x, n.v, 0.0), b: vec4<f32>(jn, n.d / lk, atan2(along.y, along.x)) };
}
// How steeply o's potential falls to neighbour t's (0: it does not).
pub fn fall(o: Pot, t: Pot) -> f32 {
    let drop = o.a.z - t.a.z;
    if (drop <= 0.0) { return 0.0; }
    return drop / max(length(t.a.xy - o.a.xy), 1.0);
}
// A stream's end slope (12 bits over -0.6 to 0.6) and its width (11 bits
// over 0 to 8 m) as the grids hold them, in a float exactly
// (dendry_grid.bk), and taken so by both evaluations.
fn slope_q(x: f32) -> i32 { return (clamp((x + 0.6) / 1.2, 0.0, 1.0) * 4095.0 + 0.5) as i32; }
fn slope_of(q: i32) -> f32 { return -0.6 + (q as f32) / 4095.0 * 1.2; }
fn width_q(x: f32) -> i32 { return (clamp(x / 8.0, 0.0, 1.0) * 2047.0 + 0.5) as i32; }
fn width_of(q: i32) -> f32 { return (q as f32) / 2047.0 * 8.0; }
// A segment of level 1 on (no base level; its start's slope is its
// number's, start_slope) as two vec4s: a, and its heights, slope and
// width, number.
pub fn seg_packed(s: Seg) -> vec4<f32> {
    return vec4<f32>(s.b.x, s.b.y, (slope_q(s.c.y) + 4096 * width_q(s.c.z)) as f32, s.c.w);
}
pub fn seg_unpacked(a: vec4<f32>, b: vec4<f32>) -> Seg {
    let p = b.z as i32;
    return Seg { a: a, b: vec4<f32>(b.x, b.y, 0.0, 0.0),
                 c: vec4<f32>(start_slope(bitcast<i32>(b.w)), slope_of(p & 4095), width_of(p >> 12), b.w) };
}
// Whether x is past a segment's valley `limit` metres wide (as seg_dist
// bounds it, its chord alone).
pub fn seg_far(a: vec4<f32>, x: vec2<f32>, limit: f32) -> bool {
    let p = a.xy;
    let len = max(length(a.zw - p), 1e-3);
    let along = (a.zw - p) / len;
    let rel = x - p;
    let sr = dot(rel, along);
    let ahead = sr - clamp(sr, 0.0, len);
    let across = dot(rel, vec2<f32>(along.y, -along.x));
    return abs(ahead) > limit || abs(across) > limit + 0.4 * len;
}

// Point o's segment (level k, rising sig), to neighbour t where `to_t`,
// else to the network above, leaning the way it runs, each as much as its
// own draw says (id: its number), so streams meet their parents at every
// angle from straight across to nearly along. None where o has no
// potential.
pub fn link_of(o: Pot, t: Pot, to_t: bool, k: i32, sig: f32, id: i32) -> Seg {
    var s = no_seg();
    if (o.a.z > 1.0e8) { return s; }
    // What it gathers: most where it nears the network above.
    let width = width_of(width_q(stream_width(k) * (0.3 + 0.7 * (1.0 - clamp(o.b.z / 2.5, 0.0, 1.0)))));
    let start = start_slope(id);
    if (to_t) {
        s.a = vec4<f32>(o.a.xy, t.a.xy);
        s.b = vec4<f32>(o.a.z, t.a.z, 0.0, 0.0);
        s.c = vec4<f32>(start, slope_of(slope_q((id_unit(id, 823) - 0.5) * 0.8)), width, bitcast<f32>(id));
        return s;
    }
    let len = max(length(o.b.xy - o.a.xy), 1e-3);
    let along = (o.b.xy - o.a.xy) / len;
    let side = vec2<f32>(along.y, -along.x);
    var tg = along + (0.15 + 1.7 * id_unit(id, 829)) * vec2<f32>(cos(o.b.w), sin(o.b.w));
    if (dot(tg, tg) < 1e-4) { tg = along; }
    let slope = slope_of(slope_q(dot(tg, side) / max(dot(tg, along), 0.3)));
    s.a = vec4<f32>(o.a.xy, o.b.xy);
    s.b = vec4<f32>(o.a.z, o.a.z - sig * o.b.z, 0.0, 0.0);
    s.c = vec4<f32>(start, slope, width, bitcast<f32>(id));
    return s;
}

// ── A level's valleys at a point ───────────────────────────────────────────

// Segment s's valley's term in the soft minimum at a point dt (seg_dist)
// from it, its level's valleys `wk` either side at the most: a valley
// widens with what its stream gathers (its channel's width, link_of), a
// source's gully narrow and the reach that joins the network above broad.
pub fn valley_half(s: Seg, k: i32, wk: f32) -> f32 {
    if (k == 0) { return wk; }
    return wk * (0.55 + 0.45 * clamp(s.c.z / stream_width(k), 0.0, 1.0));
}
pub fn valley_term(s: Seg, dt: vec2<f32>, k: i32, wk: f32) -> f32 {
    let wv = valley_half(s, k, wk);
    if (dt.x >= wv) { return 0.0; }
    let u = mix(s.b.x, s.b.y, dt.y);
    let r = u + (1.0 - u) * prof(dt.x / wv);
    if (r >= 1.0) { return 0.0; }
    return pow(max(r, 1e-3), -SOFT) - 1.0;
}
// The relative height rel after a level's valleys: their terms' sum acc,
// as much as the cell resolves them (fk), the mean over them (streams at
// ubar) for the rest.
pub fn rel_after(rel: f32, acc: f32, ubar: f32, fk: f32) -> f32 {
    let actual = pow(pow(max(rel, 1e-3), -SOFT) + acc, -1.0 / SOFT);
    return mix(mean_rel(rel, ubar), actual, fk);
}
// The base level's weight for a reach dn of the lattice's spacings away.
pub fn base_weight(dn: f32) -> f32 {
    return smoothstep(BASE_REACH, 0.6 * BASE_REACH, dn) / ((dn * dn + 0.0025) * (dn * dn + 0.0025));
}

// What a point takes from the levels besides its relative height: the
// streams' channels and their banks over a cell (sg: the cell's spread in
// metres), the valley floors and interfluves about it.
pub struct Tally {
    share: f32,
    gallery: f32,
    dry: f32,
    wet_even: f32,
    far: f32,
    far_even: f32,
}
pub fn tally_none() -> Tally {
    return Tally { share: 0.0, gallery: 0.0, dry: 1.0, wet_even: 1.0, far: 1.0, far_even: 1.0 };
}
// Segment s's channel, dist metres away, into the tally: level 0's reaches
// too small for rivers.bk, levels 1 and 2 as much as the cell resolves them.
pub fn tally_water(t: Tally, s: Seg, dist: f32, k: i32, fk: f32, sg: f32) -> Tally {
    var o = t;
    if (k > 2 || (k == 0 && s.c.z >= RIVER_WIDTH_MIN)) { return o; }
    let hw = 0.5 * s.c.z;
    let gw = k == 0 ? hw + 10.0 + 4.0 * s.c.z : hw + 8.0 + 3.0 * s.c.z;
    // Past the banks by three of the cell's spreads there is nothing of it.
    if (dist > gw + 3.0 * sg) { return o; }
    let ws = clamp(0.5 * (erf_approx((hw - dist) / sg) - erf_approx((-hw - dist) / sg)), 0.0, 1.0);
    let strip = clamp(0.5 * (erf_approx((gw - dist) / sg) - erf_approx((-gw - dist) / sg)), 0.0, 1.0);
    let f = k == 0 ? 1.0 : fk;
    o.share = max(o.share, ws * f);
    o.gallery = max(o.gallery, (strip - ws) * f);
    return o;
}
// Level k's floors and interfluves into the tally, its nearest stream dmin
// away (seg_near), as much as the cell resolves them (fk), their means for
// the rest, weighed by the level's strength in the region (a).
pub fn tally_level(t: Tally, k: i32, dmin: f32, wk: f32, fk: f32, a: f32) -> Tally {
    var o = t;
    let wet = a * wet_weight(k);
    let ridge = a * ridge_weight(k);
    let em = k == 0 ? NEAR_SHARE_RIVERS : NEAR_SHARE;
    o.dry *= 1.0 - wet * mix(WET_MEAN * em, exp(-(dmin * dmin) / (WET_W * WET_W * wk * wk)), fk);
    o.wet_even *= 1.0 - wet * WET_MEAN * em;
    o.far *= 1.0 - ridge * mix(NEAR_MEAN * em, exp(-(dmin * dmin) / (NEAR_W * NEAR_W * wk * wk)), fk);
    o.far_even *= 1.0 - ridge * NEAR_MEAN * em;
    return o;
}
// A segment's distance d as the floors and interfluves weigh it: a stream
// counts as near as what it gathers (its width, 0.3 to 1 of the level's
// most, link_of) and as its own draw makes it (its number: some streams
// hold water and green floors, others are dry washes), so the floors run
// from a fifth of the width to the whole and the land reads by some of its
// streams, not as an even lace of every one. (Over a level's streams that
// keeps about NEAR_SHARE of the floors a full width each would.)
// The rivers' reaches (level 0) by their catchment alone: a 3 m stream's
// floor is a fifth of a 100 m river's.
const NEAR_SHARE: f32 = 0.45;
const NEAR_SHARE_RIVERS: f32 = 0.4;
pub fn seg_near(s: Seg, d: f32, k: i32, wk: f32) -> f32 {
    if (k == 0) {
        let g0 = clamp(log2(max(s.c.z, 1.0) / 3.0) / 5.0, 0.0, 1.0);
        return d / (0.2 + 0.8 * g0);
    }
    let g = clamp((s.c.z / stream_width(k) - 0.15) / 0.85, 0.0, 1.0) * mix(0.15, 1.0, id_unit(bitcast<i32>(s.c.w), 841));
    return d / (0.2 + 0.8 * g * g);
}

// The streams of an unresolved level climb on above the last level's: a
// point's potential is about RISE of a spacing over its parent's.
pub fn ubar_next(ubar: f32, k: i32) -> f32 {
    return ubar + 0.8 * rise(k);
}

// ── The drainage's character over a region ─────────────────────────────────

// How dry the land's drainage is here, 0 to 1: the climate's broad
// moisture, varied by regions of a few hundred kilometres. (Found at each
// drainage point, so cheap: two noise calls.)
pub fn dryness(dir: vec3<f32>, seed: i32) -> f32 {
    let m = moist_broad(dir, seed);
    return clamp(0.1 + 0.75 * (1.0 - smoothstep(0.15, 0.75, m.x)) + 0.45 * m.y, 0.0, 1.0);
}
// How strongly levels 1 to 4 cut (x to w, of their depth) in land of
// dryness `dry` standing hh metres over its base level. Dry land dissects
// finely, every gully cut (badlands); wet land, under its soil and cover,
// keeps broad smooth interfluves between sparse long streams, more of them
// as it has the relief to cut them: wet hill country is well dissected, if
// less finely than dry, a level most fully once the land stands a couple of
// its depths over its base. The coarse levels always cut: the land's main
// valleys run everywhere. With hh 0, the climate's alone, which the floors'
// and interfluves' colour takes (tally_level).
pub fn strengths(dry: f32, hh: f32, radius: f32) -> vec4<f32> {
    let clim = vec4<f32>(mix(0.85, 1.0, dry), mix(0.6, 1.0, dry), mix(0.35, 1.0, dry), mix(0.12, 1.0, dry * dry));
    let c = vec4<f32>(depth_scale(1, radius), depth_scale(2, radius), depth_scale(3, radius), depth_scale(4, radius));
    return mix(clim, vec4<f32>(1.0), 0.75 * smoothstep(0.1 * c, c, vec4<f32>(hh)));
}
pub fn comp4(v: vec4<f32>, i: i32) -> f32 {
    return i == 0 ? v.x : (i == 1 ? v.y : (i == 2 ? v.z : v.w));
}

// A region's grain: where folded strata, joints or a tilted surface run
// through the land, a stream drains, of the neighbours its potential falls
// to, the most along the grain, so the network runs in parallel lines or
// in a trellis; over most land there is none and it branches freely. xy
// the grain's axis on the plane f, z its strength, w how far it is
// rectangular (joints at right angles: either axis). Its fields span
// hundreds of kilometres, so a link reads it about where it is read
// (drain_probed, a vertex's window) as at its own point.
pub fn grain_at(dir: vec3<f32>, f: Local, seed: i32) -> vec4<f32> {
    let g = simplex_grad_f32(dir * 7.0, seed + 961);
    let h = simplex_grad_f32(dir * 13.0, seed + 962);
    var ax = vec_local(f, g.yzw);
    let l = length(ax);
    ax = l > 1e-6 ? ax / l : vec2<f32>(1.0, 0.0);
    return vec4<f32>(ax, 2.2 * smoothstep(0.05, 0.45, h.x), smoothstep(0.0, 0.4, h.y * GRAD_TO_VALUE));
}
// How a stream at o weighs the fall to neighbour t in grain r.
pub fn lean(r: vec4<f32>, o: Pot, t: Pot) -> f32 {
    if (r.z <= 0.0) { return 1.0; }
    let v = t.a.xy - o.a.xy;
    let n = v / max(length(v), 1e-3);
    let c = abs(dot(n, r.xy));
    let s = abs(n.x * r.y - n.y * r.x);
    let al = mix(c, max(c, s), r.w);
    return exp(r.z * (2.0 * al * al - 1.0));
}

// ── The drainage at a point ────────────────────────────────────────────────

// The drainage about here: the base level (m), the relative height (0 to
// 1, ground.bk shaped_by), and what the land's colour and water take from
// it: wet, how much of a cell lies on valley floors (each level's floors
// counting by wet_weight, together as independent shares), ridge, how much
// lies on interfluves away from every level's streams; both less their
// means over the planet (landform), so they move the climate about its
// own. share, how much of the cell the streams' channels cover (level 0's
// reaches too small for rivers.bk, levels 1 and 2), gallery how much their
// banks' strip. probe: the relative height at the four points drain_probed
// was given (+s1, -s1, +s2, -s2). drops: how much of the relative height
// levels 1 to 4 took at full strength (x to w; rel is 1 less level 0's and
// these); dry, the land's dryness (dryness). drained takes each level's
// drop as strongly as the region cuts it (strengths), its depth saturating
// at its own scale.
pub struct Drain {
    base: f32,
    rel: f32,
    wet: f32,
    ridge: f32,
    share: f32,
    gallery: f32,
    probe: vec4<f32>,
    drops: vec4<f32>,
    dry: f32,
}
pub fn drain_of(base: f32, rel: f32, t: Tally, probe: vec4<f32>, drops: vec4<f32>, dry: f32) -> Drain {
    var d: Drain;
    d.base = base;
    d.rel = rel;
    d.wet = (1.0 - t.dry) - (1.0 - t.wet_even);
    d.ridge = t.far - t.far_even;
    d.share = t.share;
    d.gallery = t.gallery;
    d.probe = probe;
    d.drops = drops;
    d.dry = dry;
    return d;
}
// A drainage of base level, relative height and dryness (xyz of brd) and
// the levels' drops alone, as a kernel found it for another (what the
// ground's height takes, ground.bk shaped_by).
pub fn drain_held(brd: vec4<f32>, drops: vec4<f32>) -> Drain {
    return drain_of(brd.x, brd.y, tally_none(), vec4<f32>(1.0), drops, brd.z);
}
// A cell `cell` wide's spread in metres, for the channels' share of it.
pub fn cell_spread(cell: f32) -> f32 {
    return 0.75 * max(cell, 1e-3) * 1.4142136;
}

pub fn drain_at(hi: vec3<f32>, lo: vec3<f32>, radius: f32, cell: f32, net: read_store<f32, 1>, seed: i32) -> Drain {
    return drain_probed(hi, lo, radius, cell, net, seed, vec3<f32>(0.0), vec3<f32>(0.0), 1);
}

// The same, and the relative height at `np` - 1 more points (up to 4),
// here + s1, - s1, + s2, - s2 (metres), from the same streams.
pub fn drain_probed(hi: vec3<f32>, lo: vec3<f32>, radius: f32, cell: f32, net: read_store<f32, 1>, seed: i32,
                    s1: vec3<f32>, s2: vec3<f32>, np: i32) -> Drain {
    let f = local_frame(hi, lo, radius);
    let up = normalize(hi + lo);
    var q: array<vec2<f32>, 5>;
    q[0] = vec2<f32>(0.0);
    q[1] = vec_local(f, s1);
    q[2] = -q[1];
    q[3] = vec_local(f, s2);
    q[4] = -q[3];
    var rel: array<f32, 5>;
    var acc: array<f32, 5>;
    for (var p: i32 = 0; p < 5; p += 1) {
        rel[p] = 1.0;
        acc[p] = 0.0;
    }
    // The level's segments, and the next's as they are found.
    var sa: array<vec4<f32>, 25>;
    var sb: array<vec4<f32>, 25>;
    var sc: array<vec4<f32>, 25>;
    // The level's points' potentials.
    var pa: array<vec4<f32>, 49>;
    var pb: array<vec4<f32>, 49>;
    let sg = cell_spread(cell);
    var t = tally_none();
    let dry = dryness(up, seed);
    let st = strengths(dry, 0.0, radius);
    let grain = grain_at(up, f, seed);
    var drop: array<f32, 4>;

    // Level 0: the reaches from the 5 x 5 rivers' points about here, every
    // reach whose valley can reach here.
    let l0 = spacing(0, radius);
    let w0 = VALLEY * l0;
    let f0 = fade(l0, cell);
    let c0 = cell_of(up);
    var zsum: f32 = 0.0;
    var wsum: f32 = 0.0;
    var dmin: f32 = 1.0e9;
    for (var m: i32 = 0; m < 25; m += 1) {
        let s = reach_seg(net, cell_next(c0, m % 5 - 2, m / 5 - 2), f);
        sa[m] = s.a;
        sb[m] = s.b;
        sc[m] = s.c;
        if (s.c.z > 0.0) {
            let ch = chord(s.a, q[0]);
            let wt = base_weight(ch.x / l0);
            zsum += wt * mix(s.b.z, s.b.w, ch.y / ch.z);
            wsum += wt;
            if (f0 > 0.0) {
                for (var p: i32 = 0; p < np; p += 1) {
                    let dt = seg_dist(s, q[p], 0, w0, seed);
                    acc[p] += valley_term(s, dt, 0, w0);
                    if (p == 0) {
                        if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, 0, w0)); }
                        t = tally_water(t, s, dt.x, 0, 1.0, sg);
                    }
                }
            }
        }
    }
    let base = wsum > 0.0 ? zsum / wsum : 0.0;
    for (var p: i32 = 0; p < np; p += 1) { rel[p] = rel_after(1.0, acc[p], 0.0, f0); }
    t = tally_level(t, 0, dmin, w0, f0, 1.0);

    // Levels 1 on, each from the last's segments while the cells resolve
    // them; past that each the mean over its valleys.
    var resolved = f0 > 0.0;
    var ubar: f32 = 0.0;
    for (var k: i32 = 1; k <= DRAIN_LEVELS; k += 1) {
        let lk = spacing(k, radius);
        let wk = VALLEY * lk;
        let sig = rise(k);
        let fk = fade(lk, cell);
        let ak = comp4(st, k - 1);
        let before = rel[0];
        if (!resolved || fk <= 0.0) {
            ubar = ubar_next(ubar, k);
            for (var p: i32 = 0; p < np; p += 1) { rel[p] = mean_rel(rel[p], ubar); }
            t = tally_level(t, k, 1.0e9, wk, 0.0, ak);
            drop[k - 1] = before - rel[0];
            resolved = false;
            continue;
        }
        let n = RIV_N << (2 * k);
        let ck = cell_in(up, n);
        let sk = seed + 1000 * k;
        // The potentials of the 7 x 7 points about here and of here itself
        // (index 49), each from the segments above about its parent.
        var uq: f32 = 1.0e9;
        for (var m: i32 = 0; m < 50; m += 1) {
            var di: i32 = 0;
            var dj: i32 = 0;
            var x = q[0];
            if (m < 49) {
                di = m % 7 - 3;
                dj = m / 7 - 3;
                x = to_local(f, site_dir(cell_step(ck, di, dj, n), n, sk));
            }
            let pi = parent_of(ck.y + di) - parent_of(ck.y) + 2;
            let pj = parent_of(ck.z + dj) - parent_of(ck.z) + 2;
            var near = near_none();
            for (var e: i32 = 0; e < 9; e += 1) {
                let at = (pj + e / 3 - 1) * 5 + pi + e % 3 - 1;
                near = near_try(near, Seg { a: sa[at], b: sb[at], c: sc[at] }, x, sig, lk);
            }
            if (m == 49) {
                uq = streams_about(near, sig);
            } else {
                let pt = pot_of(near, x, k, lk, seed);
                pa[m] = pt.a;
                pb[m] = pt.b;
            }
        }
        ubar = uq < 1.0e8 ? uq : ubar_next(ubar, k);
        // The links of the 5 x 5 within, to the neighbour the potential
        // falls to most steeply or to the network above, and their valleys
        // here.
        for (var p: i32 = 0; p < np; p += 1) { acc[p] = 0.0; }
        dmin = 1.0e9;
        for (var m: i32 = 0; m < 25; m += 1) {
            let o = (m / 5 + 1) * 7 + m % 5 + 1;
            let po = Pot { a: pa[o], b: pb[o] };
            var tgt: i32 = o;
            var steep: f32 = 0.0;
            for (var nb: i32 = 0; nb < 9; nb += 1) {
                let at = o + (nb / 3 - 1) * 7 + nb % 3 - 1;
                let pt = Pot { a: pa[at], b: pb[at] };
                let sl = fall(po, pt) * lean(grain, po, pt);
                if (sl > steep) {
                    steep = sl;
                    tgt = at;
                }
            }
            let s = link_of(po, Pot { a: pa[tgt], b: pb[tgt] }, tgt != o, k, sig,
                            site_id(cell_step(ck, m % 5 - 2, m / 5 - 2, n), k));
            sa[m] = s.a;
            sb[m] = s.b;
            sc[m] = s.c;
            if (s.c.z > 0.0) {
                for (var p: i32 = 0; p < np; p += 1) {
                    let dt = seg_dist(s, q[p], k, wk, seed);
                    acc[p] += valley_term(s, dt, k, wk);
                    if (p == 0) {
                        if (dt.x < dmin) { dmin = min(dmin, seg_near(s, dt.x, k, wk)); }
                        t = tally_water(t, s, dt.x, k, fk, sg);
                    }
                }
            }
        }
        for (var p: i32 = 0; p < np; p += 1) { rel[p] = rel_after(rel[p], acc[p], ubar, fk); }
        t = tally_level(t, k, dmin, wk, fk, ak);
        drop[k - 1] = before - rel[0];
    }
    return drain_of(base, rel[0], t, vec4<f32>(rel[1], rel[2], rel[3], rel[4]),
                    vec4<f32>(drop[0], drop[1], drop[2], drop[3]), dry);
}

// Ground h0 metres up drained: the base level plus its relative height of
// the height hh over it, each level's drop taken as strongly as the land
// here cuts it (strengths) and of the depth it can cut there (depth_scale
// c: hh while hh is well under c, saturating to c past it), so the coarse
// levels cut in proportion to the relief and the fine ones, gullies, no
// deeper than their width allows. x the height, y its
// slope to h0 (the share of the relief's octaves it carries). Ground under
// the base level (a hollow) as it is. `rel` may be a probe's (drain_probed)
// with the point's drops: the probe's own difference from the point is the
// finest level's, and cut as that level's.
pub fn drained(h0: f32, base: f32, rel_at: f32, d: Drain, radius: f32) -> vec2<f32> {
    let hh = h0 - base;
    if (hh <= 0.0) { return vec2<f32>(h0, 1.0); }    let st = strengths(d.dry, hh, radius);
    // The relative height after level 0 alone, and each level's cut from
    // it. The levels' depths are each a quarter of the last's (their
    // spacings'), so their saturations are one exponential's powers.
    let rel0 = d.rel + d.drops.x + d.drops.y + d.drops.z + d.drops.w;
    let c = vec4<f32>(depth_scale(1, radius), depth_scale(2, radius), depth_scale(3, radius), depth_scale(4, radius));
    let e1 = exp(-hh / c.x);
    let e2 = (e1 * e1) * (e1 * e1);
    let e3 = (e2 * e2) * (e2 * e2);
    let e = vec4<f32>(e1, e2, e3, (e3 * e3) * (e3 * e3));
    let dj = d.drops * st;
    let h = hh * rel0 + (rel_at - d.rel) * st.w * c.w * (1.0 - e.w) - dot(c * (vec4<f32>(1.0) - e), dj);
    let k = rel0 + (rel_at - d.rel) * st.w * e.w - dot(e, dj);
    return vec2<f32>(base + h, k);
}
