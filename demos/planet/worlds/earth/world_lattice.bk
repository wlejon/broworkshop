// Where Earth's noise lattices lie (planet::world_lattice, which the core's
// anchors read, core/anchor.bk): the point at a direction, in the noise's
// coordinates, of each of the anchor's lattices, a.l[i]:
//   P  the relief's first octave, BASE_WAVELENGTH (ground.bk's p), simplex
//   V  the albedo's variation, from octave VARY_FIRST of it (variation), a grid
//   F  the strata's folds, every STRATA_FOLD metres (strata), a grid
module planet::world_lattice;
from planet::relief import BASE_WAVELENGTH;

pub const LATTICES: i32 = 3;
pub const P: i32 = 0;
pub const V: i32 = 1;
pub const F: i32 = 2;
pub const VARY_FIRST: i32 = 5;
pub const STRATA_FOLD: f32 = 3500.0;

// Whether lattice i is simplex's (skewed) or a grid's.
pub fn lattice_skewed(i: i32) -> bool {
    return i == P;
}
// Lattice i's point at a unit direction known only to f32 (anchor.bk
// anchor_near).
pub fn lattice_point_near(i: i32, dir: vec3<f32>, radius: f32) -> vec3<f32> {
    let p = dir * (radius / BASE_WAVELENGTH);
    if (i == P) { return p; }
    if (i == V) { return p * exp2(VARY_FIRST as f32); }
    return dir * (radius / STRATA_FOLD);
}
// At a unit direction in f64, on the CPU (anchor.bk anchor_of).
pub fn lattice_point(i: i32, d: vec3<f64>, radius: f64) -> vec3<f64> {
    let p = d * (radius / (BASE_WAVELENGTH as f64));
    if (i == P) { return p; }
    if (i == V) { return p * exp2(VARY_FIRST as f64); }
    return d * (radius / (STRATA_FOLD as f64));
}
