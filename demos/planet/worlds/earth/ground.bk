// The planet's ground: one height function of the unit direction, and the
// colour of the truth under a cell. produce.bk's kernels fill tiles with it;
// the tests measure it. GPU code is f32: a direction is an anchor's (anchor.bk,
// its noise lattices found in f64 on the CPU) plus an f32 offset e from it, so
// a cell lands exactly at any scale, Earth radius included.
module planet::ground;

import std::noise::*;
import tiles;
from planet::rivers import water_at, Water, RIM, RIM_CREST, lake_rim, sea_water;
from planet::dendry import Drain, drain_at, drain_probed, drained;
from planet::climate import Climate, climate_at, cover_at, temp_at, snow_at;
// The ridged relief's octaves and statistics, which the ground's shader
// shares (relief.bk): BASE_WAVELENGTH the first octave's wavelength, metres;
// RIDGE_MEAN E[(1 - |noise|)^2] and NOISE_VAR Var(noise), measured over 200k
// samples; NOISE_GRAD_VAR the variance of the noise's gradient along one axis
// per unit of input.
from planet::relief import BASE_WAVELENGTH, RIDGE_MEAN, RIDGE_FIRST, RIDGE_LAST,
    RIDGE_PAST, FINE_FIRST, WARP_OCTAVE, WARP_DISPLACE, ridge_amp, ridge_cell_mean, span_at, mean_factor, kept_share;
from planet::noise import NOISE_VAR, NOISE_GRAD_VAR, NOISE_BOX, normal_cdf, SimplexAt, simplex_grad, simplex_f32,
    simplex_grad_f32, GRAD_TO_VALUE;
from planet::world_lattice import RANGE, VARY_FIRST, STRATA_FOLD;
from planet::anchor import Anchor, Lattice, PerlinAt, twice, doubled, simplex_from, perlin_from, moved, anchor_near;

// Var((1 - |noise|)^2), and the variance of its gradient along one axis per
// unit of input, measured the same way.
const RIDGE_VAR: f32 = 0.0727;
const RIDGE_GRAD_VAR: f32 = 4.586;

// The ground's noise: OpenSimplex2S, continuous everywhere. The classic
// simplex (std simplex3d) steps on planes like y = z that every octave
// shares: a 4 cm ledge along the cube's +Y/+Z edge, a line to the horizon.
//
// It is std supersimplex3d (relief.bk simplex_grad) at a lattice point and
// an offset from it (anchor.bk simplex_from): octave k of lattice l at the
// point `off` from l's point (in the noise's units at l's own octave).
fn noise_on(l: Lattice, k: i32, off: vec3<f32>, seed: i32) -> f32 {
    return simplex_grad(simplex_from(doubled(l, k), off * exp2(k as f32)), seed).x;
}

// A cell holds the mean of the ground over it, not the value at its centre:
// on a crest the centre stands above the mean, in a hollow below it, and
// children's means average to their parent's where centres do not. An
// octave's mean over a cell, given its value at the centre, is that value
// moved toward the octave's mean by a factor (the regression slope) that
// falls as the cell widens: `span` is the cell in the octave's wavelengths,
// exp2(o - octaves) / 2.5 (octaves_for). For a smooth wave the factor is
// 1 - k^2 L^2 / 24 ~ exp(-k^2 L^2 / 24) (the box's Laplacian term); E[k^2]
// along the surface is twice the gradient variance along one axis over the
// variance, which gives NOISE_BOX and RIDGE_BOX per unit of span^2. Measured
// over 100k cells (16 x 16 samples each), the noise holds to it out to a
// cell a wavelength wide; the ridge's crests are kinks, so its factor falls
// by exp(-0.9 span) as cells widen. Both within a few hundredths.
const RIDGE_BOX: f32 = 2.0 * RIDGE_GRAD_VAR / RIDGE_VAR / 24.0;
fn span_of(o: i32, octaves: f32) -> f32 {
    return span_at(o, octaves);
}
fn noise_mean_factor(o: i32, octaves: f32) -> f32 {
    return mean_factor(o, octaves);
}
fn ridge_mean_factor(o: i32, octaves: f32) -> f32 {
    let s = span_of(o, octaves);
    return exp(-RIDGE_BOX * s * s * exp(-0.9 * s));
}
// Octaves past a cell's own carry on until their factor is negligible (a
// cell `NOISE_PAST` octaves finer is 2.3 wavelengths wide, factor 0.003; the
// ridge's 1.1, factor 0.08), the last fading out over its final octave so
// the sum is continuous in `octaves`.
const NOISE_PAST: f32 = 2.5;

// The octaves first to last - 1 of noise on lattice l at `off` from its
// point (the noise's units at octave 0), each at the factor of its mean over
// one of the tile's cells (noise_mean_factor): a tile holds the average of
// what its children hold plus zero-mean detail. Each octave's lattice point
// is the last's doubled (anchor.bk twice), exactly.
fn fbm_to(l: Lattice, off: vec3<f32>, octaves: f32, first: i32, last: i32, seed: i32) -> f32 {
    var sum: f32 = 0.0;
    var amp: f32 = 1.0;
    let past = octaves + NOISE_PAST;
    let n = min(ceil(past) as i32, last);
    var lat = doubled(l, first);
    var d = off * exp2(first as f32);
    for (var o: i32 = first; o < n; o += 1) {
        let w = clamp(past - (o as f32), 0.0, 1.0) * noise_mean_factor(o, octaves);
        sum += simplex_grad(simplex_from(lat, d), seed + o).x * amp * w;
        amp *= 0.5;
        lat = twice(lat);
        d *= 2.0;
    }
    return sum;
}

// The octaves a tile `extent` wide with cells of `inv_size` of its edge can
// carry: down to a wavelength of 2.5 cells (world.js octavesFor, the same).
pub fn octaves_for(extent: f32, inv_size: f32) -> f32 {
    let ratio = BASE_WAVELENGTH / (2.5 * extent * inv_size);
    return clamp(log2(ratio), 1.0, 30.0);
}

// The relief: ridged octaves RIDGE_FIRST to RIDGE_LAST - 1, each (1 -
// |noise|)^2 less its mean, so two-sided and adding nothing on average where
// a tile cannot resolve it; amplitudes peak at octave 8 (9.4 km) and fall
// off by 0.45, down to 2.3 m (relief.bk ridge_amp). Where ranges are, their
// ground is lifted this far (metres): the belt the relief stands on.
const UPLIFT: f32 = 2500.0;
// The detail fbm's first amplitude (octave 4), metres: the plains', and
// what the ranges add on top.
const DETAIL_PLAINS: f32 = 250.0;
const DETAIL_RANGES: f32 = 300.0;

// What the octaves finer than a tile's can still add to its surface, in
// metres: the detail fbm (octave 4 up) and the relief, counted from the last
// octave the tile resolves (a peak between its cells), with a quarter more
// for the noise's reach toward 1. Below the continents' octaves it is
// everything (`top`).
pub fn range_margin(octaves: f32, top: f32) -> f32 {
    let k = (floor(octaves) as i32) - 1;
    if (k < 4) { return top; }
    var m: f32 = (DETAIL_PLAINS + DETAIL_RANGES) * 2.0 * exp2(4.0 - (k as f32));
    for (var o: i32 = max(k, RIDGE_FIRST); o < RIDGE_LAST; o += 1) {
        m += ridge_amp(o);
    }
    return m * 1.25;
}

// The shares of an octave's variance that lie inside one of a tile's cells,
// about the cell's value: `f` the octave's mean factor at the cell, `box`
// its k^2 / 24.
//
// within_share: all of it the cell does not hold, 1 - f^2.
fn within_share(f: f32) -> f32 {
    return 1.0 - f * f;
}

// unresolved_share: what is left once the cell's own slope is known too.
// The slope across a cell L wide carries g^2 L^2 / 12, which expected_surface
// counts exactly; as a share of the octave's variance that is 2 box span^2
// of the slope the cell holds (f^2 of it).
fn unresolved_share(f: f32, box: f32, span: f32) -> f32 {
    return max(1.0 - f * f - 2.0 * box * span * span * f * f, 0.0);
}

// gradient_share: the share of an octave's gradient variance a cell's own
// gradient misses. The gradient is a central difference over two cells,
// which passes sinc(2 pi span) of the slope of what the cell holds, so an
// octave near the cells' limit keeps half of it; and the slope varies across
// the cell by about span^2 of its own.
fn gradient_share(f: f32, span: f32) -> f32 {
    let x = 6.2831853 * min(span, 1.0);
    let kept = f * sin(x) / x;
    return min(1.0 - kept * kept + span * span * f * f, 1.0);
}

// E[(X - k)+] for X ~ N(m, s^2): the mean of a ramp over noise a tile
// cannot resolve.
fn ramp_mean(m: f32, s: f32, k: f32) -> f32 {
    if (s < 1e-6) { return max(m - k, 0.0); }
    let z = (m - k) / s;
    return (m - k) * normal_cdf(z) + s * 0.3989423 * exp(-0.5 * z * z);
}

// E[clamp(X, lo, hi)] for X ~ N(m, s^2).
fn clamp_mean(m: f32, s: f32, lo: f32, hi: f32) -> f32 {
    return lo + ramp_mean(m, s, lo) - ramp_mean(m, s, hi);
}

// The broad masks at `off` from the anchor's p (p = dir * radius /
// BASE_WAVELENGTH): x the continents, y what they vary by inside one of the
// tile's cells as Gaussian noise (the coastline clamps take their mean over
// it, so a coarse tile holds what its descendants average to), z where
// mountain ranges rise, w how much is land.
//
// The continents read through a broad warp (octaves 1 and 3: 1200 and
// 300 km wavelengths, displacing up to a few hundred kilometres), which
// bends their coasts into peninsulas, capes and gulfs: unwarped, a coast
// was the zero line of a few smooth octaves, and ran straight for a
// thousand kilometres. Its octaves go on to 6 (a 37 km wavelength), so
// the coast is ragged at every scale a continent is seen at.
const CONTINENT_OCTAVES: i32 = 7;
// Each octave's displacement is one noise's gradient (relief.bk
// GRAD_TO_VALUE), a field per axis at the cost of one.
fn continent_offset(a: Anchor, off: vec3<f32>, seed: i32) -> vec3<f32> {
    let broad = simplex_grad(simplex_from(doubled(a.p, 1), off * 2.0), seed + 420).yzw;
    let fine = simplex_grad(simplex_from(doubled(a.p, 3), off * 8.0), seed + 423).yzw;
    return off + (broad * 0.1 + fine * 0.025) * GRAD_TO_VALUE;
}
// Under them, the continents' own scale: one octave twice the base
// wavelength (about 5000 km), which gathers the land into a few great
// masses with oceans between, where the base octaves alone scattered it
// over the planet in even blobs. At that wavelength f32 directions (half a
// metre) are exact enough to read it without a lattice.
const CONTINENT_SCALE: f32 = 0.55;     // noise cycles per p unit: ~4400 km
const CONTINENT_WEIGHT: f32 = 1.4;
const BELT_SCALE: f32 = 0.8;           // the ranges' belts: ~3000 km
// Lowers the continents field: about a third of the planet is land.
const SEA_SHARE_BIAS: f32 = -0.3;
fn masks(a: Anchor, off: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> vec4<f32> {
    let warped = continent_offset(a, off, seed);
    let p = a.dir * (radius / BASE_WAVELENGTH) + warped;
    let big = simplex_f32(p * CONTINENT_SCALE, seed + 430) * CONTINENT_WEIGHT;
    let continents = big + fbm_to(a.p, warped, octaves, 0, CONTINENT_OCTAVES, seed) + SEA_SHARE_BIAS;
    var unresolved: f32 = 0.0;
    var amp: f32 = 1.0;
    for (var o: i32 = 0; o < CONTINENT_OCTAVES; o += 1) {
        unresolved += amp * amp * NOISE_VAR * within_share(noise_mean_factor(o, octaves));
        amp *= 0.5;
    }
    let sc = sqrt(unresolved);
    let onLand = clamp_mean(continents * 6.0 + 0.3, sc * 6.0, 0.0, 1.0);
    // Ranges stand in belts, as a planet's do along its plates' margins:
    // where a broad noise (~3000 km, warped with the continents) crosses
    // zero, a few hundred kilometres wide and thousands long, broken into
    // chains along their length by a field of the same call (its gradient),
    // with lowlands and plains between.
    let belt = simplex_grad_f32(p * BELT_SCALE, seed + 300);
    let rn = belt.x;
    let gate = belt.y * GRAD_TO_VALUE;
    let ranges = smoothstep(0.8, 0.95, 1.0 - abs(rn)) * smoothstep(-0.35, 0.1, gate);
    return vec4<f32>(continents, sc, ranges, onLand);
}

// The relief reads its octaves through a warp: a smooth displacement (one
// octave of noise per axis at octave WARP_OCTAVE, a 19 km wavelength, twice
// the relief's strongest; about 1.2 km on average, 3 km at most) that bends
// ridgelines off the noise lattice's directions and breaks the round basins
// between them into valleys, short of folding the ground over itself.
// (WARP_OCTAVE and WARP_DISPLACE, in p units per unit of noise, are relief.bk's.)
//
// The relief's point at `off` from the anchor's p: off moved by the warp (p
// units), from which the relief's octaves run on the p lattice.
pub fn relief_offset(a: Anchor, off: vec3<f32>, seed: i32) -> vec3<f32> {
    let at = simplex_from(doubled(a.p, WARP_OCTAVE), off * exp2(WARP_OCTAVE as f32));
    let warp = vec3<f32>(simplex_grad(at, seed + 400).x, simplex_grad(at, seed + 401).x, simplex_grad(at, seed + 402).x);
    return off + warp * WARP_DISPLACE;
}

// The relief at `off`, metres at full uplift: the ridged octaves, each its
// mean over one of the tile's cells (relief.bk ridge_cell_mean) less the
// ridge's mean. x the octaves below FINE_FIRST, y those from it on: the
// ground's fine relief (a 1.2 km wavelength on), spurs, gullies and knolls,
// which a valley's sides carry on (terrain) instead of being planed away;
// z the part of the fine relief finer than the drainage's gullies
// (relief.bk kept_share), which rides on the drained ground unscaled.
fn relief(a: Anchor, off: vec3<f32>, octaves: f32, seed: i32) -> vec3<f32> {
    let n = min(ceil(octaves + RIDGE_PAST) as i32, RIDGE_LAST);
    if (n <= RIDGE_FIRST) { return vec3<f32>(0.0); }
    var lat = doubled(a.p, RIDGE_FIRST);
    var d = relief_offset(a, off, seed) * exp2(RIDGE_FIRST as f32);
    var broad: f32 = 0.0;
    var fine: f32 = 0.0;
    var kept: f32 = 0.0;
    let past = octaves + RIDGE_PAST;
    for (var o: i32 = RIDGE_FIRST; o < n; o += 1) {
        let fade = clamp(past - (o as f32), 0.0, 1.0);
        let mean = ridge_cell_mean(simplex_grad(simplex_from(lat, d), seed + 100 + o).x, noise_mean_factor(o, octaves));
        let v = (mean - RIDGE_MEAN) * ridge_amp(o) * fade;
        if (o < FINE_FIRST) {
            broad += v;
        } else {
            let ks = kept_share(o);
            fine += v * (1.0 - ks);
            kept += v * ks;
        }
        lat = twice(lat);
        d *= 2.0;
    }
    return vec3<f32>(broad, fine, kept);
}

// The anchor's offset e in p units.
fn p_offset(e: vec3<f32>, radius: f32) -> vec3<f32> {
    return e * (radius / BASE_WAVELENGTH);
}

// The ground before the water cuts it, metres above the sphere at offset e
// from the anchor's direction: x its broad shape, y the fine relief over it
// (FINE_FIRST). Continents from the broad octaves, ranges where a broad mask
// allows them on land (lifted, and carrying the ridged relief), and the fine
// octaves over both, rougher in the ranges. z how much of the relief the
// land carries (relief_scale); w the fine relief finer than the drainage's
// gullies (relief), which the drainage leaves as it is.
pub fn terrain_parts(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> vec4<f32> {
    return terrain_parts_over(a, e, masks(a, p_offset(e, radius), radius, octaves, seed), radius, octaves, seed);
}
// The same over masks `m` already read: a supersampled cell reads them once
// at its centre, at its own octaves, where they are the mean over the cell
// (their finest octave is tens of kilometres; the coast's clamps take their
// mean over the rest, masks y).
fn terrain_parts_over(a: Anchor, e: vec3<f32>, m: vec4<f32>, radius: f32, octaves: f32, seed: i32) -> vec4<f32> {
    let off = p_offset(e, radius);
    let land = clamp_mean(m.x * 3.0 + 0.15, m.y * 3.0, -1.0, 1.0);
    let uplift = m.z * m.w;
    let rs = relief_scale(a, off, m, radius, seed);
    let r = relief(a, off, octaves, seed);
    let amp = DETAIL_PLAINS + DETAIL_RANGES * uplift;
    let broad = fbm_to(a.p, off, octaves, 4, FINE_FIRST, seed + 200);
    let fine = fbm_to(a.p, off, octaves, FINE_FIRST, 64, seed + 200) * exp2((4 - FINE_FIRST) as f32);
    return vec4<f32>(land * 1100.0 + uplift * UPLIFT + rs * r.x + broad * amp, rs * r.y + fine * amp, rs, rs * r.z);
}
// The ridged relief the land carries (per unit at full uplift): all in the
// ranges, between them hill country in ~1000 km regions, HILLS_LOW (rolling)
// to HILLS_HIGH (foothills, low mountains). None at sea.
const HILL_SCALE: f32 = 2.4;
const HILLS_LOW: f32 = 0.1;
const HILLS_HIGH: f32 = 0.5;
fn relief_scale(a: Anchor, off: vec3<f32>, m: vec4<f32>, radius: f32, seed: i32) -> f32 {
    let n = simplex_f32((a.dir * (radius / BASE_WAVELENGTH) + off) * HILL_SCALE, seed + 440);
    return max(m.z, mix(HILLS_LOW, HILLS_HIGH, smoothstep(-0.15, 0.5, n))) * m.w;
}
pub fn terrain_base(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> f32 {
    let t = terrain_parts(a, e, radius, octaves, seed);
    return t.x + t.y + t.w;
}
// The same at a direction known only to f32 (anchor.bk anchor_near): for the
// clouds' and the rivers' coarse work, good to about a metre.
pub fn terrain_base_near(dir: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> f32 {
    return terrain_base(anchor_near(dir, radius), vec3<f32>(0.0), radius, octaves, seed);
}

// The width of a cell that carries `octaves` (octaves_for, inverted).
pub fn cell_width(octaves: f32) -> f32 {
    return BASE_WAVELENGTH / (2.5 * exp2(octaves));
}

// The ground at offset e, metres above the sphere, or the water over it:
// the terrain drained (dendry.bk: its height over the base level its water
// drains to, scaled by the relative height of the valleys within valleys
// there, each level's cut saturating at its own depth, so the valleys'
// sides carry its relief), the relief finer than the drainage's gullies on
// it unscaled, cut down by the rivers' channels and floodplains
// (rivers.bk), and a lake's level where it stands over that. The rivers'
// cut joins the ground by a smooth minimum over up to CUT_BLEND metres,
// its sides carrying the fine relief on, faded out over the last
// VALLEY_FLOOR metres to its bed. y, z and w: how much the ground moves with
// the relief's octaves below FINE_FIRST, from it on, and the part of those
// finer than the gullies (relief), per metre of relief at full uplift: the
// relief_scale where the ground stands, scaled as the drainage scales it (the
// finest not), less where a river cuts it (the fine parts as its sides
// carry them on), none under a lake. The ground's shader scales the
// octaves finer than its texels by them (ground_mesh.bk).
const VALLEY_FLOOR: f32 = 150.0;
const CUT_BLEND: f32 = 40.0;
const CUT_SOFT: f32 = 3.0;
const BANK_BLEND: f32 = 4.0;
const SHORE_WANDER: f32 = 45.0;
pub fn terrain_shaped(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> vec4<f32> {
    return shaped_by(terrain_parts(a, e, radius, octaves, seed), water_at(a.dir, e, radius, cell_width(octaves), net, seed),
                     drain_at(a.dir, e, radius, cell_width(octaves), net, seed), radius);
}
// The ground's parts (terrain_parts) drained by d and cut by the water w
// found for them (read only once the parts are: held through the noise, a
// tile's drainage costs its kernels threads).
pub fn shaped_by(t: vec4<f32>, w: Water, d: Drain, radius: f32) -> vec4<f32> {
    return shaped_rel(t, w, d, d.rel, radius);
}
// The same at relative height `rel` (a probe's, site_ground).
fn shaped_rel(t: vec4<f32>, w: Water, d: Drain, rel: f32, radius: f32) -> vec4<f32> {
    // The drained height and d h / d (t.x + t.y).
    let dr = drained(t.x + t.y, d.base, rel, d, radius);
    let k = dr.y;
    let h = dr.x + t.w;
    let side = smoothstep(0.0, VALLEY_FLOOR, w.near.x - w.bed);
    let valley = w.near.x + (t.y + t.w) * side;
    let x = h - valley;
    // Ground under the valley stays as it is; ground over it eases down to
    // it over a blend of twice its height over the bed, from CUT_SOFT (a low
    // bank), leaving the valley with the ground's own slope, so no crease:
    // never under the valley, never over the ground (a smooth minimum sank
    // floodplains under the land in engraved scarps).
    let blend = clamp(2.0 * (h - w.bed), CUT_SOFT, CUT_BLEND);
    let bx = blend;
    let tb = clamp(x / bx, 0.0, 1.0);
    let sb = tb * tb * (3.0 - 2.0 * tb);
    // (h - x sb, not valley + x (1 - sb): far from a stream the valley is a
    // sentinel, and the sum loses the ground's height to it.)
    let cut = h - x * sb;
    let u = t.z;
    var g = vec4<f32>(cut, u * k, u * k, u);
    if (tb > 0.0) {
        // On the cut: d cut / d h and d cut / d valley.
        let dh = 1.0 - sb - x * 6.0 * tb * (1.0 - tb) / bx;
        g = vec4<f32>(cut, u * k * dh, u * (k * dh + (1.0 - dh) * side), u * (dh + (1.0 - dh) * side));
    }
    if (w.lake < -1.0e8) { return g; }
    // A lake near (rivers.bk lake_rim): its rim, carrying the ground's fine
    // relief (less over its crest, so the crest holds over the level), joins
    // the ground by a smooth maximum over BANK_BLEND metres, with no crease
    // at its foot. The relief moves the beach in and out, SHORE_WANDER
    // metres a metre of it, none at the crest, so the waterline runs in bays
    // and points, not along the profile's contour. Under the level on the
    // lake's side of the crest, the lake's surface.
    let level = w.near.z;
    let fine = t.y + t.w;
    let rim = lake_rim(w.shore + SHORE_WANDER * fine * clamp(1.0 - w.shore / RIM_CREST, 0.0, 1.0));
    let gain = clamp(1.0 - 0.7 * rim / RIM, 0.3, 1.0);
    let bank = level + rim + fine * gain;
    let s = clamp(0.5 + 0.5 * (bank - cut) / BANK_BLEND, 0.0, 1.0);
    let ground = mix(cut, bank, s) + BANK_BLEND * s * (1.0 - s);
    if (w.shore < RIM_CREST && ground < level) { return vec4<f32>(level, 0.0, 0.0, 0.0); }
    return vec4<f32>(ground, mix(g.yzw, vec3<f32>(u * gain), s));
}
pub fn terrain(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    return terrain_shaped(a, e, radius, octaves, seed, net).x;
}
// The same drained by d, found for a cell cell_width(octaves) wide (a
// field's, dendry_field.bk field_drain).
pub fn terrain_drained(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>,
                       d: Drain) -> f32 {
    return shaped_by(terrain_parts(a, e, radius, octaves, seed), water_at(a.dir, e, radius, cell_width(octaves), net, seed),
                     d, radius).x;
}

// Whether the ground holds soil, grass and trees or lies bare as rock is
// its slope over tens of metres, not over the bumps of a metre: soil creeps
// and settles over those, and a meadow's hummocks are as steep as a cliff.
// The soil's slope is the ground's through SOIL_OCTAVES (wavelengths down
// to about 37 m), decided there once, so every scale reads the same rock:
// a cell finer than that takes it at its point (soil_gradient), a coarser
// one the share of it under the cell (spread to SOIL_OCTAVES).
pub const SOIL_OCTAVES: f32 = 17.0;
// The ground through SOIL_OCTAVES at offset e, its drainage and its water's
// cut included.
pub fn soil_height(a: Anchor, e: vec3<f32>, radius: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    let cell = cell_width(SOIL_OCTAVES);
    return shaped_by(terrain_parts(a, e, radius, SOIL_OCTAVES, seed), water_at(a.dir, e, radius, cell, net, seed),
                     drain_at(a.dir, e, radius, cell, net, seed), radius).x;
}
pub fn soil_gradient(a: Anchor, e: vec3<f32>, radius: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    return site_ground(a, e, radius, SOIL_OCTAVES, seed, net).grad;
}

// The ground at a site (a tree's, a grass point's): its height at
// `octaves`, the soil's gradient there (soil_gradient), its water and its
// drainage, the drainage found once for all of them (its relative height
// probed at the gradient's four points).
pub struct Site {
    h: f32,
    grad: f32,
    water: Water,
    drain: Drain,
}
pub fn site_ground(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> Site {
    let s = site_probes(a, e);
    let d = drain_probed(a.dir, e, radius, site_cell(octaves), net, seed, s.t1 * SITE_STEP, s.t2 * SITE_STEP, 5);
    return site_ground_drained(a, e, radius, octaves, seed, net, d);
}
// Where a site's gradient is probed: SITE_STEP metres either side along t1
// and t2, across the ground at offset e; and the cell its drainage is found
// for. A field's sites find theirs from its grids (dendry_field.bk
// field_drain at these probes).
pub const SITE_STEP: f32 = 2.0;
pub struct SiteProbes {
    t1: vec3<f32>,
    t2: vec3<f32>,
}
pub fn site_probes(a: Anchor, e: vec3<f32>) -> SiteProbes {
    let n = a.dir + e;
    let axis = abs(n.y) < 0.9 ? vec3<f32>(0.0, 1.0, 0.0) : vec3<f32>(1.0, 0.0, 0.0);
    let t1 = normalize(cross(n, axis));
    return SiteProbes { t1: t1, t2: cross(n, t1) };
}
pub fn site_cell(octaves: f32) -> f32 {
    return cell_width(max(octaves, SOIL_OCTAVES));
}
// The site with its drainage d found at its probes (site_probes) already.
pub fn site_ground_drained(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>,
                           d: Drain) -> Site {
    let pr = site_probes(a, e);
    let t1 = pr.t1;
    let t2 = pr.t2;
    let step = SITE_STEP;
    let w = water_at(a.dir, e, radius, site_cell(octaves), net, seed);
    let k = step / radius;
    let hu = shaped_rel(terrain_parts(a, moved(a.dir, e, t1 * k), radius, SOIL_OCTAVES, seed), w, d, d.probe.x, radius).x
           - shaped_rel(terrain_parts(a, moved(a.dir, e, -t1 * k), radius, SOIL_OCTAVES, seed), w, d, d.probe.y, radius).x;
    let hv = shaped_rel(terrain_parts(a, moved(a.dir, e, t2 * k), radius, SOIL_OCTAVES, seed), w, d, d.probe.z, radius).x
           - shaped_rel(terrain_parts(a, moved(a.dir, e, -t2 * k), radius, SOIL_OCTAVES, seed), w, d, d.probe.w, radius).x;
    var s: Site;
    s.h = shaped_by(terrain_parts(a, e, radius, octaves, seed), w, d, radius).x;
    s.grad = sqrt(hu * hu + hv * hv) / (2.0 * step);
    s.water = w;
    s.drain = d;
    return s;
}

// Below this many octaves a cell is wide enough that the next octaves vary
// a lot inside it, through the coastline clamps and the ridges: such a cell
// averages SUB x SUB samples taken with two more octaves instead of reading
// one, so it is the aggregate of the finer truth, not a guess at it.
const SUPERSAMPLE_BELOW: f32 = 7.0;
const SUB: i32 = 4;

// A tile's point at (s, t) of its frame: its offset from the anchor's
// direction (the tile's record, tiles.bk).
pub fn frame_dir(rec: tiles::Record, s: f32, t: f32) -> vec3<f32> {
    return rec.dir_lo + tiles::sphere_offset(rec, tiles::frame_offset(rec, s, t));
}

// The height a cell holds: at (s, t) of the tile's frame, `cell` wide in
// (s, t).
pub fn cell_height(a: Anchor, rec: tiles::Record, s: f32, t: f32, cell: f32,
                   radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    return cell_ground(a, rec, s, t, cell, radius, octaves, seed, net).h;
}
// The same, with the drainage found for it (the cell's: a supersampled
// cell's samples take it from its centre, where it holds the mean over the
// valleys the cell does not resolve).
pub struct CellGround {
    h: f32,
    drain: Drain,
}
pub fn cell_ground(a: Anchor, rec: tiles::Record, s: f32, t: f32, cell: f32,
                   radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> CellGround {
    let e = frame_dir(rec, s, t);
    return cell_ground_drained(a, rec, s, t, cell, radius, octaves, seed, net,
                               drain_at(a.dir, e, radius, cell_width(octaves), net, seed));
}
// The same with the cell's drainage found already (a tile's, dendry_grid.bk).
pub fn cell_ground_drained(a: Anchor, rec: tiles::Record, s: f32, t: f32, cell: f32, radius: f32, octaves: f32,
                           seed: i32, net: read_store<f32, 1>, d: Drain) -> CellGround {
    let e = frame_dir(rec, s, t);
    let w = water_at(a.dir, e, radius, cell_width(octaves), net, seed);
    var out: CellGround;
    out.drain = d;
    if (octaves >= SUPERSAMPLE_BELOW) {
        out.h = shaped_by(terrain_parts(a, e, radius, octaves, seed), w, d, radius).x;
        return out;
    }
    let m = masks(a, p_offset(e, radius), radius, octaves, seed);
    var sum: f32 = 0.0;
    for (var j: i32 = 0; j < SUB; j += 1) {
        for (var i: i32 = 0; i < SUB; i += 1) {
            let ds = (((i as f32) + 0.5) / (SUB as f32) - 0.5) * cell;
            let dt = (((j as f32) + 0.5) / (SUB as f32) - 0.5) * cell;
            sum += shaped_by(terrain_parts_over(a, frame_dir(rec, s + ds, t + dt), m, radius, octaves + 2.0, seed), w, d,
                             radius).x;
        }
    }
    out.h = sum / ((SUB * SUB) as f32);
    return out;
}

// ── Colour ──────────────────────────────────────────────────────────────────
//
// A cell's colour is the mean colour of the truth under it, not the colour
// of its mean: snow-capped peaks over green valleys read from orbit as the
// mix they are. The truth under a cell is modelled as its own height and
// gradient plus Gaussian spreads from the octaves it does not resolve.
//
// What the truth under a cell varies by about the cell's own values: x the
// height (m) the cell's slope does not account for, y the gradient along
// either axis (m/m). Each octave counts by unresolved_share in height and
// gradient_share in gradient, down to `truth`, the finest octaves anything
// draws. With gain 0.5 and lacunarity 2 every octave adds the same slope,
// so the fine octaves matter to the gradient as much as the broad ones.
pub fn spread(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, truth: f32, seed: i32) -> vec2<f32> {
    let m = masks(a, p_offset(e, radius), radius, octaves, seed);
    // The continents through the coastline clamp, which passes them where
    // it is linear: 1100 * 3 metres of height per unit of noise.
    let mc = m.x * 3.0 + 0.15;
    let sc = max(m.y * 3.0, 1e-6);
    let land = 3300.0 * (normal_cdf((1.0 - mc) / sc) - normal_cdf((-1.0 - mc) / sc));
    var ch: f32 = 0.0;
    var cg: f32 = 0.0;
    var amp: f32 = 1.0;
    for (var o: i32 = 0; o < CONTINENT_OCTAVES; o += 1) {
        let f = noise_mean_factor(o, octaves);
        let s = span_of(o, octaves);
        ch += amp * amp * NOISE_VAR * unresolved_share(f, NOISE_BOX, s);
        cg += NOISE_GRAD_VAR * gradient_share(f, s);   // amplitude * frequency = 1
        amp *= 0.5;
    }
    // The relief, in metres already (ridge_amp), as the land carries it.
    let mount = relief_scale(a, p_offset(e, radius), m, radius, seed);
    let lift = m.z * m.w;
    var rh: f32 = 0.0;
    var rg: f32 = 0.0;
    for (var o: i32 = RIDGE_FIRST; o < RIDGE_LAST; o += 1) {
        let f = ridge_mean_factor(o, octaves) * clamp(octaves + RIDGE_PAST - (o as f32), 0.0, 1.0);
        let s = span_of(o, octaves);
        let ra = ridge_amp(o);
        let rf = ra * exp2(o as f32);   // amplitude * frequency
        let w = clamp(truth - (o as f32), 0.0, 1.0);
        rh += ra * ra * RIDGE_VAR * unresolved_share(f, RIDGE_BOX, s) * w * w;
        rg += rf * rf * RIDGE_GRAD_VAR * gradient_share(f, s) * w * w;
    }
    // The detail, octave 4 up at amplitude 0.5^(o - 4), to the truth's last.
    let detail = DETAIL_PLAINS + DETAIL_RANGES * lift;
    var dh: f32 = 0.0;
    var dg: f32 = 0.0;
    amp = 1.0;
    let n = ceil(truth) as i32;
    for (var o: i32 = 4; o < n; o += 1) {
        let w = clamp(truth - (o as f32), 0.0, 1.0);
        let f = noise_mean_factor(o, octaves) * clamp(octaves + NOISE_PAST - (o as f32), 0.0, 1.0);
        let s = span_of(o, octaves);
        dh += amp * amp * NOISE_VAR * unresolved_share(f, NOISE_BOX, s) * w * w;
        dg += 256.0 * NOISE_GRAD_VAR * gradient_share(f, s) * w * w;   // amplitude * frequency = 16
        amp *= 0.5;
    }
    let wl = BASE_WAVELENGTH;
    let h2 = land * land * ch + mount * mount * rh + detail * detail * dh;
    let g2 = (land * land * cg + mount * mount * rg + detail * detail * dg) / (wl * wl);
    return vec2<f32>(sqrt(h2), sqrt(g2));
}

pub use planet::surface::{
    surface, strata, bedded_surface, grass_cover, tree_cover, banked, with_streams,
    woodland, wooded, perlin_f32, perlin_at, variation, expected_surface, sea_floor,
    expected_cover, gradient,
};
