// The trees' ground (trees.js): one point per tree site, on a lattice of the
// gnomonic plane of a cube face (the points a + e u + f v projected onto the
// sphere) about a power of two of the plane's units apart, each site at a
// spot hashed inside its lattice cell, so a tree stands where it grew
// whichever field holds it. Each holds the ground's true surface at that
// spot, whether a tree stands there (the forest's cover, ground.bk
// tree_cover, against the site's hash) and how large, and the ground's
// colour variation there, which the crown takes. The field is anchored at
// its centre (anchor.bk, found on the CPU): cell (x, y)'s corner is the plane
// offset lost + e (du0 + x delta) + f (dv0 + y delta) from it.
import std::noise::*;
from planet::ground import tree_cover, variation, site_ground_drained, site_probes, site_cell, SITE_STEP, woodland, wooded,
    banked, with_streams;
from planet::dendry_field import field_drain;
from planet::rivers import water_share;
from planet::climate import climate_at, landform_climate, landform_wood, landform_share;
from planet::anchor import read_anchor, plane_offset;

// Site (x, y0 + y) of the field, lattice site (li + x, lj + y0 + y) on face
// `face`, seven floats at `out` (row * width + x) * 7: its position about
// `origin` (xyz), its size (0: no tree) and the colour variation (rgb).
// `point` is the anchor's surface point (its direction times the radius)
// less the origin. The drainage is the field's about the anchor (its sun
// grid's, sun.bk k_field_*: dendry_field.bk), `reaches` and `segs`.
@kernel @grid(2)
fn k_tree_field(g: grid<2>, out: write_store<f32, 1>, anchor: read_store<vec4<i32>, 1>,
                ex: f32, ey: f32, ez: f32, fx: f32, fy: f32, fz: f32,
                du0: f32, dv0: f32, delta: f32, px: f32, py: f32, pz: f32, radius: f32, octaves: f32, seed: i32,
                li: i32, lj: i32, face: i32, y0: i32, net: read_store<f32, 1>,
                reaches: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>) {
    let a = read_anchor(anchor, 0);
    let row = y0 + g.y();
    let hx = hash_primes3d(seed + 977, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    let hy = hash_primes3d(seed + 1979, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    let hp = hash_primes3d(seed + 2971, (li + g.x()) * PRIME_X, (lj + row) * PRIME_Y, face * PRIME_Z);
    // Anywhere but the cell's very edge, so spacings run from a crown's
    // width down to touching, not an even grid.
    let jx = 0.04 + 0.92 * (((hx >> 8) & 65535) as f32) / 65536.0;
    let jy = 0.04 + 0.92 * (((hy >> 8) & 65535) as f32) / 65536.0;
    let pick = (((hp >> 8) & 65535) as f32) / 65536.0;
    let open = stand_openness(li + g.x(), lj + row, face, jx, jy, seed);
    let du = du0 + ((g.x() as f32) + jx) * delta;
    let dv = dv0 + ((row as f32) + jy) * delta;
    let e = plane_offset(a, a.lost + vec3<f32>(ex, ey, ez) * du + vec3<f32>(fx, fy, fz) * dv);
    // The ground, the soil's slope (the cover's rock, as the ground's colour
    // lays it), the water and the drainage, found together (ground.bk
    // site_ground, its drainage the field's at the site's probes).
    let pr = site_probes(a, e);
    let site = site_ground_drained(a, e, radius, octaves, seed, net,
                                   field_drain(reaches, segs, a, e, radius, site_cell(octaves), seed,
                                               pr.t1 * SITE_STEP, pr.t2 * SITE_STEP, 5));
    let h = site.h;
    let grad = site.grad;
    // Forests grow as a mosaic, forests to glades (ground.bk woodland),
    // leaning to the valleys, in the climate the landform makes (climate.bk
    // landform_climate), the same the ground's colour takes over its
    // texels, and in gallery woods along the rivers' and streams' banks
    // (ground.bk banked); none in the water. A tree stands where the site's
    // pick is under the cover as the stand thins it (stand_openness); at a
    // thinning edge the ones left are smaller, in an opening larger.
    let region = climate_at(normalize(a.dir + e), 0.0, seed);
    let dr = site.drain;
    let lf = landform_share(dr.dry);
    let cl = landform_climate(region, lf * dr.wet, lf * dr.ridge);
    let wa = with_streams(site.water, dr.share, dr.gallery, region, h);
    let local = wooded(banked(tree_cover(h, grad, cl), h, grad, cl, wa),
                       landform_wood(woodland(a, e, radius, 99.0, seed), lf * dr.wet, lf * dr.ridge))
              * (1.0 - smoothstep(0.0, 0.08, water_share(h, wa, 0.0)));
    var size: f32 = 0.0;
    if (pick < local * mix(1.0, OPEN_DENSITY, open)) { size = (0.6 + 0.4 * local) * mix(CLUMP_SIZE, OPEN_SIZE, open); }
    let vary = variation(a, e, radius, octaves, seed);

    let i = (row * g.width() + g.x()) * 7;
    let rel = vec3<f32>(px, py, pz) + e * radius + (a.dir + e) * max(h, 0.0);
    out[i] = rel.x;
    out[i + 1] = rel.y;
    out[i + 2] = rel.z;
    out[i + 3] = size;
    out[i + 4] = vary.x;
    out[i + 5] = vary.y;
    out[i + 6] = vary.z;
}

// A forest grows in stands, not rows: clumps whose crowns close, small
// openings, and in them a few lone trees grown large in the light. The
// openness of site (x, y) on face `face`, 0 in a clump to 1 in an opening,
// from value noise over the sites (16 sites, about 130 m, and 4 sites,
// about 30 m, a step) at the site's spot (jx, jy in its cell). A clump
// stands every site the cover keeps, its trees CLUMP_SIZE; an opening
// OPEN_DENSITY of them, OPEN_SIZE. The two are chosen so the crowns'
// mean area, the density times the size squared over the openness's
// spread, is the cover's as an even stand of size-1 trees had it, which
// the ground's canopy past the drawn trees takes (ground_mesh.bk
// TREE_CROWNS).
const OPEN_DENSITY: f32 = 0.15;
const CLUMP_SIZE: f32 = 1.145;
const OPEN_SIZE: f32 = 1.25;
fn stand_value(x: i32, y: i32, face: i32, jx: f32, jy: f32, shift: i32, seed: i32) -> f32 {
    let cx = x >> shift;
    let cy = y >> shift;
    let m = (1 << shift) - 1;
    let f = (vec2<f32>((x & m) as f32 + jx, (y & m) as f32 + jy)) / ((m + 1) as f32);
    let s = f * f * (vec2<f32>(3.0) - 2.0 * f);
    let n00 = hash_primes3d(seed, cx * PRIME_X, cy * PRIME_Y, face * PRIME_Z);
    let n10 = hash_primes3d(seed, (cx + 1) * PRIME_X, cy * PRIME_Y, face * PRIME_Z);
    let n01 = hash_primes3d(seed, cx * PRIME_X, (cy + 1) * PRIME_Y, face * PRIME_Z);
    let n11 = hash_primes3d(seed, (cx + 1) * PRIME_X, (cy + 1) * PRIME_Y, face * PRIME_Z);
    let v = vec4<f32>(((n00 >> 8) & 65535) as f32, ((n10 >> 8) & 65535) as f32,
                      ((n01 >> 8) & 65535) as f32, ((n11 >> 8) & 65535) as f32) / 65536.0;
    return mix(mix(v.x, v.y, s.x), mix(v.z, v.w, s.x), s.y);
}
fn stand_openness(x: i32, y: i32, face: i32, jx: f32, jy: f32, seed: i32) -> f32 {
    let n = 0.6 * stand_value(x, y, face, jx, jy, 4, seed + 3967) + 0.4 * stand_value(x, y, face, jx, jy, 2, seed + 4973);
    return smoothstep(0.5, 0.68, n);
}
