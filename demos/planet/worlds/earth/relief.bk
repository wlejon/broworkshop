// The mountains' ridged relief, shared by the truth (ground.bk relief) and
// the ground's shader (ground_mesh.bk), which adds per pixel the octaves
// finer than a tile's texels: the octaves and their amplitudes, a ridge
// octave's mean over a cell. The noise is the core's (core/noise.bk).
module planet::relief;
from planet::noise import NOISE_VAR, NOISE_BOX, normal_cdf;

pub const RIDGE_MEAN: f32 = 0.4999;
// The ridged octaves, and how far past a cell's own they carry on.
pub const RIDGE_FIRST: i32 = 4;
pub const RIDGE_LAST: i32 = 21;
pub const RIDGE_PAST: f32 = 1.5;
// From FINE_FIRST on the relief is the fine relief, which a valley's sides
// fade out toward its bed (ground.bk terrain).
pub const FINE_FIRST: i32 = 11;
// How much of a fine octave rides on the drained ground unscaled (ground.bk
// shaped_by): none of the octaves as long as the drainage's valleys, which
// the drainage shapes, all of those under its finest gullies' width (from
// 37 m), the knolls, rills and roughness the ground holds wherever it is.
pub fn kept_share(o: i32) -> f32 {
    return clamp(((o - 14) as f32) * 0.5, 0.0, 1.0);
}
// The ground's first octave's wavelength, metres, and the warp the relief
// reads its octaves through (ground.bk relief): one octave of noise per axis
// at WARP_OCTAVE, WARP_DISPLACE of the base wavelength per unit of noise.
pub const BASE_WAVELENGTH: f32 = 2400000.0;
pub const WARP_OCTAVE: i32 = 7;
pub const WARP_DISPLACE: f32 = 0.0013;
pub const CREST: f32 = 0.08;

// A ridge octave's amplitude, metres at full uplift: peaking at octave 8,
// held high through octave 11 (wavelengths 4.7 to 1.2 km), where alpine
// ranges carve their horns, arêtes and walls, and the finer falling off by
// 0.45 (ground.bk relief).
pub fn ridge_amp(o: i32) -> f32 {
    if (o < 8) {
        if (o == 4) { return 200.0; }
        if (o == 5) { return 350.0; }
        if (o == 6) { return 600.0; }
        return 900.0;
    }
    if (o == 8) { return 1200.0; }
    if (o == 9) { return 1000.0; }
    if (o == 10) { return 750.0; }
    return 500.0 * pow(0.45, (o - 11) as f32);
}

// Octave o's span over a cell carrying `octaves` (ground.bk span_of), and
// the factor its mean over the cell keeps.
pub fn span_at(o: i32, octaves: f32) -> f32 {
    return exp2((o as f32) - octaves) / 2.5;
}
pub fn mean_factor(o: i32, octaves: f32) -> f32 {
    let s = span_at(o, octaves);
    return exp(-NOISE_BOX * s * s);
}

// A ridge octave's mean over a cell, from the noise n at the centre and its
// factor f there (mean_factor). The ridge is (1 - |n|)^2 of a smooth noise,
// whose cell mean is nonlinear: on a crest (n ~ 0) the centre is the ridge's
// top and the cell around it is lower, by more than any factor on the
// ridge's value says. So it is taken through the smooth noise, which holds
// to its box factor: n over the cell ~ N(f n, (1 - f^2) NOISE_VAR), and the
// mean of (1 - |n|)^2 is 1 - 2 E|n| + E[n^2], E|n| a folded normal's, scaled
// so a cell that resolves nothing of the octave holds the ridge's measured
// mean exactly (the noise is bounded, not Gaussian: E|n| = (1 + NOISE_VAR -
// RIDGE_MEAN) / 2 over the Gaussian's sqrt(NOISE_VAR) sqrt(2 / pi)).
// Measured against 16 x 16 box means, it errs 30-40% less than a linear
// factor on the ridge for cells up to a third of a wavelength, crests
// included, and the same for wider ones.
//
// The spread never falls below CREST: a crest is (1 - |n|)^2 seen through
// that much noise, rounded over a twentieth of its octave's wavelength,
// where an exact |n| creases it. A broad octave's crest runs kilometres
// nearly straight, and creased it was a hard line across the land with
// planar flanks either side, at every distance.
pub fn ridge_cell_mean(n: f32, f: f32) -> f32 {
    let mu = f * n;
    let spread2 = max(max(1.0 - f * f, 0.0) * NOISE_VAR, CREST * CREST);
    let sd = sqrt(spread2);
    var fold = abs(mu);
    if (sd > 1e-6) {
        let scale = (1.0 + NOISE_VAR - RIDGE_MEAN) * 0.5 / (0.7978846 * sqrt(NOISE_VAR));
        fold = scale * sd * 0.7978846 * exp(-0.5 * mu * mu / spread2) + mu * (1.0 - 2.0 * normal_cdf(-mu / sd));
    }
    return 1.0 - 2.0 * fold + mu * mu + spread2;
}
// ridge_cell_mean's derivative in n. The folded normal's E|X| has slope
// 1 - 2 Phi(-mu / sd) in mu; its scaling leaves (1 - scale) of the
// Gaussian term's own slope over.
pub fn ridge_cell_slope(n: f32, f: f32) -> f32 {
    let mu = f * n;
    let spread2 = max(max(1.0 - f * f, 0.0) * NOISE_VAR, CREST * CREST);
    let sd = sqrt(spread2);
    let scale = (1.0 + NOISE_VAR - RIDGE_MEAN) * 0.5 / (0.7978846 * sqrt(NOISE_VAR));
    let dfold = 1.0 - 2.0 * normal_cdf(-mu / sd) + 0.7978846 * (1.0 - scale) * mu * exp(-0.5 * mu * mu / spread2) / sd;
    return f * (2.0 * mu - 2.0 * dfold);
}
