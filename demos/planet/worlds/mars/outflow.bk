// Mars's outflow channels: the beds of the floods that burst from the chaos
// at the canyons' mouth and from Echus Chasma and ran north into Chryse
// Planitia: Kasei, Maja, Simud, Tiu and Ares Valles, tens of kilometres
// wide and one to two deep, their floors scoured into longitudinal grooves
// and left with streamlined islands, teardrops of the old ground pointing
// downstream.
//
// A function of the direction alone, kilometres across at its finest, so
// ground.bk reads it with the other broad landforms at its broad lattice's
// corners: each channel a chain of great-circle reaches, the ground cut by
// the deepest reach about the point.
module planet::outflow;
from planet::noise import simplex_f32;
from planet::scale import place, angle, RADIUS;

pub struct Outflow {
    cut: f32,    // metres the floods took off the ground (0 or less)
    floor: f32,  // on a channel's floor, 0 to 1
}
pub fn mix_outflow(a: Outflow, b: Outflow, t: f32) -> Outflow {
    return Outflow { cut: mix(a.cut, b.cut, t), floor: mix(a.floor, b.floor, t) };
}

// The reaches: each one's ends (latitude, longitude) and its floor's half
// width (m) and depth (m), the channels' in order from source to mouth.
const REACHES: i32 = 13;
const REACH_ENDS: array<vec4<f32>, 13> = [
    // Kasei, from Echus Chasma north and then east to Chryse.
    vec4<f32>(0.5, -80.0, 12.0, -77.0), vec4<f32>(12.0, -77.0, 22.0, -70.0), vec4<f32>(22.0, -70.0, 25.5, -58.0),
    vec4<f32>(25.5, -58.0, 27.0, -50.0),
    // Maja, from Juventae north.
    vec4<f32>(-3.0, -61.0, 6.0, -58.5), vec4<f32>(6.0, -58.5, 16.0, -55.0),
    // Simud, from Hydraotes Chaos.
    vec4<f32>(0.8, -35.5, 10.0, -38.5), vec4<f32>(10.0, -38.5, 19.0, -40.0),
    // Tiu, from Hydaspes Chaos.
    vec4<f32>(2.0, -27.0, 9.0, -32.0), vec4<f32>(9.0, -32.0, 17.0, -35.0),
    // Ares, from Iani Chaos.
    vec4<f32>(-2.5, -18.0, 5.0, -22.0), vec4<f32>(5.0, -22.0, 11.0, -26.0), vec4<f32>(11.0, -26.0, 19.0, -32.0),
];
const REACH_SHAPE: array<vec2<f32>, 13> = [
    vec2<f32>(30000.0, 2200.0), vec2<f32>(38000.0, 2000.0), vec2<f32>(40000.0, 1700.0), vec2<f32>(45000.0, 1300.0),
    vec2<f32>(12000.0, 1000.0), vec2<f32>(14000.0, 800.0),
    vec2<f32>(20000.0, 1300.0), vec2<f32>(26000.0, 1000.0),
    vec2<f32>(15000.0, 1100.0), vec2<f32>(20000.0, 900.0),
    vec2<f32>(11000.0, 1100.0), vec2<f32>(14000.0, 1000.0), vec2<f32>(18000.0, 800.0),
];
// The walls' mean slope (some 11 degrees: worn, not cut).
const WALL: f32 = 0.2;

// Reach a to b: the distance (m) from the point to the reach's line, past
// its ends rounded (x), and the point's place along and across it (y, z).
fn reach(up: vec3<f32>, a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    let n = normalize(cross(a, b));
    let across = dot(up, n);
    let onto = normalize(up - n * across);
    let len = angle(a, b);
    let ta = angle(a, onto);
    let tb = angle(b, onto);
    let beyond = max(max(ta - len, tb - len), 0.0) * RADIUS;
    let side = abs(across) * RADIUS;
    return vec3<f32>(sqrt(side * side + beyond * beyond), ta * RADIUS, across * RADIUS);
}

pub fn outflow(up: vec3<f32>, seed: i32) -> Outflow {
    var o = Outflow { cut: 0.0, floor: 0.0 };
    // Far from the channels, nothing.
    if (angle(up, place(12.0, -50.0)) > 0.5) { return o; }
    for (var i: i32 = 0; i < REACHES; i += 1) {
        let e = REACH_ENDS[i];
        let s = REACH_SHAPE[i];
        let r = reach(up, place(e.x, e.y), place(e.z, e.w));
        // The floor's edge wanders by a fifth of its width.
        let edge = s.x * (1.0 + 0.2 * simplex_f32(vec3<f32>(r.y / 60000.0, (i as f32) * 3.1, 0.4), seed + 560));
        let wall = s.y / WALL;
        if (r.x > edge + wall) { continue; }
        let floor = 1.0 - smoothstep(edge, edge + wall, r.x);
        // Streamlined islands: the old ground left standing in teardrops
        // drawn out along the flow, on the floor away from its edges.
        let q = vec3<f32>(r.y / 50000.0, r.z / 16000.0, (i as f32) * 7.7);
        let n = simplex_f32(q, seed + 561) + 0.3 * simplex_f32(q * vec3<f32>(2.1, 2.6, 1.0), seed + 562);
        let island = smoothstep(0.36, 0.42, n) * (1.0 - smoothstep(0.6 * edge, 0.9 * edge, r.x));
        // Grooves along the flow, tens of metres deep, some 2 km apart.
        let groove = 30.0 * sin(6.2831853 * (r.z / 2200.0 + 0.6 * n));
        let cut = -(s.y + groove) * floor * (1.0 - island);
        if (cut < o.cut) {
            o.cut = cut;
            o.floor = floor * (1.0 - island);
        }
    }
    return o;
}
