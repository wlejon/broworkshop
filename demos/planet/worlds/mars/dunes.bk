// Mars's dunes: fields of transverse dunes on the sand of crater floors,
// basins, canyon floors and the polar erg, their crests across the wind,
// each a long gentle stoss rising to a crest and a steep slip face down
// wind.
//
// The dunes are periodic over DUNE_PERIOD metres: each set is a wave of
// integer wave vector n over the point's position about the planet's
// centre, so its phase is exact from the lattice C doubled to the period
// (world_lattice.bk, ground.bk), the same on every tile. A set runs along
// the ground where n lies along it (its weight, tangential); the sets whose
// n lies along the local wind take the field, so the crests turn with it.
//
// No field is a ruled pattern: the phase is warped by noise kilometres
// across (dune_field), so crests wander, bend, fork and end where the warp
// winds a period in, and the spacing breathes; and the sand's cover comes
// in patches, so where it thins the crests break into separate dunes on
// bare ground (the profile clipped at 1 - cover) and where it is deep they
// merge into ridges.
//
// Each set's profile less its mean, at the share a cell's width leaves
// (dune_share): a coarse cell holds the field's mean and none of its crests.
module planet::dunes;
from planet::noise import simplex_grad, simplex_grad_f32, GRAD_TO_VALUE;
from planet::anchor import Anchor, doubled, twice, simplex_from;
from planet::world_lattice import S;
from planet::scale import BASE_WAVELENGTH;

pub const DUNE_PERIOD: f32 = 4096.0;   // lattice C doubled 8 times
pub const DUNE_OCTAVE: i32 = 8;
const DUNE_HEIGHT: f32 = 34.0;         // a full field's crest over its troughs, m
const SETS: i32 = 6;
// The sets' wave vectors: |n| about 10, a wavelength about 400 m.
const DUNE_N: array<vec3<f32>, 6> = [
    vec3<f32>(10.0, 1.0, 0.0), vec3<f32>(0.0, 10.0, 1.0), vec3<f32>(1.0, 0.0, 10.0),
    vec3<f32>(6.0, -7.0, 4.0), vec3<f32>(-4.0, 6.0, 7.0), vec3<f32>(7.0, 4.0, -6.0),
];
const CREST: f32 = 0.78;   // where in a period the crest stands: the stoss before, the slip face after

// The warp's octaves on lattice S (4 km down to 1 km) and how many periods
// each winds the phase; the cover's patches' octave (2 km).
const WARP_FIRST: i32 = 9;
const WARP_LAST: i32 = 11;
const WARP_PERIODS: array<f32, 3> = [0.8, 0.25, 0.08];
const COVER_OCTAVE: i32 = 10;

// A dune's profile over a period, 0 to 1 at its crest, t its phase along
// the wind.
fn profile(t: f32) -> f32 {
    if (t < CREST) {
        let u = t / CREST;
        return u * u * (1.5 - 0.5 * u);
    }
    let u = (t - CREST) / (1.0 - CREST);
    return 1.0 - u * u * (3.0 - 2.0 * u);
}

// The profile standing `cover` over the ground (0 none, 1 the full
// profile): its part above 1 - cover.
fn clipped(t: f32, cover: f32) -> f32 {
    return max(profile(t) - (1.0 - cover), 0.0);
}
// Whether a point of that profile is on a dune (1) or the bare ground
// between (0).
fn on_dune(t: f32, cover: f32) -> f32 {
    return smoothstep(0.0, 0.04, clipped(t, cover));
}
// Their means over a period: the height's (x) and the dunes' share (y).
fn clipped_mean(cover: f32) -> vec2<f32> {
    var m = vec2<f32>(0.0);
    for (var i: i32 = 0; i < 16; i += 1) {
        let t = ((i as f32) + 0.5) / 16.0;
        m += vec2<f32>(clipped(t, cover), on_dune(t, cover));
    }
    return m / 16.0;
}

// The wind over the sand at up (a unit direction): a broad field turning
// over hundreds of kilometres, on the tangent plane.
pub fn wind_at(up: vec3<f32>, seed: i32) -> vec3<f32> {
    let g = simplex_grad_f32(up * 3.0, seed + 600).yzw + vec3<f32>(0.3, 0.0, -0.2) / GRAD_TO_VALUE;
    let t = g - up * dot(g, up);
    return t / max(length(t), 1e-6);
}

// The share of a dune's relief a cell `width` metres wide keeps, for a
// wavelength `wl`.
fn dune_share(width: f32, wl: f32) -> f32 {
    let r = width / wl;
    return exp(-3.3 * r * r);
}

// Where a field's crests wander and how deep its sand lies, at offset e
// from the anchor: x the phase's warp in periods, y the cover's patches
// (about -1 to 1).
pub fn dune_field(a: Anchor, e: vec3<f32>, radius: f32, seed: i32) -> vec2<f32> {
    var lat = doubled(a.l[S], WARP_FIRST);
    var d = e * (radius / BASE_WAVELENGTH) * exp2(WARP_FIRST as f32);
    var warp: f32 = 0.0;
    var cover: f32 = 0.0;
    for (var o: i32 = WARP_FIRST; o <= WARP_LAST; o += 1) {
        let at = simplex_from(lat, d);
        // (The noise's value spreads 0.39 either way: NOISE_VAR.)
        warp += WARP_PERIODS[o - WARP_FIRST] * simplex_grad(at, seed + 640 + o).x * 2.5;
        if (o == COVER_OCTAVE) { cover = simplex_grad(at, seed + 660).x * 2.5; }
        lat = twice(lat);
        d *= 2.0;
    }
    return vec2<f32>(warp, cover);
}

// The dunes' height (m) at x, the point about the planet's centre in
// periods (modulo 1 a period is all that matters), on the ground whose up
// is `up`, `sand` deep (0 none to 1 a full field), its field `field`
// (dune_field), seen through a cell `width` metres wide: x the height, y
// the share of the cell on a dune (the dark moving sand) and not the ground
// between.
pub fn dunes(x: vec3<f32>, up: vec3<f32>, sand: f32, field: vec2<f32>, width: f32, seed: i32) -> vec2<f32> {
    if (sand <= 0.0) { return vec2<f32>(0.0); }
    // Thin sand stands in separate dunes, deep sand in ridges.
    let cover = clamp(sand * (0.8 + 0.7 * field.y), 0.12, 1.0);
    let mean = clipped_mean(cover);
    let wind = wind_at(up, seed);
    var sum: f32 = 0.0;
    var body: f32 = 0.0;
    var weights: f32 = 0.0;
    for (var i: i32 = 0; i < SETS; i += 1) {
        let n = DUNE_N[i];
        let nl = length(n);
        let kt = n - up * dot(n, up);
        let tl = length(kt);
        let along = dot(kt, wind) / max(tl, 1e-6);
        // Along the ground, and along the wind.
        let tangential = smoothstep(0.55, 0.85, tl / nl);
        let w = tangential * pow(0.08 + along * along, 3.0);
        if (w <= 1e-4) { continue; }
        var t = fract(dot(n, x) + field.x);
        if (along < 0.0) { t = 1.0 - t; }
        let wl = DUNE_PERIOD / tl;
        let share = dune_share(width, wl);
        sum += w * (clipped(t, cover) - mean.x) * share;
        body += w * mix(mean.y, on_dune(t, cover), share);
        weights += w;
    }
    if (weights <= 0.0) { return vec2<f32>(0.0); }
    return vec2<f32>(DUNE_HEIGHT * smoothstep(0.0, 0.3, sand) * sum / weights, body / weights);
}
