// Mars's tile production (world.js produce): each tile's cells, horizon
// heights and detail from the ground (ground.bk), in the core's layer
// formats (core/layers.bk); the core's kernels (core/tiles.bk) run after
// them. Grid z is the tile's record in the batch table (tiles::record), its
// anchor in `anchors` (core/anchor.bk), a cell's point the anchor's
// direction and its offset from it, in f32.
from planet::ground import ground_at, terrain, Ground;
from planet::scale import octaves_for, cell_width;
from planet::surface import surface_colour, variation;
from planet::anchor import read_anchor, anchor_at, plane_offset;
from planet::layers import HZ_MARGIN, HZ_DENSITY, gather_span, detail_words;
import tiles;

// The offset of frame point (s, t) from the tile's anchor's direction.
fn frame_dir(rec: tiles::Record, s: f32, t: f32) -> vec3<f32> {
    return rec.dir_lo + tiles::sphere_offset(rec, tiles::frame_offset(rec, s, t));
}

// Cell (x, y): its vertex the ground's truth at its point, every octave down
// to `truth` (a parent's vertices are every other one of its children's, and
// none moves as tiles refine), relative to the tile's centre, and its
// height; gathered into `span` over the cache's minHeight, `bottom`.
@kernel @grid(3)
fn k_tile(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>, out: write_store<vec4<f32>, 3>,
          span: rw_store<i32, 1>, radius: f32, border: f32, inv_size: f32, truth: f32, seed: i32, bottom: f32) {
    let rec = tiles::record(table, g.z());
    let a = read_anchor(anchors, g.z());
    let s = ((g.x() as f32) - border) * inv_size;
    let t = ((g.y() as f32) - border) * inv_size;
    let d = tiles::frame_offset(rec, s, t);
    let e = rec.dir_lo + tiles::sphere_offset(rec, d);
    // (Its broad landforms read as the tile's cells are spaced: ground.bk
    // BROAD_FINE.)
    let h = terrain(a, e, radius, truth, cell_width(octaves_for(rec.extent, inv_size)), seed);
    out[g.x(), g.y(), rec.slot] = vec4<f32>(tiles::sphere_vertex(rec, d, radius, h), h);
    gather_span(span, g.z(), max(h - bottom, 0.0));
}

// The heights the core's horizons march through (core/layers.bk heights):
// the ground at the tile's octaves plus two.
@kernel @grid(3)
fn k_horizon_heights(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                     heights: write_store<f32, 1>, radius: f32, inv_size: f32, seed: i32) {
    let rec = tiles::record(table, g.z());
    let a = read_anchor(anchors, g.z());
    let n = g.width();
    let m = HZ_MARGIN as f32;
    let dens = HZ_DENSITY as f32;
    let cx = (g.x() as f32) / dens - m;
    let cy = (g.y() as f32) / dens - m;
    let octaves = octaves_for(rec.extent, inv_size) + 2.0;
    let e = frame_dir(rec, cx * inv_size, cy * inv_size);
    heights[(g.z() * n + g.y()) * n + g.x()] = terrain(a, e, radius, octaves, cell_width(octaves), seed);
}

// ── The detail layer ────────────────────────────────────────────────────────
//
// `d` texels along each cell's edge, texel (tx, ty) centred at cell
// ((tx, ty) + 0.5) / d - 0.5: each the mean of the ground over it.

fn texel_st(tx: i32, ty: i32, border: f32, inv_size: f32, d: f32) -> vec2<f32> {
    return vec2<f32>(((tx as f32) + 0.5) / d - 0.5 - border, ((ty as f32) + 0.5) / d - 0.5 - border) * inv_size;
}

// What colours a texel, FIELDS vec4s of `fields` a texel from k_detail_height
// to k_detail: the Ground's shares and the tone's patches.
pub const FIELDS: i32 = 4;
fn put_fields(fields: write_store<vec4<f32>, 1>, at: i32, gr: Ground, vary: f32) {
    fields[FIELDS * at] = vec4<f32>(gr.dust, gr.sand, gr.layered, gr.fresh);
    fields[FIELDS * at + 1] = vec4<f32>(gr.ice, gr.polar, gr.wall, vary);
    fields[FIELDS * at + 2] = vec4<f32>(gr.floor, gr.volcanic, gr.old, gr.strat);
    fields[FIELDS * at + 3] = vec4<f32>(gr.ild, gr.talus, gr.frost, 0.0);
}
// The Ground at height h from a texel's fields (x), and its tone's patches (y).
struct Fields {
    gr: Ground,
    vary: f32,
}
fn get_fields(fields: read_store<vec4<f32>, 1>, at: i32, h: f32) -> Fields {
    let fa = fields[FIELDS * at];
    let fb = fields[FIELDS * at + 1];
    let fc = fields[FIELDS * at + 2];
    let fd = fields[FIELDS * at + 3];
    var gr: Ground;
    gr.h = h;
    gr.dust = fa.x;
    gr.sand = fa.y;
    gr.layered = fa.z;
    gr.fresh = fa.w;
    gr.ice = fb.x;
    gr.polar = fb.y;
    gr.wall = fb.z;
    gr.floor = fc.x;
    gr.volcanic = fc.y;
    gr.old = fc.z;
    gr.strat = fc.w;
    gr.ild = fd.x;
    gr.talus = fd.y;
    gr.frost = fd.z;
    return Fields { gr: gr, vary: fb.w };
}

// Each texel's point of the mean surface relative to the tile's centre and
// its mean height (xyz, w) into `texels`, and what colours it into
// `fields` (put_fields), for k_detail.
@kernel @grid(3)
fn k_detail_height(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                   texels: write_store<vec4<f32>, 1>, fields: write_store<vec4<f32>, 1>, radius: f32, border: f32,
                   inv_size: f32, d: f32, seed: i32) {
    let rec = tiles::record(table, g.z());
    let a = read_anchor(anchors, g.z());
    let w = g.width();
    let st = texel_st(g.x(), g.y(), border, inv_size, d);
    let octaves = octaves_for(rec.extent, inv_size / d);
    let e = frame_dir(rec, st.x, st.y);
    let gr = ground_at(a, e, radius, octaves, cell_width(octaves), seed);
    let p = tiles::sphere_vertex(rec, tiles::frame_offset(rec, st.x, st.y), radius, gr.h);
    let at = (g.z() * w + g.y()) * w + g.x();
    texels[at] = vec4<f32>(p, gr.h);
    put_fields(fields, at, gr, variation(a, e, radius, octaves, seed));
}

fn texel_at(texels: read_store<vec4<f32>, 1>, z: i32, w: i32, tx: i32, ty: i32) -> vec4<f32> {
    return texels[(z * w + clamp(ty, 0, w - 1)) * w + clamp(tx, 0, w - 1)];
}

// A tile's detail layer: each texel's colour from its fields and slope, and
// the normal of the mean surface from its neighbours (core/layers.bk
// detail_words: a the sand's share, the byte the ice's).
@kernel @grid(3)
fn k_detail(g: grid<3>, table: read_store<vec4<i32>, 1>, texels: read_store<vec4<f32>, 1>, fields: read_store<vec4<f32>, 1>,
            out: write_store<i32, 1>, radius: f32) {
    let rec = tiles::record(table, g.z());
    let z = g.z();
    let w = g.width();
    let tx = g.x();
    let ty = g.y();
    let du = texel_at(texels, z, w, tx + 1, ty).xyz - texel_at(texels, z, w, tx - 1, ty).xyz;
    let dv = texel_at(texels, z, w, tx, ty + 1).xyz - texel_at(texels, z, w, tx, ty - 1).xyz;
    let here = texels[(z * w + ty) * w + tx];
    // The texel's own up (tiles::sphere_vertex backwards: its point less
    // the tile's is dd (radius + h) + dir h, dd the direction's offset), so
    // a coarse tile's slopes are the ground's and not its curve's.
    let dd = (here.xyz - rec.point - rec.dir_hi * here.w) / (radius + here.w);
    let up = normalize(rec.dir_hi + dd);
    var n = normalize(cross(du, dv));
    if (dot(n, up) < 0.0) { n = -n; }
    let c = dot(n, up);
    let slope = sqrt(max(1.0 - c * c, 0.0)) / max(c, 1e-3);
    let at = (z * w + ty) * w + tx;
    let fl = get_fields(fields, at, here.w);
    let gr = fl.gr;
    let col = surface_colour(gr, slope, fl.vary, slope * length(du) * 0.5);
    let words = detail_words(vec4<f32>(col, gr.sand), n, gr.ice);
    let o = ((rec.slot * w + ty) * w + tx) * 2;
    out[o] = words.x;
    out[o + 1] = words.y;
}

// ── On the CPU ──────────────────────────────────────────────────────────────

// The ground's height under a point, for the camera (run over a grid of one).
@kernel @cpu @grid(1)
fn k_height(g: grid<1>, x: f64, y: f64, z: f64, radius: f64, octaves: f64, seed: i32) -> f64 {
    let dir = normalize(vec3<f64>(x, y, z));
    let a = anchor_at(dir, radius);
    let e = plane_offset(a, a.lost);
    return terrain(a, e, radius as f32, octaves as f32, 1.0e9, seed) as f64;
}
