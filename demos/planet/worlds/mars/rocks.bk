// Mars's rocks: the blocks and cobbles strewn over the ground, from boulders
// a metre and a half across down to stones of a few centimetres, thick on
// fresh ejecta and the talus under canyon walls, scattered over the old
// plains, sparse under thick dust and none on deep sand or ice.
//
// Each size is an octave of lattice C (ROCK_FIRST to ROCK_LAST, cells 4 m
// down to 25 cm): a cell may hold one rock, its centre a hash of the cell
// kept to the cell's middle, and the rock stands where the surface passes
// near that centre (within the cell's middle fifth along the up), so its
// footprint, a fifth of the cell across at most, never leaves the cell and
// a point reads only its own cell an octave. A rock is a block: an outline
// of a few lobes about its centre, steep sides, a tilted, rounded top, set
// partly into the ground.
//
// A cell too coarse to draw a rock holds the octave's mean (its expected
// volume over the cell's area), and the share in between (rock_share)
// mixes the two, so a coarse cell is the aggregate of the rocks it holds.
module planet::rocks;
from planet::anchor import Anchor, doubled, twice, perlin_from;
from planet::world_lattice import C;
from planet::craters import C0;

const ROCK_FIRST: i32 = 18;   // cells 4 m: boulders to 1.6 m across
const ROCK_LAST: i32 = 22;    // cells 25 cm: stones of 10 cm
const FOOT: f32 = 0.2;        // a rock's largest radius, a share of its cell
// A rock's volume over its mean radius cubed: the block's profile (block)
// above its burial, at its mean height, over its outline.
const VOLUME: f32 = 0.9;

fn mix32(x_in: u32) -> u32 {
    var x = x_in;
    x = (x ^ (x >> 16u)) * 0x7feb352du;
    x = (x ^ (x >> 15u)) * 0x846ca68bu;
    return x ^ (x >> 16u);
}
// Four uniform numbers in [0, 1) for cell c of octave k.
fn hash4(c: vec3<i32>, k: i32, seed: i32) -> vec4<f32> {
    var h = mix32(bitcast<u32>(c.x) * 0x9e3779b1u ^ bitcast<u32>(c.y) * 0x85ebca6bu ^ bitcast<u32>(c.z) * 0xc2b2ae35u
                  ^ bitcast<u32>(k * 7919 + seed) * 0x27d4eb2fu);
    let a = h;
    h = mix32(h + 0x6a09e667u);
    let b = h;
    h = mix32(h + 0x6a09e667u);
    let c2 = h;
    h = mix32(h + 0x6a09e667u);
    return vec4<f32>((a >> 8u) as f32, (b >> 8u) as f32, (c2 >> 8u) as f32, (h >> 8u) as f32) * (1.0 / 16777216.0);
}

// The share of a rock's relief a cell `width` metres wide keeps, for a rock
// `size` metres across.
fn rock_share(width: f32, size: f32) -> f32 {
    let r = width / size;
    return exp(-2.5 * r * r);
}

// A block's height over its footprint, x = r / R (R the outline's radius
// in that direction): steep sides, a rounded top.
fn block(x: f32) -> f32 {
    let u = clamp(1.0 - x * x * x * x, 0.0, 1.0);
    return sqrt(u);
}

pub struct Rocks {
    h: f32,       // metres over the ground
    cover: f32,   // the share of the cell under rock
}

// How strewn with rocks the ground is, 0 bare to 1 a field of blocks, from
// what it holds (ground.bk): fresh ejecta, talus, old ground, dust, sand.
pub fn rockiness(fresh: f32, talus: f32, old: f32, dust: f32, sand: f32, ice: f32) -> f32 {
    let r = 0.2 + 0.8 * fresh + 0.7 * talus + 0.25 * old * (1.0 - dust) - 0.25 * dust;
    return clamp(r, 0.0, 1.0) * (1.0 - smoothstep(0.25, 0.6, sand)) * (1.0 - ice);
}

// The rocks at offset e from the anchor on the ground whose up is `up`, as
// strewn as `rocky` (rockiness), over a cell `width` metres wide.
pub fn rocks(a: Anchor, e: vec3<f32>, up: vec3<f32>, radius: f32, rocky: f32, width: f32, seed: i32) -> Rocks {
    var out = Rocks { h: 0.0, cover: 0.0 };
    if (rocky <= 0.0) { return out; }
    // A frame on the ground, for the outlines' lobes.
    let ax = select(abs(up.y) < 0.9, vec3<f32>(0.0, 1.0, 0.0), vec3<f32>(1.0, 0.0, 0.0));
    let t1 = normalize(cross(up, ax));
    let t2 = cross(up, t1);
    var lat = doubled(a.l[C], ROCK_FIRST);
    var d = e * (radius / C0) * exp2(ROCK_FIRST as f32);
    var cell = C0 / exp2(ROCK_FIRST as f32);
    for (var k: i32 = ROCK_FIRST; k <= ROCK_LAST; k += 1) {
        // Smaller rocks are more common: a cell holds one at a chance
        // rising from a fifth of `rocky` at 4 m to the whole of it.
        let chance = rocky * mix(0.2, 0.9, ((k - ROCK_FIRST) as f32) / ((ROCK_LAST - ROCK_FIRST) as f32));
        let size = 2.0 * FOOT * cell;
        let share = rock_share(width, size);
        // The octave's mean: rocks stand in some 15% of the cells (where the
        // surface passes within a tenth of a cell of their centre along the
        // up), each VOLUME R^3 and covering pi R^2 (R its mean radius,
        // 0.75 FOOT cells).
        let rm = 0.75 * FOOT * cell;
        let mean_h = 0.15 * chance * VOLUME * rm * rm * rm / (cell * cell);
        let mean_cover = 0.15 * chance * 3.14159265 * rm * rm / (cell * cell);
        var here_h = mean_h;
        var here_cover = mean_cover;
        if (share > 0.02) {
            let at = perlin_from(lat, d);
            let hs = hash4(at.cell, k, seed + 1500);
            var hrock: f32 = 0.0;
            var on: f32 = 0.0;
            if (hs.x < chance) {
                let hs2 = hash4(at.cell, k, seed + 1501);
                let c = vec3<f32>(0.35, 0.35, 0.35) + 0.3 * hs2.xyz;
                let off = at.f - c;
                let along = dot(off, up);
                if (abs(along) < 0.1) {
                    let tang = off - up * along;
                    let x = dot(tang, t1);
                    let y = dot(tang, t2);
                    let r = sqrt(x * x + y * y);
                    let th = atan2(y, x);
                    // The outline: a few lobes of a hashed phase; the
                    // radius from 0.5 to 1 of FOOT.
                    let rad = FOOT * (0.5 + 0.5 * hs2.w) * (1.0 + 0.12 * sin(3.0 * th + 6.28 * hs.y) + 0.06 * sin(5.0 * th + 6.28 * hs.z));
                    let xr = r / rad;
                    if (xr < 1.0) {
                        // Height 0.4 to 0.9 of the radius, the top tilted,
                        // a quarter to a half of it set into the ground.
                        let tall = (0.4 + 0.5 * hs.w) * rad * cell;
                        let tilt = 0.25 * (x * cos(6.28 * hs.y) + y * sin(6.28 * hs.y)) / rad;
                        let buried = 0.25 + 0.25 * hs.z;
                        let b = block(xr) * (1.0 + tilt);
                        hrock = max(b - buried, 0.0) / (1.0 - buried) * tall;
                        on = smoothstep(0.0, 0.02 * cell, hrock);
                    }
                }
            }
            here_h = mix(mean_h, hrock, share);
            here_cover = mix(mean_cover, on, share);
        }
        out.h += here_h;
        out.cover = max(out.cover, here_cover);
        lat = twice(lat);
        d *= 2.0;
        cell *= 0.5;
    }
    return out;
}
