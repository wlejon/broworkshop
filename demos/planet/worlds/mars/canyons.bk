// Mars's canyons: Valles Marineris, its chasmata cut up to 7 km into the
// Tharsis plateau east of the volcanoes, their walls the plateau's layered
// rock (strata.bk), its resistant beds ledges over the soft beds' slopes,
// ribbed with spurs and gullies; its interior layered deposits standing as
// mesas of finer, lighter beds on the floors of Candor and Melas; Noctis
// Labyrinthus, the maze of troughs at its head; and the chaos at its mouth
// and on to Chryse, plateaus broken into mesas and knobs.
//
// In two parts: the field (canyon_field), broad shapes of the direction
// alone, which ground.bk reads at its broad lattice's corners as it does
// the other landforms; and the cut it makes in the detailed ground
// (canyons).
module planet::canyons;
from planet::noise import simplex_f32;
from planet::scale import place, angle, RADIUS;
from planet::strata import terrace;

pub struct Canyon {
    h: f32,        // the ground, cut
    layered: f32,  // the share on a canyon's or mesa's layered walls
    floor: f32,    // on a canyon's or chaos's floor
    ild: f32,      // the share of the layered rock that is the interior deposits'
    talus: f32,    // on a wall's foot, under the rock fallen from above
}

// The beds the walls cut (strata.bk sequences): the plateau's, thick and
// mostly resistant lava and sediment, and the interior deposits', finer
// and softer.
pub const WALL_BED: f32 = 190.0;
pub const WALL_SEED: i32 = 71;
pub const ILD_BED: f32 = 55.0;
pub const ILD_SEED: i32 = 73;

// The canyons' broad shapes at a direction.
pub struct CanyonField {
    z: f32,        // the chasmata's walls' height (m over the datum), the lowest at the point
    run: f32,      // how far up its wall that is from its floor (m)
    z_rel: f32,    // Noctis's troughs' walls, m over the ground they cut
    run_rel: f32,  // and how far up from their floors
    ild: f32,      // the interior layered deposits' rise, 0 to 1
    chaos: f32,    // in a field of chaos, 0 to 1
    mesa: f32,     // on one of its mesas, 0 to 1
}
pub fn no_canyon() -> CanyonField {
    return CanyonField { z: 1.0e9, run: 1.0e9, z_rel: 1.0e9, run_rel: 1.0e9, ild: 0.0, chaos: 0.0, mesa: 0.0 };
}
pub fn mix_canyon(a: CanyonField, b: CanyonField, t: f32) -> CanyonField {
    return CanyonField { z: mix(a.z, b.z, t), run: mix(a.run, b.run, t), z_rel: mix(a.z_rel, b.z_rel, t),
                         run_rel: mix(a.run_rel, b.run_rel, t), ild: mix(a.ild, b.ild, t),
                         chaos: mix(a.chaos, b.chaos, t), mesa: mix(a.mesa, b.mesa, t) };
}

// The smaller of a and b, eased over k metres.
fn smin(a: f32, b: f32, k: f32) -> f32 {
    // Apart by k or more, the lower as it is: mixed, a far one (no_canyon's
    // 1e9) would round the other to its own f32 step, 64 m.
    if (b - a >= k) { return a; }
    if (a - b >= k) { return b; }
    let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

// A chasma along the great-circle arc a to b, half `w` metres wide at its
// floor's edge in its middle and narrowing to a third of that toward its
// ends, which round off. The distance (m) from the point to its floor's
// edge, past which the wall rises (x), and the point's place along the
// chasma and across it, metres (y, z): a frame its walls' gullies run in.
fn chasma(up: vec3<f32>, a: vec3<f32>, b: vec3<f32>, w: f32) -> vec3<f32> {
    let n = normalize(cross(a, b));
    let across = dot(up, n);
    let onto = normalize(up - n * across);
    let len = angle(a, b);
    let ta = angle(a, onto);
    let tb = angle(b, onto);
    // Along the arc, 0 at a to 1 at b; past an end, its distance from it.
    let u = clamp(ta / len, 0.0, 1.0);
    let past = max(ta - len, tb - len);
    let taper = 0.35 + 0.65 * smoothstep(0.0, 0.3, u) * smoothstep(1.0, 0.7, u);
    let side = abs(across) * RADIUS;
    let beyond = max(past, 0.0) * RADIUS;
    return vec3<f32>(sqrt(side * side + beyond * beyond) - w * taper, ta * RADIUS, across * RADIUS);
}

// The walls rise some 31 degrees on the mean from their floor's edge, as
// cliffs over the resistant beds and gentler over the soft.
const WALL_SLOPE: f32 = 0.6;
const APRON: f32 = 1200.0;

// The chasmata: Ius, Tithonium, Melas, Candor, Ophir, Coprates, Eos and
// Ganges: each arc's ends (latitude, longitude), its floor's half width
// (m), its floor's height over the datum (m), and how far its walls wander
// with the spurs (a share).
const CHASMATA: i32 = 8;
const CHASMA_ENDS: array<vec4<f32>, 8> = [
    vec4<f32>(-7.0, -96.0, -8.5, -80.0), vec4<f32>(-4.6, -92.0, -5.0, -81.5), vec4<f32>(-10.0, -79.0, -10.5, -70.0),
    vec4<f32>(-6.5, -78.0, -6.5, -69.0), vec4<f32>(-4.0, -74.0, -4.0, -68.0), vec4<f32>(-12.5, -69.0, -13.8, -56.0),
    vec4<f32>(-13.6, -56.5, -11.5, -43.0), vec4<f32>(-8.2, -52.0, -7.0, -46.0),
];
const CHASMA_SHAPE: array<vec3<f32>, 8> = [
    vec3<f32>(22000.0, -3600.0, 1.0), vec3<f32>(7000.0, -1800.0, 0.6), vec3<f32>(50000.0, -3800.0, 1.0),
    vec3<f32>(40000.0, -3000.0, 1.0), vec3<f32>(25000.0, -2500.0, 1.0), vec3<f32>(28000.0, -4800.0, 1.0),
    vec3<f32>(45000.0, -4500.0, 1.0), vec3<f32>(28000.0, -3500.0, 1.0),
];

// The gullies down a wall: grooves carved into it where a noise stretched
// across the chasma (so they run down the wall) crosses zero, a few
// kilometres apart along it, between the spurs they leave standing; how
// far back (m) they cut the wall at a point `along` and `across` it.
// `up_wall` is how far up the wall the point is (m across from its foot):
// a gully is an alcove at the top, narrowing down the wall.
fn gullies(along: f32, across: f32, up_wall: f32, seed: i32) -> f32 {
    let q = vec3<f32>(along / 3600.0, across / 22000.0, 0.5);
    let n = simplex_f32(q, seed + 505) + 0.45 * simplex_f32(q * vec3<f32>(2.3, 1.7, 1.0), seed + 506);
    let width = mix(0.07, 0.3, smoothstep(1000.0, 9000.0, up_wall));
    return 1500.0 * (1.0 - smoothstep(0.0, width, abs(n)));
}

pub fn canyon_field(up: vec3<f32>, seed: i32) -> CanyonField {
    var c = no_canyon();
    // Far from the canyons, nothing.
    if (angle(up, place(-8.0, -72.0)) > 0.62) { return c; }
    let p = up * (RADIUS / 14000.0);
    // Spurs: the walls' edge wanders by kilometres along them.
    let spur = 5500.0 * simplex_f32(p, seed + 500) + 2500.0 * simplex_f32(p * 2.7, seed + 501)
             + 900.0 * simplex_f32(p * 7.3, seed + 502);
    // The chasma whose wall stands lowest at the point is the one there.
    var near = vec3<f32>(1.0e9);
    var near_floor: f32 = 0.0;
    for (var i: i32 = 0; i < CHASMATA; i += 1) {
        let e = CHASMA_ENDS[i];
        let s = CHASMA_SHAPE[i];
        let ch = chasma(up, place(e.x, e.y), place(e.z, e.w), s.x);
        let d = ch.x + s.z * spur;
        let w = s.y + WALL_SLOPE * max(d, 0.0);
        if (w < c.z) {
            c.z = w;
            near = vec3<f32>(d, ch.y + 1.0e6 * (i as f32), ch.z);
            near_floor = s.y;
        }
    }
    // Its wall, cut back by its gullies (on the wall alone: they fan out
    // onto the floor as its talus).
    // Its foot is a talus apron, concave, easing onto the floor over a
    // kilometre or so.
    if (near.x > 0.0) {
        let d = max(near.x - gullies(near.y, near.z, near.x, seed) * smoothstep(0.0, 2500.0, near.x), 0.0);
        c.z = near_floor + WALL_SLOPE * (d - APRON * (1.0 - exp(-d / APRON)));
    }
    c.run = c.z - near_floor;
    // Noctis Labyrinthus: troughs 4.5 km deep where two noises cross zero,
    // in a field 600 km across at the canyons' head.
    let noctis = 1.0 - smoothstep(0.06, 0.11, angle(up, place(-7.0, -101.0)));
    if (noctis > 0.0) {
        let q = up * (RADIUS / 160000.0);
        let n1 = abs(simplex_f32(q, seed + 510));
        let n2 = abs(simplex_f32(q * 1.7 + vec3<f32>(3.1), seed + 511));
        let trough = min(n1, n2 * 1.3);
        let run = WALL_SLOPE * max((trough - 0.025) * 160000.0 * 2.2 + 0.25 * spur, 0.0);
        c.z_rel = run - 4500.0 * noctis;
        c.run_rel = run;
    }
    // The interior layered deposits: mesas of layered rock up to 4 km
    // over Candor's and Melas's floors, their flanks steep and lobed where
    // the wind has cut them back.
    let lobes = 0.3 * simplex_f32(p * 0.8, seed + 520) + 0.1 * simplex_f32(p * 2.9, seed + 522);
    let ild_a = angle(up, place(-6.6, -73.5)) / 0.032 + lobes;
    let ild_b = angle(up, place(-10.0, -75.0)) / 0.022 + 0.8 * simplex_f32(p * 0.8, seed + 521) * 0.3;
    c.ild = max(1.0 - smoothstep(0.6, 0.88, ild_a), 0.8 * (1.0 - smoothstep(0.6, 0.88, ild_b)));
    // The chaos, at Aram, Hydraotes and Eos.
    c.chaos = max(max(1.0 - smoothstep(0.6, 1.0, angle(up, place(2.6, -21.0)) / 0.045),
                      1.0 - smoothstep(0.6, 1.0, angle(up, place(0.8, -35.0)) / 0.06)),
                  1.0 - smoothstep(0.6, 1.0, angle(up, place(-11.0, -44.0)) / 0.06));
    if (c.chaos > 0.0) {
        let q = up * (RADIUS / 22000.0);
        let m = simplex_f32(q, seed + 530) + 0.5 * simplex_f32(q * 2.3, seed + 531);
        c.mesa = smoothstep(0.18, 0.26, m + 0.35 * (1.0 - c.chaos));
    }
    return c;
}

// The canyons of field f cut into the ground `h_base + detail` (the broad
// landforms, and the relief and craters on them): the floors keep half the
// detail. `strat` is the beds' warp at the point (ground.bk): a bed lies at
// height z - strat.
pub fn canyons(f: CanyonField, h_base: f32, detail: f32, strat: f32) -> Canyon {
    let h_in = h_base + detail;
    var c: Canyon;
    c.h = h_in;
    c.layered = 0.0;
    c.floor = 0.0;
    c.ild = 0.0;
    c.talus = 0.0;
    var z = f.z;
    var run = f.run;
    if (h_in + f.z_rel < z) {
        z = h_in + f.z_rel;
        run = f.run_rel;
    }
    // The walls through the plateau's beds: ledges and cliffs of the
    // resistant beds over the soft beds' slopes.
    let cut = terrace(z + strat, WALL_BED, 5.0, 0.9, WALL_SEED) - strat + 0.5 * detail;
    var h = smin(h_in, cut, 250.0);
    // How far the cut takes the ground down; its floor, and its layered
    // walls from the floor's edge to the plateau.
    let below = clamp((h_in - h) / 300.0, 0.0, 1.0);
    c.floor = below * (1.0 - smoothstep(20.0, 120.0, run));
    c.layered = below * smoothstep(20.0, 120.0, run);
    c.talus = c.layered * (1.0 - smoothstep(200.0, 1400.0, run));
    if (f.ild > 0.0) {
        let mound = terrace(-3000.0 + 4200.0 * f.ild + strat, ILD_BED, 3.0, 0.75, ILD_SEED) - strat + 0.5 * detail;
        // (Rising from the floor over the deposit's first tenth, so its edge
        // is a slope and not a step the height of its lowest bench.)
        let raised = h + smoothstep(0.0, 0.12, f.ild) * max(min(mound, h_in) - h, 0.0);
        c.ild = smoothstep(h + 30.0, h + 200.0, raised);
        c.layered = max(c.layered, c.ild);
        c.floor *= 1.0 - c.ild;
        h = raised;
    }
    // The chaos: plateaus broken into mesas and knobs, the ground between
    // them sunk to the floor.
    if (f.chaos > 0.0) {
        let sunk = h_in - 2500.0 * f.chaos;
        let broken = terrace(mix(sunk, h, f.mesa) + strat, WALL_BED, 4.0, 0.8, WALL_SEED) - strat;
        c.layered = max(c.layered, f.chaos * (1.0 - f.mesa) * smoothstep(0.0, 0.2, f.mesa + 0.1));
        c.floor = max(c.floor, f.chaos * (1.0 - f.mesa));
        h -= smoothstep(0.0, 0.12, f.chaos) * max(h - broken, 0.0);
    }
    c.h = h;
    return c;
}
