// Mars's surface colours (linear albedo), from what the ground holds at a
// point (ground.bk Ground) and its slope: the rust of the oxidised
// regolith, the pale butterscotch of settled dust, the dark basaltic sand
// of the dunes and the dark regions, the grey of rock the wind scours and
// the canyons' walls expose, the light-toned layered deposits banded by
// their beds, fresh ejecta darker than the dust about it, the season's
// frost and the polar ice. Each varies over the plains in patches (variation) as the dust lies
// thicker or thinner.
module planet::surface;
from planet::noise import simplex_grad;
from planet::anchor import Anchor, doubled, twice, simplex_from;
from planet::world_lattice import S;
from planet::scale import BASE_WAVELENGTH, mean_factor;
from planet::ground import Ground;
from planet::strata import bed_tone;
from planet::canyons import WALL_BED, WALL_SEED, ILD_BED, ILD_SEED;

const DUST = vec3<f32>(0.34, 0.18, 0.085);
const RUST = vec3<f32>(0.23, 0.115, 0.055);
const DARK = vec3<f32>(0.095, 0.072, 0.058);    // basaltic sand, the dark regions
const ROCK = vec3<f32>(0.17, 0.135, 0.11);      // scoured and broken rock
const LAYERED = vec3<f32>(0.40, 0.29, 0.18);    // light-toned layered deposits
const LAYERED_DARK = vec3<f32>(0.25, 0.17, 0.105);
const WALL_DARK = vec3<f32>(0.10, 0.08, 0.065);  // the plateau's dark lava and sediment beds
const WALL_LIGHT = vec3<f32>(0.30, 0.215, 0.145);
const TALUS = vec3<f32>(0.20, 0.135, 0.085);     // rock fallen from the walls, dusted
const EJECTA = vec3<f32>(0.13, 0.095, 0.072);
const ICE = vec3<f32>(0.84, 0.82, 0.80);
const FROST = vec3<f32>(0.66, 0.61, 0.57);       // carbon dioxide frost, dusted
const POLAR = vec3<f32>(0.42, 0.31, 0.22);      // the polar layered deposits' dusty ice

// Patches of the ground's tone, -1 to 1 or so: octaves from 16 km down to
// 500 m of noise on lattice S, each its mean over the cell.
const VARY_FIRST: i32 = 7;
const VARY_LAST: i32 = 12;
pub fn variation(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> f32 {
    var lat = doubled(a.l[S], VARY_FIRST);
    var d = e * (radius / BASE_WAVELENGTH) * exp2(VARY_FIRST as f32);
    var sum: f32 = 0.0;
    var amp: f32 = 1.6;
    for (var o: i32 = VARY_FIRST; o < VARY_LAST; o += 1) {
        sum += simplex_grad(simplex_from(lat, d), seed + 700 + o).x * amp * mean_factor(o, octaves);
        amp *= 0.7;
        lat = twice(lat);
        d *= 2.0;
    }
    return sum;
}

// The colour of the ground g with slope `slope` (rise over run), its tone's
// patches `vary`, over a texel whose ground spans `span` metres of height
// (its beds' bands average out across it).
pub fn surface_colour(g: Ground, slope: f32, vary: f32, span: f32) -> vec3<f32> {
    let dust = clamp(g.dust + 0.15 * vary, 0.0, 1.0);
    var c = mix(RUST, DUST, smoothstep(0.15, 0.85, dust));
    // The dark regions: dust swept off the basaltic ground.
    c = mix(c, DARK * 1.25, smoothstep(0.3, 0.0, dust) * 0.7);
    // Steep ground sheds its dust: rock, or the beds of layered rock.
    let steep = smoothstep(0.25, 0.7, slope);
    // The beds (strata.bk) at the rock's stratigraphic height: the
    // plateau's in the canyons' walls, dark lava and sediment with light
    // beds among them, and the interior deposits' light-toned ones, each
    // bed's tone fading as a texel spans it. Their finer beds band each
    // within it.
    let z = g.h + g.strat;
    let wall_bed = bed_tone(z, WALL_BED, span, WALL_SEED);
    let wall_fine = bed_tone(z, 0.2 * WALL_BED, span, WALL_SEED + 1);
    let ild_bed = bed_tone(z, ILD_BED, span, ILD_SEED);
    let ild_fine = bed_tone(z, 0.25 * ILD_BED, span, ILD_SEED + 1);
    let wall_rock = mix(WALL_DARK, WALL_LIGHT, clamp(0.45 + 0.4 * wall_bed.x + 0.08 * wall_fine.x, 0.0, 1.0));
    let ild_rock = mix(LAYERED_DARK, LAYERED, clamp(0.55 + 0.35 * ild_bed.x + 0.15 * ild_fine.x, 0.0, 1.0));
    let layered_rock = mix(wall_rock, ild_rock, g.ild);
    // Where the layered rock crops out: on cliffs (the resistant beds'
    // faces) bare; on the soft beds' slopes under talus, the beds above
    // fallen and mixed; on benches and flats under dust over a caprock.
    let cliff = smoothstep(0.6, 1.3, slope);
    let talus = mix(TALUS, layered_rock, 0.35);
    let face = mix(talus, layered_rock, max(cliff, 0.6 * max(wall_bed.y, ild_bed.y) * steep));
    // A wall's foot under its talus apron, the fallen rock dusted and lighter
    // than the beds it came from, streaked down its gullies' fans.
    let apron = mix(face, mix(TALUS, DUST, 0.35 + 0.15 * vary), g.talus * (1.0 - 0.6 * cliff));
    let walls = mix(ROCK, apron, g.layered);
    c = mix(c, walls, max(steep * (1.0 - 0.5 * g.dust), g.layered * mix(0.3, 1.0, steep)));
    c = mix(c, ROCK, g.wall * 0.35 * (1.0 - dust));
    // The floors of the canyons and the great craters: darker, where sand
    // and rock fallen from the walls lie under less dust.
    c = mix(c, mix(DARK, RUST, 0.35), 0.7 * g.floor * (1.0 - steep));
    // Fresh ejecta: dark, the dust not yet settled on it.
    c = mix(c, EJECTA, g.fresh * 0.3 * (1.0 - steep));
    // The poles' layered deposits.
    c = mix(c, POLAR, g.polar * 0.6 * (1.0 - steep));
    // The sand over them all: dark where it moves (the dunes), dustier where
    // it lies still.
    c = mix(c, mix(DARK, RUST, 0.25 * dust), smoothstep(0.3, 0.8, g.sand) * 0.9);
    // The season's frost, thinner and dustier in patches.
    c = mix(c, FROST, g.frost * clamp(0.85 + 0.25 * vary, 0.0, 1.0));
    // The caps' ice, its beds faint through it.
    let polar_bed = bed_tone(z, 40.0, span, 75);
    c = mix(c, mix(POLAR, ICE, 0.88 + 0.12 * polar_bed.x), g.ice);
    return c;
}
