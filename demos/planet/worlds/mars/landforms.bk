// Mars's broad landforms, each a function of the unit direction: the
// hemispheric dichotomy (the low, smooth northern plains against the high,
// cratered southern uplands), the Tharsis and Elysium rises, the great
// impact basins (Hellas, Argyre, Isidis, and Utopia and Chryse under the
// plains), the polar layered deposits with their ice caps and spiral
// troughs, and the regions' age and dust. They span hundreds to thousands
// of kilometres, so an f32 direction (a fifth of a metre) reads them
// exactly enough, and every cell holds them as they are.
module planet::landforms;
from planet::noise import simplex_f32, simplex_grad_f32;
from planet::scale import place, angle;

// What the landforms make at a point.
pub struct Region {
    h: f32,          // metres over the datum
    old: f32,        // the surface's age, 0 young lava to 1 the ancient uplands (craters.bk density)
    dust: f32,       // how dusty its surface is, 0 dark to 1 bright
    ice: f32,        // the share under the polar caps' ice
    polar: f32,      // under the polar layered deposits
    volcanic: f32,   // on the volcanic rises
    low: f32,        // in the northern plains
    basin: f32,      // on a great basin's floor
}

pub fn mix_region(a: Region, b: Region, t: f32) -> Region {
    return Region { h: mix(a.h, b.h, t), old: mix(a.old, b.old, t), dust: mix(a.dust, b.dust, t), ice: mix(a.ice, b.ice, t),
                    polar: mix(a.polar, b.polar, t), volcanic: mix(a.volcanic, b.volcanic, t), low: mix(a.low, b.low, t),
                    basin: mix(a.basin, b.basin, t) };
}

// A smooth bell: 1 at t = 0, 0 from t = 1, flat at both.
pub fn bell(t: f32) -> f32 {
    let u = clamp(1.0 - t * t, 0.0, 1.0);
    return u * u;
}

// A great basin about c, `r` radians to its rim: a broad floor `depth`
// under the surround, its wall rising to a rim `rim` high, its ejecta
// falling off beyond. x: its floor's share (sand gathers there).
fn basin(up: vec3<f32>, c: vec3<f32>, r: f32, depth: f32, rim: f32) -> vec2<f32> {
    let x = angle(up, c) / r;
    let wall = smoothstep(0.45, 1.0, x);
    let h = -depth * (1.0 - wall * wall * (3.0 - 2.0 * wall)) + rim * exp(-(x - 1.02) * (x - 1.02) / 0.03)
          + 0.35 * rim * (1.0 - smoothstep(1.0, 1.8, x)) * smoothstep(0.95, 1.1, x);
    return vec2<f32>(h, 1.0 - smoothstep(0.35, 0.7, x));
}

pub fn region(up: vec3<f32>, seed: i32) -> Region {
    var r: Region;
    // The dichotomy: the plains about 70 N 180 E, out to some 80 degrees
    // from there, the boundary bent by a broad warp; the uplands rolling
    // and higher toward the south.
    let lowland = place(70.0, 180.0);
    let warp = 0.11 * simplex_f32(up * 2.3, seed + 11) + 0.045 * simplex_f32(up * 6.1, seed + 12);
    let a = angle(up, lowland) + warp;
    let low = 1.0 - smoothstep(1.30, 1.47, a);
    let uplands = 1300.0 + 900.0 * simplex_f32(up * 1.6, seed + 13) + 900.0 * smoothstep(0.1, -0.8, up.y);
    let plains = -4100.0 + 350.0 * simplex_f32(up * 2.0, seed + 14);
    var h = mix(uplands, plains, low);

    // The rises: Tharsis, 7 km and some 5000 km across, west of the
    // canyons, and Elysium's smaller one.
    let tharsis = bell(angle(up, place(-2.0, -105.0)) / 0.78);
    let elysium = bell(angle(up, place(24.0, 147.0)) / 0.24);
    h += 6800.0 * tharsis + 2200.0 * elysium;
    // Their volcanic plains: young, smooth, dusty.
    let volcanic = max(smoothstep(0.25, 0.75, tharsis), smoothstep(0.2, 0.7, elysium));

    // The basins.
    let hellas = basin(up, place(-42.4, 70.5), 0.34, 8600.0, 1600.0);
    let argyre = basin(up, place(-49.7, -43.0), 0.265, 5000.0, 1500.0);
    let isidis = basin(up, place(12.9, 87.0), 0.22, 3200.0, 1300.0);
    let utopia = basin(up, place(49.7, 118.0), 0.48, 1300.0, 0.0);
    let chryse = basin(up, place(25.0, -40.0), 0.21, 2400.0, 0.0);
    h += hellas.x + argyre.x + isidis.x + utopia.x + chryse.x;
    let floors = max(max(hellas.y, argyre.y), isidis.y);

    // The poles: the north's layered dome (Planum Boreum) 2.8 km high and
    // some 1200 km across, cut by its spiral troughs and Chasma Boreale;
    // the south's (Planum Australe) off the pole toward 315 E.
    let an = angle(up, vec3<f32>(0.0, 1.0, 0.0));
    let north = bell(an / 0.21);
    let az = atan2(up.x, up.z);
    let spiral = sin(2.0 * az + an * 95.0 + 1.5 * simplex_f32(up * 18.0, seed + 15));
    let trough = smoothstep(0.75, 0.97, spiral) * smoothstep(0.02, 0.06, an) * smoothstep(0.2, 0.12, an);
    let chasma_az = abs(atan2(sin(az + 0.6), cos(az + 0.6)));
    let chasma = (1.0 - smoothstep(0.08, 0.22, chasma_az * max(an, 0.02) / 0.06)) * smoothstep(0.04, 0.1, an) * smoothstep(0.24, 0.17, an);
    h += 2800.0 * north - 450.0 * trough * north - 1500.0 * chasma;
    let south_c = place(-86.5, -45.0);
    let as_ = angle(up, south_c);
    let south = bell(as_ / 0.16);
    let south_trough = smoothstep(0.8, 0.97, sin(-2.0 * atan2(up.x, up.z) + as_ * 120.0)) * smoothstep(0.02, 0.05, as_) * smoothstep(0.15, 0.09, as_);
    h += 3100.0 * south - 350.0 * south_trough * south;
    let ice_n = (1.0 - smoothstep(0.10, 0.145, an + 0.02 * simplex_f32(up * 30.0, seed + 16))) * (1.0 - 0.75 * trough) * (1.0 - chasma);
    let ice_s = (1.0 - smoothstep(0.035, 0.06, as_ + 0.01 * simplex_f32(up * 40.0, seed + 17))) * (1.0 - 0.6 * south_trough);
    r.ice = max(ice_n, ice_s);
    r.polar = max(smoothstep(0.0, 0.25, north), smoothstep(0.0, 0.25, south));

    r.h = h;
    r.low = low;
    r.volcanic = volcanic;
    r.basin = floors;
    // Age: the uplands ancient, the plains resurfaced, the rises' lava and
    // the polar deposits young.
    r.old = mix(1.0, 0.32, low) * (1.0 - 0.85 * volcanic) * (1.0 - 0.9 * r.polar);
    // Dust: bright where it settles thick (Tharsis, Arabia, Elysium), dark
    // where the wind sweeps it off (Syrtis Major, Acidalia, the southern
    // mid-latitudes' dark bands).
    let syrtis = bell(angle(up, place(9.0, 69.0)) / 0.18);
    let acidalia = bell(angle(up, place(47.0, -30.0)) / 0.2);
    let arabia = bell(angle(up, place(20.0, 10.0)) / 0.3);
    let band = smoothstep(-0.15, -0.4, up.y) * smoothstep(-0.85, -0.6, up.y);
    let n = simplex_grad_f32(up * 2.2, seed + 18);
    r.dust = clamp(0.55 + 0.45 * n.x + 0.07 * n.y + 0.45 * volcanic + 0.4 * arabia - 0.7 * syrtis - 0.55 * acidalia
                   - 0.35 * band - 0.3 * floors, 0.0, 1.0);
    return r;
}
