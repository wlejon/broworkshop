// Mars's shield volcanoes: Olympus Mons, the three Tharsis Montes, Alba
// Mons and Elysium Mons, each a broad shield of gentle flanks (a few
// degrees) to a summit caldera of nested collapse pits, its flanks ribbed
// by radial lava flows and channels; Olympus stands on its basal scarp, a
// cliff kilometres high all round.
module planet::volcanoes;
from planet::noise import simplex_f32;
from planet::scale import place, angle, RADIUS;

pub struct Volcano {
    h: f32,       // metres over the ground about it
    flank: f32,   // the share on a shield
    caldera: f32, // in a caldera
}

pub fn mix_volcano(a: Volcano, b: Volcano, t: f32) -> Volcano {
    return Volcano { h: mix(a.h, b.h, t), flank: mix(a.flank, b.flank, t), caldera: mix(a.caldera, b.caldera, t) };
}

// A pit of a caldera: a flat floor `depth` down, its wall steep, at
// angular distance a from its centre, `r` radians across its rim.
fn pit(a: f32, r: f32, depth: f32) -> f32 {
    return -depth * (1.0 - smoothstep(0.82, 1.0, a / r));
}

// A shield about c: `rb` radians to its base, `height` metres over it,
// standing on a scarp `scarp` metres high at its base; its flanks' lava
// flows' relief `ribs` metres; seen through a cell `width` metres wide.
fn shield(up: vec3<f32>, c: vec3<f32>, rb: f32, height: f32, scarp: f32, ribs: f32, width: f32, seed: i32) -> Volcano {
    var v: Volcano;
    v.h = 0.0;
    v.flank = 0.0;
    v.caldera = 0.0;
    let a = angle(up, c);
    if (a >= 1.35 * rb) { return v; }
    // Which way round the shield the point is.
    let e = normalize(cross(vec3<f32>(0.0, 1.0, 0.0), c));
    let n = cross(c, e);
    let dx = dot(up, e);
    let dy = dot(up, n);
    let around = vec2<f32>(dx, dy) / max(length(vec2<f32>(dx, dy)), 1e-9);
    // The base's edge wanders round it by a tenth, in lobes where its
    // flows ran farthest.
    let lobes = 0.07 * simplex_f32(vec3<f32>(around.x * 1.6, around.y * 1.6, 0.37), seed + 7)
              + 0.035 * simplex_f32(vec3<f32>(around.x * 4.5, around.y * 4.5, 1.7), seed + 8);
    let x = a / (rb * (1.0 + lobes));
    if (x >= 1.15) { return v; }
    // The shield: flanks steepest low down and easing to a broad summit.
    let body = height - scarp;
    let t = clamp(x, 0.0, 1.0);
    var h = body * pow(1.0 - t, 1.35);
    // The scarp: a cliff over the last 3% of the radius, higher in places,
    // and a skirt of the shield's own aureole beyond.
    let cliff = scarp * (1.0 + 2.5 * lobes);
    h += cliff * (1.0 - smoothstep(0.97, 1.0, x)) + 0.06 * cliff * (1.0 - smoothstep(1.0, 1.15, x)) * smoothstep(0.98, 1.0, x);
    // Radial lava flows: noise stretched along the fall line, its
    // wavelength around the shield 2 pi rb / 70, down it rb / 6, faded as
    // a cell spans it.
    let k = 70.0 / 6.2831853;
    let lam = max(6.2831853 * max(x, 0.15) * rb * RADIUS / 70.0, 1.0);
    let m = exp(-1.1 * (width / lam) * (width / lam));
    let flows = simplex_f32(vec3<f32>(around.x * k, around.y * k, x * 6.0), seed) +
                0.5 * simplex_f32(vec3<f32>(around.x * k * 2.0, around.y * k * 2.0, x * 13.0), seed + 1);
    let on_flank = smoothstep(0.08, 0.2, x) * (1.0 - smoothstep(0.9, 1.0, x));
    h += ribs * flows * m * on_flank;
    v.flank = 1.0 - smoothstep(0.95, 1.1, x);
    v.h = h;
    return v;
}

pub fn volcanoes(up: vec3<f32>, width: f32, seed: i32) -> Volcano {
    var out: Volcano;
    out.h = 0.0;
    out.flank = 0.0;
    out.caldera = 0.0;
    // Olympus Mons: 600 km across, 20 km over its plains, on a 6 km scarp;
    // its caldera six pits, 80 km across in all, 3 km deep.
    let olympus = place(18.65, -133.8);
    let o = shield(up, olympus, 0.088, 19500.0, 6000.0, 260.0, width, seed + 300);
    if (o.flank > 0.0) {
        var cal = 0.0;
        cal = min(cal, pit(angle(up, place(18.4, -133.6)), 0.0075, 2900.0));
        cal = min(cal, pit(angle(up, place(18.9, -134.2)), 0.0055, 2300.0));
        cal = min(cal, pit(angle(up, place(18.2, -134.3)), 0.0042, 3200.0));
        cal = min(cal, pit(angle(up, place(18.8, -133.3)), 0.0035, 2000.0));
        cal = min(cal, pit(angle(up, place(19.15, -133.75)), 0.003, 1500.0));
        out.h += o.h + cal;
        out.flank = max(out.flank, o.flank);
        out.caldera = max(out.caldera, smoothstep(-200.0, -1200.0, cal));
    }
    // The Tharsis Montes, in a line from SW to NE.
    let ascraeus = place(11.8, -104.5);
    let a = shield(up, ascraeus, 0.068, 13000.0, 0.0, 180.0, width, seed + 310);
    if (a.flank > 0.0) {
        let cal = min(pit(angle(up, ascraeus), 0.008, 3000.0), pit(angle(up, place(11.6, -104.2)), 0.005, 2400.0));
        out.h += a.h + cal;
        out.flank = max(out.flank, a.flank);
        out.caldera = max(out.caldera, smoothstep(-200.0, -1200.0, cal));
    }
    let pavonis = place(1.5, -113.0);
    let p = shield(up, pavonis, 0.056, 8500.0, 0.0, 150.0, width, seed + 320);
    if (p.flank > 0.0) {
        let cal = min(pit(angle(up, pavonis), 0.014, 4000.0), pit(angle(up, place(1.2, -112.6)), 0.007, 3000.0));
        out.h += p.h + cal;
        out.flank = max(out.flank, p.flank);
        out.caldera = max(out.caldera, smoothstep(-200.0, -1200.0, cal));
    }
    let arsia = place(-8.3, -121.0);
    let r = shield(up, arsia, 0.065, 12500.0, 0.0, 160.0, width, seed + 330);
    if (r.flank > 0.0) {
        let cal = pit(angle(up, arsia), 0.034, 1300.0);
        out.h += r.h + cal;
        out.flank = max(out.flank, r.flank);
        out.caldera = max(out.caldera, smoothstep(-200.0, -1000.0, cal));
    }
    // Alba Mons: low and vast.
    let alba = place(40.5, -109.6);
    let b = shield(up, alba, 0.18, 5500.0, 0.0, 120.0, width, seed + 340);
    if (b.flank > 0.0) {
        let cal = pit(angle(up, alba), 0.017, 900.0);
        out.h += b.h + cal;
        out.flank = max(out.flank, b.flank);
    }
    // Elysium Mons.
    let elysium = place(25.0, 147.0);
    let y = shield(up, elysium, 0.037, 11500.0, 0.0, 140.0, width, seed + 350);
    if (y.flank > 0.0) {
        let cal = pit(angle(up, elysium), 0.004, 900.0);
        out.h += y.h + cal;
        out.flank = max(out.flank, y.flank);
    }
    return out;
}
