// Mars's crater system: impact craters at every scale, from basins hundreds
// of kilometres wide down to metre pits, the same craters in every tile's
// cells and texels (produce.bk), however coarse.
//
// Octave k is a 3D grid of cells C0 / 2^k wide about the planet's centre
// (world_lattice.bk's lattice C, doubled k times: exact at every scale).
// A cell holds at most one crater: whether it does is a hash of the cell
// against the octave's density there (density), its centre a hashed point
// in the cell, kept when it lies within half a cell of the sphere (so a
// shell a cell deep, and as many craters a square cell of the surface
// whatever the cell's lie), and its diameter up to SIZE_MAX of the cell. A
// crater reaches REACH radii (its ejecta), at most half a cell from its
// centre across the surface, so the 3 x 3 x 3 cells about a point hold
// every crater that can touch it.
//
// Each crater's profile is zero-mean over its reach: what the bowl takes
// out stands in its rim and ejecta (profile_rim), so craters too small for
// a cell average to nothing in it, and a cell holds each crater's profile
// as its box sees it (seen: the profile blurred by the cell's width, which
// fills the bowl from the rim and spreads the rim). A coarse cell is the
// aggregate of the fine ones, never a different ground.
module planet::craters;

pub const C0: f32 = 1048576.0;   // octave 0's cell, metres (lattice C's)
pub const OCTAVES: i32 = 19;     // to cells of 4 m: pits a metre across
pub const SIZE_MAX: f32 = 0.30;  // a crater's diameter, at most, of its cell
pub const REACH: f32 = 3.0;      // the ejecta's reach, in radii

// ── Hashes ──────────────────────────────────────────────────────────────────

fn mix32(x_in: u32) -> u32 {
    var x = x_in;
    x = (x ^ (x >> 16u)) * 0x7feb352du;
    x = (x ^ (x >> 15u)) * 0x846ca68bu;
    return x ^ (x >> 16u);
}
// Four uniform numbers in [0, 1) for cell c of octave k.
fn cell_hash(c: vec3<i32>, k: i32, seed: i32) -> vec4<f32> {
    let h0 = mix32(bitcast<u32>(c.x) * 0x8da6b343u ^ bitcast<u32>(c.y) * 0xd8163841u ^ bitcast<u32>(c.z) * 0xcb1ab31fu
                   ^ bitcast<u32>(k * 7919 + seed) * 0x165667b1u);
    let h1 = mix32(h0 ^ 0x9e3779b9u);
    let h2 = mix32(h1 ^ 0x85ebca6bu);
    let h3 = mix32(h2 ^ 0xc2b2ae35u);
    return vec4<f32>((h0 >> 8u) as f32, (h1 >> 8u) as f32, (h2 >> 8u) as f32, (h3 >> 8u) as f32) * (1.0 / 16777216.0);
}

// ── Where craters are, and how old ──────────────────────────────────────────
//
// `old` is the surface's age, 0 the youngest lava to 1 the ancient
// highlands: old ground is saturated with craters of every size, most of
// them worn; young plains hold few large ones (resurfacing buried them) and
// fresh small ones.
pub fn density(k: i32, old: f32) -> f32 {
    let large = 0.04 + 0.9 * old * old;
    let small = 0.25 + 0.7 * old;
    return mix(large, small, smoothstep(4.0, 9.0, k as f32));
}
// A crater's wear, 0 fresh to 1 nearly gone, from its hash u.
fn wear(u: f32, old: f32) -> f32 {
    return pow(u, mix(2.6, 0.55, old));
}

// ── A crater's profile ──────────────────────────────────────────────────────
//
// At x = r / R from its centre (R its radius), in metres: a bowl under its
// rim to depth d, flat-floored past the simple-to-complex transition (floor
// radius f, central peak P out to PEAK_X), the rim at x = 1, and ejecta
// falling off as x^-3 to REACH. Simple craters are 0.2 D deep; complex ones
// shallower as they widen (0.4 D_km^0.3 km); worn ones shallower still,
// their floors filled and peaks gone. The rim's height is what keeps the
// crater's volume zero (profile_rim).
pub struct Shape {
    d: f32,      // depth under the surround, m
    hr: f32,     // the rim's height, m
    f: f32,      // the floor's radius, a share of R
    p: f32,      // the central peak's height, m
}
const PEAK_X: f32 = 0.16;
const EJECTA_SHAPE: f32 = 3.3880;   // 2 pi int_1^X (x^-3 - X^-3) / (1 - X^-3) x dx, X = REACH

pub fn shape(diameter: f32, worn: f32) -> Shape {
    let km = diameter * 0.001;
    let complex = smoothstep(5000.0, 14000.0, diameter);
    let dd = mix(0.2, min(0.4 * pow(max(km, 0.001), -0.7), 0.2), complex);
    var s: Shape;
    s.d = dd * diameter * (1.0 - 0.8 * worn);
    s.f = mix(mix(0.0, 0.5, complex), 0.72, 0.85 * worn);
    s.p = complex * 0.4 * s.d * (1.0 - smoothstep(60000.0, 160000.0, diameter)) * (1.0 - worn);
    s.hr = profile_rim(s.d, s.f, s.p);
    return s;
}
// The rim height that makes the profile's volume zero: the bowl's volume
// -pi d + 2 pi (d + hr) Q (Q = (1 - f)(f / 3 + (1 - f) / 4)), the peak's
// pi P PEAK_X^2 / 3 and the ejecta's hr EJECTA_SHAPE (per R^2) sum to none.
fn profile_rim(d: f32, f: f32, p: f32) -> f32 {
    let q = (1.0 - f) * (f / 3.0 + (1.0 - f) * 0.25);
    return max((3.14159265 * d * (1.0 - 2.0 * q) - p * 3.14159265 * PEAK_X * PEAK_X / 3.0) / (6.2831853 * q + EJECTA_SHAPE), 0.0);
}
// The profile at x and its slope d h / d x (metres a radius).
pub fn profile(s: Shape, x: f32) -> vec2<f32> {
    var h = vec2<f32>(0.0);
    let xr3 = 1.0 / (REACH * REACH * REACH);
    if (x < s.f) {
        h = vec2<f32>(-s.d, 0.0);
    } else if (x < 1.0) {
        let w = 1.0 - s.f;
        let t = (x - s.f) / w;
        h = vec2<f32>(-s.d + (s.d + s.hr) * t * t, 2.0 * (s.d + s.hr) * t / w);
    } else if (x < REACH) {
        let x2 = x * x;
        let inv = 1.0 / (1.0 - xr3);
        h = vec2<f32>(s.hr * (1.0 / (x2 * x) - xr3) * inv, -3.0 * s.hr / (x2 * x2) * inv);
    }
    if (x < PEAK_X && s.p > 0.0) {
        let u = x * x / (PEAK_X * PEAK_X);
        let g = 1.0 - u;
        h += vec2<f32>(s.p * g * g, -4.0 * s.p * g * x / (PEAK_X * PEAK_X));
    }
    return h;
}
// The share of a crater a cell `width` metres wide holds about its centre:
// the profile seen through the cell's box, about a Gaussian of its
// variance, over the crater's own (a bump of R / 2). It weighs the shares
// that colour the ground.
pub fn mean_share(diameter: f32, width: f32) -> f32 {
    let r = width / diameter;
    return 1.0 / (1.0 + 1.33 * r * r);
}

// I0(z) e^-z, the scaled modified Bessel function of order zero
// (Abramowitz and Stegun 9.8.1 and 9.8.2).
fn i0e(z: f32) -> f32 {
    if (z < 3.75) {
        let t = z * z / 14.0625;
        let i0 = 1.0 + t * (3.5156229 + t * (3.0899424 + t * (1.2067492 + t * (0.2659732 + t * (0.0360768 + t * 0.0045813)))));
        return i0 * exp(-z);
    }
    let u = 3.75 / z;
    let p = 0.39894228 + u * (0.01328592 + u * (0.00225319 + u * (-0.00157565 + u * (0.00916281
            + u * (-0.02057706 + u * (0.02635537 + u * (-0.01647633 + u * 0.00392377)))))));
    return p / sqrt(z);
}
// A cell's box blurs a crater about a Gaussian of the box's variance:
// sigma (radii) is width / sqrt(12) over the radius. Under this the profile
// is taken as it is.
const SHARP: f32 = 0.02;
const SEEN_STEPS: i32 = 16;
// The profile at x seen through a Gaussian `sigma` radii wide: about the
// circle of radius x, the ring at r weighs exp(-(x - r)^2 / 2 sigma^2)
// I0e(x r / sigma^2) r, summed over the rings within 3 sigma.
pub fn seen(s: Shape, x: f32, sigma: f32) -> f32 {
    if (sigma < SHARP) { return profile(s, x).x; }
    let lo = max(x - 3.0 * sigma, 0.0);
    let hi = x + 3.0 * sigma;
    let dr = (hi - lo) / (SEEN_STEPS as f32);
    let inv = 1.0 / (sigma * sigma);
    var sum: f32 = 0.0;
    var weight: f32 = 0.0;
    for (var i: i32 = 0; i < SEEN_STEPS; i += 1) {
        let r = lo + ((i as f32) + 0.5) * dr;
        let w = exp(-0.5 * (x - r) * (x - r) * inv) * i0e(x * r * inv) * r;
        if (r < REACH) { sum += profile(s, r).x * w; }
        weight += w;
    }
    return sum / max(weight, 1e-20);
}

// ── The craters about a point ───────────────────────────────────────────────

// What the craters of one octave make at a point: the height (m), and the
// shares that colour the ground: under a crater's floor (sand gathers there
// in craters a few kilometres and wider), on its walls, and over a fresh
// crater's ejecta.
pub struct Craters {
    h: f32,
    floor: f32,
    wall: f32,
    fresh: f32,
}
pub fn no_craters() -> Craters {
    return Craters { h: 0.0, floor: 0.0, wall: 0.0, fresh: 0.0 };
}

// Octave k's craters at the point `f` in lattice cell `cell` (f in [0, 1)
// a cell, cells `size` metres), on the sphere whose up is `up`, a radius of
// `rad_cells` cells from the centre, its surface `old` (density), seen
// through a cell `width` metres wide (0: the point), `buried` (0 to 1) the
// share of the small ones (under some 4 km) lost under sand and sediment
// laid over them. Their heights add.
pub fn octave(cell: vec3<i32>, f: vec3<f32>, up: vec3<f32>, rad_cells: f32, k: i32, size: f32, old: f32,
              buried: f32, width: f32, seed: i32) -> Craters {
    var out = no_craters();
    let p = density(k, old) * (1.0 - buried * smoothstep(7.0, 10.0, k as f32));
    let reach = 0.5;
    // A neighbour cell can hold a crater touching the point only if it lies
    // within `reach` across the surface (0.71 of a cell in all) and the
    // shell a cell deep about the sphere: the rest are passed over unhashed.
    let near = 0.72;
    let spread = 0.5 * (abs(up.x) + abs(up.y) + abs(up.z));
    for (var dz: i32 = -1; dz <= 1; dz += 1) {
        if ((dz < 0 && f.z > near) || (dz > 0 && f.z < 1.0 - near)) { continue; }
        for (var dy: i32 = -1; dy <= 1; dy += 1) {
            if ((dy < 0 && f.y > near) || (dy > 0 && f.y < 1.0 - near)) { continue; }
            for (var dx: i32 = -1; dx <= 1; dx += 1) {
                if ((dx < 0 && f.x > near) || (dx > 0 && f.x < 1.0 - near)) { continue; }
                // The cell's centre less the point along up, against the
                // shell (with the sphere's fall over a cell's reach).
                let mid = vec3<f32>(dx as f32, dy as f32, dz as f32) + vec3<f32>(0.5) - f;
                if (abs(dot(mid, up)) > 0.5 + spread + 0.5 / rad_cells) { continue; }
                let c = cell + vec3<i32>(dx, dy, dz);
                let hs = cell_hash(c, k, seed);
                if (hs.x >= p) { continue; }
                let j = cell_hash(c, k, seed + 1);
                // Whether the crater is: its centre within half a cell of
                // the sphere, from the cell alone (so every point agrees).
                let centre = vec3<f32>(c.x as f32, c.y as f32, c.z as f32) + j.xyz;
                if (abs(length(centre) - rad_cells) >= 0.5) { continue; }
                // The centre less the point, in cells.
                let d = vec3<f32>(dx as f32, dy as f32, dz as f32) + j.xyz - f;
                let up_d = dot(d, up);
                let dt = d - up * up_d;
                let s2 = dot(dt, dt);
                if (s2 >= reach * reach) { continue; }
                let diameter = SIZE_MAX * size * exp2(-1.3 * hs.y);
                let radius = 0.5 * diameter / size;   // in cells
                let x = sqrt(s2) / radius;
                // The box's blur, in radii.
                let sigma = 0.57735 * width / diameter;
                if (x >= REACH + 3.0 * sigma) { continue; }
                let worn = wear(hs.z, old);
                let sh = shape(diameter, worn);
                let m = mean_share(diameter, width);
                out.h += seen(sh, x, sigma);
                if (x >= REACH) { continue; }
                let inner = 1.0 - smoothstep(max(sh.f, 0.35), 0.95, x);
                out.floor += inner * smoothstep(1500.0, 5000.0, diameter) * (1.0 - 0.6 * worn) * m;
                out.wall += smoothstep(max(sh.f, 0.3), 0.95, x) * (1.0 - smoothstep(1.0, 1.15, x)) * (1.0 - worn) * m;
                out.fresh += (1.0 - smoothstep(0.0, 0.3, worn)) * (1.0 - smoothstep(1.0, REACH, x)) * m;
            }
        }
    }
    return out;
}
