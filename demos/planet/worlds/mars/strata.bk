// Mars's layered rock: the beds of the canyons' walls, of the interior
// layered deposits and of the polar layered deposits, as a sequence in
// stratigraphic height. Each bed is its own thickness (0.25 to 1.75 of the
// sequence's mean, from a hash of its index, so the boundaries never fall
// on a ruled spacing), hardness and tone; beds come in members some seven
// beds thick, each member harder or softer, lighter or darker as a whole,
// so the bands read in packets of thick and thin.
//
// The beds shape the walls they crop out on (terrace): a wall's height
// through a soft bed rises at the wall's mean slope, through a hard one as
// a bench under a cliff, so resistant beds stand out as ledges and the
// soft ones between them are slopes. And they colour them (bed_tone): the
// colour of rock at a stratigraphic height is its bed's.
module planet::strata;

fn mix32(x_in: u32) -> u32 {
    var x = x_in;
    x = (x ^ (x >> 16u)) * 0x7feb352du;
    x = (x ^ (x >> 15u)) * 0x846ca68bu;
    return x ^ (x >> 16u);
}
// A uniform number in [0, 1) for index i of sequence `seed`.
fn hash1(i: i32, seed: i32) -> f32 {
    return ((mix32(bitcast<u32>(i) * 0x9e3779b1u ^ bitcast<u32>(seed) * 0x85ebca6bu) >> 8u) as f32) * (1.0 / 16777216.0);
}

// Where bed k's base lies, in means: k plus a jitter of up to 3/8 either
// way, so a bed is 0.25 to 1.75 of the mean thick.
fn bed_base(k: i32, seed: i32) -> f32 {
    return (k as f32) + 0.75 * (hash1(k, seed) - 0.5);
}

pub struct Bed {
    base: f32,    // the bed's base and thickness, metres of stratigraphic height
    thick: f32,
    f: f32,       // how far up the bed the point is, 0 to 1
    hard: f32,    // 0 soft (slope-forming) to 1 resistant (ledge-forming)
    tone: f32,    // -1 dark to 1 light
}

// The bed at stratigraphic height z (m) of a sequence whose beds are
// `mean` metres thick on average.
pub fn bed_at(z: f32, mean: f32, seed: i32) -> Bed {
    let u = z / mean;
    var k = floor(u) as i32;
    if (u < bed_base(k, seed)) { k -= 1; } else if (u >= bed_base(k + 1, seed)) { k += 1; }
    let b0 = bed_base(k, seed);
    let b1 = bed_base(k + 1, seed);
    // The member: seven beds or so, from a jittered index of its own.
    let m = floor((k as f32) / 7.0 + 0.6 * hash1(k, seed + 3)) as i32;
    let member_hard = hash1(m, seed + 5);
    let member_tone = hash1(m, seed + 7) * 2.0 - 1.0;
    var b: Bed;
    b.base = b0 * mean;
    b.thick = (b1 - b0) * mean;
    b.f = clamp((u - b0) / max(b1 - b0, 1e-3), 0.0, 1.0);
    b.hard = clamp(0.65 * hash1(k, seed + 1) + 0.7 * member_hard - 0.35, 0.0, 1.0);
    b.tone = clamp(0.65 * member_tone + 0.4 * (hash1(k, seed + 2) * 2.0 - 1.0), -1.0, 1.0);
    return b;
}

// A wall's height z (metres, rising at its mean slope) through the beds of
// a sequence `mean` thick: soft beds at the mean slope, hard ones a bench
// that steepens into a cliff at the bed's top (up to `cliff` times the mean
// slope), by `strength` (0 none, 1 full).
pub fn terrace(z: f32, mean: f32, cliff: f32, strength: f32, seed: i32) -> f32 {
    let b = bed_at(z, mean, seed);
    // g(f): f on a soft bed, f^cliff on a hard one (flat, then a cliff of
    // `cliff` times the slope at its top).
    let g = mix(b.f, pow(b.f, cliff), b.hard * strength);
    return b.base + b.thick * g;
}

// The tone (-1 dark to 1 light) and hardness of the rock at stratigraphic
// height z, seen over a texel spanning `span` metres of it: its bed's,
// fading toward none as the texel spans the bed.
pub fn bed_tone(z: f32, mean: f32, span: f32, seed: i32) -> vec2<f32> {
    let b = bed_at(z, mean, seed);
    let seen = exp(-(span * span) / (b.thick * b.thick * 2.0));
    return vec2<f32>(b.tone * seen, b.hard * seen);
}
