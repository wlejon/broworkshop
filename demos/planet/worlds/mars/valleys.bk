// Mars's valley networks: the branching valleys that dissect the ancient
// highlands, cut by water some three and a half billion years ago, trunks
// kilometres wide and a couple of hundred metres deep, their tributaries
// finer, all running down the ground's slopes.
//
// Each size is an octave of lattice C (VALLEY_FIRST to VALLEY_LAST, 8 km
// down to 1 km apart): about each of the 3 x 3 x 3 cells' hashed points
// near the point, a wave whose crests run down the slope (across the
// gradient), weighted by the distance to the point; their mean is gullies
// laid down the fall line that merge and part where the points do. Each
// octave's slope is the ground's so far, its own valleys included, so a
// finer octave's gullies run down the coarser's valley sides into its
// floors: the networks branch (after Johansen's erosion filter, 2023).
// Only where the ground slopes and only on old ground.
//
// The waves are zero-mean, and a cell too coarse to see an octave holds
// none of it (share), so a coarse cell is the aggregate of its valleys.
module planet::valleys;
from planet::anchor import Anchor, doubled, twice, perlin_from;
from planet::world_lattice import C;
from planet::craters import C0;

const VALLEY_FIRST: i32 = 7;   // cells 8 km
const VALLEY_LAST: i32 = 10;   // cells 1 km
const VALLEY_DEPTH: array<f32, 4> = [240.0, 120.0, 60.0, 30.0];
const TAU: f32 = 6.2831853;

fn mix32(x_in: u32) -> u32 {
    var x = x_in;
    x = (x ^ (x >> 16u)) * 0x7feb352du;
    x = (x ^ (x >> 15u)) * 0x846ca68bu;
    return x ^ (x >> 16u);
}
// A point in cell c of octave k, as an offset in the cell (0 to 1 an axis).
fn site(c: vec3<i32>, k: i32, seed: i32) -> vec3<f32> {
    var h = mix32(bitcast<u32>(c.x) * 0x9e3779b1u ^ bitcast<u32>(c.y) * 0x85ebca6bu ^ bitcast<u32>(c.z) * 0xc2b2ae35u
                  ^ bitcast<u32>(k * 7919 + seed) * 0x27d4eb2fu);
    let x = (h >> 8u) as f32;
    h = mix32(h + 0x6a09e667u);
    let y = (h >> 8u) as f32;
    h = mix32(h + 0x6a09e667u);
    let z = (h >> 8u) as f32;
    return vec3<f32>(x, y, z) * (1.0 / 16777216.0);
}

// The share of an octave's valleys `cell` metres apart a cell `width`
// metres wide keeps.
fn valley_share(width: f32, cell: f32) -> f32 {
    let r = width / cell;
    return exp(-6.0 * r * r);
}

// The valleys' height (m) at offset e from the anchor on the ground whose up
// is `up`, its gradient so far `grad` (metres a metre), on ground `old`
// (the surface's age: none on young ground), over a cell `width` metres
// wide.
pub fn valleys(a: Anchor, e: vec3<f32>, up: vec3<f32>, radius: f32, grad: vec3<f32>, old: f32, width: f32,
               seed: i32) -> f32 {
    let strength = smoothstep(0.45, 0.85, old);
    if (strength <= 0.0) { return 0.0; }
    var g = grad - up * dot(grad, up);
    var sum: f32 = 0.0;
    var lat = doubled(a.l[C], VALLEY_FIRST);
    var d = e * (radius / C0) * exp2(VALLEY_FIRST as f32);
    var cell = C0 / exp2(VALLEY_FIRST as f32);
    for (var k: i32 = VALLEY_FIRST; k <= VALLEY_LAST; k += 1) {
        let share = valley_share(width, cell);
        if (share < 0.01) { break; }
        let slope = length(g);
        let amp = 0.5 * VALLEY_DEPTH[k - VALLEY_FIRST] * strength * share * smoothstep(0.002, 0.012, slope);
        if (amp > 0.01) {
            // Across the fall line: the waves' crests run down it.
            let across = cross(up, g / slope);
            let at = perlin_from(lat, d);
            var wave: f32 = 0.0;
            var dwave: f32 = 0.0;
            var weight: f32 = 0.0;
            for (var i: i32 = 0; i < 27; i += 1) {
                let o = vec3<i32>(i % 3 - 1, (i / 3) % 3 - 1, i / 9 - 1);
                let pp = at.f - (vec3<f32>(o.x as f32, o.y as f32, o.z as f32) + site(at.cell + o, k, seed + 1700));
                // (Weighted by the whole distance, so a point leaving the
                // 3 x 3 x 3 cells as the point moves weighs next to nothing.)
                let w = exp(-4.0 * dot(pp, pp));
                let ph = TAU * dot(pp, across);
                wave += cos(ph) * w;
                dwave -= sin(ph) * w;
                weight += w;
            }
            wave /= max(weight, 1e-6);
            dwave /= max(weight, 1e-6);
            sum += amp * wave;
            // The next octave runs down this one's valley sides.
            g += across * (amp * dwave * TAU / cell);
        }
        lat = twice(lat);
        d *= 2.0;
        cell *= 0.5;
    }
    return sum;
}
