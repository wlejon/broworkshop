// Mars's shading of the ground (planet::world_ground, which the core's hook
// core/ground_mesh.bk calls; planet::ground_core is what it gives): no
// clouds or plants stand between the ground and the sky (ground_sky), it
// keeps no varyings of its own (ground_vertex), and each pixel
// (ground_fragment) is the detail layer's colour and normal (its a the
// sand's share, its byte the ice's) with the regolith's finer relief and
// tone to what the pixel resolves, and the wind's ripples on the sand.
module planet::world_ground;
import scene;
import mesh;
from planet::ground_layout import DETAIL_PERIOD, FAR_PERIOD, SEED;
from planet::ground_core import detail_texel, GroundVarying, GroundFrag, lit;
from planet::periodic import perlin_grad;

const VARY_LUM: f32 = 0.14;      // the regolith's tone per octave, log-luminance per unit of noise
const PERLIN_VAR: f32 = 0.0728;  // the periodic noise's variance
const RELIEF: f32 = 0.10;        // its slope per octave, per unit of the noise's gradient
const ROCK_LUM: f32 = 1.6;
const ROCK_RELIEF: f32 = 2.6;
// The ripples on the sand: wave vectors over DETAIL_PERIOD (|n| about 21: 3 m
// wavelengths), their crest's height and the share of the slope's profile.
const RIPPLE_N: array<vec3<f32>, 3> = [
    vec3<f32>(20.0, 5.0, -6.0), vec3<f32>(-6.0, 19.0, 8.0), vec3<f32>(7.0, -6.0, 20.0),
];
const RIPPLE_HEIGHT: f32 = 0.10;

// No clouds, no plants: the light the core found over the horizons.
pub fn ground_sky(sun_in: f32, sky_seen: f32, rel: vec3<f32>, up: vec3<f32>, to_sun: vec3<f32>, w: f32) -> vec4<f32> {
    return vec4<f32>(sun_in, sky_seen, 1.0, 0.0);
}

pub fn ground_vertex(slot: i32, cx: i32, cy: i32) -> GroundVarying {
    return GroundVarying { a: vec4<f32>(0.0), uv: vec2<f32>(0.0) };
}

// The ripples' slope (m/m) on the ground at q (modulo DETAIL_PERIOD) whose
// up is `up`, at a pixel `footprint` metres wide: the sets running along
// the ground, each fading as a pixel spans it, their asymmetric crests
// (gentle up wind, steep down).
fn ripples(q: vec3<f32>, up: vec3<f32>, footprint: f32) -> vec3<f32> {
    var slope = vec3<f32>(0.0);
    let x = q / DETAIL_PERIOD;
    for (var i: i32 = 0; i < 3; i += 1) {
        let n = RIPPLE_N[i];
        let kt = n - up * dot(n, up);
        let tl = length(kt);
        let wl = DETAIL_PERIOD / max(tl, 1e-3);
        let w = smoothstep(0.6, 0.85, tl / length(n)) * clamp(wl / footprint * 0.5 - 1.0, 0.0, 1.0);
        if (w <= 0.0) { continue; }
        let p = 6.2831853 * fract(dot(n, x));
        // h = sin p + 0.3 sin 2p, its derivative in p.
        let dh = cos(p) + 0.6 * cos(2.0 * p);
        slope += kt * (w * RIPPLE_HEIGHT * dh * 6.2831853 / DETAIL_PERIOD);
    }
    return slope;
}

pub fn ground_fragment(g: GroundFrag, s_in: mesh::Surface) -> mesh::Surface {
    var s = s_in;
    let footprint = g.footprint;
    // Bilinear over the four texels about this point.
    let fl_tex = floor(g.tex);
    let f = g.tex - fl_tex;
    let t0 = vec2<i32>(fl_tex.x as i32, fl_tex.y as i32);
    let d00 = detail_texel(g.slot, t0);
    let d10 = detail_texel(g.slot, t0 + vec2<i32>(1, 0));
    let d01 = detail_texel(g.slot, t0 + vec2<i32>(0, 1));
    let d11 = detail_texel(g.slot, t0 + vec2<i32>(1, 1));
    let col = mix(mix(d00.col, d10.col, f.x), mix(d01.col, d11.col, f.x), f.y);
    let ice = mix(mix(d00.cover, d10.cover, f.x), mix(d01.cover, d11.cover, f.x), f.y);
    var n = normalize(mix(mix(d00.nrm, d10.nrm, f.x), mix(d01.nrm, d11.nrm, f.x), f.y));
    let sand = col.w;
    let up = normalize(g.up);
    let texel = footprint / max(max(length(dpdx(g.tex)), length(dpdy(g.tex))), 1e-6);

    // The regolith's octaves finer than the texels, to what the pixel
    // resolves (full weight from 4 pixels a wavelength, none at 2), less
    // what the texels already hold: tone and relief, more of both on bare
    // rock (grey, low in colour) than on the dust and sand.
    let hi_c = max(col.x, max(col.y, col.z));
    let lo_c = min(col.x, min(col.y, col.z));
    let rock = 1.0 - smoothstep(0.25, 0.5, (hi_c - lo_c) / max(hi_c, 1e-3));
    let lum_gain = mix(1.0, ROCK_LUM, rock) * (1.0 - 0.5 * sand) * (1.0 - 0.6 * ice);
    let relief_gain = mix(1.0, ROCK_RELIEF, rock) * (1.0 - 0.6 * sand) * (1.0 - 0.7 * ice);
    var lum: f32 = 0.0;
    var lum_var: f32 = 0.0;
    var slope = vec3<f32>(0.0);
    var wl = min(exp2(ceil(log2(2.0 * texel))), 64.0);
    for (var k: i32 = 0; k < 10 && wl > 0.0625; k += 1) {
        let w = clamp(wl / footprint * 0.5 - 1.0, 0.0, 1.0) - clamp(wl / texel * 0.5 - 1.0, 0.0, 1.0);
        if (w > 0.0) {
            let far = wl >= 1.0;
            let x = (far ? g.far : g.q) / wl;
            let pg = perlin_grad(x, ((far ? FAR_PERIOD : DETAIL_PERIOD) / wl) as i32, 31 + (round(log2(wl)) as i32));
            let a = VARY_LUM * lum_gain * w;
            lum += pg.x * a;
            lum_var += a * a * PERLIN_VAR;
            slope += pg.yzw * (RELIEF * relief_gain * w);
        }
        wl *= 0.5;
    }
    // The ripples on the sand.
    if (sand > 0.05 && footprint < 1.5) {
        slope += ripples(g.q, up, footprint) * smoothstep(0.05, 0.4, sand);
    }
    n = normalize(n - (slope - dot(slope, n) * n));
    s.base_color = col.xyz * exp(lum - 0.5 * lum_var);
    s.normal = n;
    s.roughness = mix(0.95, 0.6, ice);
    s.metallic = 0.0;
    s = lit(g, s, 1.0);

    // Its debug views: the sand's share, the ice's, the texels' colour and
    // the octaves' tone.
    if (SCENE_DEBUG(sand)) { s = mesh::debug(s, vec3<f32>(sand, sand * 0.5, ice)); }
    if (SCENE_DEBUG(texels)) { s = mesh::debug(s, col.xyz); }
    if (SCENE_DEBUG(octaves)) { s = mesh::debug(s, vec3<f32>(0.5 * exp(lum - 0.5 * lum_var))); }
    return s;
}
