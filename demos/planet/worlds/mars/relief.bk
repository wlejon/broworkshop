// Mars's rolling relief: octaves of noise on lattice S (world_lattice.bk)
// from 262 km down to a metre, under the landforms' broad shapes and the
// craters. Its spectrum falls more slowly than smooth ground's (0.58 an
// octave, so the slopes steepen toward the small scales: the rubble and
// rough lava of a rover's view), and how rough the ground is scales it:
// the ancient highlands most, the dusty plains and the polar deposits least.
// Each octave's share is its mean over the cell (scale.bk mean_factor), so
// a coarse cell holds the mean of the fine ones.
module planet::relief;
from planet::noise import simplex_grad;
from planet::anchor import Anchor, doubled, twice, simplex_from;
from planet::world_lattice import S;
from planet::scale import BASE_WAVELENGTH, mean_factor;

pub const RELIEF_FIRST: i32 = 3;
pub const RELIEF_LAST: i32 = 22;
const RELIEF_AMP: f32 = 700.0;   // octave 3's amplitude, m
const RELIEF_FALL: f32 = 0.58;
// Octaves past a cell's own carry on until their mean is nothing (as
// Earth's: a cell 2.3 wavelengths wide).
const RELIEF_PAST: f32 = 2.5;

// Octave o's amplitude, metres, at a roughness of 1.
pub fn relief_amp(o: i32) -> f32 {
    return RELIEF_AMP * pow(RELIEF_FALL, (o - RELIEF_FIRST) as f32);
}
// What the octaves from o on can add at most, metres.
pub fn relief_tail(o: i32) -> f32 {
    return relief_amp(max(o, RELIEF_FIRST)) / (1.0 - RELIEF_FALL);
}

// The relief at offset e from the anchor, over a cell carrying `octaves`,
// `rough` times the spectrum.
pub fn relief(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, rough: f32, seed: i32) -> f32 {
    let past = octaves + RELIEF_PAST;
    let n = min(ceil(past) as i32, RELIEF_LAST);
    var lat = doubled(a.l[S], RELIEF_FIRST);
    var d = e * (radius / BASE_WAVELENGTH) * exp2(RELIEF_FIRST as f32);
    var sum: f32 = 0.0;
    var amp = RELIEF_AMP * rough;
    for (var o: i32 = RELIEF_FIRST; o < n; o += 1) {
        let w = clamp(past - (o as f32), 0.0, 1.0) * mean_factor(o, octaves);
        sum += simplex_grad(simplex_from(lat, d), seed + 200 + o).x * amp * w;
        amp *= RELIEF_FALL;
        lat = twice(lat);
        d *= 2.0;
    }
    return sum;
}
