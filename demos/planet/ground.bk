// The planet's ground: one height function of the unit direction, evaluated
// in f64 so a cell lands exactly at any scale, Earth radius included, and the
// colour of the truth under a cell. planet.bk's kernels fill tiles with it;
// the tests measure it.
module planet::ground;

import std::noise::*;

// Wavelength of the first octave, in metres.
const BASE_WAVELENGTH: f64 = 2400000.0;
// E[(1 - |noise|)^2], measured over 200k samples.
const RIDGE_MEAN: f64 = 0.4999;
// Var(noise), measured the same way.
const NOISE_VAR: f32 = 0.1504;
// Var((1 - |noise|)^2), and the variance of either one's gradient along one
// axis per unit of input, measured the same way.
const RIDGE_VAR: f32 = 0.0727;
const NOISE_GRAD_VAR: f32 = 2.027;
const RIDGE_GRAD_VAR: f32 = 4.586;

// The ground's noise: OpenSimplex2S, which is continuous everywhere. The
// classic simplex (std simplex3d, FastNoise2's) reaches a little past its
// simplex and steps where the lattice's simplices meet: on planes like y = z,
// which every octave shares, so the steps of all of them line up into one
// (a 4 cm ledge along the cube's +Y/+Z edge, seen as a line to the horizon).
//
// It is std supersimplex3d with the f64 work only in finding q's lattice
// cell (the skew and its floor): the rest runs in f32 on the offset inside
// the cell, which needs no more, and the GPU runs f64 at a small fraction of
// f32's rate. The same as std's to f32 rounding.
fn noise(q: vec3<f64>, seed: i32) -> f64 {
    let sum = q.x + q.y + q.z;
    let s3: f64 = (0.3333333432674407958984375 as f32) as f64;
    let sx = q.x + s3 * sum;
    let sy = q.y + s3 * sum;
    let sz = q.z + s3 * sum;
    let cx = floor(sx);
    let cy = floor(sy);
    let cz = floor(sz);
    let so0: i32 = (cx as i64) as i32;
    let so1: i32 = (cy as i64) as i32;
    let so2: i32 = (cz as i64) as i32;
    var dx_skewed: f32 = (sx - cx) as f32;
    var dy_skewed: f32 = (sy - cy) as f32;
    var dz_skewed: f32 = (sz - cz) as f32;
    var x_base: i32 = 0;
    var y_base: i32 = 0;
    var z_base: i32 = 0;

    let tu0: f32 = -0.25 * (dx_skewed + dy_skewed + dz_skewed);
    let xn0: f32 = dx_skewed + tu0;
    let yn0: f32 = dy_skewed + tu0;
    let zn0: f32 = dz_skewed + tu0;
    let xyzn0: f32 = -tu0;

    var max_score: f32 = 0.375;
    var move_bits: i32 = (xyzn0 > max_score) ? -1 : 0;
    max_score = max(max_score, xyzn0);
    if xn0 > max_score { move_bits = 1; max_score = xn0; }
    if yn0 > max_score { move_bits = 2; max_score = yn0; }
    if zn0 > max_score { move_bits = 4; max_score = zn0; }
    max_score += 0.125 - xyzn0;
    if (-zn0) > max_score { move_bits = 3; max_score = -zn0; }
    if (-yn0) > max_score { move_bits = 5; max_score = -yn0; }
    if (-xn0) > max_score { move_bits = 6; max_score = -xn0; }

    if (move_bits & 1) != 0 { x_base += 1; dx_skewed -= 1.0; }
    if (move_bits & 2) != 0 { y_base += 1; dy_skewed -= 1.0; }
    if (move_bits & 4) != 0 { z_base += 1; dz_skewed -= 1.0; }

    let x_primed: i32 = (x_base + so0) * PRIME_X;
    let y_primed: i32 = (y_base + so1) * PRIME_Y;
    let z_primed: i32 = (z_base + so2) * PRIME_Z;

    let sk_sum: f32 = dx_skewed + dy_skewed + dz_skewed;
    let tu: f32 = -0.25 * sk_sum;
    let xn: f32 = dx_skewed + tu;
    let yn: f32 = dy_skewed + tu;
    let zn: f32 = dz_skewed + tu;
    let xyzn: f32 = -tu;

    let unskew_d: f32 = -0.5 * sk_sum;
    let dx_b: f32 = dx_skewed + unskew_d;
    let dy_b: f32 = dy_skewed + unskew_d;
    let dz_b: f32 = dz_skewed + unskew_d;
    let coord_sum: f32 = -0.5 * sk_sum;

    let g0: f32 = grad_dot_common3d<f32>(hash_primes3d(seed, x_primed, y_primed, z_primed), dx_b, dy_b, dz_b);
    let fb0: f32 = (((0.75 - dx_b * dx_b) - dy_b * dy_b) - dz_b * dz_b) * 0.5;
    let stem_a: f32 = fb0 - 0.375;
    let stem_b: f32 = fb0 - 0.5;
    var value: f32 = ((fb0 * fb0) * (fb0 * fb0)) * g0;

    // <1,1,1> or <-1,-1,-1>
    let sm1: bool = xyzn < 0.0;
    let off1: f32 = sm1 ? 0.5 : -0.5;
    let g1: f32 = grad_dot_common3d<f32>(
        hash_primes3d(seed,
            x_primed + (sm1 ? -PRIME_X : PRIME_X),
            y_primed + (sm1 ? -PRIME_Y : PRIME_Y),
            z_primed + (sm1 ? -PRIME_Z : PRIME_Z)),
        dx_b - off1, dy_b - off1, dz_b - off1);
    let fb1: f32 = max(off1 * coord_sum + stem_a, 0.0);
    value += ((fb1 * fb1) * (fb1 * fb1)) * g1;

    // <1,1,0> or <-1,-1,0>
    let sm2: bool = xyzn < zn;
    let off2: f32 = sm2 ? 1.0 : -1.0;
    let g2: f32 = grad_dot_common3d<f32>(
        hash_primes3d(seed, x_primed + (sm2 ? -PRIME_X : PRIME_X), y_primed + (sm2 ? -PRIME_Y : PRIME_Y), z_primed),
        dx_b, dy_b, dz_b - off2);
    let fb2: f32 = min((sm2 ? -dz_b : dz_b) - stem_b, 0.0);
    value += ((fb2 * fb2) * (fb2 * fb2)) * g2;

    // <1,0,1> or <-1,0,-1>
    let sm3: bool = xyzn < yn;
    let off3: f32 = sm3 ? 1.0 : -1.0;
    let g3: f32 = grad_dot_common3d<f32>(
        hash_primes3d(seed, x_primed + (sm3 ? -PRIME_X : PRIME_X), y_primed, z_primed + (sm3 ? -PRIME_Z : PRIME_Z)),
        dx_b, dy_b - off3, dz_b);
    let fb3: f32 = min((sm3 ? -dy_b : dy_b) - stem_b, 0.0);
    value += ((fb3 * fb3) * (fb3 * fb3)) * g3;

    // <0,1,1> or <0,-1,-1>
    let sm4: bool = xyzn < xn;
    let off4: f32 = sm4 ? 1.0 : -1.0;
    let g4: f32 = grad_dot_common3d<f32>(
        hash_primes3d(seed, x_primed, y_primed + (sm4 ? -PRIME_Y : PRIME_Y), z_primed + (sm4 ? -PRIME_Z : PRIME_Z)),
        dx_b - off4, dy_b, dz_b);
    let fb4: f32 = min((sm4 ? -dx_b : dx_b) - stem_b, 0.0);
    value += ((fb4 * fb4) * (fb4 * fb4)) * g4;

    // <1,0,0> or <-1,0,0>
    let sm5: bool = xn < 0.0;
    let off5: f32 = sm5 ? 0.5 : -0.5;
    let g5: f32 = grad_dot_common3d<f32>(
        hash_primes3d(seed, x_primed + (sm5 ? -PRIME_X : PRIME_X), y_primed, z_primed),
        dx_b + off5, dy_b - off5, dz_b - off5);
    let fb5: f32 = max((off5 * coord_sum + stem_a) + (sm5 ? -dx_b : dx_b), 0.0);
    value += ((fb5 * fb5) * (fb5 * fb5)) * g5;

    // <0,1,0> or <0,-1,0>
    let sm6: bool = yn < 0.0;
    let off6: f32 = sm6 ? 0.5 : -0.5;
    let g6: f32 = grad_dot_common3d<f32>(
        hash_primes3d(seed, x_primed, y_primed + (sm6 ? -PRIME_Y : PRIME_Y), z_primed),
        dx_b - off6, dy_b + off6, dz_b - off6);
    let fb6: f32 = max((off6 * coord_sum + stem_a) + (sm6 ? -dy_b : dy_b), 0.0);
    value += ((fb6 * fb6) * (fb6 * fb6)) * g6;

    // <0,0,1> or <0,0,-1>
    let sm7: bool = zn < 0.0;
    let off7: f32 = sm7 ? 0.5 : -0.5;
    let g7: f32 = grad_dot_common3d<f32>(
        hash_primes3d(seed, x_primed, y_primed, z_primed + (sm7 ? -PRIME_Z : PRIME_Z)),
        dx_b - off7, dy_b - off7, dz_b + off7);
    let fb7: f32 = max((off7 * coord_sum + stem_a) + (sm7 ? -dz_b : dz_b), 0.0);
    value += ((fb7 * fb7) * (fb7 * fb7)) * g7;

    return scale_output<f32>(value, -0.0069091119803488254547119140625, 0.0069091119803488254547119140625) as f64;
}

// A cell holds the mean of the ground over it, not the value at its centre:
// on a crest the centre stands above the mean, in a hollow below it, and
// children's means average to their parent's where centres do not. An
// octave's mean over a cell, given its value at the centre, is that value
// moved toward the octave's mean by a factor (the regression slope) that
// falls as the cell widens: `span` is the cell in the octave's wavelengths,
// exp2(o - octaves) / 2.5 (octaves_for). For a smooth wave the factor is
// 1 - k^2 L^2 / 24 ~ exp(-k^2 L^2 / 24) (the box's Laplacian term); E[k^2]
// along the surface is twice the gradient variance along one axis over the
// variance, which gives NOISE_BOX and RIDGE_BOX per unit of span^2. Measured
// over 100k cells (16 x 16 samples each), the noise holds to it out to a
// cell a wavelength wide; the ridge's crests are kinks, whose gradient is not
// curvature a box removes, so its factor falls by exp(-0.9 span) as cells
// widen. Both within a few hundredths of the measured slopes.
const NOISE_BOX: f32 = 2.0 * NOISE_GRAD_VAR / NOISE_VAR / 24.0;
const RIDGE_BOX: f32 = 2.0 * RIDGE_GRAD_VAR / RIDGE_VAR / 24.0;
fn span_of(o: i32, octaves: f64) -> f32 {
    return exp2((o as f32) - (octaves as f32)) / 2.5;
}
fn noise_mean_factor(o: i32, octaves: f64) -> f32 {
    let s = span_of(o, octaves);
    return exp(-NOISE_BOX * s * s);
}
fn ridge_mean_factor(o: i32, octaves: f64) -> f32 {
    let s = span_of(o, octaves);
    return exp(-RIDGE_BOX * s * s * exp(-0.9 * s));
}
// Octaves past a cell's own carry on until their factor is negligible (a
// cell `NOISE_PAST` octaves finer is 2.3 wavelengths wide, factor 0.003; the
// ridge's 1.1, factor 0.08), the last fading out over its final octave so
// the sum is continuous in `octaves`.
const NOISE_PAST: f64 = 2.5;
const RIDGE_PAST: f64 = 1.5;

// The octaves first to last - 1 of noise, each at the factor of its mean
// over one of the tile's cells (noise_mean_factor): a tile holds the average
// of what its children hold plus zero-mean detail.
fn fbm_to(p: vec3<f64>, octaves: f64, first: i32, last: i32, seed: i32) -> f64 {
    var sum: f64 = 0.0;
    var amp: f64 = 1.0;
    var q: vec3<f64> = p * pow(2.0, first as f64);
    let n = min(ceil(octaves + NOISE_PAST) as i32, last);
    for (var o: i32 = first; o < n; o += 1) {
        let w = clamp(octaves + NOISE_PAST - (o as f64), 0.0, 1.0) * (noise_mean_factor(o, octaves) as f64);
        sum += noise(q, seed + o) * amp * w;
        amp *= 0.5;
        q = q * 2.0;
    }
    return sum;
}

// The octaves a tile `extent` wide with cells of `inv_size` of its edge can
// carry: down to a wavelength of 2.5 cells (app.js octavesFor, the same).
pub fn octaves_for(extent: f64, inv_size: f64) -> f64 {
    let ratio = (BASE_WAVELENGTH / (2.5 * extent * inv_size)) as f32;
    return clamp(log2(ratio), 1.0, 30.0) as f64;
}

// The mountains' relief: ridged octaves RIDGE_FIRST to RIDGE_LAST - 1, each
// (1 - |noise|)^2 less its mean, so two-sided: crests above, valleys and
// basins between, and an octave a tile cannot resolve adds nothing on
// average. The amplitude (metres at full uplift) peaks at octave 8, a 9.4 km
// wavelength, the scale a range is composed at: the broader octaves organise
// the ridges into ranges, the finer fall off by 0.45, a little faster than
// equal slope (0.5), so the slope settles near 33 degrees instead of growing
// with every octave down.
const RIDGE_FIRST: i32 = 4;
const RIDGE_LAST: i32 = 16;
fn ridge_amp(o: i32) -> f32 {
    if (o < 8) {
        if (o == 4) { return 200.0; }
        if (o == 5) { return 350.0; }
        if (o == 6) { return 600.0; }
        return 900.0;
    }
    return 1200.0 * pow(0.45, (o - 8) as f32);
}
// Where ranges are, their ground is lifted this far (metres): the belt the
// relief stands on.
const UPLIFT: f64 = 2500.0;
// The detail fbm's first amplitude (octave 4), metres: the plains', and
// what the ranges add on top.
const DETAIL_PLAINS: f32 = 250.0;
const DETAIL_RANGES: f32 = 300.0;

// What the octaves finer than a tile's can still add to its surface, in
// metres: the detail fbm (octave 4 up) and the relief, counted from the last
// octave the tile resolves (a peak between its cells), with a quarter more
// for the noise's reach toward 1. Below the continents' octaves it is
// everything (`top`).
pub fn range_margin(octaves: f64, top: f32) -> f32 {
    let k = (floor(octaves) as i32) - 1;
    if (k < 4) { return top; }
    var m: f32 = (DETAIL_PLAINS + DETAIL_RANGES) * 2.0 * exp2(4.0 - (k as f32));
    for (var o: i32 = max(k, RIDGE_FIRST); o < RIDGE_LAST; o += 1) {
        m += ridge_amp(o);
    }
    return m * 1.25;
}

// The shares of an octave's variance that lie inside one of a tile's cells,
// about the cell's value: `f` the octave's mean factor at the cell, `box`
// its k^2 / 24. f32 here and below: the statistics need no more, and Vulkan
// has no f64 exp.
//
// within_share: all of it the cell does not hold, 1 - f^2.
fn within_share(f: f32) -> f32 {
    return 1.0 - f * f;
}

// unresolved_share: what is left once the cell's own slope is known too.
// The slope across a cell L wide carries g^2 L^2 / 12, which expected_surface
// counts exactly; as a share of the octave's variance that is 2 box span^2
// of the slope the cell holds (f^2 of it).
fn unresolved_share(f: f32, box: f32, span: f32) -> f32 {
    return max(1.0 - f * f - 2.0 * box * span * span * f * f, 0.0);
}

// gradient_share: the share of an octave's gradient variance a cell's own
// gradient misses. The gradient is a central difference over two cells,
// which passes sinc(2 pi span) of the slope of what the cell holds, so an
// octave near the cells' limit keeps half of it; and the slope varies across
// the cell by about span^2 of its own.
fn gradient_share(f: f32, span: f32) -> f32 {
    let x = 6.2831853 * min(span, 1.0);
    let kept = f * sin(x) / x;
    return min(1.0 - kept * kept + span * span * f * f, 1.0);
}

// The standard normal CDF.
fn normal_cdf(z: f32) -> f32 {
    return 0.5 * (1.0 + tanh(0.7978846 * (z + 0.044715 * z * z * z)));
}

// E[(X - k)+] for X ~ N(m, s^2): the mean of a ramp over noise a tile
// cannot resolve.
fn ramp_mean(m: f32, s: f32, k: f32) -> f32 {
    if (s < 1e-6) { return max(m - k, 0.0); }
    let z = (m - k) / s;
    return (m - k) * normal_cdf(z) + s * 0.3989423 * exp(-0.5 * z * z);
}

// E[clamp(X, lo, hi)] for X ~ N(m, s^2).
fn clamp_mean(m: f64, s: f64, lo: f32, hi: f32) -> f64 {
    let mf = m as f32;
    let sf = s as f32;
    return (lo + ramp_mean(mf, sf, lo) - ramp_mean(mf, sf, hi)) as f64;
}

// The broad masks at p (= dir * radius / BASE_WAVELENGTH): x the continents,
// y what they vary by inside one of the tile's cells as Gaussian noise (the
// coastline clamps take their mean over it, so a coarse tile holds what its
// descendants average to), z where mountain ranges rise, w how much is land.
fn masks(p: vec3<f64>, octaves: f64, seed: i32) -> vec4<f64> {
    let continents = fbm_to(p, octaves, 0, 4, seed);
    var unresolved: f32 = 0.0;
    var a: f32 = 1.0;
    for (var o: i32 = 0; o < 4; o += 1) {
        unresolved += a * a * NOISE_VAR * within_share(noise_mean_factor(o, octaves));
        a *= 0.5;
    }
    let sc = sqrt(unresolved) as f64;
    let onLand = clamp_mean(continents * 6.0 + 0.3, sc * 6.0, 0.0, 1.0);
    let ranges = clamp(noise(p * 1.7, seed + 300) * 2.2 - 0.35, 0.0, 1.0);
    return vec4<f64>(continents, sc, ranges, onLand);
}

// The relief reads its octaves through a warp: a smooth displacement (one
// octave of noise per axis at octave WARP_OCTAVE, a 37 km wavelength, about
// 2 km on average) that bends ridgelines off the noise lattice's directions,
// which otherwise run straight and parallel. Its largest stretch stays well
// short of folding the ground over itself (a displacement gradient of -1).
const WARP_OCTAVE: f64 = 6.0;
const WARP_DISPLACE: f64 = 0.0021;   // in p units (BASE_WAVELENGTH), per unit of noise

// A ridge octave's mean over one of the tile's cells, from the noise n at
// the centre. The ridge is (1 - |n|)^2 of a smooth noise, whose cell mean
// is nonlinear: on a crest (n ~ 0) the centre is the ridge's top and the
// cell around it is lower, by more than any factor on the ridge's value
// says. So it is taken through the smooth noise, which holds to its box
// factor: n over the cell ~ N(f n, (1 - f^2) NOISE_VAR), and the mean of
// (1 - |n|)^2 is 1 - 2 E|n| + E[n^2], E|n| a folded normal's, scaled so a
// cell that resolves nothing of the octave holds the ridge's measured mean
// exactly (the noise is bounded, not Gaussian: E|n| = (1 + NOISE_VAR -
// RIDGE_MEAN) / 2 over the Gaussian's sqrt(NOISE_VAR) sqrt(2 / pi)).
// Measured against 16 x 16 box means, it errs 30-40% less than a linear
// factor on the ridge for cells up to a third of a wavelength, crests
// included, and the same for wider ones.
fn ridge_cell_mean(n: f32, f: f32) -> f32 {
    let mu = f * n;
    let spread2 = max(1.0 - f * f, 0.0) * NOISE_VAR;
    let sd = sqrt(spread2);
    var fold = abs(mu);
    if (sd > 1e-6) {
        let scale = (1.0 + NOISE_VAR - (RIDGE_MEAN as f32)) * 0.5 / (0.7978846 * sqrt(NOISE_VAR));
        fold = scale * sd * 0.7978846 * exp(-0.5 * mu * mu / spread2) + mu * (1.0 - 2.0 * normal_cdf(-mu / sd));
    }
    return 1.0 - 2.0 * fold + mu * mu + spread2;
}

// The relief at p, metres at full uplift: the ridged octaves, each its mean
// over one of the tile's cells less the ridge's mean.
fn relief(p: vec3<f64>, octaves: f64, seed: i32) -> f64 {
    let n = min(ceil(octaves + RIDGE_PAST) as i32, RIDGE_LAST);
    if (n <= RIDGE_FIRST) { return 0.0; }
    let wq = p * exp2(WARP_OCTAVE);
    let warp = vec3<f64>(noise(wq, seed + 400), noise(wq, seed + 401), noise(wq, seed + 402));
    var q: vec3<f64> = (p + warp * WARP_DISPLACE) * exp2(RIDGE_FIRST as f64);
    var sum: f64 = 0.0;
    for (var o: i32 = RIDGE_FIRST; o < n; o += 1) {
        let fade = clamp(octaves + RIDGE_PAST - (o as f64), 0.0, 1.0);
        let mean = ridge_cell_mean(noise(q, seed + 100 + o) as f32, noise_mean_factor(o, octaves));
        sum += ((mean as f64) - RIDGE_MEAN) * (ridge_amp(o) as f64) * fade;
        q = q * 2.0;
    }
    return sum;
}

// Metres above the sphere at `dir`: continents from the broad octaves,
// ranges where a broad mask allows them on land (lifted, and carrying the
// ridged relief), and the fine octaves over both, rougher in the ranges.
pub fn terrain(dir: vec3<f64>, radius: f64, octaves: f64, seed: i32) -> f64 {
    let p = dir * (radius / BASE_WAVELENGTH);
    let m = masks(p, octaves, seed);
    let land = clamp_mean(m.x * 3.0 + 0.15, m.y * 3.0, -1.0, 1.0);
    let uplift = m.z * m.w;
    let mountains = uplift * (UPLIFT + relief(p, octaves, seed));
    let detail = fbm_to(p, octaves, 4, 64, seed + 200);
    return land * 1100.0 + mountains + detail * ((DETAIL_PLAINS + DETAIL_RANGES * (uplift as f32)) as f64);
}

// Below this many octaves a cell is wide enough that the next octaves vary
// a lot inside it, through the coastline clamps and the ridges: such a cell
// averages SUB x SUB samples taken with two more octaves instead of reading
// one, so it is the aggregate of the finer truth, not a guess at it.
const SUPERSAMPLE_BELOW: f64 = 7.0;
const SUB: i32 = 4;

// The height a cell holds: at (s, t) of the frame (corner c, axes u, v in
// base coordinates), `cell` wide in (s, t).
pub fn cell_height(c: vec3<f64>, u: vec3<f64>, v: vec3<f64>, s: f64, t: f64, cell: f64,
                   radius: f64, octaves: f64, seed: i32) -> f64 {
    if (octaves >= SUPERSAMPLE_BELOW) {
        return terrain(normalize(c + u * s + v * t), radius, octaves, seed);
    }
    var sum: f64 = 0.0;
    for (var j: i32 = 0; j < SUB; j += 1) {
        for (var i: i32 = 0; i < SUB; i += 1) {
            let ds = (((i as f64) + 0.5) / (SUB as f64) - 0.5) * cell;
            let dt = (((j as f64) + 0.5) / (SUB as f64) - 0.5) * cell;
            sum += terrain(normalize(c + u * (s + ds) + v * (t + dt)), radius, octaves + 2.0, seed);
        }
    }
    return sum / ((SUB * SUB) as f64);
}

// ── Colour ──────────────────────────────────────────────────────────────────
//
// A cell's colour is the mean colour of the truth under it, not the colour
// of its mean: snow-capped peaks over green valleys read from orbit as the
// mix they are. The truth under a cell is modelled as its own height and
// gradient plus Gaussian spreads from the octaves it does not resolve.

// What the truth under a cell varies by about the cell's own values: x the
// height (m) the cell's slope does not account for, y the gradient along
// either axis (m/m). Each octave counts by unresolved_share in height and
// gradient_share in gradient, down to `truth`, the finest octaves anything
// draws. With gain 0.5 and lacunarity 2 every octave adds the same slope,
// so the fine octaves matter to the gradient as much as the broad ones.
pub fn spread(dir: vec3<f64>, radius: f64, octaves: f64, truth: f32, seed: i32) -> vec2<f32> {
    let m = masks(dir * (radius / BASE_WAVELENGTH), octaves, seed);
    let oct = octaves as f32;
    // The continents through the coastline clamp, which passes them where
    // it is linear: 1100 * 3 metres of height per unit of noise.
    let mc = (m.x * 3.0 + 0.15) as f32;
    let sc = max((m.y * 3.0) as f32, 1e-6);
    let land = 3300.0 * (normal_cdf((1.0 - mc) / sc) - normal_cdf((-1.0 - mc) / sc));
    var ch: f32 = 0.0;
    var cg: f32 = 0.0;
    var a: f32 = 1.0;
    for (var o: i32 = 0; o < 4; o += 1) {
        let f = noise_mean_factor(o, octaves);
        let s = span_of(o, octaves);
        ch += a * a * NOISE_VAR * unresolved_share(f, NOISE_BOX, s);
        cg += NOISE_GRAD_VAR * gradient_share(f, s);   // amplitude * frequency = 1
        a *= 0.5;
    }
    // The relief, in metres already (ridge_amp), under the uplift.
    let mount = (m.z * m.w) as f32;
    var rh: f32 = 0.0;
    var rg: f32 = 0.0;
    for (var o: i32 = RIDGE_FIRST; o < RIDGE_LAST; o += 1) {
        let f = ridge_mean_factor(o, octaves) * clamp(oct + (RIDGE_PAST as f32) - (o as f32), 0.0, 1.0);
        let s = span_of(o, octaves);
        let ra = ridge_amp(o);
        let rf = ra * exp2(o as f32);   // amplitude * frequency
        rh += ra * ra * RIDGE_VAR * unresolved_share(f, RIDGE_BOX, s);
        rg += rf * rf * RIDGE_GRAD_VAR * gradient_share(f, s);
    }
    // The detail, octave 4 up at amplitude 0.5^(o - 4), to the truth's last.
    let detail = DETAIL_PLAINS + DETAIL_RANGES * (m.z * m.w) as f32;
    var dh: f32 = 0.0;
    var dg: f32 = 0.0;
    a = 1.0;
    let n = ceil(truth) as i32;
    for (var o: i32 = 4; o < n; o += 1) {
        let w = clamp(truth - (o as f32), 0.0, 1.0);
        let f = noise_mean_factor(o, octaves) * clamp(oct + (NOISE_PAST as f32) - (o as f32), 0.0, 1.0);
        let s = span_of(o, octaves);
        dh += a * a * NOISE_VAR * unresolved_share(f, NOISE_BOX, s) * w * w;
        dg += 256.0 * NOISE_GRAD_VAR * gradient_share(f, s) * w * w;   // amplitude * frequency = 16
        a *= 0.5;
    }
    let h2 = land * land * ch + mount * mount * rh + detail * detail * dh;
    let wl = BASE_WAVELENGTH as f32;
    let g2 = (land * land * cg + mount * mount * rg + detail * detail * dg) / (wl * wl);
    return vec2<f32>(sqrt(h2), sqrt(g2));
}

// The ground at one height and gradient (tan of the angle from up): its
// albedo, and w = 1 for water.
fn surface(h: f32, grad: f32) -> vec4<f32> {
    if (h <= 0.0) {
        let depth = clamp(-h / 2500.0, 0.0, 1.0);
        return vec4<f32>(mix(vec3<f32>(0.03, 0.16, 0.22), vec3<f32>(0.005, 0.03, 0.09), depth), 1.0);
    }
    // Beach at the shore; grassland, forest up to the treeline, alpine
    // meadow above it, bare scree higher still, snow on top; rock wherever
    // the ground is too steep to hold soil (from about 38 degrees), snow
    // where it is not too steep to hold snow.
    let slope = 1.0 - 1.0 / sqrt(1.0 + grad * grad);
    let sand = vec3<f32>(0.44, 0.39, 0.29);
    let grass = vec3<f32>(0.16, 0.27, 0.08);
    let forest = vec3<f32>(0.06, 0.13, 0.05);
    let alpine = vec3<f32>(0.20, 0.21, 0.11);
    let rock = vec3<f32>(0.24, 0.22, 0.20);
    let snow = vec3<f32>(0.92, 0.94, 0.97);
    var c = mix(sand, grass, smoothstep(1.0, 4.0, h));
    c = mix(c, forest, smoothstep(150.0, 600.0, h) * (1.0 - smoothstep(2300.0, 2900.0, h)));
    c = mix(c, alpine, smoothstep(2300.0, 2900.0, h));
    c = mix(c, rock, max(smoothstep(0.2, 0.4, slope), smoothstep(3600.0, 4300.0, h)));
    c = mix(c, snow, smoothstep(4200.0, 4800.0, h) * (1.0 - smoothstep(0.35, 0.6, slope)));
    return vec4<f32>(c, 0.0);
}

// The z with normal_cdf(z) = u: normal_cdf's tanh inverted, then its cubic
// solved by Newton from the linear guess (it is nearly linear, so three
// steps reach f32).
fn normal_quantile(u: f32) -> f32 {
    let x = clamp(2.0 * u - 1.0, -0.999999, 0.999999);
    let y = 0.5 * log((1.0 + x) / (1.0 - x)) / 0.7978846;
    var z = y;
    for (var i: i32 = 0; i < 3; i += 1) {
        z -= (z + 0.044715 * z * z * z - y) / (1.0 + 0.134145 * z * z);
    }
    return z;
}

// Gauss-Legendre nodes and weights on [0, 1]: x node, y weight.
fn gl5(i: i32) -> vec2<f32> {
    if (i == 0) { return vec2<f32>(0.0469101, 0.1184634); }
    if (i == 1) { return vec2<f32>(0.2307653, 0.2393143); }
    if (i == 2) { return vec2<f32>(0.5, 0.2844444); }
    if (i == 3) { return vec2<f32>(0.7692347, 0.2393143); }
    return vec2<f32>(0.9530899, 0.1184634);
}
// Gauss-Hermite nodes and weights for N(0, 1): x node, y weight.
fn gh3(i: i32) -> vec2<f32> {
    if (i == 0) { return vec2<f32>(-1.7320508, 0.1666667); }
    if (i == 1) { return vec2<f32>(0.0, 0.6666667); }
    return vec2<f32>(1.7320508, 0.1666667);
}

// The land's albedo varies in patches, lighter and darker, more and less ochre,
// at every scale from octave VARY_FIRST down, with equal contrast in each
// octave: log-normal factors on the albedo, independent of the height. A
// cell takes the octaves it resolves (the last weighted by its fraction),
// exp(S - var(S) / 2), which is the mean of the factor over all the octaves
// below, so a cell's factor is the average of its children's. The ground
// shader carries the octaves finer than any tile on per pixel.
const VARY_FIRST: i32 = 5;
// Var(perlin_split), measured over 200k samples.
const PERLIN_VAR: f32 = 0.0728;
const VARY_LUM: f32 = 0.11;    // log-luminance, per octave
const VARY_TINT: f32 = 0.05;   // ochre (tint_axis, log per channel), per octave
fn tint_axis() -> vec3<f32> { return vec3<f32>(1.0, 0.45, -0.5); }
const TINT_LAST: i32 = 16;

// Perlin noise at q with the f64 work only in finding q's lattice cell: the
// rest runs in f32 on the offset inside the cell, which needs no more (the
// GPU runs f64 at a small fraction of f32's rate).
pub fn perlin_split(q: vec3<f64>, seed: i32) -> f32 {
    let c = floor(q);
    let xf0 = (q.x - c.x) as f32;
    let yf0 = (q.y - c.y) as f32;
    let zf0 = (q.z - c.z) as f32;
    let x0: i32 = ((c.x as i64) as i32) * PRIME_X;
    let y0: i32 = ((c.y as i64) as i32) * PRIME_Y;
    let z0: i32 = ((c.z as i64) as i32) * PRIME_Z;
    let x1: i32 = x0 + PRIME_X;
    let y1: i32 = y0 + PRIME_Y;
    let z1: i32 = z0 + PRIME_Z;
    let xf1 = xf0 - 1.0;
    let yf1 = yf0 - 1.0;
    let zf1 = zf0 - 1.0;
    let u = interp_quintic<f32>(xf0);
    let v = interp_quintic<f32>(yf0);
    let w = interp_quintic<f32>(zf0);
    let g0 = mix(mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y0, z0), xf0, yf0, zf0),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y0, z0), xf1, yf0, zf0), u),
                 mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y1, z0), xf0, yf1, zf0),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y1, z0), xf1, yf1, zf0), u), v);
    let g1 = mix(mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y0, z1), xf0, yf0, zf1),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y0, z1), xf1, yf0, zf1), u),
                 mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y1, z1), xf0, yf1, zf1),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y1, z1), xf1, yf1, zf1), u), v);
    return mix(g0, g1, w);
}

pub fn variation(dir: vec3<f64>, radius: f64, octaves: f64, seed: i32) -> vec3<f32> {
    var q: vec3<f64> = dir * (radius / BASE_WAVELENGTH) * pow(2.0, VARY_FIRST as f64);
    var lum: f32 = 0.0;
    var tint: f32 = 0.0;
    var vl: f32 = 0.0;
    var vt: f32 = 0.0;
    let n = ceil(octaves) as i32;
    for (var o: i32 = VARY_FIRST; o < n; o += 1) {
        let w = clamp(octaves - (o as f64), 0.0, 1.0) as f32;
        let al = VARY_LUM * w;
        lum += perlin_split(q, seed + 101 + o) * al;
        vl += al * al * PERLIN_VAR;
        if (o < TINT_LAST) {
            let at = VARY_TINT * w;
            tint += perlin_split(q, seed + 211 + o) * at;
            vt += at * at * PERLIN_VAR;
        }
        q = q * 2.0;
    }
    let axis = tint_axis();
    let s = vec3<f32>(lum, lum, lum) + axis * tint;
    let v = vec3<f32>(vl, vl, vl) + axis * axis * vt;
    return exp(s - v * 0.5);
}

// The mean of `surface` over the truth under a cell: height N(h, sh^2), and
// the gradient the cell's own (`grad` along one axis) plus N(0, sg^2) along
// each. The height's spread is sh, what the cell does not resolve, with the
// cell's own slope across its width (`cell`, metres): a plane of gradient g
// over a square L wide varies by g^2 L^2 / 12. The shore is a step, which quadrature over the whole normal places
// only to its nearest node (a coast 4 m up read a quarter water), so the
// height splits there: the water takes its share P(h < 0) at its mean depth
// (its colour is linear in depth), the land its share by quadrature over the
// land's quantiles (5 nodes), each with 3 x 3 in the gradient. The land's
// albedo takes the cell's variation factor.
pub fn expected_surface(h: f32, grad: f32, cell: f32, sh: f32, sg: f32, vary: vec3<f32>) -> vec4<f32> {
    var sum = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    let trend = grad * cell;
    let sd = max(sqrt(sh * sh + trend * trend / 12.0), 1e-6);
    let zs = -h / sd;
    let wet = normal_cdf(zs);
    if (wet > 1e-5) {
        let depth = h - sd * 0.3989423 * exp(-0.5 * zs * zs) / wet;
        sum += surface(min(depth, 0.0), 0.0) * wet;
    }
    let dry = 1.0 - wet;
    if (dry > 1e-5) {
        for (var i: i32 = 0; i < 5; i += 1) {
            let nh = gl5(i);
            let height = max(h + sd * normal_quantile(wet + dry * nh.x), 1e-3);
            for (var j: i32 = 0; j < 3; j += 1) {
                let gx = gh3(j);
                for (var k: i32 = 0; k < 3; k += 1) {
                    let gy = gh3(k);
                    let ex = grad + sg * gx.x;
                    let ey = sg * gy.x;
                    let s = surface(height, sqrt(ex * ex + ey * ey));
                    sum += vec4<f32>(s.xyz * vary, 0.0) * (dry * nh.y * gx.y * gy.y);
                }
            }
        }
    }
    return sum;
}

// The gradient (tan of the angle from up) of a surface whose neighbouring
// points across a cell differ by du and dv, at `up`.
pub fn gradient(du: vec3<f32>, dv: vec3<f32>, up: vec3<f32>) -> f32 {
    let cosine = clamp(abs(dot(normalize(cross(du, dv)), up)), 1e-3, 1.0);
    return sqrt(1.0 / (cosine * cosine) - 1.0);
}
