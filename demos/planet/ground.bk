// The planet's ground: one height function of the unit direction, and the
// colour of the truth under a cell. planet.bk's kernels fill tiles with it;
// the tests measure it. GPU code is f32: a direction is an anchor's (anchor.bk,
// its noise lattices found in f64 on the CPU) plus an f32 offset e from it, so
// a cell lands exactly at any scale, Earth radius included.
module planet::ground;

import std::noise::*;
import tiles;
from planet::rivers import water_at, lake_surface, Water;
from planet::climate import Climate, climate_at, cover_at, temp_at, snow_at;
// The ridged relief's octaves and statistics, which the ground's shader
// shares (relief.bk): BASE_WAVELENGTH the first octave's wavelength, metres;
// RIDGE_MEAN E[(1 - |noise|)^2] and NOISE_VAR Var(noise), measured over 200k
// samples; NOISE_GRAD_VAR the variance of the noise's gradient along one axis
// per unit of input.
from planet::relief import BASE_WAVELENGTH, RIDGE_MEAN, NOISE_VAR, NOISE_GRAD_VAR, NOISE_BOX, RIDGE_FIRST, RIDGE_LAST,
    RIDGE_PAST, FINE_FIRST, WARP_OCTAVE, WARP_DISPLACE, ridge_amp, normal_cdf, ridge_cell_mean, span_at, mean_factor, SimplexAt,
    simplex_grad, simplex_f32, simplex_grad_f32, GRAD_TO_VALUE;
from planet::anchor import Anchor, Lattice, PerlinAt, RANGE, VARY_FIRST, STRATA_FOLD, twice, doubled, simplex_from,
    perlin_from, moved, anchor_near;

// Var((1 - |noise|)^2), and the variance of its gradient along one axis per
// unit of input, measured the same way.
const RIDGE_VAR: f32 = 0.0727;
const RIDGE_GRAD_VAR: f32 = 4.586;

// The ground's noise: OpenSimplex2S, which is continuous everywhere. The
// classic simplex (std simplex3d, FastNoise2's) reaches a little past its
// simplex and steps where the lattice's simplices meet: on planes like y = z,
// which every octave shares, so the steps of all of them line up into one
// (a 4 cm ledge along the cube's +Y/+Z edge, seen as a line to the horizon).
//
// It is std supersimplex3d (relief.bk simplex_grad) at a lattice point and
// an offset from it (anchor.bk simplex_from): octave k of lattice l at the
// point `off` from l's point (in the noise's units at l's own octave).
fn noise_on(l: Lattice, k: i32, off: vec3<f32>, seed: i32) -> f32 {
    return simplex_grad(simplex_from(doubled(l, k), off * exp2(k as f32)), seed).x;
}

// A cell holds the mean of the ground over it, not the value at its centre:
// on a crest the centre stands above the mean, in a hollow below it, and
// children's means average to their parent's where centres do not. An
// octave's mean over a cell, given its value at the centre, is that value
// moved toward the octave's mean by a factor (the regression slope) that
// falls as the cell widens: `span` is the cell in the octave's wavelengths,
// exp2(o - octaves) / 2.5 (octaves_for). For a smooth wave the factor is
// 1 - k^2 L^2 / 24 ~ exp(-k^2 L^2 / 24) (the box's Laplacian term); E[k^2]
// along the surface is twice the gradient variance along one axis over the
// variance, which gives NOISE_BOX and RIDGE_BOX per unit of span^2. Measured
// over 100k cells (16 x 16 samples each), the noise holds to it out to a
// cell a wavelength wide; the ridge's crests are kinks, whose gradient is not
// curvature a box removes, so its factor falls by exp(-0.9 span) as cells
// widen. Both within a few hundredths of the measured slopes.
const RIDGE_BOX: f32 = 2.0 * RIDGE_GRAD_VAR / RIDGE_VAR / 24.0;
fn span_of(o: i32, octaves: f32) -> f32 {
    return span_at(o, octaves);
}
fn noise_mean_factor(o: i32, octaves: f32) -> f32 {
    return mean_factor(o, octaves);
}
fn ridge_mean_factor(o: i32, octaves: f32) -> f32 {
    let s = span_of(o, octaves);
    return exp(-RIDGE_BOX * s * s * exp(-0.9 * s));
}
// Octaves past a cell's own carry on until their factor is negligible (a
// cell `NOISE_PAST` octaves finer is 2.3 wavelengths wide, factor 0.003; the
// ridge's 1.1, factor 0.08), the last fading out over its final octave so
// the sum is continuous in `octaves`.
const NOISE_PAST: f32 = 2.5;

// The octaves first to last - 1 of noise on lattice l at `off` from its
// point (the noise's units at octave 0), each at the factor of its mean over
// one of the tile's cells (noise_mean_factor): a tile holds the average of
// what its children hold plus zero-mean detail. Each octave's lattice point
// is the last's doubled (anchor.bk twice), exactly.
fn fbm_to(l: Lattice, off: vec3<f32>, octaves: f32, first: i32, last: i32, seed: i32) -> f32 {
    var sum: f32 = 0.0;
    var amp: f32 = 1.0;
    let past = octaves + NOISE_PAST;
    let n = min(ceil(past) as i32, last);
    var lat = doubled(l, first);
    var d = off * exp2(first as f32);
    for (var o: i32 = first; o < n; o += 1) {
        let w = clamp(past - (o as f32), 0.0, 1.0) * noise_mean_factor(o, octaves);
        sum += simplex_grad(simplex_from(lat, d), seed + o).x * amp * w;
        amp *= 0.5;
        lat = twice(lat);
        d *= 2.0;
    }
    return sum;
}

// The octaves a tile `extent` wide with cells of `inv_size` of its edge can
// carry: down to a wavelength of 2.5 cells (app.js octavesFor, the same).
pub fn octaves_for(extent: f32, inv_size: f32) -> f32 {
    let ratio = BASE_WAVELENGTH / (2.5 * extent * inv_size);
    return clamp(log2(ratio), 1.0, 30.0);
}

// The mountains' relief: ridged octaves RIDGE_FIRST to RIDGE_LAST - 1, each
// (1 - |noise|)^2 less its mean, so two-sided: crests above, valleys and
// basins between, and an octave a tile cannot resolve adds nothing on
// average. The amplitude (metres at full uplift) peaks at octave 8, a 9.4 km
// wavelength, the scale a range is composed at: the broader octaves organise
// the ridges into ranges, the finer fall off by 0.45, a little faster than
// equal slope (0.5), so the slope settles near 33 degrees instead of growing
// with every octave down. They go on to a 2.3 m wavelength: spurs, gullies
// and knolls down to a few metres, where a mountainside stopped at 73 m
// was smooth as a dune from close by. (relief.bk holds them: RIDGE_FIRST,
// RIDGE_LAST, ridge_amp.)
// Where ranges are, their ground is lifted this far (metres): the belt the
// relief stands on.
const UPLIFT: f32 = 2500.0;
// The detail fbm's first amplitude (octave 4), metres: the plains', and
// what the ranges add on top.
const DETAIL_PLAINS: f32 = 250.0;
const DETAIL_RANGES: f32 = 300.0;

// What the octaves finer than a tile's can still add to its surface, in
// metres: the detail fbm (octave 4 up) and the relief, counted from the last
// octave the tile resolves (a peak between its cells), with a quarter more
// for the noise's reach toward 1. Below the continents' octaves it is
// everything (`top`).
pub fn range_margin(octaves: f32, top: f32) -> f32 {
    let k = (floor(octaves) as i32) - 1;
    if (k < 4) { return top; }
    var m: f32 = (DETAIL_PLAINS + DETAIL_RANGES) * 2.0 * exp2(4.0 - (k as f32));
    for (var o: i32 = max(k, RIDGE_FIRST); o < RIDGE_LAST; o += 1) {
        m += ridge_amp(o);
    }
    return m * 1.25;
}

// The shares of an octave's variance that lie inside one of a tile's cells,
// about the cell's value: `f` the octave's mean factor at the cell, `box`
// its k^2 / 24.
//
// within_share: all of it the cell does not hold, 1 - f^2.
fn within_share(f: f32) -> f32 {
    return 1.0 - f * f;
}

// unresolved_share: what is left once the cell's own slope is known too.
// The slope across a cell L wide carries g^2 L^2 / 12, which expected_surface
// counts exactly; as a share of the octave's variance that is 2 box span^2
// of the slope the cell holds (f^2 of it).
fn unresolved_share(f: f32, box: f32, span: f32) -> f32 {
    return max(1.0 - f * f - 2.0 * box * span * span * f * f, 0.0);
}

// gradient_share: the share of an octave's gradient variance a cell's own
// gradient misses. The gradient is a central difference over two cells,
// which passes sinc(2 pi span) of the slope of what the cell holds, so an
// octave near the cells' limit keeps half of it; and the slope varies across
// the cell by about span^2 of its own.
fn gradient_share(f: f32, span: f32) -> f32 {
    let x = 6.2831853 * min(span, 1.0);
    let kept = f * sin(x) / x;
    return min(1.0 - kept * kept + span * span * f * f, 1.0);
}

// E[(X - k)+] for X ~ N(m, s^2): the mean of a ramp over noise a tile
// cannot resolve.
fn ramp_mean(m: f32, s: f32, k: f32) -> f32 {
    if (s < 1e-6) { return max(m - k, 0.0); }
    let z = (m - k) / s;
    return (m - k) * normal_cdf(z) + s * 0.3989423 * exp(-0.5 * z * z);
}

// E[clamp(X, lo, hi)] for X ~ N(m, s^2).
fn clamp_mean(m: f32, s: f32, lo: f32, hi: f32) -> f32 {
    return lo + ramp_mean(m, s, lo) - ramp_mean(m, s, hi);
}

// The broad masks at `off` from the anchor's p (p = dir * radius /
// BASE_WAVELENGTH): x the continents, y what they vary by inside one of the
// tile's cells as Gaussian noise (the coastline clamps take their mean over
// it, so a coarse tile holds what its descendants average to), z where
// mountain ranges rise, w how much is land.
//
// The continents read through a broad warp (octaves 1 and 3: 1200 and
// 300 km wavelengths, displacing up to a few hundred kilometres), which
// bends their coasts into peninsulas, capes and gulfs: unwarped, a coast
// was the zero line of a few smooth octaves, and ran straight for a
// thousand kilometres. Its octaves go on to 6 (a 37 km wavelength), so
// the coast is ragged at every scale a continent is seen at.
const CONTINENT_OCTAVES: i32 = 7;
// Each octave's displacement is one noise's gradient (relief.bk
// GRAD_TO_VALUE), a field per axis at the cost of one.
fn continent_offset(a: Anchor, off: vec3<f32>, seed: i32) -> vec3<f32> {
    let broad = simplex_grad(simplex_from(doubled(a.p, 1), off * 2.0), seed + 420).yzw;
    let fine = simplex_grad(simplex_from(doubled(a.p, 3), off * 8.0), seed + 423).yzw;
    return off + (broad * 0.1 + fine * 0.025) * GRAD_TO_VALUE;
}
// Under them, the continents' own scale: one octave twice the base
// wavelength (about 5000 km), which gathers the land into a few great
// masses with oceans between, where the base octaves alone scattered it
// over the planet in even blobs. At that wavelength f32 directions (half a
// metre) are exact enough to read it without a lattice.
const CONTINENT_SCALE: f32 = 0.55;     // noise cycles per p unit: ~4400 km
const CONTINENT_WEIGHT: f32 = 1.4;
const BELT_SCALE: f32 = 0.8;           // the ranges' belts: ~3000 km
// Lowers the continents field: about a third of the planet is land.
const SEA_SHARE_BIAS: f32 = -0.3;
fn masks(a: Anchor, off: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> vec4<f32> {
    let warped = continent_offset(a, off, seed);
    let p = a.dir * (radius / BASE_WAVELENGTH) + warped;
    let big = simplex_f32(p * CONTINENT_SCALE, seed + 430) * CONTINENT_WEIGHT;
    let continents = big + fbm_to(a.p, warped, octaves, 0, CONTINENT_OCTAVES, seed) + SEA_SHARE_BIAS;
    var unresolved: f32 = 0.0;
    var amp: f32 = 1.0;
    for (var o: i32 = 0; o < CONTINENT_OCTAVES; o += 1) {
        unresolved += amp * amp * NOISE_VAR * within_share(noise_mean_factor(o, octaves));
        amp *= 0.5;
    }
    let sc = sqrt(unresolved);
    let onLand = clamp_mean(continents * 6.0 + 0.3, sc * 6.0, 0.0, 1.0);
    // Ranges stand in belts, as a planet's do along its plates' margins:
    // where a broad noise (~3000 km, warped with the continents) crosses
    // zero, a few hundred kilometres wide and thousands long, broken into
    // chains along their length by a field of the same call (its gradient),
    // with lowlands and plains between.
    let belt = simplex_grad_f32(p * BELT_SCALE, seed + 300);
    let rn = belt.x;
    let gate = belt.y * GRAD_TO_VALUE;
    let ranges = smoothstep(0.8, 0.95, 1.0 - abs(rn)) * smoothstep(-0.35, 0.1, gate);
    return vec4<f32>(continents, sc, ranges, onLand);
}

// The relief reads its octaves through a warp: a smooth displacement (one
// octave of noise per axis at octave WARP_OCTAVE, a 19 km wavelength, twice
// the relief's strongest; about 1.2 km on average, 3 km at most) that bends
// ridgelines off the noise lattice's directions, which otherwise run straight
// and parallel, and breaks the round basins between them into valleys. A
// warp much broader than the relief only moves it. Its largest stretch stays
// short of folding the ground over itself (a displacement gradient of -1).
// Where it compresses the ground a cell spans more of an octave than its
// size says, which the mean factors do not follow. (WARP_OCTAVE and
// WARP_DISPLACE, in p units per unit of noise, are relief.bk's.)
//
// The relief's point at `off` from the anchor's p: off moved by the warp (p
// units), from which the relief's octaves run on the p lattice.
pub fn relief_offset(a: Anchor, off: vec3<f32>, seed: i32) -> vec3<f32> {
    let at = simplex_from(doubled(a.p, WARP_OCTAVE), off * exp2(WARP_OCTAVE as f32));
    let warp = vec3<f32>(simplex_grad(at, seed + 400).x, simplex_grad(at, seed + 401).x, simplex_grad(at, seed + 402).x);
    return off + warp * WARP_DISPLACE;
}

// The relief at `off`, metres at full uplift: the ridged octaves, each its
// mean over one of the tile's cells (relief.bk ridge_cell_mean) less the
// ridge's mean. x the octaves below FINE_FIRST, y those from it on: the
// ground's fine relief (a 1.2 km wavelength on), spurs, gullies and knolls,
// which a valley's sides carry on (terrain) instead of being planed away.
fn relief(a: Anchor, off: vec3<f32>, octaves: f32, seed: i32) -> vec2<f32> {
    let n = min(ceil(octaves + RIDGE_PAST) as i32, RIDGE_LAST);
    if (n <= RIDGE_FIRST) { return vec2<f32>(0.0, 0.0); }
    var lat = doubled(a.p, RIDGE_FIRST);
    var d = relief_offset(a, off, seed) * exp2(RIDGE_FIRST as f32);
    var broad: f32 = 0.0;
    var fine: f32 = 0.0;
    let past = octaves + RIDGE_PAST;
    for (var o: i32 = RIDGE_FIRST; o < n; o += 1) {
        let fade = clamp(past - (o as f32), 0.0, 1.0);
        let mean = ridge_cell_mean(simplex_grad(simplex_from(lat, d), seed + 100 + o).x, noise_mean_factor(o, octaves));
        let v = (mean - RIDGE_MEAN) * ridge_amp(o) * fade;
        if (o < FINE_FIRST) { broad += v; } else { fine += v; }
        lat = twice(lat);
        d *= 2.0;
    }
    return vec2<f32>(broad, fine);
}

// The anchor's offset e in p units.
fn p_offset(e: vec3<f32>, radius: f32) -> vec3<f32> {
    return e * (radius / BASE_WAVELENGTH);
}

// The ground before the water cuts it, metres above the sphere at offset e
// from the anchor's direction: x its broad shape, y the fine relief over it
// (FINE_FIRST). Continents from the broad octaves, ranges where a broad mask
// allows them on land (lifted, and carrying the ridged relief), and the fine
// octaves over both, rougher in the ranges. z the uplift, which scales the
// relief.
pub fn terrain_parts(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> vec3<f32> {
    return terrain_parts_over(a, e, masks(a, p_offset(e, radius), radius, octaves, seed), radius, octaves, seed);
}
// The same over masks `m` already read: a supersampled cell reads them once
// at its centre, at its own octaves, where they are the mean over the cell
// (their finest octave is tens of kilometres; the coast's clamps take their
// mean over the rest, masks y).
fn terrain_parts_over(a: Anchor, e: vec3<f32>, m: vec4<f32>, radius: f32, octaves: f32, seed: i32) -> vec3<f32> {
    let off = p_offset(e, radius);
    let land = clamp_mean(m.x * 3.0 + 0.15, m.y * 3.0, -1.0, 1.0);
    let uplift = m.z * m.w;
    let r = relief(a, off, octaves, seed);
    let amp = DETAIL_PLAINS + DETAIL_RANGES * uplift;
    let broad = fbm_to(a.p, off, octaves, 4, FINE_FIRST, seed + 200);
    let fine = fbm_to(a.p, off, octaves, FINE_FIRST, 64, seed + 200) * exp2((4 - FINE_FIRST) as f32);
    return vec3<f32>(land * 1100.0 + uplift * (UPLIFT + r.x) + broad * amp, uplift * r.y + fine * amp, uplift);
}
pub fn terrain_base(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> f32 {
    let t = terrain_parts(a, e, radius, octaves, seed);
    return t.x + t.y;
}
// The same at a direction known only to f32 (anchor.bk anchor_near): for the
// clouds' and the rivers' coarse work, good to about a metre.
pub fn terrain_base_near(dir: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> f32 {
    return terrain_base(anchor_near(dir, radius), vec3<f32>(0.0), radius, octaves, seed);
}

// The width of a cell that carries `octaves` (octaves_for, inverted).
pub fn cell_width(octaves: f32) -> f32 {
    return BASE_WAVELENGTH / (2.5 * exp2(octaves));
}

// The ground at offset e, metres above the sphere, or the water over it: the
// ground cut down by the rivers' valleys (rivers.bk), and a lake's level
// where it stands over that. A valley cuts the broad shape, and its sides
// carry the fine relief on, faded out over the last VALLEY_FLOOR metres down
// to its bed: a valley side planed to its profile would be a smooth ramp,
// straight along its reach, and meet the ground in a crease. A smooth
// minimum over CUT_BLEND metres joins the cut to the ground.
const VALLEY_FLOOR: f32 = 150.0;
const CUT_BLEND: f32 = 40.0;
//
// y and z: how much the ground here moves with the relief's octaves below
// FINE_FIRST and from it on, per metre of relief at full uplift (relief):
// the uplift where the ground stands, less where a valley cuts it (the
// fine part as its sides carry it on), none under a lake. The ground's
// shader scales the octaves finer than its texels by them (ground_mesh.bk).
pub fn terrain_shaped(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> vec3<f32> {
    return shaped_by(terrain_parts(a, e, radius, octaves, seed), water_at(a.dir, e, radius, cell_width(octaves), net, seed));
}
// The ground's parts (terrain_parts) cut by the water w found for them.
fn shaped_by(t: vec3<f32>, w: Water) -> vec3<f32> {
    let h = t.x + t.y;
    let side = smoothstep(0.0, VALLEY_FLOOR, w.near.x - w.bed);
    let valley = w.near.x + t.y * side;
    let x = h - valley;
    let m = max(CUT_BLEND - abs(x), 0.0) / CUT_BLEND;
    let cut = min(h, valley - m * m * CUT_BLEND * 0.25);
    let lake = lake_surface(cut, w);
    if (lake > cut) { return vec3<f32>(lake, 0.0, 0.0); }
    let u = t.z;
    if (cut >= h) { return vec3<f32>(cut, t.z, t.z); }
    // On the cut: d cut / d h and d cut / d valley.
    let sx = x >= 0.0 ? 1.0 : -1.0;
    let dh = 0.5 * m * sx;
    return vec3<f32>(cut, u * dh, u * (dh + (1.0 - dh) * side));
}
pub fn terrain(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    return terrain_shaped(a, e, radius, octaves, seed, net).x;
}

// Whether the ground holds soil, grass and trees or lies bare as rock is
// its slope over tens of metres, not over the bumps of a metre: soil creeps
// and settles over those, and a meadow's hummocks are as steep as a cliff.
// The soil's slope is the ground's through SOIL_OCTAVES (wavelengths down
// to about 37 m), decided there once, so every scale reads the same rock:
// a cell finer than that takes it at its point (soil_gradient), a coarser
// one the share of it under the cell (spread to SOIL_OCTAVES).
pub const SOIL_OCTAVES: f32 = 17.0;
// The ground through SOIL_OCTAVES at offset e, its water's cut included.
pub fn soil_height(a: Anchor, e: vec3<f32>, radius: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    let w = water_at(a.dir, e, radius, cell_width(SOIL_OCTAVES), net, seed);
    return shaped_by(terrain_parts(a, e, radius, SOIL_OCTAVES, seed), w).x;
}
pub fn soil_gradient(a: Anchor, e: vec3<f32>, radius: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    let n = a.dir + e;
    let axis = abs(n.y) < 0.9 ? vec3<f32>(0.0, 1.0, 0.0) : vec3<f32>(1.0, 0.0, 0.0);
    let t1 = normalize(cross(n, axis));
    let t2 = cross(n, t1);
    let step: f32 = 2.0;   // metres either side
    let w = water_at(a.dir, e, radius, cell_width(SOIL_OCTAVES), net, seed);
    let k = step / radius;
    let hu = shaped_by(terrain_parts(a, moved(a.dir, e, t1 * k), radius, SOIL_OCTAVES, seed), w).x
           - shaped_by(terrain_parts(a, moved(a.dir, e, -t1 * k), radius, SOIL_OCTAVES, seed), w).x;
    let hv = shaped_by(terrain_parts(a, moved(a.dir, e, t2 * k), radius, SOIL_OCTAVES, seed), w).x
           - shaped_by(terrain_parts(a, moved(a.dir, e, -t2 * k), radius, SOIL_OCTAVES, seed), w).x;
    return sqrt(hu * hu + hv * hv) / (2.0 * step);
}

// Below this many octaves a cell is wide enough that the next octaves vary
// a lot inside it, through the coastline clamps and the ridges: such a cell
// averages SUB x SUB samples taken with two more octaves instead of reading
// one, so it is the aggregate of the finer truth, not a guess at it.
const SUPERSAMPLE_BELOW: f32 = 7.0;
const SUB: i32 = 4;

// A tile's point at (s, t) of its frame: its offset from the anchor's
// direction (the tile's record, tiles.bk).
pub fn frame_dir(rec: tiles::Record, s: f32, t: f32) -> vec3<f32> {
    return rec.dir_lo + tiles::sphere_offset(rec, tiles::frame_offset(rec, s, t));
}

// The height a cell holds: at (s, t) of the tile's frame, `cell` wide in
// (s, t).
pub fn cell_height(a: Anchor, rec: tiles::Record, s: f32, t: f32, cell: f32,
                   radius: f32, octaves: f32, seed: i32, net: read_store<f32, 1>) -> f32 {
    if (octaves >= SUPERSAMPLE_BELOW) {
        return terrain(a, frame_dir(rec, s, t), radius, octaves, seed, net);
    }
    let w = water_at(a.dir, frame_dir(rec, s, t), radius, cell_width(octaves), net, seed);
    let m = masks(a, p_offset(frame_dir(rec, s, t), radius), radius, octaves, seed);
    var sum: f32 = 0.0;
    for (var j: i32 = 0; j < SUB; j += 1) {
        for (var i: i32 = 0; i < SUB; i += 1) {
            let ds = (((i as f32) + 0.5) / (SUB as f32) - 0.5) * cell;
            let dt = (((j as f32) + 0.5) / (SUB as f32) - 0.5) * cell;
            sum += shaped_by(terrain_parts_over(a, frame_dir(rec, s + ds, t + dt), m, radius, octaves + 2.0, seed), w).x;
        }
    }
    return sum / ((SUB * SUB) as f32);
}

// ── Colour ──────────────────────────────────────────────────────────────────
//
// A cell's colour is the mean colour of the truth under it, not the colour
// of its mean: snow-capped peaks over green valleys read from orbit as the
// mix they are. The truth under a cell is modelled as its own height and
// gradient plus Gaussian spreads from the octaves it does not resolve.

// What the truth under a cell varies by about the cell's own values: x the
// height (m) the cell's slope does not account for, y the gradient along
// either axis (m/m). Each octave counts by unresolved_share in height and
// gradient_share in gradient, down to `truth`, the finest octaves anything
// draws. With gain 0.5 and lacunarity 2 every octave adds the same slope,
// so the fine octaves matter to the gradient as much as the broad ones.
pub fn spread(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, truth: f32, seed: i32) -> vec2<f32> {
    let m = masks(a, p_offset(e, radius), radius, octaves, seed);
    // The continents through the coastline clamp, which passes them where
    // it is linear: 1100 * 3 metres of height per unit of noise.
    let mc = m.x * 3.0 + 0.15;
    let sc = max(m.y * 3.0, 1e-6);
    let land = 3300.0 * (normal_cdf((1.0 - mc) / sc) - normal_cdf((-1.0 - mc) / sc));
    var ch: f32 = 0.0;
    var cg: f32 = 0.0;
    var amp: f32 = 1.0;
    for (var o: i32 = 0; o < CONTINENT_OCTAVES; o += 1) {
        let f = noise_mean_factor(o, octaves);
        let s = span_of(o, octaves);
        ch += amp * amp * NOISE_VAR * unresolved_share(f, NOISE_BOX, s);
        cg += NOISE_GRAD_VAR * gradient_share(f, s);   // amplitude * frequency = 1
        amp *= 0.5;
    }
    // The relief, in metres already (ridge_amp), under the uplift.
    let mount = m.z * m.w;
    var rh: f32 = 0.0;
    var rg: f32 = 0.0;
    for (var o: i32 = RIDGE_FIRST; o < RIDGE_LAST; o += 1) {
        let f = ridge_mean_factor(o, octaves) * clamp(octaves + RIDGE_PAST - (o as f32), 0.0, 1.0);
        let s = span_of(o, octaves);
        let ra = ridge_amp(o);
        let rf = ra * exp2(o as f32);   // amplitude * frequency
        let w = clamp(truth - (o as f32), 0.0, 1.0);
        rh += ra * ra * RIDGE_VAR * unresolved_share(f, RIDGE_BOX, s) * w * w;
        rg += rf * rf * RIDGE_GRAD_VAR * gradient_share(f, s) * w * w;
    }
    // The detail, octave 4 up at amplitude 0.5^(o - 4), to the truth's last.
    let detail = DETAIL_PLAINS + DETAIL_RANGES * mount;
    var dh: f32 = 0.0;
    var dg: f32 = 0.0;
    amp = 1.0;
    let n = ceil(truth) as i32;
    for (var o: i32 = 4; o < n; o += 1) {
        let w = clamp(truth - (o as f32), 0.0, 1.0);
        let f = noise_mean_factor(o, octaves) * clamp(octaves + NOISE_PAST - (o as f32), 0.0, 1.0);
        let s = span_of(o, octaves);
        dh += amp * amp * NOISE_VAR * unresolved_share(f, NOISE_BOX, s) * w * w;
        dg += 256.0 * NOISE_GRAD_VAR * gradient_share(f, s) * w * w;   // amplitude * frequency = 16
        amp *= 0.5;
    }
    let h2 = land * land * ch + mount * mount * rh + detail * detail * dh;
    let wl = BASE_WAVELENGTH;
    let g2 = (land * land * cg + mount * mount * rg + detail * detail * dg) / (wl * wl);
    return vec2<f32>(sqrt(h2), sqrt(g2));
}

// Water's colour: the sea bed seen through the water, down and back up
// (clear ocean water's attenuation, red lost in a few metres and blue
// carrying tens), over what the water itself sends back where the bed is
// too deep to see.
const DEEP_WATER = vec3<f32>(0.004, 0.017, 0.040);
const SEA_BED = vec3<f32>(0.40, 0.36, 0.27);
const WATER_ATTENUATION = vec3<f32>(0.40, 0.065, 0.032);   // per metre

// Fresh water's colour, `depth` metres deep: a lake's or a river's silt and
// leaf litter seen the same way, through water whose dissolved organic
// matter takes the blue and whose algae the red, so it carries green and
// brown a metre or two and is dark beyond (Kirk, Light and Photosynthesis
// in Aquatic Ecosystems): darker than the land around it from above, as
// lakes are, where the sea is blue.
const LAKE_WATER = vec3<f32>(0.006, 0.011, 0.009);
const LAKE_BED = vec3<f32>(0.13, 0.11, 0.07);
const LAKE_ATTENUATION = vec3<f32>(0.55, 0.30, 0.65);   // per metre
pub fn fresh_water(depth: f32) -> vec3<f32> {
    let through = exp(LAKE_ATTENUATION * (-2.0 * depth));
    return mix(LAKE_WATER, LAKE_BED, through);
}

// The ground at one height and gradient (tan of the angle from up): its
// albedo, and w = 1 for water.
pub fn surface(h: f32, grad: f32, c: Climate) -> vec4<f32> {
    return bedded_surface(h, grad, 0.0, c);
}

// Bedded rock: a cliff's face shows its beds as bands, lighter and warmer
// ones (sandstone, limestone) between darker ones (shale), each bed level
// along a surface folded by low-frequency noise, so the bands follow the
// strata rather than the contours. Three scales of bed, each gradient noise
// along the height on the fold (a line through the lattice, so the beds'
// thicknesses and tones are irregular, not a cosine's even stripes), in
// log-luminance at an amplitude of its deviation. Over a texel whose
// heights spread by sd, an octave of wavelength L averages to about itself
// times exp(-(2 pi sd / L)^2 / 2) (a sinusoid's mean under a normal), so a
// bed fades out where the texel spans it, and the far ground keeps the
// beds' mean. (The folds' wavelength, STRATA_FOLD metres, is anchor.bk's.)
const STRATA_FOLD_HEIGHT: f32 = 1600.0;   // the folds' height, per unit of noise
const STRATA_L0: f32 = 9.0;
const STRATA_L1: f32 = 41.0;
const STRATA_L2: f32 = 130.0;
const STRATA_A0: f32 = 0.10;
const STRATA_A1: f32 = 0.16;
const STRATA_A2: f32 = 0.18;

fn strata_band(level: f32, length: f32, track: f32, sd: f32, seed: i32) -> f32 {
    let n = perlin_f32(vec3<f32>(level / length, track, 0.5 * track), seed);
    let t = 6.2831853 * sd / length;
    return n / sqrt(PERLIN_VAR) * exp(-0.5 * t * t);
}

pub fn strata(a: Anchor, e: vec3<f32>, radius: f32, h: f32, sd: f32, seed: i32) -> f32 {
    let fold = perlin_at(perlin_from(a.f, e * (radius / STRATA_FOLD)), seed + 307) * STRATA_FOLD_HEIGHT;
    let level = h + fold;
    return STRATA_A0 * strata_band(level, STRATA_L0, 0.37, sd, seed + 311)
         + STRATA_A1 * strata_band(level, STRATA_L1, 0.61, sd, seed + 313)
         + STRATA_A2 * strata_band(level, STRATA_L2, 0.29, sd, seed + 317);
}

// surface with the rock's beds at `bed` (strata, log-luminance).
pub fn bedded_surface(h: f32, grad: f32, bed: f32, cl: Climate) -> vec4<f32> {
    if (h <= 0.0) {
        let through = exp(WATER_ATTENUATION * (2.0 * h));
        return vec4<f32>(mix(DEEP_WATER, SEA_BED, through), 1.0);
    }
    // Beach at the shore; the climate's cover (climate.bk: desert, steppe,
    // savanna, grassland, forest, tundra by temperature and moisture) up to
    // the treeline, alpine meadow above it, bare scree higher still, snow
    // where it is cold enough; the region's rock wherever the ground is too
    // steep to hold soil (from about 38 degrees), snow where it is not too
    // steep to hold snow.
    let slope = 1.0 - 1.0 / sqrt(1.0 + grad * grad);
    let t = temp_at(cl, h);
    let beach = mix(vec3<f32>(0.50, 0.45, 0.34), cl.sand, 0.5);
    let cover = cover_at(cl, h);
    let alpine = mix(vec3<f32>(0.16, 0.17, 0.09), vec3<f32>(0.24, 0.21, 0.15), 1.0 - smoothstep(0.2, 0.5, cl.moist));
    let rock = cl.rock * exp(bed) + vec3<f32>(0.03, 0.012, -0.012) * bed;
    let snow = vec3<f32>(0.92, 0.94, 0.97);
    var c = mix(beach, cover.colour, smoothstep(1.0, 4.0, h));
    // Above the trees: alpine meadow, then scree.
    c = mix(c, alpine, (1.0 - smoothstep(-4.0, 0.0, t)) * smoothstep(0.15, 0.35, cl.moist));
    c = mix(c, rock, max(smoothstep(0.2, 0.4, slope), 1.0 - smoothstep(-8.0, -4.5, t)));
    c = mix(c, snow, snow_at(cl, h) * (1.0 - smoothstep(0.35, 0.6, slope)));
    return vec4<f32>(c, 0.0);
}

// The share of the ground at one height and gradient that grows grass (the
// grass blades' density, demos/planet/grass.js): surface's land past the
// beach, less the rock and the snow it lays over it.
pub fn grass_cover(h: f32, grad: f32, cl: Climate) -> f32 {
    if (h <= 0.0) { return 0.0; }
    let slope = 1.0 - 1.0 / sqrt(1.0 + grad * grad);
    var c = smoothstep(1.0, 4.0, h) * cover_at(cl, h).grass;
    c *= 1.0 - max(smoothstep(0.2, 0.4, slope), 1.0 - smoothstep(-8.0, -4.5, temp_at(cl, h)));
    c *= 1.0 - snow_at(cl, h) * (1.0 - smoothstep(0.35, 0.6, slope));
    return c;
}

// The sun's disc over the terrain from the ground at offset e: the highest
// the ground rises toward the sun, out to 1.8 km at SUN_STEPS steps 1.3
// apart, against the sun's elevation, over the disc's 0.53 degrees. The
// steps are independent, so a kernel takes them in parallel
// (sun_step_height) and another gathers them (sun_seen). Far steps read
// coarser octaves: what is finer than the step does not cast its shadow.
pub const SUN_STEPS: i32 = 28;
pub fn sun_step_dist(k: i32) -> f32 { return 1.5 * pow(1.3, k as f32); }

// The ground's height (sea level and up) at step k toward the sun.
pub fn sun_step_height(a: Anchor, e: vec3<f32>, toSun: vec3<f32>, k: i32, radius: f32, octaves: f32, seed: i32,
                       net: read_store<f32, 1>) -> f32 {
    let n = a.dir + e;
    let sunUp = dot(toSun, n);
    let level = normalize(toSun - n * sunUp);
    let dist = sun_step_dist(k);
    let q = moved(a.dir, e, level * (dist / radius));
    let o = max(octaves - log2(max(dist, 1.0)) * 0.7, 8.0);
    return max(terrain(a, q, radius, o, seed, net), 0.0);
}

// The share of the disc seen from `up` over ground rising to the angle
// `highest` (the largest of sun_step_angle's).
pub fn sun_elevation_seen(up: vec3<f32>, toSun: vec3<f32>, highest: f32) -> f32 {
    let sunUp = dot(toSun, up);
    if (sunUp <= -0.01) { return 0.0; }
    let sunElev = asin(clamp(sunUp, -1.0, 1.0));
    return clamp((sunElev - highest) / 0.0093 + 0.5, 0.0, 1.0);
}

// Step k's elevation angle seen from `h` up: above the point's tangent
// plane, the sphere's fall included.
pub fn sun_step_angle(h: f32, hk: f32, k: i32, radius: f32) -> f32 {
    let dist = sun_step_dist(k);
    let rise = hk - max(h, 0.0) - dist * dist / (2.0 * radius);
    return atan(rise / dist);
}

// The share of the ground at one height and gradient under forest (the
// trees' density, demos/planet/trees.js): surface's forest band, less the
// rock and the snow it lays over it. Where the trees are not drawn the
// ground shader lays their average over surface's floor by this share
// (expected_cover, over a texel).
pub fn tree_cover(h: f32, grad: f32, cl: Climate) -> f32 {
    if (h <= 0.0) { return 0.0; }
    let slope = 1.0 - 1.0 / sqrt(1.0 + grad * grad);
    var c = smoothstep(4.0, 30.0, h) * cover_at(cl, h).forest;
    c *= 1.0 - smoothstep(0.2, 0.4, slope);
    c *= 1.0 - snow_at(cl, h);
    return c;
}

// The z with normal_cdf(z) = u: normal_cdf's tanh inverted, then its cubic
// solved by Newton from the linear guess (it is nearly linear, so three
// steps reach f32).
fn normal_quantile(u: f32) -> f32 {
    let x = clamp(2.0 * u - 1.0, -0.999999, 0.999999);
    let y = 0.5 * log((1.0 + x) / (1.0 - x)) / 0.7978846;
    var z = y;
    for (var i: i32 = 0; i < 3; i += 1) {
        z -= (z + 0.044715 * z * z * z - y) / (1.0 + 0.134145 * z * z);
    }
    return z;
}

// Gauss-Legendre nodes and weights on [0, 1]: x node, y weight.
fn gl5(i: i32) -> vec2<f32> {
    if (i == 0) { return vec2<f32>(0.0469101, 0.1184634); }
    if (i == 1) { return vec2<f32>(0.2307653, 0.2393143); }
    if (i == 2) { return vec2<f32>(0.5, 0.2844444); }
    if (i == 3) { return vec2<f32>(0.7692347, 0.2393143); }
    return vec2<f32>(0.9530899, 0.1184634);
}
// Gauss-Hermite nodes and weights for N(0, 1): x node, y weight.
fn gh3(i: i32) -> vec2<f32> {
    if (i == 0) { return vec2<f32>(-1.7320508, 0.1666667); }
    if (i == 1) { return vec2<f32>(0.0, 0.6666667); }
    return vec2<f32>(1.7320508, 0.1666667);
}

// The land's albedo varies in patches, lighter and darker, more and less ochre,
// at every scale from octave VARY_FIRST down, with equal contrast in each
// octave: log-normal factors on the albedo, independent of the height. A
// cell takes the octaves it resolves (the last weighted by its fraction),
// exp(S - var(S) / 2), which is the mean of the factor over all the octaves
// below, so a cell's factor is the average of its children's. The ground
// shader carries the octaves finer than any tile on per pixel. (VARY_FIRST
// is anchor.bk's: the anchor holds its lattice.)
// Var(perlin_at), measured over 200k samples.
const PERLIN_VAR: f32 = 0.0728;
const VARY_LUM: f32 = 0.11;    // log-luminance, per octave
const VARY_TINT: f32 = 0.05;   // ochre (tint_axis, log per channel), per octave
// Toward ochre and straw one way and deeper green the other; blue kept, as
// its share of the light does not swing between a dry patch and a lush one.
fn tint_axis() -> vec3<f32> { return vec3<f32>(1.0, 0.4, 0.0); }
const TINT_LAST: i32 = 20;
// Over a few metres to a few hundred (octaves 13 to 19, 290 m to 4.6 m)
// the patches are stronger: a meadow's clumps of other grasses and herbs,
// its dry straw beside lush green, where the variance of a grassland's
// greenness lies (remote sensing of grassland finds most of it at these
// scales); coarser the land is a region's, finer a sward's blades.
const PATCH_FIRST: i32 = 13;
const PATCH_LAST: i32 = 19;
const PATCH_LUM: f32 = 0.30;
const PATCH_TINT: f32 = 0.16;
const PATCH_CORR: f32 = 0.7;
const PATCH_CORR_REST: f32 = 0.71414;   // sqrt(1 - PATCH_CORR^2)
fn lum_amp(o: i32) -> f32 {
    if (o >= PATCH_FIRST && o <= PATCH_LAST) { return PATCH_LUM; }
    return VARY_LUM;
}
fn tint_amp(o: i32) -> f32 {
    if (o >= PATCH_FIRST && o <= PATCH_LAST) { return PATCH_TINT; }
    return VARY_TINT;
}

// Perlin noise at a lattice cell and the offset in it (anchor.bk
// perlin_from), or at an f32 point (perlin_f32: the strata's bands, the
// clouds' octaves, coarse beside f32's step there).
pub fn perlin_f32(q: vec3<f32>, seed: i32) -> f32 {
    let c = floor(q);
    return perlin_at(PerlinAt { cell: vec3<i32>(c.x as i32, c.y as i32, c.z as i32), f: q - c }, seed);
}
pub fn perlin_at(at: PerlinAt, seed: i32) -> f32 {
    let xf0 = at.f.x;
    let yf0 = at.f.y;
    let zf0 = at.f.z;
    let x0: i32 = at.cell.x * PRIME_X;
    let y0: i32 = at.cell.y * PRIME_Y;
    let z0: i32 = at.cell.z * PRIME_Z;
    let x1: i32 = x0 + PRIME_X;
    let y1: i32 = y0 + PRIME_Y;
    let z1: i32 = z0 + PRIME_Z;
    let xf1 = xf0 - 1.0;
    let yf1 = yf0 - 1.0;
    let zf1 = zf0 - 1.0;
    let u = interp_quintic<f32>(xf0);
    let v = interp_quintic<f32>(yf0);
    let w = interp_quintic<f32>(zf0);
    let g0 = mix(mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y0, z0), xf0, yf0, zf0),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y0, z0), xf1, yf0, zf0), u),
                 mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y1, z0), xf0, yf1, zf0),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y1, z0), xf1, yf1, zf0), u), v);
    let g1 = mix(mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y0, z1), xf0, yf0, zf1),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y0, z1), xf1, yf0, zf1), u),
                 mix(grad_dot_common3d<f32>(hash_primes3d(seed, x0, y1, z1), xf0, yf1, zf1),
                     grad_dot_common3d<f32>(hash_primes3d(seed, x1, y1, z1), xf1, yf1, zf1), u), v);
    return mix(g0, g1, w);
}

pub fn variation(a: Anchor, e: vec3<f32>, radius: f32, octaves: f32, seed: i32) -> vec3<f32> {
    var lat = a.v;
    var d = p_offset(e, radius) * exp2(VARY_FIRST as f32);
    var lum: f32 = 0.0;
    var tint: f32 = 0.0;
    var vl: f32 = 0.0;
    var vt: f32 = 0.0;
    let n = ceil(octaves) as i32;
    for (var o: i32 = VARY_FIRST; o < n; o += 1) {
        let pa = perlin_from(lat, d);
        let w = clamp(octaves - (o as f32), 0.0, 1.0);
        let al = lum_amp(o) * w;
        let nl = perlin_at(pa, seed + 101 + o);
        lum += nl * al;
        vl += al * al * PERLIN_VAR;
        if (o < TINT_LAST) {
            let at = tint_amp(o) * w;
            // A meadow's light patches are its dry ones, straw, and its dark
            // ones lush: in the patch octaves the tint follows the
            // luminance at a correlation of PATCH_CORR (its variance kept).
            var nt = perlin_at(pa, seed + 211 + o);
            if (o >= PATCH_FIRST && o <= PATCH_LAST) { nt = PATCH_CORR * nl + PATCH_CORR_REST * nt; }
            tint += nt * at;
            vt += at * at * PERLIN_VAR;
        }
        lat = twice(lat);
        d *= 2.0;
    }
    let axis = tint_axis();
    let s = vec3<f32>(lum, lum, lum) + axis * tint;
    let v = vec3<f32>(vl, vl, vl) + axis * axis * vt;
    return exp(s - v * 0.5);
}

// The mean of `surface` over the truth under a cell: height N(h, sh^2), and
// the soil's gradient its own (soil.x along one axis) plus N(0, soil.y^2)
// along each. The height's spread is sh, what the cell does not resolve, with the
// cell's own slope across its width (`cell`, metres): a plane of gradient g
// over a square L wide varies by g^2 L^2 / 12. The shore is a step, which
// quadrature over the whole normal places only to its nearest node (a coast
// 4 m up read a quarter water), so the height splits there: the water takes
// its share P(h < 0) by quadrature over the water's quantiles (5 nodes), the
// land its share the same over the land's, each with 3 x 3 in the gradient.
// The land's albedo takes the cell's variation factor, its rock the beds'
// mean over the cell (`bed`, strata). The rock and snow are by the soil's
// slope (SOIL_OCTAVES): `soil` its gradient and spread, which for a cell
// finer than the soil's scale are its point's and 0.
pub fn expected_surface(h: f32, grad: f32, cell: f32, sh: f32, soil: vec2<f32>, vary: vec3<f32>, bed: f32,
                        cl: Climate) -> vec4<f32> {
    var sum = vec4<f32>(0.0, 0.0, 0.0, 0.0);
    let trend = grad * cell;
    let sd = max(sqrt(sh * sh + trend * trend / 12.0), 1e-6);
    let zs = -h / sd;
    let wet = normal_cdf(zs);
    if (wet > 1e-5) {
        for (var i: i32 = 0; i < 5; i += 1) {
            let nh = gl5(i);
            let depth = min(h + sd * normal_quantile(wet * nh.x), 0.0);
            sum += surface(depth, 0.0, cl) * (wet * nh.y);
        }
    }
    let dry = 1.0 - wet;
    if (dry > 1e-5) {
        for (var i: i32 = 0; i < 5; i += 1) {
            let nh = gl5(i);
            let height = max(h + sd * normal_quantile(wet + dry * nh.x), 1e-3);
            for (var j: i32 = 0; j < 3; j += 1) {
                let gx = gh3(j);
                for (var k: i32 = 0; k < 3; k += 1) {
                    let gy = gh3(k);
                    let ex = soil.x + soil.y * gx.x;
                    let ey = soil.y * gy.x;
                    let s = bedded_surface(height, sqrt(ex * ex + ey * ey), bed, cl);
                    sum += vec4<f32>(s.xyz * vary, 0.0) * (dry * nh.y * gx.y * gy.y);
                }
            }
        }
    }
    return sum;
}

// tree_cover's mean over a cell, by expected_surface's quadrature over the
// heights and soil gradients the cell holds.
pub fn expected_cover(h: f32, grad: f32, cell: f32, sh: f32, soil: vec2<f32>, cl: Climate) -> f32 {
    let trend = grad * cell;
    let sd = max(sqrt(sh * sh + trend * trend / 12.0), 1e-6);
    let wet = normal_cdf(-h / sd);
    let dry = 1.0 - wet;
    var sum: f32 = 0.0;
    if (dry > 1e-5) {
        for (var i: i32 = 0; i < 5; i += 1) {
            let nh = gl5(i);
            let height = max(h + sd * normal_quantile(wet + dry * nh.x), 1e-3);
            for (var j: i32 = 0; j < 3; j += 1) {
                let gx = gh3(j);
                for (var k: i32 = 0; k < 3; k += 1) {
                    let gy = gh3(k);
                    let ex = soil.x + soil.y * gx.x;
                    let ey = soil.y * gy.x;
                    sum += tree_cover(height, sqrt(ex * ex + ey * ey), cl) * (dry * nh.y * gx.y * gy.y);
                }
            }
        }
    }
    return sum;
}

// The gradient (tan of the angle from up) of a surface whose neighbouring
// points across a cell differ by du and dv, at `up`.
pub fn gradient(du: vec3<f32>, dv: vec3<f32>, up: vec3<f32>) -> f32 {
    let cosine = clamp(abs(dot(normalize(cross(du, dv)), up)), 1e-3, 1.0);
    return sqrt(1.0 / (cosine * cosine) - 1.0);
}
