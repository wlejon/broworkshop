// The planet's kernels: each tile's cells from the ground (ground.bk). The
// tile kernels produce a whole batch in one dispatch (bro.tiles' produce):
// grid z is the tile's record in the batch table (tiles-api.js, read by
// tiles::record), whose slot says where in the pools, viewed as [cells,
// cells, capacity], it goes, and the tile's anchor in `anchors` (anchor.bk:
// its noise lattices, found on the CPU in f64 by k_anchors). A cell's point
// is the anchor's direction and its offset from it (ground.bk frame_dir),
// in f32.
from planet::ground import terrain, terrain_parts, shaped_by, cell_ground_drained, spread, expected_surface, expected_cover,
                           gradient, variation, strata, octaves_for, range_margin, relief_offset, frame_dir,
                           SOIL_OCTAVES, cell_width, woodland, wooded, banked, with_streams;
from planet::climate import climate_fields, climate_of, cover_at, snow_at, Climate, landform_climate, landform_wood,
                            landform_share;
from planet::relief import BASE_WAVELENGTH, RIDGE_FIRST, WARP_OCTAVE, WARP_DISPLACE, simplex_grad, SimplexAt;
from planet::rivers import water_at, water_share, fresh_water, water_depth;
from planet::anchor import Anchor, read_anchor, write_anchor, anchor_of, anchor_at, doubled, simplex_from, plane_offset;
from planet::dendry_grid import grid_reach_point, grid_holds, grid_point, grid_link, level_part, drain_parts, texel_cell,
    horizon_cell, window_point, window_link, window_part;
from planet::dendry import drain_held, dryness;
import tiles;

// The batch's drainage grids (dendry_grid.bk), before anything reads them:
// the rivers' reaches about each tile into `reaches`, then a level at a time
// from the coarsest each point's potential into `pots` and each point's
// segment into `segs` from them.
@kernel @grid(3)
fn k_drain_reaches(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                   reaches: write_store<vec4<f32>, 1>, radius: f32, inv_size: f32, d: f32, net: read_store<f32, 1>) {
    grid_reach_point(reaches, net, read_anchor(anchors, g.z()), tiles::record(table, g.z()), g.z(), g.x(), g.y(),
                     radius, inv_size, d);
}
@kernel @grid(3)
fn k_drain_points(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                  pots: write_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>, reaches: read_store<vec4<f32>, 1>,
                  radius: f32, inv_size: f32, d: f32, level: i32, tiles: i32, seed: i32) {
    grid_point(pots, segs, reaches, read_anchor(anchors, g.z()), tiles::record(table, g.z()), level, g.z(), tiles,
               g.x(), g.y(), radius, inv_size, d, seed);
}
@kernel @grid(3)
fn k_drain_links(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                 segs: write_store<vec4<f32>, 1>, pots: read_store<vec4<f32>, 1>, radius: f32, inv_size: f32,
                 d: f32, level: i32, tiles: i32, seed: i32) {
    grid_link(segs, pots, read_anchor(anchors, g.z()), tiles::record(table, g.z()), level, g.z(), tiles,
              g.x(), g.y(), radius, inv_size, d, seed);
}
// Then, a level at a time after the grid's, the levels finer than a tile's
// grid holds about each of its vertices (dendry_grid.bk window_point): grid
// [cells^2, POTS, count] its potentials into `pots`, [cells^2, WIN, count]
// its links into `win`.
@kernel @grid(3)
fn k_window_points(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                   pots: write_store<vec4<f32>, 1>, win: read_store<vec4<f32>, 1>, segs: read_store<vec4<f32>, 1>,
                   reaches: read_store<vec4<f32>, 1>, net: read_store<f32, 1>, cells: i32, radius: f32, border: f32,
                   inv_size: f32, d: f32, level: i32, tiles: i32, seed: i32) {
    let rec = tiles::record(table, g.z());
    let v = g.x();
    window_point(pots, win, segs, reaches, net, read_anchor(anchors, g.z()), rec, g.z(), tiles,
                 vertex_dir(rec, v % cells, v / cells, border, inv_size), v, cells * cells, g.y(), level, radius,
                 inv_size, d, seed);
}
@kernel @grid(3)
fn k_window_links(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                  win: write_store<vec4<f32>, 1>, pots: read_store<vec4<f32>, 1>, cells: i32, radius: f32, border: f32,
                  inv_size: f32, d: f32, level: i32, seed: i32) {
    let rec = tiles::record(table, g.z());
    let v = g.x();
    window_link(win, pots, read_anchor(anchors, g.z()), rec, g.z(), vertex_dir(rec, v % cells, v / cells, border, inv_size),
                v, cells * cells, g.y(), level, radius, inv_size, d, seed);
}

// The drainage at the batch's points from the grids, found apart from the
// kernels that take it (theirs are heavy already, and a lone tile's
// production is as long as its slowest threads), each point's levels side
// by side (k_drain_parts, dendry_grid.bk level_part) and then together
// (k_point_drains): the base level, the relative height and the dryness
// (xyz of `out`) and the levels' drops (`drops`, dendry.bk Drain drops),
// drain_points() a tile, in order its texels' (every other texel,
// tex_drains; k_detail_height, and k_detail, which takes from `extras`
// what their colour does: wet, ridge, the streams' share and their
// gallery, and their climate from `climates`), the
// horizon heights' points (k_horizon_heights), the soil's (k_soil,
// SOIL_STRIDE^2, its ring beyond the texels: soil_ring). Past those, the
// vertices (k_tile, every level, into `vertices`, cells^2 a tile), the
// levels the grid does not hold from their windows (k_window_points).
fn drain_points(texels: i32, hz: i32) -> i32 {
    let td = tex_drains(texels);
    let hd = hz_drains(hz);
    return td * td + hd * hd + SOIL_STRIDE * SOIL_STRIDE;
}
// The texels' drainage is found at every other texel, for two texels' cells
// (dendry_grid.bk texel_cell): the valleys it resolves are a few cells wide,
// and the texels between take it bilinearly (halved). texels / 2 + 1 a side
// reaches the last texel of an even side too.
fn tex_drains(texels: i32) -> i32 {
    return texels / 2 + 1;
}
// Point (x, y) of a grid of points found at every other one of them, n a
// side from `base`: the found one, or the mean of the two or four about it.
fn halved4(drains: read_store<vec4<f32>, 1>, base: i32, n: i32, x: i32, y: i32) -> vec4<f32> {
    let x0 = x / 2;
    let y0 = y / 2;
    let x1 = min(x0 + (x & 1), n - 1);
    let y1 = min(y0 + (y & 1), n - 1);
    return 0.25 * (drains[base + y0 * n + x0] + drains[base + y0 * n + x1] + drains[base + y1 * n + x0] +
                   drains[base + y1 * n + x1]);
}
// The horizon heights' drainage is found a cell apart (every other of their
// points; between, k_horizon_heights takes it bilinearly), for the tile's
// own cells (dendry_grid.bk horizon_cell).
fn hz_drains(hz: i32) -> i32 {
    return (hz + 1) / 2;
}
// Point i's offset from the anchor's direction (xyz) and the cell it is
// drained for (w; 0: none).
fn drain_point(rec: tiles::Record, i: i32, texels: i32, hz: i32, cells: i32, border: f32, inv_size: f32, d: f32,
               truth: f32, radius: f32) -> vec4<f32> {
    let td = tex_drains(texels);
    let nt = td * td;
    let hd = hz_drains(hz);
    let nh = hd * hd;
    let np = drain_points(texels, hz);
    if (i >= np) {
        let j = i - np;
        return vec4<f32>(vertex_dir(rec, j % cells, j / cells, border, inv_size), cell_width(truth));
    }
    if (i < nt) {
        let st = texel_st(2 * (i % td), 2 * (i / td), border, inv_size, d);
        return vec4<f32>(frame_dir(rec, st.x, st.y), texel_cell(rec, inv_size, d));
    }
    if (i < nt + nh) {
        let j = i - nt;
        let cx = ((j % hd) - HZ_MARGIN) as f32;
        let cy = ((j / hd) - HZ_MARGIN) as f32;
        return vec4<f32>(frame_dir(rec, cx * inv_size, cy * inv_size), horizon_cell(rec, inv_size));
    }
    let j = i - nt - nh;
    let x = j % SOIL_STRIDE;
    let y = j / SOIL_STRIDE;
    let octaves = octaves_for(rec.extent, inv_size / d);
    let n = soil_points(octaves, texels);
    if (octaves <= SOIL_OCTAVES || x >= n + 2 || y >= n + 2 || !soil_ring(x, y, n)) { return vec4<f32>(0.0); }
    let st = soil_st(x, y, n, texels, border, inv_size, d);
    return vec4<f32>(frame_dir(rec, st.x, st.y), texel_cell(rec, inv_size, d));
}
// Whether soil point (x, y) of n + 2 a side is one of the ring beyond the
// texels, the soil points drained apart: the others lie among the texels'
// drainage points and take theirs (k_soil, tex_drain_at).
fn soil_ring(x: i32, y: i32, n: i32) -> bool {
    return x == 0 || y == 0 || x == n + 1 || y == n + 1;
}
// The texels' drainage at texel coordinate (tx, ty), bilinearly between
// its points (every other texel, tex_drains): either of its stores.
fn tex_drain_at(drains: read_store<vec4<f32>, 1>, base: i32, td: i32, tx: f32, ty: f32) -> vec4<f32> {
    let gx = clamp(0.5 * tx, 0.0, (td - 1) as f32);
    let gy = clamp(0.5 * ty, 0.0, (td - 1) as f32);
    let x0 = min(floor(gx) as i32, td - 2);
    let y0 = min(floor(gy) as i32, td - 2);
    let fx = gx - (x0 as f32);
    let fy = gy - (y0 as f32);
    let at = base + y0 * td + x0;
    return mix(mix(drains[at], drains[at + 1], fx), mix(drains[at + td], drains[at + td + 1], fx), fy);
}
// Level y's part at point x of tile z into `parts` (DRAIN_PARTS vec4s a
// point, all of a level's points together): a vertex's levels the grid
// does not hold from its windows.
const DRAIN_PARTS: i32 = 5;
@kernel @grid(3)
fn k_drain_parts(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                 segs: read_store<vec4<f32>, 1>, reaches: read_store<vec4<f32>, 1>, parts: write_store<vec4<f32>, 1>,
                 texels: i32, hz: i32, cells: i32, radius: f32, border: f32, inv_size: f32, d: f32, truth: f32,
                 tiles: i32, seed: i32, net: read_store<f32, 1>, win: read_store<vec4<f32>, 1>) {
    let z = g.z();
    let k = g.y();
    let rec = tiles::record(table, z);
    let p = drain_point(rec, g.x(), texels, hz, cells, border, inv_size, d, truth, radius);
    if (p.w <= 0.0) { return; }
    let a = read_anchor(anchors, z);
    let v = g.x() - drain_points(texels, hz);
    let out = (z * DRAIN_PARTS + k) * g.width() + g.x();
    if (v >= 0 && k > 0 && !grid_holds(rec, k, radius, inv_size, d)) {
        parts[out] = window_part(win, a, rec, z, p.xyz, v, cells * cells, p.w, k, radius, seed);
        return;
    }
    parts[out] = level_part(segs, reaches, net, a, rec, z, tiles, p.xyz, p.w, k, radius, inv_size, d, seed);
}
// Each point's drainage: base level, relative height and the land's
// dryness (dendry.bk dryness, which the levels' strengths follow) into
// `out` (or `vertices`), the levels' drops (dendry.bk Drain drops) into
// `drops` (or `vertex_drops`) at the same index, what its texel's colour
// takes into `extras`, and a texel's climate (climate.bk climate_fields,
// for the texel's width) into `climates`, two vec4s, td^2 apart (k_detail
// takes both bilinearly, as it does `extras`).
@kernel @grid(2)
fn k_point_drains(g: grid<2>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                  parts: read_store<vec4<f32>, 1>, out: write_store<vec4<f32>, 1>, extras: write_store<vec4<f32>, 1>,
                  vertices: write_store<vec4<f32>, 1>, drops: write_store<vec4<f32>, 1>,
                  vertex_drops: write_store<vec4<f32>, 1>, climates: write_store<vec4<f32>, 1>, texels: i32, hz: i32,
                  cells: i32, radius: f32, border: f32, inv_size: f32, d: f32, truth: f32, seed: i32) {
    let z = g.y();
    let i = g.x();
    let rec = tiles::record(table, z);
    let p = drain_point(rec, i, texels, hz, cells, border, inv_size, d, truth, radius);
    if (p.w <= 0.0) { return; }
    let w = g.width();
    let at = z * DRAIN_PARTS * w + i;
    let np = drain_points(texels, hz);
    // A vertex's levels go on past the grid to its own cell.
    let tc = i >= np ? p.w : texel_cell(rec, inv_size, d);
    let up = normalize(read_anchor(anchors, z).dir + p.xyz);
    let dry = dryness(up, seed);
    let dr = drain_parts(parts[at], parts[at + w], parts[at + 2 * w], parts[at + 3 * w], parts[at + 4 * w], p.w, tc,
                         radius, dry);
    let brd = vec4<f32>(dr.base, dr.rel, dry, 0.0);
    if (i >= np) {
        vertices[z * cells * cells + i - np] = brd;
        vertex_drops[z * cells * cells + i - np] = dr.drops;
        return;
    }
    out[z * np + i] = brd;
    drops[z * np + i] = dr.drops;
    let td = tex_drains(texels);
    // The landform's wet and ridge as the land's dryness takes them
    // (climate.bk landform_share).
    let lf = landform_share(dry);
    let nt = td * td;
    if (i >= nt) { return; }
    extras[z * nt + i] = vec4<f32>(lf * dr.wet, lf * dr.ridge, dr.share, dr.gallery);
    let cf = climate_fields(up, cell_width(octaves_for(rec.extent, inv_size / d)) / radius, seed);
    climates[2 * z * nt + i] = cf.a;
    climates[(2 * z + 1) * nt + i] = cf.b;
}
// Vertex (x, y)'s offset from the tile's anchor's direction (as k_tile).
fn vertex_dir(rec: tiles::Record, x: i32, y: i32, border: f32, inv_size: f32) -> vec3<f32> {
    return rec.dir_lo + tiles::sphere_offset(rec, tiles::frame_offset(rec, ((x as f32) - border) * inv_size,
                                                                       ((y as f32) - border) * inv_size));
}

// Cell (x, y) of a tile at (s, t) = ((x, y) - border) / tileSize across the
// tile's frame. Its vertex is the ground's true surface at that point, every
// octave down to `truth`: a parent's vertices are every other vertex of its
// children, so refining only adds vertices between the ones already drawn,
// and none of those moves; what is finer than the vertices, a tile shades
// with (the detail layer, below). Written as the vertex's position relative
// to the tile's center and its height (sea level clamps the surface, not
// the height). The tile's surface heights gather in `span` for k_range: two
// int32 per record, INT_MAX less the lowest's float bits and the highest's
// (a surface never lies below sea level, and non-negative floats order as
// their bits). And into `relief`, for the ground's shader, which adds the
// relief's octaves finer than its texels (ground_mesh.bk): where the cell is
// in the relief's noise (ground.bk relief_offset), from the anchor's, through
// the warp (xyz); and how much the ground there moves with the octaves (w's
// bits: ground.bk terrain_shaped, below FINE_FIRST in the low 11 bits, from
// it on in the next 11, the octaves the drainage keeps whole (relief.bk
// kept_share) in the top 10, each -0.5 to 1 as a unorm).
@kernel @grid(3)
fn k_tile(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>, out: write_store<vec4<f32>, 3>,
          relief: write_store<vec4<f32>, 3>, span: rw_store<i32, 1>, radius: f32, border: f32, inv_size: f32, truth: f32,
          seed: i32, net: read_store<f32, 1>, drains: read_store<vec4<f32>, 1>, drops: read_store<vec4<f32>, 1>) {
    let rec = tiles::record(table, g.z());
    let a = read_anchor(anchors, g.z());
    let s = ((g.x() as f32) - border) * inv_size;
    let t = ((g.y() as f32) - border) * inv_size;
    let d = tiles::frame_offset(rec, s, t);
    let e = rec.dir_lo + tiles::sphere_offset(rec, d);
    // (Its drainage read after the noise: kept live through it, it costs the
    // noise's threads.)
    let parts = terrain_parts(a, e, radius, truth, seed);
    let wa = water_at(a.dir, e, radius, cell_width(truth), net, seed);
    let vi = (g.z() * g.height() + g.y()) * g.width() + g.x();
    let shaped = shaped_by(parts, wa, drain_held(drains[vi], drops[vi]), radius);
    let h = shaped.x;
    let p = tiles::sphere_vertex(rec, d, radius, max(h, 0.0));
    out[g.x(), g.y(), rec.slot] = vec4<f32>(p, h);
    let scales = unorm((shaped.y + 0.5) / 1.5, 11) | (unorm((shaped.z + 0.5) / 1.5, 11) << 11) |
                 (unorm((shaped.w + 0.5) / 1.5, 10) << 22);
    let k = radius / BASE_WAVELENGTH;
    let dq = relief_offset(a, e * k, seed) - relief_offset(a, rec.dir_lo * k, seed);
    relief[g.x(), g.y(), rec.slot] = vec4<f32>(dq, bitcast<f32>(scales));
    let bits = bitcast<i32>(max(h, 0.0));
    span.atomic_max(2 * g.z(), 2147483647 - bits);
    span.atomic_max(2 * g.z() + 1, bits);
}

// ── The detail layer ────────────────────────────────────────────────────────
//
// What a tile shades with, at `d` texels along each cell's edge: finer than
// its vertices, so a coarse tile lights and colours as the ground it stands
// for does. A tile's texels form an (n * d)^2 image over its cells, texel
// (tx, ty) centred at cell coordinate ((tx, ty) + 0.5) / d - 0.5 (cell (x, y)
// is the vertex at (x, y)). Each texel holds two words: the mean colour of
// the truth under it (rgb, and how much is water; 8 bits each) and the
// normal of the ground's mean surface over it (octahedral, 12 bits a
// component) with the share of it under forest (8 bits), all taken from
// the texels' mean heights.

// Texel (tx, ty)'s frame coordinates (s, t).
fn texel_st(tx: i32, ty: i32, border: f32, inv_size: f32, d: f32) -> vec2<f32> {
    return vec2<f32>(((tx as f32) + 0.5) / d - 0.5 - border, ((ty as f32) + 0.5) / d - 0.5 - border) * inv_size;
}

// The soil's height (ground.bk soil_height) over a tile finer than its
// scale, at n x n points spanning the tile's texels corner texel to corner
// texel and one point more about them, (n + 2)^2 in all, each tile
// SOIL_STRIDE^2 floats of `out` in the batch's order. Its slope varies over
// tens of metres, so k_detail takes it between the points from their
// neighbours (soil_slope), not at every texel. n puts the points about
// SOIL_SPACING apart, a quarter of the soil's shortest wavelength, from 3 on
// a small tile to SOIL_FINE on one a kilometre across (soil_points); the
// grid is SOIL_STRIDE square and the points a tile does not take return at
// once. Tiles that do not resolve the soil take nothing (k_detail takes the
// share of it under each texel instead).
const SOIL_FINE: i32 = 65;
pub const SOIL_STRIDE: i32 = 67;
const SOIL_SPACING: f32 = 10.0;
fn soil_points(octaves: f32, texels: i32) -> i32 {
    let extent = ((texels - 1) as f32) * cell_width(octaves);
    return clamp((ceil(extent / SOIL_SPACING) as i32) + 1, 3, SOIL_FINE);
}
@kernel @grid(3)
fn k_soil(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>, out: write_store<f32, 1>,
          texels: i32, radius: f32, border: f32, inv_size: f32, d: f32, seed: i32, net: read_store<f32, 1>,
          drains: read_store<vec4<f32>, 1>, hz: i32, drops: read_store<vec4<f32>, 1>) {
    let rec = tiles::record(table, g.z());
    let octaves = octaves_for(rec.extent, inv_size / d);
    let n = soil_points(octaves, texels);
    if (octaves <= SOIL_OCTAVES || g.x() >= n + 2 || g.y() >= n + 2) { return; }
    let at = g.z() * SOIL_STRIDE * SOIL_STRIDE + g.y() * (n + 2) + g.x();
    let st = soil_st(g.x(), g.y(), n, texels, border, inv_size, d);
    let a = read_anchor(anchors, g.z());
    let e = frame_dir(rec, st.x, st.y);
    // (Its drainage read after the noise, as k_tile's.)
    let parts = terrain_parts(a, e, radius, SOIL_OCTAVES, seed);
    let wa = water_at(a.dir, e, radius, cell_width(SOIL_OCTAVES), net, seed);
    let hd = hz_drains(hz);
    let td = tex_drains(texels);
    let base = g.z() * drain_points(texels, hz);
    let ri = base + td * td + hd * hd + g.y() * SOIL_STRIDE + g.x();
    var dr = drains[ri];
    var dp = drops[ri];
    if (!soil_ring(g.x(), g.y(), n)) {
        // (soil_st: point x is at texel (x - 1) span.)
        let span = ((texels - 1) as f32) / ((n - 1) as f32);
        let tx = ((g.x() - 1) as f32) * span;
        let ty = ((g.y() - 1) as f32) * span;
        dr = tex_drain_at(drains, base, td, tx, ty);
        dp = tex_drain_at(drops, base, td, tx, ty);
    }
    out[at] = shaped_by(parts, wa, drain_held(dr, dp), radius).x;
}
// Soil point (x, y)'s frame coordinates, n points a side.
fn soil_st(x: i32, y: i32, n: i32, texels: i32, border: f32, inv_size: f32, d: f32) -> vec2<f32> {
    let span = ((texels - 1) as f32) / ((n - 1) as f32);
    return vec2<f32>(((((x - 1) as f32) * span + 0.5) / d - 0.5 - border) * inv_size,
                     ((((y - 1) as f32) * span + 0.5) / d - 0.5 - border) * inv_size);
}

// The soil's gradient at point (i, j) of a tile's k_soil grid (its points
// numbered from the border's, m a side), points `step` metres apart.
fn soil_slope(soil: read_store<f32, 1>, base: i32, m: i32, i: i32, j: i32, step: f32) -> f32 {
    let at = base + j * m + i;
    let gu = soil[at + 1] - soil[at - 1];
    let gv = soil[at + m] - soil[at - m];
    return sqrt(gu * gu + gv * gv) / (2.0 * step);
}

// Each texel of a batch into `texels`, the batch's tiles one after another,
// (n * d)^2 each: xyz its point of the mean surface relative to the tile's
// center, w its mean height. k_detail reads every texel's point four times
// over, from its neighbours, so it is found once here. Its drainage is
// k_point_drains'.
@kernel @grid(3)
fn k_detail_height(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                   texels: write_store<vec4<f32>, 1>, radius: f32, border: f32, inv_size: f32, d: f32, seed: i32,
                   net: read_store<f32, 1>, drains: read_store<vec4<f32>, 1>, hz: i32, drops: read_store<vec4<f32>, 1>) {
    let rec = tiles::record(table, g.z());
    let a = read_anchor(anchors, g.z());
    let w = g.width();
    let tx = g.x();
    let ty = g.y();
    let cell = inv_size / d;
    let st = texel_st(tx, ty, border, inv_size, d);
    let octaves = octaves_for(rec.extent, cell);
    let base = g.z() * drain_points(w, hz);
    let drain = drain_held(halved4(drains, base, tex_drains(w), tx, ty), halved4(drops, base, tex_drains(w), tx, ty));
    let h = cell_ground_drained(a, rec, st.x, st.y, cell, radius, octaves, seed, net, drain).h;
    let p = tiles::sphere_vertex(rec, tiles::frame_offset(rec, st.x, st.y), radius, max(h, 0.0));
    texels[(g.z() * w + ty) * w + tx] = vec4<f32>(p, h);
}

// Texel (tx, ty) of tile z, clamped to the tile's texels.
fn texel_at(texels: read_store<vec4<f32>, 1>, z: i32, w: i32, tx: i32, ty: i32) -> vec4<f32> {
    return texels[(z * w + clamp(ty, 0, w - 1)) * w + clamp(tx, 0, w - 1)];
}

// 0 to 1 into `bits` bits, rounded.
fn unorm(x: f32, bits: i32) -> i32 {
    let top = ((1 << bits) - 1) as f32;
    return (clamp(x, 0.0, 1.0) * top + 0.5) as i32;
}

// A tile's detail layer from the texels' mean heights: each texel's
// gradient from its neighbours', its spreads from the octaves it does not
// resolve, and the expected surface over them, with the mean surface's
// normal.
// A floodplain's moisture over its climate's, and a river's silt off its
// floodplain (rivers.bk fresh_water).
const RIPARIAN_MOIST: f32 = 0.45;
const RIPARIAN: f32 = 0.8;
const RIVER_TURBID: f32 = 0.6;
const BAR_SAND = vec3<f32>(0.44, 0.40, 0.32);

@kernel @grid(3)
fn k_detail(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>, texels: read_store<vec4<f32>, 1>,
            out: write_store<i32, 1>, radius: f32, border: f32, inv_size: f32, d: f32, truth: f32, seed: i32,
            net: read_store<f32, 1>, soil_grid: read_store<f32, 1>, rock: write_store<i32, 1>,
            drains: read_store<vec4<f32>, 1>, climates: read_store<vec4<f32>, 1>) {
    let rec = tiles::record(table, g.z());
    let a = read_anchor(anchors, g.z());
    let z = g.z();
    let w = g.width();
    let slot = rec.slot;
    let tx = g.x();
    let ty = g.y();
    let octaves = octaves_for(rec.extent, inv_size / d);
    let du = texel_at(texels, z, w, tx + 1, ty).xyz - texel_at(texels, z, w, tx - 1, ty).xyz;
    let dv = texel_at(texels, z, w, tx, ty + 1).xyz - texel_at(texels, z, w, tx, ty - 1).xyz;
    let st = texel_st(tx, ty, border, inv_size, d);
    let e = frame_dir(rec, st.x, st.y);
    let up = normalize(a.dir + e);
    let sp = spread(a, e, radius, octaves, truth, seed);
    let h = texels[(z * w + ty) * w + tx].w;
    // du and dv span two texels.
    let grad = gradient(du, dv, up);
    let trend = grad * length(du) * 0.5;
    let sd = sqrt(sp.x * sp.x + trend * trend / 12.0);
    // The soil's slope: a texel finer than its scale reads it at its point,
    // a coarser one its own and the spread of the soil's octaves under it.
    var soil = vec2<f32>(0.0);
    if (octaves <= SOIL_OCTAVES) {
        soil = vec2<f32>(grad, spread(a, e, radius, octaves, min(truth, SOIL_OCTAVES), seed).y);
    } else {
        let pts = soil_points(octaves, w);
        let span = ((pts - 1) as f32) / ((w - 1) as f32);
        let sx = (tx as f32) * span;
        let sy = (ty as f32) * span;
        let ix = min(floor(sx) as i32, pts - 2);
        let iy = min(floor(sy) as i32, pts - 2);
        let fx = sx - (ix as f32);
        let fy = sy - (iy as f32);
        // Points (ix, iy) on are (ix + 1, iy + 1) of the grid, its border
        // about them; `step` metres apart (du spans two texels).
        let base = z * SOIL_STRIDE * SOIL_STRIDE;
        let m = pts + 2;
        let step = length(du) * 0.5 / span;
        let top = mix(soil_slope(soil_grid, base, m, ix + 1, iy + 1, step),
                      soil_slope(soil_grid, base, m, ix + 2, iy + 1, step), fx);
        let bottom = mix(soil_slope(soil_grid, base, m, ix + 1, iy + 2, step),
                         soil_slope(soil_grid, base, m, ix + 2, iy + 2, step), fx);
        soil = vec2<f32>(mix(top, bottom, fy), 0.0);
    }
    // The climate (k_point_drains', every other texel), wetter down the
    // valleys and drier along the ridges (its drainage); the region's rock
    // is the climate's own.
    let td = tex_drains(w);
    let dr = halved4(drains, z * td * td, td, tx, ty);
    let cl_region = climate_of(halved4(climates, 2 * z * td * td, td, tx, ty),
                               halved4(climates, (2 * z + 1) * td * td, td, tx, ty));
    let cl = landform_climate(cl_region, dr.x, dr.y);
    // The texels nearest the tile's corners give it its rock's corners
    // (ANCHOR_WORDS' word 5), half a texel in.
    // (texel_st: texel t is at s = ((t + 0.5) / d - 0.5 - border) / TILE.)
    let c0 = ((border + 0.5) * d - 0.5) as i32;
    let c1 = ((border + 1.0 / inv_size + 0.5) * d - 0.5) as i32;
    if ((tx == c0 || tx == c1) && (ty == c0 || ty == c1)) {
        let r = sqrt(cl.rock);
        let k = (tx == c1 ? 1 : 0) + (ty == c1 ? 2 : 0);
        rock[slot * ANCHOR_WORDS + 20 + k] = unorm(r.x, 8) | (unorm(r.y, 8) << 8) | (unorm(r.z, 8) << 16);
    }
    var col = expected_surface(h, grad, length(du) * 0.5, sp.x, soil, variation(a, e, radius, octaves, seed),
                               strata(a, e, radius, h, sd, seed), cl);
    // The rivers and lakes: the share of the texel under their water, a
    // river as deep as its channel runs there (shallow at its banks, its bed
    // showing through), a lake as deep as its water stands over its
    // valley's bed (rivers.bk lake_surface).
    let wa = with_streams(water_at(a.dir, e, radius, length(du) * 0.5, net, seed), dr.z, dr.w, cl_region);
    // A great river's floodplain is the land's wettest: its colour is the
    // climate's with the river's water (the green ribbon a desert river
    // draws from orbit, a darker forest along a temperate one), and its
    // forest the gallery along the banks.
    var cover = wooded(banked(expected_cover(h, grad, length(du) * 0.5, sp.x, soil, cl), h, grad, cl, wa),
                       landform_wood(woodland(a, e, radius, octaves, seed), dr.x, dr.y));
    if (wa.plain > 0.0) {
        let wet = Climate { temp: cl.temp, moist: min(cl.moist + RIPARIAN_MOIST, 1.0), sand: cl.sand, rock: cl.rock };
        let riparian = cover_at(wet, h);
        let share = RIPARIAN * wa.plain * (1.0 - snow_at(cl, h)) * (1.0 - smoothstep(0.15, 0.5, grad));
        // Its old courses: darker, wetter, grown over.
        let banded = riparian.colour * (1.0 + 0.35 * wa.tone);
        col = vec4<f32>(mix(col.xyz, banded, share), col.w);
        cover = mix(cover, max(cover, riparian.forest * (0.4 - 0.4 * wa.tone)), share);
    }
    // Sand bars, pale and bare.
    if (wa.bar > 0.0) {
        col = vec4<f32>(mix(col.xyz, mix(cl.sand, BAR_SAND, 0.6), wa.bar), col.w);
        cover = cover * (1.0 - wa.bar);
    }
    let water = water_share(h, wa, sd);
    // A great river carries silt: lighter and browner than a lake, as the
    // Amazon's and the Mississippi's water reads from orbit; so do the lakes
    // on its floodplain. Every river carries some (its share of the water
    // here, against a lake's), so however deep its channel it is never the
    // clear lakes' near-black.
    let silt = max(wa.plain, RIVER_TURBID * clamp(wa.near.y / max(water, 1.0e-3), 0.0, 1.0));
    let fresh = fresh_water(water_depth(wa), silt);
    col = vec4<f32>(mix(col.xyz, fresh, water), max(col.w, water));
    cover = cover * (1.0 - water);
    var n = normalize(cross(du, dv));
    if (dot(n, up) < 0.0) { n = -n; }
    // Octahedral: the normal onto the octahedron |x| + |y| + |z| = 1, its
    // lower half folded over, x and y 0 to 1.
    let o = n / (abs(n.x) + abs(n.y) + abs(n.z));
    var ox = o.x;
    var oy = o.y;
    if (o.z < 0.0) {
        ox = (1.0 - abs(o.y)) * sign(o.x);
        oy = (1.0 - abs(o.x)) * sign(o.y);
    }
    let at = ((slot * w + ty) * w + tx) * 2;
    // The colour square-rooted, as 8 linear bits band a dark forest's
    // greens in steps a tenth of its value (ground_mesh.bk detail_texel
    // squares it back); the water's share linear.
    let enc = sqrt(max(col.xyz, vec3<f32>(0.0)));
    out[at] = unorm(enc.x, 8) | (unorm(enc.y, 8) << 8) | (unorm(enc.z, 8) << 16) | (unorm(col.w, 8) << 24);
    // The normal in 12 bits a coordinate, the forest's cover in the top 8.
    out[at + 1] = unorm(ox * 0.5 + 0.5, 12) | (unorm(oy * 0.5 + 0.5, 12) << 12) | (unorm(cover, 8) << 24);
}

// ── The relief anchors ──────────────────────────────────────────────────────
//
// Where a tile's anchor is on the lattices of the relief's noise, for the
// ground's shader, which adds per pixel the ridged octaves finer than the
// tile's texels (ground_mesh.bk) from each cell's offset (k_tile's relief
// layer): the noise's lattice cell and the offset in it, once a tile, from
// which the shader runs the rest (relief.bk). The ridge octaves' lattices
// are each twice the last, so one anchor gives every finer octave's.
// ANCHOR_WORDS int32 a slot, as six vec4s:
//   0 the ridge octaves' lattice cell at octave o_a (xyz), o_a (w)
//   1 the offset in it (xyz, float bits), the octaves the texels carry (w)
//   2-4 the warp's x, y and z noise's gradients per unit of p, times
//       WARP_DISPLACE: the warp's stretch, which the shader's gradients take
//   5 the region's rock colour (climate.bk) at the tile's corners (s, t) =
//     (0, 0), (1, 0), (0, 1), (1, 1), square-rooted in unorm 8 x 4: the
//     shader's cliffs interpolate it, the provinces being hundreds of
//     kilometres to a near tile's few (k_detail writes it, from the texels
//     nearest the corners)
const ANCHOR_WORDS: i32 = 24;
fn f32_bits(x: f32) -> i32 {
    return bitcast<i32>(x);
}
@kernel @grid(1)
fn k_anchor(g: grid<1>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>, out: write_store<i32, 1>,
            radius: f32, inv_size: f32, d: f32, seed: i32) {
    let rec = tiles::record(table, g.x());
    let a = read_anchor(anchors, g.x());
    let oct = octaves_for(rec.extent, inv_size / d);
    // An octave broader than the texels': they still hold less of it than
    // a pixel does.
    let o_a = max((floor(oct) as i32) - 1, RIDGE_FIRST);
    let off = rec.dir_lo * (radius / BASE_WAVELENGTH);
    let ra = simplex_from(doubled(a.p, o_a), relief_offset(a, off, seed) * exp2(o_a as f32));
    let wa = simplex_from(doubled(a.p, WARP_OCTAVE), off * exp2(WARP_OCTAVE as f32));
    let k = WARP_DISPLACE * exp2(WARP_OCTAVE as f32);
    let gx = simplex_grad(wa, seed + 400).yzw * k;
    let gy = simplex_grad(wa, seed + 401).yzw * k;
    let gz = simplex_grad(wa, seed + 402).yzw * k;
    let at = rec.slot * ANCHOR_WORDS;
    out[at] = ra.cell.x;
    out[at + 1] = ra.cell.y;
    out[at + 2] = ra.cell.z;
    out[at + 3] = o_a;
    out[at + 4] = f32_bits(ra.sk.x);
    out[at + 5] = f32_bits(ra.sk.y);
    out[at + 6] = f32_bits(ra.sk.z);
    out[at + 7] = f32_bits(oct);
    out[at + 8] = f32_bits(gx.x);
    out[at + 9] = f32_bits(gx.y);
    out[at + 10] = f32_bits(gx.z);
    out[at + 11] = 0;
    out[at + 12] = f32_bits(gy.x);
    out[at + 13] = f32_bits(gy.y);
    out[at + 14] = f32_bits(gy.z);
    out[at + 15] = 0;
    out[at + 16] = f32_bits(gz.x);
    out[at + 17] = f32_bits(gz.y);
    out[at + 18] = f32_bits(gz.z);
    out[at + 19] = 0;
}

// ── The horizon layer ───────────────────────────────────────────────────────
//
// How high the ground rises around a point, which the ground shader turns
// into how much of the sun and of the sky it sees: at every other cell of a
// tile (an n^2 grid, point (i, j) at cell (2i, 2j)), the sine of the
// horizon's elevation in HZ_DIRS directions of the tile's grid, the k-th
// along (cos, sin)(k * 45 degrees) in cells (the frame's u and v, which the
// shader maps the sun into), each 16 bits, two to a word: four words, then
// four more holding the far horizon alone.
//
// Each tile marches its horizons through one grid of the ground's heights at
// its cells, HZ_MARGIN cells past the tile on every side, at the octaves the
// tile shades with (k_horizon_heights): a height a cell holds is shared by
// every ray that passes it, where sampling the ground per ray cost each tile
// six times the evaluations. Steps are 2^(1/12) apart from a cell out: the
// near band to 8 cells, the far band from 8 to 16 cells.
//
// The far horizon, over distances from 8 cells out, is what a child
// inherits: read bilinearly from its parent's grid at the same point (the
// parent's points are 4 child cells apart, and what lies 16 child cells or
// more away changes little across that), widened by the child's own far
// band. As the parent's far band is 16 to 32 child cells, its
// parent's the next octave out, a point's horizon spans every distance from
// a cell to its root's. The horizon the ground is shaded by adds the near
// band, marched from the point itself: interpolated, a near ridge's horizon
// would spill onto the valley beside it.
const HZ_DIRS: i32 = 8;
const HZ_PER_OCTAVE: i32 = 12;   // steps a doubling of distance: at 8 a crest between two stood low
const HZ_STEPS: i32 = 48;    // a cell to 16 cells, a factor 2^(1/12) apart
const HZ_NEAR: i32 = 36;     // of them, the near band's (to 8 cells)
const HZ_MARGIN: i32 = 16;   // cells of heights past the tile, beyond the farthest step from its points
const HZ_WORDS: i32 = 16;    // a point's: 4 of full horizons, 8 of far ones, its height, 3 unused

// The heights the horizons march through: an e^2 grid a tile, HZ_DENSITY
// points a cell, point (x, y) at cell (x, y) / HZ_DENSITY - HZ_MARGIN, the
// surface at the tile's octaves plus two, drained as an octave finer than
// the tile's own cells resolve its valleys (k_point_drains, a cell apart and
// bilinear between: hz_drains). Sharp crests stand
// between the points, and a ridge read between them stands low, so every
// horizon behind one did: at a point a cell (and 8 steps an octave) the
// horizons of alpine ranges sat 1.6 degrees low on average, at two (and 12)
// 0.5.
const HZ_DENSITY: i32 = 2;
@kernel @grid(3)
fn k_horizon_heights(g: grid<3>, table: read_store<vec4<i32>, 1>, anchors: read_store<vec4<i32>, 1>,
                     heights: write_store<f32, 1>, radius: f32, inv_size: f32, seed: i32, net: read_store<f32, 1>,
                     drains: read_store<vec4<f32>, 1>, texels: i32, drops: read_store<vec4<f32>, 1>) {
    let rec = tiles::record(table, g.z());
    let a = read_anchor(anchors, g.z());
    let e = g.width();
    let m = HZ_MARGIN as f32;
    let dens = HZ_DENSITY as f32;
    let cx = (g.x() as f32) / dens - m;
    let cy = (g.y() as f32) / dens - m;
    let octaves = octaves_for(rec.extent, inv_size) + 2.0;
    let at = frame_dir(rec, cx * inv_size, cy * inv_size);
    // The drainage a cell apart, bilinearly (hz_drains).
    let td = tex_drains(texels);
    let hb = g.z() * drain_points(texels, e) + td * td;
    let hd = hz_drains(e);
    // (Read after the noise, as k_tile's.)
    let parts = terrain_parts(a, at, radius, octaves, seed);
    let wa = water_at(a.dir, at, radius, cell_width(octaves), net, seed);
    let drain = drain_held(halved4(drains, hb, hd, g.x(), g.y()), halved4(drops, hb, hd, g.x(), g.y()));
    let h = shaped_by(parts, wa, drain, radius).x;
    heights[(g.z() * e + g.y()) * e + g.x()] = max(h, 0.0);
}

// The height grid bilinearly at cell coordinate (cx, cy).
fn grid_height(heights: read_store<f32, 1>, base: i32, e: i32, cx: f32, cy: f32) -> f32 {
    let gx = (cx + (HZ_MARGIN as f32)) * (HZ_DENSITY as f32);
    let gy = (cy + (HZ_MARGIN as f32)) * (HZ_DENSITY as f32);
    let ix = min(floor(gx) as i32, e - 2);
    let iy = min(floor(gy) as i32, e - 2);
    let fx = gx - (ix as f32);
    let fy = gy - (iy as f32);
    let at = base + iy * e + ix;
    let top = mix(heights[at], heights[at + 1], fx);
    let bottom = mix(heights[at + e], heights[at + e + 1], fx);
    return mix(top, bottom, fy);
}

// A far horizon's word: its sine (16 bits) and the log2 of its distance in
// metres (16 bits over 0 to HZ_LOG_RANGE).
const HZ_LOG_RANGE: f32 = 24.0;

fn hz_pack_far(s: f32, d: f32) -> i32 {
    return unorm(s * 0.5 + 0.5, 16) | (unorm(clamp(log2(max(d, 1.0)) / HZ_LOG_RANGE, 0.0, 1.0), 16) << 16);
}

// The sine of direction k's far horizon at point (gx, gy) of tile `slot`,
// as seen from height `h` instead of the point's own: the occluder stays
// where it is (its distance kept with it), the eye moves up or down.
fn hz_read_far(hz: rw_store<i32, 1>, slot: i32, n: i32, gx: i32, gy: i32, k: i32, h: f32) -> f32 {
    let at = ((slot * n + gy) * n + gx) * HZ_WORDS;
    let word = hz[at + 4 + k];
    let s = ((word & 65535) as f32) / 65535.0 * 2.0 - 1.0;
    if (s <= -1.0) { return -1.0; }
    let d = exp2((((word >> 16) & 65535) as f32) / 65535.0 * HZ_LOG_RANGE);
    let rise = d * s + bitcast<f32>(hz[at + 12]) - h;
    let run = d * sqrt(max(1.0 - s * s, 0.0));
    return rise / sqrt(rise * rise + run * run);
}

@kernel @grid(3)
fn k_horizon(g: grid<3>, table: read_store<vec4<i32>, 1>, heights: read_store<f32, 1>, hz: rw_store<i32, 1>,
             e: i32, radius: f32, border: f32, inv_size: f32) {
    let rec = tiles::record(table, g.z());
    let slot = rec.slot;
    let parent = rec.parent;
    let n = g.width();
    let hbase = g.z() * e * e;
    let x = g.x() * 2;
    let y = g.y() * 2;
    let cx = (x as f32) - border;
    let cy = (y as f32) - border;
    // The point, and the frame as offsets from it: a sample at cell offset
    // (dx, dy) lies along normalize(base + au * dx + av * dy) * |base|, base
    // the frame at the point. au, av are small beside 1, and the march works
    // in them alone (exact to the metre on the finest tiles).
    let d = tiles::frame_offset(rec, cx * inv_size, cy * inv_size);
    let len = length(rec.anchor + d);
    let n32 = normalize(rec.dir_hi + (rec.dir_lo + tiles::sphere_offset(rec, d)));
    let au = rec.u * (inv_size / len);
    let av = rec.v * (inv_size / len);
    let rad = radius;
    let h = grid_height(heights, hbase, e, cx, cy);
    // This point on the parent's grid: the parent's cells are twice as wide,
    // and the tile is its quadrant.
    let half = 0.5 / inv_size;
    let gx = (cx * 0.5 + (rec.quadrant.x as f32) * half + border) * 0.5;
    let gy = (cy * 0.5 + (rec.quadrant.y as f32) * half + border) * 0.5;
    let ix = floor(gx) as i32;
    let iy = floor(gy) as i32;
    let ix1 = min(ix + 1, n - 1);
    let iy1 = min(iy + 1, n - 1);
    let fx = gx - floor(gx);
    let fy = gy - floor(gy);
    // The parent point nearest, whose far horizon's distance an inherited
    // one keeps.
    var jx = ix;
    if (fx >= 0.5) { jx = ix1; }
    var jy = iy;
    if (fy >= 0.5) { jy = iy1; }
    let at = ((slot * n + g.y()) * n + g.x()) * HZ_WORDS;
    var w0: i32 = 0;
    var w1: i32 = 0;
    var w2: i32 = 0;
    var w3: i32 = 0;
    for (var k: i32 = 0; k < HZ_DIRS; k += 1) {
        let ang = (k as f32) * 0.78539816;
        let ca = cos(ang);
        let sa = sin(ang);
        var far: f32 = -1.0;
        var far_d: f32 = 1.0;
        if (parent >= 0) {
            let top = mix(hz_read_far(hz, parent, n, ix, iy, k, h), hz_read_far(hz, parent, n, ix1, iy, k, h), fx);
            let bottom = mix(hz_read_far(hz, parent, n, ix, iy1, k, h), hz_read_far(hz, parent, n, ix1, iy1, k, h), fx);
            far = mix(top, bottom, fy);
            let word = hz[((parent * n + jy) * n + jx) * HZ_WORDS + 4 + k];
            far_d = exp2((((word >> 16) & 65535) as f32) / 65535.0 * HZ_LOG_RANGE);
        }
        var near: f32 = -1.0;
        for (var i: i32 = 0; i < HZ_STEPS; i += 1) {
            let dist = exp2((i as f32) / (HZ_PER_OCTAVE as f32));
            let dx = ca * dist;
            let dy = sa * dist;
            let hq = grid_height(heights, hbase, e, cx + dx, cy + dy);
            // The sample's direction less the point's, from the offset alone.
            let off = au * dx + av * dy;
            let grow = 2.0 * dot(n32, off) + dot(off, off);
            let l = sqrt(1.0 + grow);
            let delta = (off - n32 * (grow / (l + 1.0))) / l;
            let to = delta * (rad + hq) + n32 * (hq - h);
            let s = dot(to, n32) / length(to);
            if (i < HZ_NEAR) { near = max(near, s); }
            else if (s > far) { far = s; far_d = length(to); }
        }
        hz[at + 4 + k] = hz_pack_far(far, far_d);
        let full = unorm(max(near, far) * 0.5 + 0.5, 16) << (16 * (k % 2));
        let wk = k / 2;
        if (wk == 0) { w0 = w0 | full; } else if (wk == 1) { w1 = w1 | full; }
        else if (wk == 2) { w2 = w2 | full; } else { w3 = w3 | full; }
    }
    hz[at] = w0;
    hz[at + 1] = w1;
    hz[at + 2] = w2;
    hz[at + 3] = w3;
    hz[at + 12] = bitcast<i32>(h);
}


// The range the surface of a tile and of every tile below it lies in, into
// the cache's ranges at 2 * slot: the surface heights k_tile gathered,
// widened by what finer octaves can still add (ground.bk range_margin), at
// most `top`. It clears the tile's `span` for the next batch.
@kernel @grid(1)
fn k_range(g: grid<1>, table: read_store<vec4<i32>, 1>, span: rw_store<i32, 1>, ranges: write_store<f32, 1>,
           inv_size: f32, top: f32) {
    let rec = tiles::record(table, g.x());
    let slot = rec.slot;
    let lo = bitcast<f32>(2147483647 - span[2 * g.x()]);
    let hi = bitcast<f32>(span[2 * g.x() + 1]);
    span[2 * g.x()] = 0;
    span[2 * g.x() + 1] = 0;
    let margin = range_margin(octaves_for(rec.extent, inv_size), top);
    ranges[2 * slot] = max(lo - margin, 0.0);
    ranges[2 * slot + 1] = min(hi + margin, top);
}

// The error splitting a tile would take away, into the cache's detail at
// slot: what its children's new vertices add to its surface (metres, rms).
// The ground is self-similar, so the tile's own cells say it beforehand: the
// rms of its odd vertices less the mean of the even ones about them (its
// own split, seen from inside) times DETAIL_RATIO, the next split's share of
// it, which falls from 0.85 at level 6 to 0.46 from level 11 on as the
// alpine octaves give out (measured over leaf quads; within 10% at a level).
fn detail_ratio(level: i32) -> f32 {
    return 0.46 + 0.39 * clamp((11.0 - (level as f32)) / 5.0, 0.0, 1.0);
}

// A store is shaped like its kernel's grid, so the pool (cells x cells a
// slot) is read flat here.
fn surface_at(pos: read_store<vec4<f32>, 1>, base: i32, cells: i32, border: i32, i: i32, j: i32) -> f32 {
    return max(pos[base + (j + border) * cells + i + border].w, 0.0);
}

// What the texels hold beyond the means of their 2x2 blocks (the tile's own
// texels seen at half their count): colour and forest cover, each 0 to 1,
// and the mean surface's normal (octahedral, -1 to 1: what lights the relief
// a texel's vertices are too far apart to carry),
// squared and summed over the tile's interior into `spread` at the batch
// record, in fixed point (SPREAD_ONE a unit), for k_split_detail. A thread a
// block, so the sum gathers by atomics rather than one serial loop a tile.
const SPREAD_ONE: f32 = 16384.0;

fn texel_channels(det: read_store<i32, 1>, at: i32) -> vec4<f32> {
    let c = det[at];
    let n = det[at + 1];
    return vec4<f32>((c & 255) as f32, ((c >> 8) & 255) as f32, ((c >> 16) & 255) as f32, ((n >> 24) & 255) as f32) / 255.0;
}

// The texel's normal as its octahedral coordinates, -1 to 1 (k_detail).
fn texel_normal(det: read_store<i32, 1>, at: i32) -> vec2<f32> {
    let n = det[at + 1];
    return vec2<f32>((n & 4095) as f32, ((n >> 12) & 4095) as f32) / 4095.0 * 2.0 - 1.0;
}

@kernel @grid(3)
fn k_texel_spread(g: grid<3>, table: read_store<vec4<i32>, 1>, det: read_store<i32, 1>, spread: rw_store<i32, 1>,
                  texels: i32, first: i32) {
    let rec = tiles::record(table, g.z());
    let tx = first + 2 * g.x();
    let ty = first + 2 * g.y();
    let base = rec.slot * texels * texels;
    let a = texel_channels(det, (base + ty * texels + tx) * 2);
    let b = texel_channels(det, (base + ty * texels + tx + 1) * 2);
    let c = texel_channels(det, (base + (ty + 1) * texels + tx) * 2);
    let d = texel_channels(det, (base + (ty + 1) * texels + tx + 1) * 2);
    let m = (a + b + c + d) * 0.25;
    let na = texel_normal(det, (base + ty * texels + tx) * 2);
    let nb = texel_normal(det, (base + ty * texels + tx + 1) * 2);
    let nc = texel_normal(det, (base + (ty + 1) * texels + tx) * 2);
    let nd = texel_normal(det, (base + (ty + 1) * texels + tx + 1) * 2);
    let nm = (na + nb + nc + nd) * 0.25;
    let s = dot(a - m, a - m) + dot(b - m, b - m) + dot(c - m, c - m) + dot(d - m, d - m) +
            dot(na - nm, na - nm) + dot(nb - nm, nb - nm) + dot(nc - nm, nc - nm) + dot(nd - nm, nd - nm);
    spread.atomic_add(g.z(), (s * SPREAD_ONE + 0.5) as i32);
}

// A tile's detail: the larger of what its split takes from its surface
// (metres) and from its colour, the texels' spread as a length: a texel's
// width times its rms spread over `contrast` (a spread of `contrast` counts
// as a whole texel wrong). Clears `spread` for the next batch.
@kernel @grid(1)
fn k_split_detail(g: grid<1>, table: read_store<vec4<i32>, 1>, pos: read_store<vec4<f32>, 1>, detail: write_store<f32, 1>,
                  spread: rw_store<i32, 1>, tile: i32, border: i32, texel_count: f32, contrast: f32) {
    let rec = tiles::record(table, g.x());
    let slot = rec.slot;
    let cells = tile + 2 * border;
    let base = slot * cells * cells;
    var sum = 0.0;
    var n = 0.0;
    for (var j = 0; j <= tile; j = j + 1) {
        for (var i = 0; i <= tile; i = i + 1) {
            if ((i & 1) == 0 && (j & 1) == 0) { continue; }
            let x0 = i & -2;
            let y0 = j & -2;
            let x1 = min(x0 + 2, tile);
            let y1 = min(y0 + 2, tile);
            let fx = ((i - x0) as f32) * 0.5;
            let fy = ((j - y0) as f32) * 0.5;
            let e = mix(mix(surface_at(pos, base, cells, border, x0, y0), surface_at(pos, base, cells, border, x1, y0), fx),
                        mix(surface_at(pos, base, cells, border, x0, y1), surface_at(pos, base, cells, border, x1, y1), fx), fy);
            let r = surface_at(pos, base, cells, border, i, j) - e;
            sum = sum + r * r;
            n = n + 1.0;
        }
    }
    let colour = sqrt((spread[g.x()] as f32) / SPREAD_ONE / texel_count) / contrast * rec.extent / sqrt(texel_count);
    spread[g.x()] = 0;
    detail[slot] = max(detail_ratio(rec.level) * sqrt(sum / n), colour);
}

// ── On the CPU ──────────────────────────────────────────────────────────────

// Anchors (anchor.bk) for the GPU's work, found in f64: anchor i at the base
// point src[6i..6i+3] (base coordinates, exact) whose direction rounded to
// f32 is src[6i+3..6i+6], into `out` in read_anchor's layout.
@kernel @cpu @grid(1)
fn k_anchors(g: grid<1>, src: read_store<f64, 1>, out: write_store<i32, 1>, radius: f64) {
    let i = g.x() * 6;
    let base = vec3<f64>(src[i], src[i + 1], src[i + 2]);
    let dir = vec3<f32>(src[i + 3] as f32, src[i + 4] as f32, src[i + 5] as f32);
    write_anchor(out, g.x(), anchor_of(base, dir, radius));
}

// The ground height under a point, for the camera (run over a grid of one).
@kernel @cpu @grid(1)
fn k_height(g: grid<1>, x: f64, y: f64, z: f64, radius: f64, octaves: f64, seed: i32, net: read_store<f32, 1>) -> f64 {
    let dir = normalize(vec3<f64>(x, y, z));
    let a = anchor_at(dir, radius);
    let e = plane_offset(a, a.lost);
    return max(terrain(a, e, radius as f32, octaves as f32, seed, net), 0.0) as f64;
}
