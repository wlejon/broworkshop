// The planet's kernels: each tile's cells from the ground (ground.bk). The
// tile kernels produce a whole batch in one dispatch (bro.tiles' produce):
// grid z is the tile's record in the batch table (tiles-api.js), whose slot
// says where in the pools, viewed as [cells, cells, capacity], it goes.
from planet::ground import terrain, terrain_shaped, cell_height, spread, expected_surface, expected_cover, gradient,
                           variation, strata, octaves_for, range_margin, fresh_water, noise_at, simplex_anchor;
from planet::relief import BASE_WAVELENGTH, RIDGE_FIRST, WARP_OCTAVE, WARP_DISPLACE, simplex_grad, SimplexAt;
from planet::rivers import water_at, water_share;

// A batch table record's float64s.
const RECORD: i32 = 24;

fn record_vec(table: read_store<f64, 1>, at: i32) -> vec3<f64> {
    return vec3<f64>(table[at], table[at + 1], table[at + 2]);
}

// Cell (x, y) of a tile at (s, t) = ((x, y) - border) / tileSize across the
// tile's frame. Its vertex is the ground's true surface at that point, every
// octave down to `truth`: a parent's vertices are every other vertex of its
// children, so refining only adds vertices between the ones already drawn,
// and none of those moves; what is finer than the vertices, a tile shades
// with (the detail layer, below). Written as the vertex's position relative
// to the tile's center and its height (sea level clamps the surface, not
// the height). The tile's surface heights gather in `span` for k_range: two
// int32 per record, INT_MAX less the lowest's float bits and the highest's
// (a surface never lies below sea level, and non-negative floats order as
// their bits). And into `relief`, for the ground's shader, which adds the
// relief's octaves finer than its texels (ground_mesh.bk): where the cell is
// in the relief's noise (ground.bk relief), from the tile's centre, through
// the warp (xyz); and how much the ground there moves with the octaves (w's
// bits: ground.bk terrain_shaped, below FINE_FIRST in the low 16 bits, from
// it on in the high, each -0.5 to 1 as a unorm).
@kernel @grid(3)
fn k_tile(g: grid<3>, table: read_store<f64, 1>, out: write_store<vec4<f32>, 3>, relief: write_store<vec4<f32>, 3>,
          span: rw_store<i32, 1>, radius: f64, border: f64, inv_size: f64, truth: f64, seed: i32, net: read_store<f32, 1>) {
    let r = g.z() * RECORD;
    let slot = table[r] as i32;
    let c = record_vec(table, r + 8);
    let u = record_vec(table, r + 11);
    let v = record_vec(table, r + 14);
    let center = record_vec(table, r + 17);
    let s = (g.x() as f64 - border) * inv_size;
    let t = (g.y() as f64 - border) * inv_size;
    let dir = normalize(c + u * s + v * t);
    let shaped = terrain_shaped(dir, radius, truth, seed, net);
    let h = shaped.x;
    let p = dir * (radius + max(h, 0.0)) - center;
    out[g.x(), g.y(), slot] = vec4<f32>(p.x as f32, p.y as f32, p.z as f32, h as f32);
    let scales = unorm(((shaped.y as f32) + 0.5) / 1.5, 16) | (unorm(((shaped.z as f32) + 0.5) / 1.5, 16) << 16);
    let dq = relief_point(dir, radius, seed) - relief_point(normalize(center), radius, seed);
    relief[g.x(), g.y(), slot] = vec4<f32>(dq.x as f32, dq.y as f32, dq.z as f32, bitcast<f32>(scales));
    let bits = bitcast<i32>(max(h as f32, 0.0));
    span.atomic_max(2 * g.z(), 2147483647 - bits);
    span.atomic_max(2 * g.z() + 1, bits);
}

// ── The detail layer ────────────────────────────────────────────────────────
//
// What a tile shades with, at `d` texels along each cell's edge: finer than
// its vertices, so a coarse tile lights and colours as the ground it stands
// for does. A tile's texels form an (n * d)^2 image over its cells, texel
// (tx, ty) centred at cell coordinate ((tx, ty) + 0.5) / d - 0.5 (cell (x, y)
// is the vertex at (x, y)). Each texel holds two words: the mean colour of
// the truth under it (rgb, and how much is water; 8 bits each) and the
// normal of the ground's mean surface over it (octahedral, 12 bits a
// component) with the share of it under forest (8 bits), all taken from
// the texels' mean heights.

// Texel (tx, ty)'s frame coordinates (s, t) and its direction.
fn texel_dir(table: read_store<f64, 1>, r: i32, tx: i32, ty: i32, border: f64, inv_size: f64, d: f64) -> vec3<f64> {
    let s = ((tx as f64 + 0.5) / d - 0.5 - border) * inv_size;
    let t = ((ty as f64 + 0.5) / d - 0.5 - border) * inv_size;
    return normalize(record_vec(table, r + 8) + record_vec(table, r + 11) * s + record_vec(table, r + 14) * t);
}

// The mean height of each texel of a batch into `heights`, the batch's
// tiles one after another, (n * d)^2 each.
@kernel @grid(3)
fn k_detail_height(g: grid<3>, table: read_store<f64, 1>, heights: write_store<f32, 1>,
                   radius: f64, border: f64, inv_size: f64, d: f64, seed: i32, net: read_store<f32, 1>) {
    let r = g.z() * RECORD;
    let w = g.width();
    let tx = g.x();
    let ty = g.y();
    let c = record_vec(table, r + 8);
    let u = record_vec(table, r + 11);
    let v = record_vec(table, r + 14);
    let cell = inv_size / d;
    let s = ((tx as f64 + 0.5) / d - 0.5 - border) * inv_size;
    let t = ((ty as f64 + 0.5) / d - 0.5 - border) * inv_size;
    let octaves = octaves_for(table[r + 20], cell);
    heights[(g.z() * w + ty) * w + tx] = cell_height(c, u, v, s, t, cell, radius, octaves, seed, net) as f32;
}

// Texel (tx, ty)'s point of the mean surface, relative to the tile's center.
fn texel_point(table: read_store<f64, 1>, heights: read_store<f32, 1>, r: i32, z: i32, w: i32, tx: i32, ty: i32,
               radius: f64, border: f64, inv_size: f64, d: f64, center: vec3<f64>) -> vec3<f32> {
    let x = clamp(tx, 0, w - 1);
    let y = clamp(ty, 0, w - 1);
    let h = heights[(z * w + y) * w + x] as f64;
    let p = texel_dir(table, r, x, y, border, inv_size, d) * (radius + max(h, 0.0)) - center;
    return vec3<f32>(p.x as f32, p.y as f32, p.z as f32);
}

// 0 to 1 into `bits` bits, rounded.
fn unorm(x: f32, bits: i32) -> i32 {
    let top = ((1 << bits) - 1) as f32;
    return (clamp(x, 0.0, 1.0) * top + 0.5) as i32;
}

// A tile's detail layer from the texels' mean heights: each texel's
// gradient from its neighbours', its spreads from the octaves it does not
// resolve, and the expected surface over them, with the mean surface's
// normal.
@kernel @grid(3)
fn k_detail(g: grid<3>, table: read_store<f64, 1>, heights: read_store<f32, 1>, out: write_store<i32, 1>,
            radius: f64, border: f64, inv_size: f64, d: f64, truth: f32, seed: i32, net: read_store<f32, 1>) {
    let r = g.z() * RECORD;
    let z = g.z();
    let w = g.width();
    let slot = table[r] as i32;
    let center = record_vec(table, r + 17);
    let tx = g.x();
    let ty = g.y();
    let octaves = octaves_for(table[r + 20], inv_size / d);
    let du = texel_point(table, heights, r, z, w, tx + 1, ty, radius, border, inv_size, d, center)
           - texel_point(table, heights, r, z, w, tx - 1, ty, radius, border, inv_size, d, center);
    let dv = texel_point(table, heights, r, z, w, tx, ty + 1, radius, border, inv_size, d, center)
           - texel_point(table, heights, r, z, w, tx, ty - 1, radius, border, inv_size, d, center);
    let dir = texel_dir(table, r, tx, ty, border, inv_size, d);
    let up = vec3<f32>(dir.x as f32, dir.y as f32, dir.z as f32);
    let sp = spread(dir, radius, octaves, truth, seed);
    let h = heights[(z * w + ty) * w + tx];
    // du and dv span two texels.
    let grad = gradient(du, dv, up);
    let trend = grad * length(du) * 0.5;
    let sd = sqrt(sp.x * sp.x + trend * trend / 12.0);
    var col = expected_surface(h, grad, length(du) * 0.5, sp.x, sp.y, variation(dir, radius, octaves, seed),
                               strata(dir, radius, h, sd, seed));
    // The rivers and lakes: the share of the texel under their water, a
    // river as deep as its channel runs there (shallow at its banks, its bed
    // showing through), a lake as deep as its water stands over its
    // valley's bed (rivers.bk lake_surface).
    let wa = water_at(dir, radius, length(du) * 0.5, net, seed);
    let water = water_share(h, wa, sd);
    col = vec4<f32>(mix(col.xyz, fresh_water(max(max(wa.near.w, wa.channel), 0.3)), water), max(col.w, water));
    let cover = expected_cover(h, grad, length(du) * 0.5, sp.x, sp.y) * (1.0 - water);
    var n = normalize(cross(du, dv));
    if (dot(n, up) < 0.0) { n = -n; }
    // Octahedral: the normal onto the octahedron |x| + |y| + |z| = 1, its
    // lower half folded over, x and y 0 to 1.
    let a = n / (abs(n.x) + abs(n.y) + abs(n.z));
    var ox = a.x;
    var oy = a.y;
    if (a.z < 0.0) {
        ox = (1.0 - abs(a.y)) * sign(a.x);
        oy = (1.0 - abs(a.x)) * sign(a.y);
    }
    let at = ((slot * w + ty) * w + tx) * 2;
    out[at] = unorm(col.x, 8) | (unorm(col.y, 8) << 8) | (unorm(col.z, 8) << 16) | (unorm(col.w, 8) << 24);
    // The normal in 12 bits a coordinate, the forest's cover in the top 8.
    out[at + 1] = unorm(ox * 0.5 + 0.5, 12) | (unorm(oy * 0.5 + 0.5, 12) << 12) | (unorm(cover, 8) << 24);
}

// ── The relief anchors ──────────────────────────────────────────────────────
//
// Where a direction is in the relief's noise (ground.bk relief: the point,
// in the noise's units, moved by the warp), before any octave's scale.
fn relief_point(dir: vec3<f64>, radius: f64, seed: i32) -> vec3<f64> {
    let p = dir * (radius / (BASE_WAVELENGTH as f64));
    let wq = p * exp2(WARP_OCTAVE as f64);
    let warp = vec3<f64>(noise_at(wq, seed + 400), noise_at(wq, seed + 401), noise_at(wq, seed + 402));
    return p + warp * (WARP_DISPLACE as f64);
}

// Where a tile's centre is on the lattices of the relief's noise, for the
// ground's shader, which adds per pixel the ridged octaves finer than the
// tile's texels (ground_mesh.bk) from each cell's offset (k_tile's relief
// layer): the f64 half of the noise, once a tile, from which the shader runs
// the rest in f32 (relief.bk). The ridge octaves' lattices are each twice the
// last, so one anchor gives every finer octave's exactly. ANCHOR_WORDS int32
// a slot, as five vec4s:
//   0 the ridge octaves' lattice cell at octave o_a (xyz), o_a (w)
//   1 the offset in it (xyz, float bits), the octaves the texels carry (w)
//   2-4 the warp's x, y and z noise's gradients per unit of p, times
//       WARP_DISPLACE: the warp's stretch, which the shader's gradients take
const ANCHOR_WORDS: i32 = 20;
fn f32_bits(x: f32) -> i32 {
    return bitcast<i32>(x);
}
@kernel @grid(1)
fn k_anchor(g: grid<1>, table: read_store<f64, 1>, out: write_store<i32, 1>, radius: f64, inv_size: f64, d: f64, seed: i32) {
    let r = g.x() * RECORD;
    let slot = table[r] as i32;
    let dir = normalize(record_vec(table, r + 17));
    let oct = octaves_for(table[r + 20], inv_size / d);
    // An octave broader than the texels': they still hold less of it than
    // a pixel does.
    let o_a = max((floor(oct) as i32) - 1, RIDGE_FIRST);
    let ra = simplex_anchor(relief_point(dir, radius, seed) * exp2(o_a as f64));
    let wa = simplex_anchor(dir * (radius / (BASE_WAVELENGTH as f64)) * exp2(WARP_OCTAVE as f64));
    let k = WARP_DISPLACE * exp2(WARP_OCTAVE as f32);
    let gx = simplex_grad(wa, seed + 400).yzw * k;
    let gy = simplex_grad(wa, seed + 401).yzw * k;
    let gz = simplex_grad(wa, seed + 402).yzw * k;
    let at = slot * ANCHOR_WORDS;
    out[at] = ra.cell.x;
    out[at + 1] = ra.cell.y;
    out[at + 2] = ra.cell.z;
    out[at + 3] = o_a;
    out[at + 4] = f32_bits(ra.sk.x);
    out[at + 5] = f32_bits(ra.sk.y);
    out[at + 6] = f32_bits(ra.sk.z);
    out[at + 7] = f32_bits(oct as f32);
    out[at + 8] = f32_bits(gx.x);
    out[at + 9] = f32_bits(gx.y);
    out[at + 10] = f32_bits(gx.z);
    out[at + 11] = 0;
    out[at + 12] = f32_bits(gy.x);
    out[at + 13] = f32_bits(gy.y);
    out[at + 14] = f32_bits(gy.z);
    out[at + 15] = 0;
    out[at + 16] = f32_bits(gz.x);
    out[at + 17] = f32_bits(gz.y);
    out[at + 18] = f32_bits(gz.z);
    out[at + 19] = 0;
}

// ── The horizon layer ───────────────────────────────────────────────────────
//
// How high the ground rises around a point, which the ground shader turns
// into how much of the sun and of the sky it sees: at every other cell of a
// tile (an n^2 grid, point (i, j) at cell (2i, 2j)), the sine of the
// horizon's elevation in HZ_DIRS directions of the tile's grid, the k-th
// along (cos, sin)(k * 45 degrees) in cells (the frame's u and v, which the
// shader maps the sun into), each 16 bits, two to a word: four words, then
// four more holding the far horizon alone.
//
// Each tile marches its horizons through one grid of the ground's heights at
// its cells, HZ_MARGIN cells past the tile on every side, at the octaves the
// tile shades with (k_horizon_heights): a height a cell holds is shared by
// every ray that passes it, where sampling the ground per ray cost each tile
// six times the evaluations. Steps are 2^(1/8) apart from a cell out: the
// near band to 8 cells, the far band from 8 to 16 cells.
//
// The far horizon, over distances from 8 cells out, is what a child
// inherits: read bilinearly from its parent's grid at the same point (the
// parent's points are 4 child cells apart, and what lies 16 child cells or
// more away changes little across that), widened by the child's own far
// band. As the parent's far band is 16 to 32 child cells, its
// parent's the next octave out, a point's horizon spans every distance from
// a cell to its root's. The horizon the ground is shaded by adds the near
// band, marched from the point itself: interpolated, a near ridge's horizon
// would spill onto the valley beside it.
const HZ_DIRS: i32 = 8;
const HZ_STEPS: i32 = 32;    // a cell to 16 cells, a factor 2^(1/8) apart
const HZ_NEAR: i32 = 24;     // of them, the near band's
const HZ_MARGIN: i32 = 16;   // cells of heights past the tile, beyond the farthest step from its points
const HZ_WORDS: i32 = 16;    // a point's: 4 of full horizons, 8 of far ones, its height, 3 unused

// The tile's direction at cell coordinate (cx, cy) (cell 0 the drawn edge).
fn cell_dir(table: read_store<f64, 1>, r: i32, cx: f64, cy: f64, inv_size: f64) -> vec3<f64> {
    return normalize(record_vec(table, r + 8) + record_vec(table, r + 11) * (cx * inv_size)
                     + record_vec(table, r + 14) * (cy * inv_size));
}

// The heights the horizons march through: an e^2 grid a tile, point (x, y)
// at cell (x, y) - HZ_MARGIN, the surface at the tile's octaves plus one.
@kernel @grid(3)
fn k_horizon_heights(g: grid<3>, table: read_store<f64, 1>, heights: write_store<f32, 1>,
                     radius: f64, inv_size: f64, seed: i32, net: read_store<f32, 1>) {
    let r = g.z() * RECORD;
    let e = g.width();
    let m = HZ_MARGIN as f64;
    let dir = cell_dir(table, r, g.x() as f64 - m, g.y() as f64 - m, inv_size);
    let octaves = octaves_for(table[r + 20], inv_size) + 2.0;
    heights[(g.z() * e + g.y()) * e + g.x()] = max(terrain(dir, radius, octaves, seed, net), 0.0) as f32;
}

// The height grid bilinearly at cell coordinate (cx, cy).
fn grid_height(heights: read_store<f32, 1>, base: i32, e: i32, cx: f32, cy: f32) -> f32 {
    let gx = cx + (HZ_MARGIN as f32);
    let gy = cy + (HZ_MARGIN as f32);
    let ix = min(floor(gx) as i32, e - 2);
    let iy = min(floor(gy) as i32, e - 2);
    let fx = gx - (ix as f32);
    let fy = gy - (iy as f32);
    let at = base + iy * e + ix;
    let top = mix(heights[at], heights[at + 1], fx);
    let bottom = mix(heights[at + e], heights[at + e + 1], fx);
    return mix(top, bottom, fy);
}

// A far horizon's word: its sine (16 bits) and the log2 of its distance in
// metres (16 bits over 0 to HZ_LOG_RANGE).
const HZ_LOG_RANGE: f32 = 24.0;

fn hz_pack_far(s: f32, d: f32) -> i32 {
    return unorm(s * 0.5 + 0.5, 16) | (unorm(clamp(log2(max(d, 1.0)) / HZ_LOG_RANGE, 0.0, 1.0), 16) << 16);
}

// The sine of direction k's far horizon at point (gx, gy) of tile `slot`,
// as seen from height `h` instead of the point's own: the occluder stays
// where it is (its distance kept with it), the eye moves up or down.
fn hz_read_far(hz: rw_store<i32, 1>, slot: i32, n: i32, gx: i32, gy: i32, k: i32, h: f32) -> f32 {
    let at = ((slot * n + gy) * n + gx) * HZ_WORDS;
    let word = hz[at + 4 + k];
    let s = ((word & 65535) as f32) / 65535.0 * 2.0 - 1.0;
    if (s <= -1.0) { return -1.0; }
    let d = exp2((((word >> 16) & 65535) as f32) / 65535.0 * HZ_LOG_RANGE);
    let rise = d * s + bitcast<f32>(hz[at + 12]) - h;
    let run = d * sqrt(max(1.0 - s * s, 0.0));
    return rise / sqrt(rise * rise + run * run);
}

@kernel @grid(3)
fn k_horizon(g: grid<3>, table: read_store<f64, 1>, heights: read_store<f32, 1>, hz: rw_store<i32, 1>,
             e: i32, radius: f64, border: f64, inv_size: f64) {
    let r = g.z() * RECORD;
    let slot = table[r] as i32;
    let parent = table[r + 1] as i32;
    let n = g.width();
    let hbase = g.z() * e * e;
    let x = g.x() * 2;
    let y = g.y() * 2;
    let cx = (x as f64) - border;
    let cy = (y as f64) - border;
    // The point, and the frame as offsets from it: a sample at cell offset
    // (dx, dy) lies along normalize(base + au * dx + av * dy) * |base|, base
    // the frame at the point. au, av are small beside 1, and the march works
    // in them alone (f32, exact to the metre on the finest tiles).
    let base = record_vec(table, r + 8) + record_vec(table, r + 11) * (cx * inv_size)
               + record_vec(table, r + 14) * (cy * inv_size);
    let len = length(base);
    let dir = base / len;
    let n32 = vec3<f32>(dir.x as f32, dir.y as f32, dir.z as f32);
    let au64 = record_vec(table, r + 11) * (inv_size / len);
    let av64 = record_vec(table, r + 14) * (inv_size / len);
    let au = vec3<f32>(au64.x as f32, au64.y as f32, au64.z as f32);
    let av = vec3<f32>(av64.x as f32, av64.y as f32, av64.z as f32);
    let rad = radius as f32;
    let h = grid_height(heights, hbase, e, cx as f32, cy as f32);
    // This point on the parent's grid: the parent's cells are twice as wide,
    // and the tile is its quadrant (table 6, 7).
    let half = 0.5 / inv_size;
    let gx = (cx * 0.5 + table[r + 6] * half + border) * 0.5;
    let gy = (cy * 0.5 + table[r + 7] * half + border) * 0.5;
    let ix = floor(gx) as i32;
    let iy = floor(gy) as i32;
    let ix1 = min(ix + 1, n - 1);
    let iy1 = min(iy + 1, n - 1);
    let fx = (gx - floor(gx)) as f32;
    let fy = (gy - floor(gy)) as f32;
    // The parent point nearest, whose far horizon's distance an inherited
    // one keeps.
    var jx = ix;
    if (fx >= 0.5) { jx = ix1; }
    var jy = iy;
    if (fy >= 0.5) { jy = iy1; }
    let at = ((slot * n + g.y()) * n + g.x()) * HZ_WORDS;
    var w0: i32 = 0;
    var w1: i32 = 0;
    var w2: i32 = 0;
    var w3: i32 = 0;
    for (var k: i32 = 0; k < HZ_DIRS; k += 1) {
        let a = (k as f64) * 0.78539816339744831;
        let ca = cos(a) as f32;
        let sa = sin(a) as f32;
        var far: f32 = -1.0;
        var far_d: f32 = 1.0;
        if (parent >= 0) {
            let top = mix(hz_read_far(hz, parent, n, ix, iy, k, h), hz_read_far(hz, parent, n, ix1, iy, k, h), fx);
            let bottom = mix(hz_read_far(hz, parent, n, ix, iy1, k, h), hz_read_far(hz, parent, n, ix1, iy1, k, h), fx);
            far = mix(top, bottom, fy);
            let word = hz[((parent * n + jy) * n + jx) * HZ_WORDS + 4 + k];
            far_d = exp2((((word >> 16) & 65535) as f32) / 65535.0 * HZ_LOG_RANGE);
        }
        var near: f32 = -1.0;
        for (var i: i32 = 0; i < HZ_STEPS; i += 1) {
            let d = exp2((i as f32) * 0.125);
            let dx = ca * d;
            let dy = sa * d;
            let hq = grid_height(heights, hbase, e, (cx as f32) + dx, (cy as f32) + dy);
            // The sample's direction less the point's, from the offset alone.
            let off = au * dx + av * dy;
            let grow = 2.0 * dot(n32, off) + dot(off, off);
            let l = sqrt(1.0 + grow);
            let delta = (off - n32 * (grow / (l + 1.0))) / l;
            let to = delta * (rad + hq) + n32 * (hq - h);
            let s = dot(to, n32) / length(to);
            if (i < HZ_NEAR) { near = max(near, s); }
            else if (s > far) { far = s; far_d = length(to); }
        }
        hz[at + 4 + k] = hz_pack_far(far, far_d);
        let full = unorm(max(near, far) * 0.5 + 0.5, 16) << (16 * (k % 2));
        let wk = k / 2;
        if (wk == 0) { w0 = w0 | full; } else if (wk == 1) { w1 = w1 | full; }
        else if (wk == 2) { w2 = w2 | full; } else { w3 = w3 | full; }
    }
    hz[at] = w0;
    hz[at + 1] = w1;
    hz[at + 2] = w2;
    hz[at + 3] = w3;
    hz[at + 12] = bitcast<i32>(h);
}


// The range the surface of a tile and of every tile below it lies in, into
// the cache's ranges at 2 * slot: the surface heights k_tile gathered,
// widened by what finer octaves can still add (ground.bk range_margin), at
// most `top`. It clears the tile's `span` for the next batch.
@kernel @grid(1)
fn k_range(g: grid<1>, table: read_store<f64, 1>, span: rw_store<i32, 1>, ranges: write_store<f32, 1>,
           inv_size: f64, top: f32) {
    let r = g.x() * RECORD;
    let slot = table[r] as i32;
    let lo = bitcast<f32>(2147483647 - span[2 * g.x()]);
    let hi = bitcast<f32>(span[2 * g.x() + 1]);
    span[2 * g.x()] = 0;
    span[2 * g.x() + 1] = 0;
    let margin = range_margin(octaves_for(table[r + 20], inv_size), top);
    ranges[2 * slot] = max(lo - margin, 0.0);
    ranges[2 * slot + 1] = min(hi + margin, top);
}

// The ground height under a point, for the camera (on the CPU: run over a
// grid of one).
@kernel @grid(1)
fn k_height(g: grid<1>, x: f64, y: f64, z: f64, radius: f64, octaves: f64, seed: i32, net: read_store<f32, 1>) -> f64 {
    return max(terrain(normalize(vec3<f64>(x, y, z)), radius, octaves, seed, net), 0.0);
}
