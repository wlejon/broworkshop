// demos/foundry/shaders/foundry_cage.bk — Razor-sharp holographic CAD bounding cage.
// Zero glossy face reflection (unlit emissive wireframe + corner L-brackets only)
// so internal machined parts stay 100% crystal clear at every viewing angle.

module hook;
import mesh;
import scene;

struct CageParams {
    tint: vec4<f32>,    // rgb color, w = intensity
    pulse: f32,         // 0..1 alert pulse
    time: f32,
    xray: f32,          // 1 = clear wireframe cage, 0 = subtle technical housing tint
    pad0: f32,
}

@binding(4, 0) var params: uniform<CageParams>;

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    v.v0 = vec4<f32>(v_in.pos, 0.0);
    v.v1 = vec4<f32>(v_in.uv.x, v_in.uv.y, 0.0, 0.0);
    return v;
}

pub fn fragment(v: mesh::Vertex, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    let uv = v.v1.xy;
    let dx = min(uv.x, 1.0 - uv.x);
    let dy = min(uv.y, 1.0 - uv.y);
    let edge_d = min(dx, dy);

    // Thin razor-sharp CAD wireframe border + precision corner L-brackets
    let border = 1.0 - smoothstep(0.005, 0.015, edge_d);
    let corner_mask = (1.0 - smoothstep(0.10, 0.14, dx)) * (1.0 - smoothstep(0.10, 0.14, dy));
    let corner_line = corner_mask * (1.0 - smoothstep(0.012, 0.026, edge_d));
    let line = max(border * 0.72, corner_line);

    // Subtle diagonal blueprint hatch ONLY during active alerts or solid-housing toggle
    let hatch = smoothstep(0.93, 0.99, sin((uv.x + uv.y) * 56.0 - params.time * 2.4) * 0.5 + 0.5);
    let wave = 0.84 + 0.16 * sin(params.time * 6.5) * params.pulse;

    let fill_alpha = params.xray > 0.5
        ? (0.04 * hatch * params.pulse)
        : (0.14 + 0.05 * hatch);

    let alpha = clamp(max(fill_alpha, line * (0.82 + 0.18 * params.pulse)), 0.0, 0.92);
    let c = params.tint.xyz * params.tint.w * wave;

    // Pure unlit emissive wireframe — ZERO specular/diffuse glare on flat transparent faces!
    out.base_color = vec3<f32>(0.0, 0.0, 0.0);
    out.roughness = 1.0;
    out.metallic = 0.0;
    out.sky_visibility = 0.0;
    out.emissive = c * (line * 1.15 + fill_alpha * 0.9);
    out.alpha = alpha;
    return out;
}
