// demos/foundry/shaders/foundry_floor.bk — Industrial brushed steel workshop deck
// & armored BattleBox arena floor with team starting boxes, hazard stripes, center ring,
// and seamless radial studio fade into the dark charcoal backdrop.

module hook;
import mesh;
import scene;

struct FloorParams {
    major_step: f32,    // major grid spacing in metres
    minor_div: f32,     // subdivisions per major cell
    radius: f32,        // radial studio fade / arena half-size
    arena_mode: f32,    // 0 = precision engineering bench, 1 = armored battlebox arena
}

@binding(4, 0) var params: uniform<FloorParams>;

fn grid_line(coord: f32, step: f32, width: f32) -> f32 {
    let u = abs(fract(coord / step + 0.5) - 0.5) * step;
    return 1.0 - smoothstep(width * 0.45, width * 1.35, u);
}

fn box_outline(p: vec2<f32>, c: vec2<f32>, h: vec2<f32>, w: f32) -> f32 {
    let d = abs(p - c) - h;
    let out_d = max(d.x, d.y);
    return (1.0 - smoothstep(w * 0.4, w, abs(out_d))) * step(out_d, w);
}

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    v.v0 = vec4<f32>(v_in.pos, 0.0);
    return v;
}

pub fn fragment(v: mesh::Vertex, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    // Use object-space plane coordinates (v.v0.xyz) centered cleanly at (0, 0) on the floor!
    let wp = v.v0.xyz;
    let x = wp.x;
    let z = wp.z;

    let step = max(0.02, params.major_step);
    let minor_step = step / max(2.0, params.minor_div);

    let maj = max(grid_line(x, step, step * 0.015), grid_line(z, step, step * 0.015));
    let min_l = max(grid_line(x, minor_step, step * 0.006), grid_line(z, minor_step, step * 0.006));
    let axis_x = 1.0 - smoothstep(step * 0.012, step * 0.028, abs(z));
    let axis_z = 1.0 - smoothstep(step * 0.012, step * 0.028, abs(x));

    // Brushed steel deck plate grain + subtle tile reflectance variation
    let grain = sin(x * 23.0 + z * 9.0) * 0.5 + sin(x * 61.0 - z * 47.0) * 0.5;
    let plate_var = sin(floor(x / step) * 12.7 + floor(z / step) * 31.3) * 0.5 + 0.5;
    let scuff = sin(x * 3.7 - z * 2.9) * cos(x * 1.9 + z * 4.3);

    var col = vec3<f32>(0.044, 0.052, 0.066) * (0.90 + 0.16 * plate_var + 0.03 * grain);
    var rough = 0.58 + 0.09 * plate_var - 0.04 * grain + 0.04 * scuff;
    var metal = 0.36;
    var emis = vec3<f32>(0.0);

    let dist = length(vec2<f32>(x, z));

    if (params.arena_mode > 0.5) {
        // Armored BattleBox floor: weathered steel plates + hazard perimeter + team boxes + center ring!
        let edge_d = max(abs(x), abs(z));
        let in_hazard = smoothstep(params.radius - 0.52, params.radius - 0.47, edge_d) *
                        (1.0 - smoothstep(params.radius - 0.04, params.radius, edge_d));
        let stripe = smoothstep(-0.08, 0.08, sin((x + z) * 9.0));
        let haz_col = mix(vec3<f32>(0.038, 0.040, 0.046), vec3<f32>(0.78, 0.54, 0.06), stripe);
        col = mix(col, haz_col, in_hazard * 0.92);

        // Team Amber (-X) and Team Cyan (+X) starting squares
        let p2 = vec2<f32>(x, z);
        let box_l = box_outline(p2, vec2<f32>(-2.4, 0.0), vec2<f32>(0.72, 0.72), 0.045);
        let box_r = box_outline(p2, vec2<f32>( 2.4, 0.0), vec2<f32>(0.72, 0.72), 0.045);
        col = mix(col, vec3<f32>(0.88, 0.50, 0.08), box_l * 0.85);
        col = mix(col, vec3<f32>(0.16, 0.62, 0.92), box_r * 0.85);
        emis += vec3<f32>(0.45, 0.24, 0.03) * box_l * 0.30;
        emis += vec3<f32>(0.06, 0.28, 0.45) * box_r * 0.30;

        // Center combat ring + inner target dashes
        let ring_outer = 1.0 - smoothstep(0.022, 0.052, abs(dist - 1.95));
        let ring_inner = 1.0 - smoothstep(0.015, 0.038, abs(dist - 0.85));
        let cross = max(axis_x, axis_z) * smoothstep(2.15, 1.80, dist) * smoothstep(0.35, 0.55, dist);
        let mark = max(ring_outer, max(ring_inner * 0.65, cross * 0.75));
        col = mix(col, vec3<f32>(0.74, 0.48, 0.08), mark * 0.68);
        emis += vec3<f32>(0.42, 0.26, 0.03) * ring_outer * 0.25;

        // Steel plate weld seams
        col = mix(col, vec3<f32>(0.10, 0.12, 0.15), maj * 0.58);
        col = mix(col, vec3<f32>(0.072, 0.086, 0.105), min_l * 0.24);
        rough = mix(rough, 0.74, in_hazard);
    } else {
        // Precision CAD bench deck with smooth seamless fade into dark studio backdrop!
        let fade = 1.0 - smoothstep(params.radius * 0.24, params.radius * 0.68, dist);
        col = mix(col, vec3<f32>(0.075, 0.092, 0.120), min_l * 0.42 * fade);
        col = mix(col, vec3<f32>(0.13, 0.17, 0.22), maj * 0.72 * fade);
        col = mix(col, vec3<f32>(0.18, 0.44, 0.78), axis_z * 0.62 * fade);
        col = mix(col, vec3<f32>(0.72, 0.30, 0.20), axis_x * 0.52 * fade);
        emis += vec3<f32>(0.07, 0.20, 0.38) * max(axis_x, axis_z) * 0.28 * fade;

        // Fade smoothly into exact studio fog color [0.026, 0.032, 0.042]
        let bg = vec3<f32>(0.026, 0.032, 0.042);
        col = mix(bg, col, fade);
        rough = mix(0.98, rough, fade);
        metal = mix(0.0, metal, fade);
    }

    out.base_color = col;
    out.roughness = rough;
    out.metallic = metal;
    out.emissive = emis;
    out.alpha = 1.0;
    return out;
}
