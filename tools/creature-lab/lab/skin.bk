// The skinning hook every creature draws with: an instanced mesh whose
// instance i is creature i of a pose buffer. Each vertex has up to four
// bones in the `skin` buffer (two vec4 a vertex, by v.vertex_index: the
// weights, then the bone indices). A bone's pose rows [R | p] place its
// rest point v at R (v - head) + p, in the node's space (the instance
// transform applies after).
//
// The bones' transforms are blended as dual quaternions, not as matrices:
// a vertex between two bones turns with them about the joint rather than
// being pulled along the chord, so a bent elbow or hock keeps its girth
// and a twisted joint does not pinch (linear blending lost up to 40% of
// the elbow's section in the deer's trot). lab/form.js places the skin the
// same way on the CPU.
//
// The creature's face (creature::face, lab/face.bk) is drawn per pixel
// from each point's rest position, passed to the fragment in v0.
//
// Three debug views (SceneGraph.setDebugView) show what lab/shots.js reads
// off an image: `normal` (the world normal, n * 0.5 + 0.5), `depth` (the
// distance from the eye in whole centimetres: cm / 64 in red, cm mod 64 in
// green, each as level 4 v + 2, blue full) and `piece` (the body piece a
// vertex belongs to plus one, from the optional `piece` buffer: id mod 16
// in red and id / 16 in blue, each as level 16 v + 8, green full, so the
// body stands apart from the grey of surfaces that do not answer). Levels
// are spaced so a byte or two of error in the render target still decodes;
// each colour is written so the display's 2.2 gamma gives back the byte.
module hook;
import mesh;
import scene;
from creature::skeleton import NB, HEAD;
from creature::face import face;

@binding(4, 14) var pose: read_buffer<vec4<f32>>;
@binding(4, 15) var skin: read_buffer<vec4<f32>>;
@binding(4, 16) var piece: read_buffer<f32>;

// The linear value the sRGB encoding turns into c.
fn lin(c: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(pow(c.x, 2.2), pow(c.y, 2.2), pow(c.z, 2.2));
}

// A byte level written as the colour that comes back as it.
fn level(b: f32) -> f32 { return b / 255.0; }

pub fn fragment(v: mesh::Vertex, s: mesh::Surface) -> mesh::Surface {
    // The face, by the point's rest position (v0) and a pixel's size there.
    let rest = v.v0.xyz;
    var out = face(rest, max(length(dpdx(rest)), length(dpdy(rest))), s);
    if (SCENE_DEBUG(normal)) { out.debug = vec4<f32>(lin(normalize(s.normal) * 0.5 + vec3<f32>(0.5)), 1.0); }
    if (SCENE_DEBUG(depth)) {
        let cm = clamp(floor(length(v.world_pos) * 100.0 + 0.5), 0.0, 4095.0);
        let hi = floor(cm / 64.0);
        out.debug = vec4<f32>(lin(vec3<f32>(level(hi * 4.0 + 2.0), level((cm - hi * 64.0) * 4.0 + 2.0), 1.0)), 1.0);
    }
    if (SCENE_DEBUG(piece)) {
        let id = f32(v.vi.x + 1);
        let hi = floor(id / 16.0);
        out.debug = vec4<f32>(lin(vec3<f32>(level((id - hi * 16.0) * 16.0 + 8.0), 1.0, level(hi * 16.0 + 8.0))), 1.0);
    }
    return out;
}

// The unit quaternion (x, y, z, w) of rotation rows r0, r1, r2.
fn quat_of(r0: vec4<f32>, r1: vec4<f32>, r2: vec4<f32>) -> vec4<f32> {
    let tr = r0.x + r1.y + r2.z;
    if (tr > 0.0) {
        let s = sqrt(tr + 1.0) * 2.0;
        return vec4<f32>((r2.y - r1.z) / s, (r0.z - r2.x) / s, (r1.x - r0.y) / s, 0.25 * s);
    }
    if (r0.x > r1.y && r0.x > r2.z) {
        let s = sqrt(1.0 + r0.x - r1.y - r2.z) * 2.0;
        return vec4<f32>(0.25 * s, (r0.y + r1.x) / s, (r0.z + r2.x) / s, (r2.y - r1.z) / s);
    }
    if (r1.y > r2.z) {
        let s = sqrt(1.0 + r1.y - r0.x - r2.z) * 2.0;
        return vec4<f32>((r0.y + r1.x) / s, 0.25 * s, (r1.z + r2.y) / s, (r0.z - r2.x) / s);
    }
    let s = sqrt(1.0 + r2.z - r0.x - r1.y) * 2.0;
    return vec4<f32>((r0.z + r2.x) / s, (r1.z + r2.y) / s, 0.25 * s, (r1.x - r0.y) / s);
}

// q * (t, 0): the dual part (times 2) of translation t after rotation q.
fn dual_of(q: vec4<f32>, t: vec3<f32>) -> vec4<f32> {
    return vec4<f32>(t * q.w + cross(t, q.xyz), -dot(t, q.xyz));
}

fn rotate(q: vec4<f32>, v: vec3<f32>) -> vec3<f32> {
    let u = cross(q.xyz, v) * 2.0;
    return v + q.w * u + cross(q.xyz, u);
}

pub fn vertex(v_in: mesh::Vertex) -> mesh::Vertex {
    var v = v_in;
    v.v0 = vec4<f32>(v_in.pos, 0.0);
    let k = v.vertex_index;
    let wt = skin[2 * k];
    let ix = skin[2 * k + 1];
    let base = v.instance_index * NB;
    var qr = vec4<f32>(0.0);
    var qd = vec4<f32>(0.0);
    var q0 = vec4<f32>(0.0);
    for (var j: i32 = 0; j < 4; j += 1) {
        let w = wt[j];
        if (w > 0.0) {
            let b = ix[j] as i32;
            let r = 3 * (base + b);
            let r0 = pose[r];
            let r1 = pose[r + 1];
            let r2 = pose[r + 2];
            var q = quat_of(r0, r1, r2);
            if (j == 0) { q0 = q; }
            var s = w;
            if (dot(q, q0) < 0.0) { s = -w; }
            // x' = R x + t with t = p - R head.
            let t = vec3<f32>(r0.w, r1.w, r2.w) - rotate(q, HEAD[b]);
            qr += s * q;
            qd += s * dual_of(q, t);
        }
    }
    let n = length(qr);
    let rq = qr / n;
    let dq = qd / n;
    // The translation: 2 (dual * conj(real)), vector part; dual_of holds it times 2 already.
    let tr = rq.w * dq.xyz - dq.w * rq.xyz + cross(rq.xyz, dq.xyz);
    v.pos = rotate(rq, v.pos) + tr;
    v.normal = normalize(rotate(rq, v.normal));
    var pc = -1;
    if (piece.len() > 0) { pc = piece[k] as i32; }
    v.vi = vec4<i32>(pc, 0, 0, 0);
    return v;
}
