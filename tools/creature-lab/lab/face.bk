// creature::face for a creature without its own: the skin as its coat
// leaves it. A face is drawn per pixel by the skin hooks (lab/skin.bk,
// lab/skin-crowd.bk) from the rest pose's position of the point shaded, so
// its marks ride the head however it moves and stay sharp however coarse
// the mesh under them.
module creature::face;
import mesh;

pub fn face(p: vec3<f32>, foot: f32, s: mesh::Surface) -> mesh::Surface {
    return s;
}
