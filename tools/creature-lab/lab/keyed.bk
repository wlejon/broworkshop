// creature::keyed — a creature posed from keys: the poses its species
// draws (creatures/<name>/poses.js, written out as creature::keys by
// lab/posing.js) sampled, blended and stood on the ground.
//
// A Key is a whole pose in the creature's own frame: where the root is from
// its rest place, every bone's turn from its parent, and for each leg where
// the ball of its foot is (from its rest place, y over the ground) with the
// heel's lift, the toes' pitch and the foot's turn. Legs are not keyed by
// their joints: a leg is solved from its hip to the ball (leg_solve), so a
// foot a rig has planted stays where it is whatever key is drawn over it,
// and a key is drawn by saying where the feet are.
//
// A cycle is keys at phases of a stride; cycle_at reads it at any phase,
// carried through the keys with no corner in any bone's speed.
//
// Legs are chains of four bones from LEG_TOP: thigh, shin, the foot (to the
// ball) and the toe.
module creature::keyed;
import creature::common::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::limbs::*;
import creature::keys::*;

// fa: the heel's lift (rad more than at rest), the toes' pitch (rad down
// from rest) and the foot's turn about the vertical.
pub struct Key { root: vec3<f32>, q: array<vec4<f32>, NB>, foot: array<vec3<f32>, NLEGS>, fa: array<vec3<f32>, NLEGS> }

pub fn key_get(k: i32) -> Key {
    var K: Key;
    K.root = KEY_ROOT[k];
    for (var b: i32 = 0; b < NB; b += 1) { K.q[b] = KEY_Q[k * NB + b]; }
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        K.foot[l] = KEY_FOOT[k * NLEGS + l];
        K.fa[l] = KEY_FA[k * NLEGS + l];
    }
    return K;
}

// From A toward B by t.
pub fn key_mix(A: Key, B: Key, t: f32) -> Key {
    var o: Key;
    o.root = mix(A.root, B.root, t);
    for (var j: i32 = 0; j < NB; j += 1) { o.q[j] = q_norm((1.0 - t) * A.q[j] + t * same_side(B.q[j], A.q[j])); }
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        o.foot[l] = mix(A.foot[l], B.foot[l], t);
        o.fa[l] = mix(A.fa[l], B.fa[l], t);
    }
    return o;
}

// Cycle c at `phase` (cycles): through its keys as a Hermite spline whose
// slope at each key is the chord between its neighbours over their phases,
// so no bone's speed has a corner at a key however the keys are spaced.
pub fn cycle_at(c: i32, phase: f32) -> Key {
    let n = CYC_N[c];
    let o = CYC_AT[c];
    let ph = fract01(phase);
    var i: i32 = n - 1;
    for (var k: i32 = 0; k + 1 < n; k += 1) {
        if (ph >= CYC_PH[o + k] && ph < CYC_PH[o + k + 1]) { i = k; }
    }
    let im = (i + n - 1) % n;
    let ip = (i + 1) % n;
    let iq = (i + 2) % n;
    let p1 = CYC_PH[o + i];
    var p0 = CYC_PH[o + im];
    if (im >= i) { p0 -= 1.0; }
    var p2 = CYC_PH[o + ip];
    if (ip <= i) { p2 += 1.0; }
    var p3 = CYC_PH[o + iq];
    if (p3 <= p2) { p3 += 1.0; }
    let h = max(p2 - p1, 1e-5);
    let t = clamp((ph - p1) / h, 0.0, 1.0);
    let t2 = t * t;
    let t3 = t2 * t;
    let h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    let h10 = t3 - 2.0 * t2 + t;
    let h01 = -2.0 * t3 + 3.0 * t2;
    let h11 = t3 - t2;
    let a = h10 * h / max(p2 - p0, 1e-5);
    let b = h11 * h / max(p3 - p1, 1e-5);
    // (The four keys' weighted mean, each bone read from the keys' tables
    // and written once: built as whole keys added one to the next, the
    // compiler carried every bone of every key through each step, and a rig
    // reading two cycles took eighteen seconds to compile.)
    let k1 = CYC_KEY[o + i];
    let k0 = CYC_KEY[o + im];
    let k2 = CYC_KEY[o + ip];
    let k3 = CYC_KEY[o + iq];
    let w1 = h00 - b;
    let w0 = -a;
    let w2 = h01 + a;
    let w3 = b;
    var S: Key;
    S.root = w1 * KEY_ROOT[k1] + w0 * KEY_ROOT[k0] + w2 * KEY_ROOT[k2] + w3 * KEY_ROOT[k3];
    for (var j: i32 = 0; j < NB; j += 1) {
        let q1 = KEY_Q[k1 * NB + j];
        S.q[j] = q_norm(w1 * q1 + w0 * same_side(KEY_Q[k0 * NB + j], q1) + w2 * same_side(KEY_Q[k2 * NB + j], q1) + w3 * same_side(KEY_Q[k3 * NB + j], q1));
    }
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        S.foot[l] = w1 * KEY_FOOT[k1 * NLEGS + l] + w0 * KEY_FOOT[k0 * NLEGS + l] + w2 * KEY_FOOT[k2 * NLEGS + l] + w3 * KEY_FOOT[k3 * NLEGS + l];
        S.fa[l] = w1 * KEY_FA[k1 * NLEGS + l] + w0 * KEY_FA[k0 * NLEGS + l] + w2 * KEY_FA[k2 * NLEGS + l] + w3 * KEY_FA[k3 * NLEGS + l];
        // (The curve through a foot's lift may dip under the ground beside
        // a key that has it down; a foot does not.)
        S.foot[l].y = max(S.foot[l].y, 0.0);
    }
    return S;
}

// q on r's side of the sphere.
fn same_side(q: vec4<f32>, r: vec4<f32>) -> vec4<f32> {
    if (dot(q, r) < 0.0) { return -q; }
    return q;
}

// Whether leg l is in its stance at `phase` of cycle c, and how far through
// it (0 at touchdown, 1 at lift-off; -1 in its swing).
pub fn cycle_stance(c: i32, l: i32, phase: f32) -> f32 {
    let st = CYC_STANCE[c * NLEGS + l];
    let len = fract01(st.y - st.x);
    let u = fract01(phase - st.x);
    if (u < len) { return u / len; }
    return -1.0;
}

// How far through its swing leg l is (0 at lift-off, 1 at touchdown).
pub fn cycle_swing(c: i32, l: i32, phase: f32) -> f32 {
    let st = CYC_STANCE[c * NLEGS + l];
    let len = fract01(st.y - st.x);
    let u = fract01(phase - st.x);
    return clamp((u - len) / max(1.0 - len, 1e-4), 0.0, 1.0);
}

// The share of its cycle leg l is down.
pub fn cycle_duty(c: i32, l: i32) -> f32 {
    let st = CYC_STANCE[c * NLEGS + l];
    return fract01(st.y - st.x);
}

// --- a gait: two cycles on one clock ------------------------------------------
// Cycles a and b (a walk and a run: both begin at the same foot's touchdown)
// read at one phase and blended by w, their stances' lengths blended with
// them, so a creature goes from one to the other through a stride that is
// some of each.

pub fn gait_at(a: i32, b: i32, w: f32, phase: f32) -> Key {
    return key_mix(cycle_at(a, phase), cycle_at(b, phase), clamp(w, 0.0, 1.0));
}

// Leg l's stance: where in the cycle it begins, and the share it lasts.
fn gait_window(a: i32, b: i32, w: f32, l: i32) -> vec2<f32> {
    let sa = CYC_STANCE[a * NLEGS + l];
    let sb = CYC_STANCE[b * NLEGS + l];
    return vec2<f32>(mix(sa.x, sb.x, w), mix(fract01(sa.y - sa.x), fract01(sb.y - sb.x), w));
}

pub fn gait_stance(a: i32, b: i32, w: f32, l: i32, phase: f32) -> f32 {
    let st = gait_window(a, b, w, l);
    let u = fract01(phase - st.x);
    if (u < st.y) { return u / st.y; }
    return -1.0;
}

pub fn gait_swing(a: i32, b: i32, w: f32, l: i32, phase: f32) -> f32 {
    let st = gait_window(a, b, w, l);
    return clamp((fract01(phase - st.x) - st.y) / max(1.0 - st.y, 1e-4), 0.0, 1.0);
}

pub fn gait_duty(a: i32, b: i32, w: f32, l: i32) -> f32 { return gait_window(a, b, w, l).y; }

// The ground a stance covers.
pub fn gait_span(a: i32, b: i32, w: f32) -> f32 { return mix(CYC_SPAN[a], CYC_SPAN[b], w); }

// --- in the air ---------------------------------------------------------------
// Keys draw a flight's poses; where its mass goes with no foot down is not
// theirs to say. A rig keeps AIR_STATE floats at `at`, stands its keys
// air_lift from where they would be (the root and the feet in the air),
// and after posing hands air_step the pose's centre of mass and whether a
// foot is down. With none down the mass falls freely from the velocity it
// left the ground with, and air_step returns how far to move the pose
// (pose::moved) to have it there; landed, the lift is let go through the
// stance.
pub const AIR_STATE: i32 = 12;  // the mass's place (3), its velocity (3), the lift (3) and its speed (3)
// 1/s the landed lift is let go at: critically damped from the speed it
// came down with, so the body sinks on into its landing and comes back
// rather than meeting the keys' path at a corner.
const AIR_LAND: f32 = 13.0;

// The lift for this step: last step's, let go a step further. (Stepped here,
// before the pose is made, and not after it in air_step: a flight's step
// moves the pose by its fall at once, and a landed step that stood on the
// lift of the step before would skip a step of its motion, a pop in the body
// on every landing.)
pub fn air_lift(st: rw_store<f32, 1>, at: i32, dt: f32) -> vec3<f32> {
    let l0 = ld3(st, at + 6);
    let lv = ld3(st, at + 9) + (-AIR_LAND * AIR_LAND * l0 - 2.0 * AIR_LAND * ld3(st, at + 9)) * dt;
    st3(st, at + 9, lv);
    st3(st, at + 6, l0 + lv * dt);
    return l0 + lv * dt;
}

pub fn air_step(st: rw_store<f32, 1>, at: i32, com: vec3<f32>, grounded: bool, init: bool, dt: f32) -> vec3<f32> {
    if (init) {
        st3(st, at, com);
        st3(st, at + 3, vec3<f32>(0.0));
        st3(st, at + 6, vec3<f32>(0.0));
        st3(st, at + 9, vec3<f32>(0.0));
        return vec3<f32>(0.0);
    }
    if (grounded) {
        st3(st, at + 3, (com - ld3(st, at)) / max(dt, 1e-5));
        st3(st, at, com);
        return vec3<f32>(0.0);
    }
    let v = ld3(st, at + 3) - vec3<f32>(0.0, 9.81 * dt, 0.0);
    let p = ld3(st, at) + v * dt;
    let d = p - com;
    st3(st, at, p);
    st3(st, at + 3, v);
    // (The lift and its speed are what the fall made them, not what
    // air_lift let go this step.)
    st3(st, at + 6, ld3(st, at + 6) + d);
    st3(st, at + 9, ld3(st, at + 9) + d / max(dt, 1e-5));
    return d;
}

// Where K has leg l's ball, for a creature whose rest root stands over
// `org` on the ground, turned by qyaw (y is K's height over org's).
pub fn key_ball(K: Key, l: i32, org: vec3<f32>, qyaw: vec4<f32>) -> vec3<f32> {
    return org + q_rot(qyaw, HEAD[LEG_TOP[l] + 3] + K.foot[l]);
}

// Leg l of P solved from its hip (where P's bones above have put it) to
// `ball`, in the frame qframe (the creature's heading): the foot turned
// `yaw` from the frame with its heel lifted `heel` and its toes pitched
// `toe`, the thigh and shin reaching the hock that leaves, the knee turned
// with the foot. `soft`: the share of the reach where it eases in.
pub fn leg_solve(T: Pose, l: i32, qframe: vec4<f32>, ball: vec3<f32>, heel: f32, toe: f32, yaw: f32, soft: f32) -> Pose {
    var P = T;
    let b0 = LEG_TOP[l];
    let pa = PARENT[b0];
    let j = P.p[pa] + q_rot(P.q[pa], HEAD[b0] - HEAD[pa]);
    let qf = q_mul(qframe, q_y(yaw));
    let hock = ball - q_rot(qf, q_rot(q_x(heel), TAIL[b0 + 2] - HEAD[b0 + 2]));
    let d = q_rot(q_conj(qframe), hock - j);
    let pl = leg_plane(b0, b0 + 1, d);
    let sol = two_bone_soft(rest_len(b0), rest_len(b0 + 1), vec2<f32>(pl.y, pl.z), 1.0, soft);
    let qr = q_mul(qframe, q_z(pl.x));
    let ax = normalize(j - hock);
    let qknee = vec4<f32>(ax * sin(0.5 * yaw), cos(0.5 * yaw));
    // (The thigh's range is its joint's, from the bone it hangs from: a
    // pelvis leaned back, sitting, leaves the thigh that much more to rise.)
    let up = q_rot(q_mul(q_conj(qframe), P.q[pa]), vec3<f32>(0.0, 1.0, 0.0));
    let lean = atan2(up.z, up.y);
    let a0 = lean + soft_range(-(sol.x - rest_angle(b0)) - lean, LIM_LO[b0].x, LIM_HI[b0].x, 0.12);
    let a1 = soft_range(-(sol.y - rest_angle(b0 + 1)) - a0, LIM_LO[b0 + 1].x, LIM_HI[b0 + 1].x, 0.12);
    P.q[b0] = q_mul(qknee, q_mul(qr, q_x(a0)));
    P.p[b0] = j;
    P.q[b0 + 1] = q_mul(qknee, q_mul(qr, q_x(a0 + a1)));
    P.p[b0 + 1] = head_of(P, b0 + 1);
    P.q[b0 + 2] = q_mul(qf, q_x(heel));
    P.p[b0 + 2] = head_of(P, b0 + 2);
    P.q[b0 + 3] = q_mul(qf, q_x(toe));
    P.p[b0 + 3] = head_of(P, b0 + 3);
    return P;
}

// K's bones off the legs, stood over `org` and turned by qyaw: the root
// where K has it, every other bone turned from its parent as K has it (the
// legs' bones too, to be solved after).
pub fn key_trunk(K: Key, org: vec3<f32>, qyaw: vec4<f32>) -> Pose {
    var P: Pose;
    for (var b: i32 = 0; b < NB; b += 1) {
        if (PARENT[b] < 0) {
            P.q[b] = q_mul(qyaw, K.q[b]);
            P.p[b] = org + q_rot(qyaw, HEAD[b] + K.root);
        } else {
            P.q[b] = q_mul(P.q[PARENT[b]], K.q[b]);
            P.p[b] = head_of(P, b);
        }
    }
    return P;
}

// K as a pose with its feet where it has them: a key as it is drawn.
pub fn key_pose(K: Key, org: vec3<f32>, qyaw: vec4<f32>) -> Pose {
    var P = key_trunk(K, org, qyaw);
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        P = leg_solve(P, l, qyaw, key_ball(K, l, org, qyaw), K.fa[l].x, K.fa[l].y, K.fa[l].z, KEY_SOFT);
    }
    return P;
}
