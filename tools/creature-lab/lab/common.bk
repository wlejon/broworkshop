// creature::common — the small helpers a rig may call. Nothing here knows a
// species: angles, quaternions, two-bone IK in a plane, rate limits, a
// support-plane fit, and reading and writing the per-creature records.
//
// Conventions (the lab's): +Y up, a creature at rest faces +Z with +X its
// left. A bone's rotation is a quaternion vec4(x, y, z, w) from its rest
// frame (the world's axes). A limb angle in its leg plane is measured from
// straight down, positive toward +Z (forward).
module creature::common;

pub const PI: f32 = 3.14159265;
pub const TAU: f32 = 6.28318531;

pub fn clamp01(x: f32) -> f32 { return clamp(x, 0.0, 1.0); }

// The quintic smoothstep of x in [0, 1]: no slope and no curvature at
// either end, so a motion eased by it starts and stops with no jump in its
// acceleration (a cubic's would leave one: a kink in a joint's velocity).
pub fn smooth01(x: f32) -> f32 {
    let t = clamp(x, 0.0, 1.0);
    return t * t * t * (t * (6.0 * t - 15.0) + 10.0);
}

pub fn fract01(x: f32) -> f32 { return x - floor(x); }

// The smaller of a and b with no corner where they cross: within about k of
// each other it falls up to k ln 2 under both (a limit made of several
// limits, one taking over from another, moves without a jump in its speed).
pub fn smin(a: f32, b: f32, k: f32) -> f32 {
    let m = min(a, b);
    return m - k * log(exp((m - a) / k) + exp((m - b) / k));
}

pub fn wrap_pi(a: f32) -> f32 { return atan2(sin(a), cos(a)); }

// The shortest signed difference b - a of two phases in cycles (-0.5, 0.5].
pub fn phase_diff(a: f32, b: f32) -> f32 {
    let d = fract01(b - a + 0.5) - 0.5;
    return d;
}

// cur moved toward want by at most rate * dt.
pub fn approach(cur: f32, want: f32, rate: f32, dt: f32) -> f32 {
    let d = want - cur;
    let s = rate * dt;
    if (abs(d) <= s) { return want; }
    return cur + sign(d) * s;
}

// Exponential approach with rate k (1/s).
pub fn damp(cur: f32, want: f32, k: f32, dt: f32) -> f32 {
    return want + (cur - want) * exp(-k * dt);
}

// One step of a critically damped spring of rate w (rad/s) toward t from
// x = (value, speed): the new (value, speed).
pub fn crit_step(x: vec2<f32>, t: f32, w: f32, dt: f32) -> vec2<f32> {
    let v = x.y + (w * w * (t - x.x) - 2.0 * w * x.y) * dt;
    return vec2<f32>(x.x + v * dt, v);
}

// A yaw turned toward `want` at most `rate` rad/s: (new yaw, its rate).
pub fn turn_toward(cur: f32, want: f32, rate: f32, dt: f32) -> vec2<f32> {
    let d = wrap_pi(want - cur);
    let s = rate * dt;
    var turn: f32 = d;
    if (abs(d) > s) { turn = sign(d) * s; }
    var omega: f32 = 0.0;
    if (dt > 0.0) { omega = turn / dt; }
    return vec2<f32>(wrap_pi(cur + turn), omega);
}

// --- quaternions ------------------------------------------------------------

pub fn q_id() -> vec4<f32> { return vec4<f32>(0.0, 0.0, 0.0, 1.0); }

pub fn q_mul(a: vec4<f32>, b: vec4<f32>) -> vec4<f32> {
    return vec4<f32>(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz), a.w * b.w - dot(a.xyz, b.xyz));
}

pub fn q_conj(q: vec4<f32>) -> vec4<f32> { return vec4<f32>(-q.xyz, q.w); }

pub fn q_axis(axis: vec3<f32>, a: f32) -> vec4<f32> {
    let h = 0.5 * a;
    return vec4<f32>(axis * sin(h), cos(h));
}

pub fn q_x(a: f32) -> vec4<f32> { return vec4<f32>(sin(0.5 * a), 0.0, 0.0, cos(0.5 * a)); }
pub fn q_y(a: f32) -> vec4<f32> { return vec4<f32>(0.0, sin(0.5 * a), 0.0, cos(0.5 * a)); }
pub fn q_z(a: f32) -> vec4<f32> { return vec4<f32>(0.0, 0.0, sin(0.5 * a), cos(0.5 * a)); }

// R = Rx(a.x) Ry(a.y) Rz(a.z): the lab's joint-angle order.
pub fn q_xyz(a: vec3<f32>) -> vec4<f32> {
    return q_mul(q_mul(q_x(a.x), q_y(a.y)), q_z(a.z));
}

pub fn q_rot(q: vec4<f32>, v: vec3<f32>) -> vec3<f32> {
    let t = 2.0 * cross(q.xyz, v);
    return v + q.w * t + cross(q.xyz, t);
}

pub fn q_norm(q: vec4<f32>) -> vec4<f32> { return q / max(length(q), 1e-8); }

// From a toward b by t, along the shorter way (normalised lerp: for the
// small turns a layer blends, as good as a slerp and cheaper).
pub fn q_blend(a: vec4<f32>, b: vec4<f32>, t: f32) -> vec4<f32> {
    var bb = b;
    if (dot(a, b) < 0.0) { bb = -b; }
    return q_norm(mix(a, bb, t));
}

// The shortest rotation taking a's direction onto b's (of any lengths: on
// vectors not of unit length the half-angle form below turns too little).
pub fn q_from_to(a0: vec3<f32>, b0: vec3<f32>) -> vec4<f32> {
    let a = a0 / max(length(a0), 1e-9);
    let b = b0 / max(length(b0), 1e-9);
    let c = dot(a, b);
    if (c < -0.9999) {
        var ax = cross(a, vec3<f32>(1.0, 0.0, 0.0));
        if (dot(ax, ax) < 1e-6) { ax = cross(a, vec3<f32>(0.0, 1.0, 0.0)); }
        return vec4<f32>(normalize(ax), 0.0);
    }
    return q_norm(vec4<f32>(cross(a, b), 1.0 + c));
}

// The angles of q as R = Rx(x) Ry(y) Rz(z).
pub fn q_to_xyz(q: vec4<f32>) -> vec3<f32> {
    let x = q.x; let y = q.y; let z = q.z; let w = q.w;
    let r02 = 2.0 * (x * z + w * y);
    let r12 = 2.0 * (y * z - w * x);
    let r22 = 1.0 - 2.0 * (x * x + y * y);
    let r01 = 2.0 * (x * y - w * z);
    let r00 = 1.0 - 2.0 * (y * y + z * z);
    return vec3<f32>(atan2(-r12, r22), asin(clamp(r02, -1.0, 1.0)), atan2(-r01, r00));
}

// --- planar limbs -----------------------------------------------------------

// The unit direction of a limb angle in its (z, y) plane.
pub fn limb_dir(a: f32) -> vec2<f32> { return vec2<f32>(sin(a), -cos(a)); }

// The limb angle of a (z, y) vector.
pub fn limb_angle(d: vec2<f32>) -> f32 { return atan2(d.x, -d.y); }

// x unchanged up to k, then eased toward m with no corner and no jump in
// its curvature where the easing begins (x / sqrt(1 + x^2) leaves its line
// with neither), so a motion running into the limit is turned, not knocked.
pub fn soft_limit(x: f32, k: f32, m: f32) -> f32 {
    if (x <= k) { return x; }
    let s = m - k;
    let t = (x - k) / s;
    return k + s * t / sqrt(1.0 + t * t);
}

// Two segments of lengths a and b from the origin to d in the (z, y)
// plane: their limb angles. bend > 0 puts the joint ahead of the line to d
// (a stifle, a carpus held forward), bend < 0 behind it (an elbow, a hock).
// A target out of reach is put at full reach along its line.
pub fn two_bone(a: f32, b: f32, d: vec2<f32>, bend: f32) -> vec2<f32> {
    return two_bone_at(a, b, d, bend, clamp(length(d), abs(a - b) + 1e-4, a + b - 1e-4));
}

// two_bone with a target past `soft` of full reach drawn in along its line
// on a soft curve: the joint's angle runs away as a chain nears straight
// (its rate grows without bound), so a leg reaching full extension would
// snap straight in a step; eased, it straightens with no corner and stops a
// few millimetres short. Where the easing should begin is the creature's: a
// leg that works near straight wants it late, one that often reaches full
// extension at speed wants it early.
pub fn two_bone_soft(a: f32, b: f32, d: vec2<f32>, bend: f32, soft: f32) -> vec2<f32> {
    let m = a + b;
    return two_bone_at(a, b, d, bend, max(soft_limit(length(d), soft * m, 0.9995 * m), abs(a - b) + 1e-4));
}

// The two segments' angles with the target d put at distance r along its line.
fn two_bone_at(a: f32, b: f32, d: vec2<f32>, bend: f32, r: f32) -> vec2<f32> {
    let ad = limb_angle(d);
    let c = clamp((a * a + r * r - b * b) / (2.0 * a * r), -1.0, 1.0);
    let g = acos(c);
    var aa: f32 = ad - g;
    if (bend > 0.0) { aa = ad + g; }
    let j = a * limb_dir(aa);
    let t = r * limb_dir(ad);
    return vec2<f32>(aa, limb_angle(t - j));
}

// --- support ----------------------------------------------------------------

// A plane fit to four points: (height at c, dh/dx, dh/dz), least squares.
pub fn fit_plane4(p0: vec3<f32>, p1: vec3<f32>, p2: vec3<f32>, p3: vec3<f32>, c: vec2<f32>) -> vec3<f32> {
    let m = (p0 + p1 + p2 + p3) * 0.25;
    var sxx: f32 = 1e-4;
    var sxz: f32 = 0.0;
    var szz: f32 = 1e-4;
    var sxy: f32 = 0.0;
    var szy: f32 = 0.0;
    var pts: array<vec3<f32>, 4>;
    pts[0] = p0; pts[1] = p1; pts[2] = p2; pts[3] = p3;
    for (var i: i32 = 0; i < 4; i += 1) {
        let d = pts[i] - m;
        sxx += d.x * d.x; sxz += d.x * d.z; szz += d.z * d.z;
        sxy += d.x * d.y; szy += d.z * d.y;
    }
    let det = sxx * szz - sxz * sxz;
    let gx = (szz * sxy - sxz * szy) / det;
    let gz = (sxx * szy - sxz * sxy) / det;
    return vec3<f32>(m.y + gx * (c.x - m.x) + gz * (c.y - m.z), gx, gz);
}

// --- records ----------------------------------------------------------------

pub fn ld3(s: rw_store<f32, 1>, i: i32) -> vec3<f32> { return vec3<f32>(s[i], s[i + 1], s[i + 2]); }

pub fn st3(s: rw_store<f32, 1>, i: i32, v: vec3<f32>) {
    s[i] = v.x; s[i + 1] = v.y; s[i + 2] = v.z;
}

// Bone k of a pose: the rows of its rotation with its head's position.
pub fn put_bone(pose: write_store<vec4<f32>, 1>, k: i32, q: vec4<f32>, p: vec3<f32>) {
    let x = q.x; let y = q.y; let z = q.z; let w = q.w;
    pose[3 * k] = vec4<f32>(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y - w * z), 2.0 * (x * z + w * y), p.x);
    pose[3 * k + 1] = vec4<f32>(2.0 * (x * y + w * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z - w * x), p.y);
    pose[3 * k + 2] = vec4<f32>(2.0 * (x * z - w * y), 2.0 * (y * z + w * x), 1.0 - 2.0 * (x * x + y * y), p.z);
}

// Smooth value noise in [-1, 1] over t (one knot a unit), from the seed and
// channel: knots from hash01, joined by smoothstep, so it has no corner.
pub fn noise1(t: f32, seed: f32, ch: f32) -> f32 {
    let k = floor(t);
    let a = hash01(k * 7.13 + seed * 13.7 + ch * 101.3);
    let b = hash01((k + 1.0) * 7.13 + seed * 13.7 + ch * 101.3);
    return 2.0 * mix(a, b, smooth01(t - k)) - 1.0;
}

// A small deterministic hash in [0, 1), without sin: a GPU's sin of a large
// argument is not the CPU's, and the same seed must give the same value on
// both (the lab measures on the CPU what the rig did on the GPU).
pub fn hash01(n: f32) -> f32 {
    var p = fract01(n * 0.1031);
    p = p * (p + 33.33);
    p = p * (p + p);
    return fract01(p);
}
