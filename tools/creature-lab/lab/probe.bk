// creature::probe — values from inside a rig, recorded every step of a lab
// run and printed by the `trace` command (p0 .. p15), for seeing what a
// solver was given rather than only the pose it made. A rig reserves
// PROBE_N floats of its state at an offset it names `pub const PROBE` (the
// lab records them when that constant exists) and writes them with `probe`;
// slots it does not write stay zero and are not printed.
module creature::probe;

pub const PROBE_N: i32 = 16;

// Slot i (0 .. PROBE_N - 1) of the probe slice at `at` (s + PROBE).
pub fn probe(st: rw_store<f32, 1>, at: i32, i: i32, v: f32) {
    st[at + i] = v;
}

// A vector in slots i .. i + 2.
pub fn probe3(st: rw_store<f32, 1>, at: i32, i: i32, v: vec3<f32>) {
    st[at + i] = v.x;
    st[at + i + 1] = v.y;
    st[at + i + 2] = v.z;
}
