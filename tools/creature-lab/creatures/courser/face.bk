// creature::face — the courser's face, drawn per pixel over the head's skin
// (lab/face.bk has how), in the rest pose's coordinates (body.js: x to its
// left, y up, z forward, metres). `foot` is a pixel's size there; every
// edge is softened over it.
//
// `look` is what its face bones say (lab/skin.bk's look_of): where the eye
// has turned (x to its left, y up; a little, a bird's), how far the lids
// are shut (z; under 0: wide) and the third eyelid drawn across (w).
//
// What it shows:
//   skin    bare carmine-to-amber periorbital teardrop patch sweeping from the
//           cere around the eye to a pointed post-ocular tip
//   brow    sleek raptor/secretary-bird supraorbital ridge and dark loreal
//           wedge sweeping smoothly back toward the crown quills
//   eye     luminous amber-gold iris about a black pupil in a dark orbital rim
//   bill    saffron cere with oblique nostril slit, slate culmen ridge, dark
//           hooked raptor tip, and crisp tomium/gape line
module creature::face;
import mesh;

fn lin(c: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(pow(c.x, 2.2), pow(c.y, 2.2), pow(c.z, 2.2));
}

// 1 inside (d < 0), 0 outside, over w either side of the edge.
fn inside(d: f32, w: f32) -> f32 {
    return clamp(0.5 - d / (2.0 * w), 0.0, 1.0);
}

// The eye (body.js's eye mass) seen from the side: (y, z) of its middle and
// the opening's radius.
const EYE: vec2<f32> = vec2<f32>(1.19, 0.452);
const EYE_R: f32 = 0.0098;

pub fn face(p: vec3<f32>, foot: f32, look: vec4<f32>, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    let w = max(foot, 0.0002);
    let ax = abs(p.x);
    var c = s.base_color;
    var rough = s.roughness;
    let q = vec2<f32>(p.y, p.z);

    if (p.y > 1.125 && p.y < 1.225 && p.z > 0.39 && p.z < 0.57) {
        // Bill, cere, nostril, and hooked tip shading (runs across midline ax >= 0 too).
        if (p.z > 0.454) {
            let tb = clamp((p.z - 0.482) / 0.076, 0.0, 1.0);
            let on_bill = smoothstep(0.490, 0.502, p.z) * smoothstep(1.192, 1.182, p.y + 0.35 * tb);
            // Dark slate dorsal culmen ridge and raptorial hooked tip shading.
            let culmen_y = 1.186 - 0.012 * tb - 0.028 * tb * tb * tb;
            let culmen = smoothstep(0.007, 0.0, abs(p.y - culmen_y)) * smoothstep(0.010, 0.001, ax) * on_bill;
            c = mix(c, lin(vec3<f32>(0.16, 0.19, 0.23)), 0.58 * culmen);
            let hook_tip = smoothstep(0.52, 0.88, tb) * smoothstep(0.495, 0.515, p.z);
            c = mix(c, lin(vec3<f32>(0.04, 0.045, 0.055)), 0.88 * hook_tip);
            // Subtle pale horn highlight along the upper tomium cutting edge before the hook.
            let gt = clamp((p.z - 0.455) / 0.094, 0.0, 1.0);
            let gy = 1.171 - 0.004 * gt - 0.022 * gt * gt * gt;
            let tomium_hi = smoothstep(0.0032, 0.0008, abs(p.y - (gy + 0.0022))) * (1.0 - hook_tip) * on_bill;
            c = mix(c, lin(vec3<f32>(0.62, 0.67, 0.72)), 0.32 * tomium_hi);
            // Waxy saffron cere border shadow where cere meets frontal feathers & bill plate.
            let cere_seam = smoothstep(0.0028, 0.0, abs(p.z - (0.499 - 0.15 * max(p.y - 1.18, 0.0))))
                * smoothstep(1.174, 1.180, p.y) * smoothstep(0.018, 0.004, ax);
            c = mix(c, lin(vec3<f32>(0.62, 0.44, 0.08)), 0.42 * cere_seam);
            // Oblique oval nostril slit on the cere.
            let nd = vec2<f32>((p.y - 1.1865) + 0.28 * (p.z - 0.493), (p.z - 0.493) - 0.28 * (p.y - 1.1865));
            let nost_r = length(nd / vec2<f32>(0.0024, 0.0048));
            let nost_rim = inside((nost_r - 1.35) * 0.0025, w) * inside(0.0055 - ax, w) * inside(ax - 0.0155, w);
            let nost = inside((nost_r - 1.0) * 0.0025, w) * inside(0.006 - ax, w) * inside(ax - 0.015, w);
            c = mix(c, lin(vec3<f32>(0.68, 0.46, 0.08)), 0.55 * nost_rim);
            c = mix(c, lin(vec3<f32>(0.07, 0.05, 0.03)), 0.94 * nost);
            // Crisp gape / tomium cleft from below the lore forward into the hook.
            let gape = inside(abs(p.y - gy) - 0.00095, w) * inside(abs(p.z - 0.501) - 0.047, w) * smoothstep(0.002, 0.006, ax + 0.004 * gt);
            c = mix(c, lin(vec3<f32>(0.06, 0.05, 0.05)), 0.88 * gape);
            rough = mix(rough, 0.34, on_bill);
        }

        // Lateral facial skin, swept avian supercilium, dark lore wedge, and eye.
        if (ax > 0.008) {
            let e = q - EYE;
            let side_in = inside(0.0115 - ax, w);
            // Bare carmine-orange to amber periorbital teardrop patch, pointed behind.
            let back = max(-e.y, 0.0);
            let half_y = max(0.0175 - 0.38 * back, 0.0015);
            let patch = length(vec2<f32>((e.x + 0.0015 + 0.08 * back) / half_y, (e.y - 0.005) / 0.036)) - 1.0;
            let skin = inside(patch * 0.017, w) * side_in;
            let skin_grad = mix(lin(vec3<f32>(0.88, 0.30, 0.07)), lin(vec3<f32>(0.96, 0.56, 0.12)),
                smoothstep(-0.014, 0.022, e.y) * 0.65 + smoothstep(-0.015, 0.015, e.x) * 0.35);
            c = mix(c, skin_grad, skin);
            rough = mix(rough, 0.44, skin);

            // Dark raptor loreal wedge in front of the anterior canthus (secretary-bird / falcon look).
            let lore_z = e.y - 0.017;
            let lore_y = e.x + 0.0018 + 0.18 * (e.y - 0.010);
            let lore_h = 0.0038 * smoothstep(0.006, 0.013, e.y) * (1.0 - smoothstep(0.022, 0.031, e.y));
            let lore_mk = inside(abs(lore_y) - lore_h, w) * side_in * (1.0 - smoothstep(0.030, 0.033, e.y));
            c = mix(c, lin(vec3<f32>(0.055, 0.045, 0.045)), 0.86 * lore_mk);

            // Sleek, arched avian supercilium / raptor supraorbital ridge:
            // rises from a fine point above the lore, arches smoothly over the orbit,
            // and sweeps upward and backward toward the occipital crest quills.
            let u_brow = e.y; // +ahead, -behind
            let arch_y = EYE.x + 0.0136 - 0.11 * u_brow - 5.2 * max(u_brow + 0.003, 0.0) * max(u_brow + 0.003, 0.0)
                + 3.4 * back * back;
            let front_t = 1.0 - smoothstep(0.012, 0.028, u_brow);
            let back_t = 1.0 - smoothstep(0.016, 0.042, back);
            let brow_half = (0.0007 + 0.0019 * smoothstep(-0.028, 0.004, u_brow)) * front_t * back_t;
            // Subtle warm shadow beneath the orbital overhang before the crisp dark feather line.
            let brow_shade = smoothstep(0.0055, 0.0, abs(p.y - (arch_y - 0.0024))) * front_t * back_t * skin;
            c = mix(c, c * 0.62, 0.55 * brow_shade);
            let brow = inside(abs(p.y - arch_y) - brow_half, w)
                * inside(u_brow - 0.028, w) * inside(-0.042 - u_brow, w) * side_in;
            c = mix(c, lin(vec3<f32>(0.045, 0.042, 0.048)), brow);

            // The eye: a little larger when wide.
            let R = EYE_R * (1.0 + 0.1 * max(-look.z, 0.0));
            let r = length(e);
            let d = r - R;
            c = mix(c, lin(vec3<f32>(0.08, 0.05, 0.045)), inside(d - 0.0017, w) * side_in);
            let open = inside(d, w) * side_in;
            let ei = (e - 0.35 * R * vec2<f32>(look.y, 0.0)) / R;
            let ki = length(ei);
            var eye = mix(lin(vec3<f32>(0.92, 0.75, 0.30)), lin(vec3<f32>(0.42, 0.26, 0.09)), smoothstep(0.55, 1.0, ki));
            // The pupil: pinned small when it is wide-eyed.
            eye = mix(eye, lin(vec3<f32>(0.012, 0.01, 0.01)), inside((ki - 0.50 - 0.14 * min(look.z, 0.0)) * R, w));
            // The brow's shade on its top.
            eye = eye * mix(1.0, 0.48, smoothstep(0.18, 1.0, e.x / R));
            // The sky's light on it, high and forward.
            eye = mix(eye, vec3<f32>(1.0), 0.95 * inside(length(e - vec2<f32>(0.32, 0.36) * R) - 0.2 * R, w));
            // The third eyelid (look.w): pale and half clear, across from the front corner.
            let front = e.y / R;
            let mem = inside((1.0 - 2.0 * look.w - front) * R, w) * step(0.001, look.w);
            eye = mix(eye, lin(vec3<f32>(0.66, 0.68, 0.70)), 0.82 * mem);
            c = mix(c, eye, open);
            rough = mix(rough, mix(0.04, 0.3, mem), open);
            // The lids (look.z): the lower comes up as a bird's does, the upper
            // a little down to meet it, the bare skin's colour.
            let shut = clamp(look.z, 0.0, 1.0);
            let lid = open * max(inside((e.x / R - (1.7 * shut - 1.0)) * R, w), inside(((1.0 - 0.45 * shut) - e.x / R) * R, w)) * step(0.001, shut);
            c = mix(c, lin(vec3<f32>(0.88, 0.46, 0.18)), lid);
            rough = mix(rough, 0.48, lid);
        }
    }
    out.base_color = c;
    out.roughness = rough;
    return out;
}
