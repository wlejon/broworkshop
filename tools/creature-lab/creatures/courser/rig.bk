// The courser's rig: one invocation per courser, its state in `state`, its
// bones out to `pose` (the creature contract, lab/contract.js).
//
// It moves as its keys draw it (poses.js, creature::keyed). Standing is a
// pose; the walk and the run are cycles of poses read at the stride's phase,
// the walk blended from the stand by how fast it goes and the run from the
// walk as it speeds up; pecking, resting, standing alert and flinching are
// poses blended over those. The rig's own work is the ground and the life:
//
//   feet    a foot that lands is pinned where it landed and its leg solved
//           to it from wherever the keys carry the hips, so no foot slides;
//           the stride's rate is what carries the body one stance's ground
//           in one stance's time; a foot that lifts leaves from where it
//           really was and joins the key's path through its swing. Stopping,
//           a foot in the air finishes its step, and a foot left away from
//           where it stands steps home.
//   life    standing it breathes, shifts its weight, shuffles its wings
//           and fans its tail; its head goes to a new place in a snap every
//           second or two and is held dead still between, cocked to one
//           side now and then, the crest lifting with each; pecking, it
//           stabs at the ground and looks up between.
//
//   head    held level: the keys turn the trunk under it every step, and
//           the top of the neck and the head turn back against that.
//   loose   the crest, the wings and the tail are the keys' with their own
//           momentum: each bone's tip on a spring (creature::dangle) from
//           where the keys have it, so the crest nods after the head and
//           the wings shake at a landing; the tail's fan trails.
import creature::common::*;
import creature::contract::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::dangle::*;
import creature::limbs::*;
import creature::keys::*;
import creature::keyed::*;
import creature::probe::*;
from creature::ground import height, obstacle_ahead;

const D_SPEED: i32 = 5;
const D_OMEGA: i32 = 6;
const D_PHASE: i32 = 7;
const D_MOVING: i32 = 8;
const D_CLOCK: i32 = 9;
const D_GO: i32 = 10;        // the walk's share over the stand (0..1)
const D_VRAMP: i32 = 11;     // the pace's ramp the speed follows
const D_GROUND: i32 = 12;    // the ground's height under it, eased
const D_LOOK: i32 = 13;      // the gaze's turn and pitch, and their speeds
const D_LOOK_V: i32 = 14;
const D_LOOK_P: i32 = 15;
const D_LOOK_PV: i32 = 16;
const D_RUN: i32 = 17;       // the run's share over the walk (0..1)
const D_GRAZE: i32 = 18;     // foraging, resting, alert (0..1 each)
const D_LIE: i32 = 19;
const D_ALERT: i32 = 20;
const D_STARTLE_T: i32 = 21; // s since it was startled (-1: not)
const D_PREV_ACT: i32 = 22;
const D_AIR: i32 = 23;       // creature::keyed's flight (AIR_STATE)
const D_LEG: i32 = D_AIR + AIR_STATE;
const LEG_REC: i32 = 14;
const L_PLANT: i32 = 0;
const L_PIN: i32 = 1;        // the ball: pinned, or where the swing has it (3)
const L_OFF: i32 = 4;        // where on the ground it lifted from (3)
const L_YAW: i32 = 7;        // the foot's heading
const L_ARMED: i32 = 8;      // set in stance, so a leg lifts once a cycle
const L_HOME: i32 = 9;       // a step home: its progress (0: none), and where from (3)
const L_FROM: i32 = 10;
const D_HEADQ: i32 = D_LEG + 2 * LEG_REC;   // the head's turn in the creature's frame, eased (4)
const D_LOOSE: i32 = D_HEADQ + 4;           // the loose bones' tips (creature::dangle), in LOOSE's order
const NLOOSE: i32 = 7;
const D_LEAP: i32 = D_LOOSE + NLOOSE * DANGLE_REC;   // a leap: 0 none, 1 the push, 2 the flight; the leg it pushes with;
                                                     //   s of the flight left; its share in the pose (0..1)
pub const PROBE: i32 = D_LEAP + 4;                   // creature::probe's slice
pub const STATE: i32 = PROBE + PROBE_N;

// The loose bones, each after the one it hangs from, and each one's spring:
// rad/s walking, rad/s more running (a part is held firmer at speed), its
// damping, and the most it turns from where the keys have it (rad).
const LOOSE: array<i32, NLOOSE> = [B_CREST1, B_CREST2, B_WINGL, B_WINGR, B_TAIL1, B_TAIL2, B_TAIL3];
// (The tail's are not sprung but trail, `trail`: rad/s each follows at.)
const LOOSE_W: array<f32, NLOOSE> = [30.0, 22.0, 24.0, 25.0, 34.0, 30.0, 26.0];
const LOOSE_RUN: array<f32, NLOOSE> = [30.0, 30.0, 6.0, 6.0, 0.0, 0.0, 0.0];
const LOOSE_ZETA: array<f32, NLOOSE> = [0.55, 0.5, 0.55, 0.55, 0.8, 0.8, 0.8];
const LOOSE_MAX: array<f32, NLOOSE> = [0.5, 0.5, 0.14, 0.14, 0.16, 0.2, 0.24];

@knob const LAYERS: f32 = 1.0;       // the head's steadying and the loose parts' share (0: the keys as they are)
@knob const SOFT_REACH: f32 = 0.985; // share of a leg's reach where its IK eases the reach in
@knob const WALK_V: f32 = 1.0;       // m/s the walk's keys are drawn for: slower, it is blended toward the stand
@knob const JOG_V: f32 = 1.2;        // m/s the walk begins to go over to the run
@knob const JOIN_U: f32 = 0.6;      // share of a swing over which the foot goes from the ground it left to the keys' path
@knob const LIFT_DRAWN: f32 = 0.012; // m off the ground the keys draw a standing foot before it has left it
@knob const RUN_V: f32 = 2.6;       // m/s it is all the run's keys
@knob const HEAD_SPACE: f32 = 0.8;   // share of the trunk's turning under it the head is held against
const HEAD_RATE: f32 = 3.0;          // 1/s the head's heading follows where the keys would have it
@knob const LIFE: f32 = 1.0;         // the idle life's share (breath, sway, flicks, glances)
const HOME_T: f32 = 0.32;            // s a step home takes
const BREATH_T: f32 = 3.2;           // s of a breath
const GLANCE_T: f32 = 1.6;           // s its head holds a place it looks
const SNAP_T: f32 = 0.11;            // s its head takes to a new one
const SHUFFLE_T: f32 = 6.5;          // s between its wings' chances to shuffle
const BLINK_T: f32 = 2.7;            // s to a blink, about
// A leap (over a log in its way, at a run): a hurdler's, off one foot.
@knob const LEAP_PUSH_T: f32 = 0.2;  // s the last stance is held for the push
@knob const LEAP_DIP: f32 = 0.09;    // m the hips sink into it
@knob const LEAP_RISE: f32 = 0.09;   // m over the stride's own they are at as the foot leaves
const LEAP_FOLD: f32 = 0.44;         // m from its hip a foot is kept in a leap: as far as the leg folds
const LEAP_FLIGHT: f32 = 0.6;       // s of flight it plans its take-off spot for
@knob const LEAP_LATE: f32 = 0.07;   // s after the hips cross the log that the flight tops
@knob const LEAP_TUCK: f32 = 0.2;   // m the feet are drawn up under it in the air

fn select_i(c: bool, a: i32, b: i32) -> i32 {
    if (c) { return a; }
    return b;
}

// Where leg l's ball rests on the ground at p, `lift` over it.
fn ball_on(env: read_store<f32, 1>, p: vec3<f32>, l: i32, lift: f32) -> vec3<f32> {
    return vec3<f32>(p.x, height(env, p.x, p.z) + HEAD[LEG_TOP[l] + 3].y + lift, p.z);
}

// Bone b of T hung again from its parent as K turns it, then turned to its
// tip, which is on a spring at st[k..] from where that puts it.
// A bone's turn from its parent, turned a further `e` (x, y, z, rad).
fn turned(q: vec4<f32>, e: vec3<f32>) -> vec4<f32> { return q_mul(q, q_xyz(e)); }

// q, on r's side of the sphere (to blend the two).
fn same_way(q: vec4<f32>, r: vec4<f32>) -> vec4<f32> {
    if (dot(q, r) < 0.0) { return -q; }
    return q;
}

fn loose(st: rw_store<f32, 1>, k: i32, T: Pose, K: Key, b: i32, w: f32, zeta: f32, amax: f32, share: f32, dt: f32, init: bool) -> Pose {
    var P = T;
    P.q[b] = q_mul(P.q[PARENT[b]], K.q[b]);
    P.p[b] = head_of(P, b);
    let along = TAIL[b] - HEAD[b];
    let tip = dangle_step(st, k, P.p[b] + q_rot(P.q[b], along), w, zeta, 0.0, dt, init);
    P.q[b] = q_blend(P.q[b], aim_at(P.q[b], P.p[b], along, tip, amax), share);
    return P;
}

// The tail's bone b, hung again from the one before as K turns it, then
// turned to its tip, which trails: it follows where that puts it, about
// `org` (where the creature stands at its pace), without overshoot. So the
// tail takes up the hips' bounce along its length and streams behind a
// run instead of being thrown about by it, and swings wide of a turn.
fn trail(st: rw_store<f32, 1>, k: i32, T: Pose, K: Key, b: i32, org: vec3<f32>, w: f32, amax: f32, share: f32, dt: f32, init: bool) -> Pose {
    var P = T;
    P.q[b] = q_mul(P.q[PARENT[b]], K.q[b]);
    P.p[b] = head_of(P, b);
    let along = TAIL[b] - HEAD[b];
    let rest = P.p[b] + q_rot(P.q[b], along) - org;
    if (init) {
        st3(st, k, rest);
        st3(st, k + 3, vec3<f32>(0.0));
    }
    let x = crit_step(vec2<f32>(st[k], st[k + 3]), rest.x, w, dt);
    let y = crit_step(vec2<f32>(st[k + 1], st[k + 4]), rest.y, w, dt);
    let z = crit_step(vec2<f32>(st[k + 2], st[k + 5]), rest.z, w, dt);
    st3(st, k, vec3<f32>(x.x, y.x, z.x));
    st3(st, k + 3, vec3<f32>(x.y, y.y, z.y));
    P.q[b] = q_blend(P.q[b], aim_at(P.q[b], P.p[b], along, org + vec3<f32>(x.x, y.x, z.x), amax), share);
    return P;
}

@kernel @grid(1)
fn k_rig(g: grid<1>, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
         pose: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    let c = g.x();
    let s = c * STATE;
    let ii = c * INTENT;
    let init = state[s + S_PLACED] < 0.5;
    let KS = key_get(K_STAND);
    if (init) {
        let p = ld3(state, s + S_POS);
        let q = q_y(state[s + S_YAW]);
        let o = vec3<f32>(p.x, height(env, p.x, p.z), p.z);
        state[s + D_GROUND] = o.y;
        state[s + D_STARTLE_T] = -1.0;
        for (var l: i32 = 0; l < NLEGS; l += 1) {
            let k = s + D_LEG + l * LEG_REC;
            st3(state, k + L_PIN, ball_on(env, key_ball(KS, l, o, q), l, 0.0));
            state[k + L_PLANT] = 1.0;
            state[k + L_ARMED] = 1.0;
            state[k + L_YAW] = state[s + S_YAW];
        }
        state[s + S_PLACED] = 1.0;
    }

    // --- intent and actions -----------------------------------------------------------
    let act = intent[ii + I_ACTION] as i32;
    let seed = intent[ii + I_SEED];
    let clock = state[s + D_CLOCK] + dt;
    state[s + D_CLOCK] = clock;
    let graze = approach(state[s + D_GRAZE], select_f(act == ACT_GRAZE, 1.0, 0.0), 1.1, dt);
    let lie = approach(state[s + D_LIE], select_f(act == ACT_LIE, 1.0, 0.0), 0.7, dt);
    var st_t = state[s + D_STARTLE_T];
    if (act == ACT_STARTLE && (state[s + D_PREV_ACT] as i32) != ACT_STARTLE) { st_t = 0.0; }
    if (st_t >= 0.0) { st_t += dt; }
    if (st_t > 2.0) { st_t = -1.0; }
    let alert_want = act == ACT_ALERT || act == ACT_STARTLE;
    let alert = approach(state[s + D_ALERT], select_f(alert_want, 1.0, 0.0), select_f(alert_want, 4.0, 0.8), dt);
    // The flinch: down and back at once, let go over half a second.
    var flinch: f32 = 0.0;
    // (Down over a quarter of a second: in a tenth it dropped 15 cm, four
    // times as far as a body falls in that time, with its feet on the ground.)
    if (st_t >= 0.0) { flinch = smooth01(st_t / 0.26) * (1.0 - smooth01((st_t - 0.36) / 0.6)); }
    state[s + D_GRAZE] = graze;
    state[s + D_LIE] = lie;
    state[s + D_ALERT] = alert;
    state[s + D_STARTLE_T] = st_t;
    state[s + D_PREV_ACT] = act as f32;

    // --- heading and speed ------------------------------------------------------------
    var vdes = vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z]);
    if (act == ACT_BOUND) { vdes = vdes * max(1.0, 3.2 / max(length(vdes), 0.1)); }
    // (It gets up before it goes anywhere.)
    if (act == ACT_LIE || act == ACT_GRAZE || lie > 0.02 || graze > 0.3) { vdes = vec2<f32>(0.0); }
    var yaw = state[s + S_YAW];
    var speed = state[s + D_SPEED];
    var want = yaw;
    let vd = length(vdes);
    if (intent[ii + I_HEADING_MODE] > 0.5) { want = intent[ii + I_HEADING]; }
    else if (vd > 0.05) { want = atan2(vdes.x, vdes.y); }
    if (lie > 0.02) { want = yaw; }
    let rate = mix(1.6, 2.6 / (1.0 + 0.25 * speed), smooth01(speed / 0.5));
    let omega = approach(state[s + D_OMEGA], clamp(4.0 * wrap_pi(want - yaw), -rate, rate), 8.0, dt);
    yaw = wrap_pi(yaw + omega * dt);
    let err = wrap_pi(want - yaw);
    let vt = vd * clamp(cos(err), 0.2, 1.0);
    // The pace ramps to what is asked and the speed follows the ramp through
    // a lag, so a start or a stop has no step in its acceleration.
    let ramp = approach(state[s + D_VRAMP], vt, select_f(vt > state[s + D_VRAMP], 1.6 + 0.4 * speed, 3.0), dt);
    state[s + D_VRAMP] = ramp;
    speed = damp(speed, ramp, 8.0, dt);
    let qyaw = q_y(yaw);
    let fwd = q_rot(qyaw, vec3<f32>(0.0, 0.0, 1.0));
    var pos = ld3(state, s + S_POS);
    pos += fwd * (speed * dt);

    // --- the stride's clock -------------------------------------------------------------
    let was_moving = state[s + D_MOVING] > 0.5;
    var moving = vd > 0.05 || speed > 0.05 || abs(err) > 0.12;
    if (was_moving) { moving = moving || speed > 0.03 || abs(err) > 0.05; }
    let veff = max(speed, 0.35 * abs(omega));
    var air = false;
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        if (state[k + L_PLANT] < 0.5 && state[k + L_HOME] <= 0.0) { air = true; }
    }
    // Slower than the keys are drawn for, the walk is blended toward the
    // stand: shorter steps, less of everything. Faster, the walk goes over
    // to the run through a jog that is some of each: its steps lengthen and
    // its feet are down for less of them until it is in the air between.
    // (Turning on the spot it has none of the walk: it steps where it stands.)
    let go_want = select_f(moving, clamp(pow(speed / WALK_V, 0.6), 0.0, 1.0), 0.0);
    let go = approach(state[s + D_GO], go_want, 2.5, dt);
    state[s + D_GO] = go;
    let run_u = approach(state[s + D_RUN], clamp((speed - JOG_V) / (RUN_V - JOG_V), 0.0, 1.0), 2.5, dt);
    state[s + D_RUN] = run_u;
    let rw = smooth01(run_u);
    // The rate that carries the body a stance's ground (as the keys cover
    // it, blended) in a stance's time; turning, a step for each half
    // radian or so.
    let gw = smooth01(go);
    let duty = gait_duty(C_WALK, C_RUN, rw, 0);
    let freq = clamp(max(speed * duty / max(gw * gait_span(C_WALK, C_RUN, rw), 0.02), 0.9 * abs(omega)), 0.6, 3.2);
    var phase = state[s + D_PHASE];
    // (Setting off, the left foot lifts at once.)
    if (moving && !was_moving && !air) {
        phase = floor(phase) + CYC_STANCE[C_WALK * NLEGS].y + 0.001;
        for (var l: i32 = 0; l < NLEGS; l += 1) { state[s + D_LEG + l * LEG_REC + L_ARMED] = 1.0; }
    }
    // --- a leap --------------------------------------------------------------------------
    // At a run, a log in its way is cleared as a hurdler clears one: the
    // stance that comes nearest the take-off spot (the flight's top over
    // the log) is held longer, the hips sinking into it and driven up out
    // of it, and the clock is slowed through the flight that push gives so
    // the other foot comes down as the body does. In between it is the
    // run's own stride, stretched: one leg reaching, the other trailing.
    var leap = state[s + D_LEAP];
    var leap_leg = state[s + D_LEAP + 1] as i32;
    var leap_left = state[s + D_LEAP + 2];
    var cfreq = freq;
    var push_u: f32 = -1.0;
    var begun = false;
    if (leap < 0.5 && rw > 0.6 && moving && !init) {
        let ob = obstacle_ahead(env, pos.x, pos.z, vec2<f32>(fwd.x, fwd.z));
        // (The flight's top a little short of the log: the trailing foot,
        // lowest, crosses it a moment after the hips.)
        let spot = speed * (LEAP_PUSH_T + 0.5 * LEAP_FLIGHT - LEAP_LATE);
        if (ob.y > 0.02 && ob.x < spot + 0.3 * speed / freq) {
            for (var l: i32 = 0; l < NLEGS; l += 1) {
                // (The foot that has just come down pushes.)
                if (gait_stance(C_WALK, C_RUN, rw, l, phase) < 0.0 && gait_stance(C_WALK, C_RUN, rw, l, phase + freq * dt) >= 0.0 && leap < 0.5) {
                    leap = 1.0;
                    leap_leg = l;
                    begun = true;
                }
            }
        }
    }
    if (leap > 0.5 && leap < 1.5) {
        push_u = select_f(begun, 0.0, gait_stance(C_WALK, C_RUN, rw, leap_leg, phase));
        cfreq = select_f(begun, freq, duty / LEAP_PUSH_T);
        if (push_u < 0.0) {
            // Off the ground: the flight is what the push gave it.
            leap = 2.0;
            leap_left = clamp(2.0 * state[s + D_AIR + 4] / 9.81, 0.2, 0.9);
        }
    }
    if (leap > 1.5) {
        let u = gait_swing(C_WALK, C_RUN, rw, 1 - leap_leg, phase);
        cfreq = clamp((1.0 - u) * (1.0 - duty) / max(leap_left, 0.02), 0.25, 2.0 * freq);
        leap_left -= dt;
        if (gait_stance(C_WALK, C_RUN, rw, 1 - leap_leg, phase) >= 0.0 && state[s + D_LEG + (1 - leap_leg) * LEG_REC + L_PLANT] > 0.5) { leap = 0.0; }
        if (leap_left < -0.3) { leap = 0.0; }
    }
    let leap_w = approach(state[s + D_LEAP + 3], select_f(leap > 1.5, 1.0, 0.0), select_f(leap > 1.5, 9.0, 5.0), dt);
    state[s + D_LEAP] = leap;
    state[s + D_LEAP + 1] = leap_leg as f32;
    state[s + D_LEAP + 2] = leap_left;
    state[s + D_LEAP + 3] = leap_w;
    if (moving || air) { phase += cfreq * dt; }
    var K = key_mix(KS, gait_at(C_WALK, C_RUN, rw, phase), gw);
    if (push_u >= 0.0) {
        // The push: down into the leg, then up out of it faster and faster.
        let up = max(push_u - 0.4, 0.0) / 0.6;
        K.root.y += -LEAP_DIP * smooth01(push_u / 0.4) + (LEAP_DIP + LEAP_RISE) * up * up;
    }
    if (leap_w > 0.0) {
        // In the air: the neck stretched out ahead, the wings thrown open,
        // the tail up behind and the crest flat; the legs keep the stride's
        // split, drawn up under it.
        let L = key_get(K_LEAP);
        let w = smooth01(leap_w);
        for (var b: i32 = 0; b < NB; b += 1) { K.q[b] = q_norm(mix(K.q[b], same_way(L.q[b], K.q[b]), 0.85 * w)); }
        // (A foot the clock has down is on the ground: only one in its swing is drawn up.)
        for (var l: i32 = 0; l < NLEGS; l += 1) {
            // (The trailing one, which pushed, more: the leading leg is high already.)
            if (gait_stance(C_WALK, C_RUN, rw, l, phase) < 0.0) { K.foot[l].y += LEAP_TUCK * w * select_f(l == leap_leg, 1.0, 0.2); }
        }
    }

    // --- the poses over it ------------------------------------------------------------
    let still = 1.0 - gw;
    let wg = smooth01(graze);
    let wl = smooth01(lie);
    if (wg > 0.0) { K = key_mix(K, key_get(K_FORAGE), wg); }
    // It lies down as a dog does: back onto its hocks first, then the chest
    // let down forward onto the ground; up again the other way.
    if (wl > 0.0) {
        let sit = smooth01(lie / 0.55);
        let down = smooth01((lie - 0.4) / 0.6);
        K = key_mix(K, key_mix(key_get(K_REST), key_get(K_LIE), down), sit);
    }
    let wa = smooth01(alert) * (1.0 - 0.6 * gw) * (1.0 - wl);
    if (wa > 0.0) { K = key_mix(K, key_get(K_ALERT), wa); }
    if (flinch > 0.0) { K = key_mix(K, key_get(K_FLINCH), flinch * (1.0 - wl)); }

    // --- the ground under it ----------------------------------------------------------
    var gsum: f32 = 0.0;
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        let p = ld3(state, s + D_LEG + l * LEG_REC + L_PIN);
        gsum += height(env, p.x, p.z);
    }
    let ground_y = damp(state[s + D_GROUND], gsum / f32(NLEGS), 10.0, dt);
    state[s + D_GROUND] = ground_y;
    let org = vec3<f32>(pos.x, ground_y, pos.z);
    let ground_now = max(ground_y, height(env, pos.x, pos.z));
    // (What its last flight left it off the keys' place, creature::keyed's air.)
    let lift = air_lift(state, s + D_AIR, dt);

    // --- feet ---------------------------------------------------------------------------
    // Standing, a foot left away from its place steps home, the one further
    // off first, one at a time.
    var stepping = air;
    var stray: array<f32, NLEGS>;
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        if (state[k + L_HOME] > 0.0) { stepping = true; }
        let d = key_ball(KS, l, org, qyaw) - ld3(state, k + L_PIN);
        stray[l] = length(vec2<f32>(d.x, d.z)) + 0.15 * abs(wrap_pi(state[k + L_YAW] - yaw));
    }
    let settled = !moving && go < 0.05 && lie < 0.02 && graze < 0.02;
    var balls: array<vec3<f32>, NLEGS>;
    var dyaw: array<f32, NLEGS>;
    var tilt: array<f32, NLEGS>;
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let sp = gait_stance(C_WALK, C_RUN, rw, l, phase);
        var planted = state[k + L_PLANT] > 0.5;
        var home_u = state[k + L_HOME];
        var ball = ld3(state, k + L_PIN);
        var fyaw = state[k + L_YAW];
        if (planted) {
            if (sp >= 0.0) { state[k + L_ARMED] = 1.0; }
            // Between the walk and the run the clock's stance outlasts the
            // drawn one: the keys have the foot leaving the ground while the
            // clock still holds it down. It leaves when it is drawn to (a
            // foot held down in the air would carry a body that should be
            // falling), and waits armed at -1 for the clock's own lift.
            let drawn_off = moving && sp >= 0.0 && state[k + L_ARMED] > 0.5 && K.foot[l].y > LIFT_DRAWN;
            if ((moving && sp < 0.0 && state[k + L_ARMED] > 0.5) || drawn_off) {
                // Lift-off: from where it stands.
                planted = false;
                state[k + L_ARMED] = select_f(drawn_off, -1.0, 0.0);
                st3(state, k + L_OFF, ball);
            } else if (settled && !stepping && stray[l] > 0.04 && stray[l] >= stray[1 - l]) {
                planted = false;
                stepping = true;
                home_u = 0.0001;
                st3(state, k + L_FROM, ball);
            }
        }
        if (planted) {
            // Pinned: only its height is the key's (the ball lifts as the
            // foot rolls onto its toes).
            ball = ball_on(env, ball, l, K.foot[l].y);
        } else if (home_u > 0.0) {
            // A step home: an arc from where it stood to where it stands.
            home_u = min(home_u + dt / HOME_T, 1.0);
            let e = smooth01(home_u);
            let p0 = ld3(state, k + L_FROM);
            let to = ball_on(env, key_ball(KS, l, org, qyaw), l, 0.0);
            ball = mix(p0, to, e) + vec3<f32>(0.0, 0.04 * bump(home_u, 0.4, 0.6), 0.0);
            fyaw = fyaw + wrap_pi(yaw - fyaw) * e;
            if (home_u >= 1.0) { planted = true; home_u = 0.0; ball = to; fyaw = yaw; }
        } else {
            // The swing: the key's path, joined from where the foot left.
            // (L_ARMED below zero: -1 and the time since it left early, while
            // it waits for the clock's lift; -50 and that time once it has
            // come.)
            var arm = state[k + L_ARMED];
            let early = arm < -0.5 && arm > -40.0;
            if (early) { arm -= dt; if (sp < 0.0) { arm -= 49.0; } state[k + L_ARMED] = arm; }
            let u = select_f(early, 0.0, select_f(sp >= 0.0, 1.0, gait_swing(C_WALK, C_RUN, rw, l, phase)));
            // Left early, the toes come clear of the ground at once: the
            // keys, between the walk's foot down and the run's foot up,
            // draw it a centimetre off for a tenth of a second.
            let since = select_f(arm < -40.0, -arm - 50.0, -arm - 1.0);
            let clear = select_f(arm < -0.5, 0.022 * smooth01(since / 0.06) * (1.0 - smooth01(u / 0.6)), 0.0);
            // (In a leap's push the clock runs slow and the body goes on at
            // its pace: the swinging foot leaves the ground it lifted from by
            // the push's time, not the clock's, or it would be dragged out
            // behind.)
            let join = (1.0 - smooth01(u / JOIN_U)) * (1.0 - select_f(leap > 1.5, 1.0, smooth01(max(push_u, 0.0) / 0.5)));
            // (A step on the spot, which the stand's key has no lift for, is
            // lifted here.)
            let hop = 0.045 * (1.0 - gw) * bump(u, 0.4, 0.6);
            // Turning, it lands where the key will have it halfway through
            // its stance: pinned where the key has it now, the body turns on
            // over it and the leg is carried across under the hips.
            let lead_at = key_ball(K, l, org, q_y(yaw + omega * 0.5 * duty / freq * smooth01(u)));
            // (A foot in the air comes down with the body's flight, but
            // gives the dip of a landing no more than half its clearance.)
            // (Joined from the ground it left, not from an offset carried
            // with the body: it leaves at the ground's speed and gathers the
            // swing's, with no corner in its path or in the legs' turning.)
            ball = ball_on(env, mix(lead_at + lift * vec3<f32>(1.0, 0.0, 1.0), ld3(state, k + L_OFF), join), l, max(K.foot[l].y + hop + clear + max(lift.y, -0.5 * (K.foot[l].y + hop + clear)), 0.0));
            fyaw = yaw + wrap_pi(fyaw - yaw) * join;
            if (leap_w > 0.0) {
                // In a leap a foot's height is from the ground the body
                // stands over, not from what passes under the foot: it is
                // carried over the log with the body, and does not step up
                // its side.
                // The leg that pushed is drawn through under the hips as a
                // hurdler's trailing leg is, not left hanging out behind.
                if (l == leap_leg) {
                    let under = org + lift + vec3<f32>(0.0, HEAD[LEG_TOP[l] + 3].y + 0.16, 0.0) + q_rot(qyaw, vec3<f32>(HEAD[LEG_TOP[l]].x, 0.0, -0.1));
                    ball = mix(ball, under, 0.7 * smooth01(leap_w));
                }
                let own = height(env, ball.x, ball.z);
                ball.y = max(ball.y + smooth01(leap_w) * (ground_now - own), own + HEAD[LEG_TOP[l] + 3].y + 0.05);
                // (Over the log a foot is lifted toward the hip it hangs
                // from; nearer than the leg can fold, it is carried out
                // ahead or behind instead, where it is already going.)
                let hip = org + lift + vec3<f32>(0.0, HEAD[LEG_TOP[l]].y + K.root.y, 0.0) + q_rot(qyaw, vec3<f32>(HEAD[LEG_TOP[l]].x, 0.0, K.root.z));
                let dh = vec2<f32>(ball.x - hip.x, ball.z - hip.z);
                let need = sqrt(max(LEAP_FOLD * LEAP_FOLD - (ball.y - hip.y) * (ball.y - hip.y), 0.0));
                let have = length(dh);
                if (have < need) {
                    let way = select_f(dot(dh, vec2<f32>(fwd.x, fwd.z)) >= 0.0, 1.0, -1.0);
                    let out = mix(vec2<f32>(fwd.x, fwd.z) * way, dh / max(have, 0.0001), smooth01(have / 0.1));
                    let to = out / max(length(out), 0.0001) * need;
                    ball.x = hip.x + to.x;
                    ball.z = hip.z + to.y;
                }
            }
            if (sp >= 0.0 && !early) {
                planted = true;
                ball = ball_on(env, ball, l, 0.0);
                fyaw = yaw;
            }
        }
        state[k + L_PLANT] = select_f(planted, 1.0, 0.0);
        state[k + L_HOME] = home_u;
        state[k + L_YAW] = fyaw;
        st3(state, k + L_PIN, ball);
        balls[l] = ball;
        dyaw[l] = wrap_pi(fyaw - yaw);
        // The toes lie along the ground they are on.
        let ahead = ball + q_rot(q_y(fyaw), vec3<f32>(0.0, 0.0, 0.07));
        let near = 1.0 - smooth01((ball.y - ball_on(env, ball, l, 0.0).y) / 0.05);
        tilt[l] = near * atan2(height(env, ahead.x, ahead.z) - height(env, ball.x, ball.z), 0.07);
    }

    // --- the head: turned to the gaze, or glancing about ------------------------------
    var look = 0.0;
    var look_p = 0.0;
    let gaze_w = intent[ii + I_GAZE_W];
    if (gaze_w > 0.0) {
        let gz = vec3<f32>(intent[ii + I_GAZE_X], intent[ii + I_GAZE_Y], intent[ii + I_GAZE_Z]) - (org + vec3<f32>(0.0, HEAD[B_HEAD].y + K.root.y, 0.0));
        let gl = q_rot(q_conj(qyaw), gz);
        look = gaze_w * clamp(atan2(gl.x, gl.z), -1.4, 1.4);
        look_p = gaze_w * clamp(-atan2(gl.y, length(vec2<f32>(gl.x, gl.z))), -0.7, 0.7);
    }
    // With nothing to look at it looks about as a bird does: its head goes
    // to a new place in a tenth of a second, every second or two, and is
    // dead still between (x its turn, y its pitch, z cocked to one side,
    // which some are); smaller and fewer on the move, none at a run.
    let idle = LIFE * still;
    let gt = clock / GLANCE_T + seed;
    let gk = floor(gt);
    let gu = smooth01((gt - gk) * GLANCE_T / SNAP_T);
    let roam = LIFE * (1.0 - gaze_w) * (1.0 - 0.55 * gw) * (1.0 - rw) * (1.0 - 0.7 * wg);
    let g0 = vec3<f32>(1.9 * (hash01((gk - 1.0) * 9.7 + seed) - 0.5), 0.36 * (hash01((gk - 1.0) * 4.1 + seed * 7.0) - 0.4),
                       select_f(hash01((gk - 1.0) * 5.3 + seed * 3.1) > 0.55, 0.9 * (hash01((gk - 1.0) * 2.9 + seed) - 0.5), 0.0));
    let g1 = vec3<f32>(1.9 * (hash01(gk * 9.7 + seed) - 0.5), 0.36 * (hash01(gk * 4.1 + seed * 7.0) - 0.4),
                       select_f(hash01(gk * 5.3 + seed * 3.1) > 0.55, 0.9 * (hash01(gk * 2.9 + seed) - 0.5), 0.0));
    let snap = roam * mix(g0, g1, gu);
    // (How far this one took it, falling away after: the crest's stir.)
    let stir = roam * min(length(g1 - g0), 1.0) * smooth01((gt - gk) * GLANCE_T / SNAP_T) * exp(-3.0 * (gt - gk) * GLANCE_T);
    let lk = crit_step(vec2<f32>(state[s + D_LOOK], state[s + D_LOOK_V]), look + 0.3 * omega, 14.0, dt);
    let lp = crit_step(vec2<f32>(state[s + D_LOOK_P], state[s + D_LOOK_PV]), look_p, 14.0, dt);
    state[s + D_LOOK] = lk.x;
    state[s + D_LOOK_V] = lk.y;
    state[s + D_LOOK_P] = lp.x;
    state[s + D_LOOK_PV] = lp.y;
    var KP = K;

    // --- life ---------------------------------------------------------------------------
    // Breathing: the breast lifts and the wings ride out on it.
    let breath = LIFE * (0.016 + 0.008 * wl + 0.01 * alert) * (1.0 - 0.7 * gw) * sin(TAU * clock / BREATH_T + seed);
    KP.q[B_SPINE] = turned(KP.q[B_SPINE], vec3<f32>(-0.5 * breath, 0.0, 0.0));
    KP.q[B_CHEST] = turned(KP.q[B_CHEST], vec3<f32>(-breath, 0.0, 0.0));
    // Now and then it shuffles its wings: both lifted off the flanks, shaken
    // twice and folded again, the tail's fan wagged after.
    let ht = clock / SHUFFLE_T + seed * 1.3;
    let hk = floor(ht);
    let hu = (ht - hk) * SHUFFLE_T / 0.9;
    var shuffle: f32 = 0.0;
    var wag: f32 = 0.0;
    if (hu < 1.8 && hash01(hk * 3.7 + seed) > 0.4) {
        shuffle = idle * (1.0 - 0.5 * wl) * bump(min(hu, 1.0), 0.3, 0.55);
        wag = idle * bump(clamp(hu - 0.7, 0.0, 1.0), 0.2, 0.4) * sin(TAU * 3.0 * (hu - 0.7));
    }
    let shake = shuffle * sin(TAU * 2.0 * hu);
    KP.q[B_WINGL] = turned(KP.q[B_WINGL], vec3<f32>(0.1 * shuffle + 0.5 * breath, -0.34 * shuffle - 0.07 * shake - 1.5 * breath, 0.0));
    KP.q[B_WINGR] = turned(KP.q[B_WINGR], vec3<f32>(0.1 * shuffle + 0.5 * breath, 0.34 * shuffle - 0.07 * shake + 1.5 * breath, 0.0));
    // Its weight wanders from foot to foot, the hips tipping with it.
    let shift = idle * (1.0 - wl) * noise1(clock * 0.21, seed, 1.0);
    KP.root.x += 0.016 * shift;
    KP.q[B_PELVIS] = turned(KP.q[B_PELVIS], vec3<f32>(0.0, 0.0, 0.03 * shift));
    KP.q[B_SPINE] = turned(KP.q[B_SPINE], vec3<f32>(0.0, 0.0, -0.03 * shift));
    // The tail's fan: tipped a little up and down as it stands, and wagged.
    let fan = idle * (1.0 - 0.6 * wl) * noise1(clock * 0.27, seed, 2.0);
    for (var i: i32 = 0; i < 3; i += 1) {
        KP.q[B_TAIL1 + i] = turned(KP.q[B_TAIL1 + i], vec3<f32>(0.035 * fan, (0.05 + 0.03 * f32(i)) * wag, 0.0));
    }
    // The crest: stirred by each turn of the head, lifted when it is
    // curious (its head cocked).
    let lying = wl * smooth01((lie - 0.4) / 0.6);
    let curious = abs(snap.z) / 0.45;
    KP.q[B_CREST1] = turned(KP.q[B_CREST1], vec3<f32>(0.5 * stir + 0.45 * curious, 0.0, 0.0));
    KP.q[B_CREST2] = turned(KP.q[B_CREST2], vec3<f32>(0.3 * stir + 0.25 * curious, 0.0, 0.0));

    // --- the eyes -----------------------------------------------------------------------
    // A bird's eye hardly turns in its head: it goes a little way first to
    // where the head is about to turn. Its lids say how it is: wide when
    // alert, narrowed at a run, squeezed shut in a flinch, the lower lid
    // coming up as it dozes lying down. It blinks with its third eyelid,
    // across from the front and back in a seventh of a second, and always
    // as its head snaps round.
    KP.q[B_GAZE] = q_xyz(vec3<f32>(clamp(0.6 * (look_p - lp.x), -0.2, 0.2), clamp(0.6 * (look - lk.x), -0.25, 0.25), 0.0));
    let bt = clock / BLINK_T + seed * 5.7;
    let bk = floor(bt);
    let bu = ((bt - bk) - 0.1 - 0.7 * hash01(bk * 4.3 + seed)) * BLINK_T;
    var blink: f32 = 0.0;
    if (bu > 0.0 && bu < 0.15) { blink = smooth01(bu / 0.05) * (1.0 - smooth01((bu - 0.06) / 0.09)); }
    let turning = roam * min(length(g1 - g0) / 0.8, 1.0) * bump(clamp((gt - gk) * GLANCE_T / (1.6 * SNAP_T), 0.0, 1.0), 0.35, 0.6);
    let wide = smooth01(alert) * (1.0 - wl) * (1.0 - flinch);
    let doze = lying * (0.45 + 0.35 * smooth01(2.0 * noise1(clock * 0.15, seed, 6.0)));
    let shut = clamp(max(0.1 - 0.5 * wide + 0.16 * rw * gw + doze, 0.95 * flinch), -0.6, 1.0);
    KP.q[B_LID] = q_xyz(vec3<f32>(asin(shut), 0.0, asin(clamp(LIFE * max(blink, turning), 0.0, 1.0))));

    // --- the head, held level -----------------------------------------------------------
    // Where the keys would turn the head, in the creature's frame, is eased;
    // the neck's top bone and the head each take half of the turn from the
    // neck under them to that, so the body works under a head that stays
    // level and looks where it is going.
    let qc = q_mul(q_mul(q_mul(KP.q[B_PELVIS], KP.q[B_SPINE]), KP.q[B_CHEST]), q_mul(KP.q[B_NECK1], KP.q[B_NECK2]));
    let qk = q_mul(qc, q_mul(KP.q[B_NECK3], KP.q[B_HEAD]));
    var qe = vec4<f32>(state[s + D_HEADQ], state[s + D_HEADQ + 1], state[s + D_HEADQ + 2], state[s + D_HEADQ + 3]);
    if (init) { qe = qk; }
    qe = q_blend(qe, qk, 1.0 - exp(-(HEAD_RATE + 12.0 * flinch) * dt));
    state[s + D_HEADQ] = qe.x;
    state[s + D_HEADQ + 1] = qe.y;
    state[s + D_HEADQ + 2] = qe.z;
    state[s + D_HEADQ + 3] = qe.w;
    let qn2 = q_mul(q_conj(qc), q_blend(qk, qe, HEAD_SPACE * LAYERS));
    // (What the keys bend the neck by beyond its half of their own turn, it
    // keeps: the neck gives under the head at each step, and the head is
    // turned back by as much, so it travels on the neck without tipping.)
    let own = q_mul(q_conj(q_blend(q_id(), q_mul(KP.q[B_NECK3], KP.q[B_HEAD]), 0.5)), KP.q[B_NECK3]);
    let qn = q_mul(q_blend(q_id(), qn2, 0.5), own);
    KP.q[B_NECK3] = qn;
    KP.q[B_HEAD] = q_mul(q_conj(qn), qn2);
    // Over that, it turns to what it looks at: the turn taken up the whole
    // neck, the pitch by its top and the head, and the head alone cocked.
    let ty = lk.x + snap.x;
    let tp = lp.x + snap.y;
    KP.q[B_NECK1] = turned(KP.q[B_NECK1], vec3<f32>(0.0, 0.2 * ty, 0.0));
    KP.q[B_NECK2] = turned(KP.q[B_NECK2], vec3<f32>(0.0, 0.2 * ty, 0.0));
    KP.q[B_NECK3] = turned(KP.q[B_NECK3], vec3<f32>(0.4 * tp, 0.25 * ty, 0.0));
    KP.q[B_HEAD] = turned(KP.q[B_HEAD], vec3<f32>(0.6 * tp, 0.35 * ty, snap.z));

    // Pecking: the bill held a hand over the ground, stabbed down to it and
    // back, in runs; and every few seconds it lifts its head to look about.
    if (wg > 0.0) {
        let hold = wg * (0.24 + 0.05 * noise1(clock * 0.6, seed, 3.0));
        let run = smooth01(2.5 * noise1(clock * 0.3, seed, 5.0) + 0.6);
        let stab = run * pow(max(sin(TAU * clock / 0.62 + seed), 0.0), 5.0);
        let up = hold * (1.0 - stab) + wg * 0.9 * smooth01(3.0 * noise1(clock * 0.16, seed, 7.0) - 1.1) * (1.0 - run);
        KP.q[B_NECK1] = turned(KP.q[B_NECK1], vec3<f32>(-0.3 * up, 0.1 * wg * noise1(clock * 0.5, seed, 4.0), 0.0));
        KP.q[B_NECK2] = turned(KP.q[B_NECK2], vec3<f32>(-0.6 * up, 0.0, 0.0));
        KP.q[B_NECK3] = turned(KP.q[B_NECK3], vec3<f32>(-0.4 * up, 0.0, 0.0));
        KP.q[B_HEAD] = turned(KP.q[B_HEAD], vec3<f32>(0.75 * up, 0.0, 0.0));
    }

    // --- the pose: the keys' trunk, the legs solved to the feet ------------------------
    var T = key_trunk(KP, org + lift, qyaw);
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        T = leg_solve(T, l, qyaw, balls[l], K.fa[l].x, K.fa[l].y - tilt[l], dyaw[l], SOFT_REACH);
    }

    // (trace's p0..: the stride's phase, the walk's and the run's shares, the
    // left ball and hip in the creature's frame.)
    probe(state, s + PROBE, 0, fract01(phase));
    probe(state, s + PROBE, 1, gw);
    probe(state, s + PROBE, 2, rw);
    probe3(state, s + PROBE, 3, q_rot(q_conj(qyaw), balls[0] - org));
    probe3(state, s + PROBE, 6, q_rot(q_conj(qyaw), T.p[LEG_TOP[0]] - org));

    // --- in the air ----------------------------------------------------------------------
    // With no foot down its mass is in free fall (creature::keyed's air):
    // the whole of it is moved to where that has it. (Before the loose
    // parts, which swing from where the body is: hung from the keys' place
    // and moved after, they felt none of the fall and a jolt at each end of it.)
    var grounded = false;
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        if (state[s + D_LEG + l * LEG_REC + L_PLANT] > 0.5 || state[s + D_LEG + l * LEG_REC + L_HOME] > 0.0) { grounded = true; }
    }
    var A = moved(T, air_step(state, s + D_AIR, com_of(T), grounded, init, dt));

    // --- the loose parts carry their momentum ---------------------------------------
    for (var i: i32 = 0; i < NLOOSE; i += 1) {
        let k = s + D_LOOSE + i * DANGLE_REC;
        if (LOOSE[i] >= B_TAIL1) { A = trail(state, k, A, KP, LOOSE[i], org, LOOSE_W[i], LOOSE_MAX[i], LAYERS, dt, init); }
        else { A = loose(state, k, A, KP, LOOSE[i], LOOSE_W[i] + LOOSE_RUN[i] * rw, LOOSE_ZETA[i], LOOSE_MAX[i], LAYERS, dt, init); }
    }

    // --- out -------------------------------------------------------------------------------
    put(pose, c, A);
    st3(state, s + S_POS, pos);
    state[s + S_YAW] = yaw;
    state[s + D_SPEED] = speed;
    state[s + D_OMEGA] = omega;
    state[s + D_PHASE] = phase;
    state[s + D_MOVING] = select_f(moving, 1.0, 0.0);

    let t0 = c * TELE;
    tele[t0 + T_POS] = pos.x;
    tele[t0 + T_POS + 1] = T.p[ROOT].y;
    tele[t0 + T_POS + 2] = pos.z;
    tele[t0 + T_YAW] = yaw;
    tele[t0 + T_SPEED] = speed;
    tele[t0 + T_GAIT] = select_i(moving, select_i(run_u > 0.5, GAIT_RUN, GAIT_WALK), GAIT_STAND) as f32;
    tele[t0 + T_PHASE] = fract01(phase);
    tele[t0 + T_ACTION] = act as f32;
    tele[t0 + T_HEIGHT] = T.p[ROOT].y - ground_y;
    tele[t0 + T_PITCH] = 0.0;
    tele[t0 + T_ROLL] = 0.0;
    tele[t0 + T_FREQ] = freq * select_f(moving, 1.0, 0.0);
    for (var l: i32 = 0; l < NLEGS; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let f0 = t0 + T_FOOT + 4 * l;
        tele[f0] = state[k + L_PLANT];
        tele[f0 + 1] = balls[l].x;
        tele[f0 + 2] = balls[l].y;
        tele[f0 + 3] = balls[l].z;
    }
}
