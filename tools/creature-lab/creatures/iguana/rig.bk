// Green spiny iguana (Iguana iguana) rig: sprawling-limb reptilian locomotion,
// travelling lateral S-wave spine, phase-lagged 4-bone whip tail, territorial
// head-bobbing & gular dewlap flare, low herbivorous foliage browse, flat
// sun-basking rest, and agile obstacle vaults.
//
// All @knob const declarations, `pub fn pose`, and `@kernel @grid(1) fn k_rig`
// live here; pure gait, S-wave, and 3D sprawling limb IK helpers live in
// `iguana/gait.bk` (`module iguana::gait;`).
import creature::common::*;
import creature::contract::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::body::*;
import creature::spine::*;
import creature::leap::*;
import creature::limbs::*;
import creature::probe::*;
import iguana::gait::*;
from creature::ground import height, terrain, obstacle_ahead;

// Deliberate test faults (0 in the healthy iguana).
@knob const FAULT_SLIP: f32 = 0.0;
@knob const FAULT_SINK: f32 = 0.0;
@knob const FAULT_OVERBEND: f32 = 0.0;
@knob const FAULT_STUMBLE: f32 = 0.0;

// Reptilian biomechanical & behavioural tuning knobs.
@knob const SWAVE_AMP: f32 = 0.21;      // rad lateral S-wave amplitude across the spine
@knob const TAIL_AMP: f32 = 0.27;       // rad lateral/elliptical wave per whip-tail segment
@knob const BOB_AMP: f32 = 0.34;        // rad territorial head-bob nod amplitude
@knob const DEWLAP_FLARE: f32 = 0.64;   // rad downward gular dewlap fan extension in display
@knob const SCAP_SWING: f32 = 1.45;     // rad/m pectoral girdle yaw/pitch follow per m of stride
@knob const SWING_CURL: f32 = 0.44;     // rad plantigrade foot/digit curl during swing
@knob const HEAD_HOLD: f32 = 0.72;      // cervical counter-steering against trunk pitch/bob
@knob const HEAD_SPACE: f32 = 0.85;     // world-space gaze hold on head in secondary carry
@knob const NECK_LEVER: f32 = 0.14;     // m cervical lever arm for vertical bob compensation
@knob const REACH_FORE: f32 = 0.208;    // m 2-bone workspace radius from fore virtual pivot
@knob const REACH_HIND: f32 = 0.258;    // m 2-bone workspace radius from hind virtual pivot
@knob const SHORT_LET: f32 = 0.010;     // m IK shortfall tolerance before triggering a step
@knob const LIE_HIP: f32 = 0.068;       // m pelvic height when sun-basking on warm ground
@knob const LIE_SHOULDER: f32 = 0.088;  // m pectoral height when sun-basking
@knob const SPRINT_LIFT: f32 = 0.016;   // m elevated high-walk/sprint trunk lift in gallop
@knob const VARY: f32 = 1.0;            // natural stride-to-stride organic variation
@knob const LAYERS: f32 = 1.0;          // share of dynamic CoM/spine/secondary layers
@knob const LAND_REACH: f32 = 0.78;     // landing mark fraction of horizontal reach
@knob const LAND_WALK: f32 = 0.84;      // landing mark fraction in deliberate walk
@knob const LAND_MIN: f32 = 0.25;       // minimum landing mark fraction
@knob const TROT_SPRING: f32 = 0.56;    // stance springiness in trot/sprint
@knob const GALLOP_FREE: f32 = 0.018;   // m upward CoM freedom in sprint
@knob const RISE_IN: f32 = 0.002;
@knob const TUCK_HIND: f32 = 0.30;      // hind leg tuck fraction clearing obstacles in flight
@knob const TUCK_FORE: f32 = 0.26;      // fore leg tuck fraction clearing obstacles in flight
@knob const TUCK_BACK: f32 = -0.07;     // m hind foot draw-back in flight
@knob const UNTUCK: f32 = 0.68;
@knob const LAND_EXT: f32 = 0.94;
@knob const LEAP_AHEAD: f32 = 0.46;
@knob const SPENT: f32 = 1.4;
@knob const SLOW_DUTY: f32 = 0.04;
@knob const LAG_FREE: f32 = 0.015;
@knob const LAG_BAND: f32 = 0.045;
@knob const GALLOP_ACC: f32 = 0.72;
@knob const COFF_W: f32 = 18.0;
@knob const LAND_LEAD: f32 = 0.16;

pub const PROBE: i32 = IG_PROBE;
pub const STATE: i32 = IG_STATE;

// Gait transition thresholds tailored to walk 0.55, trot 1.6, sprint gallop 4.2 m/s.
const WALK_UP: f32 = 0.96;
const TROT_DOWN: f32 = 0.78;
const TROT_UP: f32 = 2.65;
const GALLOP_DOWN: f32 = 2.20;

const SETTLE_TRIG: f32 = 0.065;
const REACH_TRIG: f32 = 0.220;
const SETTLE_T: f32 = 0.26;
const RISE_EASE: f32 = 0.010;
const GUARD_RATE: f32 = 22.0;

pub fn pose(c: i32, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
            pose_out: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    let s = c * STATE;
    let ii = c * INTENT;
    let init = state[s + S_PLACED] < 0.5;
    if (init) { place_iguana(state, env, s); }

    // --- 1. Intent & signature reptilian actions (smooth C2 springs, zero velocity corners) ---
    var vdes = vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z]);
    let act = intent[ii + I_ACTION] as i32;
    let seed = intent[ii + I_SEED];
    let clock = state[s + IG_CLOCK] + dt;
    state[s + IG_CLOCK] = clock;

    let lie_want = select_f(act == ACT_LIE, 1.0, 0.0);
    var lie_s = crit_step(vec2<f32>(state[s + IG_LIE], state[s + IG_LIE_V]), lie_want, 3.2, dt);
    if (init) { lie_s = vec2<f32>(lie_want, 0.0); }
    let lie = clamp01(lie_s.x);

    let graze_want = select_f(act == ACT_GRAZE, 1.0, 0.0);
    var grz_s = crit_step(vec2<f32>(state[s + IG_GRAZE], state[s + IG_GRAZE_V]), graze_want, 5.2, dt);
    if (init) { grz_s = vec2<f32>(graze_want, 0.0); }
    let graze = clamp01(grz_s.x);

    let alert_want = select_f(act == ACT_STARTLE || act == ACT_ALERT, 1.0, 0.0);
    let aw = select_f(alert_want > state[s + IG_ALERT], 12.0, 2.4);
    var als = crit_step(vec2<f32>(state[s + IG_ALERT], state[s + IG_ALERT_V]), alert_want, aw, dt);
    if (init) { als = vec2<f32>(alert_want, 0.0); }
    let alert = clamp01(als.x);

    // Territorial head-bob & dewlap display activates in `ACT_ALERT`, `ACT_STARTLE`,
    // and attentive standing `idle` (when gazing around while stationary).
    let gwt = intent[ii + I_GAZE_W];
    let still_gaze = gwt * (1.0 - clamp01(length(vdes) / 0.1)) * (1.0 - lie_want) * (1.0 - graze_want);
    let disp_want = clamp01(max(alert_want, still_gaze));
    let dw_rate = select_f(disp_want > state[s + IG_DISP], 7.5, 2.6);
    var dps = crit_step(vec2<f32>(state[s + IG_DISP], state[s + IG_DISP_V]), disp_want, dw_rate, dt);
    if (init) { dps = vec2<f32>(disp_want, 0.0); }
    let disp = clamp01(dps.x);

    var st_t = state[s + IG_STARTLE_T];
    if (act == ACT_STARTLE && (state[s + IG_PREV_ACT] as i32) != ACT_STARTLE) { st_t = 0.0; }
    if (st_t >= 0.0) { st_t += dt; }
    if (st_t > 3.2) { st_t = -1.0; }

    state[s + IG_LIE] = lie; state[s + IG_LIE_V] = lie_s.y;
    state[s + IG_GRAZE] = graze; state[s + IG_GRAZE_V] = grz_s.y;
    state[s + IG_ALERT] = alert; state[s + IG_ALERT_V] = als.y;
    state[s + IG_DISP] = disp; state[s + IG_DISP_V] = dps.y;
    state[s + IG_STARTLE_T] = st_t;
    state[s + IG_PREV_ACT] = act as f32;

    if (lie > 0.002 || act == ACT_LIE) { vdes = vec2<f32>(0.0); }
    vdes *= (1.0 - 0.82 * graze);

    // --- 2. Heading & speed integration --------------------------------------------------------
    var yaw = state[s + S_YAW];
    var speed = state[s + IG_SPEED];
    var want = yaw;
    let vd = length(vdes);
    let vary = VARY * smooth01(speed / 0.30) * smooth01(1.0 - abs(vd - speed) / 0.28);
    if (intent[ii + I_HEADING_MODE] > 0.5) {
        want = intent[ii + I_HEADING];
    } else if (vd > 0.03) {
        want = atan2(vdes.x, vdes.y) + vary * 0.035 * noise1(clock / 1.6, seed, 2.0);
    }
    let leaping = state[s + IG_LEAP] > 0.5;
    let max_turn = mix(0.75, 3.2 / (1.0 + 0.45 * speed), smooth01(speed / 0.42));
    let w_t = clamp(3.4 * wrap_pi(want - yaw), -max_turn, max_turn) * select_f(leaping, 0.0, 1.0);
    let omega = approach(state[s + IG_OMEGA], w_t, 6.5, dt);
    let yaw0 = yaw;
    yaw = wrap_pi(yaw + omega * dt);
    let err = wrap_pi(want - yaw);

    let vt = vd * clamp(cos(err), 0.18, 1.0) * (1.0 + vary * 0.038 * noise1(clock / 1.35, seed, 1.0));
    let dv_max = 0.85 * MU_T * 9.81;
    let lag_f = dot(ld3(state, s + IG_LAG), vec3<f32>(sin(yaw), 0.0, cos(yaw)));
    let wait = 1.0 - 0.75 * smooth01((select_f(vt > speed, -lag_f, lag_f) - LAG_FREE) / LAG_BAND)
        * smooth01((abs(vt - speed) - 0.2) / 0.35);
    let gallop_w = state[s + IG_GW + 2];
    if (!leaping) {
        let acc_rate = min(select_f(vt > speed, 2.0 + 0.9 * speed, 4.2), dv_max) * mix(1.0, GALLOP_ACC, gallop_w) * wait;
        speed = approach(speed, vt, acc_rate, dt);
    }

    let fwd = vec3<f32>(sin(yaw), 0.0, cos(yaw));
    let left = vec3<f32>(cos(yaw), 0.0, -sin(yaw));
    var pos = ld3(state, s + S_POS);
    pos += fwd * speed * dt;
    let tz = turn_z();
    pos += (vec3<f32>(sin(yaw0), 0.0, cos(yaw0)) - fwd) * tz;
    let lag = ld3(state, s + IG_LAG) * vec3<f32>(1.0, 0.0, 1.0) * LAYERS;
    let bpos = pos + lag;
    let vel = fwd * speed + ld3(state, s + IG_LAGV) * vec3<f32>(1.0, 0.0, 1.0) * LAYERS;

    // --- 3. Agile lizard obstacle vault (`creature::leap`) -------------------------------------
    var lp = leap_load(state, s + IG_LEAP);
    let hip_t = terrain(env, pos.x, pos.z);
    if (lp.on) {
        lp.tau += dt;
        if (lp.tau >= lp.tcr && lp.tau - dt < lp.tcr) {
            lp.h0 = state[s + IG_HY] + state[s + IG_LAG + 1];
            lp.v0 = state[s + IG_HV] + state[s + IG_LAGV + 1];
        }
        let fd_t = fore_down(lp);
        if (lp.tau >= fd_t && lp.tau - dt < fd_t) {
            lp.h0 = state[s + IG_HY_O] + state[s + IG_LAG + 1];
            lp.v0 = state[s + IG_BODY + 4];
        }
        let at_tc = lp.tau >= lp.tc && lp.tau - dt < lp.tc;
        let at_off = lp.tau >= 0.0 && lp.tau - dt < 0.0;
        if (at_off) {
            lp = leap_takeoff(lp, state[s + IG_BODY + 1] - state[s + IG_COFF1 + 1], state[s + IG_BODY + 4]);
            state[s + IG_BODY + 4] = lp.vy;
            speed = max(speed + dot(ld3(state, s + IG_LAGV), fwd), 0.55 * speed);
            lp.fl = reach_time(env, lp, 1, pos, fwd, speed, q_y(yaw), REACH_HIND, REACH_FORE, LAND_LEAD);
            lp.hl = max(reach_time(env, lp, 0, pos, fwd, speed, q_y(yaw), REACH_HIND, REACH_FORE, LAND_LEAD), lp.fl + 0.22 * leg_time());
        }
        for (var l: i32 = 0; l < 4; l += 1) {
            let k = s + IG_LEG + l * LEG_REC;
            if (state[k + L_PLANT] < 0.5 && (at_off || (at_tc && LEG_HIND[l] == 0))) {
                flight_swing(state, k, leap_leg(lp, LEG_HIND[l] == 1, 0.5 * (1.0 - LEG_SIDE[l])).w - lp.tau);
            }
        }
        if (lp.tau >= leap_end(lp)) { lp.on = false; lp.since = 0.0; }
    } else {
        lp.since += dt;
    }
    var in_leap = lp.on && !lp.legs_back;

    // --- 4. Sprawling gait selection, cadence & duty factor ------------------------------------
    var gait = state[s + IG_GAIT] as i32;
    if (gait == GAIT_WALK && speed > WALK_UP) { gait = GAIT_TROT; }
    else if (gait == GAIT_TROT && speed < TROT_DOWN) { gait = GAIT_WALK; }
    else if (gait == GAIT_TROT && speed > TROT_UP) { gait = GAIT_GALLOP; }
    else if (gait == GAIT_GALLOP && speed < GALLOP_DOWN) { gait = GAIT_TROT; }

    var gw = ld3(state, s + IG_GW);
    gw.x = approach(gw.x, select_f(gait == GAIT_WALK, 1.0, 0.0), 2.5, dt);
    gw.y = approach(gw.y, select_f(gait == GAIT_TROT, 1.0, 0.0), 2.5, dt);
    gw.z = approach(gw.z, select_f(gait == GAIT_GALLOP, 1.0, 0.0), 2.5, dt);
    gw = gw / max(gw.x + gw.y + gw.z, 1e-4);

    let veff = max(speed, max(abs(omega), abs(w_t)) * mix(0.75, 0.20, smooth01(speed / 0.42)));
    // Cadence & duty tuned so measured sole contact duty matches 0.66 (walk), 0.48 (trot), 0.36 (gallop).
    let freq = gw.x * (0.96 + 1.36 * veff) + gw.y * (1.98 + 0.52 * veff) + gw.z * (2.68 + 0.30 * veff);
    let duty = gw.x * (clamp(0.55 - 0.03 * veff, 0.49, 0.57) + SLOW_DUTY * (1.0 - smooth01(veff / 0.55)))
        + gw.y * 0.22 + gw.z * 0.12;
    let lift_base = gw.x * vec2<f32>(0.046, 0.048) + gw.y * vec2<f32>(0.060, 0.064) + gw.z * vec2<f32>(0.068, 0.072);
    let roll_w = gw.x * 0.13 + gw.y * 0.15 + gw.z * 0.12;

    var phase = state[s + IG_PHASE];
    let was_moving = state[s + IG_MOVING] > 0.5;
    var moving = vd > 0.035 || speed > 0.035 || abs(err) > 0.09;
    if (was_moving) { moving = moving || speed > 0.018 || vd > 0.018 || abs(err) > 0.04; }
    if (lie > 0.002) { moving = false; }

    var go_s = crit_step(vec2<f32>(state[s + IG_STILL], state[s + IG_STILL_V]), select_f(moving, 1.0, 0.0), 7.5, dt);
    if (init) { go_s = vec2<f32>(0.0); }
    state[s + IG_STILL] = go_s.x; state[s + IG_STILL_V] = go_s.y;
    let gom = clamp01(go_s.x);

    var offs: array<f32, 4>;
    let pivot = (1.0 - smooth01(speed / 0.22)) * smooth01(max(abs(omega), abs(w_t)) / 0.15);
    for (var l: i32 = 0; l < 4; l += 1) {
        offs[l] = off_mix(OFF_WALK, OFF_TROT, OFF_GALLOP, gw, l);
        offs[l] += pivot * phase_diff(offs[l], OFF_TROT[l]);
    }
    let cyc = floor(phase);
    if (cyc - 2.0 * floor(cyc * 0.5) > 0.5) { offs[3] += FAULT_STUMBLE; }
    if (moving && !was_moving) {
        phase = floor(phase) + 1.0 + offs[0] + duty;
        for (var l: i32 = 0; l < 4; l += 1) {
            state[s + IG_LEG + l * LEG_REC + L_ARMED] = 1.0;
        }
    }

    // Trigger obstacle vault ahead when sprinting toward a log or in ACT_BOUND.
    if (!lp.on && !init && moving && gw.z > 0.65 && lie < 0.001) {
        var c_rem = fract01(duty - (phase - offs[3]));
        if (c_rem < 0.05) { c_rem += 1.0; }
        let trail = min(0.5 * speed * duty / max(freq, 0.5), 0.72 * REACH_HIND);
        let vr_h = leg_virt_rest(0);
        let h_take = hip_t + sqrt(max(REACH_HIND * REACH_HIND - trail * trail, 0.03)) + HEAD[B_PELVIS].y - vr_h.y - 0.014;
        let ob = obstacle_ahead(env, pos.x, pos.z, vec2<f32>(fwd.x, fwd.z));
        let dc = duty + fract01(offs[3] - offs[0]);
        let held = max(PUSH_T * leg_time() - dc / freq, 0.0);
        let dist = ob.x - leap_lead(flight_time(leap_rise(ob.y, hip_t, h_take)), speed, tz) - speed * held;
        var st_c = vec2<f32>(0.0, c_rem);
        var obst = ob.y;
        if (ob.y > 0.0 && dist < speed * (c_rem + 3.0) / freq) {
            st_c = leap_stride(c_rem, dist, speed, freq);
        } else if (act == ACT_BOUND && lp.since > 0.06 && c_rem > dc + 0.25 && ob.x > 4.0 * speed / freq) {
            st_c.x = 1.0; obst = 0.0;
        }
        if (st_c.x > 0.0) {
            lp = leap_begin(lp, obst, hip_t, state[s + IG_HY] - hip_t, h_take,
                            state[s + IG_HY] + state[s + IG_LAG + 1],
                            state[s + IG_HV] + state[s + IG_LAGV + 1], st_c.y, dc, freq, st_c.x);
            for (var l: i32 = 0; l < 4; l += 1) { state[s + IG_LEG + l * LEG_REC + L_LEAP] = 0.0; }
            in_leap = true;
        }
    }

    let cfreq = freq * select_f(in_leap && lp.tau < 0.0, select_f(lp.tau < lp.tc, lp.rate, lp.prate), 1.0);
    if (moving) { phase += cfreq * dt; }

    let hind_air = state[s + IG_LEG + L_PLANT] < 0.5 || state[s + IG_LEG + 3 * LEG_REC + L_PLANT] < 0.5;
    let sunk = lp.tau >= fore_down(lp) + sink_time(lp, hip_t + lp.h_stand);
    if (in_leap && lp.tau >= legs_done(lp) && sunk && (!hind_air || lp.tau >= legs_done(lp) + 0.20)) {
        lp.legs_back = true;
        in_leap = false;
        phase = floor(phase) + 1.0 + offs[3];
        for (var l: i32 = 0; l < 4; l += 1) {
            state[s + IG_LEG + l * LEG_REC + L_ARMED] = 1.0;
            state[s + IG_LEG + l * LEG_REC + L_LEAP] = 0.0;
        }
    }

    probe(state, s + PROBE, 0, select_f(lp.on, lp.tau, 0.0));
    probe(state, s + PROBE, 1, select_f(lp.on, lp.tc, 0.0));
    probe(state, s + PROBE, 2, dot(lag, fwd));

    // --- 5. Foot placement, C2 swing trajectories, and terrain clamping ------------------------
    let qyaw = q_y(yaw);
    var any_swing = false;
    var worst: i32 = -1;
    var worst_e: f32 = SETTLE_TRIG;
    let settle_ref = select_v3(moving, bpos, pos);
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + IG_LEG + l * LEG_REC;
        if (state[k + L_PLANT] < 0.5) {
            any_swing = true;
        } else {
            let toe0 = TAIL[LEG_TOE[l]] - HEAD[B_PELVIS];
            let home = settle_ref + q_rot(qyaw, vec3<f32>(toe0.x, 0.0, toe0.z));
            let t = ld3(state, k + L_TOE);
            let e = length(vec2<f32>(t.x - home.x, t.z - home.z));
            if (e > worst_e) { worst_e = e; worst = l; }
        }
    }

    var sw: array<f32, 4>;
    var feet: array<vec3<f32>, 4>;
    var toes: array<vec3<f32>, 4>;
    var left_t: array<f32, 4>;
    var swing_sum_hind: f32 = 0.0;
    var sway: f32 = 0.0;
    var hip_drop: f32 = 0.0;

    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + IG_LEG + l * LEG_REC;
        let hind = LEG_HIND[l] == 1;
        let side01 = 0.5 * (1.0 - LEG_SIDE[l]);
        let toe0 = TAIL[LEG_TOE[l]] - HEAD[B_PELVIS];
        // S-wave stride reach bonus: lateral pelvic/pectoral rotation naturally shifts home along ±Z.
        let home_off = vec3<f32>(toe0.x, 0.0, toe0.z);
        let home = bpos + q_rot(qyaw, home_off);
        let ph = fract01(phase - offs[l]);
        var planted = state[k + L_PLANT] > 0.5;
        var toe = ld3(state, k + L_TOE);
        var lift = false;
        var lift_t: f32 = SETTLE_T;
        var kind: f32 = 1.0;

        if (planted) {
            if (FAULT_SLIP > 0.0) { toe -= vel * (FAULT_SLIP * dt); }
            if (ph < duty) { state[k + L_ARMED] = 1.0; }
            let stray = length(vec2<f32>(toe.x - home.x, toe.z - home.z));
            let top = leg_top(l, bpos, qyaw, state[s + IG_HY_O], state[s + IG_FY_O])
                + vec3<f32>(0.0, max(state[s + IG_LAG + 1], 0.0) * LAYERS, 0.0);
            let over = (length(toe - top) > select_f(hind, REACH_HIND, REACH_FORE)
                || (state[s + IG_SHORT + l] > SHORT_LET && !init)) && lie < 0.02;
            let lev = leap_leg(lp, hind, side01);
            let early = lp.tau >= lp.tc - 0.08 && state[k + L_SINCE] < lp.tau - (lp.tc - 0.08);
            if (in_leap && ((hind && (lp.tau >= lp.tc - 0.02 || early)) || lp.tau >= lev.z)) {
                let spent = length(toe - top) > REACH_HIND - SPENT * lp.vy * dt;
                if (state[k + L_LEAP] < 2.5 && (lp.tau >= lev.z || (hind && (over || spent) && lp.tau > -0.05))) {
                    lift = true; lift_t = lev.w - lp.tau; kind = 0.0; state[k + L_LEAP] = 3.0;
                } else if (!hind && state[k + L_LEAP] > 3.5 && state[k + L_LEAP] < 4.5 && over) {
                    lift = true; kind = 0.0; state[k + L_LEAP] = 5.0;
                    lift_t = clamp(0.6 * (1.0 - duty) / max(cfreq, 0.1), 0.08, 0.22);
                }
            } else if (moving && state[k + L_ARMED] > 0.5 && ph >= duty) {
                lift = true;
                lift_t = clamp((1.0 - ph) / max(cfreq, 0.1), 0.08, 0.48);
                kind = 0.0;
            } else if (moving && (stray > REACH_TRIG || over)) {
                lift = true;
                kind = select_f(in_leap, 1.0, 0.0);
                lift_t = clamp((1.0 - ph) / max(cfreq, 0.1), min(0.14, 0.5 * (1.0 - duty) / max(cfreq, 0.1)), 0.42);
            } else if (!moving && lie < 0.02 && !any_swing && worst == l) {
                lift = true;
            }
            if (lift) {
                planted = false;
                any_swing = true;
                state[k + L_ARMED] = 0.0;
                st3(state, k + L_FROM, toe);
                state[k + L_U] = 0.0;
                state[k + L_T] = lift_t;
                state[k + L_KIND] = kind;
                state[k + L_SINCE] = select_f(in_leap && hind, 1.0, hoof_roll(ph, duty, roll_w) * gom);
            }
        }

        var u: f32 = 0.0;
        if (!planted) {
            let tt = max(state[k + L_T], 0.04);
            u = state[k + L_U];
            var target = home;
            let leap_step = in_leap && state[k + L_LEAP] > 2.5 && state[k + L_LEAP] < 4.5;
            if (leap_step) {
                let t_ref = leap_leg(lp, hind, side01).w + LAND_LEAD * leg_time();
                target = bpos + fwd * (speed * (t_ref - lp.tau)) + q_rot(qyaw, home_off);
            } else if (moving || gom > 1e-3) {
                var stance_t = duty / max(cfreq, 0.1);
                var ahead_s: f32 = 0.50;
                if (in_leap && hind && lp.tau < 0.0 && lp.tau + (1.0 - u) * tt > lp.tc - 0.04) {
                    stance_t = max(-(lp.tau + (1.0 - u) * tt), 0.0);
                    ahead_s = LEAP_AHEAD;
                }
                let lead = (1.0 - u) * tt + ahead_s * stance_t;
                let yl = yaw + omega * lead;
                target = bpos + vel * lead + (fwd - vec3<f32>(sin(yl), 0.0, cos(yl))) * tz + q_rot(q_y(yl), home_off);
                let top_l = leg_top(l, bpos, qyaw, state[s + IG_HY_O], state[s + IG_FY_O]) + vel * ((1.0 - u) * tt);
                let rl = select_f(hind, REACH_HIND, REACH_FORE);
                let dyl = top_l.y + max(state[s + IG_LAG + 1], 0.0) * LAYERS - height(env, target.x, target.z);
                let hml = max(mix(LAND_REACH, LAND_WALK, gw.x) * sqrt(max(rl * rl - dyl * dyl, 0.0)), LAND_MIN * rl);
                let tv = vec2<f32>(target.x - top_l.x, target.z - top_l.z);
                let tl = length(tv);
                if (tl > hml && tl > 1e-4) {
                    target.x = top_l.x + tv.x * (hml / tl);
                    target.z = top_l.z + tv.y * (hml / tl);
                }
                if (!moving) { target = mix(home, target, gom); }
            }
            target.y = height(env, target.x, target.z);
            if (l == 1) { target.y -= FAULT_SINK; }
            st3(state, k + L_TO, target);

            u = u + dt / tt;
            var lifted = ld3(state, k + L_FROM);
            let top = leg_top(l, bpos, qyaw, state[s + IG_HY_O], state[s + IG_FY_O])
                + vec3<f32>(0.0, select_f(leap_step, state[s + IG_LAG + 1] * LAYERS, 0.0), 0.0);
            if (leap_step && !init) {
                lifted += top - ld3(state, s + IG_TOPO + 3 * l);
                st3(state, k + L_FROM, lifted);
            }
            let rmax = select_f(hind, REACH_HIND, REACH_FORE);
            var landed = u >= 1.0;
            if (landed && leap_step && length(target - top) > rmax) { landed = false; u = 0.999; }
            u = min(u, 1.0);
            let e = ease01(u);

            let lift_mod = 1.0 + 0.06 * vary * noise1(clock / 1.5, seed, 20.0 + f32(l));
            var hgt = select_f(hind, lift_base.x, lift_base.y) * lift_mod;
            if (state[k + L_KIND] > 0.5 && state[k + L_KIND] < 1.5) { hgt = 0.022; }

            var to = target;
            if (leap_step) {
                let rem = (1.0 - min(u, 1.0)) * tt;
                let hv = vec2<f32>(target.x - top.x - vel.x * rem, target.z - top.z - vel.z * rem);
                let rr = LAND_EXT * rmax;
                let hh = min(length(hv), 0.88 * rr);
                let hd = hv / max(length(hv), 1e-4);
                to = top + vec3<f32>(hd.x * hh, -sqrt(max(rr * rr - hh * hh, 0.0)), hd.y * hh);
            }

            // Smooth lateral outward swing arc characteristic of sprawling reptile limbs!
            let sprawl_arc = LEG_SIDE[l] * 0.014 * swing_bump(u) * gom * (1.0 - select_f(leap_step, 1.0, 0.0));
            toe = mix(lifted, to, e) + left * sprawl_arc;
            toe.y += hgt * swing_bump(u);

            if (leap_step) {
                let tuck = top + q_rot(qyaw, vec3<f32>(
                    LEG_SIDE[l] * 0.085,
                    -select_f(hind, TUCK_HIND * REACH_HIND, TUCK_FORE * REACH_FORE),
                    select_f(hind, -TUCK_BACK, -0.02)
                ));
                let tw = smooth01(u / 0.28) * (1.0 - smooth01((u - select_f(hind, UNTUCK, 0.55)) / select_f(hind, 0.97 - UNTUCK, 0.40)));
                toe = mix(toe, tuck, tw);
                let rv = toe - top;
                let rl = length(rv);
                if (rl > 1e-4) { toe = top + rv * (soft_cap(rl, rmax, 0.02) / rl); }
            }

            let dy = top.y - toe.y;
            let hmax = sqrt(max(rmax * rmax - dy * dy, 0.0));
            let hv2 = vec2<f32>(toe.x - top.x, toe.z - top.z);
            let hl = length(hv2);
            if (hl > 1e-4) {
                let cap_n = soft_cap(hl, hmax, select_f(in_leap, 0.02, CAP_BAND));
                if (state[k + L_U] <= 0.0) { state[s + IG_CAPOFF + l] = max(hl - cap_n, 0.0); }
                let cap_e = smin(hl, cap_n + state[s + IG_CAPOFF + l] * (1.0 - ease01(u / 0.25)), 0.008);
                let hn = mix(hl, cap_e, select_f(leap_step, 1.0, max(ease01(u / 0.20), smooth01((speed - 0.8) / 0.8))));
                toe.x = top.x + hv2.x * (hn / hl);
                toe.z = top.z + hv2.y * (hn / hl);
            }

            var gy = height(env, toe.x, toe.z);
            if (l == 1) { gy -= FAULT_SINK; }
            toe.y = max(toe.y, gy);
            if (landed) {
                toe.y = gy;
                planted = true;
                state[k + L_ARMED] = select_f(ph < duty || !moving, 1.0, 0.0);
                state[k + L_SINCE] = 0.0;
                if (leap_step) { state[k + L_LEAP] = state[k + L_LEAP] + 1.0; }
            }
            state[k + L_U] = u;
        }

        if (planted) {
            state[k + L_SINCE] = state[k + L_SINCE] + dt;
            if (FAULT_SLIP <= 0.0) {
                var gy_p = height(env, toe.x, toe.z);
                if (l == 1) { gy_p -= FAULT_SINK; }
                toe.y = gy_p;
            }
        }
        st3(state, s + IG_TOPO + 3 * l, leg_top(l, bpos, qyaw, state[s + IG_HY_O], state[s + IG_FY_O])
            + vec3<f32>(0.0, state[s + IG_LAG + 1] * LAYERS, 0.0));
        state[k + L_PLANT] = select_f(planted, 1.0, 0.0);
        st3(state, k + L_TOE, toe);

        var lt: f32 = 1e3;
        if (in_leap && hind && lp.tau >= lp.tc - 0.02) {
            if (planted && state[k + L_LEAP] < 2.5) { lt = max(leap_leg(lp, hind, side01).z - lp.tau, 0.0); }
        } else if (planted && in_leap && state[k + L_LEAP] > 3.5) {
            lt = max(max(legs_done(lp), fore_down(lp) + sink_time(lp, hip_t + lp.h_stand)) - lp.tau, 0.0)
                + select_f(hind, duty / max(cfreq, 0.1), 0.02);
        } else if (planted && gom > 1e-3) {
            if (state[k + L_ARMED] > 0.5) { lt = max(duty - stance_phase(ph, duty), 0.0) / max(cfreq, 0.1); }
            else { lt = (1.0 + duty - ph) / max(cfreq, 0.1); }
            lt += 0.25 * (1.0 - gom) / gom;
        }
        left_t[l] = lt;

        var sh: f32 = 0.0;
        if (!planted) { let su = sin(PI * u); sh = su * su; }
        sw[l] = sh;
        toes[l] = toe;
        feet[l] = select_v3(planted, toe, ld3(state, k + L_TO));
        if (hind) {
            swing_sum_hind += sh;
            hip_drop += LEG_SIDE[l] * sh;
        }
        sway -= LEG_SIDE[l] * sh;
    }

    // --- 6. Body height & pitch plan (belly held clear in gaits, settled on ground in `lie`) ---
    let hip_g = height(env, pos.x, pos.z);
    let wpos = pos + fwd * WITHERS_Z;
    let fore_g = height(env, wpos.x, wpos.z);
    let plane_c = fit_plane4(feet[0], feet[1], feet[2], feet[3], vec2<f32>(pos.x, pos.z));
    let hind_ground = max(0.5 * (feet[0].y + feet[3].y), hip_g - 0.02);
    let fore_ground = max(0.5 * (feet[1].y + feet[2].y), fore_g - 0.02);

    var crouch: f32 = 0.0;
    if (st_t >= 0.0) {
        crouch = -0.016 * bump(clamp(st_t / 0.28, 0.0, 1.0), 0.40, 0.60)
            + 0.014 * smooth01((st_t - 0.20) / 0.18) * (1.0 - smooth01((st_t - 1.4) / 0.8));
    }
    let breath_y = 0.0018 * sin(TAU * 0.38 * clock + seed);
    let caps = ceiling_caps(state, s, feet, left_t, bpos, qyaw, REACH_HIND, REACH_FORE);
    let cap_h = caps.x;
    let cap_f = caps.y;

    // Stride-aware sprawling carriage: crouch slightly with stride length, elevated in sprint gallop.
    let half = 0.5 * speed * duty / max(freq, 0.2);
    let run_h = HEAD[B_PELVIS].y - 0.70 * (REACH_HIND - sqrt(max(REACH_HIND * REACH_HIND - half * half, 0.02))) + SPRINT_LIFT * gw.z * gom;
    let run_f = HEAD[B_SCAPULAL].y - 0.70 * (REACH_FORE - sqrt(max(REACH_FORE * REACH_FORE - half * half, 0.02))) + 1.25 * SPRINT_LIFT * gw.z * gom;
    let gait_lift_h = -0.004 * swing_sum_hind * gw.x;
    let gait_lift_f = 0.012 * max(alert, disp) * (1.0 - graze);

    let hy_walk = mix(hind_ground + run_h, smin(hind_ground + HEAD[B_PELVIS].y + gait_lift_h, cap_h, CAP_SOFT), gw.x);
    let fy_walk = mix(fore_ground + run_f + gait_lift_f, smin(fore_ground + HEAD[B_SCAPULAL].y + gait_lift_f, cap_f, CAP_SOFT), gw.x);
    let hy_t = mix(hy_walk + crouch + breath_y, hip_g + LIE_HIP, lie);
    let fy_t = mix(fy_walk + crouch - 0.028 * graze, fore_g + LIE_SHOULDER, smooth01(lie * 1.15));

    let wh: f32 = 16.0;
    let hs = crit_step(vec2<f32>(state[s + IG_HY], state[s + IG_HV]), hy_t, wh, dt);
    let fs = crit_step(vec2<f32>(state[s + IG_FY], state[s + IG_FV]), fy_t, wh, dt);
    var hy = hs.x; var hv = hs.y;
    var fy = fs.x; var fv = fs.y;

    let ch_t = min(cap_h, hind_ground + HEAD[B_PELVIS].y + CAP_FADE);
    let cf_t = min(cap_f, fore_ground + HEAD[B_SCAPULAL].y + CAP_FADE);
    var chs = crit_step(vec2<f32>(state[s + IG_CAP_H], state[s + IG_CAP_HV]), ch_t, wh, dt);
    var cfs = crit_step(vec2<f32>(state[s + IG_CAP_F], state[s + IG_CAP_FV]), cf_t, wh, dt);
    if (init) { chs = vec2<f32>(ch_t, 0.0); cfs = vec2<f32>(cf_t, 0.0); }
    state[s + IG_CAP_H] = chs.x; state[s + IG_CAP_HV] = chs.y;
    state[s + IG_CAP_F] = cfs.x; state[s + IG_CAP_FV] = cfs.y;
    let ch = chs.x;
    let cf = cfs.x;

    let hy_sp = hy; let hv_sp = hv;
    let fy_sp = fy; let fv_sp = fv;
    var leap_w: f32 = 0.0;
    if (lp.on) {
        let hl = leap_hip(lp, hip_t);
        let pl = leap_pitch(lp);
        let tb = 0.30 * leg_time();
        let w = smooth01((lp.tau - lp.tcr) / tb) * (1.0 - smooth01((lp.tau - (leap_end(lp) - tb)) / tb));
        leap_w = w;
        let cp = max(cos(pl.x), 0.35);
        let fl = hl.x - HEAD[B_PELVIS].y + HEAD[B_SCAPULAL].y + WITHERS_Z * tan(pl.x);
        hy = mix(hy, hl.x, w);
        hv = mix(hv, hl.y, w);
        fy = mix(fy, fl, w);
        fv = mix(fv, hl.y + WITHERS_Z * pl.y / (cp * cp), w);
    }

    let pitch = atan2((fy - HEAD[B_SCAPULAL].y) - (hy - HEAD[B_PELVIS].y), WITHERS_Z);
    let grad_x = dot(vec2<f32>(plane_c.y, plane_c.z), vec2<f32>(left.x, left.z));
    let roll = damp(state[s + IG_ROLL], clamp(0.35 * atan(grad_x), -0.14, 0.14), 6.5, dt);
    state[s + IG_ROLL] = roll;

    let mv = select_f(moving, 1.0, 0.0) * smooth01(speed / 0.35);
    let sway_v = left * (0.005 * sway * gw.x * (1.0 - lie));
    var hold4: array<vec3<f32>, 4>;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + IG_LEG + l * LEG_REC;
        hold4[l] = vec3<f32>(state[k + L_PLANT], state[k + L_SINCE], left_t[l]);
    }
    let lean_want = select_f(moving || any_swing, (1.0 - smooth01(speed / 0.25)) * (1.0 - smooth01(vd / 0.38)), 0.0);
    var ls = crit_step(vec2<f32>(state[s + IG_LEAN_S], state[s + IG_LEAN_S + 1]), lean_want, 12.0, dt);
    if (init) { ls = vec2<f32>(0.0); }
    state[s + IG_LEAN_S] = ls.x; state[s + IG_LEAN_S + 1] = ls.y;
    let still = clamp01(ls.x) * (1.0 - lie);
    let plan = vec3<f32>(pos.x, hy, pos.z) + sway_v
        + lean_over(toes, hold4, pos + q_rot(qyaw, ld3(state, s + IG_COFF)), LEAN_MAX) * still;
    let roll_g = mv * (gw.x + 0.65 * gw.y) * 0.018 * sin(TAU * (phase - 0.12)) * (1.0 - lie);

    // --- 7. Physical CoM dynamics (`creature::body`) -------------------------------------------
    let coff_p = q_rot(qyaw, 2.0 * ld3(state, s + IG_COFF1) - ld3(state, s + IG_COFF2));
    var sup: Support;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + IG_LEG + l * LEG_REC;
        let hind = LEG_HIND[l] == 1;
        let toe0 = TAIL[LEG_TOE[l]] - HEAD[B_PELVIS];
        let vr = leg_virt_rest(l);
        let piv_y = select_f(hind, hy - HEAD[B_PELVIS].y, fy - HEAD[B_SCAPULAL].y) + state[s + IG_LAG + 1] + vr.y;
        var f: Foot;
        f.at = toes[l];
        // Effective sprawling strut line-of-action lies directly over home lateral stance `toe0.x`
        // (pectoral/pelvic adductor moments balance the lateral sprawl at rest!).
        f.pivot = vec3<f32>(bpos.x, piv_y, bpos.z) + q_rot(qyaw, vec3<f32>(toe0.x, 0.0, vr.z - HEAD[B_PELVIS].z));
        f.reach = 1.08 * select_f(hind, 0.230, 0.187);
        f.since = state[k + L_SINCE];
        f.left = left_t[l];
        f.down = state[k + L_PLANT];
        sup.f[l] = f;
    }
    sup.effort = leap_effort(lp);
    sup.lead = leap_follow(lp);
    sup.spring = TROT_SPRING * (gw.y + 0.45 * gw.z);

    let pitch_sp = atan2((fy_sp - HEAD[B_SCAPULAL].y) - (hy_sp - HEAD[B_PELVIS].y), WITHERS_Z);
    let turned = q_rot(q_x(-(pitch - pitch_sp)), ld3(state, s + IG_COFF));
    var cr = crit_step(vec2<f32>(state[s + IG_COFFR], state[s + IG_COFFR + 1]),
                       state[s + IG_COFF1 + 1] - turned.y, COFF_W, dt);
    if (init) { cr = vec2<f32>(0.0); }
    state[s + IG_COFFR] = cr.x; state[s + IG_COFFR + 1] = cr.y;
    let coff_l = q_rot(qyaw, turned + vec3<f32>(0.0, cr.x * leap_w, 0.0));
    let bd = body_step(state, s + IG_BODY, plan + coff_l, 1.2 + 2.6 * gw.x, sup, init, dt);

    probe(state, s + PROBE, 3, bd.com.y);
    probe(state, s + PROBE, 4, plan.y + coff_l.y);
    probe(state, s + PROBE, 5, bd.acc.y / 9.81);
    probe(state, s + PROBE, 6, bd.load);

    var shift = (bd.com - coff_p - plan) * LAYERS * (1.0 - smooth01(lie * 2.8));
    let ceil_y = smin(ch - hy, cf - fy, CAP_SOFT);
    let above0 = max(shift.y - GALLOP_FREE * gw.z, 0.0);
    let above = soft_limit(above0, 0.012, 0.022);
    let r0 = -smin(-ceil_y, 0.0, max(above * above / 0.02, 1e-4));
    let rp = max(r0, 0.0);
    let rise = min(r0, 0.0) + rp * rp / (rp + RISE_IN) + GALLOP_FREE * gw.z;
    if (!lp.on) {
        let over = shift.y - rise;
        let free_y = shift.y;
        shift.y = smin(shift.y, rise, RISE_EASE);
        if (over > 0.02) {
            var v = bd.vel;
            v.y = min(v.y, hv);
            body_set(state, s + IG_BODY, plan + coff_p + vec3<f32>(shift.x, min(free_y, rise + 0.02), shift.z), v);
        }
    }

    let pl4 = vec4<f32>(sup.f[0].down, sup.f[1].down, sup.f[2].down, sup.f[3].down);
    var guard: f32 = 1.0;
    let over1 = reach_over(toes, pl4, plan, qyaw, hy, fy, shift, REACH_HIND, REACH_FORE);
    let over0 = max(reach_over(toes, pl4, plan, qyaw, hy, fy, vec3<f32>(0.0), REACH_HIND, REACH_FORE), 0.0);
    if (over1 > 0.0 && over1 > over0) {
        var hi: f32 = 1.0;
        guard = 0.0;
        for (var it: i32 = 0; it < 6; it += 1) {
            let m = 0.5 * (guard + hi);
            if (reach_over(toes, pl4, plan, qyaw, hy, fy, shift * m, REACH_HIND, REACH_FORE) > over0) {
                hi = m;
            } else {
                guard = m;
            }
        }
    }
    if (!init) { guard = clamp(guard, state[s + IG_GUARD] - GUARD_RATE * dt, state[s + IG_GUARD] + GUARD_RATE * dt); }
    state[s + IG_GUARD] = guard;
    shift = shift * guard;

    let root = plan + shift;
    st3(state, s + IG_LAG, shift);
    st3(state, s + IG_LAGV, bd.vel - bd.tvel);

    // --- 8. Spine bend (`creature::spine`) + axial S-wave + sprawling 3D leg IK ----------------
    var rel: array<vec3<f32>, NFEET>;
    for (var l: i32 = 0; l < 4; l += 1) {
        rel[l] = q_rot(q_conj(qyaw), toes[l] - sup.f[l].pivot) + (leg_virt_rest(l) - HEAD[LEG_TOP[l]]);
    }
    let curv = omega / max(speed, 0.45) * smooth01(speed / 0.45);
    let bend_want = spine_want(rel, curv, speed * omega, (1.0 - smooth01(lie * 2.8)) * mix(0.35, 1.0, gom) * LAYERS);
    let bend = spine_step(state, s + IG_SPINE, bend_want, bd.acc.y * LAYERS, init, dt);

    let qbody = q_mul(q_mul(qyaw, q_x(-pitch)), q_z(roll + roll_g));
    var T = pose_axial(state, env, intent, s, ii, init, dt, clock, seed, yaw, speed, omega, phase, gw, gom, mv,
                       lie, graze, alert, disp, st_t, root, qbody, hip_drop, bend, pitch, fy + shift.y,
                       leap_w, vary, SWAVE_AMP, TAIL_AMP, HEAD_HOLD, NECK_LEVER, BOB_AMP, DEWLAP_FLARE);
    T = solve_sprawling_legs(state, env, s, T, toes, left_t, sw, yaw, phase, offs, duty, roll_w, gom,
                             gw, in_leap, lp, lie, SCAP_SWING, SWING_CURL, FAULT_OVERBEND);
    finish_iguana(state, env, pose_out, tele, c, s, init, dt, T, qyaw, root, pos, yaw, speed, omega,
                  phase, gw, gait, moving, hy, fy, hy_sp, hv_sp, fy_sp, fv_sp, hip_g,
                  pitch, roll + roll_g, freq, act, lp, toes, lie, mv, graze, alert, disp,
                  HEAD_SPACE, LAYERS);
}

@kernel @grid(1)
fn k_rig(g: grid<1>, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
         pose_out: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    pose(g.x(), intent, env, state, pose_out, tele, dt);
}
