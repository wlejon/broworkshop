// creature::face — the finch's face, drawn per pixel over the head's skin
// (lab/face.bk has how), in the rest pose's coordinates (body.js: x to its
// left, y up, z forward, metres). `foot` is a pixel's size there; every
// edge is softened over it.
//
// What it shows, from the side: a round glossy eye in a thin pale
// eye-ring, a chestnut iris about a black pupil, and a dark stripe from the
// bill's base back through the eye. A bird's eye does not turn in its
// head; its face is its pupil and its brow (the rig's `mood` bone, read
// here as look.x and look.y): at ease the pupil is wide, the eye a dark
// bead; curious, wider still, the brow raised clear and the ring broad;
// alarmed or flying the pupil pins small, the iris flashing round it, and
// the brow's feathers come down over the eye's top, lowest in front.
module creature::face;
import mesh;

fn lin(c: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(pow(c.x, 2.2), pow(c.y, 2.2), pow(c.z, 2.2));
}

// 1 inside (d < 0), 0 outside, over w either side of the edge.
fn inside(d: f32, w: f32) -> f32 {
    return clamp(0.5 - d / (2.0 * w), 0.0, 1.0);
}

// The eye (body.js's eye mass) seen from the side: (y, z) of its middle,
// the side it is on (|x|), the opening's radius.
const EYE: vec2<f32> = vec2<f32>(0.0785, 0.0455);
const EYE_X: f32 = 0.0095;
const EYE_R: f32 = 0.0019;
// Where the stripe meets the bill's base, and how far back it runs.
const BILL: vec2<f32> = vec2<f32>(0.0765, 0.0485);
const STRIPE_BACK: f32 = 0.036;

pub fn face(p: vec3<f32>, foot: f32, look: vec4<f32>, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    let w = max(foot, 0.00005);
    let ax = abs(p.x);
    var c = s.base_color;
    var rough = s.roughness;
    let q = vec2<f32>(p.y, p.z);

    if (ax > EYE_X - 0.004 && p.z > STRIPE_BACK - 0.002 && p.z < 0.05 && abs(p.y - EYE.x) < 0.008) {
        // The stripe: from the bill's base through the eye, fading behind it.
        let t = clamp((p.z - BILL.y) / (STRIPE_BACK - BILL.y), 0.0, 1.0);
        let sy = mix(BILL.x, EYE.x - 0.0004, t);
        let fade = 1.0 - smoothstep(0.6, 1.0, t);
        let stripe = inside(abs(p.y - sy) - 0.0011, w) * fade;
        c = mix(c, lin(vec3<f32>(0.12, 0.09, 0.07)), 0.85 * stripe);
        // The eye in its pale ring.
        let r = length(q - EYE);
        let d = r - EYE_R;
        // (Its mood, from the rig's `mood` bone: look.x the pupil, wide at
        // ease and curious, pinned small in alarm so the chestnut iris
        // flashes round it; look.y the brow.)
        let pin = clamp(look.x / 0.6, -1.0, 1.0);
        let brow = clamp(look.y / 0.6, -1.0, 1.0);
        c = mix(c, lin(vec3<f32>(0.85, 0.82, 0.74)), inside(d - 0.0005 - 0.0003 * max(brow, 0.0), w));
        let open = inside(d, w);
        var eye = mix(lin(vec3<f32>(0.50, 0.24, 0.08)), lin(vec3<f32>(0.16, 0.08, 0.04)), smoothstep(0.75, 1.0, r / EYE_R));
        eye = mix(eye, lin(vec3<f32>(0.02, 0.018, 0.015)), inside(r - EYE_R * (0.70 + 0.24 * pin), w));
        // The sky's light on the bead, high and forward.
        eye = mix(eye, vec3<f32>(1.0), 0.9 * inside(length(q - EYE - vec2<f32>(0.35, 0.3) * EYE_R) - 0.22 * EYE_R, w));
        // The third eyelid (look.w): pale and half clear, across from the
        // front corner.
        let front = (p.z - EYE.y) / EYE_R;
        let mem = inside((1.0 - 2.0 * look.w - front) * EYE_R, w) * step(0.001, look.w);
        eye = mix(eye, lin(vec3<f32>(0.62, 0.64, 0.66)), 0.8 * mem);
        c = mix(c, eye, open);
        rough = mix(rough, mix(0.04, 0.3, mem), open);
        // The lower lid (look.z): the face's feathers, up over the eye.
        let lid = open * inside(((p.y - EYE.x) / EYE_R - (2.0 * look.z - 1.0)) * EYE_R, w) * step(0.001, look.z);
        c = mix(c, s.base_color * 0.9, lid);
        rough = mix(rough, s.roughness, lid);
        // The brow: the feathers over the eye. Sleeked down in alarm and in
        // flight they come low over it, lowest in front, and flatten its
        // top to a glare; raised, curious, they stand clear and the eye is
        // round in a wider ring.
        let stern = max(-brow, 0.0);
        let by = EYE.x + EYE_R * (1.02 + 0.5 * brow) - 0.55 * stern * (p.z - EYE.y);
        let over = open * inside(by - p.y, w) * step(0.001, stern);
        c = mix(c, s.base_color * 0.8, over);
        rough = mix(rough, s.roughness, over);
        let line = inside(abs(p.y - by) - 0.00035, w) * inside(abs(p.z - EYE.y) - 1.3 * EYE_R, w);
        c = mix(c, lin(vec3<f32>(0.10, 0.08, 0.06)), (0.25 + 0.6 * stern) * line);
    }
    out.base_color = c;
    out.roughness = rough;
    return out;
}
