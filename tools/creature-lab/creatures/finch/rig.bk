// The finch's rig: one invocation per finch, its state in `state`, its
// bones out to `pose` (the creature contract, lab/contract.js).
//
// How it goes. It hops: both feet on one clock, down together for a short
// stance and up together for a flight. The body's height through a hop is
// a bouncing body's (hop_bounce): it falls freely in the flight and is
// turned round by a spring's push through the stance, so it sinks into each
// landing and springs out of it. Each leg is a bird's Z (femur, drumstick,
// the short bare tarsus, the toes) solved hip to toe tip as a pantograph
// (creature::limbs solve_hind). The toes lie flat in stance and rise onto
// their tips as the feet leave; in the flight the feet are tucked up under
// the belly with the toes curled, and they reach out again to land flat
// ahead, where the body will be halfway through the next stance. The tail
// cocks up as it lands. Standing still, a strayed foot shuffles back.
//
// The head glances: it turns in quick looks to one side and the other, held
// in between, and follows the gaze when there is one. It keeps its own
// turn in the world while the body hops (creature::secondary holds it).
//
// Foraging it leans forward and pecks at the ground in quick jabs; resting
// (the lab's `lie`) it settles onto its belly, the legs folded under, the
// head drawn in; startled it crouches and flicks its folded wings, then stands
// alert, the head up.
import creature::common::*;
import creature::contract::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::body::*;
import creature::secondary::*;
import creature::limbs::*;
import creature::probe::*;
from creature::ground import height, obstacle_ahead;

const D_SPEED: i32 = 5;
const D_OMEGA: i32 = 6;
const D_PHASE: i32 = 7;
const D_MOVING: i32 = 8;
const D_CLOCK: i32 = 9;
const D_GAIT: i32 = 10;      // the gait chosen (contract GAIT_*)
const D_BODY_Y: i32 = 11;
const D_LOOK: i32 = 12;      // the head's turn and its speed (a glance's spring)
const D_LOOK_V: i32 = 13;
const D_GRAZE: i32 = 14;
const D_LIE: i32 = 15;
const D_ALERT: i32 = 16;
const D_HELD: i32 = 17;      // the share of the body's shift held back for reach, letting go
const D_LAG: i32 = 18;       // the body's shift from the plan, last step (3)
const D_STARTLE_T: i32 = 21; // s since a startle began (-1: none)
const D_PREV_ACT: i32 = 22;
const D_LEAN: i32 = 23;      // the body's lean forward and its speed
const D_LEAN_V: i32 = 24;
const D_BAL: i32 = 25;       // standing: the plan's shift that keeps the centre over the feet (x, z)
const D_BOFF: i32 = 27;      // the bounce left over from a start or stop, its speed, and the bounce last step
const D_BOFF_V: i32 = 28;
const D_BPREV: i32 = 29;
const D_PACE: i32 = 30;      // the pace the hop under way left the ground at
const D_COCK: i32 = 31;      // the tail's landing-bob spring and its speed
const D_COCK_V: i32 = 32;
const D_WOPEN_V: i32 = 33;   // rate of opening/closing the wings
const D_LEG: i32 = 34;
const LEG_REC: i32 = 16;
const L_PLANT: i32 = 0;
const L_TOE: i32 = 1;        // the toe tip: planted, or where the swing has it (3)
const L_FROM: i32 = 4;       // where it lifted from (3)
const L_TO: i32 = 7;         // where it will land (3)
const L_U: i32 = 10;         // the swing's progress, 0..1
const L_DUR: i32 = 11;       // the swing's length (s)
const L_ARMED: i32 = 12;     // set in stance, so a leg lifts once a cycle
const L_SINCE: i32 = 13;     // s since it landed
const L_A0: i32 = 14;        // the toes' angle as it left the ground
const L_KIND: i32 = 15;      // 0 a hop, 1 a settling step
const D_COFF: i32 = D_LEG + 2 * LEG_REC;  // the pose's centre of mass from the root, in the yaw frame: slow mean (3),
const D_COFF1: i32 = D_COFF + 3;          //   and last step's (3)
const D_BODY: i32 = D_COFF + 6;           // creature::body (BODY_STATE)
const D_SEC: i32 = D_BODY + BODY_STATE;   // creature::secondary (SEC_STATE)
// Flight: in the air (0/1), s since it took off, m over its standing height
// and m/s, the bound's clock (bursts of beats), the cruise's share (0: every
// beat one of a climb's), the wings' share open, s since a log was last in
// its way and that log's height.
const D_FLY: i32 = D_SEC + SEC_STATE;
pub const PROBE: i32 = D_FLY + 9;         // creature::probe's slice
pub const STATE: i32 = PROBE + PROBE_N;

@knob const LAYERS: f32 = 1.0;       // the motion layers' share (0: the rig's plan as it is)
@knob const SOFT_REACH: f32 = 0.95;  // share of a leg's reach where its IK eases the reach in
// (Quick and low, as a bird this small hops: at 3 a second it was 0.18 s in
// the air and rose 5 cm, a bouncing ball's hop.)
@knob const FITFUL: f32 = 1.0;      // how much it hops in fits and stops (0: steadily)
@knob const HOP_F: f32 = 5.5;      // hops a second barely moving
@knob const HOP_FV: f32 = 1.5;       //   and more per m/s
// (Little: in a tenth of a second's flight a deep tuck is a fold and unfold of 60 degrees.)
@knob const TUCK: f32 = 0.12;      // share of the hip's height the feet are drawn up in a flight
@knob const ROLL: f32 = 0.8;         // rad the toes stand up as the feet leave them
@knob const CURL: f32 = 0.3;         // the toes' limb angle curled under in a flight (0: hanging)
@knob const COCK: f32 = 0.45;        // rad the tail cocks up as it lands
@knob const WING_FLICK: f32 = 0.25;  // of a wing swung right out: how far the folded wings flick, startled
// Flight. Asked to go faster than it hops it flies, a finch's bounding
// flight: a burst of beats, then the wings shut against the body and it
// arcs on like a thrown thing, rising out of each burst and sinking into
// the next.
@knob const FLY_AT: f32 = 0.75;      // m/s asked of it past which it takes off
@knob const FLY_H: f32 = 0.24;       // m over the ground it flies at
@knob const BOUND_T: f32 = 0.38;     // s a bound lasts: the burst and the wings shut
@knob const BURST: f32 = 0.62;       // share of it beating
@knob const BEATS: f32 = 3.0;        // beats in a burst
@knob const UNDULATE: f32 = 0.6;     // share of a free fall's arc the bounds rise and sink by
@knob const STROKE_MID: f32 = 0.12;  // rad the wings' stroke is centred above level
@knob const STROKE: f32 = 0.85;      // rad it swings either side of that
@knob const TIP_LAG: f32 = 0.35;     // rad the hand trails the arm through a stroke
@knob const FEATHER: f32 = 0.3;      // rad the wing's leading edge turns down in the downstroke
@knob const FLEX: f32 = 0.45;        // share the wing is folded on the upstroke
@knob const FLIT_OVER: f32 = 0.045;  // m over a log in its way it flits
@knob const WING_SPREAD: f32 = 0.0; // share the wings are held open, standing (to look at them: finch:spread)
@knob const TAIL_FLICK: f32 = 0.35;  // rad the tail flicks up with them
@knob const GLANCE: f32 = 0.55;      // rad a glance turns the head at most
@knob const BALANCE: f32 = 1.0;      // share of the centre's offset over the feet it corrects, standing

const LEG_B0: array<i32, 2> = [B_FEMURL, B_FEMURR];
const WING_B0: array<i32, 2> = [B_HUMERUSL, B_HUMERUSR];
const SIDE: array<f32, 2> = [1.0, -1.0];
// A wing's bones, in the skeleton's order: the upper arm, the forearm, the
// hand, four primaries, four secondaries, a tertial.
const WING_NB: i32 = 12;
// Folded (the left wing's, in the body's frame): where each bone points,
// and where its upper face does. The upper arm lies back and down along
// the flank, the forearm doubled forward over it to the wrist at the
// breast's side, the hand back from there to the rump; every feather back
// along the flank, the inner ones lower, their upper faces out.
const FOLD_D: array<vec3<f32>, 12> = [
    vec3<f32>(0.18, -0.36, -0.915), vec3<f32>(-0.16, 0.18, 0.97), vec3<f32>(-0.08, -0.11, -0.99),
    vec3<f32>(-0.085, -0.13, -0.988), vec3<f32>(-0.085, -0.15, -0.985), vec3<f32>(-0.085, -0.17, -0.982), vec3<f32>(-0.085, -0.19, -0.978),
    vec3<f32>(-0.075, -0.20, -0.977), vec3<f32>(-0.07, -0.215, -0.974), vec3<f32>(-0.065, -0.23, -0.971), vec3<f32>(-0.06, -0.245, -0.968),
    vec3<f32>(-0.065, -0.17, -0.983)];
const FOLD_N: vec3<f32> = vec3<f32>(1.0, 0.32, 0.0);
const BODY_REACH: f32 = 0.985;
@knob const TRAIL_T: f32 = 0.045;    // s after a hop's take-off the feet trail where they stood
@knob const REACH_OUT: f32 = 0.85;  // share of the leg and toes' length a foot reaching out to land may be from its hip
const CAP_EASE: f32 = 0.06;
const SOFT_M: f32 = 0.004;
const LEG_BAND: f32 = 0.12;
const TOE_LEN: f32 = 0.015;      // m the ground's pitch is read over under a foot

// 0 to 1 over x in [0, 1] with no speed or acceleration at either end.
fn ease5(x: f32) -> f32 {
    let t = clamp(x, 0.0, 1.0);
    return t * t * t * (t * (6.0 * t - 15.0) + 10.0);
}

fn select_i(c: bool, a: i32, b: i32) -> i32 {
    if (c) { return a; }
    return b;
}
fn select_q(c: bool, a: vec4<f32>, b: vec4<f32>) -> vec4<f32> {
    if (c) { return a; }
    return b;
}

fn select_v2(c: bool, a: vec2<f32>, b: vec2<f32>) -> vec2<f32> {
    if (c) { return a; }
    return b;
}

// A leg's home: its toe tip under its hip as the rest pose stands it, from
// the root.
// The turn that takes a bone from pointing along d0 with its upper face to
// n0, to pointing along d1 with it to n1 (as near as is square to d1).
fn q_aim(d0: vec3<f32>, n0: vec3<f32>, d1: vec3<f32>, n1: vec3<f32>) -> vec4<f32> {
    let a = normalize(d0);
    let b = normalize(d1);
    let qa = q_from_to(a, b);
    let n = q_rot(qa, n0);
    let np = normalize(n - b * dot(n, b));
    let nq = normalize(n1 - b * dot(n1, b));
    return q_mul(q_axis(b, atan2(dot(cross(np, nq), b), dot(np, nq))), qa);
}

// Wing bone b (the i-th of its wing, on side sd) folded, from where the
// skeleton stands it spread, in the body's frame.
fn wing_fold(b: i32, i: i32, sd: f32) -> vec4<f32> {
    let m = vec3<f32>(sd, 1.0, 1.0);
    return q_aim(TAIL[b] - HEAD[b], vec3<f32>(0.0, 1.0, 0.0), FOLD_D[i] * m, FOLD_N * m);
}

fn home_of(l: i32) -> vec3<f32> {
    let t = TAIL[LEG_B0[l] + 3] - HEAD[B_BODY];
    return vec3<f32>(t.x, 0.0, t.z);
}

// The toes at limb angle a (in the yaw frame): from the ball to the tip.
fn toe_vec(l: i32, a: f32) -> vec3<f32> {
    let lh = rest_len(LEG_B0[l] + 3);
    return vec3<f32>(0.0, -lh * cos(a), lh * sin(a));
}

// The pantograph's reach from the hip to the ball.
fn leg_reach(l: i32) -> f32 {
    let b0 = LEG_B0[l];
    let c = rest_angle(b0 + 2) - rest_angle(b0);
    return length(rest_len(b0) * limb_dir(0.0) + rest_len(b0 + 2) * limb_dir(c)) + rest_len(b0 + 1);
}

// How far past its reach the furthest planted ball is from its hip.
fn reach_over(st: rw_store<f32, 1>, s: i32, balls: array<vec3<f32>, 2>, root: vec3<f32>, qbody: vec4<f32>) -> f32 {
    var hi: f32 = -1e3;
    var o: array<f32, 2>;
    for (var l: i32 = 0; l < 2; l += 1) {
        o[l] = -1e3;
        if (st[s + D_LEG + l * LEG_REC + L_PLANT] < 0.5) { continue; }
        let hip = root + q_rot(qbody, HEAD[LEG_B0[l]] - HEAD[B_BODY]);
        o[l] = length(hip - balls[l]) - BODY_REACH * leg_reach(l);
        hi = max(hi, o[l]);
    }
    if (hi < -999.0) { return hi; }
    var sum: f32 = 0.0;
    for (var l: i32 = 0; l < 2; l += 1) { sum += exp((o[l] - hi) / SOFT_M); }
    return hi + SOFT_M * log(sum);
}

// The ground's pitch under a foot along the heading (toe down positive).
fn ground_pitch(env: read_store<f32, 1>, toe: vec3<f32>, fwd: vec3<f32>) -> f32 {
    let b = toe - fwd * TOE_LEN;
    return atan2(height(env, b.x, b.z) - height(env, toe.x, toe.z), TOE_LEN);
}

// A hop's rise and fall of the body from the height it lands and leaves at,
// one stance a cycle at its start: free fall through the flight (up at v0
// off the ground, down at v0 onto it), and through the stance the legs'
// push as a spring gives it: nothing at the touchdown, most at the middle,
// nothing again as the feet leave (a half sine over the stance on top of
// gravity), so the body sinks into the landing and springs out with no
// corner in its speed nor a jump in its acceleration at either end.
fn hop_bounce(phase: f32, duty: f32, freq: f32) -> f32 {
    let ts = duty / freq;
    let tf = (1.0 - duty) / freq;
    let v0 = 0.5 * 9.81 * tf;
    let t = fract01(phase) / freq;
    // (A spring's push sinks the body further at mid-stance than an even
    // one would, by `deep`: the whole hop rides that much higher, so the
    // legs fold no further under it than they are made to.)
    let k = v0 + 4.905 * ts;
    let deep = (0.5 - 1.0 / PI) * k * ts - 0.5 * v0 * ts - 1.22625 * ts * ts + 0.25 * v0 * ts;
    if (t < ts) { return -deep - v0 * t - 4.905 * t * t + k * (t - ts / PI * sin(PI * t / ts)); }
    let u = t - ts;
    return -deep + v0 * u - 4.905 * u * u;
}

fn place(st: rw_store<f32, 1>, env: read_store<f32, 1>, s: i32) {
    let p = ld3(st, s + S_POS);
    let q = q_y(st[s + S_YAW]);
    for (var l: i32 = 0; l < 2; l += 1) {
        let h = q_rot(q, home_of(l)) + vec3<f32>(p.x, 0.0, p.z);
        let t = vec3<f32>(h.x, height(env, h.x, h.z), h.z);
        let k = s + D_LEG + l * LEG_REC;
        st[k + L_PLANT] = 1.0;
        st3(st, k + L_TOE, t);
        st3(st, k + L_TO, t);
        st[k + L_U] = 0.0;
        st[k + L_ARMED] = 1.0;
        st[k + L_SINCE] = 1.0;
    }
    st[s + D_BODY_Y] = height(env, p.x, p.z) + HEAD[B_BODY].y;
    var cr = vec3<f32>(0.0);
    for (var b: i32 = 0; b < NB; b += 1) { cr += MASS[b] * 0.5 * (HEAD[b] + TAIL[b]); }
    let coff = cr / TOTAL_MASS - HEAD[B_BODY];
    st3(st, s + D_COFF, coff);
    st3(st, s + D_COFF1, coff);
    st[s + D_STARTLE_T] = -1.0;
    st[s + D_FLY + 7] = 10.0;
    st[s + D_GAIT] = GAIT_STAND as f32;
    st[s + S_PLACED] = 1.0;
}

@kernel @grid(1)
fn k_rig(g: grid<1>, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
         pose: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    let c = g.x();
    let s = c * STATE;
    let ii = c * INTENT;
    let init = state[s + S_PLACED] < 0.5;
    if (init) { place(state, env, s); }

    // --- intent and actions ---------------------------------------------------------
    let act = intent[ii + I_ACTION] as i32;
    let seed = intent[ii + I_SEED];
    let clock = state[s + D_CLOCK] + dt;
    state[s + D_CLOCK] = clock;
    let graze = approach(state[s + D_GRAZE], select_f(act == ACT_GRAZE, 1.0, 0.0), 2.5, dt);
    let lie = approach(state[s + D_LIE], select_f(act == ACT_LIE, 1.0, 0.0), 0.8, dt);
    var st_t = state[s + D_STARTLE_T];
    if (act == ACT_STARTLE && (state[s + D_PREV_ACT] as i32) != ACT_STARTLE) { st_t = 0.0; }
    // (Startled and with somewhere to go it does not sit its flinch out:
    // the crouch is the spring it is off from, five times as soon.)
    let off_now = act != ACT_STARTLE && length(vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z])) > 0.3;
    if (st_t >= 0.0) { st_t += dt * select_f(off_now, 5.0, 1.0); }
    if (st_t > 2.0) { st_t = -1.0; }
    let alert_want = select_f(act == ACT_ALERT || act == ACT_STARTLE, 1.0, 0.0);
    var alert = state[s + D_ALERT];
    if (alert_want > alert) { alert = approach(alert, 1.0, 5.0, dt); } else { alert = approach(alert, 0.0, 1.0, dt); }
    // The flinch: down at once, the wings fluttering, then let go.
    var flinch: f32 = 0.0;
    if (st_t >= 0.0) { flinch = smooth01(st_t / 0.06) * (1.0 - smooth01((st_t - 0.4) / 0.4)); }
    state[s + D_GRAZE] = graze;
    state[s + D_LIE] = lie;
    state[s + D_ALERT] = alert;
    state[s + D_STARTLE_T] = st_t;
    state[s + D_PREV_ACT] = act as f32;
    var vdes = vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z]);
    if (act == ACT_BOUND) { vdes = vdes * max(1.0, 1.0 / max(length(vdes), 0.05)); }
    vdes *= (1.0 - 0.8 * graze) * (1.0 - smooth01(flinch * 2.0));
    if (lie > 0.001 || act == ACT_LIE) { vdes = vec2<f32>(0.0); }
    // On the ground it goes in fits, as a small bird does: a few hops, a
    // stop to look about, on again, each fit at its own pace and a little
    // off the line of the last, no two birds' fits in step (FITFUL 0: it
    // hops as a clock does).
    if (state[s + D_FLY] < 0.5 && length(vdes) < FLY_AT && act == ACT_MOVE && FITFUL > 0.0) {
        let ft = clock / 1.25 + 0.61 * seed;
        let fi = floor(ft);
        let stay = 0.45 + 0.45 * hash01(fi * 4.1 + seed * 2.3);
        if (ft - fi >= mix(1.0, stay, FITFUL)) { vdes = vec2<f32>(0.0); }
        else {
            let a = FITFUL * 0.4 * (2.0 * hash01(fi * 5.9 + seed * 1.1) - 1.0);
            // (Never so much quicker that it would take off.)
            let quick = min(mix(1.0, 0.8 + 0.7 * hash01(fi * 9.7 + seed), FITFUL), max(0.9 * FLY_AT / max(length(vdes), 0.01), 1.0));
            vdes = vec2<f32>(vdes.x * cos(a) + vdes.y * sin(a), vdes.y * cos(a) - vdes.x * sin(a)) * quick;
        }
    }

    // --- heading and speed -------------------------------------------------------------
    var yaw = state[s + S_YAW];
    var speed = state[s + D_SPEED];
    var want = yaw;
    let vd = length(vdes);
    if (intent[ii + I_HEADING_MODE] > 0.5) { want = intent[ii + I_HEADING]; }
    else if (vd > 0.02) { want = atan2(vdes.x, vdes.y) + 0.05 * smooth01(speed / 0.2) * noise1(clock / 1.1, seed, 2.0); }
    // (On the wing it jinks round far quicker than it can hop round.)
    let rate = select_f(state[s + D_FLY] > 0.5, 4.5, mix(3.5, 4.0 / (1.0 + 0.8 * speed), smooth01(speed / 0.2)));
    let w_t = clamp(6.0 * wrap_pi(want - yaw), -rate, rate);
    let omega = approach(state[s + D_OMEGA], w_t, 16.0, dt);
    yaw = wrap_pi(yaw + omega * dt);
    let err = wrap_pi(want - yaw);
    var aloft = state[s + D_FLY] > 0.5;
    // (On the ground it goes no faster than it hops; in the air it gathers
    // and sheds its speed quickly.)
    // (Over a log it flits at the pace of its fastest hopping.)
    let v_air = max(vd, select_f(state[s + D_FLY + 7] < 0.1 && vd > 0.1, 0.9, 0.0));
    let vt = select_f(aloft, v_air, min(vd, 0.9)) * clamp(cos(err), 0.2, 1.0);
    speed = approach(speed, vt, select_f(aloft, select_f(vt > speed, 14.0, 4.0), select_f(vt > speed, 1.5 + speed, 2.5)), dt);
    let qyaw = q_y(yaw);
    let fwd = q_rot(qyaw, vec3<f32>(0.0, 0.0, 1.0));
    var pos = ld3(state, s + S_POS);
    pos += fwd * (speed * dt);

    // --- flight ---------------------------------------------------------------------------
    // It takes off from its feet (both down: standing, or in a hop's
    // stance), springing up as the wings open, climbs beating all the way,
    // and cruises in bounds. Asked to slow it comes down as its speed
    // goes, beating without a pause, reaches its feet down and lands on
    // them, the fall's last going into its legs. A log in the way of its
    // hopping it flits over the same way, just clear of it.
    var fly_t = state[s + D_FLY + 1];
    var alt = state[s + D_FLY + 2];
    var alt_v = state[s + D_FLY + 3];
    var bc = state[s + D_FLY + 4];
    var cw = state[s + D_FLY + 5];
    var wopen = state[s + D_FLY + 6];
    var log_t = state[s + D_FLY + 7];
    var log_h = state[s + D_FLY + 8];
    let ob = obstacle_ahead(env, pos.x, pos.z, vec2<f32>(fwd.x, fwd.z));
    if (ob.y > 0.01 && ob.x < 0.07 + 0.2 * speed && speed > 0.1) { log_t = 0.0; log_h = ob.y; } else { log_t += dt; }
    let flit = log_t < 0.1;
    let fly_want = (vd > FLY_AT || flit) && lie < 0.01 && act != ACT_LIE && flinch < 0.05;
    let feet_down = state[s + D_LEG + L_PLANT] > 0.5 && state[s + D_LEG + LEG_REC + L_PLANT] > 0.5;
    if (!aloft && fly_want && feet_down && !init) {
        aloft = true;
        fly_t = 0.0;
        alt_v += 0.9;
        bc = 0.0;
    }
    var und: f32 = 0.0;       // the bounds' rise and sink, and its rate
    var und_v: f32 = 0.0;
    var phi: f32 = 0.5;       // the beat's phase: 0 the wings up, 0.5 down
    var shut_f: f32 = 0.0;    // the wings shut between bursts (0 during climb/flare/landing)
    var flare: f32 = 0.0;     // coming down to land
    let bound_t = BOUND_T * (0.85 + 0.3 * hash01(seed * 3.3 + 0.7));
    if (aloft) {
        fly_t += dt;
        // (Coming down it is brought to a little under the ground, so it
        // meets it still sinking: eased to the ground itself it never
        // quite arrived.)
        // (Going far and fast each flies at its own height, up to four times
        // FLY_H, and bounds to its own time: no two of a flock beat in step.)
        let fly_h = FLY_H * (1.0 + 3.0 * hash01(seed * 8.7 + 0.3) * smooth01((vd - 2.5) / 2.5));
        var h_want = (fly_h + 0.03) * smooth01((speed - 0.6) / 1.0) - 0.03;
        if (fly_want) { h_want = select_f(vd > FLY_AT, fly_h, log_h + FLIT_OVER); }
        // (A flit is quick, up and over and down; a flight's climb and
        // its coming down from speed take their time.)
        let a = crit_step(vec2<f32>(alt, alt_v), h_want, select_f(fly_want, select_f(vd > FLY_AT, 7.0, 13.0), mix(10.0, 6.0, smooth01(speed / 1.5))), dt);
        alt = a.x;
        alt_v = a.y;
        if (!fly_want) { flare = smooth01(1.0 - alt / 0.12); }
        cw = approach(cw, select_f(fly_want && vd > FLY_AT && fly_t > 0.45, 1.0, 0.0), 3.0, dt);
        bc += dt * (1.0 - 0.88 * flare) / bound_t;
        // (Climbing and coming down there is no pause: the clock goes
        // from a burst's end to the next one's start, the wings down at both.)
        if (cw < 0.5 && fract01(bc) >= BURST) { bc = floor(bc) + 1.0; }
        let fb = fract01(bc);
        let t_b = BURST * bound_t;
        let v0 = 0.5 * 9.81 * (1.0 - BURST) * bound_t;
        if (fb < BURST) {
            let ub = fb / BURST;
            let tau = ub * t_b;
            phi = 0.5 + BEATS * ub;
            shut_f = cw * max(1.0 - smooth01(ub / 0.15), smooth01((ub - 0.87) / 0.13));
            und = -v0 * tau + v0 * tau * tau / t_b;
            und_v = -v0 + 2.0 * v0 * tau / t_b;
        } else {
            shut_f = cw;
            let tau = (fb - BURST) * bound_t;
            und = v0 * tau - 4.905 * tau * tau;
            und_v = v0 - 9.81 * tau;
        }
        und *= UNDULATE * cw;
        und_v *= UNDULATE * cw;
    } else if (wopen > 0.002) {
        // Coast the flared wing posture smoothly to rest as the wings tuck
        // onto the flanks after touchdown, without flapping on the ground.
        cw = approach(cw, 0.0, 4.0, dt);
        bc += dt * (0.12 * wopen) / bound_t;
        if (cw < 0.5 && fract01(bc) >= BURST) { bc = floor(bc) + 1.0; }
        let fb = fract01(bc);
        if (fb < BURST) {
            let ub = fb / BURST;
            phi = 0.5 + BEATS * ub;
            shut_f = cw * max(1.0 - smooth01(ub / 0.15), smooth01((ub - 0.87) / 0.13));
        } else {
            shut_f = cw;
        }
        flare = 1.0;
    }
    let ws = crit_step(vec2<f32>(wopen, state[s + D_WOPEN_V]), select_f(aloft, 1.0, 0.0), select_f(aloft, 18.0, 12.0), dt);
    wopen = clamp(select_f(init, 0.0, ws.x), 0.0, 1.0);
    state[s + D_WOPEN_V] = select_f(init, 0.0, ws.y);
    var rise = alt + und;     // m the body is over where it would stand
    let rise_v = alt_v + und_v;

    // --- gait and the clock ---------------------------------------------------------------
    var gait = state[s + D_GAIT] as i32;
    var phase = state[s + D_PHASE];
    let was_moving = state[s + D_MOVING] > 0.5;
    var moving = vd > 0.02 || speed > 0.02 || abs(err) > 0.15;
    if (was_moving) { moving = moving || speed > 0.012 || abs(err) > 0.06; }
    if (lie > 0.001 || flinch > 0.05) { moving = false; }
    // A hop's length and height are settled as it leaves the ground: the
    // pace is followed in the stance and kept through the flight, which a
    // change of pace would otherwise bend out of a free fall.
    var veff = max(speed, 0.08 * abs(omega));
    let pace0 = state[s + D_PACE];
    let flying = was_moving && !init && fract01(phase) >= clamp(0.42 - 0.18 * pace0, 0.22, 0.42);
    if (flying) { veff = pace0; }
    state[s + D_PACE] = veff;
    let freq = HOP_F + HOP_FV * veff;
    let duty = clamp(0.42 - 0.18 * veff, 0.22, 0.42);
    // Hopping starts and stops at the bottom of a stance, where the body is
    // still: stopping, the hop under way is finished first.
    let fr = fract01(phase);
    if (was_moving && !(fr >= 0.5 * duty && fr < duty)) { moving = true; }
    // (In the air the hop's clock stands; it starts again as the feet come down.)
    if (aloft) { moving = false; }
    if (moving && !was_moving) { phase = floor(phase) + 1.0 + 0.5 * duty; }
    if (moving) { phase += freq * dt; }
    let go = select_f(moving, 1.0, 0.0);
    if (moving) { gait = GAIT_HOP; } else { gait = GAIT_STAND; }
    if (aloft) { gait = GAIT_FLY; }
    state[s + D_GAIT] = gait as f32;
    let stance_t = duty / freq;
    // The bounce, and across a start or a stop what is left of the last one
    // let go on a spring (the hop itself stays a free fall).
    let raw = go * hop_bounce(phase, duty, freq);
    var boff = vec2<f32>(state[s + D_BOFF], state[s + D_BOFF_V]);
    if (moving != was_moving && !init) { boff = vec2<f32>(state[s + D_BPREV] - raw, 0.0); }
    // (Down from a flight: what was left of its height and its fall are the
    // legs' to take up.)
    if (!aloft && (alt != 0.0 || alt_v != 0.0)) {
        boff += vec2<f32>(alt, alt_v);
        alt = 0.0;
        alt_v = 0.0;
        rise = 0.0;
    }
    // (It is let go only while the feet are down, most at the middle of a
    // stance and not at all where they leave and land: in the air nothing
    // can move the body off its fall, so what is left waits for the next
    // stance.)
    var let_go: f32 = 1.0;
    if (moving) {
        let su = clamp(fract01(phase) / duty, 0.0, 1.0);
        let_go = 16.0 * su * su * (1.0 - su) * (1.0 - su);
    }
    boff = crit_step(boff, 0.0, 25.0, dt * let_go);
    let bounce = raw + boff.x;
    let bounce_v = select_f(init, 0.0, (bounce - state[s + D_BPREV]) / max(dt, 1e-5));
    state[s + D_BOFF] = boff.x;
    state[s + D_BOFF_V] = boff.y;
    state[s + D_BPREV] = bounce;

    // --- feet ---------------------------------------------------------------------------------
    let lag = select_v3(init, vec3<f32>(0.0), ld3(state, s + D_LAG) * vec3<f32>(1.0, 0.0, 1.0));
    var busy = false;
    for (var l: i32 = 0; l < 2; l += 1) {
        if (state[s + D_LEG + l * LEG_REC + L_PLANT] < 0.5) { busy = true; }
    }
    var toes: array<vec3<f32>, 2>;
    var balls: array<vec3<f32>, 2>;
    var toe_a: array<f32, 2>;
    var ground_sum: f32 = 0.0;
    let hip_h = HEAD[B_FEMURL].y;
    for (var l: i32 = 0; l < 2; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let b0 = LEG_B0[l];
        let flat = rest_angle(b0 + 3);
        let home = pos + q_rot(qyaw, home_of(l));
        let ph = fract01(phase);
        var planted = state[k + L_PLANT] > 0.5;
        var toe = ld3(state, k + L_TOE);
        let hip = pos + q_rot(qyaw, HEAD[b0] - HEAD[B_BODY]) + vec3<f32>(0.0, state[s + D_BODY_Y] - pos.y + bounce + rise, 0.0);
        // In stance the toes lie on the ground; as the feet leave they stand
        // up onto their tips.
        // (Up on them until it has left: armed, a foot past its stance's
        // end on the clock is one about to lift, not one just landed.)
        // (Through the push, from the bottom of the crouch on: a stance is
        // a few hundredths of a second, and a roll kept to its end is a snap.)
        let roll = smooth01((ph - 0.40 * duty) / (0.60 * duty)) * select_f(ph < duty || state[k + L_ARMED] > 0.5, 1.0, 0.0) * go;
        var a = flat - ground_pitch(env, toe, fwd) - ROLL * roll;
        if (aloft) {
            // Flying. A foot stays down through the spring until its leg
            // has run out, is drawn up into the belly's feathers with its
            // toes curled, and coming down is reached out under the body
            // to meet the ground.
            let far = length(toe - hip) > REACH_OUT * (leg_reach(l) + length(toe_vec(l, flat)));
            if (planted && (far || fly_t > 0.08)) {
                planted = false;
                state[k + L_PLANT] = 0.0;
                state[k + L_ARMED] = 0.0;
                state[k + L_KIND] = 0.0;
                state[k + L_U] = 0.5;
                state[k + L_A0] = a;
            }
            if (!planted) {
                let down = !fly_want && alt < 0.07;
                let want = select_v3(down, vec3<f32>(0.0, -(hip_h + 0.006), 0.012), vec3<f32>(0.0, -0.22 * hip_h, -0.03));
                var rel = q_rot(q_conj(qyaw), toe - hip);
                rel += (want - rel) * (1.0 - exp(-select_f(down, 22.0, 16.0) * dt));
                toe = hip + q_rot(qyaw, rel);
                // (The toes closed and trailed back along the belly.)
                a = damp(state[k + L_A0], select_f(down, flat, -1.25), 16.0, dt);
                state[k + L_A0] = a;
                let gy = height(env, toe.x, toe.z);
                if (down && toe.y <= gy + 0.0005) {
                    toe.y = gy;
                    planted = true;
                    state[k + L_PLANT] = 1.0;
                    state[k + L_SINCE] = 0.0;
                }
                toe.y = max(toe.y, gy);
                st3(state, k + L_TO, toe);
            }
        }
        if (planted && !aloft) {
            if (ph < duty) { state[k + L_ARMED] = 1.0; }
            let stray = length(vec2<f32>(toe.x - home.x, toe.z - home.z));
            // It leaves on the clock, or sooner if the push has run the leg
            // out (a first hop from a stand, begun on legs near straight):
            // held down past that it is stretched past its length.
            let out = length(toe - hip) > REACH_OUT * (leg_reach(l) + length(toe_vec(l, flat)));
            var lift = moving && state[k + L_ARMED] > 0.5 && (ph >= duty || (out && bounce_v > 0.0));
            var dur = clamp((1.0 - ph) / freq, 0.06, 0.4);
            var kind: f32 = 0.0;
            // Standing: a foot strayed from home shuffles back, one at a time.
            if (!moving && !busy && stray > 0.006 && lie < 0.01 && flinch < 0.01) { lift = true; dur = 0.18; busy = true; kind = 1.0; }
            if (lift) {
                planted = false;
                state[k + L_PLANT] = 0.0;
                state[k + L_ARMED] = 0.0;
                state[k + L_U] = 0.0;
                state[k + L_DUR] = dur;
                state[k + L_KIND] = kind;
                state[k + L_A0] = a;
                // (Where it left from the hip: a hop carries the feet up with the body.)
                st3(state, k + L_FROM, select_v3(kind > 0.5, toe, q_rot(q_conj(qyaw), toe - hip)));
            }
        }
        if (!planted && !aloft) {
            let u_end = state[k + L_U] + dt / max(state[k + L_DUR], 0.03);
            let u = min(u_end, 1.0);
            state[k + L_U] = u;
            let settle = state[k + L_KIND] > 0.5;
            // Where it lands: home as it will be by mid-stance, turned on by
            // the turn it will make, placed from the body where it is.
            // (The time left runs past the swing's end by what the last step
            // overshoots it: cut off there, the landing place went on over the
            // ground by up to a step of the body's travel as the foot met it.)
            let to_mid = (1.0 - u_end) * state[k + L_DUR] + 0.5 * stance_t;
            var target = home;
            if (!settle) { target = q_rot(q_y(omega * to_mid), home - pos) + pos + fwd * (speed * to_mid) + lag; }
            target.y = height(env, target.x, target.z);
            st3(state, k + L_TO, target);
            let lifted = ld3(state, k + L_FROM);
            var path = target;
            if (settle) {
                path = swing_arc(hip, qyaw, lifted, target, smooth01(u / 0.9));
                path.y += 0.005 * bump(u, 0.35, 0.55);
            } else {
                // In the flight the feet go with the body as they left it, are
                // drawn up under the belly, and reach out to land.
                // (For TRAIL_T after they leave they trail where they stood,
                // the leg still lengthening as it eases off: carried from
                // the step they left, its lengthening stopped dead.)
                let t_air = u * state[k + L_DUR];
                let v_off = fwd * speed + vec3<f32>(0.0, bounce_v + 9.81 * t_air, 0.0);
                let carried = hip + q_rot(qyaw, lifted) - v_off * (t_air * (1.0 - smooth01(t_air / TRAIL_T)));
                let tucked = hip + q_rot(qyaw, vec3<f32>(0.0, -(1.0 - TUCK) * hip_h, 0.004));
                // (Eased with no acceleration at the ends: the legs are a
                // seventh of the mass, and a quick tuck jerks the body in
                // what should be a free fall.)
                path = mix(mix(carried, tucked, ease5(u / 0.55)), target, ease5((u - 0.4) / 0.6));
                // Reaching out to land, no further from the hip than the
                // leg is long: the ground is further than that until the
                // body has fallen to it, and a leg sent there early bends
                // back on itself until it lands.
                let hv = path - hip;
                let hl = length(hv);
                let cap = REACH_OUT * (leg_reach(l) + length(toe_vec(l, flat)));
                if (hl > 1e-5) { path = hip + hv * (soft_cap(hl, cap, 0.15) / hl); }
            }
            // (It lands when it has come to its place, not on the clock with
            // the body still too high for the leg to be there.)
            let there = length(path - target) < 0.002;
            let need = height(env, path.x, path.z) + 0.001 * bump(u, 0.1, 0.8);
            if (path.y < need) {
                let t = (need - path.y) / max(hip.y - path.y, 0.01);
                path += (hip - path) * min(t, 0.8);
            }
            // The toes curl under as the feet lift and open ahead to land flat.
            let gpt = ground_pitch(env, target, fwd);
            let curl = select_f(settle, mix(state[k + L_A0], flat, 0.5), CURL);
            a = mix(mix(state[k + L_A0], curl, smooth01(u / 0.35)), flat - gpt, smooth01((u - 0.50) / 0.42));
            toe = path;
            if (u >= 1.0 && there) {
                planted = true;
                state[k + L_PLANT] = 1.0;
                state[k + L_SINCE] = 0.0;
                toe = target;
            }
        }
        if (planted) { state[k + L_SINCE] = state[k + L_SINCE] + dt; }
        st3(state, k + L_TOE, toe);
        toes[l] = toe;
        toe_a[l] = a;
        balls[l] = toe - q_rot(qyaw, toe_vec(l, a));
        ground_sum += select_f(planted, toe.y, height(env, toe.x, toe.z));
    }
    let ground_y = 0.5 * ground_sum;
    // Down: both feet on the ground again, coming in to land.
    if (aloft && !fly_want && state[s + D_LEG + L_PLANT] > 0.5 && state[s + D_LEG + LEG_REC + L_PLANT] > 0.5) { aloft = false; }
    state[s + D_FLY] = select_f(aloft, 1.0, 0.0);
    state[s + D_FLY + 1] = fly_t;
    state[s + D_FLY + 2] = alt;
    state[s + D_FLY + 3] = alt_v;
    state[s + D_FLY + 4] = bc;
    state[s + D_FLY + 5] = cw;
    state[s + D_FLY + 6] = wopen;
    state[s + D_FLY + 7] = log_t;
    state[s + D_FLY + 8] = log_h;
    // Supple C2 springy tail bob driven by stance absorption, so the tail
    // cocks smoothly into every hop landing and relaxes without 1-frame snaps.
    let both_hop = state[s + D_LEG + L_PLANT] > 0.5 && state[s + D_LEG + L_KIND] < 0.5 && !aloft;
    let stance_bell = sin(PI * clamp(fract01(phase) / duty, 0.0, 1.0));
    let cock_in = select_f(both_hop, select_f(moving, stance_bell, smooth01(1.0 - state[s + D_LEG + L_SINCE] / 0.14)), 0.0);
    let cs = crit_step(vec2<f32>(state[s + D_COCK], state[s + D_COCK_V]), cock_in, 24.0, dt);
    let landed = clamp(select_f(init, 0.0, cs.x), 0.0, 1.2);
    state[s + D_COCK] = landed;
    state[s + D_COCK_V] = select_f(init, 0.0, cs.y);

    // --- the body's plan ---------------------------------------------------------------------
    // Foraging, a peck at the ground every half second or so.
    let pk = fract01(clock / 0.55 + 0.37 * seed);
    let peck = smooth01(pk / 0.12) * (1.0 - smooth01((pk - 0.18) / 0.22));
    // (Flying it lies level along its way, nose up as it rises and down as
    // it sinks, and rears back to brake as it comes in to land.)
    let air_v = rise_v + select_f(aloft, 0.0, boff.y);
    let lean_fly = 0.22 - clamp(0.45 * air_v, -0.4, 0.5) - 0.55 * flare;
    let lean_want = mix(0.1 * smooth01(speed / 0.8) + (0.45 + 0.2 * peck) * graze - 0.1 * lie + 0.15 * flinch - 0.12 * alert, lean_fly, wopen);
    let ls = crit_step(vec2<f32>(state[s + D_LEAN], state[s + D_LEAN_V]), lean_want, 18.0, dt);
    let lean = select_f(init, lean_want, ls.x);
    state[s + D_LEAN] = lean;
    state[s + D_LEAN_V] = select_f(init, 0.0, ls.y);
    // (And banks into its turns.)
    let bank = clamp(-0.12 * omega * speed, -0.6, 0.6) * wopen;
    let qbody = q_mul(qyaw, q_mul(q_x(lean), q_z(bank)));
    let crouch = 0.003 * graze + 0.021 * lie + 0.008 * flinch - 0.002 * alert;
    let want_y = ground_y + HEAD[B_BODY].y - crouch;
    // (Well up, the ground passing under it is followed slowly: a log is
    // not a hill.)
    let body_y = damp(state[s + D_BODY_Y], want_y, mix(14.0, 2.0, smooth01(alt / 0.1)), dt);
    state[s + D_BODY_Y] = body_y;
    // Standing, the plan keeps the centre of mass over the middle of the feet.
    let coff_m = q_rot(qyaw, ld3(state, s + D_COFF));
    let mid = 0.5 * (balls[0] + balls[1]) + 0.5 * (toes[0] + toes[1]);
    let still = (1.0 - go) * select_f(busy, 0.0, 1.0);
    var bal = vec2<f32>(state[s + D_BAL], state[s + D_BAL + 1]);
    let bal_want = BALANCE * still * (1.0 - wopen) * vec2<f32>(0.5 * mid.x - pos.x - coff_m.x, 0.5 * mid.z - pos.z - coff_m.z);
    bal = select_v2(init, bal_want, bal + (bal_want - bal) * (1.0 - exp(-6.0 * dt)));
    state[s + D_BAL] = bal.x;
    state[s + D_BAL + 1] = bal.y;
    let plan = vec3<f32>(pos.x + bal.x, body_y + bounce + rise, pos.z + bal.y) - fwd * (0.004 * lie);

    // --- the body: its centre of mass as the feet move it (creature::body) ---------------------
    let coff_p = q_rot(qyaw, ld3(state, s + D_COFF1));
    var sup: Support;
    for (var l: i32 = 0; l < 2; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        var f: Foot;
        f.at = 0.5 * (toes[l] + balls[l]) * vec3<f32>(1.0, 0.0, 1.0) + vec3<f32>(0.0, toes[l].y, 0.0);
        f.pivot = plan + lag + q_rot(qbody, HEAD[LEG_B0[l]] - HEAD[B_BODY]);
        f.reach = LEG_LEN[l];
        f.since = state[k + L_SINCE];
        f.left = select_f(state[k + L_PLANT] > 0.5 && moving, max(duty - fract01(phase), 0.0) / freq, 1e3);
        f.down = state[k + L_PLANT];
        sup.f[l] = f;
    }
    sup.effort = 1.0;
    // The hop's bounce is the body's own: its push begun as the plan asks.
    sup.lead = go;
    let bd = body_step(state, s + D_BODY, plan + coff_m, mix(3.0, 1.0, go), sup, init, dt);
    let wl = smooth01(lie * 3.0);
    // (Hopping, the body rides its plan: the bounce is already a true fall
    // and a spring's push, and the layer's feet, too slow for a stance this
    // short, only held the mass to the plan by its stray limit.)
    var shift = (bd.com - coff_p - plan) * LAYERS * (1.0 - wl) * (1.0 - go) * (1.0 - wopen);
    if (wl > 0.0) { body_set(state, s + D_BODY, mix(bd.com, plan + coff_p, wl), mix(bd.vel, bd.tvel, wl)); }
    // (And the layer's mass is kept on the plan while it hops, so that it
    // stops from where the body is: left to itself it strayed a centimetre
    // ahead, and the body jumped there in the step the hopping ended.)
    if (moving || wopen > 0.0) { body_set(state, s + D_BODY, plan + coff_p, bd.tvel); }
    var held = 0.0;
    let over0 = max(reach_over(state, s, balls, plan, qbody), 0.0);
    if (reach_over(state, s, balls, plan + shift, qbody) > over0) {
        var lo: f32 = 0.0;
        var hi: f32 = 1.0;
        for (var it: i32 = 0; it < 6; it += 1) {
            let m = 0.5 * (lo + hi);
            if (reach_over(state, s, balls, plan + shift * m, qbody) > over0) { hi = m; } else { lo = m; }
        }
        held = 1.0 - lo;
    }
    if (!init) { held = max(held, state[s + D_HELD] * exp(-dt / CAP_EASE)); }
    // (With both feet in the air there is no reach to keep within: the
    // body goes where its mass does.)
    if (state[s + D_LEG + L_PLANT] < 0.5 && state[s + D_LEG + LEG_REC + L_PLANT] < 0.5) { held = 0.0; }
    state[s + D_HELD] = held;
    shift = shift * (1.0 - held);
    st3(state, s + D_LAG, shift);
    let root = plan + shift;
    let pr = s + PROBE;
    probe(state, pr, 0, plan.y - ground_y);
    probe3(state, pr, 1, q_rot(q_conj(qyaw), bd.com - coff_p - plan));
    probe(state, pr, 4, held);
    probe(state, pr, 5, bd.load);
    probe(state, pr, 6, landed);

    var T: Pose;
    T.q[B_BODY] = qbody;
    T.p[B_BODY] = root;

    // --- neck and head: glances, the gaze, a peck ----------------------------------------------
    // A glance every so often to a new side, turned to quickly and held.
    let gi = floor(clock / 0.7 + seed);
    var look_want = GLANCE * (2.0 * hash01(gi * 7.31 + seed) - 1.0) * select_f(hash01(gi * 3.17) > 0.3, 1.0, 0.0);
    var look_p: f32 = 0.0;
    if (intent[ii + I_GAZE_W] > 0.0) {
        let gz = vec3<f32>(intent[ii + I_GAZE_X], intent[ii + I_GAZE_Y], intent[ii + I_GAZE_Z]) - (root + q_rot(qyaw, HEAD[B_HEAD] - HEAD[B_BODY]));
        let gl = q_rot(q_conj(qyaw), gz);
        look_want = mix(look_want, atan2(gl.x, gl.z), intent[ii + I_GAZE_W]);
        look_p = intent[ii + I_GAZE_W] * -atan2(gl.y, length(vec2<f32>(gl.x, gl.z)));
    }
    // (Flying it looks where it is going.)
    look_want = clamp(look_want * (1.0 - graze) * (1.0 - lie) * (1.0 - 0.85 * wopen) + 0.3 * omega, -1.4, 1.4);
    let lk = crit_step(vec2<f32>(state[s + D_LOOK], state[s + D_LOOK_V]), look_want, 30.0, dt);
    let look = select_f(init, look_want, lk.x);
    state[s + D_LOOK] = look;
    state[s + D_LOOK_V] = select_f(init, 0.0, lk.y);
    // The neck: forward and down foraging (deeper at a peck), drawn in
    // resting and startled, up alert, turned a little to the look.
    let nod = 0.85 * graze + 0.45 * peck * graze + 0.35 * lie + 0.3 * flinch - 0.35 * alert - lean;
    T.q[B_NECK] = q_mul(qbody, q_xyz(soft_xyz(vec3<f32>(nod, 0.35 * look, 0.0), B_NECK, 0.1)));
    T.p[B_NECK] = head_of(T, B_NECK);
    T.p[B_HEAD] = head_of(T, B_HEAD);
    // The head: the bill level, down at the ground foraging, turned to the look.
    let pitch = (0.9 + 0.35 * peck) * graze + 0.4 * look_p * (1.0 - graze) - 0.08 * alert + 0.2 * lie;
    // Now and then a glance is a cocked head: tipped over to put one eye
    // on what it looks at, snapped there and held as the glance is.
    let cf = clock / 0.7 + seed;
    let cg = floor(cf);
    let c0 = select_f(hash01((cg - 1.0) * 9.13 + seed) > 0.55, 2.0 * hash01((cg - 1.0) * 2.71 + seed) - 1.0, 0.0);
    let c1 = select_f(hash01(cg * 9.13 + seed) > 0.55, 2.0 * hash01(cg * 2.71 + seed) - 1.0, 0.0);
    let cocked = 0.5 * mix(c0, c1, smooth01((cf - cg) / 0.12)) * (1.0 - graze) * (1.0 - lie) * (1.0 - wopen) * (1.0 - smooth01(flinch * 3.0));
    T.q[B_HEAD] = q_mul(qyaw, q_mul(q_y(look), q_mul(q_x(pitch), q_z(cocked))));
    // Its mood, which its face draws (face.bk): the pupil wide at ease
    // and wider curious, pinned in alarm and on the wing; the brow raised
    // with a cocked head, sleeked down low when it is alarmed or flying.
    let curious = abs(cocked) / 0.5;
    let pupil = clamp(0.25 + 0.3 * graze + 0.3 * lie + 0.5 * curious - 1.1 * alert - 0.7 * flinch - 0.6 * wopen, -1.0, 1.0);
    let brow = clamp(0.8 * curious + 0.15 * graze - 0.9 * alert - 0.6 * flinch - 0.7 * wopen, -1.0, 1.0);
    let mood_y = asin(0.6 * pupil);
    let mood_x = clamp(-asin(clamp(0.6 * brow / max(cos(mood_y), 0.75), -0.62, 0.62)), -0.65, 0.65);
    let q_mood_rel = q_xyz(vec3<f32>(mood_x, mood_y, 0.0));
    T.q[B_MOOD] = q_mul(T.q[B_HEAD], q_mood_rel);
    T.p[B_MOOD] = head_of(T, B_MOOD);
    // The eyes: it blinks with the third eyelid, a pale flick across from
    // the front, often and too quick to follow, and at each peck as the
    // bill goes down; settled to rest, the lower lids come up and it dozes,
    // opening one now and then.
    let bt = clock / 1.7 + seed * 4.3;
    let bk = floor(bt);
    let bu = ((bt - bk) - 0.1 - 0.7 * hash01(bk * 6.7 + seed)) * 1.7;
    var flick_m: f32 = 0.0;
    if (bu > 0.0 && bu < 0.09) { flick_m = sin(PI * bu / 0.09); }
    let mem = max(flick_m, peck * graze);
    let peek = smooth01(3.0 * noise1(clock * 0.21, seed, 23.0) - 1.6);
    let doze = 0.95 * smooth01((lie - 0.5) / 0.4) * (1.0 - 0.8 * peek) * (1.0 - alert);
    let q_lid_rel = q_xyz(vec3<f32>(asin(doze), 0.0, asin(0.98 * mem)));
    T.q[B_LID] = q_mul(T.q[B_HEAD], q_lid_rel);
    T.p[B_LID] = head_of(T, B_LID);

    // --- tail and wings ---------------------------------------------------------------------
    let flick = 0.25 * max(noise1(clock / 0.35, seed, 5.0) - 0.5, 0.0) / 0.5;
    // Startled: two crisp rapid wing-and-tail flicks with C2-smooth onset.
    var flut: f32 = 0.0;
    if (st_t >= 0.0) { flut = ease5(st_t / 0.09) * (1.0 - ease5((st_t - 0.34) / 0.26)); }
    let beat = 0.5 - 0.5 * cos(TAU * 4.2 * max(st_t, 0.0));
    // (Flying the tail lies out along the body, and is thrown down to brake.)
    let cock = (COCK * landed + flick) * (1.0 - wopen) + 0.25 * alert - 0.15 * lie - 0.25 * graze + TAIL_FLICK * flut * (0.4 + 0.6 * beat)
               + wopen * (0.12 - 0.5 * flare);
    T.q[B_TAIL] = q_mul(qbody, q_xyz(soft_xyz(vec3<f32>(cock, 0.0, 0.0), B_TAIL, 0.1)));
    T.p[B_TAIL] = head_of(T, B_TAIL);
    // The wings. The skeleton stands them spread; each bone is turned from
    // there toward where it lies folded (wing_fold), by `shut`: 1 on the
    // flank, less as it opens.
    for (var w: i32 = 0; w < 2; w += 1) {
        let sd = SIDE[w];
        let b0 = WING_B0[w];
        // Beating: the arm swings about the shoulder, up and down through
        // the stroke; the hand and its primaries trail it (above it going
        // down, below it coming up); the leading edge turns down into the
        // downstroke; and on the way up the wing is half folded, to slip
        // back up through the air it pushed down. Coming in to land the
        // beats are shallow and held high, the wings a brake.
        let fp = fract01(phi);
        let sw = cos(TAU * fp);
        let dn = sin(TAU * fp);                           // over 0: going down
        let th = STROKE_MID + 0.25 * flare + STROKE * (1.0 - 0.35 * flare) * sw;
        let flex = FLEX * max(-dn, 0.0) * max(-dn, 0.0);
        let shut = (1.0 - wopen * (1.0 - max(shut_f, flex))) * (1.0 - WING_FLICK * flut * (0.35 + 0.65 * beat)) * (1.0 - WING_SPREAD);
        let q_arm = q_mul(q_z(sd * th), q_x(FEATHER * dn));
        let q_hand = q_mul(q_z(sd * (th + TIP_LAG * dn)), q_x(1.4 * FEATHER * dn));
        for (var i: i32 = 0; i < WING_NB; i += 1) {
            let b = b0 + i;
            // (The hand and its four primaries; the rest go with the arm.)
            // (The fold is made from where the bone stands spread and the
            // stroke's swing laid over it by what is left open: blended
            // straight from the beating wing to the folded one, a bone the
            // two put half a turn apart went round the other way in a step.)
            let q_open = q_blend(q_id(), select_q(i >= 2 && i <= 6, q_hand, q_arm), wopen * (1.0 - shut));
            T.q[b] = q_mul(qbody, q_mul(q_open, q_blend(q_id(), wing_fold(b, i, sd), shut)));
            T.p[b] = head_of(T, b);
        }
    }

    // --- legs: each solved in its plane, hip to toe tip -----------------------------------
    let fw = q_rot(qbody, vec3<f32>(0.0, 0.0, 1.0));
    let par_pitch = atan2(fw.y, length(vec2<f32>(fw.x, fw.z)));
    for (var l: i32 = 0; l < 2; l += 1) {
        let b0 = LEG_B0[l];
        let j = root + q_rot(qbody, HEAD[b0] - HEAD[B_BODY]);
        let d = q_rot(q_conj(qbody), toes[l] - j);
        let o = solve_hind(b0, d, toe_a[l] - par_pitch, SOFT_REACH);
        let qr = q_mul(qbody, q_z(o.rho));
        var prev: f32 = 0.0;
        for (var i: i32 = 0; i < 4; i += 1) {
            let b = b0 + i;
            let loc = soft_range(-(leg_angle(o, i) - rest_angle(b)) - prev, LIM_LO[b].x, LIM_HI[b].x, LEG_BAND);
            prev += loc;
            T.q[b] = q_mul(qr, q_x(prev));
            if (i == 0) { T.p[b] = j; } else { T.p[b] = head_of(T, b); }
        }
    }

    // --- the parts that hang carry their momentum (creature::secondary) -----------------------
    var hold: array<f32, NB>;
    var firm: array<f32, NB>;
    for (var b: i32 = 0; b < NB; b += 1) { hold[b] = 0.0; firm[b] = 0.0; }
    hold[B_HEAD] = 1.0;
    firm[B_NECK] = 1.0;
    firm[B_HEAD] = 1.0;
    firm[B_TAIL] = 0.5;
    var A = carry_held(state, env, s + D_SEC, T, hold, firm, LAYERS, init, dt);
    A.q[B_MOOD] = q_mul(A.q[B_HEAD], q_mood_rel);
    A.p[B_MOOD] = head_of(A, B_MOOD);
    A.q[B_LID] = q_mul(A.q[B_HEAD], q_lid_rel);
    A.p[B_LID] = head_of(A, B_LID);
    // The folded wings are held to the body (sprung, a hop's landing flings
    // them open); only fluttering do they carry their own momentum.
    let keep = max(1.0 - smooth01(flut * 4.0), smooth01(wopen * 4.0));
    for (var w: i32 = 0; w < 2; w += 1) {
        for (var i: i32 = 0; i < WING_NB; i += 1) {
            let b = WING_B0[w] + i;
            let par = PARENT[b];
            let q = q_mul(A.q[par], q_mul(q_conj(T.q[par]), T.q[b]));
            A.q[b] = q_blend(A.q[b], q, keep);
            A.p[b] = head_of(A, b);
        }
    }

    let coff = q_rot(q_conj(qyaw), com_of(A) - root);
    st3(state, s + D_COFF1, coff);
    st3(state, s + D_COFF, select_v3(init, coff, mix(ld3(state, s + D_COFF), coff, 1.0 - exp(-dt / 0.3))));
    if (init) { body_set(state, s + D_BODY, com_of(A), vec3<f32>(0.0)); }
    // In the air the whole bird is put on its mass: legs tucking through a
    // flight carry the mass off its usual place over the root, and with no
    // foot down nothing need stay still, so all of it goes back by that
    // (most at the middle of the feet's swing, nothing where they leave and
    // meet the ground).
    var air: f32 = go * (1.0 - wl) * (1.0 - wopen);
    for (var l: i32 = 0; l < 2; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let u = state[k + L_U];
        let bell = 4.0 * u * (1.0 - u);
        air = min(air, select_f(state[k + L_PLANT] > 0.5 || state[k + L_KIND] > 0.5, 0.0, bell * bell));
    }
    if (!init) { A = moved(A, q_rot(qyaw, ld3(state, s + D_COFF) - coff) * (LAYERS * air)); }

    // --- out ---------------------------------------------------------------------------------------
    put(pose, c, A);
    st3(state, s + S_POS, vec3<f32>(pos.x, body_y, pos.z));
    state[s + S_YAW] = yaw;
    state[s + D_SPEED] = speed;
    state[s + D_OMEGA] = omega;
    state[s + D_PHASE] = phase;
    state[s + D_MOVING] = select_f(moving, 1.0, 0.0);

    let t0 = c * TELE;
    tele[t0 + T_POS] = plan.x;
    tele[t0 + T_POS + 1] = plan.y;
    tele[t0 + T_POS + 2] = plan.z;
    tele[t0 + T_YAW] = yaw;
    tele[t0 + T_SPEED] = speed;
    tele[t0 + T_GAIT] = gait as f32;
    tele[t0 + T_PHASE] = fract01(phase);
    tele[t0 + T_ACTION] = act as f32;
    tele[t0 + T_HEIGHT] = body_y + rise - ground_y;
    tele[t0 + T_PITCH] = lean;
    tele[t0 + T_ROLL] = 0.0;
    tele[t0 + T_FREQ] = freq * go;
    for (var l: i32 = 0; l < 2; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let f0 = t0 + T_FOOT + 4 * l;
        tele[f0] = state[k + L_PLANT];
        tele[f0 + 1] = toes[l].x;
        tele[f0 + 2] = toes[l].y;
        tele[f0 + 3] = toes[l].z;
    }
}
