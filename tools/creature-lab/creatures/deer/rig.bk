// The deer's rig: one invocation per deer, its state in `state`, its bones
// out to `pose` (the creature contract, lab/contract.js).
//
// How it moves. A gait clock (walk, trot, gallop, blended across a change
// of gait) says when each leg wants to lift: a leg in stance whose phase
// passes the duty factor lifts, swings for the rest of its cycle and lands
// where its home under the hip will be by mid-stance. A planted hoof stays
// where it landed; the body moves over it. Standing still, a hoof that has
// strayed from its home past a few centimetres steps back, one at a time.
// A hoof stretched past its reach steps at once whatever the clock says.
//
// The rig plans the body: the hips over the hind feet, the withers over the
// fore, each on a spring, so the back pitches with the ground, and the path
// the intent asks for. The lab's motion layers make it move as a body:
// creature::body moves the centre of mass only as the loaded feet can push
// it (the rig places the bones about it), creature::spine bends the back with
// the legs' spread and the turn, and creature::secondary carries the neck,
// head, ears and tail as masses on springs, the head holding part of its
// gaze in space. Legs are solved in their plane (deer::legs) to the hooves
// from where the body is. Every joint is held within its limits.
import creature::common::*;
import creature::contract::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::secondary::*;
import creature::body::*;
import creature::spine::*;
import deer::legs::*;
from creature::ground import height, normal;

// Deliberate faults, for testing the lab's measures (0 is the deer).
@knob const FAULT_SLIP: f32 = 0.0;      // planted hooves slide back at this share of the body's speed
@knob const FAULT_SINK: f32 = 0.0;      // metres the left fore plants below the ground
@knob const FAULT_OVERBEND: f32 = 0.0;  // radians the left hock is driven past its limit in swing
@knob const FAULT_STUMBLE: f32 = 0.0;   // cycles the right hind's phase jumps every other stride

// --- state layout (after the contract's header) ------------------------------
const D_SPEED: i32 = 5;
const D_OMEGA: i32 = 6;
const D_CLOCK: i32 = 7;
const D_PHASE: i32 = 8;
const D_GW: i32 = 9;          // gait weights walk, trot, gallop (3)
const D_GAIT: i32 = 12;       // the gait chosen (contract GAIT_*)
const D_MOVING: i32 = 13;
const D_HY: i32 = 14;         // hip height and its speed (the plan)
const D_HV: i32 = 15;
const D_FY: i32 = 16;         // withers height and its speed (the plan)
const D_FV: i32 = 17;
const D_ROLL: i32 = 18;
const D_LIE: i32 = 19;
const D_GRAZE: i32 = 20;
const D_ALERT: i32 = 21;
const D_STARTLE_T: i32 = 22;
const D_PREV_ACT: i32 = 23;
const D_GAZE_YAW: i32 = 24;
const D_GAZE_PITCH: i32 = 25;
const D_GRAZE_T: i32 = 26;
const D_PITCH_S: i32 = 28;    // the body's pitch and withers height, slowly smoothed
const D_FY_S: i32 = 29;       //   (what the neck holds the head against)
const D_LAG: i32 = 30;        // the body's centre against the plan's, last step (3)
const D_LAGV: i32 = 33;       //   and its velocity against the path's (3)
const D_LEG: i32 = 40;        // per leg, LEG_REC floats
const LEG_REC: i32 = 16;
const L_PLANT: i32 = 0;
const L_TOE: i32 = 1;         // the toe: planted point, or where the swing has it
const L_FROM: i32 = 4;
const L_TO: i32 = 7;
const L_U: i32 = 10;
const L_T: i32 = 11;
const L_ARMED: i32 = 12;
const L_KIND: i32 = 13;       // 0 a gait step, 1 a settling step
const L_SINCE: i32 = 14;      // s since it landed
const D_COFF: i32 = 104;      // the pose's centre of mass from the root, in the yaw frame: slow mean (3),
const D_COFF1: i32 = 107;     //   last step's (3)
const D_COFF2: i32 = 110;     //   and the step's before (3)
const D_BODY: i32 = 116;      // creature::body (BODY_STATE)
const D_SPINE: i32 = 130;     // creature::spine (SPINE_STATE)
const D_SEC: i32 = 136;       // creature::secondary (SEC_STATE)
pub const STATE: i32 = 400;

const WALK_UP: f32 = 1.9;
const TROT_DOWN: f32 = 1.5;
const TROT_UP: f32 = 4.6;
const GALLOP_DOWN: f32 = 4.0;

const SETTLE_TRIG: f32 = 0.05;   // m a still hoof may stray before it steps home
const REACH_TRIG: f32 = 0.52;    // m a planted hoof may trail its home before it must step
const SETTLE_T: f32 = 0.34;
@knob const HEAD_HOLD: f32 = 0.6;      // share of the body's bob and pitch the neck takes up
@knob const HEAD_SPACE: f32 = 0.6;     // share of its gaze in space the head holds (the rest it is carried)
@knob const NECK_LEVER: f32 = 0.35;    // m the head rises per radian of neck extension
@knob const SCAP_PIVOT: f32 = 0.4;     // where along the blade the fore leg swings about
@knob const REACH_FORE: f32 = 0.90;    // m from that pivot to the toe the fore leg can hold
@knob const REACH_FORE_TOP: f32 = 0.965; // m from the blade's top to the toe, the fore leg near straight
@knob const LIE_HIP: f32 = 0.36;     // m the hips rest over the ground, lying
@knob const LIE_WITHERS: f32 = 0.53;   // m the withers rest over the ground, lying
@knob const REACH_HIND: f32 = 0.835;   // m from the femur head to the toe the hind leg can hold
@knob const SCAP_FOLLOW: f32 = 0.6;  // of the leg's swing the scapula takes
@knob const VARY: f32 = 1.0;         // share of the individual's wander in speed and heading (0: none)
@knob const LAYERS: f32 = 1.0;       // the motion layers' share (0: the rig's plan as it is)
const BREAKOVER: f32 = 0.55;     // rad the hoof rolls onto its toe before lift
const WITHERS_Z: f32 = 0.69;     // hips (pelvis head) to withers, along the back
const RISE_EASE: f32 = 0.015;    // m under the legs' reach where the body's rise eases off
const CAP_FADE: f32 = 0.25;      // m a coming or going hoof's reach limit is slackened by

// The fore leg's swing pivot and the hind's, where the body layer and the
// reach caps measure a leg from (rest frame).
fn leg_pivot(l: i32) -> vec3<f32> {
    let b0 = LEG_B0[l];
    if (LEG_HIND[l] == 1) { return HEAD[b0]; }
    return mix(HEAD[b0], TAIL[b0], SCAP_PIVOT);
}

// The joint leg l swings from, with the hips at `hy` and the withers at `fy`
// over the root `bpos`.
fn leg_top(l: i32, bpos: vec3<f32>, qyaw: vec4<f32>, hy: f32, fy: f32) -> vec3<f32> {
    let piv = leg_pivot(l);
    var top = bpos + q_rot(qyaw, vec3<f32>(piv.x - HEAD[B_PELVIS].x, 0.0, piv.z - HEAD[B_PELVIS].z));
    if (LEG_HIND[l] == 1) { top.y = hy - HEAD[B_PELVIS].y + piv.y; }
    else { top.y = fy - HEAD[B_SCAPL].y + piv.y; }
    return top;
}

// How far past its reach the furthest planted hoof is with the body moved
// by `shift` from `plan` (negative: all within reach).
fn reach_over(st: rw_store<f32, 1>, s: i32, toes: array<vec3<f32>, 4>, plan: vec3<f32>, qyaw: vec4<f32>,
              hy: f32, fy: f32, shift: vec3<f32>) -> f32 {
    var worst: f32 = -1e3;
    for (var l: i32 = 0; l < 4; l += 1) {
        if (st[s + D_LEG + l * LEG_REC + L_PLANT] < 0.5) { continue; }
        let top = leg_top(l, plan, qyaw, hy, fy) + shift;
        let r = select_f(LEG_HIND[l] == 1, REACH_HIND, REACH_FORE);
        worst = max(worst, length(toes[l] - top) - r);
    }
    return worst;
}

// How far ahead of the hips (pelvis head) the body turns about.
fn turn_z() -> f32 {
    return 0.5 * (leg_pivot(0).z + leg_pivot(1).z) - HEAD[B_PELVIS].z;
}

fn place(st: rw_store<f32, 1>, env: read_store<f32, 1>, s: i32) {
    let p = ld3(st, s + S_POS);
    let yaw = st[s + S_YAW];
    let q = q_y(yaw);
    for (var l: i32 = 0; l < 4; l += 1) {
        let toe0 = TAIL[LEG_B0[l] + LEG_NB[l] - 1] - HEAD[B_PELVIS];
        let w = q_rot(q, vec3<f32>(toe0.x, 0.0, toe0.z)) + vec3<f32>(p.x, 0.0, p.z);
        let t = vec3<f32>(w.x, height(env, w.x, w.z), w.z);
        let k = s + D_LEG + l * LEG_REC;
        st[k + L_PLANT] = 1.0;
        st3(st, k + L_TOE, t);
        st3(st, k + L_TO, t);
        st[k + L_U] = 0.0;
        st[k + L_ARMED] = 1.0;
        st[k + L_SINCE] = 1.0;
    }
    let gp = height(env, p.x, p.z);
    let pf = p + q_rot(q, vec3<f32>(0.0, 0.0, WITHERS_Z));
    st[s + D_HY] = gp + HEAD[B_PELVIS].y;
    st[s + D_FY] = height(env, pf.x, pf.z) + HEAD[B_SCAPL].y;
    st[s + D_HV] = 0.0;
    st[s + D_FV] = 0.0;
    st[s + D_GW] = 1.0;
    st[s + D_GAIT] = GAIT_WALK as f32;
    // The rest pose's centre of mass from its root, as the body starts.
    var cr = vec3<f32>(0.0);
    for (var b: i32 = 0; b < NB; b += 1) { cr += MASS[b] * 0.5 * (HEAD[b] + TAIL[b]); }
    let coff = cr / TOTAL_MASS - HEAD[B_PELVIS];
    st3(st, s + D_COFF, coff);
    st3(st, s + D_COFF1, coff);
    st3(st, s + D_COFF2, coff);
    st[s + S_PLACED] = 1.0;
}

@kernel @grid(1)
fn k_rig(g: grid<1>, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
         pose: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    let c = g.x();
    let s = c * STATE;
    let ii = c * INTENT;
    let init = state[s + S_PLACED] < 0.5;
    if (init) { place(state, env, s); }

    // --- intent and actions -------------------------------------------------------
    var vdes = vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z]);
    let act = intent[ii + I_ACTION] as i32;
    let seed = intent[ii + I_SEED];
    let clock = state[s + D_CLOCK] + dt;
    state[s + D_CLOCK] = clock;

    var lie = approach(state[s + D_LIE], select_f(act == ACT_LIE, 1.0, 0.0), 0.42, dt);
    var graze = approach(state[s + D_GRAZE], select_f(act == ACT_GRAZE, 1.0, 0.0), 1.1, dt);
    let alert_want = select_f(act == ACT_STARTLE || act == ACT_ALERT, 1.0, 0.0);
    var alert = state[s + D_ALERT];
    if (alert_want > alert) { alert = approach(alert, 1.0, 9.0, dt); } else { alert = approach(alert, 0.0, 0.7, dt); }
    var st_t = state[s + D_STARTLE_T];
    if (act == ACT_STARTLE && (state[s + D_PREV_ACT] as i32) != ACT_STARTLE) { st_t = 0.0; }
    if (st_t >= 0.0) { st_t += dt; }
    if (st_t > 3.0) { st_t = -1.0; }
    state[s + D_LIE] = lie;
    state[s + D_GRAZE] = graze;
    state[s + D_ALERT] = alert;
    state[s + D_STARTLE_T] = st_t;
    state[s + D_PREV_ACT] = act as f32;
    if (lie > 0.001 || act == ACT_LIE) { vdes = vec2<f32>(0.0); }
    let graze_slow = 1.0 - 0.8 * graze;
    vdes *= graze_slow;

    // --- heading and speed ---------------------------------------------------------
    // The individual wanders a little in speed (4%) and heading (0.04 rad)
    // about what the intent asks, slowly (over a second or two): the
    // variation from stride to stride comes from the body's own response to
    // it, not from the strides themselves. It belongs to steady going: it
    // fades out under 0.6 m/s and while the speed is still changing.
    var yaw = state[s + S_YAW];
    var speed = state[s + D_SPEED];
    var want = yaw;
    let vd = length(vdes);
    let vary = VARY * smooth01(speed / 0.6) * smooth01(1.0 - abs(vd - speed) / 0.4);
    if (intent[ii + I_HEADING_MODE] > 0.5) { want = intent[ii + I_HEADING]; }
    else if (vd > 0.05) { want = atan2(vdes.x, vdes.y) + vary * 0.04 * noise1(clock / 1.7, seed, 2.0); }
    // The turn's rate comes and goes within an angular acceleration (no
    // corner in any joint's speed), and on the spot it is what the hooves
    // can step round: the girdle turns about half the angle between its
    // two hooves in a stride, or a hoof would land on its pair's.
    let rate = mix(0.45, 2.1 / (1.0 + 0.3 * speed), smooth01(speed / 0.8));
    let w_t = clamp(3.0 * wrap_pi(want - yaw), -rate, rate);
    let omega = approach(state[s + D_OMEGA], w_t, 4.0, dt);
    yaw = wrap_pi(yaw + omega * dt);
    let err = wrap_pi(want - yaw);
    let vt = vd * clamp(cos(err), 0.15, 1.0) * (1.0 + vary * 0.04 * noise1(clock / 1.3, seed, 1.0));
    // The path asks only for what the feet can do: speed changes within the
    // push they can give across their legs (creature::body MU_T).
    let dv_max = 0.8 * MU_T * 9.81;
    if (vt > speed) { speed = approach(speed, vt, min(1.6 + 0.6 * speed, dv_max), dt); }
    else { speed = approach(speed, vt, min(3.5, dv_max), dt); }
    let fwd = vec3<f32>(sin(yaw), 0.0, cos(yaw));
    let left = vec3<f32>(cos(yaw), 0.0, -sin(yaw));
    var pos = ld3(state, s + S_POS);
    pos += fwd * speed * dt;
    // The body turns about its middle (halfway between the girdles' swing
    // joints), not its hips: the root is moved by what the turn swings it
    // round that point, so in a tight circle or a turn on the spot both
    // girdles step round and neither sweeps its hooves out from under it.
    let tz = turn_z();
    let yaw0 = state[s + S_YAW];
    pos += (vec3<f32>(sin(yaw0), 0.0, cos(yaw0)) - fwd) * tz;
    // The feet go where the body is and as it moves (the body's centre and
    // its velocity against the plan's, last step): a body that lags its path
    // is stepped under, not braked by hooves planted ahead of it.
    let lag = ld3(state, s + D_LAG) * vec3<f32>(1.0, 0.0, 1.0) * LAYERS;
    let bpos = pos + lag;
    let vel = fwd * speed + ld3(state, s + D_LAGV) * vec3<f32>(1.0, 0.0, 1.0) * LAYERS;

    // --- gait ------------------------------------------------------------------------
    var gait = state[s + D_GAIT] as i32;
    if (gait == GAIT_WALK && speed > WALK_UP) { gait = GAIT_TROT; }
    else if (gait == GAIT_TROT && speed < TROT_DOWN) { gait = GAIT_WALK; }
    else if (gait == GAIT_TROT && speed > TROT_UP) { gait = GAIT_GALLOP; }
    else if (gait == GAIT_GALLOP && speed < GALLOP_DOWN) { gait = GAIT_TROT; }
    var gw = ld3(state, s + D_GW);
    gw.x = approach(gw.x, select_f(gait == GAIT_WALK, 1.0, 0.0), 2.2, dt);
    gw.y = approach(gw.y, select_f(gait == GAIT_TROT, 1.0, 0.0), 2.2, dt);
    gw.z = approach(gw.z, select_f(gait == GAIT_GALLOP, 1.0, 0.0), 2.2, dt);
    gw = gw / max(gw.x + gw.y + gw.z, 1e-4);
    // A turn steps as fast as its hooves go round, and quicker on the spot,
    // where the strides are short.
    let veff = max(speed, abs(omega) * mix(1.5, 0.9, smooth01(speed / 0.8)));
    let freq = gw.x * (0.62 + 0.45 * veff) + gw.y * (1.55 + 0.12 * veff) + gw.z * (2.0 + 0.06 * veff);
    // The clock's duty: the measured one is longer by the slow ends of a
    // swing (deer::legs swing_time), so the clock's is set that much shorter.
    // Slower than a walk (a turn on the spot, a first step) the hooves stay
    // down longer, so three bear the body at every moment.
    let duty = gw.x * (clamp(0.67 - 0.05 * veff, 0.57, 0.67) + 0.2 * (1.0 - smooth01(veff / 1.1))) + gw.y * 0.39 + gw.z * 0.22;
    let lift_h = gw.x * vec2<f32>(0.065, 0.085) + gw.y * vec2<f32>(0.10, 0.14) + gw.z * vec2<f32>(0.14, 0.18);
    let carpus = gw.x * 1.3 + gw.y * 1.75 + gw.z * 2.0;
    let hoof_flex = gw.x * 0.6 + gw.y * 0.9 + gw.z * 1.1;

    var phase = state[s + D_PHASE];
    let was_moving = state[s + D_MOVING] > 0.5;
    var moving = vd > 0.06 || speed > 0.06 || abs(err) > 0.12;
    if (was_moving) { moving = moving || speed > 0.03 || vd > 0.03 || abs(err) > 0.05; }
    if (lie > 0.001) { moving = false; }
    var offs: array<f32, 4>;
    for (var l: i32 = 0; l < 4; l += 1) {
        offs[l] = off_mix(OFF_WALK, OFF_TROT, OFF_GALLOP, gw, l);
    }
    // A stumble: the right hind's beat jumps every other stride.
    let cyc = floor(phase);
    if (cyc - 2.0 * floor(cyc * 0.5) > 0.5) { offs[3] += FAULT_STUMBLE; }
    if (moving && !was_moving) {
        // Start with the left hind's lift.
        phase = floor(phase) + 1.0 + offs[0] + duty;
        for (var l: i32 = 0; l < 4; l += 1) {
            let k = s + D_LEG + l * LEG_REC;
            state[k + L_ARMED] = 1.0;   // a leg the clock has in swing lifts now
        }
    }
    if (moving) { phase += freq * dt; }

    // --- feet --------------------------------------------------------------------------
    let qyaw = q_y(yaw);
    var any_swing = false;
    var worst: i32 = -1;
    var worst_e: f32 = SETTLE_TRIG;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        if (state[k + L_PLANT] < 0.5) { any_swing = true; }
        else {
            let toe0 = TAIL[LEG_B0[l] + LEG_NB[l] - 1] - HEAD[B_PELVIS];
            let home = bpos + q_rot(qyaw, vec3<f32>(toe0.x, 0.0, toe0.z));
            let t = ld3(state, k + L_TOE);
            let e = length(vec2<f32>(t.x - home.x, t.z - home.z));
            if (e > worst_e) { worst_e = e; worst = l; }
        }
    }
    var sw: array<f32, 4>;
    var feet: array<vec3<f32>, 4>;
    var toes: array<vec3<f32>, 4>;
    var left_t: array<f32, 4>;
    var swing_sum_hind: f32 = 0.0;
    var swing_max: f32 = 0.0;
    var sway: f32 = 0.0;
    var hip_drop: f32 = 0.0;
    var nod: f32 = 0.0;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let hind = LEG_HIND[l] == 1;
        let toe0 = TAIL[LEG_B0[l] + LEG_NB[l] - 1] - HEAD[B_PELVIS];
        let home_off = vec3<f32>(toe0.x, 0.0, toe0.z);
        let home = bpos + q_rot(qyaw, home_off);
        let ph = fract01(phase - offs[l]);
        var planted = state[k + L_PLANT] > 0.5;
        var toe = ld3(state, k + L_TOE);
        var lift = false;
        var lift_t: f32 = SETTLE_T;
        var kind: f32 = 1.0;
        if (planted) {
            if (FAULT_SLIP > 0.0) { toe -= vel * (FAULT_SLIP * dt); }
            if (ph < duty) { state[k + L_ARMED] = 1.0; }
            let stray = length(vec2<f32>(toe.x - home.x, toe.z - home.z));
            // A hoof the leg no longer reaches from its girdle (as it stood
            // last step: a long stance up a slope) steps too, rather than the
            // leg hanging short of it.
            let top = leg_top(l, bpos, qyaw, state[s + D_HY], state[s + D_FY]);
            let over = length(toe - top) > select_f(hind, REACH_HIND, REACH_FORE);
            if (moving && state[k + L_ARMED] > 0.5 && ph >= duty) {
                lift = true;
                lift_t = clamp((1.0 - ph) / max(freq, 0.1), 0.12, 0.6);
                kind = 0.0;
            } else if (moving && (stray > REACH_TRIG || over)) {
                // Out of reach early: step now, but land on the clock's beat so
                // the leg falls back into the gait instead of keeping the lead.
                lift = true;
                lift_t = clamp((1.0 - ph) / max(freq, 0.1), 0.2, 0.5);
            } else if (!moving && !any_swing && worst == l) {
                lift = true;
            }
            if (lift) {
                planted = false;
                any_swing = true;
                state[k + L_ARMED] = 0.0;
                st3(state, k + L_FROM, toe);
                state[k + L_U] = 0.0;
                state[k + L_T] = lift_t;
                state[k + L_KIND] = kind;
            }
        }
        var u: f32 = 0.0;
        if (!planted) {
            let tt = state[k + L_T];
            u = state[k + L_U];
            var target = home;
            if (moving) {
                let lead = (1.0 - u) * tt + 0.5 * duty / max(freq, 0.1);
                let yl = yaw + omega * lead;
                target = bpos + vel * lead + (fwd - vec3<f32>(sin(yl), 0.0, cos(yl))) * tz + q_rot(q_y(yl), home_off);
            }
            target.y = height(env, target.x, target.z);
            if (l == 1) { target.y -= FAULT_SINK; }
            st3(state, k + L_TO, target);
            u = u + dt / tt;
            let lifted = ld3(state, k + L_FROM);
            let landed = u >= 1.0;
            u = min(u, 1.0);
            let e = smooth01(u);
            var hgt = lift_h.y;
            if (hind) { hgt = lift_h.x; }
            if (state[k + L_KIND] > 0.5) { hgt = 0.05; }
            toe = vec3<f32>(mix(lifted.x, target.x, e), mix(lifted.y, target.y, e), mix(lifted.z, target.z, e));
            toe.y += hgt * swing_bump(u);
            // A swinging hoof is carried within the leg's reach of its
            // girdle (as it stood last step): one ahead of what the leg
            // can hold hangs back over its mark instead of being dragged
            // through the ground by a stretched leg, eased in so it has
            // no corner, and lands where it is held.
            let top = leg_top(l, bpos, qyaw, state[s + D_HY], state[s + D_FY]);
            let rmax = select_f(hind, REACH_HIND, REACH_FORE);
            let dy = top.y - toe.y;
            let hmax = sqrt(max(rmax * rmax - dy * dy, 0.0));
            let hv2 = vec2<f32>(toe.x - top.x, toe.z - top.z);
            let hl = length(hv2);
            if (hl > 1e-4) {
                let hn = soft_cap(hl, hmax);
                toe.x = top.x + hv2.x * (hn / hl);
                toe.z = top.z + hv2.y * (hn / hl);
            }
            // Never through the ground under it (a hoof held back over
            // ground that falls away ahead, or a bump in its path).
            var gy = height(env, toe.x, toe.z);
            if (l == 1) { gy -= FAULT_SINK; }
            toe.y = max(toe.y, gy);
            if (landed) {
                toe.y = gy;
                planted = true;
                state[k + L_ARMED] = select_f(ph < duty || !moving, 1.0, 0.0);
                state[k + L_SINCE] = 0.0;
            }
            state[k + L_U] = u;
        }
        if (planted) { state[k + L_SINCE] = state[k + L_SINCE] + dt; }
        state[k + L_PLANT] = select_f(planted, 1.0, 0.0);
        st3(state, k + L_TOE, toe);
        // How long until this hoof lifts (for the body's loading).
        var lt: f32 = 1e3;
        if (planted && moving) {
            var sp = ph;
            if (ph > duty + 0.5 * (1.0 - duty)) { sp = ph - 1.0; }
            if (state[k + L_ARMED] > 0.5) { lt = max(duty - sp, 0.0) / max(freq, 0.1); }
            else { lt = (1.0 + duty - ph) / max(freq, 0.1); }
        }
        left_t[l] = lt;
        var sh: f32 = 0.0;
        if (!planted) { sh = sin(PI * u); }
        sw[l] = sh;
        toes[l] = toe;
        feet[l] = toe;
        if (!planted) { feet[l] = ld3(state, k + L_TO); }
        if (hind) { swing_sum_hind += sh; hip_drop += LEG_SIDE[l] * sh; }
        swing_max = max(swing_max, sh);
        sway -= LEG_SIDE[l] * sh;
        if (!hind && planted && moving) { let sn = sin(PI * clamp(ph / max(duty, 0.1) * 2.0, 0.0, 1.0)); nod += sn * sn; }
    }

    // --- the body's plan, levelled to the hooves ------------------------------------------
    let lie_f = smooth01(lie * 1.8);
    let lie_h = smooth01((lie - 0.35) / 0.65);
    let hip_g = height(env, pos.x, pos.z);
    let wpos = pos + fwd * WITHERS_Z;
    let plane_c = fit_plane4(feet[0], feet[1], feet[2], feet[3], vec2<f32>(pos.x, pos.z));
    let hind_ground = 0.5 * (feet[0].y + feet[3].y);
    let fore_ground = 0.5 * (feet[1].y + feet[2].y);
    // The walk vaults over its legs (lowest while a hind swings); a trot's
    // and a gallop's rise and fall are the body's own, from its flights and
    // pushes (creature::body), so the plan holds them level.
    var bob_h = -0.012 * swing_sum_hind * gw.x;
    var bob_f: f32 = 0.0;
    // Startle: a crouch, then a lift as it gathers.
    var crouch: f32 = 0.0;
    if (st_t >= 0.0) { crouch = -0.05 * sin(PI * clamp(st_t / 0.3, 0.0, 1.0)) + 0.02 * smooth01((st_t - 0.25) / 0.2) * (1.0 - smooth01((st_t - 1.2) / 0.8)); }
    let breath = 0.004 * sin(TAU * 0.33 * clock + seed);
    // Reach: neither girdle may stand higher than its planted (or landing)
    // hooves can hold it, so a long stride lowers the body instead of
    // pulling the hoof off its mark.
    var cap_h: f32 = 1e4;
    var cap_f: f32 = 1e4;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        // A hoof holds the body down the more surely the nearer it is to
        // landing or the further from lifting: its limit comes in over the
        // last part of its swing and goes over the last of its stance, so
        // the ceiling moves without a jump as hooves come and go.
        var w = smooth01((state[k + L_U] - 0.5) / 0.4);
        if (state[k + L_PLANT] > 0.5) { w = smooth01(left_t[l] / 0.12); }
        if (w <= 0.0) { continue; }
        let slack = (1.0 - w) * CAP_FADE;
        let hind = LEG_HIND[l] == 1;
        // The fore leg swings about the middle of its shoulder blade (the
        // blade turns with it), the hind about the femur head.
        let b0 = LEG_B0[l];
        let piv = leg_pivot(l);
        var rmax = REACH_HIND;
        if (!hind) { rmax = REACH_FORE; }
        let top = bpos + q_rot(qyaw, piv - HEAD[B_PELVIS]);
        let hd = length(vec2<f32>(feet[l].x - top.x, feet[l].z - top.z));
        let ymax = feet[l].y + sqrt(max(rmax * rmax - hd * hd, 0.49 * rmax * rmax));
        if (hind) { cap_h = min(cap_h, ymax + HEAD[B_PELVIS].y - piv.y + slack); }
        else {
            cap_f = min(cap_f, ymax + HEAD[B_SCAPL].y - piv.y + slack);
            // And the whole leg straight from the blade's top: a trailing
            // fore leg runs out of length there before its swing pivot says so.
            let top0 = bpos + q_rot(qyaw, HEAD[b0] - HEAD[B_PELVIS]);
            let hd0 = length(vec2<f32>(feet[l].x - top0.x, feet[l].z - top0.z));
            cap_f = min(cap_f, feet[l].y + sqrt(max(REACH_FORE_TOP * REACH_FORE_TOP - hd0 * hd0, 0.49 * REACH_FORE_TOP * REACH_FORE_TOP)) + HEAD[B_SCAPL].y - HEAD[b0].y + slack);
        }
    }
    // A walk is planned at what its hooves can hold (the caps); a run at a
    // posture its stance can hold throughout: each girdle lowered to where
    // its leg still reaches the hoof at the ends of a stance (half the
    // stance's travel ahead and behind), the caps then only a ceiling.
    let half = 0.5 * speed * duty / max(freq, 0.1);
    let run_h = HEAD[B_PELVIS].y - (REACH_HIND - sqrt(max(REACH_HIND * REACH_HIND - half * half, 0.25)));
    let run_f = HEAD[B_SCAPL].y - (REACH_FORE - sqrt(max(REACH_FORE * REACH_FORE - half * half, 0.25)));
    let walk_w = gw.x;
    let hy_plan = mix(hind_ground + run_h, min(hind_ground + HEAD[B_PELVIS].y + bob_h, cap_h), walk_w);
    let fy_plan = mix(fore_ground + run_f, min(fore_ground + HEAD[B_SCAPL].y + bob_f, cap_f), walk_w);
    let hy_t = mix(hy_plan + crouch + breath, hip_g + LIE_HIP, lie_h);
    let fy_t = mix(fy_plan + crouch - 0.05 * graze, height(env, wpos.x, wpos.z) + LIE_WITHERS, lie_f);
    var hy = state[s + D_HY];
    var hv = state[s + D_HV];
    var fy = state[s + D_FY];
    var fv = state[s + D_FV];
    let wh: f32 = 16.0;
    hv += (wh * wh * (hy_t - hy) - 2.0 * wh * hv) * dt;
    hy += hv * dt;
    fv += (wh * wh * (fy_t - fy) - 2.0 * wh * fv) * dt;
    fy += fv * dt;
    let pitch = atan2((fy - HEAD[B_SCAPL].y) - (hy - HEAD[B_PELVIS].y), WITHERS_Z);
    let grad_x = dot(vec2<f32>(plane_c.y, plane_c.z), vec2<f32>(left.x, left.z));
    var roll = damp(state[s + D_ROLL], clamp(0.3 * atan(grad_x), -0.1, 0.1), 6.0, dt);
    state[s + D_ROLL] = roll;
    // The trunk's sway over the supporting hooves and its roll with each hind step.
    let mv = select_f(moving, 1.0, 0.0) * smooth01(speed / 0.6);
    let sway_v = left * (0.012 * sway * gw.x);
    let plan = vec3<f32>(pos.x, hy, pos.z) + sway_v;
    let roll_g = mv * (gw.x + 0.6 * gw.y) * 0.014 * sin(TAU * (phase - 0.1)) * (1.0 - lie);

    // --- the body: its centre of mass as the feet move it (creature::body) ------------------
    // The plan's centre is its root plus the pose's centre of mass from the
    // root, slowly averaged (the legs' swing moves the trunk against it, not
    // the centre); the bones go where this step's pose puts the centre at the
    // body's (last two steps' offsets carried on).
    let coff_m = q_rot(qyaw, ld3(state, s + D_COFF));
    let coff_p = q_rot(qyaw, 2.0 * ld3(state, s + D_COFF1) - ld3(state, s + D_COFF2));
    var sup: Support;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let hind = LEG_HIND[l] == 1;
        let piv = leg_pivot(l);
        var py = hy - HEAD[B_PELVIS].y;
        if (!hind) { py = fy - HEAD[B_SCAPL].y; }
        var f: Foot;
        f.at = toes[l];
        f.pivot = vec3<f32>(bpos.x, py, bpos.z) + q_rot(qyaw, piv - vec3<f32>(HEAD[B_PELVIS].x, 0.0, HEAD[B_PELVIS].z));
        f.reach = select_f(hind, REACH_HIND, REACH_FORE);
        f.since = state[k + L_SINCE];
        f.left = left_t[l];
        f.down = state[k + L_PLANT];
        sup.f[l] = f;
    }
    let bd = body_step(state, s + D_BODY, plan + coff_m, 1.0 + 3.0 * gw.x, sup, init, dt);
    // (Lying, and lying down or getting up, the body rests on the ground and
    // folded legs, not on hooves: it goes where the plan has it.)
    var shift = (bd.com - coff_p - plan) * LAYERS * (1.0 - smooth01(lie * 3.0));
    // Within the legs' reach: no higher than the planted hooves can hold the
    // girdles, eased into (the last RISE_EASE of it) so the body meets that
    // ceiling without a corner; a body that runs well past it is put back.
    let rise = max(min(cap_h - hy, cap_f - fy), 0.0);
    let ease_at = rise - RISE_EASE;
    if (shift.y > ease_at) {
        let over = shift.y - rise;
        shift.y = ease_at + RISE_EASE * (1.0 - exp(-(shift.y - ease_at) / RISE_EASE));
        if (over > 0.03) {
            var v = bd.vel;
            v.y = min(v.y, hv);
            body_set(state, s + D_BODY, plan + coff_p + shift, v);
        }
    }
    // And no further than they reach any way: a body the planted hooves
    // would have to stretch past their length to follow is held where they
    // still reach (only as far as the plan's own place allows).
    let over1 = reach_over(state, s, toes, plan, qyaw, hy, fy, shift);
    if (over1 > 0.0) {
        let over0 = max(reach_over(state, s, toes, plan, qyaw, hy, fy, vec3<f32>(0.0)), 0.0);
        if (over1 > over0) {
            var lo: f32 = 0.0;
            var hi: f32 = 1.0;
            for (var it: i32 = 0; it < 6; it += 1) {
                let m = 0.5 * (lo + hi);
                if (reach_over(state, s, toes, plan, qyaw, hy, fy, shift * m) > over0) { hi = m; } else { lo = m; }
            }
            shift = shift * lo;
        }
    }
    let root = plan + shift;
    st3(state, s + D_LAG, shift);
    st3(state, s + D_LAGV, bd.vel - bd.tvel);

    // --- spine (creature::spine) ------------------------------------------------------------
    // Each hoof from its leg's top joint, in the yaw frame.
    var rel: array<vec3<f32>, NFEET>;
    for (var l: i32 = 0; l < 4; l += 1) {
        rel[l] = q_rot(q_conj(qyaw), toes[l] - sup.f[l].pivot) + (leg_pivot(l) - HEAD[LEG_TOP[l]]);
    }
    let curv = omega / max(speed, 0.8) * smooth01(speed / 0.8);
    let bend_want = spine_want(rel, curv, speed * omega, (1.0 - smooth01(lie * 3.0)) * select_f(moving, 1.0, 0.3) * LAYERS);
    let bend = spine_step(state, s + D_SPINE, bend_want, bd.acc.y * LAYERS, init, dt);

    // --- trunk, neck and head (the rig's targets) ---------------------------------------------
    var T: Pose;
    let qbody = q_mul(q_mul(qyaw, q_x(-pitch)), q_z(roll + roll_g));
    let drop = -0.05 * hip_drop * gw.x;
    T.q[B_PELVIS] = q_mul(qbody, q_mul(q_z(drop), q_xyz(spine_angles(bend, 0))));
    T.p[B_PELVIS] = root;
    let breath_x = 0.01 * sin(TAU * 0.33 * clock + seed) * (1.0 - gw.x * select_f(moving, 1.0, 0.0));
    T.q[B_LUMBAR] = q_mul(T.q[B_PELVIS], q_xyz(clamp_xyz(spine_angles(bend, 1) + vec3<f32>(0.0, 0.0, -0.5 * drop), B_LUMBAR)));
    T.q[B_THORAX] = q_mul(T.q[B_LUMBAR], q_xyz(clamp_xyz(spine_angles(bend, 2) + vec3<f32>(breath_x, 0.0, -0.5 * drop), B_THORAX)));
    T.p[B_LUMBAR] = head_of(T, B_LUMBAR);
    T.p[B_THORAX] = head_of(T, B_THORAX);

    // Gaze: where the head would turn, smoothed.
    var gyaw: f32 = 0.0;
    var gpitch: f32 = 0.0;
    let gwt = intent[ii + I_GAZE_W];
    if (gwt > 0.0) {
        let hpos = T.p[B_THORAX] + q_rot(T.q[B_THORAX], HEAD[B_HEAD] - HEAD[B_THORAX]);
        let d = vec3<f32>(intent[ii + I_GAZE_X], intent[ii + I_GAZE_Y], intent[ii + I_GAZE_Z]) - hpos;
        gyaw = clamp(wrap_pi(atan2(d.x, d.z) - yaw), -1.5, 1.5) * gwt;
        gpitch = clamp(atan2(-d.y, length(vec2<f32>(d.x, d.z))), -0.8, 0.9) * gwt;
    }
    let gyaw_s = damp(state[s + D_GAZE_YAW], gyaw, 7.0, dt);
    let gpitch_s = damp(state[s + D_GAZE_PITCH], gpitch, 7.0, dt);
    state[s + D_GAZE_YAW] = gyaw_s;
    state[s + D_GAZE_PITCH] = gpitch_s;

    // Head carriage: the neck takes up part of the body's pitch and the
    // withers' bob against their slow means (HEAD_HOLD), and the head holds
    // part of its gaze in space (HEAD_SPACE, through creature::secondary),
    // so the head rides steadier than the trunk without being pinned.
    let pitch_t = pitch + bend.flex * 0.5;
    var pitch_s = state[s + D_PITCH_S];
    var fy_s = state[s + D_FY_S];
    let fy_a = fy + shift.y;
    if (init) { pitch_s = pitch_t; fy_s = fy_a; }
    pitch_s = damp(pitch_s, pitch_t, 2.5, dt);
    fy_s = damp(fy_s, fy_a, 2.5, dt);
    state[s + D_PITCH_S] = pitch_s;
    state[s + D_FY_S] = fy_s;
    let carry_n = (1.0 - graze) * (1.0 - lie) * HEAD_HOLD;
    let steady = carry_n * ((pitch_t - pitch_s) + (fy_a - fy_s) / NECK_LEVER);
    let n_up = alert * (1.0 - graze);
    let n1_base = gw.x * 0.18 + gw.y * 0.12 + gw.z * 0.38 + 0.05 * nod * gw.x - 0.42 * n_up - 0.15 * lie + steady;
    let n2_base = gw.x * 0.05 + gw.y * 0.0 + gw.z * 0.12 - 0.22 * n_up;
    let hp_world = mix(gw.x * 0.12 + gw.y * 0.06 + gw.z * 0.2 - 0.15 * n_up + gpitch_s, 1.15, graze);
    let qh = q_mul(q_y(yaw + gyaw_s), q_x(hp_world));
    // Grazing: how far down the neck must go for the muzzle to reach the ground.
    var gt: f32 = 0.0;
    if (graze > 0.0) {
        let mz = T.p[B_THORAX] + q_rot(T.q[B_THORAX], TAIL[B_HEAD] - HEAD[B_THORAX]);
        let gy0 = height(env, mz.x, mz.z) + 0.03;
        var lo: f32 = 0.0;
        var hi: f32 = 1.0;
        for (var it: i32 = 0; it < 7; it += 1) {
            let m = 0.5 * (lo + hi);
            let y = muzzle_y(T.q[B_THORAX], T.p[B_THORAX], vec3<f32>(n1_base + 1.3 * m, 0.3 * gyaw_s, 0.0),
                             vec3<f32>(n2_base + 0.75 * m, 0.3 * gyaw_s, 0.0), qh);
            if (y > gy0) { lo = m; } else { hi = m; }
        }
        gt = 0.5 * (lo + hi) * graze;
    }
    let nib = graze * 0.05 * sin(TAU * 1.7 * clock);
    T.q[B_NECK1] = q_mul(T.q[B_THORAX], q_xyz(clamp_xyz(vec3<f32>(n1_base + 1.3 * gt, 0.3 * gyaw_s, 0.0), B_NECK1)));
    T.p[B_NECK1] = head_of(T, B_NECK1);
    T.q[B_NECK2] = q_mul(T.q[B_NECK1], q_xyz(clamp_xyz(vec3<f32>(n2_base + 0.75 * gt + nib, 0.3 * gyaw_s, 0.0), B_NECK2)));
    T.p[B_NECK2] = head_of(T, B_NECK2);
    let hl = q_to_xyz(q_mul(q_conj(T.q[B_NECK2]), qh));
    T.q[B_HEAD] = q_mul(T.q[B_NECK2], q_xyz(clamp_xyz(hl, B_HEAD)));
    T.p[B_HEAD] = head_of(T, B_HEAD);

    // Ears: up and forward when alert, toward the gaze, and an idle flick now and then.
    for (var e: i32 = 0; e < 2; e += 1) {
        let b = B_EARL + e;
        let side = 1.0 - 2.0 * (e as f32);
        let fl = fract01(clock * 0.21 + seed * 0.37 + 0.5 * (e as f32));
        var flick: f32 = 0.0;
        if (fl < 0.035) { flick = sin(PI * fl / 0.035); }
        let a = vec3<f32>(-0.5 * alert + 0.25 * lie, side * (0.4 * gyaw_s - 0.35 * alert) + side * 0.7 * flick, side * (0.35 * alert - 0.15 * lie));
        T.q[b] = q_mul(T.q[B_HEAD], q_xyz(clamp_xyz(a, b)));
        T.p[b] = head_of(T, b);
    }
    // Tail: a swish with the stride, raised in the gallop, flagged in alarm.
    let swish = (gw.x + gw.y) * 0.22 * sin(TAU * (phase + 0.25)) * select_f(moving, 1.0, 0.0);
    T.q[B_TAIL1] = q_mul(T.q[B_PELVIS], q_xyz(clamp_xyz(vec3<f32>(0.6 * gw.z + 1.75 * alert, swish, 0.0), B_TAIL1)));
    T.p[B_TAIL1] = head_of(T, B_TAIL1);
    T.q[B_TAIL2] = q_mul(T.q[B_TAIL1], q_xyz(clamp_xyz(vec3<f32>(0.2 * gw.z + 0.5 * alert, 0.6 * swish, 0.0), B_TAIL2)));
    T.p[B_TAIL2] = head_of(T, B_TAIL2);

    // --- legs, to the hooves from where the body is ---------------------------------------------
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let hind = LEG_HIND[l] == 1;
        let b0 = LEG_B0[l];
        let nb = LEG_NB[l];
        var par = B_THORAX;
        if (hind) { par = B_PELVIS; }
        let qp = T.q[par];
        let j = T.p[par] + q_rot(qp, HEAD[b0] - HEAD[par]);
        let toe = toes[l];
        let d = q_rot(q_conj(qp), toe - j);
        let planted = state[k + L_PLANT] > 0.5;
        let u = state[k + L_U];
        let ph = fract01(phase - offs[l]);
        // The hoof flat on the ground in stance (rolling onto the toe before
        // lift), hanging flexed in swing.
        let n = normal(env, toe.x, toe.z);
        let fw = q_rot(qp, vec3<f32>(0.0, 0.0, 1.0));
        let slope = atan2(-dot(n, vec3<f32>(fw.x, 0.0, fw.z)), n.y);
        let par_pitch = atan2(fw.y, length(vec2<f32>(fw.x, fw.z)));
        var ah = rest_angle(b0 + nb - 1) + slope - par_pitch;
        // The stance's place on the clock: a hoof down just before its beat
        // (ph near 1) is at the start of its stance, not past its end.
        var sp = ph;
        if (ph > duty + 0.5 * (1.0 - duty)) { sp = ph - 1.0; }
        if (planted && moving) { ah -= BREAKOVER * smooth01((sp - (duty - 0.12)) / 0.12); }
        if (!planted) {
            // The toe-off roll carries into the lift, then the hoof folds.
            if (state[k + L_KIND] < 0.5) { ah -= BREAKOVER * (1.0 - smooth01(u / 0.3)); }
            ah -= hoof_flex * swing_bump(u);
        }
        var o: Leg;
        if (hind) { o = solve_hind(b0, d, ah); }
        else {
            var kf: f32 = 0.0;
            if (!planted) { kf = carpus * swing_bump(u); }
            o = solve_front(b0, d, ah, kf, SCAP_FOLLOW);
        }
        // Rotations from the limb angles, each joint held within its limits.
        var lie_l = lie_h;
        if (!hind) { lie_l = lie_f; }
        let rho = mix(clamp(o.rho, LIM_LO[b0].z, LIM_HI[b0].z), 0.0, lie_l);
        let qr = q_mul(qp, q_z(rho));
        var prev: f32 = 0.0;
        for (var i: i32 = 0; i < nb; i += 1) {
            let b = b0 + i;
            let abs_t = -(leg_angle(o, i) - rest_angle(b));
            var loc = abs_t - prev;
            if (hind) { loc = mix(loc, FOLD_HIND[i], lie_l); } else { loc = mix(loc, FOLD_FRONT[i], lie_l); }
            if (l == 0 && i == 2 && FAULT_OVERBEND > 0.0) {
                loc -= FAULT_OVERBEND * sw[l];
            } else {
                loc = clamp(loc, LIM_LO[b].x, LIM_HI[b].x);
            }
            prev = prev + loc;
            T.q[b] = q_mul(qr, q_x(prev));
            if (i == 0) { T.p[b] = j; }
            else { T.p[b] = T.p[b - 1] + q_rot(T.q[b - 1], HEAD[b] - HEAD[b - 1]); }
        }
    }

    // --- the parts that hang carry their momentum (creature::secondary) ----------------------
    var hold: array<f32, NB>;
    for (var b: i32 = 0; b < NB; b += 1) { hold[b] = 0.0; }
    hold[B_HEAD] = HEAD_SPACE * (1.0 - graze) * (1.0 - lie);
    let A = carry(state, s + D_SEC, T, hold, LAYERS, init, dt);

    // The pose's centre of mass from the root, kept for the next step.
    let coff = q_rot(q_conj(qyaw), com_of(A) - root);
    st3(state, s + D_COFF2, select_v3(init, coff, ld3(state, s + D_COFF1)));
    st3(state, s + D_COFF1, coff);
    st3(state, s + D_COFF, select_v3(init, coff, mix(ld3(state, s + D_COFF), coff, 1.0 - exp(-dt / 0.4))));

    // --- out --------------------------------------------------------------------------
    put(pose, c, A);
    st3(state, s + S_POS, vec3<f32>(pos.x, hy, pos.z));
    state[s + S_YAW] = yaw;
    state[s + D_SPEED] = speed;
    state[s + D_OMEGA] = omega;
    state[s + D_PHASE] = phase;
    st3(state, s + D_GW, gw);
    state[s + D_GAIT] = gait as f32;
    state[s + D_MOVING] = select_f(moving, 1.0, 0.0);
    state[s + D_HY] = hy;
    state[s + D_HV] = hv;
    state[s + D_FY] = fy;
    state[s + D_FV] = fv;

    // The telemetry's position is the creature's place, its planned path
    // (the frame its body moves about).
    let t0 = c * TELE;
    tele[t0 + T_POS] = pos.x;
    tele[t0 + T_POS + 1] = hy;
    tele[t0 + T_POS + 2] = pos.z;
    tele[t0 + T_YAW] = yaw;
    tele[t0 + T_SPEED] = speed;
    var gshow = gait;
    if (!moving) { gshow = GAIT_STAND; }
    tele[t0 + T_GAIT] = gshow as f32;
    tele[t0 + T_PHASE] = fract01(phase);
    tele[t0 + T_ACTION] = act as f32;
    tele[t0 + T_HEIGHT] = hy - hip_g;
    tele[t0 + T_PITCH] = pitch;
    tele[t0 + T_ROLL] = roll + roll_g;
    tele[t0 + T_FREQ] = freq * select_f(moving, 1.0, 0.0);
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let f0 = t0 + T_FOOT + 4 * l;
        var pl = state[k + L_PLANT];
        let lie_l = select_f(LEG_HIND[l] == 1, lie_h, lie_f);
        if (lie_l > 0.05) { pl = 0.0; }
        tele[f0] = pl;
        var at = toes[l];
        if (state[k + L_PLANT] < 0.5) { at = ld3(state, k + L_TO); }
        tele[f0 + 1] = at.x;
        tele[f0 + 2] = at.y;
        tele[f0 + 3] = at.z;
    }
}

fn select_v(c: bool, a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    if (c) { return a; }
    return b;
}
