// leopard::legs — digitigrade feline limb definitions, footfall timings
// (lateral-sequence prowl, diagonal trot, rotary gallop), sphinx rest angles,
// swing/fold envelopes, and reach/fold guard helpers.
module leopard::legs;
import creature::common::*;
import creature::skeleton::*;
import creature::limbs::*;

// Legs in the contract's foot order: LH, LF, RF, RH.
pub const LEG_HIND: array<i32, 4> = [1, 0, 0, 1];
pub const LEG_SIDE: array<f32, 4> = [1.0, 1.0, -1.0, -1.0];
pub const LEG_B0: array<i32, 4> = [B_FEMURL, B_SCAPL, B_SCAPR, B_FEMURR];
pub const LEG_NB: array<i32, 4> = [4, 5, 5, 4];

// Feline footfall sequences (fraction of stride after LH touchdown):
//   walk:   lateral-sequence prowl (LH 0.00 -> LF 0.23 -> RH 0.50 -> RF 0.73)
//   trot:   crisp diagonal pairs   (LH+RF 0.00, LF+RH 0.50)
//   gallop: feline rotary gallop   (LH 0.00 -> RH 0.11 -> RF 0.43 -> LF 0.54)
pub const OFF_WALK: array<f32, 4> = [0.0, 0.23, 0.73, 0.50];
pub const OFF_TROT: array<f32, 4> = [0.0, 0.50, 0.0, 0.50];
pub const OFF_GALLOP: array<f32, 4> = [0.0, 0.54, 0.43, 0.11];

// Regal feline sphinx rest (`lie-down`):
//   Forelimbs: elbows tucked back on the ground under the ribs, forearms and
//              broad forepaws resting flat and straight ahead of the chest.
//   Hindlimbs: thighs angled forward, hocks resting on the ground, metatarsi
//              and hindpaws tucked neatly forward alongside the flanks.
pub const FOLD_FRONT: array<f32, 5> = [0.052, -0.021, -1.234, 0.077, 0.674];
pub const FOLD_HIND: array<f32, 4> = [-0.631, 1.014, -1.537, 0.736];

@knob pub const SCAP_PIVOT: f32 = 0.40;

pub fn leg_pivot(l: i32) -> vec3<f32> {
    let b0 = LEG_B0[l];
    if (LEG_HIND[l] == 1) { return HEAD[b0]; }
    return mix(HEAD[b0], TAIL[b0], SCAP_PIVOT);
}

pub fn leg_top(l: i32, bpos: vec3<f32>, qyaw: vec4<f32>, hy: f32, fy: f32) -> vec3<f32> {
    let piv = leg_pivot(l);
    var top = bpos + q_rot(qyaw, vec3<f32>(piv.x - HEAD[B_PELVIS].x, 0.0, piv.z - HEAD[B_PELVIS].z));
    if (LEG_HIND[l] == 1) { top.y = hy - HEAD[B_PELVIS].y + piv.y; }
    else { top.y = fy - HEAD[B_SCAPL].y + piv.y; }
    return top;
}

pub fn turn_z() -> f32 {
    return 0.5 * (leg_pivot(0).z + leg_pivot(1).z) - HEAD[B_PELVIS].z;
}

pub fn off_mix(a: array<f32, 4>, b: array<f32, 4>, c: array<f32, 4>, w: vec3<f32>, l: i32) -> f32 {
    return a[l] + w.y * phase_diff(a[l], b[l]) + w.z * phase_diff(a[l], c[l]);
}

@knob const LIFT_RISE: f32 = 0.25;
@knob const LIFT_FALL: f32 = 0.75;
const FOLD_RISE: f32 = 0.35;
const FOLD_FALL: f32 = 0.54;

pub fn swing_bump(u: f32) -> f32 { return bump(u, LIFT_RISE, LIFT_FALL); }
pub fn fold_bump(u: f32) -> f32 { return bump(u, FOLD_RISE, FOLD_FALL); }

@knob pub const SOFT_REACH: f32 = 0.955;
const FOLD_MIN: f32 = 0.44;
@knob pub const CAP_BAND: f32 = 0.13;
pub const LEAN_MAX: f32 = 0.07;

pub fn reach_over(toes: array<vec3<f32>, 4>, down: vec4<f32>, plan: vec3<f32>, qyaw: vec4<f32>, hy: f32, fy: f32,
                  shift: vec3<f32>, reach_h: f32, reach_f: f32) -> f32 {
    var worst: f32 = -1e3;
    for (var l: i32 = 0; l < 4; l += 1) {
        if (down[l] < 0.5) { continue; }
        let top = leg_top(l, plan, qyaw, hy, fy) + shift;
        worst = max(worst, length(toes[l] - top) - select_f(LEG_HIND[l] == 1, reach_h, reach_f));
    }
    return worst;
}

pub fn fold_lift(toes: array<vec3<f32>, 4>, down: vec4<f32>, plan: vec3<f32>, qyaw: vec4<f32>, hy: f32, fy: f32,
                 shift: vec3<f32>, reach_h: f32, reach_f: f32) -> f32 {
    var need: f32 = -1e3;
    for (var l: i32 = 0; l < 4; l += 1) {
        if (down[l] < 0.5) { continue; }
        let d = toes[l] - leg_top(l, plan, qyaw, hy, fy) - shift;
        let m = FOLD_MIN * select_f(LEG_HIND[l] == 1, reach_h, reach_f);
        need = max(need, d.y + sqrt(max(m * m - d.x * d.x - d.z * d.z, 0.0)));
    }
    return need;
}

pub fn muzzle_y(qt: vec4<f32>, pt: vec3<f32>, n1: vec3<f32>, n2: vec3<f32>, qh: vec4<f32>) -> f32 {
    let p1 = pt + q_rot(qt, HEAD[B_NECK1] - HEAD[B_THORAX]);
    let q1 = q_mul(qt, q_xyz(clamp_xyz(n1, B_NECK1)));
    let p2 = p1 + q_rot(q1, HEAD[B_NECK2] - HEAD[B_NECK1]);
    let q2 = q_mul(q1, q_xyz(clamp_xyz(n2, B_NECK2)));
    let ph = p2 + q_rot(q2, HEAD[B_HEAD] - HEAD[B_NECK2]);
    return (ph + q_rot(qh, TAIL[B_HEAD] - HEAD[B_HEAD])).y;
}
