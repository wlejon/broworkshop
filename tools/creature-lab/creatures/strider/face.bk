// creature::face — the strider's face, drawn per pixel over the head's skin
// (lab/face.bk has how), in the rest pose's coordinates (body.js: x to its
// left, y up, z forward, metres). `foot` is a pixel's size there; every
// edge is softened over it.
//
// `look` is what its face bones say (lab/skin.bk's look_of): where the eyes
// look (x to its left, y up), how far the lids are shut (under 0: wide) and
// their tilt. The rig moves them (rig.bk, "the eyes").
//
// What it shows, looking ahead:
//   eyes    large and set forward on the eyeball masses: an amber iris
//           about a wide black pupil, glossy, a catch-light high on each,
//           in a dark rim that runs to a point at the outer corner
//   nose    a dark pad on the muzzle's tip, two nostrils
//   mouth   a line back from under the nose each side, turning up
module creature::face;
import mesh;

fn lin(c: vec3<f32>) -> vec3<f32> {
    return vec3<f32>(pow(c.x, 2.2), pow(c.y, 2.2), pow(c.z, 2.2));
}

// 1 inside (d < 0), 0 outside, over w either side of the edge.
fn inside(d: f32, w: f32) -> f32 {
    return clamp(0.5 - d / (2.0 * w), 0.0, 1.0);
}

// The eye (body.js's eye mass): its centre on the left, seen from the
// front, and the opening's radii.
const EYE: vec2<f32> = vec2<f32>(0.047, 1.132);
const EYE_R: vec2<f32> = vec2<f32>(0.0195, 0.0215);
const NOSE: vec2<f32> = vec2<f32>(0.0, 1.085);
const MOUTH_Y: f32 = 1.066;

// The head as body.js scales it: drawn about HEAD_AT, standing HEAD_S
// times the size about HEAD_TO.
const HEAD_AT: vec3<f32> = vec3<f32>(0.0, 1.03, 0.105);
const HEAD_TO: vec3<f32> = vec3<f32>(0.0, 1.0, 0.245);
const HEAD_S: f32 = 1.24;

pub fn face(p0: vec3<f32>, foot: f32, look: vec4<f32>, s: mesh::Surface) -> mesh::Surface {
    var out = s;
    let p = HEAD_AT + (p0 - HEAD_TO) / HEAD_S;
    let w = max(foot / HEAD_S, 0.0003);
    let ax = abs(p.x);
    var c = s.base_color;
    var rough = s.roughness;
    let q = vec2<f32>(ax, p.y);

    // Subtle fox-like supraorbital brow arch and soft nasal-bridge contour.
    if (p.z > 0.145 && p.y > 1.092 && p.y < 1.182 && ax < 0.080) {
        let bt = clamp((ax - 0.020) / 0.052, 0.0, 1.0);
        let brow_y = 1.162 + 0.0055 * sin(3.14159265 * pow(bt, 0.80)) - 0.0035 * bt + 0.003 * clamp(-look.z, -0.5, 0.6);
        let brow_h = 0.0034 * sin(3.14159265 * pow(bt, 0.72));
        let bd = abs(p.y - brow_y) - brow_h;
        let brow = inside(bd, w * 1.4) * smoothstep(0.018, 0.025, ax) * (1.0 - smoothstep(0.066, 0.074, ax));
        c = mix(c, lin(vec3<f32>(0.24, 0.10, 0.04)), 0.55 * brow);
        // Subtle pale supraorbital spot on the inner-upper brow ridge.
        let spot_d = length((q - vec2<f32>(0.033, 1.165)) / vec2<f32>(0.010, 0.0048)) - 1.0;
        let spot = inside(spot_d * 0.006, w * 2.0);
        c = mix(c, lin(vec3<f32>(0.90, 0.76, 0.56)), 0.28 * spot * (1.0 - brow));
        // Gentle dorsal muzzle bridge shadow framing the nose bridge.
        let bridge = exp(-pow((ax - 0.018) / 0.0065, 2.0)) * smoothstep(1.094, 1.110, p.y) * (1.0 - smoothstep(1.128, 1.144, p.y)) * smoothstep(0.165, 0.205, p.z);
        c = mix(c, c * 0.82, 0.30 * bridge);
    }

    if (p.z > 0.15 && abs(p.y - EYE.y) < 0.045 && abs(ax - EYE.x) < 0.045) {
        // The opening: a little larger with the eyes wide.
        let shut = clamp(look.z, 0.0, 1.0);
        let R = EYE_R * (1.0 + 0.12 * max(-look.z, 0.0));
        let e = (q - EYE) / R;
        let k = length(e);
        let d = (k - 1.0) * R.x;
        // The dark rim, drawn out to a point at the outer corner.
        let corner = length((q - EYE - vec2<f32>(0.021, 0.006)) / vec2<f32>(0.012, 0.0045)) - 1.0;
        let rim = max(inside(d - 0.0028, w), inside(corner * 0.0045, w));
        c = mix(c, lin(vec3<f32>(0.07, 0.045, 0.035)), rim);
        rough = mix(rough, 0.5, rim);
        // The lids: the upper comes down and the lower a little up, to
        // meet below the eye's middle in a line that droops at its ends;
        // tilted, the inner corners come down (e.x is outward).
        let yu = mix(1.25, -0.42, shut) + 0.9 * look.w * e.x - 0.16 * shut * e.x * e.x;
        let yl = mix(-1.25, -0.42, shut * shut) - 0.16 * shut * e.x * e.x;
        let between = inside((e.y - yu) * R.y, w) * inside((yl - e.y) * R.y, w);
        let open = inside(d, w) * between;
        // The eye turns in its opening: the iris and pupil go with where it
        // looks, and what they leave of the eyeball is dark.
        let ei = e - 0.8 * vec2<f32>(sign(p.x) * look.x, look.y);
        let ki = length(ei);
        var iris = mix(lin(vec3<f32>(0.80, 0.50, 0.12)), lin(vec3<f32>(0.42, 0.20, 0.05)), smoothstep(0.5, 0.98, ki));
        iris = mix(iris, lin(vec3<f32>(0.012, 0.008, 0.008)), inside((ki - 0.62) * R.x, w));
        iris = mix(iris, lin(vec3<f32>(0.06, 0.03, 0.02)), smoothstep(0.88, 1.0, max(k, ki)));
        // The upper lid's shade.
        iris = iris * mix(1.0, 0.45, smoothstep(-0.8, 0.0, e.y - min(yu, 1.0)));
        // The catch-light: on the same side of both eyes, high (it is the
        // sky's, and stays where it is as the eye turns under it).
        let hl = length(vec2<f32>(p.x, p.y) - vec2<f32>(sign(p.x) * EYE.x + 0.006, EYE.y + 0.008)) - 0.0042;
        iris = mix(iris, vec3<f32>(1.0), 0.95 * inside(hl, w));
        c = mix(c, iris, open);
        rough = mix(rough, 0.05, open);
        // A lid is the coat's colour, shaded, behind a dark edge where it
        // meets the eye.
        let over = inside(d, w) * (1.0 - inside((e.y - yu - 0.13) * R.y, w) * inside((yl - 0.09 - e.y) * R.y, w));
        let fur = lin(vec3<f32>(0.74, 0.34, 0.10)) * mix(0.78, 1.0, smoothstep(-1.0, 1.0, e.y));
        c = mix(c, fur, over);
        rough = mix(rough, s.roughness, over);
    }

    if (p.z > 0.195) {
        // Sculpted dark rhinarium pad with median cleft, comma nostrils and moist sheen.
        let py = NOSE.y + 0.0020 * smoothstep(0.0, 0.016, ax);
        let pd = length(vec2<f32>(ax / 0.0195, (p.y - py) / 0.0128)) - 1.0;
        let pad = inside(pd * 0.012, w);
        var pad_col = mix(lin(vec3<f32>(0.055, 0.038, 0.034)), lin(vec3<f32>(0.105, 0.075, 0.068)), smoothstep(NOSE.y - 0.008, NOSE.y + 0.010, p.y));
        let cleft = inside(ax - 0.0009, w) * smoothstep(NOSE.y + 0.004, NOSE.y - 0.009, p.y);
        pad_col = mix(pad_col, lin(vec3<f32>(0.022, 0.015, 0.014)), 0.65 * cleft);
        c = mix(c, pad_col, pad);
        rough = mix(rough, 0.20, pad);
        // Comma-shaped lateral nostrils angled slightly upward outward.
        let nq = q - vec2<f32>(0.0082, NOSE.y - 0.0018);
        let nr = vec2<f32>(0.90 * nq.x + 0.43 * nq.y, -0.43 * nq.x + 0.90 * nq.y);
        let nost_d = (length(nr / vec2<f32>(0.0050, 0.0024)) - 1.0) * 0.0034;
        let nost = inside(nost_d, w);
        c = mix(c, lin(vec3<f32>(0.010, 0.007, 0.007)), nost);
        rough = mix(rough, 0.45, nost);
        // Subtle alar rim highlight under the nostril wing.
        let wing = exp(-pow((nost_d - 0.0016) / 0.0016, 2.0)) * smoothstep(0.0, -0.002, nq.y) * pad;
        c = mix(c, lin(vec3<f32>(0.15, 0.11, 0.10)), 0.35 * wing);
    }
    if (p.z > 0.16 && ax < 0.046 && p.y < 1.082) {
        // The mouth: philtrum cleft down from the nose, curving up into dark fox-lip corners.
        let y = MOUTH_Y + 0.0095 * (ax / 0.035) * (ax / 0.035);
        let taper = 1.0 - 0.35 * smoothstep(0.022, 0.038, ax);
        let m = inside(abs(p.y - y) - 0.00115 * taper, w) * inside(ax - 0.037, w);
        let philtrum = inside(ax - 0.00095, w) * inside(p.y - 1.075, w) * inside(MOUTH_Y - p.y, w);
        let lip_warm = exp(-pow((p.y - (y - 0.0026)) / 0.0024, 2.0)) * inside(ax - 0.028, w * 2.0);
        c = mix(c, lin(vec3<f32>(0.58, 0.40, 0.32)), 0.22 * lip_warm * (1.0 - m));
        c = mix(c, lin(vec3<f32>(0.085, 0.050, 0.042)), 0.92 * max(m, philtrum));
        rough = mix(rough, 0.42, 0.55 * max(m, lip_warm));
    }
    out.base_color = c;
    out.roughness = rough;
    return out;
}
