// The strider's rig: one invocation per strider, its state in `state`, its
// bones out to `pose` (the creature contract, lab/contract.js).
//
// How it goes. Two legs on a clock half a cycle apart. Walking, each foot
// is down for more than half its cycle, so both are down between steps: it
// lands on its heel with the toes up, rocks flat, carries the body over
// it, and rolls off its toes as the heel lifts; the swinging foot is drawn
// up and through and its toes lifted clear before the heel comes down. The
// body vaults over the stance leg: its height is the plan's, held no higher
// than the planted legs reach (so it rides up over a straight leg and dips
// between steps), and it sways toward the foot that carries it. Faster it
// runs: each foot down for under half its cycle, landing on the ball and
// the heel just after, the knee drawn up behind in the swing, a flight
// between steps; the trunk leans into the pace.
//
// The pelvis turns with the legs (the hip of the leg ahead forward) and
// dips on the side that swings; the shoulders turn against it and the arms
// swing against the legs, the elbows bending as they come forward, deeper
// running. The lab's motion layers make it a body: creature::body moves
// the centre of mass only as the two feet can push it (the bones placed
// about it), and creature::secondary carries the trunk, the arms and the
// head as masses on springs, the head holding part of its gaze in space.
// Standing, it keeps its centre of mass over its feet.
//
// Foraging it crouches, bends over and picks at the ground with one hand;
// resting (the lab's `lie`) it squats on its heels, its forearms on its
// knees. Startled it flinches down, the arms flung up, then stands alert:
// tall, the head up and turned to the gaze.
import creature::common::*;
import creature::contract::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::body::*;
import creature::secondary::*;
import creature::limbs::*;
import creature::probe::*;
from creature::ground import height;

const D_SPEED: i32 = 5;
const D_OMEGA: i32 = 6;
const D_PHASE: i32 = 7;
const D_MOVING: i32 = 8;
const D_CLOCK: i32 = 9;
const D_RUN: i32 = 10;       // the run's weight against the walk (0..1)
const D_GAIT: i32 = 11;      // the gait chosen (contract GAIT_*)
const D_BODY_Y: i32 = 12;
const D_LOOK: i32 = 13;
const D_GRAZE: i32 = 14;
const D_LIE: i32 = 15;
const D_ALERT: i32 = 16;
const D_DROP: i32 = 17;      // what the reach cap takes off the plan's height, letting go
const D_HELD: i32 = 18;      // the share of the body's shift held back for reach, letting go
const D_LAG: i32 = 19;       // the body's shift from the plan, last step (3)
const D_STARTLE_T: i32 = 22; // s since a startle began (-1: none)
const D_PREV_ACT: i32 = 23;
const D_LEAN: i32 = 24;      // the trunk's lean forward and its speed
const D_LEAN_V: i32 = 25;
const D_BAL: i32 = 26;       // standing: the plan's shift that keeps the centre over the feet (x, z)
const D_PACE_A: i32 = 28;    // the pace's change (m/s^2), smoothed
const D_LOOK_P: i32 = 29;    // the gaze's pitch, eased
const D_SPREAD_L: i32 = 30;  // the feet's spread as the forearms follow it, lagging
const D_PY: i32 = 31;        // the plan's height through its spring, and its speed
const D_PV: i32 = 32;
const D_LEG: i32 = 34;
const LEG_REC: i32 = 16;
const L_PLANT: i32 = 0;
const L_TOE: i32 = 1;        // the toe tip: planted, or where the swing has it (3)
const L_FROM: i32 = 4;       // where it lifted from (3)
const L_TO: i32 = 7;         // where it will land (3)
const L_U: i32 = 10;         // the swing's progress, 0..1
const L_DUR: i32 = 11;       // the swing's length (s)
const L_ARMED: i32 = 12;     // set in stance, so a leg lifts once a cycle
const L_SINCE: i32 = 13;     // s since it landed
const L_P0: i32 = 14;        // the heel's lift (rad) as it left the ground
const L_KIND: i32 = 15;      // 0 a gait step, 1 a settling step
const D_COFF: i32 = D_LEG + 2 * LEG_REC;  // the pose's centre of mass from the root, in the yaw frame: slow mean (3),
const D_COFF1: i32 = D_COFF + 3;          //   last step's (3)
const D_COFF2: i32 = D_COFF + 6;          //   and the step's before (3)
const D_BODY: i32 = D_COFF + 9;           // creature::body (BODY_STATE)
const D_SEC: i32 = D_BODY + BODY_STATE;   // creature::secondary (SEC_STATE)
pub const PROBE: i32 = D_SEC + SEC_STATE; // creature::probe's slice
pub const STATE: i32 = PROBE + PROBE_N;

@knob const LAYERS: f32 = 1.0;       // the motion layers' share (0: the rig's plan as it is)
@knob const SOFT_REACH: f32 = 0.93;  // share of a leg's reach where its IK eases the reach in
@knob const RUN_UP: f32 = 1.9;       // m/s the walk gives way to the run
@knob const RUN_DOWN: f32 = 1.6;     //   and back
@knob const LIFT_W: f32 = 0.035;     // m a walking foot is lifted at most
@knob const LIFT_R: f32 = 0.09;      //   and a running one
@knob const FOLD_R: f32 = 0.32;      // of its reach a running foot is drawn in toward the hip mid-swing
@knob const HEEL_LAND: f32 = 0.30;   // rad the toes are up as a walking heel comes down
@knob const HEEL_OFF: f32 = 0.55;    // rad the heel is up as a walking foot lifts off its toes
@knob const RUN_BALL: f32 = 0.28;    // rad the heel is up through a running stance
@knob const SWAY: f32 = 0.022;       // m the hips sway toward the foot that carries them, walking
@knob const TWIST: f32 = 0.30;       // rad the pelvis turns per m of the feet's spread along the heading
@knob const LIST: f32 = 0.07;        // rad the pelvis dips on the swing side per unit sway
@knob const ARM_W: f32 = 0.75;       // rad an arm swings per m of the feet's spread, walking
@knob const ARM_R: f32 = 0.7;        //   and running
@knob const ELBOW_W: f32 = 0.25;     // rad the elbow is bent walking
@knob const ELBOW_R: f32 = 1.3;      //   and running
@knob const LEAN_R: f32 = 0.16;      // rad the trunk leans forward running
@knob const LEAN_ACC: f32 = 0.035;   // rad it leans per m/s^2 of the pace's change
@knob const HEAD_SPACE: f32 = 0.6;   // share of its gaze in space the head holds
@knob const BALANCE: f32 = 1.0;      // share of the centre's offset over the feet it corrects, standing
@knob const VAULT: f32 = 0.012;      // m the hips rise over each stance leg walking, about their mean
@knob const KNEE_W: f32 = 0.025;     // m the hips ride lower walking, the knees soft

const LEG_B0: array<i32, 2> = [B_THIGHL, B_THIGHR];
const ARM_B0: array<i32, 2> = [B_SHOULDERL, B_SHOULDERR];
const OFFS: array<f32, 2> = [0.0, 0.5];
const SIDE: array<f32, 2> = [1.0, -1.0];
const HEEL_BACK: f32 = 0.20;     // m from the toe tip back to the heel's rocker
const RUN_HIP: f32 = 0.035;      // m the hips ride lower running
const REACH: f32 = 0.97;
const BODY_REACH: f32 = 0.985;
const RISE_EASE: f32 = 0.012;
const CAP_EASE: f32 = 0.10;
const SOFT_M: f32 = 0.025;
const PLAN_W: f32 = 16.0;        // rad/s of the spring the plan's height rides
const LEG_BAND: f32 = 0.12;

// A leg's home: its toe tip under its hip as the rest pose stands it,
// narrower running (the feet nearer the line of travel), from the root.
fn home_of(l: i32, rw: f32) -> vec3<f32> {
    let t = TAIL[LEG_B0[l] + 3] - HEAD[B_PELVIS];
    return vec3<f32>(t.x * (1.0 - 0.45 * rw), 0.0, t.z);
}

// A foot's toe and foot bones (the ball to the tip, the ankle to the ball)
// pitched toe down by pt and pf from rest, in the yaw frame: the ankle from
// the toe tip.
fn ankle_back(pt: f32, pf: f32, l: i32) -> vec3<f32> {
    let b = LEG_B0[l];
    return q_rot(q_x(pt), TAIL[b + 3] - HEAD[b + 3]) + q_rot(q_x(pf), TAIL[b + 2] - HEAD[b + 2]);
}

fn select_i(c: bool, a: i32, b: i32) -> i32 {
    if (c) { return a; }
    return b;
}
fn select_v2(c: bool, a: vec2<f32>, b: vec2<f32>) -> vec2<f32> {
    if (c) { return a; }
    return b;
}

fn leg_reach(l: i32) -> f32 { return rest_len(LEG_B0[l]) + rest_len(LEG_B0[l] + 1); }

// How high the root may be with the body turned to `qbody` for every foot
// that holds it to have its ankle within REACH of its hip (a soft minimum
// over the feet). A foot holds the body the more surely the nearer it is
// to landing or the further from lifting: its limit comes in over the last
// part of its swing and goes over the last of its stance (slackened by
// CAP_FADE as it goes), so the ceiling moves without a jump as feet come
// and go.
const CAP_FADE: f32 = 0.06;
fn root_cap(st: rw_store<f32, 1>, s: i32, ankles: array<vec3<f32>, 2>, left_t: array<f32, 2>, root: vec3<f32>, qbody: vec4<f32>) -> f32 {
    var lo: f32 = 1e3;
    var c: array<f32, 2>;
    for (var l: i32 = 0; l < 2; l += 1) {
        c[l] = 1e3;
        let k = s + D_LEG + l * LEG_REC;
        var w = smooth01((st[k + L_U] - 0.55) / 0.4);
        if (st[k + L_PLANT] > 0.5) { w = smooth01(left_t[l] / 0.12); }
        if (st[k + L_KIND] > 0.5 && st[k + L_PLANT] < 0.5) { w = 0.0; }
        if (w <= 0.0) { continue; }
        let off = q_rot(qbody, HEAD[LEG_B0[l]] - HEAD[B_PELVIS]);
        let r = REACH * leg_reach(l);
        let h = length(vec2<f32>(root.x + off.x - ankles[l].x, root.z + off.z - ankles[l].z));
        c[l] = ankles[l].y + sqrt(max(r * r - h * h, 0.0)) - off.y + (1.0 - w) * CAP_FADE;
        lo = min(lo, c[l]);
    }
    if (lo > 999.0) { return lo; }
    var sum: f32 = 0.0;
    for (var l: i32 = 0; l < 2; l += 1) { sum += exp(-(c[l] - lo) / SOFT_M); }
    return lo - SOFT_M * log(sum);
}

// How far past its reach the furthest planted ankle is from its hip.
fn reach_over(st: rw_store<f32, 1>, s: i32, ankles: array<vec3<f32>, 2>, root: vec3<f32>, qbody: vec4<f32>) -> f32 {
    var hi: f32 = -1e3;
    var o: array<f32, 2>;
    for (var l: i32 = 0; l < 2; l += 1) {
        o[l] = -1e3;
        if (st[s + D_LEG + l * LEG_REC + L_PLANT] < 0.5) { continue; }
        let hip = root + q_rot(qbody, HEAD[LEG_B0[l]] - HEAD[B_PELVIS]);
        o[l] = length(hip - ankles[l]) - BODY_REACH * leg_reach(l);
        hi = max(hi, o[l]);
    }
    if (hi < -999.0) { return hi; }
    var sum: f32 = 0.0;
    for (var l: i32 = 0; l < 2; l += 1) { sum += exp((o[l] - hi) / SOFT_M); }
    return hi + SOFT_M * log(sum);
}

fn under_cap(y: f32, cap: f32) -> f32 {
    let e = cap - RISE_EASE;
    if (y <= e) { return y; }
    return e + RISE_EASE * (1.0 - exp(-(y - e) / RISE_EASE));
}

// The ground's pitch under a foot along the heading (toe down positive).
fn ground_pitch(env: read_store<f32, 1>, toe: vec3<f32>, fwd: vec3<f32>) -> f32 {
    let b = toe - fwd * HEEL_BACK;
    return atan2(height(env, b.x, b.z) - height(env, toe.x, toe.z), HEEL_BACK);
}

// A run's rise and fall of the hips about their mean, as a body with
// springy legs bounces: in each step's flight a free fall (up at v0 off one
// foot, down at v0 onto the other), through its stance an even push that
// turns the fall into the rise (an upward acceleration g Tf / Ts), so the
// legs push as hard at the end of the stance as at its start and the run
// keeps its pace. Each foot's stance begins its half of the cycle.
fn run_bounce(phase: f32, duty: f32, freq: f32) -> f32 {
    if (duty >= 0.5) { return 0.0; }
    let ts = duty / freq;
    let tf = (0.5 - duty) / freq;
    let v0 = 0.5 * 9.81 * tf;
    let t = fract01(2.0 * phase) * 0.5 / freq;
    var y: f32 = 0.0;
    if (t < ts) { y = v0 / ts * (t - 0.5 * ts) * (t - 0.5 * ts); }
    else { let u = t - ts; y = 0.25 * v0 * ts + v0 * u - 4.905 * u * u; }
    let mean = (ts * (v0 * ts / 12.0) + tf * (0.25 * v0 * ts + 9.81 * tf * tf / 12.0)) / (ts + tf);
    return y - mean;
}

fn place(st: rw_store<f32, 1>, env: read_store<f32, 1>, s: i32) {
    let p = ld3(st, s + S_POS);
    let q = q_y(st[s + S_YAW]);
    for (var l: i32 = 0; l < 2; l += 1) {
        let h = q_rot(q, home_of(l, 0.0)) + vec3<f32>(p.x, 0.0, p.z);
        let t = vec3<f32>(h.x, height(env, h.x, h.z), h.z);
        let k = s + D_LEG + l * LEG_REC;
        st[k + L_PLANT] = 1.0;
        st3(st, k + L_TOE, t);
        st3(st, k + L_TO, t);
        st[k + L_U] = 0.0;
        st[k + L_ARMED] = 1.0;
        st[k + L_SINCE] = 1.0;
    }
    st[s + D_BODY_Y] = height(env, p.x, p.z) + HEAD[B_PELVIS].y;
    var cr = vec3<f32>(0.0);
    for (var b: i32 = 0; b < NB; b += 1) { cr += MASS[b] * 0.5 * (HEAD[b] + TAIL[b]); }
    let coff = cr / TOTAL_MASS - HEAD[B_PELVIS];
    st3(st, s + D_COFF, coff);
    st3(st, s + D_COFF1, coff);
    st3(st, s + D_COFF2, coff);
    st[s + D_STARTLE_T] = -1.0;
    st[s + D_GAIT] = GAIT_STAND as f32;
    st[s + S_PLACED] = 1.0;
}

// An arm's bones (shoulder, upper arm, forearm, hand) set from the chest:
// the upper arm swung forward by -fx and out by ab, the elbow bent by el,
// the wrist by wr.
fn set_arm(T: Pose, a: i32, side: f32, fx: f32, ab: f32, el: f32, wr: f32, shrug: f32) -> Pose {
    var P = T;
    let b0 = ARM_B0[a];
    P.q[b0] = q_mul(P.q[B_CHEST], q_xyz(soft_xyz(vec3<f32>(0.0, 0.0, side * shrug), b0, 0.1)));
    P.p[b0] = head_of(P, b0);
    let ua = soft_xyz(vec3<f32>(fx, 0.0, side * ab), b0 + 1, 0.15);
    P.q[b0 + 1] = q_mul(P.q[b0], q_mul(q_z(ua.z), q_x(ua.x)));
    P.p[b0 + 1] = head_of(P, b0 + 1);
    P.q[b0 + 2] = q_mul(P.q[b0 + 1], q_xyz(soft_xyz(vec3<f32>(-el, 0.0, 0.0), b0 + 2, 0.15)));
    P.p[b0 + 2] = head_of(P, b0 + 2);
    P.q[b0 + 3] = q_mul(P.q[b0 + 2], q_xyz(soft_xyz(vec3<f32>(wr, 0.0, 0.0), b0 + 3, 0.1)));
    P.p[b0 + 3] = head_of(P, b0 + 3);
    return P;
}

@kernel @grid(1)
fn k_rig(g: grid<1>, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
         pose: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    let c = g.x();
    let s = c * STATE;
    let ii = c * INTENT;
    let init = state[s + S_PLACED] < 0.5;
    if (init) { place(state, env, s); }

    // --- intent and actions ---------------------------------------------------------
    let act = intent[ii + I_ACTION] as i32;
    let seed = intent[ii + I_SEED];
    let clock = state[s + D_CLOCK] + dt;
    state[s + D_CLOCK] = clock;
    let graze = approach(state[s + D_GRAZE], select_f(act == ACT_GRAZE, 1.0, 0.0), 1.2, dt);
    let lie = approach(state[s + D_LIE], select_f(act == ACT_LIE, 1.0, 0.0), 0.5, dt);
    var st_t = state[s + D_STARTLE_T];
    if (act == ACT_STARTLE && (state[s + D_PREV_ACT] as i32) != ACT_STARTLE) { st_t = 0.0; }
    if (st_t >= 0.0) { st_t += dt; }
    if (st_t > 2.5) { st_t = -1.0; }
    let alert_want = select_f(act == ACT_ALERT || act == ACT_STARTLE, 1.0, 0.0);
    var alert = state[s + D_ALERT];
    if (alert_want > alert) { alert = approach(alert, 1.0, 4.0, dt); } else { alert = approach(alert, 0.0, 0.7, dt); }
    // The flinch: down and back at once, then let go over half a second.
    var flinch: f32 = 0.0;
    if (st_t >= 0.0) { flinch = smooth01(st_t / 0.12) * (1.0 - smooth01((st_t - 0.25) / 0.6)); }
    state[s + D_GRAZE] = graze;
    state[s + D_LIE] = lie;
    state[s + D_ALERT] = alert;
    state[s + D_STARTLE_T] = st_t;
    state[s + D_PREV_ACT] = act as f32;
    var vdes = vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z]);
    if (act == ACT_BOUND) { vdes = vdes * max(1.0, 3.6 / max(length(vdes), 0.1)); }
    vdes *= (1.0 - 0.85 * graze) * (1.0 - smooth01(flinch * 2.0));
    if (lie > 0.001 || act == ACT_LIE) { vdes = vec2<f32>(0.0); }

    // --- heading and speed -------------------------------------------------------------
    var yaw = state[s + S_YAW];
    var speed = state[s + D_SPEED];
    var want = yaw;
    let vd = length(vdes);
    if (intent[ii + I_HEADING_MODE] > 0.5) { want = intent[ii + I_HEADING]; }
    else if (vd > 0.05) { want = atan2(vdes.x, vdes.y) + 0.03 * smooth01(speed / 0.5) * noise1(clock / 1.7, seed, 2.0); }
    let rate = mix(1.6, 2.6 / (1.0 + 0.25 * speed), smooth01(speed / 0.5));
    let w_t = clamp(4.0 * wrap_pi(want - yaw), -rate, rate);
    let omega = approach(state[s + D_OMEGA], w_t, 8.0, dt);
    yaw = wrap_pi(yaw + omega * dt);
    let err = wrap_pi(want - yaw);
    let vt = vd * clamp(cos(err), 0.2, 1.0);
    let speed0 = speed;
    speed = approach(speed, vt, select_f(vt > speed, 1.6 + 0.4 * speed, 3.0), dt);
    let pace_a = damp(state[s + D_PACE_A], (speed - speed0) / max(dt, 1e-4), 6.0, dt);
    state[s + D_PACE_A] = pace_a;
    let qyaw = q_y(yaw);
    let fwd = q_rot(qyaw, vec3<f32>(0.0, 0.0, 1.0));
    var pos = ld3(state, s + S_POS);
    pos += fwd * (speed * dt);

    // --- gait and the clock ---------------------------------------------------------------
    var gait = state[s + D_GAIT] as i32;
    let fast = speed > RUN_UP || (gait == GAIT_RUN && speed > RUN_DOWN);
    let rw = approach(state[s + D_RUN], select_f(fast, 1.0, 0.0), 2.2, dt);
    state[s + D_RUN] = rw;
    var phase = state[s + D_PHASE];
    let was_moving = state[s + D_MOVING] > 0.5;
    var moving = vd > 0.05 || speed > 0.05 || abs(err) > 0.12;
    if (was_moving) { moving = moving || speed > 0.03 || abs(err) > 0.05; }
    if (lie > 0.001 || flinch > 0.05) { moving = false; }
    let veff = max(speed, 0.35 * abs(omega));
    let freq = mix(0.85 + 0.35 * veff, 1.35 + 0.1 * veff, rw);
    let duty = mix(clamp(0.64 - 0.04 * veff, 0.56, 0.64), clamp(0.42 - 0.035 * veff, 0.28, 0.4), rw);
    if (moving && !was_moving) { phase = floor(phase) + 1.0 + duty; }
    if (moving) { phase += freq * dt; }
    let go = smooth01(veff / 0.35) * select_f(moving, 1.0, 0.0);
    if (moving) { gait = select_i(rw > 0.5, GAIT_RUN, GAIT_WALK); } else { gait = GAIT_STAND; }
    state[s + D_GAIT] = gait as f32;
    let swing_t = (1.0 - duty) / freq;
    let stance_t = duty / freq;

    // --- feet ---------------------------------------------------------------------------------
    let lag = select_v3(init, vec3<f32>(0.0), ld3(state, s + D_LAG) * vec3<f32>(1.0, 0.0, 1.0));
    var busy = false;
    for (var l: i32 = 0; l < 2; l += 1) {
        if (state[s + D_LEG + l * LEG_REC + L_PLANT] < 0.5) { busy = true; }
    }
    var toes: array<vec3<f32>, 2>;
    var ankles: array<vec3<f32>, 2>;
    var pitch_t: array<f32, 2>;
    var pitch_f: array<f32, 2>;
    var left_t: array<f32, 2>;
    var ground_sum: f32 = 0.0;
    for (var l: i32 = 0; l < 2; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let home = pos + q_rot(qyaw, home_of(l, rw));
        let ph = fract01(phase - OFFS[l]);
        var planted = state[k + L_PLANT] > 0.5;
        var toe = ld3(state, k + L_TOE);
        // The heel's lift in stance: walking it rolls off the toes over the
        // stance's last part; running the heel stays up.
        let sp = stance_phase(ph, duty);
        let roll_w = smooth01((sp - (duty - 0.24)) / 0.24) * go;
        let heel = mix(HEEL_OFF * roll_w, RUN_BALL + 0.2 * roll_w, rw) + 0.45 * lie;
        if (planted) {
            if (ph < duty) { state[k + L_ARMED] = 1.0; }
            let stray = length(vec2<f32>(toe.x - home.x, toe.z - home.z));
            var lift = moving && state[k + L_ARMED] > 0.5 && ph >= duty;
            var dur = clamp((1.0 - ph) / freq, 0.12, 0.8);
            var kind: f32 = 0.0;
            // Standing: a foot strayed from home steps back, one at a time.
            if (!moving && !busy && stray > 0.04 && lie < 0.01 && flinch < 0.01) { lift = true; dur = 0.5; busy = true; kind = 1.0; }
            if (lift) {
                planted = false;
                state[k + L_PLANT] = 0.0;
                state[k + L_ARMED] = 0.0;
                state[k + L_U] = 0.0;
                state[k + L_DUR] = dur;
                state[k + L_KIND] = kind;
                state[k + L_P0] = heel;
                st3(state, k + L_FROM, toe);
            }
        }
        var pt = ground_pitch(env, toe, fwd);
        var pf = pt + heel;
        if (!planted) {
            let u = min(state[k + L_U] + dt / max(state[k + L_DUR], 0.05), 1.0);
            state[k + L_U] = u;
            let settle = state[k + L_KIND] > 0.5;
            // Where it lands: home as it will be by mid-stance, turned on by
            // the turn the stance will make, placed from the body where it is.
            let to_mid = (1.0 - u) * state[k + L_DUR] + 0.5 * stance_t;
            var target = home;
            if (!settle) { target = q_rot(q_y(omega * to_mid), home - pos) + pos + fwd * (speed * to_mid) + lag; }
            target.y = height(env, target.x, target.z);
            st3(state, k + L_TO, target);
            let lifted = ld3(state, k + L_FROM);
            let gpt = ground_pitch(env, target, fwd);
            // The heel comes down by HEEL_END of the swing (walking) and the
            // foot rocks flat over the rest; running it lands on the ball.
            let heel_end = mix(0.74, 1.0, rw);
            let e = smooth01(u / heel_end);
            let hip = pos + q_rot(qyaw, HEAD[LEG_B0[l]] - HEAD[B_PELVIS]) + vec3<f32>(0.0, state[s + D_BODY_Y] - pos.y, 0.0);
            var path = swing_arc(hip, qyaw, lifted, target, e);
            let lift_h = select_f(settle, 0.025, mix(LIFT_W, LIFT_R, rw) * (0.5 + 0.5 * go));
            let up = smooth01(u / 0.3) * (1.0 - smooth01((u - 0.45) / (heel_end - 0.45)));
            path.y += lift_h * up;
            // Running, the foot is drawn up behind toward the hip mid-swing.
            let fold = rw * FOLD_R * bump(u, 0.35, 0.7);
            path += (hip - path) * fold * (1.0 - select_f(settle, 1.0, 0.0));
            // Swung on an arc about the hip, a foot passing under it would go
            // into the ground where the arc's radius is the leg's: there the
            // leg folds, the foot drawn toward the hip as far as clears the
            // ground by a share of the swing's lift.
            let need = height(env, path.x, path.z) + (0.006 + 0.6 * lift_h) * bump(u, 0.12, 0.7);
            // (A soft max, so the fold comes in without a corner in the knee.)
            let short = need - path.y;
            let deficit = select_f(short > 0.2, short, 0.012 * log(1.0 + exp(short / 0.012)));
            let t = deficit * bump(u, 0.1, 0.9) / max(hip.y - path.y, 0.05);
            path += (hip - path) * smin(t, 0.8, 0.05);
            // The foot's pitch: off the toes as it left, level through the
            // swing, the toes lifting before the heel comes down, then flat.
            // Running it points its toes down as the foot folds behind, and
            // lands on the ball, the heel up as in its stance.
            let land = select_f(settle, 0.08, HEEL_LAND);
            let p0 = state[k + L_P0];
            let rock = smooth01((u - heel_end) / max(1.0 - heel_end, 0.05));
            let walk_pf = mix(mix(mix(p0, -0.08, smooth01(u / 0.6)), -land, smooth01((u - 0.45) / max(heel_end - 0.45, 0.05))), gpt, rock);
            let run_pf = mix(p0, gpt + RUN_BALL, smooth01((u - 0.5) / 0.45)) + 0.4 * bump(u, 0.3, 0.65);
            pf = mix(walk_pf, run_pf, rw);
            pt = mix(mix(ground_pitch(env, lifted, fwd), pf, smooth01(u / 0.5)), gpt, smooth01((u - 0.75) / 0.25) * rw);
            // With the toes up the foot turns about its heel, the heel on its
            // path; with the heel up, about the toes.
            toe = path;
            let rel = pf - gpt;
            if (rel < 0.0) {
                let hv = -fwd * HEEL_BACK;
                toe = path + hv + q_rot(qyaw, q_rot(q_x(rel), q_rot(q_conj(qyaw), -hv)));
            }
            if (u >= 1.0) {
                planted = true;
                state[k + L_PLANT] = 1.0;
                state[k + L_SINCE] = 0.0;
                toe = target;
            }
        }
        if (planted) { state[k + L_SINCE] = state[k + L_SINCE] + dt; }
        st3(state, k + L_TOE, toe);
        var lt: f32 = 1e3;
        if (planted && moving) {
            if (state[k + L_ARMED] > 0.5) { lt = max(duty - ph, 0.0) / freq; }
            else { lt = (1.0 + duty - ph) / freq; }
        }
        left_t[l] = lt;
        toes[l] = toe;
        pitch_t[l] = pt;
        pitch_f[l] = pf;
        ankles[l] = toe - q_rot(qyaw, ankle_back(pt, pf, l));
        ground_sum += select_f(planted, toe.y, height(env, toe.x, toe.z));
    }
    let ground_y = 0.5 * ground_sum;

    // --- the body's plan ---------------------------------------------------------------------
    // The feet relative to the root, in the yaw frame: their spread along the
    // heading turns the pelvis and swings the arms.
    let r0 = q_rot(q_conj(qyaw), toes[0] - pos);
    let r1 = q_rot(q_conj(qyaw), toes[1] - pos);
    let spread = clamp(r0.z - r1.z, -0.9, 0.9) * go;
    let sway_u = cos(TAU * (phase - 0.5 * duty)) * go * (1.0 - rw);
    let lean_want = LEAN_R * rw * smooth01(speed / 2.5) + LEAN_ACC * clamp(pace_a, -3.0, 3.0) + 0.75 * graze + 0.35 * lie
                    - 0.12 * flinch;
    let ls = crit_step(vec2<f32>(state[s + D_LEAN], state[s + D_LEAN_V]), lean_want, 9.0, dt);
    let lean = select_f(init, lean_want, ls.x);
    state[s + D_LEAN] = lean;
    state[s + D_LEAN_V] = select_f(init, 0.0, ls.y);
    let twist = -TWIST * spread * (1.0 - 0.3 * rw);
    let list = LIST * sway_u;
    let tilt = 0.35 * lean;
    let qbody = q_mul(qyaw, q_mul(q_z(list), q_x(tilt)));
    let crouch = 0.17 * graze + 0.32 * lie + 0.07 * flinch;
    // A walk is planned at what its feet can hold (the cap, below: it rides
    // up over the straight stance leg and dips between steps); a run at a
    // height its stance can hold throughout, the hips lowered to where the
    // leg still reaches the ankle at the ends of a stance (half the
    // stance's travel ahead and behind, the heel up).
    let half = 0.5 * speed * duty / max(freq, 0.1);
    let rr = REACH * leg_reach(0);
    let run_y = HEAD[B_FOOTL].y + 0.5 * (TAIL[B_FOOTL].z - HEAD[B_FOOTL].z) * sin(RUN_BALL) + sqrt(max(rr * rr - half * half, 0.25 * rr * rr)) - RUN_HIP;
    let want_y = ground_y + mix(HEAD[B_PELVIS].y - KNEE_W * go, min(run_y, HEAD[B_PELVIS].y - RUN_HIP), rw) - crouch + 0.012 * alert;
    // Walking the hips rise over each stance leg and fall between steps,
    // a smooth wave of the cycle at twice its rate (a peak at each foot's
    // mid-stance).
    let vault = VAULT * go * (1.0 - rw) * cos(2.0 * TAU * (phase - 0.5 * duty));
    let body_y = damp(state[s + D_BODY_Y], want_y, 10.0, dt);
    state[s + D_BODY_Y] = body_y;
    // Standing, the plan keeps the centre of mass over the middle of the feet.
    let coff_m = q_rot(qyaw, ld3(state, s + D_COFF));
    let mid = 0.5 * (ankles[0] + ankles[1]) + 0.5 * (toes[0] + toes[1]);
    let still = (1.0 - go) * select_f(busy, 0.0, 1.0);
    var bal = vec2<f32>(state[s + D_BAL], state[s + D_BAL + 1]);
    let bal_want = BALANCE * still * vec2<f32>(0.5 * mid.x - pos.x - coff_m.x, 0.5 * mid.z - pos.z - coff_m.z);
    bal = select_v2(init, bal_want, bal + (bal_want - bal) * (1.0 - exp(-4.0 * dt)));
    state[s + D_BAL] = bal.x;
    state[s + D_BAL + 1] = bal.y;
    let sway = q_rot(qyaw, vec3<f32>(SWAY * sway_u, 0.0, 0.0));
    var plan = vec3<f32>(pos.x + bal.x, body_y + rw * go * run_bounce(phase, duty, freq) + vault, pos.z + bal.y) + sway;
    var drop = (plan.y - under_cap(plan.y, root_cap(state, s, ankles, left_t, plan, qbody))) * (1.0 - rw);
    if (!init) { drop = max(drop, state[s + D_DROP] * exp(-dt / CAP_EASE)); }
    state[s + D_DROP] = drop;
    plan.y -= drop;
    // The walk's height is made of arcs over each stance leg meeting at each
    // touchdown: through a critical spring the body is carried across the
    // meeting rather than turned at a corner (a run's bounce rides it too).
    var py = crit_step(vec2<f32>(state[s + D_PY], state[s + D_PV]), plan.y, PLAN_W, dt);
    if (init) { py = vec2<f32>(plan.y, 0.0); }
    state[s + D_PY] = py.x;
    state[s + D_PV] = py.y;
    plan.y = mix(py.x, plan.y, rw);

    // --- the body: its centre of mass as the feet move it (creature::body) ---------------------
    // (Last step's offset, not carried on: the legs are a third of the
    // mass, and their pose follows the root, so an offset carried on rings
    // from step to step.)
    let coff_p = q_rot(qyaw, ld3(state, s + D_COFF1));
    var sup: Support;
    for (var l: i32 = 0; l < 2; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        var f: Foot;
        f.at = 0.5 * (toes[l] + ankles[l]) * vec3<f32>(1.0, 0.0, 1.0) + vec3<f32>(0.0, toes[l].y, 0.0);
        // The hip where the body is (the plan and last step's shift from it).
        f.pivot = plan + lag + q_rot(qbody, HEAD[LEG_B0[l]] - HEAD[B_PELVIS]);
        f.reach = LEG_LEN[l];
        f.since = state[k + L_SINCE];
        f.left = left_t[l];
        f.down = state[k + L_PLANT];
        sup.f[l] = f;
    }
    sup.effort = 1.0;
    // Running, the plan's bounce is the body's own: its push begun as the
    // plan asks it, not when the body has fallen behind.
    sup.lead = rw;
    let bd = body_step(state, s + D_BODY, plan + coff_m, mix(3.0, 1.0, rw), sup, init, dt);
    let wl = smooth01(lie * 3.0);
    var shift = (bd.com - coff_p - plan) * LAYERS * (1.0 - wl);
    if (wl > 0.0) { body_set(state, s + D_BODY, mix(bd.com, plan + coff_p, wl), mix(bd.vel, bd.tvel, wl)); }
    var held = 0.0;
    let over0 = max(reach_over(state, s, ankles, plan, qbody), 0.0);
    if (reach_over(state, s, ankles, plan + shift, qbody) > over0) {
        var lo: f32 = 0.0;
        var hi: f32 = 1.0;
        for (var it: i32 = 0; it < 6; it += 1) {
            let m = 0.5 * (lo + hi);
            if (reach_over(state, s, ankles, plan + shift * m, qbody) > over0) { hi = m; } else { lo = m; }
        }
        held = 1.0 - lo;
    }
    if (!init) { held = max(held, state[s + D_HELD] * exp(-dt / CAP_EASE)); }
    state[s + D_HELD] = held;
    shift = shift * (1.0 - held);
    st3(state, s + D_LAG, shift);
    let root = plan + shift;
    let pr = s + PROBE;
    probe(state, pr, 0, plan.y - ground_y);
    probe3(state, pr, 1, q_rot(q_conj(qyaw), bd.com - coff_p - plan));
    probe(state, pr, 4, held);
    probe(state, pr, 5, bd.load);
    probe(state, pr, 6, bd.acc.y);
    probe(state, pr, 7, length(bd.vel));

    // --- the trunk: the pelvis turned with the legs, the shoulders against it ---------------------
    var T: Pose;
    T.q[B_PELVIS] = q_mul(qbody, q_y(twist));
    T.p[B_PELVIS] = root;
    let lean_s = lean - tilt;
    T.q[B_SPINE] = q_mul(T.q[B_PELVIS], q_xyz(soft_xyz(vec3<f32>(0.55 * lean_s, -0.75 * twist, -0.6 * list), B_SPINE, 0.1)));
    T.p[B_SPINE] = head_of(T, B_SPINE);
    T.q[B_CHEST] = q_mul(T.q[B_SPINE], q_xyz(soft_xyz(vec3<f32>(0.45 * lean_s - 0.05 * alert, -0.75 * twist, -0.3 * list), B_CHEST, 0.1)));
    T.p[B_CHEST] = head_of(T, B_CHEST);

    // --- neck and head: up over the lean, turned to the gaze ------------------------------------
    var look = 0.0;
    var look_p = 0.0;
    if (intent[ii + I_GAZE_W] > 0.0) {
        let gz = vec3<f32>(intent[ii + I_GAZE_X], intent[ii + I_GAZE_Y], intent[ii + I_GAZE_Z]) - T.p[B_CHEST];
        let gl = q_rot(q_conj(qyaw), gz);
        look = intent[ii + I_GAZE_W] * atan2(gl.x, gl.z);
        look_p = intent[ii + I_GAZE_W] * -atan2(gl.y - 0.2, length(vec2<f32>(gl.x, gl.z)));
    }
    look = damp(state[s + D_LOOK], look + 0.4 * omega, 5.0, dt);
    look_p = damp(state[s + D_LOOK_P], look_p, 5.0, dt);
    state[s + D_LOOK] = look;
    state[s + D_LOOK_P] = look_p;
    // The trunk's turn in the world, which the head turns back from.
    let chest_yaw = -0.5 * twist;
    let nod = -0.85 * lean + 0.55 * graze + 0.25 * lie - 0.15 * alert + 0.6 * look_p;
    let turn = look - chest_yaw;
    T.q[B_NECK] = q_mul(T.q[B_CHEST], q_xyz(soft_xyz(vec3<f32>(0.5 * nod, 0.45 * turn, 0.3 * list), B_NECK, 0.1)));
    T.p[B_NECK] = head_of(T, B_NECK);
    T.q[B_HEAD] = q_mul(T.q[B_NECK], q_xyz(soft_xyz(vec3<f32>(0.5 * nod, 0.55 * turn, 0.0), B_HEAD, 0.1)));
    T.p[B_HEAD] = head_of(T, B_HEAD);

    // --- arms: swung against the legs, the elbows bending forward -------------------------------
    let arm_k = mix(ARM_W, ARM_R, rw) * (1.0 - graze) * (1.0 - lie);
    let elbow = mix(ELBOW_W, ELBOW_R, rw * smooth01(speed / 2.2));
    // Foraging the right hand picks at the ground ahead of the feet; resting
    // both forearms lie over the knees.
    let pick = graze * (0.5 + 0.5 * sin(clock * 5.0 + seed));
    // The forearm follows the upper arm's swing a little late (the elbow
    // loose), so its swing trails and carries on past the turn.
    let spread_l = select_f(init, spread, damp(state[s + D_SPREAD_L], spread, 9.0, dt));
    state[s + D_SPREAD_L] = spread_l;
    for (var a: i32 = 0; a < 2; a += 1) {
        let sd = SIDE[a];
        let sw = arm_k * spread * sd;
        let trail = 0.6 * arm_k * (spread_l - spread) * sd;
        let reach_down = graze * select_f(a == 1, 1.0, 0.6);
        // (Less the trunk's lean, an arm hangs; resting, the upper arms hang
        // a little forward and the hands down between the knees.)
        let fx = sw - lean - 0.5 * reach_down - 0.15 * lie - 0.9 * flinch;
        let el = elbow * (1.0 - graze) + mix(0.45, 0.2, rw) * max(-sw, 0.0) - trail + select_f(a == 1, 0.25 * pick, 0.15 * graze)
                 + 0.6 * lie + 1.4 * flinch + 0.1 * alert;
        // (The rest pose holds the arm 13 degrees out; it hangs nearer.)
        let ab = -0.12 + 0.06 * rw + 0.55 * flinch + 0.08 * lie;
        let wr = 0.2 * reach_down - 0.3 * lie - 0.5 * flinch;
        T = set_arm(T, a, sd, fx, ab, el, wr, 0.2 * flinch);
    }

    // --- legs: each solved in its plane to the ankle, the foot pitched on -----------------------
    let qleg = qbody;
    let fw = q_rot(qleg, vec3<f32>(0.0, 0.0, 1.0));
    let par_pitch = atan2(fw.y, length(vec2<f32>(fw.x, fw.z)));
    for (var l: i32 = 0; l < 2; l += 1) {
        let b0 = LEG_B0[l];
        let j = T.p[B_PELVIS] + q_rot(T.q[B_PELVIS], HEAD[b0] - HEAD[B_PELVIS]);
        let d = q_rot(q_conj(qleg), ankles[l] - j);
        let pl = leg_plane(b0, b0 + 1, d);
        let sol = two_bone_soft(rest_len(b0), rest_len(b0 + 1), vec2<f32>(pl.y, pl.z), 1.0, SOFT_REACH);
        let qr = q_mul(qleg, q_z(pl.x));
        var ang: array<f32, 4>;
        ang[0] = sol.x;
        ang[1] = sol.y;
        ang[2] = rest_angle(b0 + 2) - pitch_f[l] - par_pitch;
        ang[3] = rest_angle(b0 + 3) - pitch_t[l] - par_pitch;
        var prev: f32 = 0.0;
        for (var i: i32 = 0; i < 4; i += 1) {
            let b = b0 + i;
            let loc = soft_range(-(ang[i] - rest_angle(b)) - prev, LIM_LO[b].x, LIM_HI[b].x, LEG_BAND);
            prev += loc;
            T.q[b] = q_mul(qr, q_x(prev));
            if (i == 0) { T.p[b] = j; } else { T.p[b] = head_of(T, b); }
        }
    }

    // --- the parts that hang carry their momentum (creature::secondary) -----------------------
    var hold: array<f32, NB>;
    var firm: array<f32, NB>;
    for (var b: i32 = 0; b < NB; b += 1) { hold[b] = 0.0; firm[b] = 0.0; }
    hold[B_HEAD] = mix(HEAD_SPACE, 0.85, rw) * (1.0 - graze) * (1.0 - lie);
    firm[B_SPINE] = 1.0;
    firm[B_CHEST] = 1.0;
    firm[B_NECK] = 0.6;
    let A = carry_held(state, env, s + D_SEC, T, hold, firm, LAYERS, init, dt);

    let coff = q_rot(q_conj(qyaw), com_of(A) - root);
    st3(state, s + D_COFF2, select_v3(init, coff, ld3(state, s + D_COFF1)));
    st3(state, s + D_COFF1, coff);
    st3(state, s + D_COFF, select_v3(init, coff, mix(ld3(state, s + D_COFF), coff, 1.0 - exp(-dt / 0.4))));
    if (init) { body_set(state, s + D_BODY, com_of(A), vec3<f32>(0.0)); }

    // --- out ---------------------------------------------------------------------------------------
    put(pose, c, A);
    st3(state, s + S_POS, vec3<f32>(pos.x, body_y, pos.z));
    state[s + S_YAW] = yaw;
    state[s + D_SPEED] = speed;
    state[s + D_OMEGA] = omega;
    state[s + D_PHASE] = phase;
    state[s + D_MOVING] = select_f(moving, 1.0, 0.0);

    let t0 = c * TELE;
    tele[t0 + T_POS] = plan.x;
    tele[t0 + T_POS + 1] = plan.y;
    tele[t0 + T_POS + 2] = plan.z;
    tele[t0 + T_YAW] = yaw;
    tele[t0 + T_SPEED] = speed;
    tele[t0 + T_GAIT] = gait as f32;
    tele[t0 + T_PHASE] = fract01(phase);
    tele[t0 + T_ACTION] = act as f32;
    tele[t0 + T_HEIGHT] = body_y - ground_y;
    tele[t0 + T_PITCH] = lean;
    tele[t0 + T_ROLL] = list;
    tele[t0 + T_FREQ] = freq * select_f(moving, 1.0, 0.0);
    for (var l: i32 = 0; l < 2; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let f0 = t0 + T_FOOT + 4 * l;
        tele[f0] = state[k + L_PLANT];
        tele[f0 + 1] = toes[l].x;
        tele[f0 + 2] = toes[l].y;
        tele[f0 + 3] = toes[l].z;
    }
}
