// The hexa's rig: one invocation per creature, its state in `state`, its
// bones out to `pose` (the creature contract, lab/contract.js).
//
// How it moves. Walking, its legs go in a ripple: on each side from the
// rear forward, each a third of a cycle after the one behind, the two sides
// half a cycle apart, so four or five feet are down. As it hurries the
// ripple closes up into a tripod (the front and rear legs of one side and
// the middle leg of the other together, then the other three). A leg in
// stance whose phase passes the duty factor lifts, swings over the rest of
// its cycle on an arc and lands where its home under its hip will be by
// mid-stance; a planted foot stays where it landed. Standing, a foot
// strayed from home steps back. The stride is quick enough that a stance
// travels less than the pairs stand apart, and the body rides as much lower
// as the legs need to reach a step's ends still bent.
// The rig plans the body: its height over the ground under the feet, no
// higher than the planted legs reach, pitched to their plane and rolled part
// way toward it, swaying from side to side with the stride; a swing lands
// from where the body is, not where the plan has it. creature::body moves
// the centre of mass only as the six feet can push it (the bones placed
// about it) and creature::spine bends the back with the feet's spread and
// the turn. Its neck, head, ears and tail are this rig's own: the neck's
// two bones give at each step, reach forward as it hurries, draw up alert
// and swing the head down to graze, chewing; the head turns to the gaze and
// to the turn; each ear roams and flicks on its own, turns forward alert
// and lies back at speed; the tail hangs as a cord the hips' sway runs down
// as a wave, trails as it hurries and swishes now and then. Lying down,
// the body sinks onto folded legs. Every joint is held within its limits.
import creature::common::*;
import creature::contract::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::body::*;
import creature::spine::*;
import creature::probe::*;
from creature::secondary import lift_to;
from creature::ground import height;

// Share of a leg's full reach where its IK eases the reach in (common
// two_bone): early, a trotting hexa's legs often reaching straight at speed.
@knob const SOFT_REACH: f32 = 0.9;
@knob const STEP_REACH: f32 = 0.87;  // the share of a leg's length it reaches at a step's ends (the body rides that low)

const D_SPEED: i32 = 5;
const D_OMEGA: i32 = 6;
const D_PHASE: i32 = 7;
const D_MOVING: i32 = 8;
const D_CLOCK: i32 = 9;
const D_BODY_Y: i32 = 10;
const D_LOOK: i32 = 11;
const D_GRAZE: i32 = 12;
const D_LIE: i32 = 13;
const D_ALERT: i32 = 14;
const D_DROP: i32 = 15;    // what the reach cap takes off the plan's height, letting go
const D_HELD: i32 = 16;    // the share of the body's shift held back for reach, letting go
const D_LAG: i32 = 17;     // the body's shift from the plan, last step (3)
const D_LEG: i32 = 20;
const LEG_REC: i32 = 11;
const L_PLANT: i32 = 0;
const L_TOE: i32 = 1;      // where the foot is (planted) or was lifted from (3)
const L_AT: i32 = 4;       // where the foot is now, in swing (3)
const L_U: i32 = 7;        // the swing's progress, 0..1
const L_ARMED: i32 = 8;    // set in stance, so a leg lifts once a cycle
const L_DUR: i32 = 9;      // the swing's length in seconds
const L_SINCE: i32 = 10;   // s since it landed
const D_COFF: i32 = D_LEG + 6 * LEG_REC;  // the pose's centre of mass from the root, in the yaw frame: slow mean (3),
const D_COFF1: i32 = D_COFF + 3;          //   last step's (3)
const D_COFF2: i32 = D_COFF + 6;          //   and the step's before (3)
const D_BODY: i32 = D_COFF + 9;           // creature::body (BODY_STATE)
const D_SPINE: i32 = D_BODY + BODY_STATE; // creature::spine (SPINE_STATE)
pub const PROBE: i32 = D_SPINE + SPINE_STATE; // creature::probe's slice
pub const STATE: i32 = PROBE + PROBE_N;

// The part of a cycle a foot is down. Walking, the six go one after another
// a sixth of a cycle apart, and at 0.68 never more than two are in the air;
// as the ripple closes into the tripod three go together and each is down
// little more than half.
@knob const DUTY_WALK: f32 = 0.68;@knob const DUTY_RUN: f32 = 0.5;
@knob const RUN_BOB: f32 = 0.022;   // m the body rises and falls, tripod to tripod, at a run
@knob const LIFT: f32 = 0.09;
@knob const SWAY: f32 = 0.07;
@knob const LAYERS: f32 = 1.0;       // the motion layers' share (0: the rig's plan as it is)

// Legs in the order of skeleton.js's feet: L1, R1, L2, R2, L3, R3.
const LEG_B0: array<i32, 6> = [B_UPPERL1, B_UPPERR1, B_UPPERL2, B_UPPERR2, B_UPPERL3, B_UPPERR3];
const LEG_PARENT: array<i32, 6> = [B_THORAX, B_THORAX, B_SPINE, B_SPINE, B_PELVIS, B_PELVIS];
// The order its legs go in: on each side from the rear forward, each
// `step` of a cycle after the one behind it, the right side half a cycle
// off the left. Walking, a step is a third of a cycle, so a ripple runs up
// each side; hurrying it is a half, which is the tripod (L1, R2, L3
// together, then R1, L2, R3).
fn leg_off(l: i32, step: f32) -> f32 {
    let pair = 2.0 - f32(l / 2);
    return pair * step + 0.5 * f32(l % 2);
}
@knob const REACH_AHEAD: f32 = 0.03; // m ahead of its place under the hip a foot lands, walking
@knob const RIPPLE_V: f32 = 1.5;    // m/s the ripple begins to close up into the tripod
@knob const TRIPOD_V: f32 = 2.3;     // m/s it is the tripod

fn select_f(c: bool, a: f32, b: f32) -> f32 {
    if (c) { return a; }
    return b;
}
fn select_v3(c: bool, a: vec3<f32>, b: vec3<f32>) -> vec3<f32> {
    if (c) { return a; }
    return b;
}

fn rest_angle(b: i32) -> f32 {
    let v = TAIL[b] - HEAD[b];
    return limb_angle(vec2<f32>(v.z, v.y));
}

fn rest_len(b: i32) -> f32 {
    let v = TAIL[b] - HEAD[b];
    return length(vec2<f32>(v.z, v.y));
}

fn clamp_xyz(a: vec3<f32>, b: i32) -> vec3<f32> { return clamp(a, LIM_LO[b], LIM_HI[b]); }

// The creature's position is the middle of its body (z MID_Z at rest), which
// it turns about.
const MID_Z: f32 = 0.12;

// A leg's home: under its hip, on the ground, in the world.
fn home_of(l: i32, pos: vec3<f32>, qyaw: vec4<f32>) -> vec3<f32> {
    let toe0 = TAIL[LEG_B0[l] + 2];
    return pos + q_rot(qyaw, vec3<f32>(toe0.x, 0.0, toe0.z - MID_Z));
}

// How high the root may be with the body turned to `qbody` for every planted
// foot to hold its leg's top joint: the ankle (behind and above a flat foot's
// toe) within REACH of the upper and lower leg's length. The body's own
// motion about the plan may stretch them to BODY_REACH.
const REACH: f32 = 0.96;
const BODY_REACH: f32 = 0.98;
const RISE_EASE: f32 = 0.015;   // m under that height where the body's rise eases off
const CAP_EASE: f32 = 0.12;     // s over which a hold for reach lets go
const TAIL_CLEAR: f32 = 0.1;    // m the tail's joints are carried over the ground
// The feet are taken together by a soft minimum (over SOFT_M), so the cap
// has no corner where the foot that holds it changes.
const SOFT_M: f32 = 0.01;
fn root_cap(st: rw_store<f32, 1>, s: i32, feet: array<vec3<f32>, 6>, root: vec3<f32>, qbody: vec4<f32>, qyaw: vec4<f32>) -> f32 {
    var lo: f32 = 1e3;
    var c: array<f32, 6>;
    for (var l: i32 = 0; l < 6; l += 1) {
        c[l] = 1e3;
        if (st[s + D_LEG + l * LEG_REC + L_PLANT] < 0.5) { continue; }
        let b0 = LEG_B0[l];
        let off = q_rot(qbody, HEAD[b0] - HEAD[B_PELVIS]);
        let ankle = feet[l] - q_rot(qyaw, TAIL[b0 + 2] - HEAD[b0 + 2]);
        let r = REACH * (rest_len(b0) + rest_len(b0 + 1));
        let h = length(vec2<f32>(root.x + off.x - ankle.x, root.z + off.z - ankle.z));
        c[l] = ankle.y + sqrt(max(r * r - h * h, 0.0)) - off.y;
        lo = min(lo, c[l]);
    }
    if (lo > 999.0) { return lo; }
    var sum: f32 = 0.0;
    for (var l: i32 = 0; l < 6; l += 1) { sum += exp(-(c[l] - lo) / SOFT_M); }
    return lo - SOFT_M * log(sum);
}
// How far past its reach the furthest planted foot's ankle is from its leg's
// top joint, the root at `root` (negative: all within reach).
fn reach_over(st: rw_store<f32, 1>, s: i32, feet: array<vec3<f32>, 6>, root: vec3<f32>, qbody: vec4<f32>, qyaw: vec4<f32>) -> f32 {
    var hi: f32 = -1e3;
    var o: array<f32, 6>;
    for (var l: i32 = 0; l < 6; l += 1) {
        o[l] = -1e3;
        if (st[s + D_LEG + l * LEG_REC + L_PLANT] < 0.5) { continue; }
        let b0 = LEG_B0[l];
        let hip = root + q_rot(qbody, HEAD[b0] - HEAD[B_PELVIS]);
        let ankle = feet[l] - q_rot(qyaw, TAIL[b0 + 2] - HEAD[b0 + 2]);
        o[l] = length(hip - ankle) - BODY_REACH * (rest_len(b0) + rest_len(b0 + 1));
        hi = max(hi, o[l]);
    }
    if (hi < -999.0) { return hi; }
    var sum: f32 = 0.0;
    for (var l: i32 = 0; l < 6; l += 1) { sum += exp((o[l] - hi) / SOFT_M); }
    return hi + SOFT_M * log(sum);
}
// y held under `cap`, eased over the last RISE_EASE so it meets it without a corner.
fn under_cap(y: f32, cap: f32) -> f32 {
    let e = cap - RISE_EASE;
    if (y <= e) { return y; }
    return e + RISE_EASE * (1.0 - exp(-(y - e) / RISE_EASE));
}

fn place(st: rw_store<f32, 1>, env: read_store<f32, 1>, s: i32) {
    let p = ld3(st, s + S_POS);
    let q = q_y(st[s + S_YAW]);
    for (var l: i32 = 0; l < 6; l += 1) {
        let h = home_of(l, vec3<f32>(p.x, 0.0, p.z), q);
        let t = vec3<f32>(h.x, height(env, h.x, h.z), h.z);
        let k = s + D_LEG + l * LEG_REC;
        st[k + L_PLANT] = 1.0;
        st3(st, k + L_TOE, t);
        st3(st, k + L_AT, t);
        st[k + L_U] = 0.0;
        st[k + L_ARMED] = 1.0;
        st[k + L_SINCE] = 1.0;
    }
    st[s + D_BODY_Y] = height(env, p.x, p.z) + HEAD[B_PELVIS].y;
    // The rest pose's centre of mass from its root, as the body starts.
    var cr = vec3<f32>(0.0);
    for (var b: i32 = 0; b < NB; b += 1) { cr += MASS[b] * 0.5 * (HEAD[b] + TAIL[b]); }
    let coff = cr / TOTAL_MASS - HEAD[B_PELVIS];
    st3(st, s + D_COFF, coff);
    st3(st, s + D_COFF1, coff);
    st3(st, s + D_COFF2, coff);
    st[s + S_PLACED] = 1.0;
}

@kernel @grid(1)
fn k_rig(g: grid<1>, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
         pose: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    let c = g.x();
    let s = c * STATE;
    let ii = c * INTENT;
    let init = state[s + S_PLACED] < 0.5;
    if (init) { place(state, env, s); }

    // --- intent ---------------------------------------------------------------
    let act = intent[ii + I_ACTION] as i32;
    let seed = intent[ii + I_SEED];
    let clock = state[s + D_CLOCK] + dt;
    state[s + D_CLOCK] = clock;
    let graze = approach(state[s + D_GRAZE], select_f(act == ACT_GRAZE, 1.0, 0.0), 0.8, dt);
    let lie = approach(state[s + D_LIE], select_f(act == ACT_LIE, 1.0, 0.0), 0.35, dt);
    let alert = approach(state[s + D_ALERT], select_f(act == ACT_STARTLE || act == ACT_ALERT, 1.0, 0.0), 3.0, dt);
    state[s + D_GRAZE] = graze;
    state[s + D_LIE] = lie;
    state[s + D_ALERT] = alert;
    var vdes = vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z]);
    // A walker, however fast: three feet are always down.
    let vmax = 2.6 * (1.0 - 0.85 * graze);
    if (length(vdes) > vmax) { vdes = normalize(vdes) * vmax; }
    if (lie > 0.001 || act == ACT_LIE) { vdes = vec2<f32>(0.0); }

    // --- heading and speed ------------------------------------------------------
    var yaw = state[s + S_YAW];
    var speed = state[s + D_SPEED];
    var want = yaw;
    let vd = length(vdes);
    if (intent[ii + I_HEADING_MODE] > 0.5) { want = intent[ii + I_HEADING]; }
    else if (vd > 0.05) { want = atan2(vdes.x, vdes.y); }
    // Long and narrow, it turns on the spot slowly: its end feet go sideways
    // under it half a metre from the middle, and a quick turn carries one
    // across the other. Walking, its feet go forward and it turns freely.
    // (The turn's rate comes on and goes off through a lag, toward a rate
    // that falls with what is left to turn: begun and ended at its full
    // rate in one step, the hips, half the body from the middle it turns
    // about, were thrown 3 mm sideways in that step.)
    let rate = mix(0.6, 0.9, smooth01(speed / 0.6));
    let w_t = clamp(2.5 * wrap_pi(want - yaw), -rate, rate);
    let omega = select_f(init, 0.0, mix(state[s + D_OMEGA], w_t, 1.0 - exp(-8.0 * dt)));
    yaw = wrap_pi(yaw + omega * dt);
    let err = wrap_pi(want - yaw);
    speed = approach(speed, vd * clamp(cos(err), 0.2, 1.0), 1.2, dt);
    let qyaw = q_y(yaw);
    let fwd = q_rot(qyaw, vec3<f32>(0.0, 0.0, 1.0));
    var pos = ld3(state, s + S_POS);
    pos += fwd * (speed * dt);

    // --- the clock -----------------------------------------------------------------
    var phase = state[s + D_PHASE];
    let was_moving = state[s + D_MOVING] > 0.5;
    var moving = vd > 0.05 || speed > 0.05 || abs(err) > 0.1;
    if (was_moving) { moving = moving || speed > 0.03 || abs(err) > 0.04; }
    if (lie > 0.001) { moving = false; }
    // Turning on the spot it steps quickly for the same reason: a long
    // stance carries the end feet out from under the body.
    let veff = max(speed, 1.6 * abs(omega));
    // Long legs take long steps, but a stance travels less than the pairs
    // stand apart (0.54 m), so a leg never reaches into its neighbour's
    // ground.
    let freq = 0.75 + 0.72 * veff;
    let tripod = smooth01((speed - RIPPLE_V) / (TRIPOD_V - RIPPLE_V));
    let step = mix(1.0 / 3.0, 0.5, tripod);
    let duty = mix(DUTY_WALK, DUTY_RUN, tripod);
    if (moving && !was_moving) { phase = floor(phase) + 1.0 + duty; }
    if (moving) { phase += freq * dt; }
    let go = smooth01(veff / 0.4) * select_f(moving, 1.0, 0.0);

    // --- feet ------------------------------------------------------------------------
    let swing_t = (1.0 - duty) / freq;
    var ground_sum: f32 = 0.0;
    var front_y: f32 = 0.0;
    var rear_y: f32 = 0.0;
    var left_y: f32 = 0.0;
    var right_y: f32 = 0.0;
    var feet: array<vec3<f32>, 6>;
    var swing: array<f32, 6>;
    var left_t: array<f32, 6>;
    var busy = false;
    var up: f32 = 0.0;
    let lag = select_v3(init, vec3<f32>(0.0), ld3(state, s + D_LAG) * vec3<f32>(1.0, 0.0, 1.0));
    for (var l: i32 = 0; l < 6; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        if (state[k + L_PLANT] < 0.5) { busy = true; up += 1.0; }
    }
    // No more feet leave the ground than the gait has in the air: two
    // walking, three in the tripod. A foot whose turn comes while that many
    // are up waits for one to land (setting off, the first steps are slow
    // and the next legs' turns come before they end).
    let up_max = 2.0 + smooth01(tripod * 2.0);
    for (var l: i32 = 0; l < 6; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let home = home_of(l, pos, qyaw);
        let ph = fract01(phase - leg_off(l, step));
        var planted = state[k + L_PLANT] > 0.5;
        var toe = ld3(state, k + L_TOE);
        var at = toe;
        // Where a swing lands: home as it will be at landing, ahead by half
        // the stance's travel, and turned on by the turn the stance will make.
        let stance_t = duty / freq;
        let to_mid = select_f(planted, swing_t, (1.0 - state[k + L_U]) * state[k + L_DUR]) + 0.5 * stance_t;
        // It is placed from the body where it is, not where the plan has it.
        // (And a little ahead of that: it reaches into its step.)
        let ahead = q_rot(q_y(omega * to_mid), home - pos) + pos + fwd * (speed * to_mid + REACH_AHEAD * go) + lag;
        let target = vec3<f32>(ahead.x, height(env, ahead.x, ahead.z), ahead.z);
        if (planted) {
            if (ph < duty) { state[k + L_ARMED] = 1.0; }
            let stray = length(vec2<f32>(toe.x - home.x, toe.z - home.z));
            // (A foot whose turn has come and whose leg is at its reach does
            // not wait: in a turn, kept down for another to land, a hind leg
            // ran out of length and the body was drawn down 24 mm to it in
            // three steps.)
            let b0 = LEG_B0[l];
            let hip_l = vec3<f32>(pos.x, state[s + D_BODY_Y] - state[s + D_DROP], pos.z) + ld3(state, s + D_LAG) + q_rot(qyaw, HEAD[b0] - HEAD[B_PELVIS] + vec3<f32>(0.0, 0.0, HEAD[B_PELVIS].z - MID_Z));
            let ankle_l = toe - q_rot(qyaw, TAIL[b0 + 2] - HEAD[b0 + 2]);
            let spent = !init && length(hip_l - ankle_l) > 0.94 * (rest_len(b0) + rest_len(b0 + 1));
            var lift = moving && state[k + L_ARMED] > 0.5 && ph >= duty && (up < up_max - 0.5 || spent);
            var dur = clamp((1.0 - ph) / freq, 0.15, 0.8);
            // (Nor one left behind its hip at its leg's reach before its
            // turn, three others down: as the walk became the run the clock
            // put three feet back at the start of their stance, far behind
            // the body, and it was drawn down 9 cm to them. Such a foot
            // steps on as a stride's swing.)
            if (!lift && moving && spent && up < 2.5 && state[k + L_SINCE] > 0.1 && dot(ankle_l - hip_l, fwd) < 0.0) {
                lift = true;
                dur = clamp((1.0 - duty) / freq, 0.15, 0.4);
            }
            if (lift) { up += 1.0; }
            // Standing: a foot strayed from home steps back, one at a time.
            if (!moving && !busy && stray > 0.05 && lie < 0.01) { lift = true; dur = 0.45; busy = true; }
            if (lift) {
                planted = false;
                state[k + L_PLANT] = 0.0;
                state[k + L_ARMED] = 0.0;
                state[k + L_U] = 0.0;
                state[k + L_DUR] = dur;
            }
        }
        var u: f32 = 0.0;
        if (!planted) {
            u = min(state[k + L_U] + dt / max(state[k + L_DUR], 0.05), 1.0);
            state[k + L_U] = u;
            // It leaves the ground and meets it again with no speed and no
            // change of speed, forward or up (a hoof picked up and set down,
            // not thrown and dropped): the leg's joints start and stop
            // without a corner.
            let e = u * u * u * (10.0 + u * (6.0 * u - 15.0));
            let arc = 4.0 * u * (1.0 - u);
            at = mix(toe, target, e) + vec3<f32>(0.0, LIFT * (0.6 + 0.4 * go) * arc * arc * arc, 0.0);
            if (u >= 1.0) {
                planted = true;
                state[k + L_PLANT] = 1.0;
                state[k + L_SINCE] = 0.0;
                st3(state, k + L_TOE, target);
                at = target;
            }
        }
        if (planted) { state[k + L_SINCE] = state[k + L_SINCE] + dt; }
        // How long until this foot lifts (for the body's loading).
        var lt: f32 = 1e3;
        if (planted && moving) {
            if (state[k + L_ARMED] > 0.5) { lt = max(duty - ph, 0.0) / freq; }
            else { lt = (1.0 + duty - ph) / freq; }
        }
        left_t[l] = lt;
        st3(state, k + L_AT, at);
        feet[l] = at;
        // (How far through its swing, as its lift goes: the hoof's curl
        // comes and goes with it, from nothing and back with no corner.)
        let bell = 4.0 * u * (1.0 - u);
        swing[l] = select_f(planted, 0.0, bell * bell * bell);
        let gy = select_f(planted, at.y, height(env, at.x, at.z));
        ground_sum += gy;
        if (l < 2) { front_y += gy * 0.5; }
        if (l >= 4) { rear_y += gy * 0.5; }
        if (l % 2 == 0) { left_y += gy / 3.0; } else { right_y += gy / 3.0; }
    }

    // --- the body's plan ------------------------------------------------------------------
    let span = HEAD[B_UPPERL1].z - HEAD[B_UPPERL3].z;
    let width = 2.0 * HEAD[B_UPPERL1].x;
    let pitch = atan2(front_y - rear_y, span);
    // Across a slope the body stays near level and the legs take the
    // difference: rolled with the ground, every hip turns its leg out down
    // the slope past what it holds.
    let roll = atan2(left_y - right_y, width) * 0.4;
    let qbody = q_mul(qyaw, q_mul(q_x(-pitch), q_z(-roll)));
    // The middle of the body rides at body_y over pos; the pelvis is the
    // skeleton's root, behind it. Its height: over the ground under the feet,
    // and no higher than the planted feet can hold it (lying, the legs fold).
    // Stepping, it rides as much lower as its legs need to reach a step's
    // ends without straightening: a longer step, a lower body.
    let step_h = REACH_AHEAD * go + 0.5 * speed * duty / freq;
    // (Still bent: short of where the leg's reach begins to ease in,
    // SOFT_REACH, or every footfall would fall inside that easing and the
    // knee turn a corner there.)
    let leg_r = STEP_REACH * (rest_len(B_UPPERL1) + rest_len(B_UPPERL1 + 1));
    let stand_h = HEAD[B_UPPERL1].y - HEAD[B_UPPERL1 + 2].y;
    let crouch = max(stand_h - sqrt(max(leg_r * leg_r - step_h * step_h, 0.01)), 0.0);
    let want_y = ground_sum / 6.0 + HEAD[B_PELVIS].y - 0.6 * smooth01(lie) - 0.03 * graze - crouch;
    let body_y = damp(state[s + D_BODY_Y], want_y, 10.0, dt);
    state[s + D_BODY_Y] = body_y;
    let sway = SWAY * go * sin(TAU * phase);
    let bendt = clamp(omega * 0.25, -0.3, 0.3);
    var plan = vec3<f32>(pos.x, body_y, pos.z) + q_rot(qbody, vec3<f32>(0.0, 0.0, HEAD[B_PELVIS].z - MID_Z));
    // Running on its tripods it bounds a little from one to the next: lowest
    // in the middle of each one's stance, highest as they change.
    plan.y -= RUN_BOB * tripod * go * cos(2.0 * TAU * (phase - 0.5 * duty));
    // What the cap takes off the height lets go over CAP_EASE s, so a foot
    // that lifts and frees it lets the body rise rather than jump.
    var drop = 0.0;
    if (lie < 0.001) { drop = plan.y - under_cap(plan.y, root_cap(state, s, feet, plan, qbody, qyaw)); }
    if (!init) { drop = max(drop, state[s + D_DROP] * exp(-dt / CAP_EASE)); }
    state[s + D_DROP] = drop;
    plan.y -= drop;

    // --- the body: its centre of mass as the feet move it (creature::body) ------------------
    // The plan's centre is its root plus the pose's centre of mass from the
    // root, slowly averaged; the bones go where this step's pose puts the
    // centre at the body's (last two steps' offsets carried on). A walker's
    // legs are near rigid struts: four times a runner's stiffness.
    let coff_m = q_rot(qyaw, ld3(state, s + D_COFF));
    let coff_p = q_rot(qyaw, 2.0 * ld3(state, s + D_COFF1) - ld3(state, s + D_COFF2));
    var sup: Support;
    for (var l: i32 = 0; l < 6; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        var f: Foot;
        f.at = feet[l];
        f.pivot = plan + q_rot(qbody, HEAD[LEG_B0[l]] - HEAD[B_PELVIS]);
        f.reach = LEG_LEN[l];
        f.since = state[k + L_SINCE];
        f.left = left_t[l];
        f.down = state[k + L_PLANT];
        sup.f[l] = f;
    }
    sup.effort = 1.0;
    sup.lead = 0.0;
    let bd = body_step(state, s + D_BODY, plan + coff_m, 4.0, sup, init, dt);
    // Lying, and lying down or getting up, the body rests on the ground and
    // folded legs: it goes where the plan has it, and is kept there.
    let wl = smooth01(lie * 3.0);
    var shift = (bd.com - coff_p - plan) * LAYERS * (1.0 - wl);
    if (wl > 0.0) { body_set(state, s + D_BODY, mix(bd.com, plan + coff_p, wl), mix(bd.vel, bd.tvel, wl)); }
    // No further from the plan than the planted feet reach: a body they
    // would have to stretch past their length to follow is held where they
    // still reach (only as far as the plan's own place allows).
    // The share held back lets go over CAP_EASE s, as the cap's drop does.
    var held = 0.0;
    if (lie < 0.001) {
        let over0 = max(reach_over(state, s, feet, plan, qbody, qyaw), 0.0);
        if (reach_over(state, s, feet, plan + shift, qbody, qyaw) > over0) {
            var lo: f32 = 0.0;
            var hi: f32 = 1.0;
            for (var it: i32 = 0; it < 6; it += 1) {
                let m = 0.5 * (lo + hi);
                if (reach_over(state, s, feet, plan + shift * m, qbody, qyaw) > over0) { hi = m; } else { lo = m; }
            }
            held = 1.0 - lo;
        }
    }
    if (!init) {
        held = max(held, state[s + D_HELD] * exp(-dt / CAP_EASE));
    }
    state[s + D_HELD] = held;
    shift = shift * (1.0 - held);
    st3(state, s + D_LAG, shift);
    let root = plan + shift;
    // (For `trace`: the cap's drop, the share held, the body's centre from
    // the plan's in the heading's frame, the feet's load.)
    let pr = s + PROBE;
    probe(state, pr, 0, drop);
    probe(state, pr, 1, held);
    probe3(state, pr, 2, q_rot(q_conj(qyaw), bd.com - coff_p - plan));
    probe(state, pr, 5, bd.load);
    probe3(state, pr, 6, q_rot(q_conj(qyaw), coff_p - coff_m));

    // --- spine (creature::spine): flexed and bent by the feet's spread, into the turn --------
    var rel: array<vec3<f32>, NFEET>;
    for (var l: i32 = 0; l < 6; l += 1) { rel[l] = q_rot(q_conj(qyaw), feet[l] - sup.f[l].pivot); }
    let curv = omega / max(speed, 0.5) * smooth01(speed / 0.5);
    let bend_want = spine_want(rel, curv, speed * omega, (1.0 - smooth01(lie * 3.0)) * select_f(moving, 1.0, 0.3) * LAYERS);
    let bend = spine_step(state, s + D_SPINE, bend_want, bd.acc.y * LAYERS, init, dt);

    // --- the trunk: swaying with the stride, the spine's bend on it ---------------------------
    var T: Pose;
    T.q[B_PELVIS] = q_mul(qbody, q_mul(q_y(sway), q_xyz(spine_angles(bend, 0))));
    T.p[B_PELVIS] = root;
    let spine_a = clamp_xyz(vec3<f32>(0.0, -1.3 * sway, 0.0) + spine_angles(bend, 1), B_SPINE);
    T.q[B_SPINE] = q_mul(T.q[B_PELVIS], q_xyz(spine_a));
    T.p[B_SPINE] = head_of(T, B_SPINE);
    let thorax_a = clamp_xyz(vec3<f32>(0.0, 0.6 * sway, 0.0) + spine_angles(bend, 2), B_THORAX);
    T.q[B_THORAX] = q_mul(T.q[B_SPINE], q_xyz(thorax_a));
    T.p[B_THORAX] = head_of(T, B_THORAX);

    // --- neck, head and jaw (the rig's targets) -----------------------------------------------
    var look = 0.0;
    if (intent[ii + I_GAZE_W] > 0.0) {
        let gz = vec3<f32>(intent[ii + I_GAZE_X], intent[ii + I_GAZE_Y], intent[ii + I_GAZE_Z]) - T.p[B_THORAX];
        let gl = q_rot(q_conj(T.q[B_THORAX]), gz);
        look = intent[ii + I_GAZE_W] * atan2(gl.x, gl.z);
    }
    look = damp(state[s + D_LOOK], look + omega * 0.5 - 0.4 * sway, 4.0, dt);
    state[s + D_LOOK] = look;
    // The neck: it reaches forward as it hurries and is drawn up alert; to
    // graze, its two bones swing the head down in front of the forefeet. At
    // each step it gives a little, the upper bone a moment after the lower.
    let hurry = smooth01((speed - 1.0) / 1.4);
    // (Running, each tripod's landing goes up it as a deeper nod: the neck's
    // root first, the upper bone and the head after, the head turned back
    // against them so its gaze stays where it was.)
    let nodn = (0.014 + 0.05 * hurry) * go * sin(2.0 * TAU * phase - 0.6);
    let nodh = (0.012 + 0.045 * hurry) * go * sin(2.0 * TAU * phase - 1.7);
    let neck_a = clamp_xyz(vec3<f32>(1.08 * graze - 0.14 * alert + 0.16 * hurry + 0.1 * lie + nodn, 0.3 * look, 0.0), B_NECK);
    T.q[B_NECK] = q_mul(T.q[B_THORAX], q_xyz(neck_a));
    T.p[B_NECK] = head_of(T, B_NECK);
    let neck2_a = clamp_xyz(vec3<f32>(1.0 * graze - 0.1 * alert + 0.1 * hurry + nodh, 0.35 * look, 0.0), B_NECK2);
    T.q[B_NECK2] = q_mul(T.q[B_NECK], q_xyz(neck2_a));
    T.p[B_NECK2] = head_of(T, B_NECK2);
    let head_a = clamp_xyz(vec3<f32>(-0.75 * graze + 0.1 * alert - 0.2 * hurry - nodn - nodh, 0.35 * look, 0.0), B_HEAD);
    T.q[B_HEAD] = q_mul(T.q[B_NECK2], q_xyz(head_a));
    T.p[B_HEAD] = head_of(T, B_HEAD);
    // The ears: out to the sides at ease, each flicking on its own; turned
    // forward and up alert, laid back as it hurries.
    for (var e: i32 = 0; e < 2; e += 1) {
        let side = select_f(e == 0, 1.0, -1.0);
        let b = B_EARL + e;
        let ch = 20.0 + 7.0 * f32(e);
        let flick = smooth01(4.0 * noise1(clock * 0.9, seed, ch) - 2.6) * sin(clock * 31.0 + ch);
        let roam = noise1(clock * 0.35, seed, ch + 1.0);
        // Laid back at a run they are not held there: each beat throws them
        // back and they come forward again after the head has, the two a
        // little apart.
        let beat = 0.16 * hurry * go * sin(2.0 * TAU * phase - 2.6 - 0.5 * f32(e));
        let ear_a = vec3<f32>(-0.25 * alert + 0.5 * hurry + beat + 0.12 * roam, side * (0.45 * alert - 0.6 * hurry + 0.3 * roam + 0.25 * flick), side * (0.35 * alert + 0.12 * flick));
        T.q[b] = q_mul(T.q[B_HEAD], q_xyz(clamp_xyz(ear_a, b)));
        T.p[b] = head_of(T, b);
    }
    let chew = graze * (0.08 + 0.08 * sin(clock * 7.0));
    T.q[B_JAW] = q_mul(T.q[B_HEAD], q_x(chew + 0.05 * alert));
    T.p[B_JAW] = head_of(T, B_JAW);

    // --- the tail: a cord hanging from the croup. Walking, the hips' sway
    // runs down it as a wave, each joint a moment after the one above, and
    // it trails back a little as it hurries; now and then it swishes, the
    // tuft thrown furthest. (Its angles are drawn from the stride's phase
    // and its own clock, so nothing in it rings.)
    let swish = LAYERS * smooth01(3.5 * noise1(clock * 0.45, seed, 30.0) - 1.6) * sin(clock * 8.5 + seed);
    for (var i: i32 = 0; i < 4; i += 1) {
        let b = B_TAIL1 + i;
        let fi = f32(i);
        let wave = -(0.5 + 0.35 * fi) * SWAY * go * sin(TAU * phase - 0.7 * (fi + 1.0)) * LAYERS;
        let swingy = wave - 0.25 * bendt + (0.05 + 0.11 * fi) * swish;
        // (Running, the croup's beat runs down it as a wave that grows to the tuft.)
        let trail = (0.16 + 0.05 * fi) * hurry + (0.012 + 0.035 * hurry) * (1.0 + fi) * go * sin(2.0 * TAU * phase - 2.0 - 0.9 * fi) * LAYERS;
        let a = clamp_xyz(vec3<f32>(-0.03 * (1.0 - lie) + 0.06 * lie - trail, swingy, 0.0), b);
        T.q[b] = q_mul(T.q[PARENT[b]], q_xyz(a));
        T.p[b] = head_of(T, b);
        // Standing, it is carried over TAIL_CLEAR of the ground (met with no
        // corner), the ground's rise lifting it within its joint's range.
        let e = T.p[b] + q_rot(T.q[b], TAIL[b] - HEAD[b]);
        let f = height(env, e.x, e.z) + TAIL_CLEAR * (1.0 - lie);
        if (e.y < f + TAIL_CLEAR) {
            let ql = lift_to(T.p[b], T.q[b], b, f + TAIL_CLEAR * exp((e.y - f - TAIL_CLEAR) / TAIL_CLEAR));
            T.q[b] = q_mul(T.q[PARENT[b]], q_xyz(clamp_xyz(q_to_xyz(q_mul(q_conj(T.q[PARENT[b]]), ql)), b)));
        }
    }

    // --- legs ----------------------------------------------------------------------------------
    for (var l: i32 = 0; l < 6; l += 1) {
        let b0 = LEG_B0[l];
        let pb = LEG_PARENT[l];
        let qp = T.q[pb];
        let j = T.p[pb] + q_rot(qp, HEAD[b0] - HEAD[pb]);
        let d = q_rot(q_conj(qp), feet[l] - j);
        // The plane through the foot: the leg turned out about the body's axis.
        let rx = TAIL[b0 + 2].x - HEAD[b0].x;
        let r2 = d.x * d.x + d.y * d.y;
        let rho = clamp(atan2(d.x, -d.y) - atan2(rx, sqrt(max(r2 - rx * rx, 1e-6))), LIM_LO[b0].z, LIM_HI[b0].z);
        let py = -d.x * sin(rho) + d.y * cos(rho);
        // The foot flat in stance (level in the world), toes curled in swing.
        let fw = q_rot(qp, vec3<f32>(0.0, 0.0, 1.0));
        let par_pitch = atan2(fw.y, length(vec2<f32>(fw.x, fw.z)));
        let af = rest_angle(b0 + 2) - par_pitch + 0.7 * swing[l];
        let ankle = vec2<f32>(d.z, py) - rest_len(b0 + 2) * limb_dir(af);
        let sol = two_bone_soft(rest_len(b0), rest_len(b0 + 1), ankle, 1.0, SOFT_REACH);
        let qr = q_mul(qp, q_z(rho));
        var prev: f32 = 0.0;
        for (var i: i32 = 0; i < 3; i += 1) {
            let b = b0 + i;
            var ang = af;
            if (i == 0) { ang = sol.x; }
            if (i == 1) { ang = sol.y; }
            let loc = clamp(-(ang - rest_angle(b)) - prev, LIM_LO[b].x, LIM_HI[b].x);
            prev += loc;
            T.q[b] = q_mul(qr, q_x(prev));
            if (i == 0) { T.p[b] = j; } else { T.p[b] = head_of(T, b); }
        }
    }

    let A = T;

    // The pose's centre of mass from the root, kept for the next step.
    let coff = q_rot(q_conj(qyaw), com_of(A) - root);
    st3(state, s + D_COFF2, select_v3(init, coff, ld3(state, s + D_COFF1)));
    st3(state, s + D_COFF1, coff);
    st3(state, s + D_COFF, select_v3(init, coff, mix(ld3(state, s + D_COFF), coff, 1.0 - exp(-dt / 0.4))));
    // (The body starts where the first pose puts its centre, not the rest pose's.)
    if (init) { body_set(state, s + D_BODY, com_of(A), vec3<f32>(0.0)); }

    // --- out -------------------------------------------------------------------------------------
    put(pose, c, A);
    st3(state, s + S_POS, vec3<f32>(pos.x, body_y, pos.z));
    state[s + S_YAW] = yaw;
    state[s + D_SPEED] = speed;
    state[s + D_OMEGA] = omega;
    state[s + D_PHASE] = phase;
    state[s + D_MOVING] = select_f(moving, 1.0, 0.0);

    // The telemetry's position is the plan's root (the frame the body moves
    // about), so the body's own motion shows against it.
    let t0 = c * TELE;
    tele[t0 + T_POS] = plan.x;
    tele[t0 + T_POS + 1] = plan.y;
    tele[t0 + T_POS + 2] = plan.z;
    tele[t0 + T_YAW] = yaw;
    tele[t0 + T_SPEED] = speed;
    tele[t0 + T_GAIT] = select_f(moving, GAIT_WALK as f32, GAIT_STAND as f32);
    tele[t0 + T_PHASE] = fract01(phase);
    tele[t0 + T_ACTION] = act as f32;
    tele[t0 + T_HEIGHT] = body_y - ground_sum / 6.0;
    tele[t0 + T_PITCH] = pitch;
    tele[t0 + T_ROLL] = roll;
    tele[t0 + T_FREQ] = freq * select_f(moving, 1.0, 0.0);    for (var l: i32 = 0; l < 6; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let f0 = t0 + T_FOOT + 4 * l;
        tele[f0] = state[k + L_PLANT];
        let at = ld3(state, k + L_AT);
        tele[f0 + 1] = at.x;
        tele[f0 + 2] = at.y;
        tele[f0 + 3] = at.z;
    }
}
