// bunny::legs — the bunny's legs on the lab's planar leg solutions
// (creature::limbs): the hind leg folded in a Z as a pantograph (thigh and
// foot kept at their rest angle, so as the leg straightens the heel lifts
// off the ground and the foot stands on its toes), the fore leg with its
// blade swinging with it and the wrist curling the paw in its swing.
module bunny::legs;
import creature::common::*;
import creature::skeleton::*;
import creature::limbs::*;

// Legs in the contract's foot order: LH, LF, RF, RH.
pub const LEG_HIND: array<i32, 4> = [1, 0, 0, 1];
pub const LEG_SIDE: array<f32, 4> = [1.0, 1.0, -1.0, -1.0];
pub const LEG_B0: array<i32, 4> = [B_FEMURL, B_SCAPL, B_SCAPR, B_FEMURR];
pub const LEG_NB: array<i32, 4> = [4, 5, 5, 4];

// When each foot touches down in the stride, after the left hind: the hind
// pair together, the fore feet one after the other between them. The hop's
// fore feet land halfway through the stride; at speed (a half-bound) the
// lead fore foot comes down later and nearer its partner.
pub const OFF_HOP: array<f32, 4> = [0.0, 0.44, 0.56, 0.025];
// Moving a little, it shuffles: the fore paws step one after the other and
// the hind feet are brought up after them, near together.
pub const OFF_SHUFFLE: array<f32, 4> = [0.0, 0.28, 0.64, 0.07];
pub const OFF_BOUND: array<f32, 4> = [0.0, 0.46, 0.57, 0.05];

pub const SCAP_PIVOT: f32 = 0.4;   // where along the blade the fore leg swings about

// Reach (m from the joint each leg swings from to its toe) a leg can hold,
// and the fore leg's from its blade's top with the whole leg straight.
pub const REACH_HIND: f32 = 0.226;
pub const REACH_FORE: f32 = 0.160;
pub const REACH_FORE_TOP: f32 = 0.180;
// The hind foot's limb angle in the world at most (its heel on the ground:
// a little past flat, its rest pose's 83 degrees).
pub const FOOT_FLAT: f32 = 1.5;
// The share of a leg's reach where its IK eases the reach in.
pub const SOFT_REACH: f32 = 0.95;
// A swing's reach cap's band (creature::limbs soft_cap).
pub const CAP_BAND: f32 = 0.12;

// The fore leg's swing pivot and the hind's, where the reach caps measure a
// leg from (rest frame).
pub fn leg_pivot(l: i32) -> vec3<f32> {
    let b0 = LEG_B0[l];
    if (LEG_HIND[l] == 1) { return HEAD[b0]; }
    return mix(HEAD[b0], TAIL[b0], SCAP_PIVOT);
}

// The joint leg l swings from, with the hips at `hy` and the withers at `fy`,
// its girdle where the root at `o` would put it (each girdle surges on its
// own, bunny::stride: `o` is the root moved by that girdle's surge).
pub fn leg_top(l: i32, o: vec3<f32>, qyaw: vec4<f32>, hy: f32, fy: f32) -> vec3<f32> {
    let piv = leg_pivot(l);
    var top = o + q_rot(qyaw, vec3<f32>(piv.x - HEAD[B_PELVIS].x, 0.0, piv.z - HEAD[B_PELVIS].z));
    if (LEG_HIND[l] == 1) { top.y = hy - HEAD[B_PELVIS].y + piv.y; }
    else { top.y = fy - HEAD[B_SCAPL].y + piv.y; }
    return top;
}

pub fn reach_of(l: i32) -> f32 { return select_f(LEG_HIND[l] == 1, REACH_HIND, REACH_FORE); }

// How far ahead of the hips (pelvis head) the body turns about.
pub fn turn_z() -> f32 {
    return 0.5 * (leg_pivot(0).z + leg_pivot(1).z) - HEAD[B_PELVIS].z;
}

// Leg l's touchdown phase: the hop's, toward the shuffle's by `w` and the
// bound's by `b`.
pub fn off_mix(b: f32, w: f32, l: i32) -> f32 {
    let o = OFF_HOP[l] + w * phase_diff(OFF_HOP[l], OFF_SHUFFLE[l]);
    return o + b * phase_diff(o, OFF_BOUND[l]);
}

// The shape of a swing (creature::limbs bump): the foot's lift eases in over
// the first quarter and down over the last, the joints' folding over the
// whole swing.
pub fn swing_bump(u: f32) -> f32 { return bump(u, 0.25, 0.72); }
pub fn fold_bump(u: f32) -> f32 { return bump(u, 0.4, 0.5); }

// The head's (its joint's) height with the neck flexed by `n` (x), from the
// thorax at (qt, pt).
pub fn head_y(qt: vec4<f32>, pt: vec3<f32>, n: f32) -> f32 {
    let p1 = pt + q_rot(qt, HEAD[B_NECK] - HEAD[B_THORAX]);
    let q1 = q_mul(qt, q_xyz(clamp_xyz(vec3<f32>(n, 0.0, 0.0), B_NECK)));
    return (p1 + q_rot(q1, HEAD[B_HEAD] - HEAD[B_NECK])).y;
}

// The nose's height with the neck flexed by `n` and the head held at `qh`
// (world), from the thorax at (qt, pt).
pub fn nose_y(qt: vec4<f32>, pt: vec3<f32>, n: vec3<f32>, qh: vec4<f32>) -> f32 {
    let p1 = pt + q_rot(qt, HEAD[B_NECK] - HEAD[B_THORAX]);
    let q1 = q_mul(qt, q_xyz(clamp_xyz(n, B_NECK)));
    let ph = p1 + q_rot(q1, HEAD[B_HEAD] - HEAD[B_NECK]);
    return (ph + q_rot(qh, TAIL[B_NOSE] - HEAD[B_HEAD])).y;
}
