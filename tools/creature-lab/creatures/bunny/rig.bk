// The bunny's rig: one invocation per bunny, its state in `state`, its bones
// out to `pose` (the creature contract, lab/contract.js).
//
// How it goes. A rabbit has no walk: it hops. The fore feet step one after
// the other while the hind pair holds the body, then the hind feet swing
// forward together, the hips lifting over them, and land beside or ahead of
// the fore feet. Faster (a half-bound) the same order runs with a flight
// after the hind push and another after the fore feet lift, the hind feet
// landing well ahead of the fore prints. A gait clock says when each foot
// lifts (hop and bound blended across a change); a planted foot stays where
// it landed; a swinging one lands where its home under its girdle will be by
// mid-stance. Standing, a foot strayed past a few millimetres steps home,
// one at a time.
//
// The body is the rabbit's own (bunny::stride): each girdle surges on its
// own, slowing over its feet's stance and running on while they swing, so
// the trunk stretches as the hind push throws the front on and gathers as
// the hips catch up; the back's arch is that length. In the bound's flights
// the body falls freely. The head, ears, nose, and scut live in bunny::act.
import creature::common::*;
import creature::contract::*;
import creature::skeleton::*;
import creature::pose::*;
import creature::limbs::*;
import bunny::legs::*;
import bunny::stride::*;
import bunny::act::*;
import creature::probe::*;
from creature::ground import height, normal, obstacle_ahead;

pub const PROBE: i32 = D_END;         // creature::probe's slice
pub const STATE: i32 = PROBE + PROBE_N;

const HOP_UP: f32 = 1.5;         // m/s the hop gives way to the bound
const BOUND_DOWN: f32 = 1.1;     //   and back
const DV_MAX: f32 = 2.7;         // m/s^2 it changes pace by at most
const SETTLE_TRIG: f32 = 0.012;  // m a still foot may stray before it steps home
const REACH_TRIG: f32 = 0.16;    // m a planted foot may trail its home before it must step
const SETTLE_T: f32 = 0.16;
const CAP_FADE: f32 = 0.06;      // m a coming or going foot's reach limit is slackened by
const CAP_SOFT: f32 = 0.003;     // m over which one reach limit hands over to another
@knob const FORE_BAND: f32 = 0.3;   // of that reach over which a swinging fore foot eases up to it
@knob const FORE_CARRY: f32 = 0.92;  // of its reach a swinging fore foot is carried from its girdle at most
@knob const SWING_FOLD_F: f32 = 0.6;  // of its reach a swinging fore foot stays from its girdle at least
@knob const SWING_FOLD_H: f32 = 0.45;  //   and a hind foot (sitting, 0.57)
@knob const LEG_BAND: f32 = 0.15;    // rad a leg's joint eases into the ends of its range over
@knob const SWING_FOLD_BAND: f32 = 0.015;  // m over which that floor eases in
@knob const HOP_ARC: f32 = 0.045;     // m the hips vault over a hop's hind swing
// A leap (bounding at a log in its way): one bound thrown high.
@knob const LEAP_OVER: f32 = 0.03;    // m over the log's height the body rises at the least
@knob const LEAP_SPARE: f32 = 0.7;   // m/s more it can leave the ground at, to put the log under the middle of its flight
@knob const LEAP_PUSH_T: f32 = 0.08;  // s the hind feet's last stance is held for the push
@knob const LEAP_DIP: f32 = 0.03;     // m the body sinks into it
@knob const LEAP_PITCH: f32 = 0.045;  // m the withers are over the hips' line at the take-off, and under it coming down
@knob const LEAP_CATCH: f32 = 0.07;   // m over the stride's height the body is as its fore feet come down
@knob const LEAP_GIVE: f32 = 24.0;    // 1/s the legs take the fall up at
@knob const LEAP_FOLD: f32 = 0.03;   // m more its feet are drawn up in the air
@knob const SHUFFLE_FULL: f32 = 0.2;  // m/s at and under which it shuffles
@knob const SHUFFLE_TOP: f32 = 0.7;   //   and by which it hops
@knob const SHUFFLE_LIFT: f32 = 0.012; // m a shuffling hind foot lifts
@knob const HOP_LAND_H: f32 = 0.02;  // m a hopping hind foot lands ahead of its home, beside the fore prints
const HIP_RUN: f32 = 0.145;      // m the hips ride at in the bound (sitting: 0.115)
const SCAP_RUN: f32 = 0.155;     //   and the withers
@knob const HOME_HOP_F: f32 = 0.04; // m a hopping fore foot's home comes back from where it sits
@knob const TRAVEL_H: f32 = 0.18;  // m a running foot travels in its stance at most, hind
@knob const TRAVEL_F: f32 = 0.13;  //   and fore, bounding
@knob const TRAVEL_F_HOP: f32 = 0.10; //   and hopping: a fore leg stood under its shoulder, which
                                      //   the long bound stride would carry to full stretch
@knob const TRUNK_SWING: f32 = 0.03;   // m the trunk stretches and gathers by about its rest
@knob const SURGE_MAX: f32 = 0.7;      // of the pace a girdle surges by at most
@knob const RECOIL_T: f32 = 0.25;      // s the mass's usual place is a mean over (the recoil is what it is off that)
@knob const RECOIL_TRUNK: f32 = 0.75;  // the share of the body that goes with the trunk when the legs are solved again
@knob const FLEX_RUN: f32 = 0.1;       // rad the back is arched by, bounding (its mean)
@knob const FLEX_SIT: f32 = 0.4;       // rad the back is rounded by, sitting and hopping (its mean)
@knob const HIP_DROP: f32 = 0.01;      // m the hips sit lower than the rest pose's, sitting and hopping
@knob const FLEX_SWING: f32 = 0.52;    // rad it flexes by per TRUNK_SWING of the girdles' spacing
@knob const FLEX_SWING_HOP: f32 = 0.3; //   and hopping (its surges larger against its stride)
@knob const FLIGHT: f32 = 1.0;         // share of the bound's free fall the body takes
const REAR_PITCH: f32 = 1.0;     // rad the trunk pitches up sitting up
const REAR_HIP: f32 = 0.104;     // m the hips sit at, sitting up
const REAR_STRETCH: f32 = 0.012; // m the back lengthens sitting up (its arch let out)
const LIE_HIP: f32 = 0.072;      // m the hips rest over the ground, loafing
const LIE_WITHERS: f32 = 0.098;  //   and the withers
@knob const HEAD_HOLD: f32 = 0.92; // share of the chest's bob the neck keeps from the head
@knob const NECK_HOP: f32 = -0.45;   // rad the neck lifts the head by, hopping
@knob const SCAP_FOLLOW: f32 = 0.6;  // of the leg's swing the blade takes
@knob const EAR_RUN: f32 = 0.8;      // rad the ears sweep back running flat out
@knob const EAR_SNAP: f32 = 16.0;    // rad/s an ear's swivel's spring (critical) turns it toward where it listens
@knob const EAR_FLICK_T: f32 = 0.3;  // s an ear's flick lasts
@knob const EAR_FLICKS: f32 = 0.07;  // share of an ear's turns that are a flick instead
@knob const EAR_GRAZE_UP: f32 = 0.6; // rad the ears lean back grazing, against the head's pitch down
@knob const EAR_BACK: f32 = 1.25;   // rad an ear's opening swivels back at most
@knob const NECK_RUN: f32 = -0.5;   // rad the neck lifts the head by, bounding
@knob const HIND_WIDE: f32 = 0.02;   // m a hind foot's home moves out, bounding
@knob const VARY: f32 = 1.0;        // share of the individual's wander in speed and heading
@knob const HEAD_RIDE: f32 = 0.25;   // share of the chest's pitch about its mean the head rides
// The ears' tips on springs (creature::dangle): rad/s, damping, share of gravity.
@knob const EAR_W1: f32 = 68.0;
@knob const EAR_W2: f32 = 52.0;
@knob const EAR_ZETA: f32 = 0.68;
@knob const EAR_SAG: f32 = 0.6;

@kernel @grid(1)
fn k_rig(g: grid<1>, intent: read_store<f32, 1>, env: read_store<f32, 1>, state: rw_store<f32, 1>,
         pose: write_store<vec4<f32>, 1>, tele: write_store<f32, 1>, dt: f32) {
    let c = g.x();
    let s = c * STATE;
    let ii = c * INTENT;
    let init = state[s + S_PLACED] < 0.5;
    if (init) { place_bunny(state, env, s, HIND_WIDE, HOME_HOP_F); }

    // --- intent and actions -------------------------------------------------------
    var vdes = vec2<f32>(intent[ii + I_VEL_X], intent[ii + I_VEL_Z]);
    let act = intent[ii + I_ACTION] as i32;
    let seed = intent[ii + I_SEED];
    let clock = state[s + D_CLOCK] + dt;
    state[s + D_CLOCK] = clock;

    let lie = approach(state[s + D_LIE], select_f(act == ACT_LIE, 1.0, 0.0), 0.8, dt);
    let graze = approach(state[s + D_GRAZE], select_f(act == ACT_GRAZE, 1.0, 0.0), 2.2, dt);
    var st_t = state[s + D_STARTLE_T];
    if (act == ACT_STARTLE && (state[s + D_PREV_ACT] as i32) != ACT_STARTLE) { st_t = 0.0; }
    if (st_t >= 0.0) { st_t += dt; }
    if (st_t > 3.0) { st_t = -1.0; }
    // Alert: smoothly sprung on a startle after its flinch, and smoothly let go.
    let alert_want = select_f(act == ACT_ALERT || (act == ACT_STARTLE && (st_t < 0.0 || st_t > 0.36)), 1.0, 0.0);
    let w_alert = select_f(alert_want > state[s + D_ALERT], 8.5, 2.2);
    let as_ = crit_step(vec2<f32>(state[s + D_ALERT], state[s + D_SEC + S_ALERT_V]), alert_want, w_alert, dt);
    let alert = clamp(as_.x, 0.0, 1.0);
    state[s + D_LIE] = lie;
    state[s + D_GRAZE] = graze;
    state[s + D_ALERT] = alert;
    state[s + D_SEC + S_ALERT_V] = as_.y;
    state[s + D_STARTLE_T] = st_t;
    state[s + D_PREV_ACT] = act as f32;
    if (lie > 0.001 || act == ACT_LIE) { vdes = vec2<f32>(0.0); }
    vdes *= 1.0 - 0.8 * graze;

    // --- heading and speed ---------------------------------------------------------
    var yaw = state[s + S_YAW];
    var speed = state[s + D_SPEED];
    var want = yaw;
    let vd = length(vdes);
    let vary = VARY * smooth01(speed / 0.3) * smooth01(1.0 - abs(vd - speed) / 0.2);
    if (intent[ii + I_HEADING_MODE] > 0.5) { want = intent[ii + I_HEADING]; }
    else if (vd > 0.03) { want = atan2(vdes.x, vdes.y) + vary * 0.05 * noise1(clock / 1.3, seed, 2.0); }
    var rear = state[s + D_REAR];
    let rear_s = smooth01(rear);
    let rate = mix(1.4, 3.2 / (1.0 + 0.3 * speed), smooth01(speed / 0.4)) * (1.0 - smooth01(rear * 3.0));
    let w_t = clamp(4.0 * wrap_pi(want - yaw), -rate, rate);
    let omega = approach(state[s + D_OMEGA], w_t, 10.0, dt);
    yaw = wrap_pi(yaw + omega * dt);
    let err = wrap_pi(want - yaw);
    let vt = vd * clamp(cos(err), 0.15, 1.0) * (1.0 + vary * 0.04 * noise1(clock / 0.9, seed, 1.0)) * (1.0 - smooth01(rear * 3.0));
    speed = approach(speed, vt, min(select_f(vt > speed, 1.2 + 0.8 * speed, 3.0), DV_MAX), dt);
    let fwd = vec3<f32>(sin(yaw), 0.0, cos(yaw));
    let left = vec3<f32>(cos(yaw), 0.0, -sin(yaw));
    var pos = ld3(state, s + S_POS);
    pos += fwd * speed * dt;
    let tz = turn_z();
    let yaw0 = state[s + S_YAW];
    pos += (vec3<f32>(sin(yaw0), 0.0, cos(yaw0)) - fwd) * tz;
    let vel = fwd * speed;

    // --- gait ------------------------------------------------------------------------
    var gait = state[s + D_GAIT] as i32;
    if (gait != GAIT_BOUND && (speed > HOP_UP || act == ACT_BOUND)) { gait = GAIT_BOUND; }
    else if (gait == GAIT_BOUND && speed < BOUND_DOWN && act != ACT_BOUND) { gait = GAIT_HOP; }
    let bw = approach(state[s + D_BW], select_f(gait == GAIT_BOUND, 1.0, 0.0), 2.5, dt);
    let hw = 1.0 - bw;
    let veff = max(speed, abs(omega) * 0.12);
    let freq = hw * (1.5 + 1.0 * veff) + bw * (2.5 + 0.25 * veff);
    let slow = 0.18 * (1.0 - smooth01(veff / 0.35));
    let duty_h = min(min(TRAVEL_H * freq / max(veff, 0.05), 0.47) + slow, 0.8);
    let duty_f = min(min(mix(TRAVEL_F_HOP, TRAVEL_F, bw) * freq / max(veff, 0.05), 0.5) + slow, 0.78);
    let shuf_t = (1.0 - smooth01((veff - SHUFFLE_FULL) / (SHUFFLE_TOP - SHUFFLE_FULL))) * (1.0 - smooth01((abs(omega) - 0.3) / 0.5));
    var shuf_s = state[s + D_SHUF];
    if (init) { shuf_s = shuf_t; }
    shuf_s = approach(shuf_s, shuf_t, 1.5, dt);
    state[s + D_SHUF] = shuf_s;
    let shuf = hw * shuf_s;
    let lift_h = mix(vec2<f32>(mix(0.030, SHUFFLE_LIFT, shuf), 0.022), vec2<f32>(0.055, 0.045), bw);
    let wrist = mix(1.2, 2.0, bw);
    let curl = mix(0.5, 0.9, bw);

    var phase = state[s + D_PHASE];
    let was_moving = state[s + D_MOVING] > 0.5;
    var moving = vd > 0.04 || speed > 0.04 || abs(err) > 0.15;
    if (was_moving) { moving = moving || speed > 0.02 || vd > 0.02 || abs(err) > 0.06; }
    if (lie > 0.001 || rear > 0.08) { moving = false; }
    var offs: array<f32, 4>;
    for (var l: i32 = 0; l < 4; l += 1) { offs[l] = off_mix(bw, shuf, l); }
    if (moving && !was_moving) {
        phase = floor(phase) + 1.0 + offs[1] + duty_f;
        for (var l: i32 = 0; l < 4; l += 1) { state[s + D_LEG + l * LEG_REC + L_ARMED] = 1.0; }
    }

    // --- a leap ---------------------------------------------------------------------------
    var leap = state[s + D_LEAP];
    var leap_s = state[s + D_LEAP + 1];
    let leap_he = max(offs[0], offs[3]) + duty_h;
    var leap_v = state[s + D_LEAP + 2];
    let php = fract01(phase - offs[0]);
    if (leap < 0.5 && bw > 0.7 && moving && !init && php + freq * dt >= 1.0) {
        let ob = obstacle_ahead(env, pos.x, pos.z, vec2<f32>(fwd.x, fwd.z));
        let v_lo = sqrt(2.0 * 9.81 * (ob.y + LEAP_OVER));
        let slack = 0.5 * max(speed / freq - speed * LEAP_SPARE / 9.81, 0.0);
        if (ob.y > 0.02 && ob.x < speed * (LEAP_PUSH_T + (v_lo + LEAP_SPARE) / 9.81) + slack) {
            leap = 1.0;
            leap_s = -LEAP_PUSH_T - dt;
            leap_v = clamp(9.81 * (ob.x / max(speed, 0.5) - LEAP_PUSH_T), v_lo, v_lo + LEAP_SPARE);
        }
    }
    state[s + D_LEAP + 2] = leap_v;
    let leap_up = max(leap_v * 0.3 * LEAP_PUSH_T - LEAP_DIP, 0.0);
    let leap_T = (leap_v + sqrt(leap_v * leap_v + 2.0 * 9.81 * max(leap_up - LEAP_CATCH, -0.4 * leap_v * leap_v / 9.81))) / 9.81;
    var cfreq = freq;
    var leap_y: f32 = 0.0;
    var leap_nose: f32 = 0.0;
    var leap_air: f32 = 0.0;
    var leap_clear: f32 = 0.0;
    if (leap > 0.5) {
        leap_s += dt;
        if (leap_s < 0.0) {
            cfreq = leap_he / LEAP_PUSH_T;
            let u = 1.0 + leap_s / LEAP_PUSH_T;
            let up = max(u - 0.4, 0.0) / 0.6;
            leap_y = -LEAP_DIP * smooth01(u / 0.4) + (LEAP_DIP + leap_up) * up * up;
            leap_nose = LEAP_PITCH * smooth01(up);
        } else if (leap_s < leap_T) {
            let rem = fract01(min(offs[1], offs[2]) - php);
            cfreq = select_f(rem > 0.6, 0.0, min(rem / max(leap_T - leap_s, 0.02), 2.0 * freq));
            leap_y = leap_up + leap_v * leap_s - 4.905 * leap_s * leap_s;
            leap_nose = LEAP_PITCH * cos(PI * leap_s / leap_T);
            leap_air = 1.0;
            leap_clear = smooth01(leap_s / 0.1) * smooth01((leap_T - leap_s) / 0.12);
        } else {
            let t = leap_s - leap_T;
            let y0 = leap_up + leap_v * leap_T - 4.905 * leap_T * leap_T;
            leap_y = (y0 + (leap_v - 9.81 * leap_T + LEAP_GIVE * y0) * t) * exp(-LEAP_GIVE * t);
            leap_nose = -LEAP_PITCH * (1.0 - smooth01(t / 0.16));
            if (t > 0.4) { leap = 0.0; }
        }
    }
    state[s + D_LEAP] = leap;
    state[s + D_LEAP + 1] = leap_s;
    let warp = cfreq / max(freq, 0.1);
    if (moving) { phase += cfreq * dt; }
    let mv = select_f(moving, 1.0, 0.0) * smooth01(speed / 0.3);

    // --- the stride: each girdle's surge (bunny::stride) -----------------------------
    let len = speed / max(freq, 0.1);
    let mh = 0.5 * (offs[0] + offs[3]) + 0.5 * duty_h;
    let sa = surge_share(len, TRUNK_SWING, SURGE_MAX) * mv;
    let p = fract01(phase);
    let dh = girdle_surge(p, mh, sa, len, true);
    let df = girdle_surge(p, mh, sa, len, false);
    let ho = pos + fwd * dh;
    let fo = pos + fwd * df;

    // --- sitting up -------------------------------------------------------------------
    let rear_want = alert * (1.0 - smooth01(vd / 0.1)) * (1.0 - lie) * (1.0 - graze) * select_f(was_moving && speed > 0.05, 0.0, 1.0);
    let rs = crit_step(vec2<f32>(rear, state[s + D_REAR_V]), rear_want, 9.0, dt);
    rear = clamp(rs.x, 0.0, 1.0);
    state[s + D_REAR] = rear;
    state[s + D_REAR_V] = rs.y;

    // --- feet --------------------------------------------------------------------------
    let qyaw = q_y(yaw);
    let pitch_o = state[s + D_PITCH_O];
    var any_swing = false;
    var worst: i32 = -1;
    var worst_e: f32 = SETTLE_TRIG;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        if (state[k + L_PLANT] < 0.5) { any_swing = true; }
        else {
            let home = select_v3(LEG_HIND[l] == 1, ho, fo) + q_rot(qyaw, home_of(l, bw, mv, HIND_WIDE, HOME_HOP_F));
            let t = ld3(state, k + L_TOE);
            let e = length(vec2<f32>(t.x - home.x, t.z - home.z));
            if (e > worst_e) { worst_e = e; worst = l; }
        }
    }
    var settle_hinds = false;
    if (worst >= 0) { settle_hinds = !any_swing && LEG_HIND[worst] == 1; }
    var feet: array<vec3<f32>, 4>;
    var toes: array<vec3<f32>, 4>;
    var left_t: array<f32, 4>;
    var grounds: array<f32, 4>;
    var hind_swing: f32 = 0.0;
    var sway: f32 = 0.0;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        let hind = LEG_HIND[l] == 1;
        let duty = select_f(hind, duty_h, duty_f);
        let og = select_v3(hind, ho, fo);
        let home_off = home_of(l, bw, mv, HIND_WIDE, HOME_HOP_F);
        let home = og + q_rot(qyaw, home_off);
        let ph = fract01(phase - offs[l]);
        var planted = state[k + L_PLANT] > 0.5;
        var toe = ld3(state, k + L_TOE);
        var lift = false;
        var lift_t: f32 = SETTLE_T;
        var u0: f32 = 0.0;
        var kind: f32 = 1.0;
        if (planted) {
            if (ph < duty) { state[k + L_ARMED] = 1.0; }
            let stray = length(vec2<f32>(toe.x - home.x, toe.z - home.z));
            let top = leg_top(l, og, qyaw, state[s + D_HY_O], state[s + D_FY_O]);
            let over = length(toe - top) > reach_of(l);
            if (!hind && rear > 0.25) {
                lift = true; kind = 2.0; lift_t = 0.26;
            } else if (moving && state[k + L_ARMED] > 0.5 && ph >= duty) {
                lift = true;
                lift_t = clamp((1.0 - duty) / max(freq, 0.1), 0.07, 0.5);
                u0 = clamp(((ph - duty) / max(freq, 0.1) - dt) / lift_t, 0.0, dt / lift_t);
                kind = 0.0;
            } else if (moving && (stray > REACH_TRIG || over)) {
                lift = true; kind = 0.0;
                lift_t = clamp((1.0 - ph) / max(freq, 0.1), min(0.1, 0.5 * (1.0 - duty) / max(freq, 0.1)), 0.4);
            } else if (!moving && ((!any_swing && worst == l) || (settle_hinds && hind)) && rear < 0.05 && lie < 0.05) {
                lift = true;
            }
            if (lift) {
                planted = false;
                any_swing = true;
                state[k + L_ARMED] = 0.0;
                st3(state, k + L_FROM, toe);
                state[k + L_U] = u0;
                state[k + L_T] = lift_t;
                state[k + L_KIND] = kind;
                let lift_w = mix(0.12, min(max(0.12, 0.1 * freq), 0.6 * duty), hw);
                state[k + L_SINCE] = select_f(moving, smooth01((stance_phase(ph, duty) - (duty - lift_w)) / lift_w), 0.0);
            }
        }
        var u: f32 = 0.0;
        if (!planted) {
            u = state[k + L_U];
            if (state[k + L_KIND] > 1.5 && rear < 0.2) {
                st3(state, k + L_FROM, toe);
                state[k + L_KIND] = 1.0; state[k + L_T] = 0.24; u = 0.0;
            }
            let held = state[k + L_KIND] > 1.5;
            let tt = state[k + L_T];
            let top = leg_top(l, og, qyaw, state[s + D_HY_O], state[s + D_FY_O]);
            var target = home;
            if (held) {
                let qt = q_mul(qyaw, q_x(-pitch_o));
                let rp = TAIL[LEG_B0[l] + LEG_NB[l] - 1] - HEAD[B_PELVIS];
                let tuck = vec3<f32>(rp.x * 0.85, rp.y + 0.062, rp.z - 0.046);
                target = vec3<f32>(ho.x, state[s + D_HY_O], ho.z) + q_rot(qt, tuck);
            } else if (moving) {
                let stance_t = duty / max(freq, 0.1);
                var lead = (1.0 - u) * tt + 0.5 * stance_t;
                if (leap_air > 0.5) { lead += max(leap_T - leap_s, 0.0); }
                let yl = yaw + omega * lead;
                let ahead = girdle_surge(p + lead * freq, mh, sa, len, hind);
                let land = select_f(hind, HOP_LAND_H * hw, 0.0);
                target = pos + vel * lead + fwd * (ahead + land) + (fwd - vec3<f32>(sin(yl), 0.0, cos(yl))) * tz + q_rot(q_y(yl), home_off);
            }
            if (!held) { target.y = height(env, target.x, target.z); }
            st3(state, k + L_TO, target);
            u = min(u + warp * dt / tt, 1.0);
            if (leap_air > 0.5) { u = min(u, 0.9); }
            let lifted = ld3(state, k + L_FROM);
            let e = smooth01(u);
            var hgt = select_f(hind, lift_h.x, lift_h.y) + LEAP_FOLD * leap_air;
            if (state[k + L_KIND] > 0.5) { hgt = 0.012; }
            toe = mix(lifted, target, vec3<f32>(e));
            if (!held) {
                toe = swing_arc(top, qyaw, lifted, target, e);
                let w = max(swing_bump(u), leap_clear);
                let below = top.y - toe.y;
                if (w > 0.0 && below > 1e-3) {
                    let room = max(top.y - height(env, toe.x, toe.z) - hgt, 0.01);
                    toe = top + (toe - top) * mix(1.0, soft_cap(below, room, 0.3) / below, w);
                }
            }
            // Carried within the leg's reach of its girdle, eased in so it
            // has no corner (FORE_CARRY keeps slow-hop fore touchdowns safely
            // flexed below SOFT_REACH so the elbow never snaps off straight).
            let rmax = reach_of(l);
            let dy = top.y - toe.y;
            let rcar = rmax * select_f(hind, 1.0, mix(FORE_CARRY, 1.0, smooth01((veff - 2.2) / 1.5)));
            let hmax = sqrt(max(rcar * rcar - dy * dy, 0.0));
            let hv2 = vec2<f32>(toe.x - top.x, toe.z - top.z);
            let hl = length(hv2);
            if (hl > 1e-4 && !held) {
                let hn = soft_cap(hl, hmax, select_f(hind, CAP_BAND, FORE_BAND));
                toe.x = top.x + hv2.x * (hn / hl);
                toe.z = top.z + hv2.y * (hn / hl);
            }
            if (leap_clear > 0.0 && !held) {
                let ls = clamp(leap_s / max(leap_T, 0.1), 0.0, 1.0);
                let lat = dot(toe - top, left);
                var lz = mix(0.06, 0.09, ls);
                var ld = mix(0.09, 0.15, smooth01((ls - 0.45) / 0.55));
                if (hind) {
                    lz = mix(-0.15, 0.05, smooth01((ls - 0.12) / 0.8));
                    ld = 0.15 - 0.055 * sin(PI * ls);
                }
                let tuck = top + left * lat + fwd * lz - vec3<f32>(0.0, ld, 0.0);
                toe = mix(toe, tuck, vec3<f32>(leap_clear));
            }
            let rv = toe - top;
            let rl = length(rv);
            let rmin = select_f(hind, SWING_FOLD_H, SWING_FOLD_F) * rmax;
            let rhi = rmin + SWING_FOLD_BAND;
            if (rl < rhi && rl > 1e-4 && !held) { toe = top + rv * ((rhi - soft_limit(rhi - rl, 0.0, SWING_FOLD_BAND)) / rl); }
            let gy = height(env, toe.x, toe.z);
            toe.y = max(toe.y, gy);
            if (u >= 1.0 && !held) {
                toe.y = gy;
                planted = true;
                state[k + L_ARMED] = select_f(ph < duty || !moving, 1.0, 0.0);
                state[k + L_SINCE] = 0.0;
            }
            state[k + L_U] = u;
        }
        if (planted) { state[k + L_SINCE] = state[k + L_SINCE] + dt; }
        state[k + L_PLANT] = select_f(planted, 1.0, 0.0);
        st3(state, k + L_TOE, toe);
        var lt: f32 = 1e3;
        if (planted && moving) {
            if (state[k + L_ARMED] > 0.5) { lt = max(duty - stance_phase(ph, duty), 0.0) / max(freq, 0.1); }
            else { lt = (1.0 + duty - ph) / max(freq, 0.1); }
        }
        if (planted && !hind && rear_want > 0.5 && rear < 0.25) { lt = min(lt, max(0.25 - rear, 0.0) * 0.6); }
        left_t[l] = lt;
        var sh: f32 = 0.0;
        if (!planted && state[k + L_KIND] < 1.5) { let su = sin(PI * u); sh = su * su; }
        toes[l] = toe;
        feet[l] = toe;
        if (!planted) { feet[l] = select_v3(state[k + L_KIND] > 1.5, home, ld3(state, k + L_TO)); }
        grounds[l] = select_f(planted, toe.y, height(env, home.x, home.z));
        if (hind) { hind_swing += 0.5 * sh; }
        sway -= LEG_SIDE[l] * sh;
    }

    // --- the body's plan, levelled to the feet ------------------------------------------
    let lie_f = smooth01(lie * 1.6);
    let lie_h = smooth01((lie - 0.2) / 0.8);
    let hip_g = height(env, ho.x, ho.z);
    let wpos = fo + fwd * WITHERS_Z;
    let plane_c = fit_plane4(feet[0], feet[1], feet[2], feet[3], vec2<f32>(pos.x, pos.z));
    let hind_ground = 0.5 * (grounds[0] + grounds[3]);
    let fore_ground = 0.5 * (grounds[1] + grounds[2]);
    let bob_h = HOP_ARC * hind_swing * (hw - shuf) * select_f(moving, 1.0, 0.0);
    let crouch = -0.022 * startle_flinch(st_t);
    let breath = 0.0012 * sin(TAU * 0.9 * clock + seed);

    var cap_h: f32 = 1e4;
    var cap_f: f32 = 1e4;
    for (var l: i32 = 0; l < 4; l += 1) {
        let k = s + D_LEG + l * LEG_REC;
        if (state[k + L_KIND] > 1.5 && state[k + L_PLANT] < 0.5) { continue; }
        var w = smooth01((state[k + L_U] - 0.5) / 0.4);
        if (state[k + L_PLANT] > 0.5) { w = smooth01(left_t[l] / 0.06); }
        if (w <= 0.0) { continue; }
        let slack = (1.0 - w) * CAP_FADE;
        let hind = LEG_HIND[l] == 1;
        let b0 = LEG_B0[l];
        let piv = leg_pivot(l);
        let rmax = reach_of(l);
        let og = select_v3(hind, ho, fo);
        let top = og + q_rot(qyaw, piv - HEAD[B_PELVIS]);
        let hd = length(vec2<f32>(feet[l].x - top.x, feet[l].z - top.z));
        let ymax = feet[l].y + sqrt(max(rmax * rmax - hd * hd, 0.49 * rmax * rmax));
        if (hind) { cap_h = smin(cap_h, ymax + HEAD[B_PELVIS].y - piv.y + slack, CAP_SOFT); }
        else {
            var cf = ymax + HEAD[B_SCAPL].y - piv.y + slack;
            let top0 = og + q_rot(qyaw, HEAD[b0] - HEAD[B_PELVIS]);
            let hd0 = length(vec2<f32>(feet[l].x - top0.x, feet[l].z - top0.z));
            cf = smin(cf, feet[l].y + sqrt(max(REACH_FORE_TOP * REACH_FORE_TOP - hd0 * hd0, 0.49 * REACH_FORE_TOP * REACH_FORE_TOP)) + HEAD[B_SCAPL].y - HEAD[b0].y + slack, CAP_SOFT);
            cap_f = smin(cap_f, cf, CAP_SOFT);
        }
    }
    let half_h = 0.5 * speed * duty_h / max(freq, 0.1);
    let half_f = 0.5 * speed * duty_f / max(freq, 0.1);
    let run_h = min(HIP_RUN, sqrt(max(0.9 * REACH_HIND * REACH_HIND - half_h * half_h, 0.0)) + HEAD[B_PELVIS].y - leg_pivot(0).y);
    let run_f = min(SCAP_RUN, sqrt(max(0.9 * REACH_FORE * REACH_FORE - half_f * half_f, 0.0)) + HEAD[B_SCAPL].y - leg_pivot(1).y);
    let hy_plan = mix(smin(hind_ground + run_h, cap_h, CAP_SOFT), smin(hind_ground + HEAD[B_PELVIS].y - HIP_DROP, cap_h, CAP_SOFT), hw);
    let fy_plan = mix(smin(fore_ground + run_f, cap_f, CAP_SOFT), smin(fore_ground + HEAD[B_SCAPL].y, cap_f, CAP_SOFT), hw);
    var hy_t = mix(hy_plan + crouch + breath, hip_g + LIE_HIP, lie_h);
    hy_t = mix(hy_t, hind_ground + REAR_HIP, rear_s);
    let fy_t = mix(fy_plan + crouch - 0.018 * graze, height(env, wpos.x, wpos.z) + LIE_WITHERS, lie_f);
    let wh: f32 = 26.0;
    var hs = crit_step(vec2<f32>(state[s + D_HY], state[s + D_HV]), hy_t, wh, dt);
    var fs = crit_step(vec2<f32>(state[s + D_FY], state[s + D_FV]), fy_t, wh, dt);
    if (leap_air > 0.5) { hs = vec2<f32>(state[s + D_HY], 0.0); fs = vec2<f32>(state[s + D_FY], 0.0); }
    let he = max(offs[0], offs[3]) + duty_h;
    let f_s = min(offs[1], offs[2]);
    let f_e = max(offs[1], offs[2]) + duty_f;
    let fl = FLIGHT * bw * mv * flight(fract01(phase - offs[0]), 1.0 / max(freq, 0.1), he, f_s, f_e);
    let hy = hs.x + fl + bob_h + leap_y;
    var fy = fs.x + fl + leap_y + leap_nose;
    let ch_t = min(cap_h, hind_ground + HEAD[B_PELVIS].y + CAP_FADE);
    let cf_t = min(cap_f, fore_ground + HEAD[B_SCAPL].y + CAP_FADE);
    var chs = crit_step(vec2<f32>(state[s + D_CAP_H], state[s + D_CAP_HV]), ch_t, wh, dt);
    var cfs = crit_step(vec2<f32>(state[s + D_CAP_F], state[s + D_CAP_FV]), cf_t, wh, dt);
    if (init) { chs = vec2<f32>(ch_t, 0.0); cfs = vec2<f32>(cf_t, 0.0); }
    state[s + D_CAP_H] = chs.x; state[s + D_CAP_HV] = chs.y;
    state[s + D_CAP_F] = cfs.x; state[s + D_CAP_FV] = cfs.y;

    let pitch_g = atan2((fy - HEAD[B_SCAPL].y) - (hy - HEAD[B_PELVIS].y), WITHERS_Z + df - dh);
    let pitch = mix(pitch_g, REAR_PITCH, rear_s);
    fy = mix(fy, hy - HEAD[B_PELVIS].y + HEAD[B_SCAPL].y + WITHERS_Z * tan(pitch), rear_s);
    let grad_x = dot(vec2<f32>(plane_c.y, plane_c.z), vec2<f32>(left.x, left.z));
    let roll = damp(state[s + D_ROLL], clamp(0.3 * atan(grad_x), -0.1, 0.1), 6.0, dt);
    state[s + D_ROLL] = roll;
    let sway_v = left * (0.003 * sway * hw);
    let root = vec3<f32>(ho.x, hy, ho.z) + sway_v;

    // --- the trunk: the back as long as the girdles are apart (bunny::stride) -------------
    let run = bw * mv;
    let flex = flex_of((df - dh) + REAR_STRETCH * rear_s, mix(FLEX_SIT * (1.0 - lie) * (1.0 - rear_s), FLEX_RUN, run), TRUNK_SWING, mix(FLEX_SWING_HOP, FLEX_SWING, bw));
    let c0 = chord(0.0);
    let dl = vec2<f32>(cos(pitch + atan2(c0.y, c0.x)), sin(pitch + atan2(c0.y, c0.x)));
    let tr = trunk(flex, dl);
    let bend_y = clamp(0.12 * omega, -0.15, 0.15) * mv;
    var T: Pose;
    T.q[B_PELVIS] = q_mul(q_mul(qyaw, q_x(tr.z)), q_z(roll));
    T.p[B_PELVIS] = root;
    let breath_x = 0.008 * sin(TAU * 0.9 * clock + seed) * (1.0 - mv);
    T.q[B_LUMBAR] = q_mul(T.q[B_PELVIS], q_xyz(clamp_xyz(vec3<f32>(tr.x, bend_y, 0.0), B_LUMBAR)));
    T.q[B_THORAX] = q_mul(T.q[B_LUMBAR], q_xyz(clamp_xyz(vec3<f32>(tr.y + breath_x, bend_y, 0.0), B_THORAX)));
    T.p[B_LUMBAR] = head_of(T, B_LUMBAR);
    T.p[B_THORAX] = head_of(T, B_THORAX);

    // --- head, gaze, nose, ears & scut (bunny::act) ---------------------------------------
    let hk = HeadKnobs(
        HEAD_HOLD, HEAD_RIDE, NECK_HOP, NECK_RUN,
        EAR_RUN, EAR_SNAP, EAR_FLICK_T, EAR_FLICKS, EAR_GRAZE_UP, EAR_BACK,
        EAR_W1, EAR_W2, EAR_ZETA, EAR_SAG
    );
    T = pose_head_ears(
        T, intent, ii, env, state, s, init, dt,
        clock, seed, yaw, speed, phase,
        bw, hw, mv, lie, lie_f, graze, alert, rear_s, st_t, hk
    );
    T = pose_scut(T, state, s, init, dt, clock, seed, speed, phase, bw, mv, lie, alert, st_t);

    // --- legs, solved twice for hind-limb inertial trunk recoil --------------------------
    var carried = vec3<f32>(0.0);
    for (var pass: i32 = 0; pass < 2; pass += 1) {
        for (var l: i32 = 0; l < 4; l += 1) {
            let k = s + D_LEG + l * LEG_REC;
            let hind = LEG_HIND[l] == 1;
            let duty = select_f(hind, duty_h, duty_f);
            let b0 = LEG_B0[l];
            let nb = LEG_NB[l];
            var par = B_THORAX; if (hind) { par = B_PELVIS; }
            let qp = T.q[par];
            let j = T.p[par] + q_rot(qp, HEAD[b0] - HEAD[par]);
            let planted = state[k + L_PLANT] > 0.5;
            var toe = toes[l];
            if (!planted) {
                let cu = 4.0 * state[k + L_U] * (1.0 - state[k + L_U]);
                toe += carried * (cu * cu);
                toe.y = max(toe.y, height(env, toe.x, toe.z));
            }
            let d = q_rot(q_conj(qp), toe - j);
            let held = !planted && state[k + L_KIND] > 1.5;
            let u = state[k + L_U];
            let ph = fract01(phase - offs[l]);
            let n = normal(env, toe.x, toe.z);
            let fw = q_rot(qp, vec3<f32>(0.0, 0.0, 1.0));
            let slope = atan2(-dot(n, vec3<f32>(fw.x, 0.0, fw.z)), n.y);
            let par_pitch = atan2(fw.y, length(vec2<f32>(fw.x, fw.z)));
            var ah = rest_angle(b0 + nb - 1) + slope - par_pitch;
            let roll_k = select_f(hind, 0.35, 0.5);
            let roll_w = mix(0.12, min(max(0.12, 0.1 * freq), 0.6 * duty), hw);
            if (planted && moving) { ah -= roll_k * smooth01((stance_phase(ph, duty) - (duty - roll_w)) / roll_w); }
            var fold: f32 = 0.0;
            if (!planted) {
                if (state[k + L_KIND] < 0.5) { ah -= roll_k * state[k + L_SINCE] * (1.0 - smooth01(u / 0.3)); }
                fold = select_f(held, smooth01(u), fold_bump(u));
                ah -= select_f(held, 1.2, curl) * fold;
            }
            var o: Leg;
            if (hind) { o = solve_hind_flat(b0, d, ah, SOFT_REACH, FOOT_FLAT + slope - par_pitch, 0.12); }
            else { o = solve_front(b0, d, ah, select_f(held, 1.6, wrist) * fold, SCAP_FOLLOW, SOFT_REACH); }
            let rho = clamp(o.rho, LIM_LO[b0].z, LIM_HI[b0].z);
            let qr = q_mul(qp, q_z(rho));
            var prev: f32 = 0.0;
            for (var i: i32 = 0; i < nb; i += 1) {
                let b = b0 + i;
                let loc = soft_range(-(leg_angle(o, i) - rest_angle(b)) - prev, LIM_LO[b].x, LIM_HI[b].x, LEG_BAND);
                prev = prev + loc;
                T.q[b] = q_mul(qr, q_x(prev));
                if (i == 0) { T.p[b] = j; }
                else { T.p[b] = T.p[b - 1] + q_rot(T.q[b - 1], HEAD[b] - HEAD[b - 1]); }
            }
        }
        if (pass == 0) {
            let cm = com_of(T);
            let ahead = dot(cm - pos, fwd);
            let over = cm.y - hy;
            let ahead_m = select_f(init, ahead, mix(state[s + D_AHEAD], ahead, 1.0 - exp(-dt / RECOIL_T)));
            let over_m = select_f(init, over, mix(state[s + D_OVER], over, 1.0 - exp(-dt / RECOIL_T)));
            state[s + D_AHEAD] = ahead_m;
            state[s + D_OVER] = over_m;
            let go_by = (fwd * (ahead_m - ahead) + vec3<f32>(0.0, over_m - over, 0.0)) * (mv * (1.0 - shuf) / RECOIL_TRUNK);
            for (var b: i32 = 0; b < NB; b += 1) {
                var w: f32 = 1.0;
                if (b == B_NECK) { w = 0.5; }
                var a = b;
                for (var up: i32 = 0; up < 3; up += 1) {
                    if (a == B_HEAD) { w = 0.0; }
                    if (a >= 0) { a = PARENT[a]; }
                }
                T.p[b] = T.p[b] + go_by * w;
            }
            carried = go_by;
        }
    }

    // --- out ------------------------------------------------------------------------------
    write_bunny_out(
        T, pose, tele, state, c, s, pos, hy, fy, hip_g, hs, fs,
        yaw, speed, omega, phase, bw, gait, moving, pitch, roll, freq, act,
        lie_h, lie_f, toes
    );
}
