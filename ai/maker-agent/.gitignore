# Generated agent bundle — 1.3 MB esbuild artifact, not source. Regenerate with
# `npm run build` in bundler/ (see bundler/README.md). Kept out of the repo.
maker.bundle.js

# Author-time bundler deps — restored with `npm install` in bundler/.
bundler/node_modules/

# Test-run artifacts (screenshots, captured preview images, logs).
tests/*.png
tests/*.jpg
tests/*.txt

# Agent scratch: the maker authors its app into project/ at runtime. Only the
# seed index.html (the "nothing built yet" placeholder) is tracked; everything
# the agent writes there during a session stays out of the repo.
/project/*
!/project/index.html
